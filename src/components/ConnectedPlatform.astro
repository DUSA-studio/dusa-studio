<script>
  (function () {
    const section = document.getElementById('connected-platform');
    if (!section) return;
    const stage = section.querySelector('.cp__stage');
    const svg = section.querySelector('.cp__wheel');
    const readout = section.querySelector('.cp__readout');
    if (!stage || !svg || !readout) return;

    const det = readout.querySelector('.cp__readout-detail');
    const tip = section.querySelector('.cp__tip');
    const tipName = tip.querySelector('.cp__tip-name');
    const tipVal = tip.querySelector('.cp__tip-val');
    const elDomain = readout.querySelector('.cp__readout-domain');
    const elName = readout.querySelector('.cp__readout-name');
    const elDesc = readout.querySelector('.cp__readout-desc');

    /* Arm the entrance only now that JS is running, so the wheel can never be
       left hidden by CSS that nothing undoes. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && 'IntersectionObserver' in window) {
      svg.classList.add('cp--anim');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { svg.classList.add('is-in'); io.disconnect(); } });
      }, { threshold: 0.15 });
      io.observe(svg);
      setTimeout(() => svg.classList.add('is-in'), 2500);
    }


    /* ── Guarantee no label ever outgrows the shape holding it ──
       Font metrics are not knowable at build time, and the labels are
       translated, so measure at runtime and shrink anything that does not
       fit. This is what stops "Conversations" (and any longer German or
       Portuguese equivalent) spilling out of its segment. */
    const CAP_RADIAL = 114; /* R_C1 - R_C0 */
    function fitLabels() {
      section.querySelectorAll('.cp__dom-text').forEach((txt) => {
        const tp = txt.querySelector('textPath');
        if (!tp) return;
        const path = section.querySelector(tp.getAttribute('href'));
        if (!path) return;
        const room = path.getTotalLength() * 0.86;
        txt.style.fontSize = '';
        tp.removeAttribute('textLength');
        tp.removeAttribute('lengthAdjust');
        const base = parseFloat(getComputedStyle(txt).fontSize);
        const len = tp.getComputedTextLength();
        if (len > room) {
          txt.style.fontSize = Math.max(9, base * (room / len)).toFixed(2) + 'px';
          /* Shrinking bottoms out at 9px. Anything still too long (a very long
             translated label) gets condensed to fit exactly, so overflow is
             impossible rather than merely unlikely. */
          if (tp.getComputedTextLength() > room) {
            tp.setAttribute('textLength', room.toFixed(1));
            tp.setAttribute('lengthAdjust', 'spacingAndGlyphs');
          }
        }
      });

      const capRoom = CAP_RADIAL - 20;
      section.querySelectorAll('.cp__cap-text').forEach((txt) => {
        txt.style.fontSize = '';
        const base = parseFloat(getComputedStyle(txt).fontSize);
        let widest = 0;
        txt.querySelectorAll('tspan').forEach((sp) => {
          widest = Math.max(widest, sp.getComputedTextLength());
        });
        if (widest > capRoom) txt.style.fontSize = Math.max(7.5, base * (capRoom / widest)).toFixed(2) + 'px';
      });
    }
    /* Fonts load after first paint and change every measurement. */
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitLabels);
    fitLabels();
    let fitTimer;
    window.addEventListener('resize', () => {
      clearTimeout(fitTimer);
      fitTimer = setTimeout(fitLabels, 150);
    });

    /* Hover handling is delegated and hysteretic on purpose.
       Per-element mouseenter/mouseleave fired leave-then-enter every time the
       pointer crossed between two adjacent segments, which cleared and rebuilt
       the readout mid-move — that was the jitter. Now: one listener, ignore
       repeats for the segment already active, and wait a beat before clearing
       so travelling across the ring is continuous. */
    let activeSeg = null;
    let leaveTimer = null;

    const capTiles = [...svg.querySelectorAll('.cp__cap')];

    const lightDomain = (di) => {
      stage.classList.add('is-dim');
      stage.querySelectorAll('.cp__seg.is-on').forEach((n) => n.classList.remove('is-on'));
      stage.querySelectorAll('.cp__seg--d' + di).forEach((n) => n.classList.add('is-on'));
    };

    const setActive = (idx) => {
      capTiles.forEach((t, i) => t.classList.toggle('is-active', i === idx));
    };

    const placeTip = (ang) => {
      const sr = svg.getBoundingClientRect();
      const scale = sr.width / 760;
      const cx = sr.left + sr.width / 2;
      const cy = sr.top + sr.height / 2;

      const w = tip.offsetWidth, h = tip.offsetHeight;
      const ca = Math.abs(Math.cos(ang)), sa = Math.abs(Math.sin(ang));
      /* Push out far enough that the box's nearest edge clears the outer ring
         at this angle, rather than just centring it outside the radius. */
      const ringOuter = (344 + 19) * scale;
      const d = ringOuter + (w / 2) * ca + (h / 2) * sa + 14;

      let x = cx + d * Math.cos(ang);
      let y = cy + d * Math.sin(ang);

      /* Clamp to the viewport, never to the wheel — clamping to the wheel is
         what dragged it back over the labels. */
      x = Math.max(w / 2 + 8, Math.min(window.innerWidth - w / 2 - 8, x));
      y = Math.max(h / 2 + 8, Math.min(window.innerHeight - h / 2 - 8, y));

      tip.style.left = x + 'px';
      tip.style.top = y + 'px';
    };

    const paintCap = (hit) => {
      lightDomain(hit.getAttribute('data-di'));
      setActive(Number(hit.getAttribute('data-idx')));

      const isAi = hit.getAttribute('data-ai') === '1';
      tipName.textContent = hit.getAttribute('data-name');
      tipVal.textContent = hit.getAttribute('data-desc');
      tip.classList.toggle('is-ai', isAi);
      placeTip(parseFloat(hit.getAttribute('data-ang')));
      tip.classList.add('is-on');

      /* Centre holds context only; the tooltip carries the detail. */
      elDomain.textContent = isAi ? 'AI POWERED' : '';
      elName.textContent = hit.getAttribute('data-domain-name');
      elDesc.textContent = '';
      readout.classList.add('is-detail');
      det.setAttribute('aria-hidden', 'false');
    };

    const paintDomain = (hit) => {
      lightDomain(hit.getAttribute('data-di'));
      setActive(-1);
      tip.classList.remove('is-on');
      readout.classList.remove('is-detail');
      det.setAttribute('aria-hidden', 'true');
    };

    const reset = () => {
      activeSeg = null;
      stage.classList.remove('is-dim');
      stage.querySelectorAll('.cp__seg.is-on').forEach((n) => n.classList.remove('is-on'));
      setActive(-1);
      tip.classList.remove('is-on');
      readout.classList.remove('is-detail');
      det.setAttribute('aria-hidden', 'true');
    };

    const clear = () => {
      clearTimeout(leaveTimer);
      leaveTimer = setTimeout(reset, 120);
    };

    svg.addEventListener('pointermove', (e) => {
      const hit = e.target.closest ? e.target.closest('.cp__hit-cap, .cp__hit-dom') : null;
      if (!hit) { if (activeSeg) clear(); return; }
      clearTimeout(leaveTimer);
      if (hit === activeSeg) return;
      activeSeg = hit;
      if (hit.classList.contains('cp__hit-cap')) paintCap(hit);
      else paintDomain(hit);
    }, { passive: true });

    svg.addEventListener('pointerleave', clear, { passive: true });

    section.querySelectorAll('.cp__lg[data-domain]').forEach((btn) => {
      const on = () => {
        clearTimeout(leaveTimer);
        activeSeg = null;
        setActive(-1);
        tip.classList.remove('is-on');
        lightDomain(btn.getAttribute('data-domain'));
      };
      btn.addEventListener('mouseenter', on);
      btn.addEventListener('focus', on);
      btn.addEventListener('mouseleave', clear);
      btn.addEventListener('blur', clear);
    });
  })();
</script>
