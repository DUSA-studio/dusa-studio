    const HOME_X = -3.8, JOB_X = 3.8, ROAD_Z = 2.0;
    const makeWorld = (nice: boolean) => {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 120);
      const hemi = new THREE.HemisphereLight(0xffffff, 0x223044, 1); scene.add(hemi);
      const sun = new THREE.DirectionalLight(0xffffff, 2.5);
      sun.castShadow = true; sun.shadow.mapSize.set(1024, 1024);
      sun.shadow.camera.left = -10; sun.shadow.camera.right = 10; sun.shadow.camera.top = 10; sun.shadow.camera.bottom = -10;
      sun.shadow.camera.near = 1; sun.shadow.camera.far = 50; sun.shadow.bias = -0.0015;
      scene.add(sun, sun.target);
      const nightAmb = new THREE.AmbientLight(0x3b5a8c, 0); scene.add(nightAmb);

      // Ground, rim, road
      const groundMat = mat(C.groundNight, { roughness: 1 });
      const ground = new THREE.Mesh(new THREE.CircleGeometry(8.4, 64), groundMat); ground.rotation.x = -Math.PI / 2; ground.receiveShadow = true; scene.add(ground);
      const rim = new THREE.Mesh(new THREE.RingGeometry(8.35, 8.5, 96), new THREE.MeshBasicMaterial({ color: nice ? C.aqua : C.trim, transparent: true, opacity: 0.35, side: THREE.DoubleSide }));
      rim.rotation.x = -Math.PI / 2; rim.position.y = 0.005; scene.add(rim);
      const roadMat = mat(C.roadNight, { roughness: 0.95 });
      const road = new THREE.Mesh(new THREE.PlaneGeometry(15, 1.6), roadMat); road.rotation.x = -Math.PI / 2; road.position.set(0, 0.01, ROAD_Z); road.receiveShadow = true; scene.add(road);
      for (let i = -6.5; i <= 6.5; i += 1.3) { const d = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.06), new THREE.MeshBasicMaterial({ color: C.trim, transparent: true, opacity: 0.5 })); d.rotation.x = -Math.PI / 2; d.position.set(i, 0.015, ROAD_Z); scene.add(d); }

      // Houses
      const windowMat = new THREE.MeshStandardMaterial({ color: 0x1c2a3e, emissive: 0xffc97a, emissiveIntensity: 0, roughness: 0.3 });
      const laptopWinMat = new THREE.MeshStandardMaterial({ color: 0x1c2a3e, emissive: 0x9fd8ff, emissiveIntensity: 0, roughness: 0.3 });
      const house = (x: number, z: number, w: number, d: number, h: number, wall: number, roofColor: number, door: number, winMat: THREE.Material) => {
        const g = new THREE.Group();
