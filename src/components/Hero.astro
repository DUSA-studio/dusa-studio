      invoice: '#D4956B',
      funnel: '#9B6BDB',
      ai: '#4ED8C2',
    };

    // Icon and delta metadata (structure only, not translatable)
    const notifMeta = [
      { icon: 'instagram', delta: 2 }, { icon: 'stripe', delta: 3 }, { icon: 'stripe', delta: 4 },
      { icon: 'whatsapp', delta: 1 }, { icon: 'calendar', delta: 5 }, { icon: 'google', delta: 3 },
      { icon: 'ai', delta: 2 }, { icon: 'sms', delta: 6 }, { icon: 'facebook', delta: 2 },
      { icon: 'email', delta: 4 }, { icon: 'stripe', delta: 7 }, { icon: 'instagram', delta: 3 },
      { icon: 'phone', delta: 5 }, { icon: 'form', delta: 4 }, { icon: 'calendar', delta: 8 },
      { icon: 'whatsapp', delta: 2 }, { icon: 'crm', delta: 5 }, { icon: 'review', delta: 3 },
      { icon: 'funnel', delta: 6 }, { icon: 'tiktok', delta: 4 }, { icon: 'email', delta: 3 },
      { icon: 'stripe', delta: 7 }, { icon: 'sms', delta: 2 }, { icon: 'google', delta: 5 },
      { icon: 'ai', delta: 4 }, { icon: 'instagram', delta: 6 }, { icon: 'invoice', delta: 8 },
      { icon: 'calendar', delta: 3 }, { icon: 'website', delta: 5 }, { icon: 'whatsapp', delta: 10 },
      { icon: 'facebook', delta: 2 }, { icon: 'crm', delta: 7 }, { icon: 'stripe', delta: 12 },
      { icon: 'email', delta: 5 }, { icon: 'phone', delta: 8 }, { icon: 'linkedin', delta: 4 },
      { icon: 'form', delta: 6 }, { icon: 'ai', delta: 15 }, { icon: 'google', delta: 10 },
      { icon: 'sms', delta: 3 }, { icon: 'stripe', delta: 7 }, { icon: 'tiktok', delta: 5 },
      { icon: 'calendar', delta: 12 }, { icon: 'instagram', delta: 4 }, { icon: 'ai', delta: 6 },
      { icon: 'crm', delta: 8 }, { icon: 'email', delta: 10 }, { icon: 'funnel', delta: 15 },
      { icon: 'ai', delta: 5 }, { icon: 'stripe', delta: 10 },
    ];

    // Load translated notification titles and text from inline JSON
    const notifDataEl = document.getElementById('hero-notif-data');
    const notifTranslations = notifDataEl ? JSON.parse(notifDataEl.textContent) : [];

    // Merge metadata with translations
    const notifications = notifMeta.map((m, i) => ({
      icon: m.icon,
      delta: m.delta,
      title: notifTranslations[i]?.title || 'Notification',
      text: notifTranslations[i]?.text || '',
    }));

    let currentIndex = 0;
    let feedStarted = false;
    let cycleInterval = null;
    let userScrolling = false;
    let scrollTimeout = null;
    let notifCounter = 0; // counts notifications since last quiet hours
    const INITIAL_COUNT = 5;
    const INITIAL_DELAY = 3000;
    const CYCLE_SPEED = 2500;
    const MAX_VISIBLE = 20;
    const QUIET_HOURS_INTERVAL = 8; // show quiet hours every N notifications

    // Stats ticker state
    let statLeads = 8;
    let statRevenue = 2400;
    let statRating = 4.8;
    const statLeadsEl = document.getElementById('stat-leads');
    const statRevenueEl = document.getElementById('stat-revenue');
    const statRatingEl = document.getElementById('stat-rating');
    const lotusEl = document.getElementById('hero-phone-lotus');

    // High-value notification types that trigger lotus pulse
    const highValueIcons = ['stripe', 'calendar', 'google', 'crm'];

    // AI notification types that get typing indicator
    const aiIcons = ['ai'];

    // Quiet hours messages
    const quietMessages = [
      { leads: 3, booked: 2, text: 'While you slept: 3 leads captured, 2 appointments booked' },
      { leads: 5, booked: 1, text: 'Overnight: 5 new enquiries handled, 1 demo booked by AI' },
      { leads: 2, booked: 3, text: 'After hours: 2 leads nurtured, 3 follow-ups sent automatically' },
      { leads: 4, booked: 2, text: 'While you were away: 4 leads qualified, 2 invoices paid' },
      { leads: 6, booked: 1, text: 'Overnight: 6 chats handled by AI, 1 new client signed up' },
    ];
    let quietIndex = 0;

    function formatRevenue(val) {
      if (val >= 10000) return '$' + (val / 1000).toFixed(1) + 'k';
      if (val >= 1000) return '$' + (val / 1000).toFixed(1) + 'k';
      return '$' + val;
    }

    function bumpStat(el) {
      el.classList.add('hero__stat-val--bump');
      setTimeout(() => el.classList.remove('hero__stat-val--bump'), 400);
    }

    function updateStats(notif) {
      // Bump leads for lead-related notifications
      if (['facebook', 'form', 'instagram', 'linkedin', 'crm', 'funnel'].includes(notif.icon)) {
        statLeads++;
        statLeadsEl.textContent = statLeads;
        bumpStat(statLeadsEl);
      }
      // Bump revenue for payment/stripe notifications
      if (['stripe'].includes(notif.icon)) {
        const amounts = [150, 250, 400, 850, 1200, 350];
        statRevenue += amounts[Math.floor(Math.random() * amounts.length)];
        statRevenueEl.textContent = formatRevenue(statRevenue);
        bumpStat(statRevenueEl);
      }
      // Bump rating for review notifications
      if (['google'].includes(notif.icon)) {
        statRating = Math.min(5.0, statRating + 0.01);
        statRatingEl.textContent = statRating.toFixed(1);
        bumpStat(statRatingEl);
      }
    }

    function pulseLotus() {
      if (!lotusEl) return;
      lotusEl.classList.remove('hero__phone-logo--pulse');
      // Force reflow to restart animation
      void lotusEl.offsetWidth;
      lotusEl.classList.add('hero__phone-logo--pulse');
      lotusEl.addEventListener('animationend', () => {
        lotusEl.classList.remove('hero__phone-logo--pulse');
      }, { once: true });
    }

    // Track displayed minutes for each visible notification element
    // Each entry: { el, mins }
    const visibleNotifs = [];

    function formatTime(mins) {
      if (mins <= 0) return 'Now';
      if (mins < 60) return `${mins}m ago`;
      const h = Math.floor(mins / 60);
      return `${h}h ago`;
    }

    function updateAllTimes(deltaMins) {
      visibleNotifs.forEach(entry => {
        entry.mins += deltaMins;
        const timeEl = entry.el.querySelector('.hero__notif-time');
        if (timeEl) timeEl.textContent = formatTime(entry.mins);
      });
    }

    function createNotifEl(notif, animate, displayTime) {
      const el = document.createElement('div');
      el.className = 'hero__notif';
      const color = barColors[notif.icon] || '#4ED8C2';
      const iconSvg = icons[notif.icon] || icons.automation;
      const iconColor = iconColors[notif.icon] || '#4ED8C2';

      el.innerHTML = `
        <div class="hero__notif-icon" style="background:${iconColor}22;color:${iconColor};width:28px;height:28px;min-width:28px;min-height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
          ${iconSvg}
        </div>
        <div class="hero__notif-body" style="flex:1;min-width:0;">
          <div class="hero__notif-row" style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:2px;">
            <span class="hero__notif-title" style="font-weight:600;font-size:0.8125rem;color:#F7F4EF;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${notif.title}</span>
            <span class="hero__notif-time" style="font-family:var(--font-mono);font-size:0.625rem;color:rgba(247,244,239,0.3);white-space:nowrap;text-transform:uppercase;letter-spacing:0.05em;">${displayTime}</span>
          </div>
          <p class="hero__notif-text" style="font-size:0.75rem;color:rgba(247,244,239,0.45);line-height:1.4;margin:0;">${notif.text}</p>
        </div>
      `;
      // Force SVG sizing (scoped styles don't apply to dynamic elements)
      const svg = el.querySelector('svg');
      if (svg) {
        svg.style.width = '14px';
        svg.style.height = '14px';
        svg.style.minWidth = '14px';
        svg.style.minHeight = '14px';
        svg.style.flexShrink = '0';
      }
      // Set the left bar color via inline
      const bar = document.createElement('span');
      bar.style.cssText = `position:absolute;top:0;left:0;width:2px;height:100%;background:${color};opacity:0.6;`;
      el.appendChild(bar);

      if (animate) {
        // Apply glow immediately via inline styles
        el.style.borderColor = 'rgba(78, 216, 194, 0.6)';
        el.style.boxShadow = '0 0 16px 3px rgba(78, 216, 194, 0.35), inset 0 0 8px rgba(78, 216, 194, 0.1)';
        el.style.background = 'rgba(78, 216, 194, 0.1)';
        el.style.transition = 'none'; // prevent instant transition away

        // After a brief moment, switch to long transition and remove glow
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            el.style.transition = 'border-color 1.6s ease-out, box-shadow 1.6s ease-out, background 1.6s ease-out';
            el.style.borderColor = '';
            el.style.boxShadow = '';
            el.style.background = '';
            // Clean up inline styles after transition
            setTimeout(() => {
              el.style.transition = '';
            }, 1700);
          });
        });
      }
      return el;
    }

    function insertNotif(el) {
      visibleNotifs.unshift({ el, mins: 0 });
      feed.insertBefore(el, feed.firstChild);
      if (!userScrolling) feed.scrollTop = 0;
      while (feed.children.length > MAX_VISIBLE) {
        feed.removeChild(feed.lastChild);
        visibleNotifs.pop();
      }
    }

    function createTypingIndicator() {
      const el = document.createElement('div');
      el.className = 'hero__typing';
      el.innerHTML = `
        <div class="hero__notif-icon" style="background:rgba(78,216,194,0.12);color:#4ED8C2;width:28px;height:28px;min-width:28px;min-height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4c0 1.95-2 3-2 5h-4c0-2-2-3.05-2-5a4 4 0 0 1 4-4z"/><line x1="10" y1="17" x2="14" y2="17"/><line x1="10" y1="20" x2="14" y2="20"/></svg>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="hero__typing-dots">
            <div class="hero__typing-dot"></div>
            <div class="hero__typing-dot"></div>
            <div class="hero__typing-dot"></div>
          </div>
          <span class="hero__typing-label">AI is composing...</span>
        </div>
      `;
      return el;
    }

    function createQuietHoursNotif() {
      const msg = quietMessages[quietIndex % quietMessages.length];
      quietIndex++;
      const el = document.createElement('div');
      el.className = 'hero__notif hero__notif--quiet';
      el.innerHTML = `
        <div class="hero__notif-icon" style="background:rgba(78,216,194,0.12);color:#4ED8C2;width:28px;height:28px;min-width:28px;min-height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </div>
        <div class="hero__notif-body" style="flex:1;min-width:0;">
          <div class="hero__notif-row" style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:2px;">
            <span class="hero__notif-title" style="font-weight:600;font-size:0.8125rem;color:var(--reef-aqua);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Quiet Hours Summary</span>
            <span class="hero__notif-time" style="font-family:var(--font-mono);font-size:0.625rem;color:rgba(78,216,194,0.4);white-space:nowrap;text-transform:uppercase;letter-spacing:0.05em;">6am</span>
          </div>
          <p class="hero__notif-text" style="font-size:0.75rem;color:rgba(78,216,194,0.55);line-height:1.4;margin:0;">${msg.text}</p>
        </div>
      `;
      // Mint left bar
      const bar = document.createElement('span');
      bar.style.cssText = 'position:absolute;top:0;left:0;width:2px;height:100%;background:#4ED8C2;opacity:0.4;';
      el.appendChild(bar);
      return el;
    }

    function addNotification() {
      if (currentIndex >= notifications.length) {
        currentIndex = 0; // Loop
      }
      const notif = notifications[currentIndex++];
      notifCounter++;

      // Check if it's time for quiet hours summary
      if (notifCounter > 0 && notifCounter % QUIET_HOURS_INTERVAL === 0) {
        updateAllTimes(360); // 6 hours passed overnight
        const quietEl = createQuietHoursNotif();
        insertNotif(quietEl);
        // Bump stats for the quiet hours
        statLeads += 3;
        statLeadsEl.textContent = statLeads;
        bumpStat(statLeadsEl);
        pulseLotus();
        return;
      }

      // Check if this is an AI notification — show typing indicator first
      if (aiIcons.includes(notif.icon)) {
        const typingEl = createTypingIndicator();
        feed.insertBefore(typingEl, feed.firstChild);
        if (!userScrolling) feed.scrollTop = 0;

        // After a delay, remove typing and show actual notification
        setTimeout(() => {
          if (typingEl.parentNode) typingEl.parentNode.removeChild(typingEl);
          updateAllTimes(notif.delta);
          const el = createNotifEl(notif, true, 'Now');
          insertNotif(el);
          updateStats(notif);
          pulseLotus();
        }, 1200);
        return;
      }

      // Regular notification flow
      updateAllTimes(notif.delta);
      const el = createNotifEl(notif, true, 'Now');
      insertNotif(el);
      updateStats(notif);

      // Pulse lotus on high-value notifications
      if (highValueIcons.includes(notif.icon)) {
        pulseLotus();
      }
    }

    function startCycling() {
      if (cycleInterval) return;
      feedStarted = true;
      cycleInterval = setInterval(addNotification, CYCLE_SPEED);
    }

    // Seed initial notifications (no animation) with cumulative times
    let cumulativeTime = 0;
    for (let i = 0; i < INITIAL_COUNT && i < notifications.length; i++) {
      // First notification shows "Now", rest accumulate deltas
      if (i === 0) {
        cumulativeTime = 0;
      } else {
        cumulativeTime += notifications[i].delta;
      }
      const el = createNotifEl(notifications[i], false, formatTime(cumulativeTime));
      feed.appendChild(el);
      visibleNotifs.push({ el, mins: cumulativeTime });
      currentIndex++;
    }

    // Start auto-cycle after initial delay
    setTimeout(startCycling, INITIAL_DELAY);

    // Also start on first scroll
    function onFirstScroll() {
      if (!feedStarted) {
        startCycling();
      }
      window.removeEventListener('scroll', onFirstScroll);
    }
    window.addEventListener('scroll', onFirstScroll, { passive: true });

    // Track user scrolling within the feed
    feed.addEventListener('scroll', () => {
      // If user scrolled away from top, pause auto-scroll-to-top
      userScrolling = feed.scrollTop > 10;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        userScrolling = false;
      }, 3000);
    }, { passive: true });

    // Pause cycling when phone is not visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting && cycleInterval) {
          clearInterval(cycleInterval);
          cycleInterval = null;
        } else if (entry.isIntersecting && feedStarted && !cycleInterval) {
          cycleInterval = setInterval(addNotification, CYCLE_SPEED);
        }
      });
    }, { threshold: 0.1 });
    observer.observe(feed);
  })();

  // ─── PLATFORM SELECTOR — morphs the device mockup + rotates the cube ───
  (function initPlatformSelector() {
    const cube = document.getElementById('platform-cube');
    const btns = document.querySelectorAll('.hero__platform-btn');
    const phone = document.querySelector('.hero__phone');
    if (!cube || !btns.length || !phone) return;

    const faceRotations = {
      front: 'rotateY(0deg)',        // iPhone
      right: 'rotateY(-90deg)',      // Android
      back:  'rotateY(-180deg)',     // Desktop
      left:  'rotateY(-270deg)',     // Web
      top:   'rotateX(-90deg)',      // Tablet
    };

    let mode = 'phone';
    let phoneOS = 'ios';
    let resumeTimer = null;

    function faceFor() {
      if (mode === 'phone') return phoneOS === 'ios' ? 'front' : 'right';
      if (mode === 'tablet') return 'top';
      if (mode === 'desktop') return 'back';
      return 'left';
    }

    function apply(btn) {
      // Morph the device mockup
      phone.classList.remove(
        'hero__phone--tablet', 'hero__phone--laptop',
        'hero__phone--web', 'hero__phone--android'
      );
      if (mode === 'tablet') phone.classList.add('hero__phone--tablet');
      else if (mode === 'desktop') phone.classList.add('hero__phone--laptop');
      else if (mode === 'web') phone.classList.add('hero__phone--web');
      else if (phoneOS === 'android') phone.classList.add('hero__phone--android');

      // Phone chip shows whichever OS is on screen
      const phoneBtn = document.querySelector('.hero__platform-btn[data-mode="phone"]');
      if (phoneBtn) phoneBtn.classList.toggle('is-android', phoneOS === 'android');

      // Land the cube on the matching face
      const current = getComputedStyle(cube).transform;
      cube.style.animation = 'none';
      cube.style.transform = current;
      void cube.offsetWidth;
      cube.classList.add('hero__cube--paused');
      cube.style.transform = faceRotations[faceFor()];

      btns.forEach(b => b.classList.remove('hero__platform-btn--active'));
      btn.classList.add('hero__platform-btn--active');

      // Resume auto-tumble after 5 seconds
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        cube.classList.remove('hero__cube--paused');
        cube.style.animation = '';
        cube.style.transform = '';
      }, 5000);
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const m = btn.dataset.mode;
        if (!m) return;
        // Clicking Phone again flips iPhone ↔ Android
        if (m === 'phone' && mode === 'phone') {
          phoneOS = phoneOS === 'ios' ? 'android' : 'ios';
        }
        mode = m;
        apply(btn);
      });
    });
  })();

  // ─── STICKY MOBILE CTA ───
  (function initStickyCta() {
    const bar = document.getElementById('sticky-cta');
    const intro = document.getElementById('hero-intro');
    if (!bar || !intro) return;

    const endCta = document.querySelector('.cta');
    let ticking = false;

    function measure() {
      ticking = false;
      const pastIntro = intro.getBoundingClientRect().bottom < 0;
      // Hide near the final CTA section so we don't double up
      const nearEnd = endCta
        ? endCta.getBoundingClientRect().top < window.innerHeight
        : false;
      bar.classList.toggle('is-visible', pastIntro && !nearEnd);
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        setTimeout(measure, 80);
      }
    }, { passive: true });
    measure();
  })();

  // ─── INTRO SCROLL CUE ───
  (function initIntroScroll() {
    const cue = document.getElementById('intro-scroll-cue');
    const target = document.querySelector('.hero__inner');
    if (!cue || !target) return;
    cue.addEventListener('click', () => {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
