      if (visible) requestAnimationFrame(tick);
    };

    /* ═════════ The chat ═════════ */
    const scroll = () => { msgs.scrollTop = msgs.scrollHeight; };
    const typingBubble = () => { const tb = document.createElement('div'); tb.className = 'ride__msg ride__msg--them ride__msg--typing'; tb.innerHTML = '<i></i><i></i><i></i>'; msgs.appendChild(tb); scroll(); return tb; };
    const say = async (text: string) => { const tb = typingBubble(); await wait(Math.min(900, 380 + text.length * 6)); tb.remove(); const m = document.createElement('div'); m.className = 'ride__msg ride__msg--them'; m.textContent = text; msgs.appendChild(m); scroll(); await wait(150); };
    const me = (text: string) => { const m = document.createElement('div'); m.className = 'ride__msg ride__msg--me'; m.textContent = text; msgs.appendChild(m); scroll(); };
    const card = async (html: string, cls = 'ride__card') => { const tb = typingBubble(); await wait(500); tb.remove(); const c = document.createElement('div'); c.className = cls; c.innerHTML = html; msgs.appendChild(c); scroll(); await wait(150); };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    let onType: ((v: string) => void) | null = null;
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value.trim(); if (!v || !onType) return; input.value = ''; onType(v); });
    const setInput = (placeholder: string, type = 'text') => { input.type = type; input.placeholder = placeholder; input.autocomplete = type === 'email' ? 'email' : type === 'tel' ? 'tel' : placeholder === 'Your first name' ? 'given-name' : placeholder === 'Business name' ? 'organization' : 'off'; };
    type Opt<X> = { label: string; value: X; tag?: string; cls?: string; html?: string };
    const ask = <X,>(opts: Opt<X>[], o: { placeholder?: string; type?: string; free?: (v: string) => X | null; echo?: (v: X, label: string) => string | null } = {}) => new Promise<X>((resolve) => {
      quick.innerHTML = ''; setInput(o.placeholder || 'Message', o.type || 'text');
      const done = (v: X, label: string) => { quick.innerHTML = ''; onType = null; const e = o.echo ? o.echo(v, label) : label; if (e) me(e); setInput('Message'); resolve(v); };
      opts.forEach((op, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = `ride__chip ${op.cls || ''}`; b.style.animationDelay = `${i * 35}ms`; b.innerHTML = op.html || `${esc(op.label)}${op.tag ? `<em>${esc(op.tag)}</em>` : ''}`; b.addEventListener('click', () => done(op.value, op.label)); quick.appendChild(b); });
      requestAnimationFrame(scroll);
      onType = (v) => { const r = o.free ? o.free(v) : null; if (r !== null && r !== undefined) done(r, v); else { me(v); say('Tap one of these?'); } };
      if (!opts.length || o.type) setTimeout(() => { if (matchMedia('(hover: hover)').matches) input.focus({ preventScroll: true }); }, 60);
    });
    const multi = (opts: { id: string; label: string }[], skipLabel = 'Skip') => new Promise<string[]>((resolve) => {
      quick.innerHTML = ''; const chosen = new Set<string>();
      const go = document.createElement('button'); go.type = 'button';
      const refresh = () => { go.textContent = chosen.size ? "Let's go" : skipLabel; go.className = `ride__chip ${chosen.size ? 'ride__chip--go' : 'ride__chip--ghost'}`; };
      opts.forEach((op, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'ride__chip'; b.style.animationDelay = `${i * 30}ms`; b.textContent = op.label; b.addEventListener('click', () => { chosen.has(op.id) ? chosen.delete(op.id) : chosen.add(op.id); b.classList.toggle('is-on'); refresh(); }); quick.appendChild(b); });
      quick.appendChild(go); refresh();
      go.addEventListener('click', () => { quick.innerHTML = ''; onType = null; const v = [...chosen]; me(v.length ? v.map((k) => opts.find((o) => o.id === k)!.label).join(', ') : skipLabel); resolve(v); });
      requestAnimationFrame(scroll);
      onType = (v) => { const tl = v.toLowerCase(); opts.forEach((op) => { if (op.label.toLowerCase().split(' ').some((w) => w.length > 3 && tl.includes(w))) chosen.add(op.id); }); quick.innerHTML = ''; onType = null; me(v); resolve([...chosen]); };
    });
    let meterNow = 0;
    const tickMeter = () => { meter.hidden = false; const to = quote().monthly, from = meterNow, s0 = performance.now(); const st = (tt: number) => { const k = Math.min(1, (tt - s0) / 700); meterNow = from + (to - from) * k; meterVal.textContent = `${money(meterNow)}/mo`; if (k < 1) requestAnimationFrame(st); }; requestAnimationFrame(st); };
    const send = async (event: string) => {
      const payload = { event, ...lead, codes: codesFor(), quote: quote(), page: location.pathname, at: new Date().toISOString() };
      (window as any).__rideLead = payload;
      const hook = root.dataset.webhook;
      if (!hook) { console.info('[ride] no webhook yet', payload); return; }
      try { await fetch(hook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }); } catch (e) { console.warn('[ride] send failed', e); }
    };
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const setClock = () => { const d = new Date(); clock.textContent = `${d.getHours() % 12 || 12}:${String(d.getMinutes()).padStart(2, '0')}`; };
    setClock(); setInterval(setClock, 30000);

    // A red light: one question, then green and go.
    const atLight = async (i: number, q: () => Promise<void>) => {
      S.stopIdx = i + 1; chapter(i + 1);
      await driveTo(STOPS[i + 1]);
      status.textContent = 'At the lights';
      await q();
      setLight(i, 'g'); status.textContent = 'On the way';
      await wait(300);
    };

    /* ═════════ The ride ═════════ */
    const run = async () => {
      chapter(0); status.textContent = 'Pulling up';
      await driveTo(PICK_X);
      // She steps out, opens the umbrella and comes round to you.
      await openDoor(doorF, true);
      gl.visible = true; gl.position.set(PICK_X + 0.6, 0.12, 2.75); face(gl, PICK_X - 0.2, 4.3);
      await openDoor(doorF, false);
      await tween(500, (k) => setUmbrella(k));
      await walk(gl, PICK_X + 0.15, 4.35, 1000);
      face(gl, you.position.x, you.position.z); face(you, gl.position.x, gl.position.z);
      await tween(400, (k) => { paper.position.y = lerp(2.32, 1.3, k); paper.rotation.z = lerp(0.08, 1.3, k); you.userData.arms[0].rotation.z = lerp(2.6, 0.1, k); you.userData.arms[1].rotation.z = lerp(2.6, 0.1, k); });
      paper.visible = false;
      status.textContent = 'At the kerb';
      await say(`Hi there, I'm ${LEAD} from DUSA, here to get you on your way. May I ask your name?`);
      lead.name = await ask<string>([], { placeholder: 'Your first name', free: (v) => v.trim().split(/\s+/)[0].replace(/^./, (c) => c.toUpperCase()) });
      await say(`Nice to meet you, ${lead.name}.`);
      // White glove: she opens your door, you hop in, she closes it, folds the umbrella and gets in.
      await walk(gl, PICK_X - 1.3, 3.65, 600);
      face(gl, PICK_X - 0.6, 2.5);
      await openDoor(doorR, true);
      await walk(you, PICK_X - 0.6, 3.05, 650);
      await tween(320, (k) => you.scale.setScalar(lerp(1, 0.01, k))); you.visible = false;
      await openDoor(doorR, false);
      await walk(gl, PICK_X + 0.5, 3.15, 700);
      await tween(380, (k) => setUmbrella(1 - k));
      await openDoor(doorF, true);
      await tween(280, (k) => gl.scale.setScalar(lerp(1, 0.01, k))); gl.visible = false;
      await openDoor(doorF, false);
      setGloom(0.85);
      await say('Where would you like to go?');
      // Light 1: the destination.
      S.stopIdx = 1; chapter(1);
      const goals = multi(GOALS.map((g) => ({ id: g.id, label: g.label })));
      await driveTo(STOPS[1]); status.textContent = 'At the lights';
      lead.goals = await goals; lead.needs = needsFrom(lead.goals);
      setLight(0, 'g'); status.textContent = 'On the way'; setGloom(0.65); await wait(300);
      // Light 2: line of work.
      await atLight(1, async () => {
        await say('What line of work are you in?');
        const ind = await ask([...INDUSTRIES.map((i) => ({ label: i.label, value: i.id })), { label: 'Skip', value: 'other', cls: 'ride__chip--ghost' }], { placeholder: 'Or type it', free: (v) => { lead.industryText = v; return matchOpt(v, INDUSTRIES)?.id || 'other'; } });
        lead.industry = ind; const I = INDUSTRIES.find((i) => i.id === ind)!;
        if (ind !== 'other') await say(`We look after plenty of ${I.plural}.`);
        setGloom(0.45);
      });
      // Light 3: how you ride (the package).
      await atLight(2, async () => {
        await say('How would you like to get there?');
        let chosen: string | null = null;
        while (!chosen) {
          const pick = await ask<string>([
            ...SEATS.map((s) => ({ label: s.name, value: s.id, cls: 'ride__chip--pkg', html: `<b>${esc(s.name)}</b>${s.tag ? `<em>${esc(s.tag)}</em>` : ''}<small><span>${esc(s.line)}</span><i>from ${money(quote({ seat: s.id, distance: 'S' }).monthly)}</i></small>` })),
            { label: 'Tell me more', value: 'more', cls: 'ride__chip--ghost' },
          ], { free: (v) => (/more|explain|what|differ/i.test(v) ? 'more' : matchOpt(v, SEATS)?.id || null) });
          if (pick === 'more') await card(`<dl>${SEATS.map((s) => `<div><dt>${esc(s.name)}</dt><dd>${esc(s.more)}</dd></div>`).join('')}</dl>`);
          else chosen = pick;
        }
        lead.seat = chosen;
        setGloom(0.25);
      });
      // Light 4: pace (the size), with the price for each.
      await atLight(3, async () => {
        await say('And how fast?');
        lead.distance = await ask(PACES.map((p) => ({ label: p.label, value: p.id, html: `${esc(p.label)} <small style="opacity:.7">${money(quote({ distance: p.id }).monthly)}/mo</small>` })), { free: (v) => (/fastest|all|full/i.test(v) ? 'L' : /fast/i.test(v) ? 'M' : /steady|slow|start/i.test(v) ? 'S' : null) });
        tickMeter(); send('profile');
        setGloom(0);
      });
      // Home.
      S.stopIdx = 5; chapter(5); status.textContent = 'Nearly home';
      tween(2500, (k) => (S.homeK = k));
      await driveTo(STOPS[5]);
      const q = quote(); lead.quote = q;
      await say(`Here we are, ${lead.name}. Your fare:`);
      await card(`<h4>DUSA · YOUR ENGINE <span>${esc(SEAT_NAME[lead.seat])}</span></h4><ul>${q.lines.map((l) => `<li class="${l.save ? 'is-save' : ''}"><span>${esc(l.label)}</span><b>${l.oneoff ? money(l.oneoff) + ' once' : money(l.price)}</b></li>`).join('')}</ul><div class="t"><span>Monthly</span><b>${money(q.monthly)}</b></div><div class="s"><span>Set-up</span><b>${q.setup ? money(q.setup) : 'None'}</b></div><small>AUD ex GST. Month to month.${q.nudge ? `<b>${esc(q.nudge)}</b>` : ''}${lead.seat !== 'self' ? `<b>Or drive yourself from ${money(cat.plans.starter)}/mo.</b>` : ''}</small>`, 'ride__fare');
      status.textContent = 'Home';
      await say('Where should I send it?');
      lead.email = await ask<string>([{ label: 'Not now', value: '', cls: 'ride__chip--ghost' }], { placeholder: 'Your email', type: 'email', free: (v) => (/\S+@\S+\.\S+/.test(v) ? v : null) });
      if (lead.email) {
        await say('And the business name?');
        lead.business = await ask<string>([{ label: 'Skip', value: '', cls: 'ride__chip--ghost' }], { placeholder: 'Business name', free: (v) => v });
        send('quote');
        await say(`Sent. Mobile for a quick call, ${lead.name}?`);
        lead.phone = await ask<string>([{ label: "I'll call you", value: '', cls: 'ride__chip--ghost' }], { placeholder: 'Mobile number', type: 'tel', free: (v) => (v.replace(/\D/g, '').length >= 8 ? v : null) });
        if (lead.phone) send('callback');
      }
      await say(lead.phone ? 'Perfect. Talk soon.' : `Call us any time: ${PHONE}.`);
      const doneFor = lead.seat === 'back' || lead.seat === 'front';
      const end = await ask([
        { label: doneFor ? 'Pay set-up and book kick-off' : 'Start my free trial', value: 'go', cls: 'ride__chip--go' },
        { label: `Talk to ${LEAD} (10 min)`, value: 'talk' },
        ...(lead.seat !== 'self' ? [{ label: `Drive myself, from ${money(cat.plans.starter)}`, value: 'self', cls: 'ride__chip--ghost' }] : []),
      ], { echo: () => null });
      send(end);
      if (end === 'talk') window.open(root.dataset.lead, '_blank', 'noopener');
      else location.href = end === 'go' && doneFor ? (root.dataset.book || '/start') : '/start';
    };

    let started = false;
    new IntersectionObserver((es) => es.forEach((e) => {
      const was = visible; visible = e.isIntersecting;
      if (visible && !was) { last = performance.now(); requestAnimationFrame(tick); }
      if (visible && !started && e.intersectionRatio > 0.45) { started = true; run(); }
    }), { threshold: [0, 0.45] }).observe(stage);
    renderer.render(scene, cam);
    if (location.hostname === 'localhost') (window as any).__ride = { lead, quote, codesFor, S };
  });
</script>
