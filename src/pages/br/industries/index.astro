---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { INDUSTRY_ICONS } from '../../../config/industry-icons';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';

const industries = [
  {
    title: 'Imobiliario',
    desc: 'Gestao de pipeline, follow-ups automaticos de visitas, e matching de compradores para corretores que querem fechar mais negocios.',
    slug: '/br/industries/real-estate',
  },
  {
    title: 'Academias e Fitness',
    desc: 'Onboarding de alunos, lembretes de aulas, campanhas de recuperacao e rastreamento de indicacoes para reduzir evasao e lotar suas aulas.',
    slug: '/br/industries/gyms',
  },
  {
    title: 'Servicos Gerais',
    desc: 'Retorno automatico de chamadas perdidas, pipelines de orcamento, agendamento de servicos e lembretes de cobranca para profissionais que estao sempre em campo.',
    slug: '/br/industries/tradies',
  },
  {
    title: 'Restaurantes',
    desc: 'Lembretes de reservas, solicitacao de avaliacoes pos-visita, campanhas de aniversario e programas de fidelidade digital.',
    slug: '/br/industries/restaurants',
  },
  {
    title: 'Saloes e Spas',
    desc: 'Agendamento online, lembretes automaticos, campanhas de reagendamento e rastreamento de preferencias para preencher todas as cadeiras.',
    slug: '/br/industries/salons',
  },
  {
    title: 'Contadores',
    desc: 'Automacao de coleta de documentos, lembretes de prazos e engajamento continuo com clientes alem da temporada de impostos.',
    slug: '/br/industries/accountants',
  },
  {
    title: 'Clinicas Odontologicas',
    desc: 'Lembretes de retorno, captacao de novos pacientes, geracao de avaliacoes e acompanhamento de planos de tratamento no piloto automatico.',
    slug: '/br/industries/dentists',
  },
  {
    title: 'Fotografos',
    desc: 'Respostas automaticas a consultas, fluxos de contratos, lembretes de sessoes, entrega de galerias e sequencias de upsell de impressoes.',
    slug: '/br/industries/photographers',
  },
  {
    title: 'Construcao Civil',
    desc: 'Rastreamento de leads, follow-ups de orcamento, comunicacao de marcos do projeto e cobranca de pagamentos para construtores.',
    slug: '/br/industries/construction',
  },
  {
    title: 'Personal Trainers',
    desc: 'Funis de isca digital, agendamento de consultas, showcases de transformacao e check-ins automaticos com clientes.',
    slug: '/br/industries/personal-trainers',
  },
  {
    title: 'Servicos de Limpeza',
    desc: 'Gestao de agendamentos recorrentes, follow-ups de qualidade, escala de equipes e campanhas de upsell para empresas de limpeza.',
    slug: '/br/industries/cleaning-services',
  },
  {
    title: 'Escritorios de Advocacia',
    desc: 'Automacao de formularios de admissao, atualizacoes de status de casos, rastreamento de indicacoes e conteudo de lideranca dentro da conformidade.',
    slug: '/br/industries/law-firms',
  },
  {
    title: 'Administradores de Imoveis',
    desc: 'Automacao do ciclo de vida do inquilino, pipelines de solicitacao de manutencao, lembretes de aluguel e campanhas de renovacao de contrato.',
    slug: '/br/industries/property-managers',
  },
  {
    title: 'Oficinas Mecanicas',
    desc: 'Automacao de lembretes de revisao, campanhas sazonais, geracao de avaliacoes e programas de fidelidade para mecanicos.',
    slug: '/br/industries/auto-repair',
  },
  {
    title: 'Coaches e Consultores',
    desc: 'Funis de chamada de descoberta, sequencias de onboarding, agendamento de sessoes e coleta de depoimentos para escalar sua pratica.',
    slug: '/br/industries/coaches',
  },
  {
    title: 'E-commerce',
    desc: 'Sequencias pos-compra, automacao de avaliacoes, fluxos de cross-sell, segmentacao VIP e recompensas de aniversario.',
    slug: '/br/industries/ecommerce',
  },
];
---

<BaseLayout
  t={tData}
  title="Setores | DUSA.studio"
  description="O DUSA foi feito para o seu setor. Veja como nossa plataforma de crescimento funciona para imoveis, servicos, academias, restaurantes, saloes, dentistas e muito mais."
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Setores</span>
        <h1>Feito para o <span class="gradient-text">seu</span> setor</h1>
        <p class="ind-hero__sub">
          Cada negocio e diferente. Por isso o DUSA se adapta ao seu jeito de trabalhar, com pipelines, automacoes e fluxos de trabalho projetados para o seu setor especifico. Encontre o seu abaixo.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Industry Grid ═══ -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={INDUSTRY_ICONS[ind.slug.split('/').pop()]} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">Saiba mais &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Nao encontrou seu setor?</h2>
        <p class="ind-cta__desc">O DUSA funciona para qualquer negocio baseado em servicos. Entre em contato e vamos mostrar como ele se encaixa no seu fluxo de trabalho.</p>
        <div class="ind-cta__buttons">
          <a href="/br/start" class="btn btn--primary">Comece Agora</a>
          <a href="/br/contact" class="btn btn--outline">Fale Conosco</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dusa.studio/" },
    { "@type": "ListItem", "position": 2, "name": "Setores", "item": "https://dusa.studio/br/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
