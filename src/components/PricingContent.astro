    { name: 'Mighty Networks', cost: 99 },
  ]},
  { feature: 'Call tracking', tools: [
    { name: 'CallRail', cost: 70 },
    { name: 'CallTrackingMetrics', cost: 65 },
    { name: 'WhatConverts', cost: 55 },
  ]},
];

/* Convert tool costs and prioritise regional competitors */
const competitorNames = new Set(competitors.map((c: any) => c.name.toLowerCase()));
const displayReplacements = replacements.map(r => {
  const converted = r.tools.map(t => ({ ...t, displayCost: convertToolCost(t.cost) }));
  /* Sort: tools that match regional competitors float to the front */
  converted.sort((a, b) => {
    const aLocal = competitorNames.has(a.name.toLowerCase()) ? 1 : 0;
    const bLocal = competitorNames.has(b.name.toLowerCase()) ? 1 : 0;
    return bLocal - aLocal;
  });
  return { ...r, tools: converted };
});

/* Compute median cost for each row (used by "Other" option) */
function median(arr: number[]) {
  const s = [...arr].sort((a, b) => a - b);
  const mid = Math.floor(s.length / 2);
  return s.length % 2 !== 0 ? s[mid] : Math.round((s[mid - 1] + s[mid]) / 2);
}
const medianCosts = displayReplacements.map(r => median(r.tools.map(t => t.displayCost)));

/* Default selection: first tool in each row */
const defaultTotal = displayReplacements.reduce((sum, r) => sum + r.tools[0].displayCost, 0);

