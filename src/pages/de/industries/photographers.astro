---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';
---

<BaseLayout t={tData} title="Kundenverwaltung für Fotografen | DUSA . studio" description="Automatisieren Sie Anfrageantworten, Verträge, Shooting-Erinnerungen und Galerie-Zustellung. DUSA bietet Fotografen ein komplettes Kundenverwaltungssystem von der ersten Anfrage bis zur Bestellung.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://dusa.studio/de/" },
      { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://dusa.studio/de/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Fotografen", "item": "https://dusa.studio/de/industries/photographers/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Fotografen</span>
        <h1>Mehr Kunden gewinnen und<br/><span class="gradient-text">keine Anfrage mehr verlieren</span></h1>
        <p class="industry-hero__sub">DUSA automatisiert Ihre Anfrageantworten, Verträge, Shooting-Erinnerungen und Galerie-Zustellung, damit Sie mehr Zeit hinter der Kamera verbringen können.</p>
        <div class="industry-hero__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Demo buchen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">Das Problem</span>
      <h2>Kommt Ihnen das bekannt vor?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">⏳</div>
          <h3>Langsame Anfrageantworten kosten Buchungen</h3>
          <p>Ein potenzieller Kunde füllt Ihr Formular am Sonntagabend aus. Sie antworten erst am Montagnachmittag. Bis dahin hat er bereits jemand anderen gebucht.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📝</div>
          <h3>Manueller Versand von Verträgen und Fragebögen</h3>
          <p>Jede Buchung bedeutet, sich einzuloggen, einen Vertrag zu senden, dann einen Fragebogen, dann eine Erinnerung. Das summiert sich auf Stunden pro Woche.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🔔</div>
          <h3>Kein Erinnerungssystem für Shootings</h3>
          <p>Kunden vergessen Shooting-Details, kommen zu spät oder verpassen Vorbereitungsschritte, weil es kein automatisches Erinnerungssystem gibt.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">💰</div>
          <h3>Verpasste Upselling-Möglichkeiten</h3>
          <p>Sie liefern die Galerie ab und machen weiter. Alben, Prints und weitere Shootings werden nie angeboten, weil es kein Follow-up-System gibt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">Die Lösung</span>
      <h2>So funktioniert DUSA für <span class="gradient-text">Fotografen</span></h2>
      <p class="solution__intro">Eine Plattform übernimmt Anfrageantworten, Verträge, Erinnerungen, Galerie-Zustellung und Upselling-Sequenzen.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Sofortige Anfrage-Autoresponder</h3>
          <p>Jede Anfrage erhält eine sofortige, personalisierte Antwort mit Ihrem Preisleitfaden und Ihrer Verfügbarkeit. Keine verlorenen Leads mehr.</p>
        </div>
        <div class="solution-card">
          <h3>Automatisierung von Verträgen und Fragebögen</h3>
          <p>Sobald ein Kunde bucht, werden Vertrag und Vorbefragungsbogen automatisch versendet. Unterschrieben und zurückgeschickt, ohne dass Sie einen Finger rühren.</p>
        </div>
        <div class="solution-card">
          <h3>Shooting-Erinnerungen</h3>
          <p>Automatische Erinnerungen mit Ortsangaben, Outfit-Tipps und Vorbereitungschecklisten werden vor jedem Shooting versendet.</p>
        </div>
        <div class="solution-card">
          <h3>Galerie-Zustellung</h3>
          <p>Wenn die Galerie fertig ist, erhalten Kunden eine professionelle Zustellungs-E-Mail mit Anzeigeanweisungen und Download-Links.</p>
        </div>
        <div class="solution-card">
          <h3>Print- und Album-Upselling-Sequenzen</h3>
          <p>Nach der Galerie-Zustellung bieten zeitgesteuerte Follow-ups Alben, Prints und Wandbilder an. Machen Sie aus jedem Shooting zusätzlichen Umsatz.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Ihre Pipeline</span>
      <h2>Jeder Kunde, jede Phase, <span class="gradient-text">perfekt organisiert</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Anfrage</h3>
          <p>Lead kommt rein. Autoresponder sendet Preise und nächste Schritte.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Beratung</h3>
          <p>Kennenlerngespräch oder Termin gebucht. Der Kunde erfährt mehr über Ihren Stil und Ihre Pakete.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Gebucht</h3>
          <p>Vertrag unterschrieben und Anzahlung geleistet. Fragebogen und Shooting-Vorbereitung werden automatisch versendet.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Shooting abgeschlossen</h3>
          <p>Shooting erledigt. Der Kunde erhält eine Dankesnachricht und den Bearbeitungszeitplan.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Galerie zugestellt</h3>
          <p>Bearbeitete Galerie versendet. Bewertungsanfrage und Upselling-Sequenz starten.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Print-Bestellung</h3>
          <p>Alben, Prints oder Wandbilder bestellt. Empfehlungsprogramm-Angebot wird versendet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Ergebnisse</span>
      <h2>Entwickelt für Fotografen, die <span class="gradient-text">wachsen</span> wollen</h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">50%</div>
          <p>höhere Buchungsrate durch sofortige Anfrageantworten</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">5 Std.</div>
          <p>pro Woche bei Verwaltungsaufgaben durch automatisierte Workflows eingespart</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">30%</div>
          <p>der Kunden bestellen Prints oder Alben dank Upselling-Sequenzen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Bereit, Ihren Kunden-Workflow zu automatisieren?</h2>
        <p>Bringen Sie Ihr Fotografie-Business in weniger als einer Woche mit DUSA zum Laufen.</p>
        <div class="final-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/photographer-client-management" class="btn btn--outline">Leitfaden lesen</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
