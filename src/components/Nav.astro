<script>
  // Scroll effect
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('nav--scrolled', window.scrollY > 50);
  });

  // Mobile toggle
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('active');
    toggle?.classList.toggle('active');
  });

  // Close mobile menu on link click (but NOT the accordion toggle)
  document.querySelectorAll('.nav__mobile-link:not(.nav__mobile-link--accordion)').forEach(link => {
    link.addEventListener('click', () => {
      mobile?.classList.remove('active');
      toggle?.classList.remove('active');
    });
  });
  // Also close menu when clicking a sub-link inside the accordion
  document.querySelectorAll('.nav__mobile-sub-link').forEach(link => {
    link.addEventListener('click', () => {
      mobile?.classList.remove('active');
      toggle?.classList.remove('active');
    });
  });

  // ─── INDUSTRIES DROPDOWN (Desktop) ───
  const indWrap = document.getElementById('industries-wrap');
  const indToggle = document.getElementById('industries-toggle');
  indToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    indWrap?.classList.toggle('is-open');
    indToggle?.setAttribute('aria-expanded', indWrap?.classList.contains('is-open') ? 'true' : 'false');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (indWrap && !indWrap.contains(e.target as Node)) {
      indWrap.classList.remove('is-open');
      indToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && indWrap?.classList.contains('is-open')) {
      indWrap.classList.remove('is-open');
      indToggle?.setAttribute('aria-expanded', 'false');
      indToggle?.focus();
    }
  });

  // ─── INDUSTRIES ACCORDION (Mobile) ───
  const mobileIndWrap = document.getElementById('mobile-industries');
  const mobileIndToggle = document.getElementById('mobile-industries-toggle');
  mobileIndToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    mobileIndWrap?.classList.toggle('is-open');
    mobileIndToggle?.setAttribute('aria-expanded', mobileIndWrap?.classList.contains('is-open') ? 'true' : 'false');
  });

  // ─── REGION SELECTOR ───
  const regionToggle = document.getElementById('region-toggle');
  const regionDropdown = document.getElementById('region-dropdown');

  // Known regions and which pages each has
  const regionPrefixes = ['au','us','uk','es','mx','br','fr','de'];
  const regionPages = {
    au: ['pricing','services','about','blog','contact','onboarding','start','privacy-policy','terms','thank-you','industries'],
    us: ['pricing'],
    uk: ['pricing'],
    es: ['index','pricing','services','about','contact','onboarding','start','blog','privacy-policy','terms','thank-you','industries'],
    mx: ['index','pricing','services','about','contact','onboarding','start','blog','privacy-policy','terms','thank-you','industries'],
    br: ['index','pricing','services','about','contact','onboarding','start','blog','privacy-policy','terms','thank-you','industries'],
    fr: ['index','pricing','services','about','contact','onboarding','start','blog','privacy-policy','terms','thank-you','industries'],
    de: ['index','pricing','services','about','contact','onboarding','start','blog','privacy-policy','terms','thank-you','industries'],
  };

  // Detect current region and page path from URL
  function parseCurrentPath() {
    const path = window.location.pathname.replace(/\/$/, '') || '';
    const segments = path.split('/').filter(Boolean);
    // Check if the first segment is a known region prefix
    if (segments.length > 0 && regionPrefixes.includes(segments[0]) && segments[0] !== 'au') {
      const currentRegion = segments[0];
      const pagePath = segments.slice(1).join('/') || 'index';
      return { region: currentRegion, page: pagePath };
    }
    // Default region (au) — pages are at root
    const pagePath = segments.join('/') || 'index';
    return { region: 'au', page: pagePath };
  }

  // Build new URL for target region, keeping the same page where possible
  function buildRegionUrl(targetRegion, currentPage) {
    const targetPages = regionPages[targetRegion] || [];
    // Determine the base page name (e.g., 'blog/some-post' → check 'blog')
    const basePage = currentPage.split('/')[0] || 'index';
    const pageExists = targetPages.includes(basePage);
    // For blog posts specifically, check if the region has a blog directory
    const isBlogPost = currentPage.startsWith('blog/');

    let targetPage;
    if (pageExists || (isBlogPost && targetPages.includes('blog'))) {
      targetPage = currentPage;
    } else {
      // Fallback: go to the same page the region supports, or its root
      if (targetPages.includes('pricing')) {
        targetPage = 'pricing';
      } else {
        targetPage = 'index';
      }
    }

    if (targetRegion === 'au') {
      // AU pages are at root
      if (targetPage === 'index') return '/';
      return '/' + targetPage;
    }
    // All other regions are prefixed
    if (targetPage === 'index') return '/' + targetRegion + '/';
    return '/' + targetRegion + '/' + targetPage;
  }

  // ─── Seamless region switch: keep the reader's place on the page ───
  // Pages are the same components in every locale, so we anchor to the
  // Nth <section> plus a fractional offset inside it. That survives the
  // height differences that translated copy creates. If the target region
  // doesn't have this page (US/UK only have pricing), no restore happens.
  const SCROLL_KEY = 'dusa-region-scroll';

  function captureScrollState(currentPage) {
    try {
      const y = window.scrollY;
      const state = { page: currentPage, y: y, ts: Date.now() };
      if (y > 80) {
        const secs = document.querySelectorAll('main section');
        const probe = y + window.innerHeight * 0.35;
        let anchor = null;
        for (let i = 0; i < secs.length; i++) {
          const r = secs[i].getBoundingClientRect();
          const top = r.top + y;
          if (top <= probe) anchor = { el: secs[i], top: top, h: r.height };
          else break;
        }
        if (anchor) {
          // Identify the section by its first class + occurrence count, so
          // locales with a section more or less still map correctly.
          const cls = (typeof anchor.el.className === 'string' ? anchor.el.className : '').split(' ')[0] || '';
          let nth = 0;
          for (let i = 0; i < secs.length; i++) {
            if (secs[i] === anchor.el) break;
            const c = (typeof secs[i].className === 'string' ? secs[i].className : '').split(' ')[0] || '';
            if (c === cls) nth++;
          }
          state.cls = cls;
          state.nth = nth;
          state.frac = anchor.h > 0 ? Math.max(0, (y - anchor.top) / anchor.h) : 0;
        }
      }
      sessionStorage.setItem(SCROLL_KEY, JSON.stringify(state));
    } catch (e) { /* storage unavailable: switch still works, just from the top */ }
  }

  function restoreScrollState(currentPage) {
    let state = null;
    try {
      state = JSON.parse(sessionStorage.getItem(SCROLL_KEY) || 'null');
      sessionStorage.removeItem(SCROLL_KEY);
    } catch (e) { return; }
    if (!state || Date.now() - state.ts > 20000) return;
    if (state.page !== currentPage || !(state.y > 80)) return;

    const de = document.documentElement;
    de.style.setProperty('scroll-behavior', 'auto', 'important');

    function targetY() {
      if (state.cls) {
        const secs = document.querySelectorAll('main section');
        let seen = 0;
        for (let i = 0; i < secs.length; i++) {
          const c = (typeof secs[i].className === 'string' ? secs[i].className : '').split(' ')[0] || '';
          if (c === state.cls) {
            if (seen === (state.nth || 0)) {
              const r = secs[i].getBoundingClientRect();
              return Math.max(0, r.top + window.scrollY + (state.frac || 0) * r.height);
            }
            seen++;
          }
        }
      }
      return state.y;
    }

    window.scrollTo(0, targetY());
    // Re-align once fonts/images settle, then hand scroll behavior back to CSS
    const settle = function () {
      setTimeout(function () {
        window.scrollTo(0, targetY());
        de.style.removeProperty('scroll-behavior');
      }, 250);
    };
    if (document.readyState === 'complete') settle();
    else window.addEventListener('load', settle, { once: true });
  }

  function switchRegion(targetRegion) {
    const { region: currentRegion, page: currentPage } = parseCurrentPath();
    if (targetRegion === currentRegion) return;
    const newUrl = buildRegionUrl(targetRegion, currentPage);
    captureScrollState(currentPage);
    window.location.href = newUrl;
  }

  // Run restore as soon as the nav script executes on the destination page
  restoreScrollState(parseCurrentPath().page);

  regionToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    regionDropdown?.classList.toggle('active');
  });

  // Desktop region buttons
  document.querySelectorAll('.nav__region-option').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const region = btn.getAttribute('data-region');
      if (region) switchRegion(region);
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!document.getElementById('region-wrap')?.contains(e.target)) {
      regionDropdown?.classList.remove('active');
    }
  });

  // Highlight current region and update nav links for the active region
  (function initRegionState() {
    const { region } = parseCurrentPath();
    // Highlight active region in dropdown
    document.querySelectorAll('.nav__region-option').forEach(btn => {
      if (btn.getAttribute('data-region') === region) {
        btn.classList.add('nav__region-option--active');
      }
    });
    const mobileSel = document.getElementById('mobile-region-select');
    if (mobileSel) mobileSel.value = region;

    // Rewrite nav links to point to the correct regional paths
    const prefix = (region === 'au') ? '' : '/' + region;
    const pages = regionPages[region] || [];
    document.querySelectorAll('[data-page]').forEach(link => {
      const page = link.getAttribute('data-page');
      // Special case: "home" links to the region root
      if (page === 'home') {
        const hash = link.getAttribute('data-hash') || '';
        link.href = ((region === 'au') ? '/' : '/' + region + '/') + hash;
        return;
      }
      // For nested paths like "industries/real-estate", check the base segment
      const basePage = page.split('/')[0] || page;
      if (pages.includes(basePage) || region === 'au') {
        link.href = prefix + '/' + page;
      } else {
        // Page doesn't exist in this region, link to root AU version
        link.href = '/' + page;
      }
    });

    // Also update the logo link to the region root
    const logoLink = document.querySelector('.nav__logo');
    if (logoLink) {
      logoLink.href = (region === 'au') ? '/' : '/' + region + '/';
    }

    // Update the Get Started CTA link
    const ctaLink = document.querySelector('.nav__cta');
    if (ctaLink && region !== 'au' && pages.includes('start')) {
      ctaLink.href = prefix + '/start';
    }
  })();

  // Mobile region select
  const mobileRegionSelect = document.getElementById('mobile-region-select');
  mobileRegionSelect?.addEventListener('change', (e) => {
    switchRegion(e.target.value);
  });

  // ─── THEME TOGGLE ───
  function toggleTheme() {
    const html = document.documentElement;
    const isLight = html.getAttribute('data-theme') === 'light';
    const mc = document.querySelector('meta[name="theme-color"]');

    if (isLight) {
      html.removeAttribute('data-theme');
      localStorage.setItem('dusa-theme', 'dark');
      if (mc) mc.setAttribute('content', '#0C0E14');
    } else {
      html.setAttribute('data-theme', 'light');
      localStorage.setItem('dusa-theme', 'light');
      if (mc) mc.setAttribute('content', '#F7F4EF');
    }
  }

  // Desktop toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', toggleTheme);

  // Mobile dropdown toggle
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
  const mobileThemeBtn = mobileThemeToggle?.querySelector('.nav__theme-toggle');
  mobileThemeBtn?.addEventListener('click', toggleTheme);

  // Mobile bar toggle (top nav)
  const barThemeToggle = document.getElementById('bar-theme-toggle');
  barThemeToggle?.addEventListener('click', toggleTheme);
</script>
