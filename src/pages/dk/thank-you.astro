---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThankYouPage from '../../components/pages/ThankYouPage.astro';
import { getRegion } from '../../i18n/regions.js';
import t from '../../i18n/translations/da.json';
const region = getRegion('dk');
---

<BaseLayout t={t} title={t.thankYou.metaTitle} description={t.thankYou.metaDesc} lang={region.htmlLang} ogLocale={region.ogLocale} region="dk">
  <ThankYouPage t={t} regionKey="dk" />
</BaseLayout>
