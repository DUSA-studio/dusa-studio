---
import BaseLayout from '../../layouts/BaseLayout.astro';
import t from '../../i18n/translations/en.json';
---

<BaseLayout t={t} title="Customer Engagement for Restaurants | DUSA.studio" description="Fill tables, reduce no-shows, and turn first-time diners into regulars. Reservation reminders, review automation, birthday campaigns, and loyalty programs for restaurants.">

  <!-- Hero -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Restaurants</span>
        <h1>Fill tables.<br/>Build <span class="gradient-text">regulars</span>.</h1>
        <p class="ind-hero__sub">Most restaurants have no system for staying connected with guests after they leave. DUSA brings them back with automated engagement that feels personal, not pushy.</p>
        <a href="/start" class="btn btn--primary">Get Started Free</a>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ind-pain section section--dark">
    <div class="container">
      <h2><span class="gradient-text">Sound familiar?</span></h2>
      <div class="ind-pain__cards">

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
              <path d="M16 2v4"/>
              <path d="M8 2v4"/>
              <path d="M3 10h18"/>
            </svg>
          </div>
          <h3 class="ind-pain__card-title">No-show reservations</h3>
          <p class="ind-pain__card-desc">Guests book and never turn up. Empty tables on a busy night mean lost revenue you cannot recover.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <path d="M22 6l-10 7L2 6"/>
            </svg>
          </div>
          <h3 class="ind-pain__card-title">No post-visit engagement</h3>
          <p class="ind-pain__card-desc">A guest has a great meal and leaves. You never hear from them again because there is no follow-up system.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="ind-pain__card-title">Low review counts</h3>
          <p class="ind-pain__card-desc">You know your food is great, but your Google listing does not reflect it. Asking for reviews feels awkward and inconsistent.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3 class="ind-pain__card-title">No birthday or loyalty program</h3>
          <p class="ind-pain__card-desc">You have no way to reward repeat customers or surprise them on their birthday. Loyalty lives in their head, not your system.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ind-solution section section--dark">
    <div class="container">
      <h2>How DUSA works for <span class="gradient-text">restaurants</span></h2>
      <p class="ind-solution__sub">From the first booking to the fifth visit and beyond.</p>
      <div class="ind-solution__grid">

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Reservation reminders</h3>
          <p class="ind-solution__card-desc">Automatic SMS and email reminders before every booking. Guests confirm or cancel with a tap, so your floor plan stays accurate.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Post-visit review requests</h3>
          <p class="ind-solution__card-desc">After a guest dines, DUSA sends a friendly review request. Make it easy for happy customers to share their experience on Google.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Birthday campaigns</h3>
          <p class="ind-solution__card-desc">Capture guest birthdays and send a personalised offer when the day arrives. A free dessert or discount brings them back with friends.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 12v10H4V12"/>
              <path d="M2 7h20v5H2z"/>
              <path d="M12 22V7"/>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Digital loyalty</h3>
          <p class="ind-solution__card-desc">Replace the old stamp card with a digital loyalty program. Track visits, reward milestones, and keep customers coming back without the paper.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
              <path d="M16 2v4"/>
              <path d="M8 2v4"/>
              <path d="M3 10h18"/>
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Seasonal promotions</h3>
          <p class="ind-solution__card-desc">Launch targeted campaigns for Valentine's Day, Mother's Day, or your own events. Reach the right guests at the right time with SMS and email.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ind-pipeline section section--dark">
    <div class="container">
      <h2>The guest <span class="gradient-text">journey</span></h2>
      <div class="ind-pipeline__track">

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">01</div>
          <h3 class="ind-pipeline__step-title">First Visit</h3>
          <p class="ind-pipeline__step-desc">A new guest books and dines. DUSA captures their details and sends a thank-you message with a review request.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">02</div>
          <h3 class="ind-pipeline__step-title">Repeat Customer</h3>
          <p class="ind-pipeline__step-desc">The guest returns. DUSA tracks visit frequency and begins building their loyalty profile.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">03</div>
          <h3 class="ind-pipeline__step-title">Loyalty Member</h3>
          <p class="ind-pipeline__step-desc">After multiple visits, the guest unlocks rewards. Birthday offers and exclusive invites keep them engaged.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">04</div>
          <h3 class="ind-pipeline__step-title">VIP</h3>
          <p class="ind-pipeline__step-desc">Your most loyal regulars. Priority booking, special event access, and personalised offers make them feel valued.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">05</div>
          <h3 class="ind-pipeline__step-title">Brand Ambassador</h3>
          <p class="ind-pipeline__step-desc">Your biggest fans leave reviews, share on social, and bring friends. DUSA rewards them with exclusive perks and early access.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">06</div>
          <h3 class="ind-pipeline__step-title">Win-Back</h3>
          <p class="ind-pipeline__step-desc">A regular has not visited in a while. DUSA triggers a personalised offer to bring them back through the door.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ind-stats section section--dark">
    <div class="container">
      <div class="ind-stats__grid">

        <div class="ind-stats__card">
          <span class="ind-stats__number">20%</span>
          <span class="ind-stats__label">of reservations result in no-shows without reminders</span>
        </div>

        <div class="ind-stats__card">
          <span class="ind-stats__number">70%</span>
          <span class="ind-stats__label">of diners check Google reviews before choosing a restaurant</span>
        </div>

        <div class="ind-stats__card">
          <span class="ind-stats__number">5x</span>
          <span class="ind-stats__label">more likely to return with a loyalty program</span>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ind-cta section section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2>Ready to fill more tables?</h2>
        <p>Set up automated guest engagement in minutes. No contracts, no credit card required.</p>
        <div class="ind-cta__actions">
          <a href="/start" class="btn btn--primary">Get Started</a>
          <a href="/blog/restaurant-customer-engagement" class="ind-cta__link">Read the guide →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dusa.studio/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Restaurants", "item": "https://dusa.studio/industries/restaurants" }
    ]
  })} />

</BaseLayout>

<style>
  /* Hero */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Pain Points */
  .ind-pain {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-pain h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .ind-pain__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }
  .ind-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s, transform 0.3s;
  }
  .ind-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ind-pain__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }
  .ind-pain__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }
  .ind-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-pain__card-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* Solution */
  .ind-solution {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xs);
  }
  .ind-solution__sub {
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-xl);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .ind-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .ind-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s, transform 0.3s;
  }
  .ind-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ind-solution__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }
  .ind-solution__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }
  .ind-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-solution__card-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* Pipeline - 4 steps for restaurants */
  .ind-pipeline {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .ind-pipeline__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-lg);
  }
  .ind-pipeline__step {
    text-align: center;
  }
  .ind-pipeline__num {
    font-family: var(--font-mono, monospace);
    font-size: 2rem;
    font-weight: 700;
    color: var(--reef-aqua);
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }
  .ind-pipeline__step-title {
    font-family: var(--font-headline);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-pipeline__step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
  }

  /* Stats */
  .ind-stats {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .ind-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    max-width: 800px;
    margin: 0 auto;
  }
  .ind-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ind-stats__number {
    display: block;
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }
  .ind-stats__label {
    font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.5;
  }

  /* CTA */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }
  .ind-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ind-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-cta__box p {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .ind-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }
  .ind-cta__link {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .ind-cta__link:hover {
    opacity: 0.7;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .ind-pain__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-pain__cards {
      grid-template-columns: 1fr;
    }
    .ind-solution__grid {
      grid-template-columns: 1fr;
    }
    .ind-pipeline__track {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
    .ind-stats__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
    .ind-pipeline__track {
      grid-template-columns: 1fr;
    }
    .ind-pain__card,
    .ind-solution__card,
    .ind-stats__card {
      padding: var(--space-md);
    }
    .ind-cta__box {
      padding: var(--space-md);
    }
    .ind-cta__actions {
      flex-direction: column;
    }
  }

  /* Light Mode */
  :global(html[data-theme="light"]) .ind-hero__content h1,
  :global(html[data-theme="light"]) .ind-pain__card-title,
  :global(html[data-theme="light"]) .ind-solution__card-title,
  :global(html[data-theme="light"]) .ind-pipeline__step-title,
  :global(html[data-theme="light"]) .ind-pain h2,
  :global(html[data-theme="light"]) .ind-solution h2,
  :global(html[data-theme="light"]) .ind-pipeline h2,
  :global(html[data-theme="light"]) .ind-stats h2,
  :global(html[data-theme="light"]) .ind-cta__box h2 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-hero__sub,
  :global(html[data-theme="light"]) .ind-pain__card-desc,
  :global(html[data-theme="light"]) .ind-solution__card-desc,
  :global(html[data-theme="light"]) .ind-solution__sub,
  :global(html[data-theme="light"]) .ind-pipeline__step-desc,
  :global(html[data-theme="light"]) .ind-stats__label,
  :global(html[data-theme="light"]) .ind-cta__box p {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .ind-pain__card,
  :global(html[data-theme="light"]) .ind-solution__card {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__card:hover,
  :global(html[data-theme="light"]) .ind-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.35);
  }

  :global(html[data-theme="light"]) .ind-stats__card {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

