---
/**
 * RooferDay.astro
 *
 * Your phone is the phone. The visitor's own screen plays the roofer's phone:
 * the island fills the stage, notifications drop in from the top edge the
 * way real ones do (red while you are without DUSA, green once you switch),
 * and one glass pill at the bottom flips the whole day to the DUSA version
 * at the same moment on the clock. At 9pm the last notification is the
 * invitation.
 *
 * A roofer's Tuesday, with and without DUSA, in one picture. An iPhone sits
 * in the middle of a floating 3D diorama and a divider runs straight through
 * both. Left of the line is the day without DUSA (red: missed, later,
 * overdue), right of the line is the same day with it (green: replied,
 * booked, paid). Drag the line and red turns green.
 *
 * The diorama is a clay-style isometric island (rounded geometry, soft
 * shadows, posed characters) rendered twice, once per world, on two stacked
 * canvases; the "with" canvas is clipped by the same slider as the phone, so
 * one drag cuts the whole picture. The day plays on its own through seven
 * moments, including smoko: on the right the crew sits down together, on the
 * left the roofer stands apart making call-backs.
 *
 * The phone is HTML (real type, real notifications), the world is Three.js,
 * and under prefers-reduced-motion the scene stays still.
 */
interface Moment { time: string; label?: string; off: { app: string; title: string; body: string; line: string }; on: { app: string; title: string; body: string; line: string } }
interface Props {
  eyebrow?: string;
  heading?: string;
  headingAccent?: string;
  sub?: string;
  labelOff?: string;
  labelOn?: string;
  switchOn?: string;
  switchOff?: string;
  endTitle?: string;
  endBody?: string;
  endCta?: string;
  endDemo?: string;
  cta?: string;
  ctaDemo?: string;
  moments?: Moment[];
}
const {
  eyebrow = "A roofer's Tuesday",
  heading = 'Your Tuesday,',
  headingAccent = 'with and without DUSA.',
  sub = 'Same roofer, same crew, same job. Watch the day, then switch.',
  switchOn = 'Switch to DUSA',
  switchOff = 'Switch back',
  endTitle = 'This could be your Tuesday.',
  endBody = 'Set up in a day. Free for 14 days, cancel in one tap.',
  endCta = 'Start free',
  endDemo = 'Book a 20-minute call',
  labelOff = 'Without DUSA',
  labelOn = 'With DUSA',
  cta = 'Start free for 14 days',
  ctaDemo = 'Book a free demo',
  moments = [
    { time: '6:40',
      off: { app: 'Phone', title: '3 prospects called overnight', body: 'Nobody answered. Two have moved on.', line: 'Three prospects rang. Two went elsewhere.' },
      on:  { app: 'DUSA', title: '3 prospects booked overnight', body: 'Answered in seconds. Sam Thu 9am, Priya Fri 7:30am.', line: 'Three prospects answered. Two booked.' } },
    { time: '9:15',
      off: { app: 'Phone', title: 'Prospect called. Missed.', body: 'Dave, re-roof in Belmont. No voicemail.', line: 'Prospect called. Gone.' },
      on:  { app: 'DUSA', title: 'Prospect called. Handled.', body: 'Dave texted back in 8 seconds. Quote booked.', line: 'Prospect called. Booked.' } },
    { time: '10:30', label: 'Smoko',
      off: { app: 'Phone', title: '2 call-backs owed', body: 'Sam and Priya are still waiting.', line: 'Smoko spent on call-backs.' },
      on:  { app: 'DUSA', title: 'Sam and Priya booked', body: 'Done while you were on the roof.', line: 'Smoko with the crew.' } },
    { time: '11:30',
      off: { app: 'Reminders', title: 'Quote not sent', body: 'Dave is comparing quotes tonight.', line: 'Quote still in your head.' },
      on:  { app: 'DUSA', title: 'Deposit paid: $1,200', body: 'Dave accepted. Job locked in for Monday.', line: 'Quote sent. Deposit in.' } },
    { time: '1:30',
      off: { app: 'Reminders', title: 'Tomorrow unconfirmed', body: "Harbour St doesn't know you are coming.", line: 'Tomorrow is a guess.' },
      on:  { app: 'DUSA', title: 'Tomorrow confirmed', body: 'Harbour St, 7am. Driveway cleared.', line: 'Tomorrow is locked in.' } },
    { time: '4:45',
      off: { app: 'Reminders', title: 'Invoice not sent', body: 'Paid in three weeks, if you chase it.', line: 'Roof half done. Customer waiting.' },
      on:  { app: 'DUSA', title: 'Invoice paid: $4,800', body: 'By card, from the ladder. Review request sent.', line: 'Roof done. Paid on the spot.' } },
    { time: '9:00',
      off: { app: 'Reminders', title: '4 follow-ups overdue', body: 'Quotes, invoices, Priya, Sam.', line: 'Upstairs with the laptop.' },
      on:  { app: 'DUSA', title: 'New 5-star review', body: 'Reply posted. Tomorrow is booked.', line: 'Downstairs with the family.' } },
  ],
} = Astro.props;
const BOOK = 'https://link.dusa.studio/widget/bookings/dusa-demo';
const ampm = (i: number) => (i >= 4 ? 'pm' : 'am');
---

<section class="ww section section--dark" id="roofer-day" data-ww>
  <div class="container">
    <div class="ww__header">
      <span class="label">{eyebrow}</span>
      <h1 class="ww__h1">{heading} <span class="gradient-text">{headingAccent}</span></h1>
      <p class="ww__sub">{sub}</p>
    </div>

    <div class="ww__stage" data-stage data-beat="0" data-world="off" data-end-title={endTitle} data-end-body={endBody} data-end-cta={endCta} data-end-demo={endDemo} data-book={BOOK}>
      <div class="ww__sky" aria-hidden="true"><span class="ww__stars"></span></div>
      <canvas class="ww__world ww__world--off" data-world="off" aria-hidden="true"></canvas>
      <canvas class="ww__world ww__world--on" data-world="on" aria-hidden="true"></canvas>
      <div class="ww__vignette" aria-hidden="true"></div>

      <ol class="ww__banners" data-banners aria-live="polite"></ol>
      <div class="ww__bubbles" data-bubbles aria-hidden="true"></div>

      <div class="ww__bottom">
        <div class="ww__lines">
          {moments.map((m, i) => (
            <p class="ww__line" data-line={i} hidden={i !== 0 ? true : undefined}><span data-side="off">{m.off.line}</span><span data-side="on">{m.on.line}</span></p>
          ))}
        </div>
        <button type="button" class="ww__switch" data-switch aria-pressed="false">
          <span class="ww__switch-dot" aria-hidden="true"></span>
          <span data-switch-label data-on={switchOn} data-off={switchOff}>{switchOn}</span>
        </button>
        <div class="ww__timeline" role="tablist" aria-label="Moments of the day">
          {moments.map((m, i) => (
            <button type="button" class={`ww__time${i === 0 ? ' is-on' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-time={i}>
              <span class="ww__time-bar" aria-hidden="true"><span></span></span>
              <b>{m.time}<small>{ampm(i)}</small></b>
              {m.label && <span class="ww__time-label">{m.label}</span>}
            </button>
          ))}
        </div>
      </div>

    </div>

    <script type="application/json" data-moments set:html={JSON.stringify(moments.map((m) => ({ off: { app: m.off.app, title: m.off.title, body: m.off.body }, on: { app: m.on.app, title: m.on.title, body: m.on.body } })))} />

    <div class="ww__ctas">
      <a href="/start" data-page="start" class="btn btn--primary">{cta}</a>
      <a href={BOOK} target="_blank" rel="noopener noreferrer" class="btn btn--outline">{ctaDemo}</a>
    </div>
  </div>
</section>

<style>
  .ww { position: relative; padding-top: calc(74px + var(--space-xl)); overflow: hidden; }
  .ww__header { text-align: center; max-width: 680px; margin: 0 auto var(--space-lg); }
  .ww__h1 { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.1; margin: 0 0 0.6rem; color: var(--warm-white); }
  .ww__sub { font-size: 1.0625rem; color: rgba(247, 244, 239, 0.66); margin: 0 auto; max-width: 560px; }

  /* ── Stage ── */
  .ww__stage {
    position: relative;
    width: 100%; max-width: 1100px; margin: 0 auto;
    aspect-ratio: 16 / 10;
    border-radius: 28px;
    overflow: hidden;
    background: var(--deep-black);
    border: 1px solid rgba(247, 244, 239, 0.1);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.06), 0 30px 80px rgba(0, 0, 0, 0.35);
    user-select: none; -webkit-user-select: none;
    --sky1: #2b2f4a; --sky2: #8d6b7a;
  }
  .ww__sky { position: absolute; inset: 0; background: linear-gradient(180deg, var(--sky1), var(--sky2)); transition: background 1.4s ease; }
  .ww__stars { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s;
    background-image: radial-gradient(1.5px 1.5px at 12% 18%, #fff 50%, transparent 55%), radial-gradient(1px 1px at 30% 9%, #fff 50%, transparent 55%), radial-gradient(1.5px 1.5px at 48% 22%, #fff 50%, transparent 55%), radial-gradient(1px 1px at 63% 12%, #fff 50%, transparent 55%), radial-gradient(1.5px 1.5px at 78% 26%, #fff 50%, transparent 55%), radial-gradient(1px 1px at 90% 8%, #fff 50%, transparent 55%), radial-gradient(1px 1px at 22% 34%, #fff 50%, transparent 55%), radial-gradient(1.2px 1.2px at 85% 40%, #fff 50%, transparent 55%); }
  .ww__stage[data-beat="0"] { --sky1: #2b2f4a; --sky2: #9c7383; }
  .ww__stage[data-beat="1"] { --sky1: #3f7fb5; --sky2: #a9cfe4; }
  .ww__stage[data-beat="2"] { --sky1: #4789bf; --sky2: #b6d8ec; }
  .ww__stage[data-beat="3"] { --sky1: #4b93c9; --sky2: #bcdcef; }
  .ww__stage[data-beat="4"] { --sky1: #478dc2; --sky2: #b6d6ea; }
  .ww__stage[data-beat="5"] { --sky1: #3d5f8f; --sky2: #e2a06b; }
  .ww__stage[data-beat="6"] { --sky1: #06080f; --sky2: #15213a; }
  .ww__stage[data-beat="6"] .ww__stars { opacity: 1; }
  /* Without DUSA the sky is a little flatter too. */
  .ww__stage[data-world="off"] .ww__sky { filter: saturate(0.6); }

  .ww__world { position: absolute; inset: 0; width: 100%; height: 100%; display: block; transition: opacity 0.7s ease; }
  .ww__world--off { filter: saturate(0.8) brightness(0.92); }
  .ww__world--on { opacity: 0; }
  .ww__stage[data-world="on"] .ww__world--on { opacity: 1; }
  .ww__stage[data-world="on"] .ww__world--off { opacity: 0; }
  .ww__vignette { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 22%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.55) 100%); }

  /* ── Notifications, the way the phone does them ── */
  /* On a desktop the banners sit top-right, clear of the house; on a phone they sit where the phone puts them. */
  :global(.ww__banners) { position: absolute; right: 14px; top: 12px; width: min(380px, calc(100% - 24px)); margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; z-index: 3; }
  :global(.ww__banner) {
    display: grid; grid-template-columns: 38px 1fr; gap: 10px; align-items: start;
    padding: 10px 12px 11px; border-radius: 22px;
    background: rgba(28, 30, 38, 0.55);
    backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.22), 0 10px 40px rgba(0, 0, 0, 0.35);
    color: #fff; font-family: -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    animation: bannerIn 0.55s cubic-bezier(0.22, 1.2, 0.36, 1);
    transition: transform 0.35s ease, opacity 0.35s ease;
  }
  :global(.ww__banner.is-out) { opacity: 0; transform: translateY(-20px) scale(0.98); }
  :global(.ww__banner.is-old) { opacity: 0.8; transform: scale(0.97); }
  @keyframes bannerIn { from { opacity: 0; transform: translateY(-36px) scale(0.96); } to { opacity: 1; transform: none; } }
  :global(.ww__banner-icon) { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; overflow: hidden; }
  :global(.ww__banner-icon--off) { background: linear-gradient(160deg, #ff6b5e, #d93b2f); color: #fff; }
  :global(.ww__banner-icon--on) { background: linear-gradient(160deg, #1f4472, #0f2440 70%, #0b1a30); box-shadow: inset 0 0 0 0.5px rgba(78, 216, 194, 0.35); }
  :global(.ww__banner-icon img) { width: 22px; height: 22px; }
  :global(.ww__banner-icon svg) { width: 18px; height: 18px; }
  :global(.ww__banner-body) { display: grid; gap: 2px; min-width: 0; }
  :global(.ww__banner-row) { display: flex; justify-content: space-between; align-items: baseline; }
  :global(.ww__banner-row b) { font-size: 12px; font-weight: 600; color: rgba(255, 255, 255, 0.92); }
  :global(.ww__banner-row em) { font-style: normal; font-size: 11px; color: rgba(255, 255, 255, 0.55); }
  :global(.ww__banner-title) { font-size: 13.5px; font-weight: 600; line-height: 1.25; }
  :global(.ww__banner--off .ww__banner-title) { color: #ffb3aa; }
  :global(.ww__banner--on .ww__banner-title) { color: #8ff2e1; }
  :global(.ww__banner-text) { font-size: 12.5px; color: rgba(255, 255, 255, 0.8); line-height: 1.3; }
  /* The last one: the invitation. It glows and it stays. */
  :global(.ww__banner--end) { background: linear-gradient(135deg, rgba(26, 58, 92, 0.72), rgba(12, 14, 20, 0.7)); box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.5), 0 0 0 6px rgba(78, 216, 194, 0.08), 0 16px 50px rgba(78, 216, 194, 0.22); animation: bannerIn 0.6s cubic-bezier(0.22, 1.2, 0.36, 1), endGlow 2.6s ease-in-out 0.6s infinite; }
  @keyframes endGlow { 0%, 100% { box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.5), 0 0 0 6px rgba(78, 216, 194, 0.08), 0 16px 50px rgba(78, 216, 194, 0.22); } 50% { box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.8), 0 0 0 10px rgba(78, 216, 194, 0.12), 0 16px 60px rgba(78, 216, 194, 0.4); } }
  :global(.ww__banner--end .ww__banner-title) { color: #fff; font-size: 15px; }
  :global(.ww__banner-actions) { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  :global(.ww__banner-btn) { display: inline-flex; align-items: center; padding: 7px 12px; border-radius: 100px; font-size: 12.5px; font-weight: 600; color: #fff; text-decoration: none; background: rgba(255, 255, 255, 0.12); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.25); }
  :global(.ww__banner-btn--primary) { background: linear-gradient(135deg, #4ed8c2, #6aaacf); color: var(--deep-black); box-shadow: 0 6px 18px rgba(78, 216, 194, 0.35); }

  /* ── Bottom: the line, the switch, the clock ── */
  .ww__bottom { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 16px 14px; display: grid; gap: 12px; justify-items: center; z-index: 2; }
  .ww__lines { width: 100%; max-width: 640px; text-align: center; }
  .ww__line { margin: 0; font-size: 1rem; line-height: 1.4; color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); max-width: none; }
  .ww__line[hidden] { display: none; }
  .ww__line [data-side="on"] { display: none; }
  .ww__stage[data-world="on"] .ww__line [data-side="on"] { display: inline; }
  .ww__stage[data-world="on"] .ww__line [data-side="off"] { display: none; }
  .ww__switch {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.8rem 1.4rem; border-radius: 100px; border: 1px solid rgba(160, 245, 230, 0.7);
    background: linear-gradient(135deg, rgba(78, 216, 194, 0.55), rgba(78, 216, 194, 0.22));
    backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
    color: #fff; font: inherit; font-weight: 600; font-size: 1rem; letter-spacing: 0.01em; cursor: pointer;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), inset 0 -10px 24px rgba(78, 216, 194, 0.35), 0 0 28px rgba(78, 216, 194, 0.55), 0 10px 30px rgba(0, 0, 0, 0.25);
    animation: switchGlow 2.2s ease-in-out infinite;
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  @keyframes switchGlow { 0%, 100% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), inset 0 -10px 24px rgba(78, 216, 194, 0.35), 0 0 22px rgba(78, 216, 194, 0.45), 0 10px 30px rgba(0, 0, 0, 0.25); } 50% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), inset 0 -10px 28px rgba(78, 216, 194, 0.55), 0 0 40px rgba(78, 216, 194, 0.8), 0 10px 30px rgba(0, 0, 0, 0.25); } }
  /* Speech and thought bubbles, pinned above heads from the 3D scene. */
  :global(.ww__bubbles) { position: absolute; inset: 0; pointer-events: none; z-index: 2; overflow: hidden; }
  :global(.ww__bubble) {
    position: absolute; transform: translate(-50%, -100%); max-width: 190px;
    padding: 7px 11px; border-radius: 14px;
    background: rgba(255, 255, 255, 0.94); color: #0c0e14;
    font-size: 12.5px; font-weight: 500; line-height: 1.3; text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    animation: bubbleIn 0.35s cubic-bezier(0.22, 1.2, 0.36, 1);
    transition: opacity 0.3s;
  }
  :global(.ww__bubble::after) { content: ''; position: absolute; left: 50%; bottom: -5px; width: 12px; height: 12px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 2px; }
  :global(.ww__bubble--thought) { font-style: italic; background: rgba(255, 255, 255, 0.82); }
  :global(.ww__bubble--thought::after) { width: 8px; height: 8px; border-radius: 50%; transform: translateX(-50%); bottom: -11px; box-shadow: -8px 8px 0 -2px rgba(255, 255, 255, 0.82); }
  :global(.ww__bubble--on) { background: #4ed8c2; }
  :global(.ww__bubble--off) { background: #ffb3aa; }
  :global(.ww__bubble.is-out) { opacity: 0; }
  @keyframes bubbleIn { from { opacity: 0; transform: translate(-50%, -90%) scale(0.9); } to { opacity: 1; transform: translate(-50%, -100%) scale(1); } }
  .ww__switch-dot { width: 9px; height: 9px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px #fff; }
  .ww__switch[aria-pressed="true"] { animation: none; background: rgba(12, 14, 20, 0.45); border-color: rgba(247, 244, 239, 0.25); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 10px 30px rgba(0, 0, 0, 0.3); }
  .ww__switch[aria-pressed="true"] .ww__switch-dot { background: #4ed8c2; box-shadow: 0 0 10px #4ed8c2; }
  .ww__switch:focus-visible { outline: 2px solid var(--reef-aqua); outline-offset: 3px; }

  .ww__timeline { display: flex; gap: 0.4rem; width: 100%; max-width: 720px; padding: 0.55rem 0.8rem 0.45rem; border-radius: 16px; background: rgba(12, 14, 20, 0.4); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.12); }
  .ww__time { flex: 1; position: relative; background: none; border: 0; padding: 0.15rem 0 0; cursor: pointer; color: rgba(247, 244, 239, 0.55); font: inherit; text-align: left; }
  .ww__time b { display: block; font-family: var(--font-headline); font-weight: 600; font-size: 0.8rem; margin-top: 0.3rem; transition: color 0.3s; white-space: nowrap; }
  .ww__time b small { font-size: 0.7em; margin-left: 1px; font-weight: 500; }
  .ww__time-label { display: block; font-size: 0.62rem; color: var(--reef-aqua); margin-top: 0; }
  .ww__time-bar { display: block; height: 3px; border-radius: 2px; background: rgba(247, 244, 239, 0.16); overflow: hidden; }
  .ww__time-bar span { display: block; height: 100%; width: 0; background: var(--reef-aqua); }
  .ww__time.is-on { color: var(--warm-white); }
  .ww__time:hover b { color: var(--warm-white); }

  .ww__ctas { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; margin-top: var(--space-lg); }

  /* ── Phones: the stage is the screen ── */
  @media (max-width: 760px) {
    .ww { padding-top: calc(74px + var(--space-md)); }
    .ww__header { margin-bottom: var(--space-sm); }
    .ww__h1 { font-size: 1.6rem; }
    .ww__sub { font-size: 0.9375rem; }
    .ww__stage { aspect-ratio: auto; width: 100vw; margin-left: calc(50% - 50vw); height: 100svh; max-height: none; border-radius: 0; border: 0; box-shadow: none; }
    :global(.ww__banners) { left: 50%; right: auto; transform: translateX(-50%); top: max(10px, env(safe-area-inset-top)); width: calc(100% - 20px); }
    :global(html.ww-immersed .ww__banners) { position: fixed; z-index: 1200; }
    .ww__bottom { padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    .ww__bottom { padding: 0 10px 10px; gap: 10px; }
    .ww__line { font-size: 0.9375rem; }
    .ww__switch { padding: 0.75rem 1.25rem; font-size: 0.9375rem; }
    .ww__timeline { gap: 0.25rem; padding: 0.45rem 0.6rem 0.4rem; }
    .ww__time b { font-size: 0.66rem; }
    .ww__time b small { display: none; }
    .ww__time-label { display: none; }
    .ww__ctas .btn { width: 100%; text-align: center; }
  }
  /* While the stage is in view, the nav steps out of the way. */
  :global(html.ww-immersed .nav) { opacity: 0; pointer-events: none; transition: opacity 0.4s; }
  :global(.nav) { transition: opacity 0.4s; }

  @media (prefers-reduced-motion: reduce) {
  :global(.ww__banner), :global(.ww__banner--end) { animation: none; }
    .ww__switch { animation: none; }
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .ww__h1 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ww__sub { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .ww__stage { border-color: rgba(12, 14, 20, 0.1); box-shadow: 0 30px 70px rgba(12, 14, 20, 0.18); }
</style>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';

  document.querySelectorAll<HTMLElement>('[data-ww]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const times = [...root.querySelectorAll<HTMLButtonElement>('[data-time]')];
    const bars = times.map((t) => t.querySelector<HTMLElement>('.ww__time-bar span')!);
    const lines = [...root.querySelectorAll<HTMLElement>('[data-line]')];
    const bannerList = root.querySelector<HTMLElement>('[data-banners]')!;
    const switchBtn = root.querySelector<HTMLButtonElement>('[data-switch]')!;
    const switchLabel = root.querySelector<HTMLElement>('[data-switch-label]')!;
