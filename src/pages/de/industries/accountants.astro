---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';
---

<BaseLayout t={tData} title="CRM für Steuerberater & Buchhalter | DUSA . studio" description="Automatisieren Sie die Dokumentensammlung, Fristenerinnerungen und Mandantenpflege zwischen den Steuersaisons. DUSA gibt Steuerberatern ein Wachstumssystem, das das ganze Jahr über funktioniert.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://dusa.studio/de/" },
      { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://dusa.studio/de/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Steuerberater & Buchhalter", "item": "https://dusa.studio/de/industries/accountants/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Steuerberater &amp; Buchhalter</span>
        <h1>Beenden Sie den Auftragszyklus<br/><span class="gradient-text">mit ganzjähriger Mandantenbindung</span></h1>
        <p class="industry-hero__sub">DUSA automatisiert das Einfordern von Unterlagen, die Fristenüberwachung und die Mandantenkommunikation, damit Sie sich auf die Zahlen konzentrieren können, nicht auf die Verwaltung.</p>
        <div class="industry-hero__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Demo buchen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">Das Problem</span>
      <h2>Kommt Ihnen das bekannt vor?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">📈</div>
          <h3>Saisonale Auftragsschwankungen</h3>
          <p>Die Steuersaison überrollt Sie. In der Nebensaison fragen Sie sich, woher der nächste Mandant kommt. Die Schwankungen sind kräftezehrend.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📄</div>
          <h3>Unterlagen von Mandanten eintreiben</h3>
          <p>Sie senden eine Anfrage. Dann eine Erinnerung. Dann noch eine. Mandanten dazu zu bringen, ihre Unterlagen rechtzeitig einzureichen, fühlt sich an wie ein zweiter Job.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📅</div>
          <h3>Manuelle Fristenverwaltung</h3>
          <p>Umsatzsteuervoranmeldung, Einkommensteuer, Jahresabschlüsse, Sozialversicherung. Dutzende Mandantenfristen in Tabellen zu jonglieren, ist ein Rezept für verpasste Abgaben.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🤷</div>
          <h3>Kein Kontakt zwischen den Steuersaisons</h3>
          <p>Mandanten hören nur von Ihnen, wenn etwas fällig ist. Ohne regelmäßige Kontaktpunkte vergessen sie Sie bis zur letzten Minute.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">Die Lösung</span>
      <h2>So funktioniert DUSA für <span class="gradient-text">Steuerberater und Buchhalter</span></h2>
      <p class="solution__intro">Eine Plattform übernimmt Dokumentensammlung, Fristenverwaltung, Mandantenpflege und Empfehlungstracking.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Automatisierte Dokumentensammlung</h3>
          <p>Senden Sie automatische Anfragen mit sicheren Upload-Links. Automatische Nachfassaktionen, bis die Unterlagen eingehen.</p>
        </div>
        <div class="solution-card">
          <h3>Fristenerinnerungen</h3>
          <p>Automatische Erinnerungen für Umsatzsteuervoranmeldung, Einkommensteuer, Jahresabschlüsse und Sozialversicherung. Mandanten und Ihr Team bleiben jeder Frist voraus.</p>
        </div>
        <div class="solution-card">
          <h3>Mandantenportal</h3>
          <p>Geben Sie Mandanten einen zentralen Ort, um Unterlagen hochzuladen, den Fortschritt zu prüfen und mit Ihrem Team zu kommunizieren.</p>
        </div>
        <div class="solution-card">
          <h3>Ganzjährige Pflegekampagnen</h3>
          <p>Steuertipps, Hinweise zu Absetzungsmöglichkeiten und Finanzplanungsimpulse halten Sie das ganze Jahr über im Gedächtnis Ihrer Mandanten.</p>
        </div>
        <div class="solution-card">
          <h3>Empfehlungstracking</h3>
          <p>Erfahren Sie genau, welche Mandanten neue Geschäfte empfehlen, und automatisieren Sie Dankesnachrichten, wenn sie es tun.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Ihre Pipeline</span>
      <h2>Jeder Mandant, jede Frist, <span class="gradient-text">automatisch verfolgt</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Neuer Mandant</h3>
          <p>Onboarding-Formular erfasst Steuernummer, Unternehmensform und Angaben zum bisherigen Steuerberater.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Unterlagen angefordert</h3>
          <p>Automatische Anfrage mit sicherem Upload-Link und Checkliste versendet.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Unterlagen erhalten</h3>
          <p>Alle Dokumente eingegangen. Ihr Team wird benachrichtigt und die Arbeit kann beginnen.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>In Bearbeitung</h3>
          <p>Steuererklärung oder Abschluss wird erstellt. Mandant sieht Statusupdates.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Eingereicht</h3>
          <p>Beim Finanzamt eingereicht. Mandant erhält Bestätigung und nächste Schritte.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Überprüfung</h3>
          <p>Nachbearbeitung und Planung für den nächsten Zeitraum beginnen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Ergebnisse</span>
      <h2>Entwickelt für Kanzleien, die <span class="gradient-text">skalieren</span> wollen</h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">70%</div>
          <p>weniger Zeitaufwand für das Eintreiben von Unterlagen durch automatische Nachfassaktionen</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">2x</div>
          <p>mehr Empfehlungen von bestehenden Mandanten durch Pflegekampagnen</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">0</div>
          <p>verpasste Fristen, wenn Erinnerungen automatisch laufen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Bereit, keine Unterlagen mehr hinterherzulaufen?</h2>
        <p>Bringen Sie Ihre Kanzlei in weniger als einer Woche auf DUSA.</p>
        <div class="final-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/crm-for-accountants" class="btn btn--outline">Leitfaden lesen</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
