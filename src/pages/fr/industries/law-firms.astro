---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';

const painPoints = [
  {
    icon: 'M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Un processus d\'accueil lent qui fait fuir les clients',
    desc: 'Les clients potentiels vous contactent et attendent des jours avant d\'obtenir une réponse. Le temps que votre équipe les rappelle, ils ont déjà sollicité un autre cabinet. La rapidité est essentielle dans l\'acquisition de clients.',
  },
  {
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
    title: 'Aucun suivi des recommandations',
    desc: 'Vous savez que les recommandations génèrent vos meilleurs clients, mais vous n\'avez aucun système pour tracer leur provenance, remercier le prescripteur ou mesurer quelles sources fonctionnent le mieux.',
  },
  {
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    title: 'Visibilité en ligne limitée',
    desc: 'Les personnes qui cherchent une aide juridique en ligne ne vous trouvent pas. Vos concurrents investissent dans leur présence numérique pendant que votre cabinet s\'appuie sur un site internet obsolète et l\'espoir.',
  },
  {
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    title: 'Aucun suivi structuré après la consultation',
    desc: 'Les consultations initiales ont lieu, mais il n\'y a pas de séquence de suivi structurée. Les clients potentiels passent entre les mailles du filet parce que personne n\'a planifié le prochain point de contact.',
  },
];

const features = [
  { title: 'Automatisation des formulaires d\'accueil', desc: 'Simplifiez l\'accueil de vos clients avec des formulaires intelligents qui recueillent les bonnes informations dès le départ. Les demandes sont automatiquement orientées vers le bon domaine de pratique.' },
  { title: 'Notifications de suivi de dossier', desc: 'Tenez vos clients informés de l\'avancement de leur dossier sans appels manuels. Les mises à jour automatiques réduisent les appels "où en est mon dossier" et améliorent la satisfaction client.' },
  { title: 'Suivi des sources de recommandation', desc: 'Identifiez chaque nouveau client par sa source de recommandation. Suivez quelles relations, annuaires et canaux génèrent vos meilleurs dossiers pour investir en conséquence.' },
  { title: 'Contenu de leadership éditorial', desc: 'Planifiez et diffusez des analyses juridiques, des études de cas et des actualités de votre domaine de pratique par email et sur les réseaux sociaux. Positionnez votre cabinet comme la référence de votre spécialité.' },
  { title: 'Séquences de suivi post-consultation', desc: 'Après une consultation initiale, déclenchez une séquence de suivi structurée. Des emails et SMS opportuns gardent votre cabinet en tête jusqu\'à ce que le client décide de vous confier son dossier.' },
  { title: 'Collecte d\'avis et de témoignages', desc: 'Demandez automatiquement des avis Google et des témoignages à vos clients satisfaits à la clôture du dossier. Développez votre réputation en ligne avec un effort minimal de la part de votre équipe.' },
];

const pipeline = [
  { stage: 'Demande', desc: 'Le client potentiel remplit un formulaire d\'accueil ou prend contact' },
  { stage: 'Consultation', desc: 'Premier rendez-vous pour évaluer le dossier et la compatibilité' },
  { stage: 'Engagé', desc: 'Le client signe la lettre de mission et la provision' },
  { stage: 'Dossier actif', desc: 'Dossier en cours avec mises à jour de statut envoyées automatiquement' },
  { stage: 'Dossier clos', desc: 'Dossier terminé avec demande d\'avis déclenchée' },
  { stage: 'Recommandation', desc: 'Le client satisfait entre dans la séquence de recommandation' },
];

const stats = [
  { value: '42%', label: 'des clients potentiels en droit choisissent le premier cabinet qui répond' },
  { value: '3.5x', label: 'plus de recommandations avec un système de suivi et de remerciement en place' },
  { value: '68%', label: 'des clients déclarent que les mises à jour proactives améliorent leur expérience' },
];
---

<BaseLayout
  t={tData}
  title="Automatisation marketing pour cabinets d'avocats | DUSA.studio"
  description="Arrêtez de perdre des clients potentiels à cause d'un accueil lent. DUSA offre aux cabinets d'avocats l'accueil automatisé, le suivi des recommandations, les relances post-consultation et les notifications de suivi de dossier sur une seule plateforme."
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Cabinets d'avocats</span>
        <h1>L'automatisation marketing pour les <span class="gradient-text">cabinets d'avocats</span></h1>
        <p class="ind-hero__sub">
          L'expertise de votre cabinet n'est pas le problème. Le problème, c'est que les clients potentiels ne vous trouvent pas, et quand ils vous trouvent, un accueil lent et un suivi incohérent les font fuir avant qu'ils ne s'engagent. DUSA corrige le processus.
        </p>
        <a href="/fr/start" class="btn btn--primary">Commencer</a>
      </div>
    </div>
  </section>

  <!-- ═══ Pain Points ═══ -->
  <section class="ind-pain section--dark">
    <div class="container">
      <h2 class="ind-section-title">Ca vous parle ?</h2>
      <div class="ind-pain__grid">
        {painPoints.map((p) => (
          <div class="ind-pain__card">
            <div class="ind-pain__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </div>
            <h3 class="ind-pain__title">{p.title}</h3>
            <p class="ind-pain__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Solution ═══ -->
  <section class="ind-solution section--dark">
    <div class="container">
      <h2 class="ind-section-title">Comment DUSA fonctionne pour les <span class="gradient-text">cabinets d'avocats</span></h2>
      <p class="ind-solution__intro">De la première demande au dossier clos et à la recommandation, chaque point de contact client est suivi, automatisé et professionnel.</p>
      <div class="ind-solution__grid">
        {features.map((f) => (
          <div class="ind-solution__item">
            <h3 class="ind-solution__item-title">{f.title}</h3>
            <p class="ind-solution__item-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Pipeline ═══ -->
  <section class="ind-pipeline section--dark">
    <div class="container">
      <h2 class="ind-section-title">Votre pipeline client</h2>
      <div class="ind-pipeline__track">
        {pipeline.map((p, i) => (
          <div class="ind-pipeline__stage">
            <div class="ind-pipeline__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ind-pipeline__stage-title">{p.stage}</h3>
            <p class="ind-pipeline__stage-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Stats ═══ -->
  <section class="ind-stats section--dark">
    <div class="container">
      <div class="ind-stats__grid">
        {stats.map((s) => (
          <div class="ind-stats__item">
            <div class="ind-stats__value">{s.value}</div>
            <p class="ind-stats__label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Prêt à moderniser l'acquisition clients de votre cabinet ?</h2>
        <p class="ind-cta__desc">Mettez en place l'accueil automatisé, le suivi des recommandations et les séquences de relance en moins d'une heure. Sans engagement.</p>
        <div class="ind-cta__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/blog/marketing-for-law-firms" class="ind-cta__link">Lire le guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Breadcrumb JSON-LD ═══ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://dusa.studio/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/fr/industries" },
      { "@type": "ListItem", "position": 3, "name": "Cabinets d'avocats", "item": "https://dusa.studio/fr/industries/law-firms" }
    ]
  })} />
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-lg);
  }

  /* ─── Section Titles ─── */
  .ind-section-title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* ─── Pain Points ─── */
  .ind-pain {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .ind-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }

  .ind-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-pain__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-sm);
  }

  .ind-pain__icon svg {
    width: 22px;
    height: 22px;
    color: var(--reef-aqua);
  }

  .ind-pain__title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-pain__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── Solution ─── */
  .ind-solution {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-solution__intro {
    text-align: center;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 560px;
    margin: calc(-1 * var(--space-md)) auto var(--space-xl);
    line-height: 1.65;
  }

  .ind-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .ind-solution__item {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast);
  }

  .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .ind-solution__item-title {
    font-family: var(--font-headline);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-solution__item-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.55);
  }

  /* ─── Pipeline ─── */
  .ind-pipeline {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pipeline__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-md);
  }

  .ind-pipeline__stage {
    text-align: center;
    position: relative;
  }

  .ind-pipeline__stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.25rem;
    right: calc(-1 * var(--space-md) / 2);
    width: var(--space-md);
    height: 1px;
    background: rgba(78, 216, 194, 0.2);
  }

  .ind-pipeline__num {
    font-family: var(--font-mono, monospace);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--reef-aqua);
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }

  .ind-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.25rem;
  }

  .ind-pipeline__stage-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(247, 244, 239, 0.5);
  }

  /* ─── Stats ─── */
  .ind-stats {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: center;
  }

  .ind-stats__item {
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .ind-stats__label {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-cta__desc {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .ind-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .ind-cta__link {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 500;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .ind-cta__link:hover {
    opacity: 0.75;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .ind-pain__grid {
      grid-template-columns: 1fr;
    }

    .ind-solution__grid {
      grid-template-columns: 1fr;
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(3, 1fr);
    }

    .ind-pipeline__stage:not(:last-child)::after {
      display: none;
    }

    .ind-stats__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(2, 1fr);
    }

    .ind-pain__card,
    .ind-solution__item {
      padding: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-md);
    }
  }

  /* ─── Light Mode ─── */
  :global(html[data-theme="light"]) .ind-hero__content h1,
  :global(html[data-theme="light"]) .ind-section-title,
  :global(html[data-theme="light"]) .ind-pain__title,
  :global(html[data-theme="light"]) .ind-solution__item-title,
  :global(html[data-theme="light"]) .ind-pipeline__stage-title,
  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-hero__sub,
  :global(html[data-theme="light"]) .ind-pain__desc,
  :global(html[data-theme="light"]) .ind-solution__intro,
  :global(html[data-theme="light"]) .ind-solution__item-desc,
  :global(html[data-theme="light"]) .ind-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ind-stats__label,
  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .ind-pain__card,
  :global(html[data-theme="light"]) .ind-solution__item {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__card:hover,
  :global(html[data-theme="light"]) .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.35);
  }

  :global(html[data-theme="light"]) .ind-stats__item {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain,
  :global(html[data-theme="light"]) .ind-solution,
  :global(html[data-theme="light"]) .ind-pipeline,
  :global(html[data-theme="light"]) .ind-stats {
    border-top-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__icon {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain__icon svg {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-pipeline__num {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-stats__value {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__link {
    color: var(--deep-ocean);
  }
</style>