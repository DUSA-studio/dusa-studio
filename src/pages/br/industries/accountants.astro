---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';
---

<BaseLayout t={tData} title="CRM para Contadores e Escritorios de Contabilidade | DUSA.studio" description="Automatize a coleta de documentos, lembretes de prazos e o relacionamento com clientes durante todo o ano. O DUSA oferece um sistema de crescimento para contadores que funciona o ano inteiro.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dusa.studio/br/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/br/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Contadores", "item": "https://dusa.studio/br/industries/accountants/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Contadores e Escritorios de Contabilidade</span>
        <h1>Acabe com o ciclo de alta e baixa<br/><span class="gradient-text">com engajamento de clientes o ano todo</span></h1>
        <p class="industry-hero__sub">O DUSA automatiza a cobranca de documentos, o acompanhamento de prazos e a comunicacao com clientes para que voce possa focar nos numeros, nao na burocracia.</p>
        <div class="industry-hero__actions">
          <a href="/br/start" class="btn btn--primary">Comece agora</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Agende uma demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">O Problema</span>
      <h2>Parece familiar?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">📈</div>
          <h3>Fluxo de trabalho sazonal de alta e baixa</h3>
          <p>A temporada fiscal te enterra de trabalho. Fora de temporada, voce fica se perguntando de onde vira o proximo cliente. As oscilacoes de demanda sao desgastantes.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📄</div>
          <h3>Cobrando documentos dos clientes</h3>
          <p>Voce envia uma solicitacao. Depois um lembrete. Depois outro. Fazer os clientes enviarem documentos no prazo parece um segundo emprego.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📅</div>
          <h3>Acompanhamento manual de prazos</h3>
          <p>DCTF, DAS, declaracoes fiscais e obrigacoes acessorias. Gerenciar dezenas de prazos de clientes em planilhas e receita certa para perder entregas.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🤷</div>
          <h3>Sem engajamento entre as temporadas fiscais</h3>
          <p>Os clientes so ouvem de voce quando algo esta vencendo. Sem pontos de contato ao longo do ano, eles esquecem de voce ate o ultimo minuto.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">A Solucao</span>
      <h2>Como o DUSA funciona para <span class="gradient-text">contadores e escritorios de contabilidade</span></h2>
      <p class="solution__intro">Uma plataforma cuida da coleta de documentos, gestao de prazos, relacionamento com clientes e rastreamento de indicacoes.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Automacao de coleta de documentos</h3>
          <p>Envie solicitacoes automaticas com links seguros de upload. O acompanhamento acontece automaticamente ate os documentos chegarem.</p>
        </div>
        <div class="solution-card">
          <h3>Sequencias de lembrete de prazos</h3>
          <p>Lembretes automaticos para DCTF, DAS, declaracoes fiscais e obrigacoes acessorias. Seus clientes e sua equipe ficam sempre a frente de cada prazo.</p>
        </div>
        <div class="solution-card">
          <h3>Portal do cliente</h3>
          <p>Ofereca aos clientes um unico lugar para enviar documentos, acompanhar o andamento e se comunicar com sua equipe.</p>
        </div>
        <div class="solution-card">
          <h3>Campanhas de relacionamento durante o ano</h3>
          <p>Dicas fiscais, lembretes de deducoes e orientacoes de planejamento financeiro mantem voce na mente dos clientes entre as temporadas de entrega.</p>
        </div>
        <div class="solution-card">
          <h3>Rastreamento de indicacoes</h3>
          <p>Saiba exatamente quais clientes indicam novos negocios e automatize mensagens de agradecimento quando isso acontecer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Seu Pipeline</span>
      <h2>Cada cliente, cada prazo, <span class="gradient-text">rastreado automaticamente</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Novo Cliente</h3>
          <p>Formulario de onboarding coleta CNPJ, dados da empresa e informacoes do contador anterior.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Documentos Solicitados</h3>
          <p>Solicitacao automatica enviada com link seguro de upload e checklist.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Documentos Recebidos</h3>
          <p>Todos os documentos recebidos. Sua equipe e notificada e o trabalho pode comecar.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Em Andamento</h3>
          <p>Declaracao ou demonstrativo sendo preparado. O cliente acompanha as atualizacoes de status.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Entregue</h3>
          <p>Entregue a Receita Federal. Cliente notificado com confirmacao e proximos passos.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Revisao</h3>
          <p>Revisao pos-entrega e planejamento para o proximo periodo comecam.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultados</span>
      <h2>Feito para escritorios que querem <span class="gradient-text">escalar</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">70%</div>
          <p>de reducao no tempo gasto cobrando documentos com acompanhamentos automaticos</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">2x</div>
          <p>mais indicacoes de clientes existentes com campanhas de relacionamento</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">0</div>
          <p>prazos perdidos quando os lembretes rodam no piloto automatico</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Pronto para parar de cobrar documentos?</h2>
        <p>Tenha seu escritorio rodando no DUSA em menos de uma semana.</p>
        <div class="final-cta__actions">
          <a href="/br/start" class="btn btn--primary">Comece agora</a>
          <a href="/blog/crm-for-accountants" class="btn btn--outline">Leia o guia</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
