---
// DIRECTION A — "The Receipt"
//
// Argument: the original funnels are decorative. They do not encode the
// numbers, so the reader has to take the total on trust. A receipt IS the
// evidence: ruled line items, a subtotal that visibly adds up, and one line
// underneath that replaces the lot. It leans on the mono type already in the
// brand and reads as a document rather than a marketing graphic.
import { STACK, DUSA_COST, STACK_TOTAL, SAVING, money } from '../../config/stack-compare';
---

<div class="rc">
  <div class="rc__grid">

    <div class="rc__paper">
      <div class="rc__head">
        <span class="rc__tag">Your stack, monthly</span>
        <span class="rc__count">{STACK.length} subscriptions</span>
      </div>

      <ul class="rc__lines">
        {STACK.map((tool, i) => (
          <li class="rc__line" style={`--i:${i}`}>
            <span class="rc__name">{tool.name}</span>
            <span class="rc__job">{tool.job}</span>
            <span class="rc__dots" aria-hidden="true"></span>
            <span class="rc__cost">{money(tool.cost)}</span>
          </li>
        ))}
      </ul>

      <div class="rc__rule" aria-hidden="true"></div>
      <div class="rc__total">
        <span class="rc__total-label">Total every month</span>
        <span class="rc__total-value">{money(STACK_TOTAL)}</span>
      </div>
      <p class="rc__foot">{STACK.length} logins. {STACK.length} bills. None of them talk to each other.</p>
    </div>

    <div class="rc__swap" aria-hidden="true">
      <span>replaced by</span>
    </div>

    <div class="rc__paper rc__paper--dusa">
      <div class="rc__head">
        <span class="rc__tag rc__tag--aqua">With DUSA</span>
        <span class="rc__count">1 subscription</span>
      </div>

      <div class="rc__line rc__line--dusa">
        <span class="rc__name">DUSA . studio</span>
        <span class="rc__job">Everything above, plus AI</span>
        <span class="rc__dots" aria-hidden="true"></span>
        <span class="rc__cost">{money(DUSA_COST)}</span>
      </div>

      <div class="rc__rule" aria-hidden="true"></div>
      <div class="rc__total rc__total--aqua">
        <span class="rc__total-label">Total every month</span>
        <span class="rc__total-value">{money(DUSA_COST)}</span>
      </div>

      <div class="rc__stamp">
        <span class="rc__stamp-value">{money(SAVING)}</span>
        <span class="rc__stamp-label">back in your pocket, every month</span>
      </div>
      <p class="rc__foot">One login. One bill. Everything sees everything.</p>
    </div>

  </div>
</div>

<style>
  .rc { container-type: inline-size; }
  .rc__grid {
    display: grid; gap: var(--space-md);
    grid-template-columns: 1fr auto 1fr; align-items: start;
  }

  .rc__paper {
    background: rgba(247, 244, 239, 0.02);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 14px; padding: 1.6rem 1.5rem 1.4rem;
    position: relative;
  }
  .rc__paper--dusa {
    border-color: rgba(78, 216, 194, 0.32);
    background: linear-gradient(180deg, rgba(78, 216, 194, 0.06), rgba(78, 216, 194, 0.015));
  }

  .rc__head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; margin-bottom: 1.1rem;
  }
  .rc__tag {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(232, 82, 78, 0.9);
  }
  .rc__tag--aqua { color: var(--reef-aqua); }
  .rc__count {
    font-family: var(--font-mono); font-size: 0.6875rem;
    color: rgba(247, 244, 239, 0.35);
  }

  .rc__lines { list-style: none; padding: 0; margin: 0; }
  .rc__line {
    display: grid; grid-template-columns: auto auto 1fr auto;
    align-items: baseline; gap: 0.5rem;
    padding: 0.42rem 0; font-family: var(--font-mono); font-size: 0.8125rem;
  }
  .rc__name { color: rgba(247, 244, 239, 0.82); }
  .rc__job {
    font-size: 0.6875rem; color: rgba(247, 244, 239, 0.3);
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  /* A leader line is what makes it read as a bill rather than a table. */
  .rc__dots {
    border-bottom: 1px dotted rgba(247, 244, 239, 0.16);
    transform: translateY(-0.2em);
  }
  .rc__cost { color: rgba(247, 244, 239, 0.6); font-variant-numeric: tabular-nums; }

  .rc__line--dusa { padding: 0.42rem 0 0; }
  .rc__line--dusa .rc__name { color: var(--warm-white); }
  .rc__line--dusa .rc__cost { color: var(--reef-aqua); }
  .rc__paper--dusa .rc__job { color: rgba(78, 216, 194, 0.55); }

  .rc__rule {
    height: 1px; margin: 0.85rem 0 0.7rem;
    background: repeating-linear-gradient(90deg,
      rgba(247, 244, 239, 0.22) 0 6px, transparent 6px 12px);
  }
  .rc__paper--dusa .rc__rule {
    background: repeating-linear-gradient(90deg,
      rgba(78, 216, 194, 0.4) 0 6px, transparent 6px 12px);
  }

  .rc__total { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .rc__total-label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.4);
  }
  .rc__total-value {
    font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem;
    color: rgba(232, 82, 78, 0.95); font-variant-numeric: tabular-nums;
  }
  .rc__total--aqua .rc__total-value { color: var(--reef-aqua); }

  .rc__stamp {
    margin-top: 1.1rem; padding: 0.85rem 1rem; border-radius: 10px;
    background: rgba(78, 216, 194, 0.1);
    border: 1px dashed rgba(78, 216, 194, 0.45);
    display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
  }
  .rc__stamp-value {
    font-family: var(--font-mono); font-weight: 700; font-size: 1.6rem;
    color: var(--reef-aqua); letter-spacing: 0.02em;
  }
  .rc__stamp-label {
    font-size: 0.75rem; color: rgba(166, 245, 231, 0.75); text-align: center;
  }

  .rc__foot {
    margin: 0.9rem 0 0; font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.4); max-width: none;
  }

  .rc__swap {
    align-self: center; display: grid; place-items: center;
    padding: 0 0.2rem;
  }
  .rc__swap span {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.3);
    writing-mode: vertical-rl; white-space: nowrap;
  }

  /* Two receipts side by side stop being comparable long before they stop
     fitting, so stack them while each is still wide enough to read. */
  @container (max-width: 860px) {
    .rc__grid { grid-template-columns: 1fr; }
    .rc__swap span { writing-mode: horizontal-tb; }
  }
</style>
