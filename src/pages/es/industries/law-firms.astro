---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';

const lang = 'es';
const region = 'es';

const painPoints = [
  {
    icon: 'M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Proceso de admision lento que pierde clientes',
    desc: 'Los clientes potenciales se comunican y esperan dias por una respuesta. Para cuando su equipo hace el seguimiento, ya contrataron otra firma. La velocidad importa en la captacion de clientes.',
  },
  {
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
    title: 'Sin seguimiento de referencias',
    desc: 'Sabe que las referencias generan sus mejores clientes, pero no tiene un sistema para rastrear de donde vienen, agradecer a quien lo refirio ni medir cuales fuentes funcionan mejor.',
  },
  {
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    title: 'Visibilidad en linea limitada',
    desc: 'Las personas que buscan ayuda legal en linea no pueden encontrarlo. Sus competidores invierten en su presencia digital mientras su firma depende de un sitio web desactualizado y la esperanza.',
  },
  {
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    title: 'Sin seguimiento sistematico de consultas',
    desc: 'Las consultas iniciales ocurren, pero no hay una secuencia de seguimiento estructurada. Los clientes potenciales se pierden porque nadie programo el siguiente punto de contacto.',
  },
];

const features = [
  { title: 'Automatizacion de formularios de admision', desc: 'Agilice la admision de clientes con formularios inteligentes que recopilan la informacion correcta desde el inicio. Las consultas se dirigen al area de practica correspondiente de forma automatica.' },
  { title: 'Notificaciones de estado de caso', desc: 'Mantenga a sus clientes informados sobre su asunto sin llamadas telefonicas manuales. Las actualizaciones automaticas de estado reducen las llamadas de "donde esta mi caso" y mejoran la satisfaccion del cliente.' },
  { title: 'Seguimiento de fuentes de referencia', desc: 'Etiquete cada nuevo cliente con su fuente de referencia. Rastree cuales relaciones, directorios y canales generan sus mejores casos para invertir en consecuencia.' },
  { title: 'Contenido de liderazgo intelectual', desc: 'Programe y distribuya analisis legales, estudios de caso y novedades por area de practica a traves de correo electronico y redes sociales. Posicione a su firma como la autoridad en su campo.' },
  { title: 'Secuencias de seguimiento de consultas', desc: 'Despues de una consulta inicial, active una secuencia de seguimiento estructurada. Correos electronicos y mensajes SMS oportunos mantienen a su firma presente hasta que el cliente decida avanzar.' },
  { title: 'Recopilacion de resenas y testimonios', desc: 'Solicite automaticamente resenas de Google y testimonios de clientes satisfechos al cierre del caso. Construya su reputacion en linea con minimo esfuerzo de su equipo.' },
];

const pipeline = [
  { stage: 'Consulta', desc: 'El cliente potencial envia el formulario de admision o hace contacto' },
  { stage: 'Evaluacion', desc: 'Reunion inicial para evaluar el asunto y la compatibilidad' },
  { stage: 'Contratado', desc: 'El cliente firma la carta de compromiso y el anticipo' },
  { stage: 'Caso Activo', desc: 'Caso en curso con actualizaciones de estado enviadas automaticamente' },
  { stage: 'Caso Cerrado', desc: 'Caso concluido con solicitud de resena activada' },
  { stage: 'Referencia', desc: 'El cliente satisfecho ingresa a la secuencia de cultivo de referencias' },
];

const stats = [
  { value: '42%', label: 'de los clientes legales potenciales eligen la primera firma que responde' },
  { value: '3.5x', label: 'mas referencias cuando existe un proceso sistematico de seguimiento y agradecimiento' },
  { value: '68%', label: 'de los clientes dicen que las actualizaciones proactivas de estado mejoran su experiencia' },
];
---

<BaseLayout
  t={tData}
  title="Automatizacion de Marketing para Firmas de Abogados | DUSA.studio"
  description="Deje de perder clientes potenciales por una admision lenta. DUSA ofrece a las firmas de abogados admision automatizada, seguimiento de referencias, seguimiento de consultas y notificaciones de estado de caso en una sola plataforma."
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Firmas de Abogados</span>
        <h1>Automatizacion de marketing para <span class="gradient-text">firmas de abogados</span></h1>
        <p class="ind-hero__sub">
          La experiencia de su firma no es el problema. El problema es que los clientes potenciales no pueden encontrarlo, y cuando lo hacen, una admision lenta y un seguimiento inconsistente los pierden antes de que contraten. DUSA corrige el proceso.
        </p>
        <a href="/es/start" class="btn btn--primary">Comenzar</a>
      </div>
    </div>
  </section>

  <!-- ═══ Pain Points ═══ -->
  <section class="ind-pain section--dark">
    <div class="container">
      <h2 class="ind-section-title">Le suena familiar?</h2>
      <div class="ind-pain__grid">
        {painPoints.map((p) => (
          <div class="ind-pain__card">
            <div class="ind-pain__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </div>
            <h3 class="ind-pain__title">{p.title}</h3>
            <p class="ind-pain__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Solution ═══ -->
  <section class="ind-solution section--dark">
    <div class="container">
      <h2 class="ind-section-title">Como funciona DUSA para <span class="gradient-text">firmas de abogados</span></h2>
      <p class="ind-solution__intro">Desde la primera consulta hasta el cierre del caso y la referencia, cada punto de contacto con el cliente esta rastreado, automatizado y es profesional.</p>
      <div class="ind-solution__grid">
        {features.map((f) => (
          <div class="ind-solution__item">
            <h3 class="ind-solution__item-title">{f.title}</h3>
            <p class="ind-solution__item-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Pipeline ═══ -->
  <section class="ind-pipeline section--dark">
    <div class="container">
      <h2 class="ind-section-title">Su pipeline de clientes</h2>
      <div class="ind-pipeline__track">
        {pipeline.map((p, i) => (
          <div class="ind-pipeline__stage">
            <div class="ind-pipeline__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ind-pipeline__stage-title">{p.stage}</h3>
            <p class="ind-pipeline__stage-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Stats ═══ -->
  <section class="ind-stats section--dark">
    <div class="container">
      <div class="ind-stats__grid">
        {stats.map((s) => (
          <div class="ind-stats__item">
            <div class="ind-stats__value">{s.value}</div>
            <p class="ind-stats__label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Listo para modernizar la captacion de clientes de su firma?</h2>
        <p class="ind-cta__desc">Configure la admision automatizada, el seguimiento de referencias y las secuencias de seguimiento en menos de una hora. Sin contratos de permanencia.</p>
        <div class="ind-cta__actions">
          <a href="/es/start" class="btn btn--primary">Comenzar</a>
          <a href="/blog/marketing-for-law-firms" class="ind-cta__link">Leer la guia</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Breadcrumb JSON-LD ═══ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://dusa.studio/es/" },
      { "@type": "ListItem", "position": 2, "name": "Industrias", "item": "https://dusa.studio/es/industries" },
      { "@type": "ListItem", "position": 3, "name": "Firmas de Abogados", "item": "https://dusa.studio/es/industries/law-firms" }
    ]
  })} />
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-lg);
  }

  /* ─── Section Titles ─── */
  .ind-section-title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* ─── Pain Points ─── */
  .ind-pain {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .ind-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }

  .ind-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-pain__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-sm);
  }

  .ind-pain__icon svg {
    width: 22px;
    height: 22px;
    color: var(--reef-aqua);
  }

  .ind-pain__title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-pain__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── Solution ─── */
  .ind-solution {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-solution__intro {
    text-align: center;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 560px;
    margin: calc(-1 * var(--space-md)) auto var(--space-xl);
    line-height: 1.65;
  }

  .ind-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .ind-solution__item {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast);
  }

  .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .ind-solution__item-title {
    font-family: var(--font-headline);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-solution__item-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.55);
  }

  /* ─── Pipeline ─── */
  .ind-pipeline {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pipeline__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-md);
  }

  .ind-pipeline__stage {
    text-align: center;
    position: relative;
  }

  .ind-pipeline__stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.25rem;
    right: calc(-1 * var(--space-md) / 2);
    width: var(--space-md);
    height: 1px;
    background: rgba(78, 216, 194, 0.2);
  }

  .ind-pipeline__num {
    font-family: var(--font-mono, monospace);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--reef-aqua);
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }

  .ind-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.25rem;
  }

  .ind-pipeline__stage-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(247, 244, 239, 0.5);
  }

  /* ─── Stats ─── */
  .ind-stats {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: center;
  }

  .ind-stats__item {
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .ind-stats__label {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-cta__desc {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .ind-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .ind-cta__link {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 500;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .ind-cta__link:hover {
    opacity: 0.75;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .ind-pain__grid {
      grid-template-columns: 1fr;
    }

    .ind-solution__grid {
      grid-template-columns: 1fr;
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(3, 1fr);
    }

    .ind-pipeline__stage:not(:last-child)::after {
      display: none;
    }

    .ind-stats__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(2, 1fr);
    }

    .ind-pain__card,
    .ind-solution__item {
      padding: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-md);
    }
  }

  /* ─── Light Mode ─── */
  :global(html[data-theme="light"]) .ind-hero__content h1,
  :global(html[data-theme="light"]) .ind-section-title,
  :global(html[data-theme="light"]) .ind-pain__title,
  :global(html[data-theme="light"]) .ind-solution__item-title,
  :global(html[data-theme="light"]) .ind-pipeline__stage-title,
  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-hero__sub,
  :global(html[data-theme="light"]) .ind-pain__desc,
  :global(html[data-theme="light"]) .ind-solution__intro,
  :global(html[data-theme="light"]) .ind-solution__item-desc,
  :global(html[data-theme="light"]) .ind-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ind-stats__label,
  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .ind-pain__card,
  :global(html[data-theme="light"]) .ind-solution__item {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__card:hover,
  :global(html[data-theme="light"]) .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.35);
  }

  :global(html[data-theme="light"]) .ind-stats__item {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain,
  :global(html[data-theme="light"]) .ind-solution,
  :global(html[data-theme="light"]) .ind-pipeline,
  :global(html[data-theme="light"]) .ind-stats {
    border-top-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__icon {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain__icon svg {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-pipeline__num {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-stats__value {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__link {
    color: var(--deep-ocean);
  }
</style>
