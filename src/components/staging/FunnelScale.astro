---
// DIRECTION B — "One scale"
//
// Argument: the two funnels never shared an axis, so "$1,074 vs $149" was a
// claim the reader had to do arithmetic on. Put both on one bar and the ratio
// is pre-attentive: you see 5.8x before you read a single number. Each segment
// is a real tool, proportional to its own cost, so the total is visibly the sum
// of its parts rather than an assertion.
import { STACK, DUSA_COST, STACK_TOTAL, SAVING, MULTIPLE, money } from '../../config/stack-compare';

const pct = (n: number) => (n / STACK_TOTAL) * 100;
---

<div class="sc">

  <div class="sc__row">
    <div class="sc__meta">
      <span class="sc__tag sc__tag--red">Eight tools</span>
      <span class="sc__figure sc__figure--red">{money(STACK_TOTAL)}<i>/mo</i></span>
    </div>
    <div class="sc__track">
      <div class="sc__bar sc__bar--stack" role="img"
           aria-label={`Eight separate tools totalling ${money(STACK_TOTAL)} per month`}>
        {STACK.map((tool, i) => (
          <span class="sc__seg" style={`--w:${pct(tool.cost)}%;--i:${i}`} tabindex="0"
                aria-label={`${tool.name}, ${tool.job}, ${money(tool.cost)} per month`}>
            <span class="sc__seg-pop">
              <b>{tool.name}</b>
              <i>{tool.job}</i>
              <em>{money(tool.cost)}</em>
            </span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="sc__row">
    <div class="sc__meta">
      <span class="sc__tag sc__tag--aqua">One platform</span>
      <span class="sc__figure sc__figure--aqua">{money(DUSA_COST)}<i>/mo</i></span>
    </div>
    <div class="sc__track">
      <div class="sc__bar sc__bar--dusa" style={`--w:${pct(DUSA_COST)}%`} role="img"
           aria-label={`DUSA, ${money(DUSA_COST)} per month, replacing all eight`}>
        <span class="sc__dusa-fill"></span>
      </div>
      <!-- The empty run of track IS the argument, so it gets labelled. -->
      <span class="sc__gap" style={`--start:${pct(DUSA_COST)}%`}>
        <span class="sc__gap-line" aria-hidden="true"></span>
        <span class="sc__gap-label">{money(SAVING)} a month you stop spending</span>
      </span>
    </div>
  </div>

  <p class="sc__kicker">
    The scattered stack costs <b>{MULTIPLE}x</b> more than DUSA, and still needs
    {STACK.length} logins to run it.
  </p>
</div>

<style>
  .sc { container-type: inline-size; display: grid; gap: 1.6rem; }

  .sc__row { display: grid; grid-template-columns: 13rem 1fr; gap: 1.4rem; align-items: center; }
  .sc__meta { display: flex; flex-direction: column; gap: 0.2rem; text-align: right; }
  .sc__tag {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sc__tag--red { color: rgba(232, 82, 78, 0.9); }
  .sc__tag--aqua { color: var(--reef-aqua); }
  .sc__figure {
    font-family: var(--font-mono); font-weight: 700; font-size: 2rem;
    line-height: 1.05; font-variant-numeric: tabular-nums;
  }
  .sc__figure i { font-style: normal; font-size: 0.875rem; opacity: 0.5; }
  .sc__figure--red { color: rgba(232, 82, 78, 0.95); }
  .sc__figure--aqua { color: var(--reef-aqua); }

  .sc__track { position: relative; }
  .sc__bar { display: flex; height: 58px; border-radius: 10px; overflow: visible; }

  .sc__seg {
    width: var(--w); position: relative; cursor: default;
    background: rgba(232, 82, 78, calc(0.14 + var(--i) * 0.035));
    border-right: 1px solid rgba(12, 14, 20, 0.55);
    transition: background var(--duration-fast), transform var(--duration-fast);
  }
  .sc__seg:first-child { border-radius: 10px 0 0 10px; }
  .sc__seg:last-child { border-radius: 0 10px 10px 0; border-right: 0; }
  .sc__seg:hover, .sc__seg:focus-visible {
    background: rgba(232, 82, 78, 0.62); outline: none;
  }

  .sc__seg-pop {
    position: absolute; left: 50%; bottom: calc(100% + 10px);
    transform: translate(-50%, 4px); opacity: 0; pointer-events: none;
    display: grid; gap: 0.1rem; padding: 0.5rem 0.7rem; border-radius: 9px;
    background: rgba(10, 14, 22, 0.95);
    border: 1px solid rgba(232, 82, 78, 0.35);
    white-space: nowrap; z-index: 5;
    transition: opacity var(--duration-fast), transform var(--duration-fast);
  }
  .sc__seg:hover .sc__seg-pop, .sc__seg:focus-visible .sc__seg-pop {
    opacity: 1; transform: translate(-50%, 0);
  }
  .sc__seg-pop b { font-size: 0.8125rem; color: var(--warm-white); }
  .sc__seg-pop i {
    font-style: normal; font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(247, 244, 239, 0.4);
  }
  .sc__seg-pop em {
    font-style: normal; font-family: var(--font-mono); font-size: 0.8125rem;
    color: rgba(232, 82, 78, 0.95);
  }

  .sc__bar--dusa {
    width: var(--w); min-width: 74px; border-radius: 10px;
    background: linear-gradient(135deg, rgba(78, 216, 194, 0.85), rgba(46, 130, 182, 0.8));
    box-shadow: 0 0 24px rgba(78, 216, 194, 0.28);
  }

  .sc__gap {
    position: absolute; left: var(--start); right: 0; top: 50%;
    transform: translateY(-50%); display: flex; align-items: center;
    gap: 0.7rem; padding-left: 0.9rem; pointer-events: none;
  }
  .sc__gap-line {
    flex: 1; height: 1px;
    background: repeating-linear-gradient(90deg,
      rgba(78, 216, 194, 0.4) 0 5px, transparent 5px 10px);
  }
  .sc__gap-label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    color: rgba(166, 245, 231, 0.75); white-space: nowrap;
  }

  .sc__kicker {
    margin: 0; text-align: center; max-width: none;
    font-size: 0.9375rem; color: rgba(247, 244, 239, 0.5);
  }
  .sc__kicker b { color: var(--reef-aqua); font-weight: 700; }

  @container (max-width: 760px) {
    .sc__row { grid-template-columns: 1fr; gap: 0.6rem; }
    .sc__meta { text-align: left; flex-direction: row; align-items: baseline; gap: 0.7rem; }
    .sc__bar { height: 46px; }
    /* The saving label has nowhere to sit once the bar is short. */
    .sc__gap { position: static; transform: none; padding: 0.5rem 0 0; }
    .sc__gap-line { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc__seg, .sc__seg-pop { transition: none; }
  }
</style>
