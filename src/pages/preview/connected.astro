---
// Private preview of an unreleased section. noindex + excluded from the
// sitemap (see astro.config.mjs). Delete this page once the section is placed.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectedPlatform from '../../components/ConnectedPlatform.astro';
import t from '../../i18n/translations/en.json';
---

<BaseLayout
  t={t}
  noindex={true}
  title="Preview: Connected Platform | DUSA . studio"
  description="Internal preview of an unreleased website section."
>
  <div class="preview-pad">
    <h1 class="sr-only">Preview: Connected Platform section</h1>
    <ConnectedPlatform t={t} />
  </div>
</BaseLayout>

<style>
  .preview-pad { padding-top: var(--nav-height); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
