---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | DUSA . studio" description="The page you're looking for has drifted off course. Head back to DUSA.studio or book a demo." noindex={true}>
  <section class="section section--dark error-page">
    <div class="container error-container">

      <!-- Floating particles for atmosphere -->
      <div class="error-particles" aria-hidden="true">
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
      </div>

      <!-- Glow ring behind the 404 -->
      <div class="error-glow" aria-hidden="true"></div>

      <div class="label error-label" style="visibility: hidden;">Off Course</div>

      <h1 class="error-heading" style="visibility: hidden;">
        <span class="gradient-text error-code">404</span>
      </h1>

      <p class="error-message" style="visibility: hidden;">
        This page drifted off course.<br />
        Let's get you back to smoother waters.
      </p>

      <div class="error-actions" style="visibility: hidden;">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Book a Demo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 2;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  /* --- Glow ring --- */
  .error-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 420px;
    height: 420px;
    transform: translate(-50%, -55%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(78, 216, 194, 0.08) 0%,
      rgba(78, 216, 194, 0.03) 40%,
      transparent 70%
    );
    animation: glow-pulse 4s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes glow-pulse {
    0%, 100% {
      opacity: 0.6;
      transform: translate(-50%, -55%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -55%) scale(1.08);
    }
  }

  /* --- Floating particles --- */
  .error-particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--reef-aqua);
    opacity: 0;
    animation: drift 8s ease-in-out infinite;
  }

  .particle:nth-child(1) {
    left: 15%;
    top: 80%;
    animation-delay: 0s;
    animation-duration: 9s;
  }
  .particle:nth-child(2) {
    left: 75%;
    top: 85%;
    animation-delay: 1.5s;
    animation-duration: 7s;
    width: 3px;
    height: 3px;
  }
  .particle:nth-child(3) {
    left: 40%;
    top: 90%;
    animation-delay: 3s;
    animation-duration: 10s;
  }
  .particle:nth-child(4) {
    left: 60%;
    top: 75%;
    animation-delay: 2s;
    animation-duration: 8s;
    width: 2px;
    height: 2px;
  }
  .particle:nth-child(5) {
    left: 25%;
    top: 70%;
    animation-delay: 4s;
    animation-duration: 11s;
    width: 3px;
    height: 3px;
  }
  .particle:nth-child(6) {
    left: 85%;
    top: 78%;
    animation-delay: 5s;
    animation-duration: 9s;
    width: 2px;
    height: 2px;
  }

  @keyframes drift {
    0% {
      opacity: 0;
      transform: translateY(0) translateX(0);
    }
    15% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.2;
    }
    85% {
      opacity: 0.35;
    }
    100% {
      opacity: 0;
      transform: translateY(-300px) translateX(30px);
    }
  }

  /* --- Label --- */
  .error-label {
    position: relative;
    z-index: 1;
  }

  /* --- 404 Heading --- */
  .error-heading {
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-md);
  }

  .error-code {
    font-family: var(--font-headline);
    font-size: clamp(7rem, 20vw, 14rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    display: block;
  }

  /* --- Message --- */
  .error-message {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--sandstone);
    opacity: 0.75;
    line-height: 1.6;
    max-width: 400px;
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  /* --- Buttons --- */
  .error-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  /* --- Mobile --- */
  @media (max-width: 600px) {
    .error-glow {
      width: 280px;
      height: 280px;
    }

    .error-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .error-actions .btn {
      width: 100%;
    }
  }

  /* noscript fallback */
  :global(noscript) ~ * .error-label,
  :global(noscript) ~ * .error-heading,
  :global(noscript) ~ * .error-message,
  :global(noscript) ~ * .error-actions {
    visibility: visible !important;
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .error-message {
    color: var(--deep-black);
    opacity: 0.6;
  }

  :global(html[data-theme="light"]) .error-glow {
    background: radial-gradient(
      circle,
      rgba(26, 58, 92, 0.1) 0%,
      rgba(26, 58, 92, 0.04) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .particle {
    background: var(--deep-ocean);
  }
</style>

<script>
  function initErrorAnimations() {
    if (typeof gsap === 'undefined') {
      // Fallback: just show everything
      document.querySelectorAll('.error-label, .error-heading, .error-message, .error-actions').forEach(el => {
        (el as HTMLElement).style.visibility = 'visible';
        (el as HTMLElement).style.opacity = '1';
      });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo('.error-label',
      { opacity: 0, y: 20, visibility: 'hidden' },
      { opacity: 1, y: 0, visibility: 'visible', duration: 0.6 }
    )
    .fromTo('.error-code',
      { opacity: 0, scale: 0.8, visibility: 'hidden' },
      { opacity: 1, scale: 1, visibility: 'visible', duration: 0.8, ease: 'back.out(1.5)' },
      '-=0.3'
    )
    .fromTo('.error-heading',
      { visibility: 'hidden' },
      { visibility: 'visible', duration: 0.01 },
      '<'
    )
    .fromTo('.error-message',
      { opacity: 0, y: 20, visibility: 'hidden' },
      { opacity: 0.75, y: 0, visibility: 'visible', duration: 0.6 },
      '-=0.4'
    )
    .fromTo('.error-actions',
      { opacity: 0, y: 20, visibility: 'hidden' },
      { opacity: 1, y: 0, visibility: 'visible', duration: 0.6 },
      '-=0.3'
    );
  }

  // GSAP is loaded with defer, so wait for it
  if (typeof gsap !== 'undefined') {
    initErrorAnimations();
  } else {
    window.addEventListener('load', () => {
      // Small delay to ensure GSAP's defer script has executed
      setTimeout(initErrorAnimations, 100);
    });
  }
</script>
