---
/**
 * DusaGuide: the floating glass guide (DUSA's face for its AI).
 * It lives in the bottom-right corner, looks around, and when the visitor goes quiet it
 * flies to the most useful thing in view, points at it and says one short,
 * industry-aware line. Click it and it asks what you want to fix, then shows
 * you where that lives on the platform. Behaviour: /js/guide.v2.js.
 * English pages only until a locale's dictionary carries a `guide` block.
 *
 * Art: Higgsfield renders (Apple-style glass, seven 3D poses) with the real
 * plain chest (the lotus badge is parked: versions with it are in media-src/guide/web-v3).
 */
import { PERSONA_ICONS } from '../../config/industry-icons';
interface Props { t?: Record<string, any>; lang?: string; }
const { t = {}, lang = 'en' } = Astro.props;
const g = t?.guide || null;
const on = !!g || lang === 'en';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const quiet = /^\/(start|thank-you|terms|privacy-policy|onboarding|preview)(\/|$)/.test(path);
const BOOK_URL = 'https://link.dusa.studio/widget/bookings/dusa-demo';

const copy = {
  name: 'DUSA guide',
  open: 'Open the DUSA guide',
  close: 'Close',
  hide: 'Hide the guide',
  show: 'Show the DUSA guide',
  ai: 'AI guide',
  intro: "Hi, I'm your DUSA guide. Tell me what kind of business you run and I'll show you what DUSA does for it.",
  askOutcome: 'What would you like to fix first?',
  askOutcomeBiz: 'What should we fix first for your {biz}?',
  outcomes: { calls: 'Missed calls', noshows: 'No-shows', reviews: 'More reviews', admin: 'Less admin' },
  outcomeLines: {
    calls: 'Missed calls get an instant text back, and on Growth the AI answers and books the job for you. It all lives here, under Conversations.',
    noshows: 'Reminders go out before every booking and people get nudged to rebook. Your calendar sits here, with bookings and payments together.',
    reviews: 'After every job DUSA asks happy customers for a review and helps you reply to each one. That is Reputation.',
    admin: 'Quotes, invoices, follow-ups and reminders run on workflows you set up once. That is Automation doing the admin for you.',
  },
  /* the same four problems, said the way each kind of business lives them */
  outcomeBy: {
    tradies: {
      calls: 'On the tools when the phone rings? The caller gets a text back straight away, and on Growth the AI answers, takes the details and books the job. It lives here, under Conversations.',
      noshows: 'Customers get a reminder before every job, so you are not driving out to an empty house. Bookings sit here in your calendar.',
      reviews: 'When a job is done, DUSA texts the customer a review link while they are still happy. More Google reviews, more local jobs. That is Reputation.',
      admin: 'Quotes followed up, invoices chased and reminders sent, without you on the phone at night. Set it up once and Automation runs it.',
    },
    salons: {
      calls: "Mid-colour and can't pick up? The client gets a text back with your booking link, and on Growth the AI answers and books them in. It lives here, under Conversations.",
      noshows: 'Every appointment gets a reminder and an easy way to reschedule instead of not turning up. Your book sits here, with payments alongside.',
      reviews: 'After each visit DUSA asks the client for a review and helps you reply to every one. Fresh reviews are what fill the chairs. That is Reputation.',
      admin: 'Rebooking nudges, birthday offers and follow-ups go out on their own. Set them up once and Automation keeps the chairs full.',
    },
    clinics: {
      calls: 'Front desk flat out? The caller gets a text back straight away, and on Growth the AI answers, takes the details and books the appointment. It lives here, under Conversations.',
      noshows: 'Patients get a reminder before every appointment and can confirm or reschedule from the message. Your calendar sits here, with intake forms sent ahead.',
      reviews: 'After an appointment DUSA asks patients for a review and helps you reply with care. That is Reputation.',
      admin: 'Intake forms, recalls and follow-ups run on workflows you set up once. That is Automation taking the load off the front desk.',
    },
    hospitality: {
      calls: 'Busy service and the phone rings out? The caller gets a text back with a booking link, and on Growth the AI answers and takes the booking. It lives here, under Conversations.',
      noshows: 'Every booking gets a reminder and a quick way to confirm, so tables are not held for people who are not coming. Bookings sit here in your calendar.',
      reviews: 'After a visit DUSA asks guests for a review and helps you reply to every one, good or bad. That is Reputation.',
      admin: 'Function enquiries, follow-ups and offers go out on their own. Set it up once and Automation runs it.',
    },
    'real-estate': {
      calls: 'At an open home when a buyer calls? They get a text back straight away, and on Growth the AI answers, takes their details and books the inspection. It lives here, under Conversations.',
      noshows: 'Inspections and appraisals get a reminder with a quick way to confirm or reschedule. Your calendar sits here.',
      reviews: 'After settlement DUSA asks your vendors and buyers for a review and helps you reply. Reviews help win the next listing. That is Reputation.',
      admin: 'New enquiries get followed up for weeks, not days, without you chasing. Set it up once and Automation keeps your contacts warm.',
    },
    fitness: {
      calls: 'Coaching a class when someone calls about a trial? They get a text back straight away, and on Growth the AI answers and books the trial. It lives here, under Conversations.',
      noshows: 'Trials and sessions get a reminder, and anyone who misses one gets a nudge to rebook. Your calendar sits here.',
      reviews: 'DUSA asks happy members for a review at the right moment and helps you reply. That is Reputation.',
      admin: 'Trial follow-ups, check-in nudges and win-back messages go out on their own. Set them up once and Automation runs it.',
    },
  },
  askBiz: "Hold on, before you scroll on: what kind of work do you do? I'll show you the parts that matter for you.",
  bizChips: { tradies: 'Trades', salons: 'Salon or beauty', clinics: 'Clinic', hospitality: 'Hospitality', 'real-estate': 'Real estate', fitness: 'Fitness', other: 'Something else' },
  bizIcons: PERSONA_ICONS,
  aPlan: 'Find my plan',
  aBook: 'Book a call',
  aChat: 'Chat with us',
  aPricing: 'See pricing',
  aSeePlatform: 'Show me on the platform',
  picked: {
    tradies: "For trades, a missed call is a missed job. DUSA's AI answers while you're on the tools, books the job in and chases the invoice.",
    salons: 'For salons, it comes down to full chairs. DUSA sends the reminders, prompts the rebooking and asks happy clients for a review.',
    clinics: "For clinics, no-shows hurt most. DUSA reminds patients, sends intake forms ahead and recalls them when they're due.",
    hospitality: 'For venues, the fastest reply wins the booking. DUSA answers every enquiry quickly and replies to every review.',
    'real-estate': 'For agencies, the first reply often wins the listing. DUSA answers every enquiry day or night and keeps contacts warm.',
    fitness: 'For gyms and studios, it is all about keeping members. DUSA follows up trials, nudges check-ins and invites lapsed members back.',
    other: 'Whatever you run, DUSA puts your leads, bookings, messages, reviews and payments in one place, with AI doing the follow-up.',
  },
  biz: { tradies: 'trade business', salons: 'salon', clinics: 'clinic', hospitality: 'venue', 'real-estate': 'agency', fitness: 'gym or studio', other: 'business', default: 'business' },
  tips: {
    platform: 'This wheel is everything your {biz} runs on, behind one login. Tap a slice to see what is inside.',
    funnel: 'Most owners pay for around eight tools that never talk to each other. Watch what one platform changes.',
    quiz: 'Not sure which plan fits? Five quick questions and I will match one to your {biz}.',
    proof: 'These are real reviews of HighLevel, the platform DUSA is built on. Tap any one to read the original.',
    steps: 'It starts with key 1: a 30-minute call, and we set it up with you.',
    cta: 'Want to see it running for your {biz}? Book a 30-minute call and we will walk you through it.',
    pricing: 'The plans differ mostly by how much the AI does for you. Growth is where it starts answering your calls and chats.',
    services: 'Rather not do it yourself? These are the things our team can set up, run or build for your {biz}.',
  },
  /* a tip changes with what the visitor told us: their problem first, then their industry */
  tipsBy: {
    platform: {
      tradies: 'For a trade business, start with Conversations and Calendar: that is where a missed call turns into a booked job. Tap a slice to look inside.',
      salons: 'For a salon, Calendar and Reputation do the heavy lifting: full chairs and fresh reviews. Tap a slice to look inside.',
      clinics: 'For a clinic, Calendar and Automation matter most: reminders, intake forms and recalls. Tap a slice to look inside.',
      hospitality: 'For a venue, Conversations and Reputation matter most: fast replies and answered reviews. Tap a slice to look inside.',
      'real-estate': 'For an agency, Conversations and Automation matter most: every enquiry answered and every contact kept warm. Tap a slice to look inside.',
      fitness: 'For a gym or studio, Automation and Conversations matter most: trial follow-ups and win-back messages. Tap a slice to look inside.',
    },
    pricing: {
      'pain:calls': 'For missed calls, Growth is the one: the AI answers and books for you. Starter still texts every missed caller back.',
      'pain:noshows': 'Good news for no-shows: reminders and rebooking are on every plan, Starter included.',
      'pain:reviews': 'Review requests are on every plan. Growth adds AI that helps reply to each review.',
      'pain:admin': 'Workflows are unlimited on every plan, so the admin runs itself from Starter up. Growth adds AI to handle the replies.',
    },
    cta: {
      'pain:calls': 'Want missed calls sorted for your {biz}? Book a 30-minute call and we will set it up with you.',
      'pain:noshows': 'Want no-shows sorted for your {biz}? Book a 30-minute call and we will set it up with you.',
      'pain:reviews': 'Want more reviews for your {biz}? Book a 30-minute call and we will set it up with you.',
      'pain:admin': 'Want the admin off your plate? Book a 30-minute call and we will set it up with you.',
    },
  },
  ...(g || {}),
};
const data = JSON.stringify({ book: BOOK_URL, copy });
const POSES = ['look', 'fly', 'point', 'down', 'up', 'wave'];
---

{on && !quiet && (
  <>
    <aside class="dzg" id="dz-guide" aria-label={copy.name} data-pose="idle" hidden>
      <button type="button" class="dzg__bot" id="dzg-bot" aria-label={copy.open} aria-expanded="false" aria-controls="dzg-bubble">
        <span class="dzg__float">
          <span class="dzg__aura" aria-hidden="true"></span>
          <img class="dzg__pose is-on" data-pose="idle" src="/media/guide/guide-idle.webp" width="220" height="220" alt="" decoding="async" />
          {POSES.map((p) => (
            <img class="dzg__pose" data-pose={p} data-src={`/media/guide/guide-${p}.webp`} width="220" height="220" alt="" decoding="async" />
          ))}
          <span class="dzg__tint" aria-hidden="true"></span>
        </span>
      </button>
    </aside>
    <div class="dzg__bubble" id="dzg-bubble" role="dialog" aria-label={copy.name} hidden>
      <button type="button" class="dzg__x" id="dzg-x" aria-label={copy.close}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <p class="dzg__tag"><span class="dzg__mark" aria-hidden="true"></span>{copy.ai}</p>
      <p class="dzg__msg" id="dzg-msg" role="status" aria-live="polite"></p>
      <div class="dzg__actions" id="dzg-actions"></div>
      <div class="dzg__links" id="dzg-links"></div>
      <button type="button" class="dzg__hide" id="dzg-hide" hidden>{copy.hide}</button>
    </div>
    <div class="dzs" id="dzg-spark" aria-hidden="true" hidden>
      <span class="dzs__p dzs__p--3"><span><i></i></span></span>
      <span class="dzs__p dzs__p--2"><span><i></i></span></span>
      <span class="dzs__p dzs__p--1"><span><i></i></span></span>
    </div>
    <button type="button" class="dzg-launch" id="dzg-launch" aria-label={copy.show} title={copy.show} hidden>
      <span class="dzg__mark dzg__mark--lg" aria-hidden="true"></span>
    </button>
    <script type="application/json" id="dz-guide-data" set:html={data}></script>
    <script is:inline src="/js/guide.v2.js" defer></script>
  </>
)}

<style is:global>
  .dzg {
    position: fixed; left: 0; top: 0; z-index: 900;
    width: 150px; height: 150px;
    transform: translate3d(var(--dzg-x, 110vw), var(--dzg-y, 60vh), 0);
    transition: transform var(--dzg-dur, 900ms) cubic-bezier(0.45, 0, 0.15, 1), opacity 0.3s ease;
    pointer-events: none;
    will-change: transform;
  }
  .dzg[hidden], .dzg-launch[hidden], .dzg__bubble[hidden], .dzg__hide[hidden] { display: none !important; }
  .dzg.is-instant { transition: opacity 0.3s ease; }
  .dzg.is-tucked { opacity: 0; visibility: hidden; }
  .dzg__bot {
    position: absolute; inset: 4% 16% 8%; padding: 0; border: 0; background: none; cursor: pointer;
    pointer-events: auto; border-radius: 45%;
    -webkit-tap-highlight-color: transparent;
  }
  .dzg.is-tucked .dzg__bot { pointer-events: none; }
  .dzg__bot:focus-visible { outline: 2px solid var(--reef-aqua); outline-offset: 4px; }
  .dzg__float { position: absolute; inset: -4.55% -23.53% -9.09%; display: block; animation: dzgBob 4.4s ease-in-out infinite; transform-origin: 50% 80%; }
  .dzg.is-flying .dzg__float { animation: dzgArc var(--dzg-dur, 900ms) ease-in-out; }
  .dzg__pose {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    opacity: 0; transition: opacity 0.34s ease 0.1s;   /* the old pose lingers a beat, so there is no see-through dip */
    filter: drop-shadow(0 12px 18px rgba(8, 30, 44, 0.32));
    user-select: none; -webkit-user-drag: none;
  }
  .dzg__pose.is-on { opacity: 1; transition: opacity 0.3s ease; }
  .dzg.is-landing .dzg__float { animation: dzgLand 0.62s cubic-bezier(0.3, 0.7, 0.3, 1); }
  .dzg__mark { display: inline-block; flex: none; width: 14px; height: 14px; background: currentColor; -webkit-mask: url('/lotus.svg') center / contain no-repeat; mask: url('/lotus.svg') center / contain no-repeat; }
  .dzg__mark--lg { width: 26px; height: 26px; }
  .dzg[data-mirror="true"] .dzg__pose, .dzg[data-mirror="true"] .dzg__tint { transform: scaleX(-1); }
  @keyframes dzgBob { 0%, 100% { transform: translateY(0) rotate(-1.2deg); } 50% { transform: translateY(-8px) rotate(1.2deg); } }
  @keyframes dzgArc { 0% { transform: translateY(0) scale(1) rotate(0deg); } 30% { transform: translateY(-18px) scale(1.04) rotate(-3deg); } 60% { transform: translateY(-24px) scale(1.05) rotate(2deg); } 100% { transform: translateY(0) scale(1) rotate(0deg); } }
  @keyframes dzgLand { 0% { transform: translateY(0) scale(1); } 35% { transform: translateY(5px) scale(1.03, 0.97); } 70% { transform: translateY(-3px) scale(0.99, 1.01); } 100% { transform: translateY(0) scale(1); } }

  /* Resting, the guide is clear glass. When it is doing something (pointing,
     talking, hovered) it warms up in mint: a soft aura behind it and a mint
     wash inside its own silhouette. */
  .dzg__aura {
    position: absolute; inset: 6% 12% 4%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(78, 216, 194, 0.55), rgba(78, 216, 194, 0.16) 55%, rgba(78, 216, 194, 0) 78%);
    filter: blur(12px); opacity: 0; transform: scale(0.8);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .dzg__tint {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(78, 216, 194, 0.05) 25%, rgba(78, 216, 194, 0.75) 80%, rgba(143, 184, 216, 0.55));
    -webkit-mask: var(--dzg-mask, url("/media/guide/guide-idle.webp")) center / contain no-repeat;
    mask: var(--dzg-mask, url("/media/guide/guide-idle.webp")) center / contain no-repeat;
    mix-blend-mode: multiply; opacity: 0; transition: opacity 0.6s ease;
  }
  .dzg.is-active .dzg__aura { opacity: 1; transform: scale(1); animation: dzgAura 2.6s ease-in-out infinite; }
  .dzg.is-active .dzg__tint { opacity: 0.3; }
  .dzg__bot:hover .dzg__aura, .dzg__bot:focus-visible .dzg__aura { opacity: 0.6; transform: scale(0.95); }
  .dzg__bot:hover .dzg__tint { opacity: 0.18; }
  @keyframes dzgAura { 0%, 100% { opacity: 0.72; } 50% { opacity: 1; } }

  /* The beacon: a small light the guide sends to the thing worth looking at.
     X and Y ease differently, so it travels on an arc; two fainter copies lag
     behind it as a tail. Landed, it rings like a ripple where the mouse should go. */
  .dzs { position: fixed; left: 0; top: 0; z-index: 902; width: 0; height: 0; pointer-events: none; }
  .dzs[hidden] { display: none !important; }
  .dzs__p, .dzs__p > span { position: absolute; left: 0; top: 0; display: block; will-change: transform; }
  .dzs__p { transform: translate3d(var(--dzs-x, 0px), 0, 0); transition: transform var(--dzs-dur, 900ms) cubic-bezier(0.5, 0, 0.2, 1); }
  .dzs__p > span { transform: translate3d(0, var(--dzs-y, 0px), 0); transition: transform var(--dzs-dur, 900ms) cubic-bezier(0.2, 0.7, 0.3, 1); }
  .dzs__p--2, .dzs__p--2 > span { transition-delay: 70ms; }
  .dzs__p--3, .dzs__p--3 > span { transition-delay: 140ms; }
  .dzs.is-instant .dzs__p, .dzs.is-instant .dzs__p > span { transition: none; }
  .dzs i {
    position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 38%, rgba(255, 255, 255, 0.75) 58%, rgba(255, 255, 255, 0) 74%);
    box-shadow: 0 0 12px 3px rgba(255, 255, 255, 0.95), 0 0 30px 10px rgba(143, 200, 232, 0.6), 0 0 54px 18px rgba(78, 216, 194, 0.28);
    animation: dzsTwinkle 1.5s ease-in-out infinite;
  }
  .dzs__p--1 i::before, .dzs__p--1 i::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 30px; height: 2px; margin: -1px 0 0 -15px; border-radius: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), #fff 50%, rgba(255, 255, 255, 0));
  }
  .dzs__p--1 i::after { transform: rotate(90deg); }
  .dzs__p--2 i { transform: scale(0.6); opacity: 0.55; animation: none; }
  .dzs__p--3 i { transform: scale(0.36); opacity: 0.32; animation: none; }
  .dzs.is-landed .dzs__p--2 i, .dzs.is-landed .dzs__p--3 i { opacity: 0; transition: opacity 0.3s ease; }
  .dzs.is-landed .dzs__p--1 > span::before, .dzs.is-landed .dzs__p--1 > span::after {
    content: ''; position: absolute; left: -26px; top: -26px; width: 52px; height: 52px; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.95); box-shadow: 0 0 14px rgba(143, 200, 232, 0.7);
    animation: dzsPing 1.7s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .dzs.is-landed .dzs__p--1 > span::after { animation-delay: 0.55s; }
  @keyframes dzsTwinkle { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.22); } }
  @keyframes dzsPing { 0% { transform: scale(0.35); opacity: 1; } 100% { transform: scale(1.9); opacity: 0; } }
  /* on a light page a white light needs an edge to be seen */
  html[data-theme="light"] .dzs i {
    box-shadow: 0 0 0 1.5px rgba(26, 58, 92, 0.30), 0 0 12px 3px rgba(255, 255, 255, 0.95), 0 0 26px 9px rgba(106, 170, 207, 0.85), 0 0 50px 18px rgba(78, 216, 194, 0.4);
  }
  html[data-theme="light"] .dzs.is-landed .dzs__p--1 > span::before, html[data-theme="light"] .dzs.is-landed .dzs__p--1 > span::after {
    border-color: rgba(26, 58, 92, 0.42); border-width: 1.5px; box-shadow: 0 0 14px rgba(106, 170, 207, 0.8);
  }
  @media (prefers-reduced-motion: reduce) { .dzs i, .dzs span::before, .dzs span::after { animation: none !important; } }

  /* Speech bubble: bold glass card, placed by the script */
  .dzg__bubble {
    position: fixed; z-index: 901; left: 0; top: 0;
    width: min(320px, calc(100vw - 24px));
    padding: 14px 16px;
    border-radius: 20px;
    color: var(--warm-white);
    background: linear-gradient(150deg, rgba(30, 44, 62, 0.9), rgba(12, 16, 24, 0.92));
    border: 1px solid rgba(247, 244, 239, 0.16);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
    animation: dzgPop 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .dzg__bubble[data-tail="br"] { border-bottom-right-radius: 6px; transform-origin: 90% 100%; }
  .dzg__bubble[data-tail="bl"] { border-bottom-left-radius: 6px; transform-origin: 10% 100%; }
  .dzg__bubble[data-tail="tr"] { border-top-right-radius: 6px; transform-origin: 90% 0; }
  .dzg__bubble[data-tail="tl"] { border-top-left-radius: 6px; transform-origin: 10% 0; }
  @keyframes dzgPop { from { opacity: 0; transform: scale(0.88) translateY(8px); } to { opacity: 1; transform: none; } }
  .dzg__tag { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--reef-aqua); max-width: none; }
  .dzg__msg { margin: 0; padding-right: 16px; font-size: 0.95rem; line-height: 1.45; max-width: none; color: inherit; }
  .dzg__x { position: absolute; top: 8px; right: 8px; width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgba(247, 244, 239, 0.08); color: inherit; cursor: pointer; }
  .dzg__x:hover { background: rgba(247, 244, 239, 0.16); }
  .dzg__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .dzg__actions--grid { display: grid; grid-template-columns: 1fr 1fr; }
  .dzg__actions:empty, .dzg__links:empty { display: none; }
  .dzg__act {
    display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 14px;
    border-radius: 999px; font-family: var(--font-headline); font-size: 0.86rem; font-weight: 500; cursor: pointer; text-align: left;
    color: var(--warm-white); background: rgba(247, 244, 239, 0.07); border: 1px solid rgba(247, 244, 239, 0.18);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .dzg__actions--grid .dzg__act { border-radius: 14px; padding: 0 12px; }
  .dzg__act:hover { border-color: rgba(78, 216, 194, 0.6); background: rgba(78, 216, 194, 0.12); transform: translateY(-1px); }
  .dzg__act--primary { color: var(--deep-black); background: linear-gradient(135deg, var(--reef-aqua), var(--mist-blue)); border-color: transparent; }
  .dzg__act--primary:hover { color: var(--deep-black); filter: brightness(1.06); }
  .dzg__act svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--reef-aqua); }
  .dzg__act--primary svg { color: currentColor; }
  .dzg__links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(247, 244, 239, 0.1); }
  .dzg__link { display: inline-flex; align-items: center; gap: 5px; min-height: 30px; padding: 0; border: 0; background: none; cursor: pointer; font-size: 0.82rem; color: rgba(247, 244, 239, 0.82); }
  .dzg__link svg { width: 14px; height: 14px; color: var(--reef-aqua); }
  .dzg__link:hover { color: var(--reef-aqua); }
