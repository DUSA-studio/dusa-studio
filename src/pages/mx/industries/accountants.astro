---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';
const lang = 'es';
const region = 'mx';
---

<BaseLayout t={tData} title="CRM para Contadores y Tenedores de Libros | DUSA . studio" description="Automatiza la recopilacion de documentos, recordatorios de fechas limite y el seguimiento de clientes entre temporadas fiscales. DUSA les da a los contadores un sistema de crecimiento que funciona todo el ano.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://dusa.studio/mx/" },
      { "@type": "ListItem", "position": 2, "name": "Industrias", "item": "https://dusa.studio/mx/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Contadores", "item": "https://dusa.studio/mx/industries/accountants/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Contadores y Tenedores de Libros</span>
        <h1>Termina con el ciclo de todo o nada<br/><span class="gradient-text">con comunicacion constante todo el ano</span></h1>
        <p class="industry-hero__sub">DUSA automatiza la recopilacion de documentos, el seguimiento de fechas limite y la comunicacion con clientes para que puedas enfocarte en los numeros, no en lo administrativo.</p>
        <div class="industry-hero__actions">
          <a href="/mx/start" class="btn btn--primary">Comienza ahora</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Agenda una demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">El Problema</span>
      <h2>Te suena familiar?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">📈</div>
          <h3>Carga de trabajo estacional extrema</h3>
          <p>La temporada fiscal te entierra. Fuera de temporada te preguntas de donde vendra el siguiente cliente. Los altibajos son agotadores.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📄</div>
          <h3>Persiguiendo documentos de clientes</h3>
          <p>Envias una solicitud. Luego un recordatorio. Luego otro. Lograr que los clientes entreguen sus documentos a tiempo se siente como un segundo trabajo.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📅</div>
          <h3>Seguimiento manual de fechas limite</h3>
          <p>ISR, IVA, declaraciones anuales, pagos provisionales. Manejar docenas de fechas limite de clientes en hojas de calculo es una receta para declaraciones atrasadas.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🤷</div>
          <h3>Sin comunicacion entre temporadas fiscales</h3>
          <p>Los clientes solo saben de ti cuando algo se vence. Sin contacto constante durante el ano, se olvidan de ti hasta el ultimo minuto.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">La Solucion</span>
      <h2>Como funciona DUSA para <span class="gradient-text">contadores y tenedores de libros</span></h2>
      <p class="solution__intro">Una sola plataforma maneja la recopilacion de documentos, la gestion de fechas limite, el seguimiento de clientes y el rastreo de referidos.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Automatizacion de recopilacion de documentos</h3>
          <p>Envia solicitudes automaticas con enlaces seguros de carga. Haz seguimiento automatico hasta que lleguen los documentos.</p>
        </div>
        <div class="solution-card">
          <h3>Secuencias de recordatorio de fechas limite</h3>
          <p>Recordatorios automaticos para ISR, IVA, declaraciones anuales y pagos provisionales. Tus clientes y tu equipo se adelantan a cada fecha.</p>
        </div>
        <div class="solution-card">
          <h3>Portal del cliente</h3>
          <p>Dale a tus clientes un solo lugar para subir documentos, revisar el avance y comunicarse con tu equipo.</p>
        </div>
        <div class="solution-card">
          <h3>Campanas de seguimiento todo el ano</h3>
          <p>Tips fiscales, recordatorios de deducciones y consejos de planeacion financiera te mantienen presente entre temporadas de declaraciones.</p>
        </div>
        <div class="solution-card">
          <h3>Rastreo de referidos</h3>
          <p>Sabe exactamente cuales clientes refieren nuevos negocios y automatiza mensajes de agradecimiento cuando lo hacen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Tu Pipeline</span>
      <h2>Cada cliente, cada fecha limite, <span class="gradient-text">rastreado automaticamente</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Nuevo Cliente</h3>
          <p>El formulario de alta recopila RFC, datos de la entidad e informacion del contador anterior.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Documentos Solicitados</h3>
          <p>Se envia solicitud automatica con enlace seguro de carga y lista de verificacion.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Documentos Recibidos</h3>
          <p>Todos los documentos llegaron. Tu equipo recibe la notificacion y el trabajo puede comenzar.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>En Proceso</h3>
          <p>Declaracion o estado financiero en preparacion. El cliente ve actualizaciones de estatus.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Presentado</h3>
          <p>Presentado ante el SAT. El cliente recibe notificacion con confirmacion y proximos pasos.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Revision</h3>
          <p>Revision posterior a la presentacion y planeacion para el siguiente periodo comienza.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultados</span>
      <h2>Hecho para despachos que quieren <span class="gradient-text">escalar</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">70%</div>
          <p>reduccion en tiempo persiguiendo documentos con seguimientos automaticos</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">2x</div>
          <p>mas referidos de clientes existentes con campanas de seguimiento</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">0</div>
          <p>fechas limite perdidas cuando los recordatorios corren en automatico</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Listo para dejar de perseguir documentos?</h2>
        <p>Pon tu despacho a funcionar con DUSA en menos de una semana.</p>
        <div class="final-cta__actions">
          <a href="/mx/start" class="btn btn--primary">Comienza ahora</a>
          <a href="/blog/crm-for-accountants" class="btn btn--outline">Lee la guia</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>