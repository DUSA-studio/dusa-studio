  .calc__out-note { margin-top: var(--space-sm); font-size: 0.75rem; line-height: 1.5; color: var(--ink-dim); max-width: 34ch; }

  /* Five-year chart. The ramp has to be visible before any number is read. */
  .grow__out { display: grid; align-content: center; }
  .grow__chart {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem;
    align-items: end; margin-bottom: var(--space-md);
  }
  .grow__col { display: grid; justify-items: center; gap: 0.35rem; align-content: end; }
  .grow__col b {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;
    color: var(--ink-soft); white-space: nowrap;
  }
  .grow__col i {
    display: block; width: 100%; border-radius: 6px 6px 0 0; min-height: 6px;
    background: linear-gradient(180deg, var(--ink-dim), var(--panel-edge));
    transition: height 0.45s var(--ease-out);
  }
  .grow__col span {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-dim);
  }
  .grow__col.is-hero b { font-size: 1rem; color: var(--accent); }
  .grow__col.is-hero i {
    background: linear-gradient(180deg, var(--accent-soft), rgba(46,130,182,0.55));
    box-shadow: 0 0 26px var(--accent-soft);
  }
  .grow__col.is-hero span { color: var(--accent); }

  .grow__totals {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    padding-top: var(--space-sm); border-top: 1px solid var(--panel-edge);
  }
  .grow__totals div { display: grid; gap: 0.15rem; text-align: center; }
  .grow__totals span {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .grow__totals b { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--ink); }
  .grow__totals div:first-child b { font-size: clamp(1.6rem, 3.4vw, 2.1rem); color: var(--accent); }

  .grow__run { margin-top: var(--space-sm); text-align: center; font-size: 0.875rem; color: var(--ink-mid); max-width: none; }
  .grow__run b { color: var(--ink); font-family: var(--font-mono); }

  /* The year-two jump, called out where the inputs are so it moves as they play. */
  .grow__jump {
    margin-top: var(--space-sm); padding: 0.8rem 1rem; border-radius: 12px;
    background: var(--accent-wash); border: 1px solid var(--accent-edge);
    display: flex; align-items: baseline; justify-content: center; gap: 0.5rem;
    flex-wrap: wrap; text-align: center;
  }
  .grow__jump span { font-size: 0.875rem; color: var(--ink-soft); }
  .grow__jump b { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: var(--accent); }

  .grow__adv { margin-top: var(--space-sm); }
  .grow__adv summary {
    cursor: pointer; font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-dim);
    padding: 0.4rem 0;
  }
  .grow__adv summary:hover { color: var(--accent); }
  .grow__adv p { margin-top: 0.6rem; font-size: 0.75rem; color: var(--ink-dim); max-width: none; }

  .grow__note { margin: var(--space-md) auto 0; max-width: 68ch; text-align: center; font-size: 0.75rem; line-height: 1.6; color: var(--ink-dim); }
  .grow__cta { text-align: center; margin-top: var(--space-md); }

  .cr__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .cr__grid article {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--panel); border: 1px solid var(--panel-edge);
  }
  .cr__grid h3 { font-size: 1.0625rem; margin-bottom: 0.4rem; }
  .cr__grid p { font-size: 0.9375rem; color: var(--ink-mid); max-width: none; }

  /* Requirements read as a reference table, not a sales pitch. */
  .cr__reqs { max-width: 860px; margin: 0 auto; }
  .cr__req {
    display: grid; grid-template-columns: 12rem 1fr; gap: 1.2rem;
    padding: 0.9rem 0; border-bottom: 1px solid var(--rule);
  }
  .cr__req-region {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent);
  }
  .cr__req-needs { color: var(--ink-soft); font-size: 0.9375rem; }
  .cr__reqs-note { max-width: 860px; margin: var(--space-md) auto 0; font-size: 0.8125rem; color: var(--ink-faint); }

  .cr__terms { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .cr__terms article {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--warn-wash); border: 1px solid var(--warn-edge);
  }
  .cr__terms h3 { font-size: 1rem; margin-bottom: 0.4rem; color: var(--warn); }
  .cr__terms p { font-size: 0.9375rem; color: var(--ink-soft); max-width: none; }
  .cr__legal { margin: var(--space-md) auto 0; max-width: 76ch; text-align: center; font-size: 0.75rem; line-height: 1.6; color: var(--ink-dim); }

  .cr__fit { max-width: 720px; margin: 0 auto; display: grid; gap: 0.7rem; list-style: none; padding: 0; }
  .cr__fit li { padding-left: 1.6rem; position: relative; color: var(--ink-soft); font-size: 1rem; }
  .cr__fit li::before {
    content: ''; position: absolute; left: 0; top: 0.55em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  }

  .cr-cta { text-align: center; }
  .cr-cta p { color: var(--ink-mid); margin: var(--space-sm) auto var(--space-md); }
  .cr-cta__alt { font-size: 0.875rem; margin-top: var(--space-sm); }
  .cr-cta__alt a { color: var(--accent); }

  @media (max-width: 1024px) { .cr__pillars { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .cr__ways, .calc, .grow { grid-template-columns: 1fr; }
    .cr__grid, .cr__terms { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .cr__pillars, .cr__grid, .cr__terms { grid-template-columns: 1fr; }
    .cr__rates-head { display: none; }
    /* Becomes a small card per plan: name, then one labelled line per figure,
       label left and value right. Reads cleanly at a glance. */
    .cr__rate {
      grid-template-columns: 1fr; gap: 0;
      padding: 1.1rem 0;
    }
    .cr__rate-name { font-size: 1.0625rem; margin-bottom: 0.5rem; }
    .cr__rate > span:not(.cr__rate-name) {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 1rem; padding: 0.3rem 0;
    }
    .cr__rate > span:not(.cr__rate-name)::before {
      content: attr(data-l);
      font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--ink-dim); flex-shrink: 0;
    }
    /* Value and unit sit on one line here rather than stacked. */
    .cr__rate em { display: flex; align-items: baseline; gap: 0.35rem; text-align: right; }
    .cr__req { grid-template-columns: 1fr; gap: 0.3rem; }
  }

</style>

<script>
  import { SHARE, ANNUAL_MONTHS_CHARGED, money } from '../config/careers';

  /* ── Calculator 1: a book as it stands today ── */
  document.querySelectorAll('[data-calc]').forEach((root) => {
    const inputs = [...root.querySelectorAll('input[data-plan]')] as HTMLInputElement[];
    const modes = [...root.querySelectorAll('[data-mode]')] as HTMLButtonElement[];
    const el = (s: string) => root.querySelector(s) as HTMLElement;
    let mode: 'monthly' | 'annual' = 'monthly';
    const clamp = (n: number) => Math.max(0, Math.min(999, Math.round(n) || 0));

    function render() {
      let clients = 0, perMonth = 0;
      inputs.forEach((i) => {
        const n = clamp(Number(i.value));
        clients += n;
        perMonth += n * Number(i.dataset.price) * SHARE;
      });
      const plural = clients === 1 ? 'client' : 'clients';
      if (mode === 'monthly') {
        el('[data-out-label]').textContent = 'Every month';
        el('[data-out-value]').textContent = money(perMonth);
        el('[data-out-sub]').textContent = `from ${clients} ${plural}`;
        el('[data-out-year-label]').textContent = 'Over 12 months';
        el('[data-out-year]').textContent = money(perMonth * 12);
        el('[data-out-note]').textContent =
          'Arrives each time their payments land, for as long as those licences stay active.';
      } else {
        const total = perMonth * ANNUAL_MONTHS_CHARGED;
        el('[data-out-label]').textContent = 'Paid to you upfront';
        el('[data-out-value]').textContent = money(total);
        el('[data-out-sub]').textContent = `from ${clients} ${plural} paying for a year`;
        el('[data-out-year-label]').textContent = 'Works out monthly at';
        el('[data-out-year]').textContent = money(total / 12);
        el('[data-out-note]').textContent =
          `Annual clients are charged the equivalent of ${ANNUAL_MONTHS_CHARGED} months. Your cut lands once their payment reaches us.`;
      }
    }
    inputs.forEach((i) => i.addEventListener('input', () => { i.value = String(clamp(Number(i.value))); render(); }));
    root.querySelectorAll('[data-step]').forEach((b) => b.addEventListener('click', () => {
      const [id, d] = (b as HTMLElement).dataset.step!.split(':');
      const input = inputs.find((i) => i.dataset.plan === id);
      if (!input) return;
      input.value = String(clamp(Number(input.value) + Number(d)));
      render();
    }));
    modes.forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as 'monthly' | 'annual';
      modes.forEach((m) => m.classList.toggle('is-on', m === b));
      render();
    }));
    render();
  });

  /* ── The five-year projection ──
     Month-by-month cohort model. Clients you already have carry forward at
     the retention rate, and the month's new sales are added on top:
         active(m) = active(m-1) * retention + salesPerMonth
     A year's figure is the SUM of that year's monthly earnings, which is what
     someone actually banks. Using the year-end run rate instead would flatter
     every number on the page. */
  document.querySelectorAll('[data-grow]').forEach((root) => {
    const el = (s: string) => root.querySelector(s) as HTMLElement;
    const rateEl = root.querySelector('[data-g="rate"]') as HTMLInputElement;
    const retEl = root.querySelector('[data-g="retention"]') as HTMLInputElement;
    const planBtns = [...root.querySelectorAll('[data-g-plan]')] as HTMLButtonElement[];
    const YEARS = 5;
    let price = Number(planBtns.find((b) => b.classList.contains('is-on'))?.dataset.gPlan ?? 149);

    function render() {
      const perMonth = Math.max(1, Math.min(50, Math.round(Number(rateEl.value)) || 1));
      const retPct = Math.max(85, Math.min(100, Math.round(Number(retEl.value)) || 97));
      rateEl.value = String(perMonth);
      retEl.value = String(retPct);
      const keep = retPct / 100;

      const years = new Array(YEARS).fill(0);
      let active = 0, total = 0;
      for (let m = 1; m <= YEARS * 12; m++) {
        active = active * keep + perMonth;
        const earned = active * price * SHARE;
        years[Math.ceil(m / 12) - 1] += earned;
        total += earned;
      }

      years.forEach((v, i) => {
        const val = root.querySelector(`[data-g-val="${i + 1}"]`) as HTMLElement;
        if (val) val.textContent = money(Math.round(v));
      });
      el('[data-g-total]').textContent = money(Math.round(total));
      el('[data-g-run]').textContent = money(Math.round(active * price * SHARE));
      el('[data-g-clients]').textContent = String(Math.round(active));
      el('[data-g-mult]').textContent =
        (years[0] > 0 ? (years[1] / years[0]).toFixed(1) : '0') + 'x';

      const peak = Math.max(...years, 1);
      years.forEach((v, i) => {
        const bar = root.querySelector(`[data-g-bar="${i + 1}"]`) as HTMLElement;
        if (bar) bar.style.height = Math.max(6, Math.round((v / peak) * 130)) + 'px';
      });
    }

    [rateEl, retEl].forEach((i) => i.addEventListener('input', render));
    root.querySelectorAll('[data-g-step]').forEach((b) => b.addEventListener('click', () => {
      const [which, d] = (b as HTMLElement).dataset.gStep!.split(':');
      const input = which === 'rate' ? rateEl : retEl;
      input.value = String(Number(input.value) + Number(d));
      render();
    }));
    planBtns.forEach((b) => b.addEventListener('click', () => {
      price = Number(b.dataset.gPlan);
      planBtns.forEach((x) => x.classList.toggle('is-on', x === b));
      render();
    }));
    render();
  });
</script>
