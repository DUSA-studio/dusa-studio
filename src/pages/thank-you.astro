---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThankYouPage from '../components/pages/ThankYouPage.astro';
import t from '../i18n/translations/en.json';
/* noindex: emits <meta name="robots" content="noindex, nofollow">. The page is
   also excluded from the sitemap (astro.config.mjs). The trial conversion only
   fires from /js/tracking.v2.js when ?status=ok&t=<token> matches the token the
   /start flow stored, or a checkout was started from /start in the last 2 hours. */
---

<BaseLayout t={t} title={t.thankYou.metaTitle} description={t.thankYou.metaDesc} noindex>
  <ThankYouPage t={t} regionKey="au" />
</BaseLayout>
