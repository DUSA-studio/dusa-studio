---
// SocialProof.astro — Trust, borrowed honestly.
// DUSA runs on HighLevel. Until DUSA has its own body of client reviews, this
// section shows HighLevel's public ratings and real HighLevel reviews, quoted
// word for word with a link to each original. Never add a quote here that
// cannot be linked to the review it came from.
// Checked 9 Nov 2026: Trustpilot 4.9 (15,298 reviews), G2 4.6 (665 reviews).
const TRUSTPILOT_URL = 'https://www.trustpilot.com/review/www.gohighlevel.com';
const G2_URL = 'https://www.g2.com/products/highlevel/reviews';

const reviews = [
  {
    name: 'Aaron Brooks', place: 'United States', date: '13 Sep 2026', stars: 4,
    url: 'https://www.trustpilot.com/reviews/6adbd9287af86ebe88d1e615',
    text: 'Been running my small marketing agency on HighLevel for about eight months and it replaced three separate subscriptions for me. The pipelines and follow up workflows are what I touch daily and the snapshots made spinning up new client accounts quick.',
  },
  {
    name: 'Bob G.', place: 'United States', date: '29 Dec 2024', stars: 5,
    url: 'https://www.trustpilot.com/reviews/67734376e81126a9ec7a2cec',
    text: 'The all-in-one platform has replaced multiple software subscriptions, streamlining my workflow and saving me both time and money. Its intuitive interface allowed me to get up and running quickly… Automating follow-ups and managing client relationships has never been easier.',
  },
  {
    name: 'Bill Lupo', place: 'United States', date: '3 Feb 2025', stars: 5,
    url: 'https://www.trustpilot.com/reviews/67a1102743f3050bbe584245',
    text: 'GoHighLevel has completely transformed the way I manage my business and interact with clients… it eliminates the need for multiple software subscriptions, saving both time and money.',
  },
  {
    name: 'Simon Lual', place: 'United States', date: '6 Nov 2026', stars: 5,
    url: 'https://www.trustpilot.com/reviews/6aede974a42e7cb72ca34485',
    text: 'In less than 15 minutes, he explained the issue, solved it, and outlined the right next steps. I was struggling with A2P for over 2 months, trying to do it alone.',
  },
  {
    name: 'Nik', place: 'Canada', date: '2 May 2026', stars: 5,
    url: 'https://www.trustpilot.com/reviews/69f66c24ef0194dda48dc851',
    text: 'I just had the most incredible onboarding experience, hands down the best I’ve ever seen! Huge shoutout to Gurvinder Singh, whose professionalism and calm demeanor are truly unmatched. His thoroughness in setting up the GoHighLevel CRM was absolutely world-class…',
  },
  {
    name: 'Gavin Johnston', place: 'Canada', date: '3 May 2026', stars: 5,
    url: 'https://www.trustpilot.com/reviews/69f815f852cc781329755cc7',
    text: 'Everything was well communicated throughout the process and the issue was resolved.',
  },
];

interface Props { t?: Record<string, any>; }
const { t = {} } = Astro.props;
const sp = t?.socialProof || {};

const label = sp.trustLabel || 'Built on HighLevel';
const heading = sp.trustHeading || 'Rated 4.9 by over 15,000 businesses.';
const headingAccent = sp.trustHeadingAccent || 'DUSA runs on the same platform.';
const sub = sp.trustSub || 'HighLevel powers more than 2 million businesses worldwide. DUSA sets it up for you, adds AI that works for your business, and supports you in Australia. Here is what HighLevel users say, word for word.';
const readLabel = sp.readReview || 'Read review';
const openLabel = sp.openOriginal || 'Open on Trustpilot';
const verifiedLabel = sp.verifiedOn || 'Review of HighLevel on Trustpilot';
const footLine = sp.trustFoot || 'Reviews of HighLevel, the platform DUSA is built on. Quoted word for word, each linked to the original.';
const closeLabel = sp.close || 'Close';

const stats = [
  { value: sp.stat4Value || '$800+', label: sp.stat4Label || 'Saved monthly' },
  { value: sp.stat1Value || '5+', label: sp.stat1Label || 'Tools replaced' },
  { value: sp.stat5Value || '< 48hrs', label: sp.stat5Label || 'Setup time' },
];

const STAR = 'M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.49L10 14.26 5.06 16.7l.94-5.49-4-3.9 5.53-.8z';
const initials = (n: string) => n.replace(/\./g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]).join('');
const clip = (s: string, n = 150) => (s.length > n ? s.slice(0, s.lastIndexOf(' ', n)).replace(/[,.…]+$/, '') + '…' : s);
---

<section class="proof section section--dark" id="proof">
  <div class="container">
    <div class="proof__header reveal">
      <span class="label">{label}</span>
      <h2>{heading} <span class="gradient-text">{headingAccent}</span></h2>
      <p class="proof__sub">{sub}</p>
    </div>

    <div class="proof__ratings reveal">
      <button type="button" class="proof__rating-card" data-review-open="tp">
        <span class="proof__rating-brand proof__rating-brand--tp"><svg viewBox="0 0 20 20" aria-hidden="true"><path d={STAR} fill="currentColor"/></svg> Trustpilot</span>
        <span class="proof__rating-score">4.9<small>/5</small></span>
        <span class="proof__rating-meta">15,000+ reviews · Excellent</span>
      </button>
      <button type="button" class="proof__rating-card" data-review-open="g2">
        <span class="proof__rating-brand proof__rating-brand--g2">G2</span>
        <span class="proof__rating-score">4.6<small>/5</small></span>
        <span class="proof__rating-meta">660+ reviews</span>
      </button>
    </div>

    <div class="proof__stats reveal">
      {stats.map((s) => (
        <div class="proof__stat">
          <span class="proof__stat-value">{s.value}</span>
          <span class="proof__stat-label">{s.label}</span>
        </div>
      ))}
    </div>

    <div class="proof__grid reveal">
      {reviews.map((r, i) => (
        <button type="button" class="proof__review" data-review-open={String(i)} aria-haspopup="dialog">
          <span class="proof__review-stars" aria-label={`${r.stars} out of 5 stars`}>
            {[1, 2, 3, 4, 5].map((n) => <i class={n <= r.stars ? 'on' : ''} aria-hidden="true"></i>)}
          </span>
          <span class="proof__review-text">&ldquo;{clip(r.text)}&rdquo;</span>
          <span class="proof__review-foot">
            <span class="proof__review-avatar" aria-hidden="true">{initials(r.name)}</span>
            <span class="proof__review-who"><b>{r.name}</b><small>{r.place} · {r.date}</small></span>
            <span class="proof__review-read">{readLabel}</span>
          </span>
        </button>
      ))}
    </div>

    <p class="proof__foot reveal">{footLine}</p>
  </div>

  <dialog class="proof__modal" id="proof-modal" aria-labelledby="proof-modal-name">
    <div class="proof__modal-card">
      <button type="button" class="proof__modal-close" data-review-close aria-label={closeLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <span class="proof__modal-source" data-m="source"></span>
      <span class="proof__review-stars proof__modal-stars" data-m="stars"></span>
      <blockquote class="proof__modal-text" data-m="text"></blockquote>
      <div class="proof__modal-who"><b id="proof-modal-name" data-m="name"></b><small data-m="meta"></small></div>
      <a class="btn btn--outline proof__modal-open" data-m="link" target="_blank" rel="noopener nofollow"><span data-m="linklabel"></span>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
      </a>
    </div>
  </dialog>
  <script type="application/json" id="proof-data" set:html={JSON.stringify({
    reviews, verifiedLabel, openLabel,
    tp: { name: 'HighLevel on Trustpilot', meta: 'TrustScore 4.9 out of 5 · 15,000+ reviews · rated Excellent', text: 'HighLevel, the platform DUSA is built on, is rated Excellent by its users on Trustpilot. 97% of reviews are 5 stars.', url: TRUSTPILOT_URL, stars: 5, label: openLabel },
    g2: { name: 'HighLevel on G2', meta: '4.6 out of 5 · 660+ verified reviews', text: 'On G2, the business software review site, HighLevel is rated 4.6 out of 5, with reviewers praising its automation and its all-in-one value.', url: G2_URL, stars: 5, label: 'Open on G2' },
  })}></script>
</section>

<script>
  (() => {
    const modal = document.getElementById('proof-modal') as HTMLDialogElement | null;
    const dataEl = document.getElementById('proof-data');
    if (!modal || !dataEl) return;
    const D = JSON.parse(dataEl.textContent || '{}');
    const q = (k: string) => modal.querySelector(`[data-m="${k}"]`) as HTMLElement;
    const open = (key: string) => {
      const r = key === 'tp' || key === 'g2' ? D[key] : D.reviews[Number(key)];
      if (!r) return;
      const isReview = !(key === 'tp' || key === 'g2');
      q('source').textContent = isReview ? D.verifiedLabel : (key === 'tp' ? 'Trustpilot' : 'G2');
      q('stars').innerHTML = [1, 2, 3, 4, 5].map((n) => `<i class="${n <= r.stars ? 'on' : ''}"></i>`).join('');
      q('text').textContent = isReview ? `“${r.text}”` : r.text;
      q('name').textContent = r.name;
      q('meta').textContent = isReview ? `${r.place} · ${r.date}` : r.meta;
      const a = q('link') as HTMLAnchorElement;
      a.href = r.url;
      q('linklabel').textContent = r.label || D.openLabel;
      if (typeof modal.showModal !== 'function') { window.open(r.url, '_blank', 'noopener'); return; }
      const y = window.scrollY;
      modal.showModal();
      if (Math.abs(window.scrollY - y) > 2) window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
    };
    document.querySelectorAll('[data-review-open]').forEach((el) => {
      el.addEventListener('click', () => open((el as HTMLElement).dataset.reviewOpen || ''));
    });
    modal.querySelector('[data-review-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  })();
</script>

<style>
  .proof__header { text-align: center; max-width: 820px; margin: 0 auto var(--space-lg); }
  .proof__header h2 { font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.08; margin: 0.7rem 0 0.9rem; }
  .proof__header h2 .gradient-text { display: block; }
  .proof__sub { margin: 0 auto; max-width: 640px; font-size: 1.05rem; line-height: 1.6; color: rgba(247, 244, 239, 0.72); }

  .proof__ratings { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 0 auto var(--space-lg); }
  .proof__rating-card {
    display: grid; grid-template-columns: auto auto; grid-template-areas: 'brand brand' 'score meta';
    align-items: end; column-gap: 0.9rem; row-gap: 0.35rem; text-align: left; cursor: pointer;
    min-width: 250px; padding: 1rem 1.3rem 1.05rem; border-radius: 20px; font: inherit; color: inherit;
    border: 1px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(150deg, rgba(247, 244, 239, 0.09), rgba(247, 244, 239, 0.025));
    -webkit-backdrop-filter: blur(16px) saturate(150%); backdrop-filter: blur(16px) saturate(150%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.14), 0 18px 40px -22px rgba(0, 0, 0, 0.6);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .proof__rating-card:hover { transform: translateY(-2px); border-color: rgba(78, 216, 194, 0.45); }
  .proof__rating-brand { grid-area: brand; display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-headline); font-weight: 700; font-size: 0.95rem; }
  .proof__rating-brand svg { width: 18px; height: 18px; }
  .proof__rating-brand--tp svg { color: #00b67a; }
  .proof__rating-brand--g2 { color: #ff492c; letter-spacing: 0.02em; }
  .proof__rating-score { grid-area: score; font-family: var(--font-headline); font-weight: 700; font-size: 2.3rem; line-height: 1; }
  .proof__rating-score small { font-size: 0.95rem; opacity: 0.55; margin-left: 2px; }
  .proof__rating-meta { grid-area: meta; font-size: 0.82rem; color: rgba(247, 244, 239, 0.66); padding-bottom: 0.3rem; }

  .proof__stats { display: flex; justify-content: center; gap: var(--space-xl); flex-wrap: wrap; margin: 0 auto var(--space-lg); }
  .proof__stat { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .proof__stat-value { font-family: var(--font-headline); font-weight: 700; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; }
  .proof__stat-label { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(247, 244, 239, 0.62); }

  .proof__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .proof__review {
    display: flex; flex-direction: column; gap: 0.9rem; text-align: left; cursor: pointer; font: inherit; color: inherit;
    padding: 1.3rem 1.3rem 1.1rem; border-radius: 20px;
    border: 1px solid rgba(247, 244, 239, 0.12);
    background: linear-gradient(150deg, rgba(247, 244, 239, 0.07), rgba(247, 244, 239, 0.02));
    -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.1), 0 16px 36px -22px rgba(0, 0, 0, 0.55);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .proof__review:hover, .proof__review:focus-visible { transform: translateY(-3px); border-color: rgba(78, 216, 194, 0.45); }
  .proof__review-stars { display: inline-flex; gap: 3px; }
  .proof__review-stars i { width: 18px; height: 18px; border-radius: 3px; background: rgba(247, 244, 239, 0.18); position: relative; }
  .proof__review-stars i.on { background: #00b67a; }
  .proof__review-stars i::after { content: ''; position: absolute; inset: 3px; background: #fff; clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  .proof__review-text { flex: 1; font-size: 0.98rem; line-height: 1.55; color: rgba(247, 244, 239, 0.88); }
  .proof__review-foot { display: flex; align-items: center; gap: 0.7rem; }
  .proof__review-avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; font-family: var(--font-headline); font-weight: 700; font-size: 0.8rem; color: #0C0E14; background: linear-gradient(135deg, #4ED8C2, #6AAACF); }
  .proof__review-who { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .proof__review-who b { font-size: 0.92rem; }
  .proof__review-who small { font-size: 0.78rem; color: rgba(247, 244, 239, 0.58); }
  .proof__review-read { margin-left: auto; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--reef-aqua); white-space: nowrap; }
  .proof__foot { text-align: center; margin: var(--space-md) auto 0; font-size: 0.85rem; color: rgba(247, 244, 239, 0.55); }

  .proof__modal { position: fixed; inset: 0; margin: auto; height: fit-content; max-height: 90vh; padding: 0; border: 0; background: transparent; max-width: min(560px, 92vw); width: 100%; color: inherit; overflow: visible; }
  .proof__modal :global(i) { width: 18px; height: 18px; border-radius: 3px; background: rgba(247, 244, 239, 0.18); position: relative; display: inline-block; }
  .proof__modal :global(i.on) { background: #00b67a; }
  .proof__modal :global(i)::after { content: ''; position: absolute; inset: 3px; background: #fff; clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  .proof__modal::backdrop { background: rgba(6, 9, 14, 0.62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .proof__modal[open] { animation: proofIn 0.28s cubic-bezier(0.2, 0.85, 0.3, 1); }
  @keyframes proofIn { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
  .proof__modal-card {
    position: relative; display: flex; flex-direction: column; gap: 0.9rem; padding: 1.8rem 1.8rem 1.6rem; border-radius: 26px;
    color: #F7F4EF; border: 1px solid rgba(247, 244, 239, 0.16);
    background: linear-gradient(150deg, rgba(30, 44, 62, 0.92), rgba(12, 16, 24, 0.94));
    -webkit-backdrop-filter: blur(24px) saturate(160%); backdrop-filter: blur(24px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.14), 0 40px 90px -30px rgba(0, 0, 0, 0.8);
  }
  .proof__modal-close { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; color: inherit; border: 1px solid rgba(247, 244, 239, 0.16); background: rgba(247, 244, 239, 0.06); }
  .proof__modal-source { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--reef-aqua); }
  .proof__modal-text { margin: 0; font-size: 1.12rem; line-height: 1.6; }
  .proof__modal-who { display: flex; flex-direction: column; gap: 2px; }
  .proof__modal-who small { color: rgba(247, 244, 239, 0.6); }
  .proof__modal-open { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; color: #0C0E14 !important; background: linear-gradient(135deg, #4ED8C2, #6AAACF) !important; border-color: transparent !important; }

  :global(html[data-theme="light"]) .proof__sub { color: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .proof__rating-card,
  :global(html[data-theme="light"]) .proof__review { border-color: rgba(255, 255, 255, 0.95); background: linear-gradient(150deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.55)); box-shadow: inset 0 1px 0 #fff, 0 0 0 1px rgba(26, 58, 92, 0.08), 0 18px 40px -24px rgba(26, 58, 92, 0.35); color: var(--deep-black); }
  :global(html[data-theme="light"]) .proof__rating-meta,
  :global(html[data-theme="light"]) .proof__review-who small,
  :global(html[data-theme="light"]) .proof__stat-label,
  :global(html[data-theme="light"]) .proof__foot { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .proof__review-text { color: rgba(12, 14, 20, 0.82); }
  :global(html[data-theme="light"]) .proof__review-stars i { background: rgba(12, 14, 20, 0.14); }
  :global(html[data-theme="light"]) .proof__review-stars i.on { background: #00b67a; }
  :global(html[data-theme="light"]) .proof__review-read { color: var(--deep-ocean); }

  @media (max-width: 960px) { .proof__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .proof__grid { grid-template-columns: 1fr; }
    .proof__rating-card { min-width: 0; flex: 1 1 100%; }
    .proof__stats { gap: var(--space-md); }
    .proof__modal-card { padding: 1.5rem 1.3rem 1.3rem; }
  }
</style>
