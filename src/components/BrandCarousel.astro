---
// BrandCarousel.astro — Auto-scrolling client logo strip
const brands = [
  { name: "PHMG", file: "PHMG.webp" },
  { name: "The Royal", file: "The-Royal.webp" },
  { name: "The Montague", file: "The-Montague.webp" },
  { name: "Harriets", file: "Harriets.png" },
  { name: "The Toxteth", file: "The-Toxteth.webp" },
  { name: "Minskys", file: "Minskys.webp" },
  { name: "Papandrea", file: "Papandrea.webp" },
  { name: "Little Lane Library", file: "Little-Lane-Library.webp" },
  { name: "Headline Solutions", file: "Headline-Solutions.webp" },
  { name: "Marle Marle", file: "Marle-Marle.webp" },
  { name: "Styllar", file: "Styllar.webp" },
  { name: "SEN", file: "SEN.webp" },
  { name: "Tommy's Italian", file: "Tommys-Italian.webp" },
  { name: "Baskk", file: "Baskk.webp" },
  { name: "EziCleen", file: "EziCleen.webp" },
  { name: "Regatta", file: "Regatta.webp" },
  { name: "RayWhite", file: "RayWhite.png" },
  { name: "Ottimo", file: "Ottimo.webp" },
  { name: "Kin Cacao", file: "Kin-Cacao.webp" },
  { name: "SmashX", wordmark: true },
];

interface Props {
  t?: Record<string, any>;
  /** Slim trust strip (label only, tight padding) for directly under a hero. */
  compact?: boolean;
}
const { t = {}, compact = false } = Astro.props;

const s = t?.brandCarousel || {};
const bcLabel = s.label || 'Powering Growth For';
const stripLabel = s.stripLabel || 'Businesses running on DUSA';
const bcHeading = s.heading || 'Brands that';
const bcHeadingAccent = s.headingAccent || 'bloom';
---

<section class={`brands section section--dark ${compact ? 'brands--compact' : ''}`} id="brands">
  <div class="container">
    <div class="brands__header">
      {compact
        ? <p class="brands__strip-label"><span class="gradient-text">{stripLabel}</span></p>
        : <><span class="label">{bcLabel}</span><h2>{bcHeading} <span class="gradient-text">{bcHeadingAccent}</span></h2></>}
    </div>
  </div>

  <div class="brands__carousel" aria-label="Brands we work with">
    <div class="brands__track">
      {/* Triple for seamless infinite loop */}
      {[...brands, ...brands, ...brands].map((b) => (
        <div class="brands__logo-wrap">
          {b.wordmark ? (
            <span class="brands__wordmark">{b.name}</span>
          ) : (
            <img
              class="brands__logo"
              src={`/images/brands/${b.file}`}
              alt={b.name}
              loading="lazy"
              width="220"
              height="100"
            />
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brands {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
    overflow: hidden;
  }

  .brands__header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  /* Compact trust strip under the hero */
  .brands--compact { padding-top: var(--space-md); padding-bottom: var(--space-sm); }
  .brands--compact .brands__header { margin-bottom: var(--space-sm); }
  .brands__strip-label {
    margin: 0 auto; max-width: none; font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em;
    color: rgba(247, 244, 239, 0.55);
  }
  .brands__strip-label .gradient-text { font-family: var(--font-headline); text-transform: none; letter-spacing: 0; font-weight: 700; font-size: 0.9375rem; }
  .brands--compact .brands__logo-wrap { height: 72px; }
  .brands--compact .brands__logo { max-height: 56px; }
  :global(html[data-theme="light"]) .brands__strip-label { color: rgba(12, 14, 20, 0.6); }

  .brands__header h2 {
    font-weight: 600;
    color: var(--warm-white);
    margin-top: var(--space-xs);
  }

  .brands__carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .brands__track {
    display: flex;
    gap: var(--space-xl);
    align-items: center;
    width: max-content;
    animation: brandScroll 45s linear infinite;
  }

  .brands__track:hover {
    animation-play-state: paused;
  }

  @keyframes brandScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% / 3));
    }
  }

  .brands__logo-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100px;
    min-width: 220px;
    padding: 0 var(--space-sm);
  }

  .brands__logo {
    max-height: 90px;
    max-width: 220px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.45;
    transition: opacity var(--duration-normal) var(--ease-out),
                filter var(--duration-normal) var(--ease-out);
  }

  .brands__logo:hover {
    opacity: 0.85;
  }

  /* Typeset stand-in for a brand with no usable logo file. Matched to the
     optical weight and opacity of the real logos so the row stays even. */
  .brands__wordmark {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--warm-white);
    opacity: 0.45;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .brands__wordmark:hover { opacity: 0.85; }
  :global(html[data-theme="light"]) .brands__wordmark { color: var(--deep-black); }

  /* Reserve for logos with opaque backgrounds if needed later */

  /* ─── RESPONSIVE ─── */
  @media (max-width: 768px) {
    .brands {
      padding-top: var(--space-lg);
      padding-bottom: var(--space-lg);
    }

    .brands__track {
      gap: var(--space-lg);
      animation-duration: 35s;
    }

    .brands__logo-wrap {
      min-width: 180px;
      height: 80px;
    }

    .brands__logo {
      max-height: 70px;
      max-width: 180px;
    }
  }

  @media (max-width: 480px) {
    .brands {
      padding-top: var(--space-md);
      padding-bottom: var(--space-md);
    }

    .brands__header {
      margin-bottom: var(--space-sm);
    }

    .brands__track {
      gap: var(--space-md);
      animation-duration: 30s;
    }

    .brands__logo-wrap {
      min-width: 150px;
      height: 70px;
      padding: 0 0.25rem;
    }

    .brands__logo {
      max-height: 60px;
      max-width: 150px;
    }
  }

  /* GSAP reveal */
  .brands__header {
    visibility: hidden;
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .brands__header h2 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .brands__logo {
    filter: brightness(0) invert(12%) sepia(40%) saturate(1200%) hue-rotate(180deg) brightness(80%);
    opacity: 0.55;
  }

  :global(html[data-theme="light"]) .brands__logo:hover {
    opacity: 0.85;
  }
</style>

<script>
  function initBrandAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initBrandAnimations, 100);
      return;
    }
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');

    gsap.set('.brands__header', { visibility: 'visible' });

    gsap.fromTo('.brands__header',
      { y: 20, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.brands',
          start: 'top 85%',
        },
      }
    );
  }
  initBrandAnimations();
</script>
