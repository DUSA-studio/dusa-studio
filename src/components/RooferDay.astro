      const roofGeo = new THREE.ExtrudeGeometry(roofShape, { depth: D + 0.6, bevelEnabled: true, bevelThickness: 0.04, bevelSize: 0.04, bevelSegments: 2 }); roofGeo.translate(0, 0, -(D + 0.6) / 2);
