---
// Footer.astro
---

<footer class="footer section--dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <img class="footer__lotus" src="/dusa-logo-animated.webp" alt="DUSA logo" width="42" height="42" />
          <span>DUSA <span style="color:var(--reef-aqua)">.</span> studio</span>
        </a>
        <p class="footer__tagline">Brands that bloom.</p>
        <p class="footer__desc">Digital Utility for Sales & Automation. The AI-powered growth platform for small businesses.</p>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Platform</h4>
        <a href="/#features" class="footer__link">Features</a>
        <a href="/#how-it-works" class="footer__link">How It Works</a>
        <a href="/pricing" class="footer__link">Pricing</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Company</h4>
        <a href="/about" class="footer__link">About</a>
        <a href="/contact" class="footer__link">Contact</a>
        <a href="/blog" class="footer__link">Blog</a>
      </div>

      <div class="footer__col footer__col--right">
        <h4 class="footer__heading">Get in Touch</h4>
        <a href="mailto:contact@dusa.studio" class="footer__link footer__link--highlight">contact@dusa.studio</a>
        <a href="tel:+61488825686" class="footer__link">+61 488 825 686</a>
        <p class="footer__link" style="opacity:0.4">Sydney, Australia</p>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; 2026 DUSA . studio. All rights reserved.</p>
      <div class="footer__legal">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-2xl) 0 var(--space-lg);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(78, 216, 194, 0.15), transparent);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .footer__lotus {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    object-fit: contain;
    transition: transform var(--duration-normal);
  }

  .footer__logo:hover .footer__lotus {
    transform: scale(1.05);
  }

  .footer__tagline {
    font-family: var(--font-headline);
    font-weight: 500;
    color: var(--reef-aqua);
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .footer__desc {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.6;
    max-width: 300px;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 239, 0.4);
    margin-bottom: var(--space-sm);
    font-weight: 400;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__col--right {
    text-align: right;
    align-items: flex-end;
  }

  .footer__link {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.6);
    transition: color var(--duration-fast);
  }

  .footer__link:hover {
    color: var(--reef-aqua);
  }

  .footer__link--highlight {
    color: var(--reef-aqua);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .footer__copy {
    font-size: 0.875rem;
    color: rgba(247, 244, 239, 0.3);
  }

  .footer__legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer__legal a {
    font-size: 0.875rem;
    color: rgba(247, 244, 239, 0.3);
    transition: color var(--duration-fast);
  }

  .footer__legal a:hover {
    color: var(--reef-aqua);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
      gap: var(--space-lg);
    }

    .footer__logo {
      font-size: 1.25rem;
    }

    .footer__lotus {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }

    .footer__col--right {
      text-align: left;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
