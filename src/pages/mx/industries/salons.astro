---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';
const lang = 'es';
const region = 'mx';
---

<BaseLayout t={tData} title="Automatizacion de Citas para Salones y Spas | DUSA . studio" description="Automatiza citas, reduce las inasistencias y haz que tus clientes regresen. DUSA le da a salones y spas un sistema completo de crecimiento con recordatorios, campanas de reagendamiento y solicitudes de resenas.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://dusa.studio/mx/" },
      { "@type": "ListItem", "position": 2, "name": "Industrias", "item": "https://dusa.studio/mx/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Salones y Spas", "item": "https://dusa.studio/mx/industries/salons/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Salones y Spas</span>
        <h1>Deja de perder ingresos por<br/><span class="gradient-text">inasistencias y citas sin reagendar</span></h1>
        <p class="industry-hero__sub">DUSA le da a tu salon un solo sistema para llenar tu agenda, hacer que los clientes regresen y construir una reputacion que crece en automatico.</p>
        <div class="industry-hero__actions">
          <a href="/mx/start" class="btn btn--primary">Comienza ahora</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Agenda una demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">El Problema</span>
      <h2>Te suena familiar?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">📵</div>
          <h3>Inasistencias que devoran tus ingresos</h3>
          <p>Sillas vacias significan dinero perdido. Sin recordatorios automaticos, los clientes se olvidan y tu pagas el precio.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📞</div>
          <h3>Llamadas interminables para cada cita</h3>
          <p>Estas cortando cabello, no contestando llamadas. Pero cada llamada perdida es un cliente potencial que se va con la competencia.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🔄</div>
          <h3>Los clientes olvidan reagendar</h3>
          <p>Les encanto su cita pero la vida los alcanzo. Sin un recordatorio, las semanas se convierten en meses de silencio.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📋</div>
          <h3>Sin registro de preferencias</h3>
          <p>Recordar la formula de color, el estilista preferido y los productos favoritos de cada cliente se vuelve imposible cuando creces.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">La Solucion</span>
      <h2>Como funciona DUSA para <span class="gradient-text">salones y spas</span></h2>
      <p class="solution__intro">Una sola plataforma reemplaza tu app de citas, tus mensajes de recordatorio, tus herramientas de resenas y tus hojas de calculo de clientes.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Citas en linea</h3>
          <p>Permite que tus clientes agenden las 24 horas desde tu sitio web, Instagram o tu perfil de Google. Sin necesidad de llamadas.</p>
        </div>
        <div class="solution-card">
          <h3>Recordatorios automaticos</h3>
          <p>Los recordatorios por SMS y correo se envian antes de cada cita. Reduce las inasistencias sin mover un dedo.</p>
        </div>
        <div class="solution-card">
          <h3>Campanas de reagendamiento</h3>
          <p>Cuando un cliente tiene tiempo sin visitarte, DUSA le envia un mensaje personalizado para que regrese al salon.</p>
        </div>
        <div class="solution-card">
          <h3>Notas de preferencias del cliente</h3>
          <p>Guarda formulas de color, preferencias de productos y notas de cada sesion en un solo lugar accesible para todo tu equipo.</p>
        </div>
        <div class="solution-card">
          <h3>Solicitudes de resenas</h3>
          <p>Automaticamente pide a los clientes satisfechos que dejen una resena en Google despues de su visita. Construye tu reputacion en automatico.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Tu Pipeline</span>
      <h2>Cada cliente, cada etapa, <span class="gradient-text">en automatico</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Nuevo Cliente</h3>
          <p>La consulta llega a traves de tu sitio web, redes sociales o referidos.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Agendado</h3>
          <p>El cliente selecciona un servicio, estilista y horario que le funcione.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Visita Realizada</h3>
          <p>Cita completada. Se envia solicitud de resena y se guardan las notas de preferencias.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Reagendamiento Pendiente</h3>
          <p>DUSA marca al cliente cuando se abre su ventana para la siguiente visita.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Reagendado</h3>
          <p>El cliente regresa. El ciclo continua y tu agenda se mantiene llena.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Fidelidad y Referidos</h3>
          <p>Los clientes a largo plazo ganan recompensas y refieren amigos. DUSA rastrea hitos de fidelidad y creditos de referidos automaticamente.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultados</span>
      <h2>Hecho para salones que quieren <span class="gradient-text">crecer</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">40%</div>
          <p>reduccion promedio de inasistencias con recordatorios automaticos</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">3x</div>
          <p>mas resenas en Google en los primeros 90 dias</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">60%</div>
          <p>de los clientes atrasados reagendan despues de un recordatorio automatico</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Listo para llenar cada silla?</h2>
        <p>Pon tu salon a funcionar con DUSA en menos de una semana.</p>
        <div class="final-cta__actions">
          <a href="/mx/start" class="btn btn--primary">Comienza ahora</a>
          <a href="/blog/salon-booking-automation" class="btn btn--outline">Lee la guia</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>