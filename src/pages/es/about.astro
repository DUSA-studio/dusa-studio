---

<BaseLayout title={t(lang, 'about.metaTitle')} description={t(lang, 'about.metaDesc')} lang={r.htmlLang} ogLocale={r.ogLocale} region={region}>

  <!-- Hero -->
  <section class="about-hero section section--dark">
    <div class="container">
      <div class="about-hero__content">
        <span class="label">{t(lang, 'about.heroLabel')}</span>
        <h1>{t(lang, 'about.heroTitle')}<br/><span class="gradient-text">{t(lang, 'about.heroTitleAccent')}</span></h1>
        <p class="about-hero__sub">{t(lang, 'about.heroSub')}</p>
      </div>
    </div>
  </section>

  <!-- Origin — Three Tiles -->
  <section class="origin section section--dark" style="padding-top:0;">
      <div class="container">
        <div class="origin__header">
          <span class="label">{t(lang, 'about.missionLabel')}</span>
          <h2>{t(lang, 'about.missionTitle')}</h2>
        </div>
        <div class="origin__tiles">
          <div class="origin__tile">
            <span class="origin__tile-number">01</span>
            <span class="label">El problema</span>
            <h3>Demasiadas herramientas,<br/><span class="gradient-text">poca claridad</span></h3>
            <p class="origin__desc">Las pequenas empresas hacen malabares con una docena de aplicaciones desconectadas. CRM aqui, correo alla, facturacion en otro lugar. Los leads se pierden, los datos viven en silos y pasas mas tiempo cambiando de pestana que haciendo crecer tu negocio.</p>
          </div>
          <div class="origin__tile">
            <span class="origin__tile-number">02</span>
            <span class="label">La idea</span>
            <h3>Una plataforma,<br/><span class="gradient-text">todo conectado</span></h3>
            <p class="origin__desc">Las herramientas existian. La integracion no. Lo que los operadores necesitaban no era otra aplicacion. Necesitaban un sistema que conecte CRM, marketing, ventas y operaciones desde el primer dia.</p>
          </div>
          <div class="origin__tile">
            <span class="origin__tile-number">03</span>
            <span class="label">DUSA . studio</span>
            <h3>Creada para crecer<br/><span class="gradient-text">contigo</span></h3>
            <p class="origin__desc">Creada en Sydney para empresas de todo el mundo. Comienza con una herramienta. Anade mas cuando las necesites. Sin compromisos, sin actualizaciones forzadas, sin complejidad empresarial. Solo claridad.</p>
          </div>
        </div>
      </div>
  </section>

  <!-- Values -->
  <section class="values section section--sand">
    <div class="container">
      <div class="values__layout">
        <div class="values__header">
          <span class="label" style="color: var(--deep-ocean);">{t(lang, 'about.valuesLabel')}</span>
          <h2 style="color: var(--deep-black);">{t(lang, 'about.missionTitle')}</h2>
        </div>

        <div class="values__stack" id="valuesStack">
          {values.map((v, i) => (
            <div class={`vcard ${i === 0 ? 'vcard--active' : ''}`} data-vcard={i}>
              <div class="vcard__badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                  <path d={v.icon}/>
                </svg>
              </div>
              <h4 class="vcard__title">{v.title}</h4>
              <p class="vcard__desc">{v.desc}</p>
            </div>
          ))}
          <div class="values__dots" id="valuesDots">
            {values.map((_, i) => (
              <button class={`values__dot ${i === 0 ? 'values__dot--active' : ''}`} data-dot={i} aria-label={`Show principle ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sydney -->
  <section class="sydney section section--dark">
    <div class="container">
      <div class="sydney__layout">
        <div class="sydney__content">
          <span class="label">{t(lang, 'about.teamLabel')}</span>
          <h2>{t(lang, 'about.teamTitle')}<br/><span class="gradient-text">{t(lang, 'about.teamTitleAccent')}</span></h2>
          <p class="sydney__desc">{t(lang, 'about.teamDesc')}</p>
          <p class="sydney__desc">{t(lang, 'about.teamSub')}</p>
          <div class="sydney__actions">
            <a href={`/${region}/pricing`} class="btn btn--primary">{t(lang, 'common.viewPricing')}</a>
            <a href="mailto:contact@dusa.studio" class="btn btn--outline">{t(lang, 'common.getInTouch')}</a>
          </div>
        </div>
        <div class="sydney__globe" id="sydneyGlobe">
          <canvas id="globeCanvas" width="480" height="480" class="globe-canvas"></canvas>
          <script type="application/json" id="geoData" set:html={geoJson}></script>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .about-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .about-hero__sub {
    font-size: 1.25rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Origin Tiles */
  .origin__header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .origin__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .origin__tile {
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: 16px;
    padding: 2rem;
    position: relative;
  }

  .origin__tile-number {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: rgba(78, 216, 194, 0.12);
    line-height: 1;
    margin-bottom: var(--space-sm);
    display: block;
  }

  .origin__tile h3 {
    font-size: 1.25rem;
    margin-top: var(--space-xs);
  }

  .origin__desc {
    font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
  }

  /* Values */
  .values__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .values__header {
    max-width: 600px;
  }

  .values__stack {
    position: relative;
    height: 340px;
    perspective: 1200px;
  }

  .vcard {
    position: absolute;
    width: 90%;
    left: 5%;
    padding: 1.75rem 2rem;
    border-radius: 16px;
    background: linear-gradient(145deg, #1e2128, #16181e);
    border: 1px solid rgba(247, 244, 239, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), 0 2px 8px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center bottom;
    opacity: 0;
    pointer-events: none;
  }

  .vcard[data-pos="0"] {
    transform: translateY(0) rotateX(0deg) scale(1);
    opacity: 1;
    z-index: 4;
    pointer-events: auto;
  }
  .vcard[data-pos="1"] {
    transform: translateY(40px) rotateX(-2deg) scale(0.96);
    opacity: 0.7;
    z-index: 3;
    pointer-events: auto;
  }
  .vcard[data-pos="2"] {
    transform: translateY(72px) rotateX(-4deg) scale(0.92);
    opacity: 0.45;
    z-index: 2;
    pointer-events: auto;
  }
  .vcard[data-pos="3"] {
    transform: translateY(96px) rotateX(-5deg) scale(0.88);
    opacity: 0.25;
    z-index: 1;
    pointer-events: none;
  }

  .vcard--expanded {
    transform: translateY(-8px) rotateX(0deg) scale(1.02) !important;
    opacity: 1 !important;
    z-index: 10 !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35), 0 0 30px rgba(78, 216, 194, 0.08);
    border-color: rgba(78, 216, 194, 0.2);
  }

  .vcard__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(247, 244, 239, 0.1);
    color: rgba(247, 244, 239, 0.7);
    margin-bottom: 0.75rem;
  }

  .vcard--expanded .vcard__badge {
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
  }

  .vcard__title {
    font-family: var(--font-headline);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: 0.75rem;
