---
// SetupSteps.astro — "Up and running in three steps".
// Rebuilt Nov 2026: three plain steps side by side (stacked on phones), one
// icon each, one sentence each, then the real booking button. No mock
// widgets, no animation loop, no script.
import Icon from './Icon.astro';

interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.howItWorks || {};
const label = s.label || 'How It Works';
const heading = s.heading || 'Up and running';
const headingAccent = s.headingAccent || 'in three steps.';
const cta = s.bookFreeDemo || 'Book Your Free Demo';
const ctaAlt = s.orTrial || 'or start a 14-day free trial';
const note = s.setupNote || 'Most businesses are live inside their first week.';

const steps = [
  {
    n: '1',
    icon: 'calendar',
    title: s.setup1Title || 'Book a 30-minute call',
    desc: s.setup1Desc || 'We look at how your business runs today and show you exactly what DUSA will do for it.',
    you: s.setup1You || 'You: 30 minutes',
  },
  {
    n: '2',
    icon: 'workflow',
    title: s.setup2Title || 'Connect your accounts',
    desc: s.setup2Desc || 'Google, Meta, your calendar and payments, one click each. We help you bring your contacts across and switch on your first automations.',
    you: s.setup2You || 'You: a few clicks',
  },
  {
    n: '3',
    icon: 'login',
    title: s.setup3Title || 'Log in and go',
    desc: s.setup3Desc || 'Open DUSA on your phone or laptop. Leads, bookings and reviews land in one place, with AI handling the follow-up.',
    you: s.setup3You || 'You: one login',
  },
];
---

<section class="ss section section--dark" id="how-it-works">
  <div class="container">
    <div class="ss__header reveal">
      <span class="label" data-icon="flag">{label}</span>
      <h2>{heading}<br/><span class="gradient-text">{headingAccent}</span></h2>
    </div>

    <ol class="ss__grid reveal">
      {steps.map((st) => (
        <li class="ss__step">
          <div class="ss__top">
            <span class="ss__icon"><Icon name={st.icon} size={26} /></span>
            <span class="ss__num" aria-hidden="true">{st.n}</span>
          </div>
          <h3 class="ss__title">{st.title}</h3>
          <p class="ss__desc">{st.desc}</p>
          <span class="ss__you">{st.you}</span>
        </li>
      ))}
    </ol>

    <div class="ss__cta reveal">
      <p class="ss__note">{note}</p>
      <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--primary">{cta}</a>
      <a href="/start" data-page="start" class="ss__cta-alt">{ctaAlt} &rarr;</a>
    </div>
  </div>
</section>

<style>
  .ss__header { text-align: center; max-width: 720px; margin: 0 auto var(--space-xl); }
  .ss__header h2 { margin-top: var(--space-xs); }

  .ss__grid {
    list-style: none; margin: 0 auto; padding: 0; max-width: 1080px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem);
  }
  .ss__step {
    position: relative; display: flex; flex-direction: column; align-items: flex-start;
    padding: clamp(1.4rem, 2.2vw, 2rem); text-align: left; color: var(--warm-white);
  }
  .ss__top { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 1.25rem; }
  .ss__icon {
    display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px;
    color: var(--reef-aqua); background: rgba(78, 216, 194, 0.10); border: 1px solid rgba(78, 216, 194, 0.22);
  }
  .ss__num {
    font-family: var(--font-headline); font-weight: 700; font-size: 3rem; line-height: 1;
    color: rgba(247, 244, 239, 0.14); letter-spacing: -0.03em;
  }
  .ss__title { font-size: 1.3rem; line-height: 1.25; margin: 0 0 0.5rem; }
  .ss__desc { font-size: 1rem; line-height: 1.6; color: rgba(247, 244, 239, 0.74); margin: 0 0 1.25rem; max-width: none; }
  .ss__you {
    margin-top: auto; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--reef-aqua);
  }

  /* the join between steps: a short line from one card to the next */
  @media (min-width: 901px) {
    .ss__step:not(:last-child)::after {
      content: ''; position: absolute; top: 50%; right: calc(clamp(1rem, 2vw, 1.5rem) * -1); width: clamp(1rem, 2vw, 1.5rem);
      height: 1px; background: rgba(247, 244, 239, 0.22);
    }
  }

  .ss__cta { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: var(--space-xl); }
  .ss__note { margin: 0 0 0.5rem; font-size: 1.0625rem; color: rgba(247, 244, 239, 0.8); text-align: center; max-width: none; }
  .ss__cta-alt { font-size: 0.9375rem; color: rgba(247, 244, 239, 0.62); text-decoration: none; transition: color var(--duration-fast); }
  .ss__cta-alt:hover { color: var(--reef-aqua); }

  @media (max-width: 900px) {
    .ss__grid { grid-template-columns: minmax(0, 1fr); max-width: 520px; }
    .ss__step { padding: 1.25rem; }
    .ss__top { margin-bottom: 0.9rem; }
    .ss__icon { width: 48px; height: 48px; border-radius: 14px; }
    .ss__num { font-size: 2.4rem; }
    .ss__desc { margin-bottom: 0.9rem; }
  }

  /* ── Light mode ─────────────────────────────────────────────────────── */
  :global(html[data-theme="light"]) .ss__step { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ss__icon { color: var(--deep-ocean); background: rgba(26, 58, 92, 0.07); border-color: rgba(26, 58, 92, 0.14); }
  :global(html[data-theme="light"]) .ss__num { color: rgba(12, 14, 20, 0.12); }
  :global(html[data-theme="light"]) .ss__desc { color: rgba(12, 14, 20, 0.72); }
  :global(html[data-theme="light"]) .ss__you { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .ss__note { color: rgba(12, 14, 20, 0.78); }
  :global(html[data-theme="light"]) .ss__cta-alt { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .ss__cta-alt:hover { color: var(--deep-ocean); }
  @media (min-width: 901px) {
    :global(html[data-theme="light"]) .ss__step:not(:last-child)::after { background: rgba(12, 14, 20, 0.2); }
  }
</style>
