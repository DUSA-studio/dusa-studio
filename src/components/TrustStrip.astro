---
/**
 * TrustStrip.astro
 *
 * A slim glass bar that answers the "what happens if you disappear?" question
 * in one line: DUSA runs on HighLevel, and here are HighLevel's own published
 * numbers. A floating DUSA glass cube carries HighLevel's arrow icon exactly as
 * supplied (public/brand/highlevel-mark.svg, cropped from their official logo;
 * their brand kit allows the icon alone but forbids recolouring, effects or
 * redrawing it), beside a glass pill with the name embossed. The glass is ours,
 * the mark is theirs.
 *
 * Numbers are HighLevel's own, from gohighlevel.com (October 2026): 2.2 million
 * businesses, 7.3 billion leads generated, 179 million appointments booked,
 * US$5.2 billion in sales facilitated in 2025. Update `trust.stats` in the
 * dictionaries when they publish new ones.
 *
 * Renders nothing when the dictionary has no `trust` block, so locale pages
 * stay in their own language until the keys are translated.
 */
interface Props {
  t?: Record<string, any>;
  /** Tighter top margin when it sits directly under a hero. */
  tight?: boolean;
}
const { t = {}, tight = false } = Astro.props;
const s = t?.trust || null;
const show = !!s;

const lead = (s && s.lead) || 'Built on HighLevel';
const sub = (s && s.sub) || 'The platform under every DUSA account';
const stats: [string, string][] = (s && s.stats) || [
  ['2.2M', 'businesses'],
  ['7.3B', 'leads generated'],
  ['179M', 'appointments booked'],
  ['US$5.2B', 'in sales, 2025'],
];
const source = (s && s.source) || 'HighLevel, published figures';
const linkHref = '/pricing#faq';
---

{show && (
<section class={`trust${tight ? ' trust--tight' : ''}`} aria-label={(s && s.aria) || 'Platform trust facts'}>
  <div class="trust__bar">
    <a class="trust__brand" href={linkHref} aria-label={lead}>
      <span class="trust__chip" aria-hidden="true">
        <span class="trust__cube">
          {['front', 'right', 'back', 'left', 'top', 'bottom'].map((f) => (
            <span class={`trust__face trust__face--${f}`}><img src="/brand/highlevel-mark.svg" alt="" width="38" height="31" loading="lazy" decoding="async" /></span>
          ))}
        </span>
      </span>
      <span class="trust__pill glass-pill">
        <span class="trust__lead">{lead}</span>
        <span class="trust__sub">{sub}</span>
      </span>
    </a>
    <ul class="trust__stats" title={source}>
      {stats.map(([n, label]) => (
        <li class="trust__stat glass-pill"><b>{n}</b><span>{label}</span></li>
      ))}
    </ul>
  </div>
</section>
)}

<style>
  .trust {
    position: relative;
    padding: 0 var(--space-md);
    margin: var(--space-lg) auto var(--space-xl);
    max-width: 1200px;
  }
  .trust--tight { margin-top: var(--space-md); }

  /* The bar: the same frosted glass recipe as the nav pills. */
  .trust__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 76px;
    padding: 0.8rem 1.5rem 0.8rem 1.1rem;
    border-radius: 100px;
    border: 1.5px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(135deg, rgba(247, 244, 239, 0.07), rgba(247, 244, 239, 0.025));
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.08), 0 10px 40px rgba(0, 0, 0, 0.18);
  }

  .trust__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  /* ── The floating glass cube: HighLevel's own arrow icon, as supplied, on
     every face of a DUSA dice (same tilt and spin as the hero cubes). ── */
  .trust__chip {
    --cube: 44px;
    width: var(--cube);
    height: var(--cube);
    display: block;
    perspective: 640px;
    flex-shrink: 0;
    animation: trustFloat 5.5s ease-in-out infinite;
  }
  @keyframes trustFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  .trust__cube {
    display: block;
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    animation: trustSpin 24s linear infinite;
  }
  @keyframes trustSpin {
    from { transform: rotateX(-28deg) rotateY(0deg); }
    to   { transform: rotateX(-28deg) rotateY(360deg); }
  }
  .trust__face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(150deg, rgba(30, 38, 54, 0.85) 0%, rgba(16, 20, 30, 0.92) 100%);
    border: 1px solid rgba(122, 219, 201, 0.18);
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.2), 0 0 0 0.5px rgba(78, 216, 194, 0.22), 0 2px 8px rgba(0, 0, 0, 0.2);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .trust__face img { width: 58%; height: auto; display: block; }
  .trust__face--front  { transform: rotateY(0deg)   translateZ(calc(var(--cube) / 2)); }
  .trust__face--right  { transform: rotateY(90deg)  translateZ(calc(var(--cube) / 2)); }
  .trust__face--back   { transform: rotateY(180deg) translateZ(calc(var(--cube) / 2)); }
  .trust__face--left   { transform: rotateY(270deg) translateZ(calc(var(--cube) / 2)); }
  .trust__face--top    { transform: rotateX(90deg)  translateZ(calc(var(--cube) / 2)); }
  .trust__face--bottom { transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2)); }

  /* The glass pill beside it carries the name, set into the glass. The
     glass itself is the shared .glass-pill recipe; only the type lives here. */
  .trust__pill {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    line-height: 1.3;
    padding: 0.6rem 1.35rem 0.65rem;
  }
  .trust__lead {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .trust__sub {
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.005em;
    color: rgba(247, 244, 239, 0.64);
    white-space: nowrap;
  }

  /* Their numbers, as stat chips. */
  .trust__stats {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.5rem 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .trust__stat {
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }
  .trust__stat b {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }
  .trust__stat span {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(247, 244, 239, 0.66);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .trust__bar { flex-wrap: wrap; border-radius: 28px; justify-content: center; row-gap: 0.75rem; padding: 0.9rem 1rem; }
    .trust__brand { width: 100%; justify-content: center; }
    .trust__stats { width: 100%; display: flex; flex-wrap: wrap; }
  }
  @media (max-width: 480px) {
    .trust { padding: 0 var(--space-sm); }
    .trust__pill { align-items: center; }
    .trust__lead, .trust__sub { white-space: normal; text-align: center; }
    .trust__stat { padding: 0.3rem 0.65rem; }
    .trust__stat b { font-size: 0.875rem; }
    .trust__stat span { font-size: 0.625rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust__cube, .trust__chip { animation: none; }
    .trust__cube { transform: rotateX(-24deg) rotateY(38deg); }
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .trust__bar {
    border-color: rgba(12, 14, 20, 0.1);
    background: linear-gradient(135deg, rgba(12, 14, 20, 0.04), rgba(12, 14, 20, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 10px 30px rgba(12, 14, 20, 0.06);
  }
  :global(html[data-theme="light"]) .trust__sub { color: rgba(12, 14, 20, 0.64); }
  :global(html[data-theme="light"]) .trust__stat span { color: rgba(12, 14, 20, 0.66); }
  /* Light mode: the cube is light glass too, so the mark sits on a clear
     face rather than a dark block. */
  :global(html[data-theme="light"]) .trust__face {
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.46) 100%);
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -6px 12px rgba(26, 58, 92, 0.08), 0 0 0 0.5px rgba(26, 58, 92, 0.14), 0 2px 8px rgba(26, 58, 92, 0.12);
  }
</style>
