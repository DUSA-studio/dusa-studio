---
// ConnectedPlatform.astro — capability wheel + integrations marquee.
//
// Layout: single centred column. An earlier two-column version put the wheel
// beside a tall grid of 26 near-identical chips, which unbalanced the section
// and made the grid the weakest thing on screen. The wheel now gets the full
// width as the hero object, and the integrations run underneath as a moving
// band, which reads as evidence rather than a list.
//
// Colour logic: the six domains sit in a TIGHT Mist Blue band, not a wide
// light-to-dark ramp — a wide ramp forced the label colour to flip between
// domains and looked half-lit. That keeps Reef Aqua free to mean exactly one
// thing: AI.
import { BRAND_MARKS, WORDMARK_ONLY } from '../config/brand-marks';
import { DOMAINS } from '../config/capabilities';

interface Props { t?: Record<string, any>; }
const { t = {} } = Astro.props;
const c = t?.connected || {};

const eyebrow = c.eyebrow || 'One Platform';
const heading = c.heading || 'Everything';
const headingAccent = c.headingAccent || 'connected';
const sub = c.sub || 'The systems that run your business, and the apps they plug into.';
const gridHeading = c.gridHeading || 'Connects with';
const appsLede = c.appsLede || 'Run your favourite apps from one screen.';
const appsSub = c.appsSub || 'Socials, email, invoices and calendars, without switching tabs.';
const note = c.note || 'Plus 1,000+ more through Zapier, Make and custom integrations.';
const ctaLabel = c.cta || 'See everything included';
const aiBandLabel = c.aiBand || 'AI · ACROSS EVERYTHING';
const hubHint = c.hubHint || 'Hover to explore';

const AQUA = '#4ED8C2';

/* ─── Geometry, resolved at build time so the SVG ships static ─── */
const VB = 760, CX = 380, CY = 380;
const R_HUB = 118, R_AI0 = 124, R_AI1 = 152, R_D0 = 158, R_D1 = 226, R_C0 = 230, R_C1 = 344;
const GAP = 0.016;

const pol = (r: number, a: number) => [CX + r * Math.cos(a), CY + r * Math.sin(a)];
function arc(r0: number, r1: number, a0: number, a1: number) {
  const [x0, y0] = pol(r1, a0), [x1, y1] = pol(r1, a1);
  const [x2, y2] = pol(r0, a1), [x3, y3] = pol(r0, a0);
  const laf = a1 - a0 > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r1},${r1} 0 ${laf} 1 ${x1.toFixed(2)},${y1.toFixed(2)}` +
         `L${x2.toFixed(2)},${y2.toFixed(2)}A${r0},${r0} 0 ${laf} 0 ${x3.toFixed(2)},${y3.toFixed(2)}Z`;
}
/**
 * Annular sector with genuinely rounded corners. Each corner is cut back by
 * `k` along both edges and rejoined with a quarter arc, so the segment reads
 * as a soft tile rather than a slice of pie chart.
 */
function roundedSector(r0: number, r1: number, a0: number, a1: number, k = 5) {
  const dIn = Math.min(k / r0, (a1 - a0) / 2.2);
  const dOut = Math.min(k / r1, (a1 - a0) / 2.2);
  const kr = Math.min(k, (r1 - r0) / 2.2);
  const P = (r: number, a: number) => pol(r, a).map((n) => n.toFixed(2)).join(',');
  const laf = a1 - a0 > Math.PI ? 1 : 0;
  return [
    `M${P(r0 + kr, a0)}`,
    `L${P(r1 - kr, a0)}`,
    `A${k},${k} 0 0 1 ${P(r1, a0 + dOut)}`,
    `A${r1},${r1} 0 ${laf} 1 ${P(r1, a1 - dOut)}`,
    `A${k},${k} 0 0 1 ${P(r1 - kr, a1)}`,
    `L${P(r0 + kr, a1)}`,
    `A${k},${k} 0 0 1 ${P(r0, a1 - dIn)}`,
    `A${r0},${r0} 0 ${laf} 0 ${P(r0, a0 + dIn)}`,
    `A${k},${k} 0 0 1 ${P(r0 + kr, a0)}`,
    'Z',
  ].join('');
}

function arcPath(r: number, a0: number, a1: number, flip: boolean) {
  const [s0, s1] = flip ? [a1, a0] : [a0, a1];
  const [x0, y0] = pol(r, s0), [x1, y1] = pol(r, s1);
  const laf = Math.abs(a1 - a0) > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r},${r} 0 ${laf} ${flip ? 0 : 1} ${x1.toFixed(2)},${y1.toFixed(2)}`;
}
const rgba = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
};

const totalCaps = DOMAINS.reduce((s, d) => s + d.items.length, 0);
const aiCount = DOMAINS.reduce((s, d) => s + d.items.filter((i) => i.ai).length, 0);
const allApps = [...BRAND_MARKS.map((b) => ({ name: b.name, hex: b.hex, path: b.path })),
                 ...WORDMARK_ONLY.map((n) => ({ name: n, hex: '', path: '' }))];
const appCount = allApps.length;
/* Two marquee rows travelling in opposite directions. */
const rowA = allApps.filter((_, i) => i % 2 === 0);
const rowB = allApps.filter((_, i) => i % 2 === 1);

let cursor = -Math.PI / 2;
const domainSegs: any[] = [];
const capSegs: any[] = [];
let capIndex = 0;

DOMAINS.forEach((d, di) => {
  const span = (d.items.length / totalCaps) * Math.PI * 2;
  const a0 = cursor, a1 = cursor + span;
  const mid = (a0 + a1) / 2;
  const m = ((mid % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
  const flip = m > 0 && m < Math.PI;
  const rLabel = (R_D0 + R_D1) / 2 + (flip ? 5 : -5);
  const rMid = (R_D0 + R_D1) / 2;
  const [gx1, gy1] = pol(rMid, a0);
  const [gx2, gy2] = pol(rMid, a1);
  domainSegs.push({
    di, d: roundedSector(R_D0, R_D1, a0 + GAP, a1 - GAP, 7),
    label: d.name, color: d.color,
    hit: arc(R_D0, R_D1, a0, a1),
    nextColor: DOMAINS[(di + 1) % DOMAINS.length].color,
    gx1, gy1, gx2, gy2,
    textPath: arcPath(rLabel, a0 + GAP, a1 - GAP, flip),
  });

  const iSpan = span / d.items.length;
  d.items.forEach((it, ii) => {
    const b0 = a0 + ii * iSpan, b1 = b0 + iSpan;
    const m2 = (b0 + b1) / 2;
    const [ix, iy] = pol((R_C0 + R_C1) / 2, m2);
    const dg = (m2 * 180) / Math.PI;
    capSegs.push({
      di, i: capIndex++, d: roundedSector(R_C0, R_C1, b0 + GAP, b1 - GAP, 6),
      fill: it.ai ? 'url(#cpCai)' : `url(#cpC${di})`,
      stroke: it.ai ? AQUA : rgba(d.color, 0.85),
      hit: arc(R_C0 - 6, R_C1 + 6, b0, b1), ang: m2,
      label: it.l, plain: it.l.replace('\n', ' '), desc: it.d,
      domain: d.name, lx: ix, ly: iy, ai: !!it.ai,
      rot: dg > 90 && dg < 270 ? dg + 180 : dg,
    });
  });
  cursor = a1;
});

const aiMidR = (R_AI0 + R_AI1) / 2 + 2;
const aiTextPath = `M ${CX - aiMidR},${CY} A ${aiMidR},${aiMidR} 0 0 1 ${CX + aiMidR},${CY}`;

/* Agent journeys.
   The wheel is treated as a road network. A signal may only travel where there
   is actually a gap: down a channel between two capability tiles, around the
   ring-to-ring channel, then in through a DOMAIN boundary. Diving straight in
   at a capability boundary would drive it through the middle of a domain tile
   like Reputation, which is what it used to do. */
const CAP_BOUNDS = capSegs.length;
/* Capability index at which each domain starts — these are the only angles
   where the domain ring actually has a gap to pass through. */
const DOMAIN_BOUNDS: number[] = [];
DOMAINS.reduce((acc, d) => { DOMAIN_BOUNDS.push(acc); return acc + d.items.length; }, 0);

const R_LANE = (R_D1 + R_C0) / 2;   /* channel between the two outer rings */
const R_CORE = (R_AI1 + R_D0) / 2;  /* channel just outside the AI band */
const R_EDGE = R_C1 - 4;

const angAt = (i: number) => -Math.PI / 2 + (i / CAP_BOUNDS) * Math.PI * 2;
const pt = (r: number, a: number) => pol(r, a).map((n) => n.toFixed(2)).join(',');
const norm = (d: number) => {
  while (d <= -Math.PI) d += Math.PI * 2;
  while (d > Math.PI) d -= Math.PI * 2;
  return d;
};
/* Sweep along a channel, shortest way round. Zero-length arcs are skipped
   because SVG treats identical start/end points as a no-op. */
const along = (r: number, from: number, to: number) => {
  const d = norm(to - from);
  if (Math.abs(d) < 1e-4) return '';
  return `A${r},${r} 0 0 ${d > 0 ? 1 : 0} ${pt(r, to)}`;
};
/* Nearest domain gap to a given capability boundary. */
const nearestDomainGap = (i: number) => {
  const a = angAt(i);
  let best = DOMAIN_BOUNDS[0], bestD = Infinity;
  for (const b of DOMAIN_BOUNDS) {
    const d = Math.abs(norm(angAt(b) - a));
    if (d < bestD) { bestD = d; best = b; }
  }
  return angAt(best);
};

function flowPath(i0: number, i1: number) {
  const t0 = angAt(i0), t1 = angAt(i1);
  const g0 = nearestDomainGap(i0), g1 = nearestDomainGap(i1);
  return [
    `M${pt(R_EDGE, t0)}`,
    `L${pt(R_LANE, t0)}`,          /* in through the capability gap */
    along(R_LANE, t0, g0),          /* along the channel to a domain gap */
    `L${pt(R_CORE, g0)}`,          /* in through the domain gap */
    along(R_CORE, g0, g1),          /* routed around the core */
    `L${pt(R_LANE, g1)}`,          /* out through the destination domain gap */
    along(R_LANE, g1, t1),          /* along the channel */
    `L${pt(R_EDGE, t1)}`,          /* out through the capability gap */
  ].join('');
}

const FLOWS = [
  [2, 21], [7, 14], [11, 25], [17, 4], [24, 9], [13, 1], [19, 6],
].map(([a, b], n) => ({
  d: flowPath(a, b),
  dur: (6.2 + (n % 4) * 1.3).toFixed(2),
  delay: ((n * 1.41) % 7).toFixed(2),
}));

const STATS = [
  { n: '6', l: 'core domains' },
  { n: String(totalCaps), l: 'capabilities' },
  { n: String(aiCount), l: 'AI powered' },
  { n: `${appCount}+`, l: 'integrations' },
];
---

<section class="cp section section--dark" id="connected-platform">
  <div class="container">
    <div class="cp__head reveal">
      <span class="label">{eyebrow}</span>
      <h2>{heading} <span class="gradient-text">{headingAccent}</span></h2>
      <p class="cp__sub">{sub}</p>
      <dl class="cp__stats">
        {STATS.map((s) => (
          <div class="cp__stat"><dt>{s.n}</dt><dd>{s.l}</dd></div>
        ))}
      </dl>
    </div>

    <div class="cp__stage reveal">
      <span class="cp__aura" aria-hidden="true"></span>

      <svg class="cp__wheel" viewBox={`0 0 ${VB} ${VB}`} role="img"
           aria-label="What DUSA does: six capability domains with AI running through them">

        <defs>
          <radialGradient id="cpAura" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color={AQUA} stop-opacity="0.18" />
            <stop offset="52%" stop-color="#1A3A5C" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#0C0E14" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cpSheen" cx="32%" cy="20%" r="62%">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.16" />
            <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0.03" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
          </radialGradient>
          <clipPath id="cpHubClip"><circle cx={CX} cy={CY} r={R_HUB - 1} /></clipPath>
          <linearGradient id="cpSweep" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color={AQUA} stop-opacity="0.16" />
            <stop offset="100%" stop-color={AQUA} stop-opacity="0" />
          </linearGradient>
          <linearGradient id="cpRim" x1="0%" y1="0%" x2="12%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.55" />
            <stop offset="45%" stop-color="#FFFFFF" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.02" />
          </linearGradient>
          <radialGradient id="cpCoreGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color={AQUA} stop-opacity="0.14" />
            <stop offset="60%" stop-color={AQUA} stop-opacity="0.04" />
            <stop offset="100%" stop-color={AQUA} stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cpHubWell" cx="50%" cy="38%" r="72%">
            <stop offset="0%" stop-color="#16202E" />
            <stop offset="70%" stop-color="#0C0E14" />
            <stop offset="100%" stop-color="#07080C" />
          </radialGradient>
          <filter id="cpDrop" x="-40%" y="-40%" width="180%" height="180%">
            <feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#04060A" flood-opacity="0.75" />
          </filter>
          <filter id="cpSoftGlow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="2.6" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          {DOMAINS.map((d, i) => (
            <radialGradient id={`cpC${i}`} gradientUnits="userSpaceOnUse"
                            cx={CX} cy={CY} r={R_C1}>
              <stop offset={`${(R_C0 / R_C1) * 100}%`} stop-color={d.color} stop-opacity="0.30" />
              <stop offset="100%" stop-color={d.color} stop-opacity="0.08" />
            </radialGradient>
          ))}
          <radialGradient id="cpCai" gradientUnits="userSpaceOnUse" cx={CX} cy={CY} r={R_C1}>
            <stop offset={`${(R_C0 / R_C1) * 100}%`} stop-color={AQUA} stop-opacity="0.42" />
            <stop offset="100%" stop-color={AQUA} stop-opacity="0.14" />
          </radialGradient>
          {domainSegs.map((s2, i) => (
            <linearGradient id={`cpD${i}`} gradientUnits="userSpaceOnUse"
                            x1={s2.gx1} y1={s2.gy1} x2={s2.gx2} y2={s2.gy2}>
              <stop offset="0%" stop-color={s2.color} />
              <stop offset="100%" stop-color={s2.nextColor} />
            </linearGradient>
          ))}
        </defs>

        <circle cx={CX} cy={CY} r={R_C1 + 26} fill="url(#cpAura)" />

        <g class="cp__ticks" aria-hidden="true">
          {DOMAINS.map((_, i) => {
            const before = DOMAINS.slice(0, i).reduce((n, dd) => n + dd.items.length, 0);
            const a = -Math.PI / 2 + (before / totalCaps) * Math.PI * 2;
            const [x1, y1] = pol(R_C1 + 8, a);
            const [x2, y2] = pol(R_C1 + 18, a);
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={rgba(AQUA, 0.5)} stroke-width="1.25" />;
          })}
        </g>
        <circle cx={CX} cy={CY} r={R_C1 + 19} fill="none" stroke="rgba(247,244,239,0.08)" stroke-width="1" />

        {capSegs.map((s) => (
          <path class={`cp__seg cp__cap cp__seg--d${s.di} ${s.ai ? 'is-ai' : ''}`}
                style={`--i:${s.i + 7};--glow:${s.ai ? AQUA : s.stroke}`} d={s.d} fill={s.fill}
                stroke={s.stroke} stroke-width="1.4" />
        ))}

        <g filter="url(#cpDrop)">
        {domainSegs.map((s) => (
          <path class={`cp__seg cp__dom cp__seg--d${s.di}`} style={`--i:${s.di};--glow:${s.color}`}
                d={s.d} fill={`url(#cpD${s.di})`} stroke="rgba(255,255,255,0.22)" stroke-width="1" />
        ))}
        </g>

        <g class="cp__ai">
          <circle cx={CX} cy={CY} r={(R_AI0 + R_AI1) / 2} fill="none"
                  stroke={rgba(AQUA, 0.08)} stroke-width={R_AI1 - R_AI0} />
          <circle cx={CX} cy={CY} r={R_AI0} fill="none" stroke={rgba(AQUA, 0.8)}
                  stroke-width="1.25" filter="url(#cpSoftGlow)" />
          <circle cx={CX} cy={CY} r={R_AI1} fill="none" stroke={rgba(AQUA, 0.8)}
                  stroke-width="1.25" filter="url(#cpSoftGlow)" />
          <circle class="cp__ai-dash" cx={CX} cy={CY} r={R_AI1 - 1} fill="none"
                  stroke={rgba(AQUA, 0.45)} stroke-width="1" stroke-dasharray="2 10" stroke-linecap="round" />
          <path id="cpAiPath" d={aiTextPath} fill="none" />
          <text class="cp__ai-label" filter="url(#cpSoftGlow)">
            <textPath href="#cpAiPath" startOffset="50%" text-anchor="middle">{aiBandLabel}</textPath>
          </text>
        </g>

        {capSegs.map((s) => (
          <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.i}`} aria-hidden="true">
            <text class={`cp__cap-text ${s.ai ? 'is-ai-text' : ''}`} x={s.lx} y={s.ly}
                  text-anchor="middle" dominant-baseline="middle"
                  transform={`rotate(${s.rot} ${s.lx} ${s.ly})`}>
              {s.label.split('\n').map((line: string, i: number, arr: string[]) => (
                <tspan x={s.lx} dy={i === 0 ? -((arr.length - 1) * 6) : 12}>{line}</tspan>
              ))}
            </text>
          </g>
        ))}
        {domainSegs.map((s) => (
          <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.di}`} aria-hidden="true">
            <path id={`cpDomPath${s.di}`} d={s.textPath} fill="none" />
            <text class="cp__dom-text">
              <textPath href={`#cpDomPath${s.di}`} startOffset="50%" text-anchor="middle">{s.label}</textPath>
            </text>
          </g>
        ))}

        <!-- Gapless hit layer. The gaps between tiles are decoration only;
             if they were real holes the pointer would fall through them and the
             wheel would reset every time you crossed from one tile to the next. -->
        <g class="cp__hit">
          {domainSegs.map((s) => (
            <path class="cp__hit-dom" data-di={s.di} d={s.hit} fill="none" pointer-events="all" />
          ))}
          {capSegs.map((s) => (
            <path class="cp__hit-cap" d={s.hit} fill="none" pointer-events="all"
                  data-di={s.di} data-idx={s.i} data-name={s.plain} data-desc={s.desc}
                  data-ang={s.ang.toFixed(4)}
                  data-domain-name={s.domain} data-ai={s.ai ? '1' : '0'} />
          ))}
        </g>

        <!-- Glass rim light. One pass over every tile so each surface has a
             lit top edge falling away to nothing, which is what sells glass. -->
        <g class="cp__rims" aria-hidden="true">
          {capSegs.map((s2) => (
            <path class={`cp__seg cp__seg--d${s2.di}`} style={`--i:${s2.i + 7}`}
                  d={s2.d} fill="none" stroke="url(#cpRim)" stroke-width="1.1" />
          ))}
          {domainSegs.map((s2) => (
            <path class={`cp__seg cp__seg--d${s2.di}`} style={`--i:${s2.di}`}
                  d={s2.d} fill="none" stroke="url(#cpRim)" stroke-width="1.4" />
          ))}
        </g>

        <!-- Agent journeys along the channels between tiles. -->
        <g class="cp__flows" aria-hidden="true">
          {FLOWS.map((f) => (
            <path class="cp__flow-line" d={f.d} fill="none"
                  stroke={rgba(AQUA, 0.12)} stroke-width="1" />
          ))}
          {FLOWS.map((f) => (
            <g class="cp__flow" style={`offset-path:path('${f.d}');--dur:${f.dur}s;--delay:${f.delay}s`}>
              <circle r="7" fill={AQUA} opacity="0.18" />
              <circle r="2.6" fill="#CFFFF6" />
            </g>
          ))}
        </g>

        <circle class="cp__sheen" cx={CX} cy={CY} r={R_C1} fill="url(#cpSheen)"
                pointer-events="none" aria-hidden="true" />

        <!-- Core: layered so it reads as live machinery, not an empty disc. -->
        <g clip-path="url(#cpHubClip)" aria-hidden="true">
          <circle cx={CX} cy={CY} r={R_HUB} fill="url(#cpHubWell)" />
          <g class="cp__sweep">
            <path d={`M${CX},${CY} L${CX + R_HUB},${CY} A${R_HUB},${R_HUB} 0 0 0 ${CX + R_HUB * Math.cos(-0.9)},${CY + R_HUB * Math.sin(-0.9)} Z`}
                  fill="url(#cpSweep)" />
          </g>
        </g>
        <circle class="cp__core-glow" cx={CX} cy={CY} r={R_HUB - 14}
                fill="url(#cpCoreGlow)" aria-hidden="true" />
        <circle cx={CX} cy={CY} r={R_HUB} fill="none"
                stroke={rgba(AQUA, 0.5)} stroke-width="1" />
        <circle cx={CX} cy={CY} r={R_HUB - 9} fill="none"
                stroke="rgba(247,244,239,0.09)" stroke-width="1" />
        <circle class="cp__core-dash" cx={CX} cy={CY} r={R_HUB - 18} fill="none"
                stroke={rgba(AQUA, 0.3)} stroke-width="1"
                stroke-dasharray="1.5 12" stroke-linecap="round" />
        <g aria-hidden="true">
          {[0, 90, 180, 270].map((deg) => {
            const a = (deg * Math.PI) / 180;
            const [x1, y1] = pol(R_HUB - 6, a);
            const [x2, y2] = pol(R_HUB - 1, a);
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={rgba(AQUA, 0.75)} stroke-width="1.5" />;
          })}
        </g>

      </svg>

      <!-- Hub readout: HTML rather than SVG text so descriptions can wrap. -->
      <div class="cp__readout" aria-live="polite">
        <div class="cp__readout-default cp__readout-pane">
          <span class="cp__readout-brand">DUSA</span>
          <span class="cp__readout-sub">ONE LOGIN</span>
        </div>
        <div class="cp__readout-detail cp__readout-pane" aria-hidden="true">
          <span class="cp__readout-domain"></span>
          <span class="cp__readout-name"></span>
          <span class="cp__readout-desc"></span>
        </div>
      </div>
    </div>

      <div class="cp__tip" aria-hidden="true">
        <span class="cp__tip-ai">AI</span>
        <span class="cp__tip-name"></span>
        <span class="cp__tip-val"></span>
      </div>

    <p class="cp__hint"><i aria-hidden="true"></i>{hubHint}</p>

    <div class="cp__legend reveal">
      {DOMAINS.map((d, i) => (
        <button class="cp__lg" data-domain={i} type="button" style={`--lg:${d.color}`}>
          <i></i>{d.name}<b>{d.items.length}</b>
        </button>
      ))}
      <span class="cp__lg cp__lg--ai"><i></i>AI powered<b>{aiCount}</b></span>
    </div>

    <!-- The full model as text: readable by screen readers and crawlers. -->
    <div class="cp__sr">
      {DOMAINS.map((d) => (
        <div>
          <h3>{d.name}</h3>
          <ul>
            {d.items.map((it) => (
              <li>{it.l.replace('\n', ' ')}: {it.d}{it.ai ? ' (AI powered)' : ''}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="cp__apps reveal">
      <div class="cp__apps-head">
        <span class="cp__apps-line" aria-hidden="true"></span>
        <span class="cp__apps-title">{gridHeading} <b>{appCount}+</b></span>
        <span class="cp__apps-line" aria-hidden="true"></span>
      </div>

      <p class="cp__apps-lede">
        {appsLede}<span>{appsSub}</span>
      </p>

      <div class="cp__marquee">
        {[rowA, rowB].map((row, ri) => (
          <div class={`cp__row cp__row--${ri}`}>
            <div class="cp__track">
              {[...row, ...row, ...row, ...row].map((a) => (
                <span class={`cp__chip ${a.path ? '' : 'cp__chip--word'}`} style={`--brand:${a.hex || '#4ED8C2'}`}>
                  {a.path && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={a.path} /></svg>}
                  <span>{a.name}</span>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="cp__note">{note}</p>
      <div class="cp__cta-wrap">
        <a href="/services" class="cp__cta">{ctaLabel} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Glass system ───
     Every surface uses the same recipe: frosted backdrop, hairline edge, and a
     1px inset highlight along the top so the light source stays consistent. */
  .cp {
    --glass-bg: rgba(247, 244, 239, 0.045);
    --glass-edge: rgba(247, 244, 239, 0.11);
    --glass-lip: inset 0 1px 0 rgba(255, 255, 255, 0.13);
