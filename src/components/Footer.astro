---
// Footer.astro

interface Props {
  t?: Record<string, any>;
}

const { t = {} } = Astro.props;

const f = t?.footer || {};
const tagline = f.tagline || 'Brands that bloom.';
const desc = f.desc || 'Digital Utility for Sales & Automation. The AI-powered growth platform for small businesses.';
const platformHeading = f.platformHeading || 'Platform';
const companyHeading = f.companyHeading || 'Company';
const getInTouchHeading = f.getInTouchHeading || 'Get in Touch';
const featuresLabel = f.features || 'Features';
const howItWorksLabel = f.howItWorks || 'How It Works';
const onboardingLabel = f.onboarding || 'Onboarding';
const pricingLabel = f.pricing || 'Pricing';
const aboutLabel = f.about || 'About';
const servicesLabel = f.services || 'Services';
const contactLabel = f.contact || 'Contact';
const getStartedLabel = f.getStarted || 'Get Started';
const newsLabel = f.news || 'News';
const industriesHeading = f.industriesHeading || 'Industries';
const industriesLabel = f.industries || 'All Industries';
const realEstateLabel = f.realEstate || 'Real Estate';
const gymsLabel = f.gyms || 'Gyms & Fitness';
const restaurantsLabel = f.restaurants || 'Restaurants';
const salonsLabel = f.salons || 'Salons';
const tradiesLabel = f.tradies || 'Trades';
const dentistsLabel = f.dentists || 'Dentists';
const coachesLabel = f.coaches || 'Coaches';
const locationLabel = f.location || 'Sydney, Australia';
const soc2Title = f.soc2Title || 'SOC 2 Type II';
const soc2Sub = f.soc2Sub || 'Compliant';
const hipaaTitle = f.hipaaTitle || 'HIPAA';
const hipaaSubCompliant = f.hipaaSubCompliant || 'Compliant*';
const hipaaNote = f.hipaaNote || '*HIPAA compliance available as an add-on for healthcare businesses.';
const copyright = f.copyright || '2026 DUSA . studio. All rights reserved.';
const privacyPolicyLabel = f.privacyPolicy || 'Privacy Policy';
const termsLabel = f.termsOfService || 'Terms of Service';

// Ask AI + share bar
const askAiLabel = f.askAi || 'Ask AI about DUSA:';
const shareLabel = f.shareThis || 'Share this:';
const aiPrompt = encodeURIComponent(
  f.aiPrompt ||
  'What is DUSA . studio (dusa.studio) and how can it help my small business grow?'
);
---

<footer class="footer section--dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" data-page="home" class="footer__logo">
          <span class="footer__logo-text">
            <span class="footer__logo-shimmer">DUSA</span>
            <span class="footer__logo-dot" aria-hidden="true">.</span>
            <span class="footer__logo-shimmer">studio</span>
          </span>
        </a>
        <p class="footer__tagline">{tagline}</p>
        <p class="footer__desc">{desc}</p>
        <div class="footer__social">
          <a href="https://www.instagram.com/the.dusa.studio" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Follow DUSA on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/company/dusa-studio" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Follow DUSA on LinkedIn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">{platformHeading}</h4>
        <a href="/#features" data-page="home" data-hash="#features" class="footer__link">{featuresLabel}</a>
        <a href="/#how-it-works" data-page="home" data-hash="#how-it-works" class="footer__link">{howItWorksLabel}</a>
        <a href="/onboarding" data-page="onboarding" class="footer__link">{onboardingLabel}</a>
        <a href="/pricing" data-page="pricing" class="footer__link">{pricingLabel}</a>
        <a href="/start" data-page="start" class="footer__link">{getStartedLabel}</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">{industriesHeading}</h4>
        <a href="/industries" data-page="industries" class="footer__link">{industriesLabel}</a>
        <a href="/industries/real-estate" data-page="industries/real-estate" class="footer__link">{realEstateLabel}</a>
        <a href="/industries/gyms" data-page="industries/gyms" class="footer__link">{gymsLabel}</a>
        <a href="/industries/restaurants" data-page="industries/restaurants" class="footer__link">{restaurantsLabel}</a>
        <a href="/industries/salons" data-page="industries/salons" class="footer__link">{salonsLabel}</a>
        <a href="/industries/tradies" data-page="industries/tradies" class="footer__link">{tradiesLabel}</a>
        <a href="/industries/dentists" data-page="industries/dentists" class="footer__link">{dentistsLabel}</a>
        <a href="/industries/coaches" data-page="industries/coaches" class="footer__link">{coachesLabel}</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">{companyHeading}</h4>
        <a href="/about" data-page="about" class="footer__link">{aboutLabel}</a>
        <a href="/services" data-page="services" class="footer__link">{servicesLabel}</a>
        <a href="/contact" data-page="contact" class="footer__link">{contactLabel}</a>
        <a href="/blog" data-page="blog" class="footer__link">{newsLabel}</a>
      </div>

      <div class="footer__col footer__col--right">
        <h4 class="footer__heading">{getInTouchHeading}</h4>
        <a href="mailto:contact@dusa.studio" class="footer__link footer__link--highlight">contact@dusa.studio</a>
        <a href="tel:+61488825686" class="footer__link">+61 488 825 686</a>
        <p class="footer__link" style="opacity:0.4">{locationLabel}</p>
      </div>
    </div>

    <div class="footer__trust">
      <div class="footer__badge">
        <svg class="footer__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <div class="footer__badge-text">
          <span class="footer__badge-title">{soc2Title}</span>
          <span class="footer__badge-sub">{soc2Sub}</span>
        </div>
      </div>
      <div class="footer__badge">
        <svg class="footer__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <div class="footer__badge-text">
          <span class="footer__badge-title">{hipaaTitle}</span>
          <span class="footer__badge-sub">{hipaaSubCompliant}</span>
        </div>
      </div>
      <p class="footer__badge-note">{hipaaNote}</p>
    </div>

    <!-- Ask AI + share bar: seeds the big AI engines with a question about
         DUSA (a GEO nudge that also builds user habit) and makes any page
         one tap to share. Icons are official simple-icons brand marks. -->
    <div class="footer__ai-bar" id="footer-ai-bar">
      <div class="footer__ai-group">
        <span class="footer__ai-label">{askAiLabel}</span>
        <a class="footer__ai-link" href={`https://chatgpt.com/?q=${aiPrompt}`} target="_blank" rel="noopener noreferrer" aria-label="Ask ChatGPT about DUSA" title="ChatGPT">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.998 5.998 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg>
        </a>
        <a class="footer__ai-link" href={`https://claude.ai/new?q=${aiPrompt}`} target="_blank" rel="noopener noreferrer" aria-label="Ask Claude about DUSA" title="Claude">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"/></svg>
        </a>
        <a class="footer__ai-link" href={`https://www.google.com/search?udm=50&q=${aiPrompt}`} target="_blank" rel="noopener noreferrer" aria-label="Ask Google AI about DUSA" title="Google AI Mode">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81"/></svg>
        </a>
        <a class="footer__ai-link" href={`https://www.perplexity.ai/search?q=${aiPrompt}`} target="_blank" rel="noopener noreferrer" aria-label="Ask Perplexity about DUSA" title="Perplexity">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M22.3977 7.0896h-2.3106V.0676l-7.5094 6.3542V.1577h-1.1554v6.1966L4.4904 0v7.0896H1.6023v10.3976h2.8882V24l6.932-6.3591v6.2005h1.1554v-6.0469l6.9318 6.1807v-6.4879h2.8882V7.0896zm-3.4657-4.531v4.531h-5.355l5.355-4.531zm-13.2862.0676 4.8691 4.4634H5.6458V2.6262zM2.7576 16.332V8.245h7.8476l-6.1149 6.1147v1.9723H2.7576zm2.8882 5.0404v-3.8852h.0001v-2.6488l5.7763-5.7764v7.0111l-5.7764 5.2993zm12.7086.0248-5.7766-5.1509V9.0618l5.7766 5.7766v6.5588zm2.8882-5.0652h-1.733v-1.9723L13.3948 8.245h7.8478v8.087z"/></svg>
        </a>
      </div>

      <div class="footer__ai-divider" aria-hidden="true"></div>

      <div class="footer__ai-group">
        <span class="footer__ai-label">{shareLabel}</span>
        <button class="footer__ai-link" id="footer-copy-link" aria-label="Copy link to this page" title="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
        <a class="footer__ai-link" id="footer-share-li" href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fdusa.studio" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a class="footer__ai-link" id="footer-share-fb" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fdusa.studio" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Share on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
        </a>
        <a class="footer__ai-link" id="footer-share-x" href="https://twitter.com/intent/tweet?url=https%3A%2F%2Fdusa.studio" target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; {copyright}</p>
      <div class="footer__legal">
        <a href="/privacy-policy" data-page="privacy-policy">{privacyPolicyLabel}</a>
        <a href="/terms" data-page="terms">{termsLabel}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-2xl) 0 var(--space-lg);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(78, 216, 194, 0.15), transparent);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .footer__logo-text {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer__logo-dot {
    color: var(--reef-aqua);
    font-weight: 700;
    margin: 0 -0.05rem;
  }

  /* Shimmer sweep animation */
  @keyframes shimmerSweep {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .footer__logo-shimmer {
    background: linear-gradient(
      90deg,
      var(--mist-blue) 0%,
      var(--mist-blue) 35%,
      var(--reef-aqua) 50%,
      var(--mist-blue) 65%,
      var(--mist-blue) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 4s ease-in-out infinite;
  }

  .footer__tagline {
    font-family: var(--font-headline);
    font-weight: 500;
    color: var(--reef-aqua);
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .footer__desc {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.6;
    max-width: 300px;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 239, 0.4);
    margin-bottom: var(--space-sm);
    font-weight: 400;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__col--right {
    text-align: right;
    align-items: flex-end;
  }

  .footer__link {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.6);
    transition: color var(--duration-fast);
    padding: 0.25rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .footer__link:hover {
    color: var(--reef-aqua);
  }

  .footer__link--highlight {
    color: var(--reef-aqua);
  }

  /* ─── Trust Badges ─── */
  .footer__trust {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    margin-bottom: var(--space-sm);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
    flex-wrap: wrap;
  }

  .footer__badge {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(78, 216, 194, 0.2);
    border-radius: var(--radius-md, 8px);
    background: rgba(78, 216, 194, 0.04);
    transition: border-color var(--duration-fast);
  }

  .footer__badge:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  .footer__badge-icon {
    width: 22px;
    height: 22px;
    color: var(--reef-aqua);
    flex-shrink: 0;
  }

  .footer__badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .footer__badge-title {
