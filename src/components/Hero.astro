---
// Hero.astro — Full-viewport editorial hero with notification phone mockup
import allNotifications from '../i18n/notifications.json';

interface Props {
  t?: Record<string, any>;
  lang?: string;
}
const { t = {}, lang = 'en' } = Astro.props;

const s = t?.hero || {};
const heroLabel = s.label || 'The AI-Powered Growth System';
const heroTitle = s.title || 'Everything you need.';
const heroTitleAccent = s.titleAccent || 'One login.';
const heroSubtitle = s.subtitle || 'AI-powered marketing, sales, and engagement. All connected. So you can run your business, not your tech stack.';
const heroGetStarted = s.getStarted || 'Get Started';
const heroBookDemo = s.bookDemo || 'Book a Demo';
const heroPhoneApp = s.phoneApp || 'DUSA . studio';
const heroStatLeads = s.statLeads || 'leads';
const heroStatTracked = s.statTracked || 'tracked';
const heroStatRating = s.statRating || 'rating';
const heroCapCrmTitle = s.capCrmTitle || 'CRM & Contacts';
const heroCapCrmSub = s.capCrmSub || 'Track every lead';
const heroCapEmailTitle = s.capEmailTitle || 'Email & SMS';
const heroCapEmailSub = s.capEmailSub || 'Campaigns on autopilot';
const heroCapFunnelsTitle = s.capFunnelsTitle || 'Funnels & Automations';
const heroCapFunnelsSub = s.capFunnelsSub || 'Convert while you sleep';
const heroCapAiTitle = s.capAiTitle || 'AI Built In';
const heroCapAiSub = s.capAiSub || 'Smarter conversations, faster growth';
const heroScrollExplore = s.scrollExplore || 'Explore';

// Intro (opening panel) strings
const introLabel = s.introLabel || 'Growth, done for you';
const introH1 = s.introH1 || 'We help your business';
const introH1Accent = s.introH1Accent || 'grow';
const introSub = s.introSub || "Running a business today means a dozen apps that don't talk to each other, and you stuck in the middle. DUSA replaces the mess with one system that chases every lead, books the jobs, and gets you paid. Automatically.";
const introStat1n = s.introStat1n || '12+ apps';
const introStat1l = s.introStat1l || 'too many apps to run a business';
const introStat2n = s.introStat2n || '1 login';
const introStat2l = s.introStat2l || 'what it takes with DUSA';
const introStat3n = s.introStat3n || '10+ hrs';
const introStat3l = s.introStat3l || 'of busywork handed to AI, every week';
const introStat4n = s.introStat4n || '+32%';
const introStat4l = s.introStat4l || 'more revenue in your first year';
const introNote = s.introNote || "Less chaos. More customers. That's the whole idea.";
const introSee = s.introSee || "See what's inside";
const introFreeDemo = s.introFreeDemo || 'Book a Free Demo';
const introFreeDemoShort = s.introFreeDemoShort || 'Free Demo';
const introSetupNote = s.introSetupNote || 'Setup done for you &middot; Powered by AI &middot; Cancel anytime';

// Pick notification translations for the current language
const notifLang = (lang in allNotifications) ? lang : 'en';
const notifTranslations = (allNotifications as Record<string, any>)[notifLang];
const notifJson = JSON.stringify(notifTranslations);
---

<section class="hero section--dark" id="hero">
  <div class="hero__bg">
    <div class="hero__water" id="hero-water-canvas"></div>
    <div class="hero__grid-lines"></div>
  </div>

  <!-- ─── HERO INTRO: opening statement over the integration globe ─── -->
  <div class="hero__intro" id="hero-intro">
    <div class="hero__integration-field" id="integration-field">
      <!-- Rotating globe of app cubes rendered by integration-field.js -->
    </div>
    <div class="hero__intro-scrim" aria-hidden="true"></div>

    <div class="hero__intro-content">
      <span class="hero__intro-label">{introLabel}</span>

      <h2 class="hero__intro-headline">
        {introH1} <span class="gradient-text">{introH1Accent}</span>.
      </h2>

      <p class="hero__intro-sub">{introSub}</p>

      <div class="hero__intro-stats">
        <div class="hero__intro-stat hero__intro-stat--dim">
          <span class="hero__intro-stat-num">{introStat1n}</span>
          <span class="hero__intro-stat-label">{introStat1l}</span>
        </div>
        <div class="hero__intro-stat">
          <span class="hero__intro-stat-num">{introStat2n}</span>
          <span class="hero__intro-stat-label">{introStat2l}</span>
        </div>
        <div class="hero__intro-stat">
          <span class="hero__intro-stat-num">{introStat3n}</span>
          <span class="hero__intro-stat-label">{introStat3l}</span>
        </div>
        <div class="hero__intro-stat">
          <span class="hero__intro-stat-num">{introStat4n}</span>
          <span class="hero__intro-stat-label">{introStat4l}</span>
        </div>
      </div>
      <p class="hero__intro-statnote">{introNote}</p>

      <div class="hero__intro-ctas">
        <a href="/start" data-page="start" class="btn btn--primary">{heroGetStarted}</a>
        <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">{introFreeDemo}</a>
      </div>

      <p class="hero__intro-note" set:html={introSetupNote}></p>
    </div>

    <button class="hero__intro-scroll" id="intro-scroll-cue" aria-label="Scroll to see the platform">
      <span>{introSee}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>

  <!-- Sticky mobile CTA — appears once the intro is scrolled past -->
  <div class="hero__sticky-cta" id="sticky-cta">
    <a href="/start" data-page="start" class="hero__sticky-btn">{heroGetStarted}</a>
    <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="hero__sticky-btn hero__sticky-btn--ghost">{introFreeDemoShort}</a>
  </div>

  <div class="container hero__inner">
    <div class="hero__layout">
      <div class="hero__content">
        <span class="label reveal">{heroLabel}</span>

        <h1 class="hero__title reveal">
          {heroTitle}<br />
          <span class="gradient-text">{heroTitleAccent}</span>
        </h1>

        <p class="hero__subtitle reveal">{heroSubtitle}</p>

        <div class="hero__ctas reveal">
          <a href="/start" data-page="start" class="btn btn--primary">{heroGetStarted}</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">{heroBookDemo}</a>
        </div>
      </div>

      <div class="hero__phone-wrap reveal-right">
        <div class="hero__phone">
          <div class="hero__phone-notch"></div>
          <div class="hero__phone-browserbar" aria-hidden="true">
            <span></span><span></span><span></span>
            <em>app.dusa.studio</em>
          </div>
          <div class="hero__phone-time" id="hero-phone-clock">9:41</div>
          <div class="hero__phone-header">
            <!-- Static lotus: this renders at 22x22, where a 91-frame animation is
                 both invisible and 96KB on the critical path. The animated
                 version still runs in the Features chip, at 52px. -->
            <img class="hero__phone-logo" id="hero-phone-lotus" src="/dusa-logo.webp" alt="DUSA" width="22" height="22" decoding="async" />
            <span class="hero__phone-app">{heroPhoneApp}</span>
          </div>

          <div class="hero__stats-ticker" id="hero-stats-ticker">
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-leads">8</span> {heroStatLeads}</div>
            <div class="hero__stat-divider"></div>
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-revenue">$2.4k</span> {heroStatTracked}</div>
            <div class="hero__stat-divider"></div>
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-rating">4.8</span>&#9733;</div>
          </div>

          <div class="hero__notifs" id="hero-notif-feed"></div>
          <script type="application/json" id="hero-notif-data" set:html={notifJson}></script>
        </div>

        <!-- Monitor stand — only visible in Desktop mode -->
        <div class="hero__phone-stand" aria-hidden="true">
          <i></i>
          <span></span>
        </div>

        <div class="hero__platforms">
          <div class="hero__cube-stage">
            <div class="hero__cube" id="platform-cube">
              <!-- Front: iOS -->
              <div class="hero__cube-face hero__cube-face--front">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              </div>
              <!-- Right: Android -->
              <div class="hero__cube-face hero__cube-face--right">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.27-.86-.31-.16-.69-.04-.86.27l-1.87 3.23C14.89 8.35 13.48 8 12 8c-1.48 0-2.89.35-4.44.94L5.69 5.71c-.16-.31-.54-.43-.86-.27-.31.16-.43.55-.27.86l1.84 3.18C3.38 11.2 1.39 13.96 1 17h22c-.39-3.04-2.38-5.8-5.4-7.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/></svg>
              </div>
              <!-- Back: Desktop -->
              <div class="hero__cube-face hero__cube-face--back">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <!-- Left: Browser -->
              <div class="hero__cube-face hero__cube-face--left">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
              </div>
              <!-- Top: Tablet -->
              <div class="hero__cube-face hero__cube-face--top">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="10" y1="18.5" x2="14" y2="18.5"/></svg>
              </div>
              <!-- Bottom: DUSA Lotus (real favicon) -->
              <div class="hero__cube-face hero__cube-face--bottom">
                <svg viewBox="0 0 500 500" width="36" height="36" fill="currentColor">
                  <path d="M215.4,395.1c-5.2,0-9.5-3-11.5-8c-7.2-17.8-14.5-35.7-21.7-53.5c-10-24.6-27.3-41.9-51.9-51.9c-17.9-7.3-35.9-14.6-53.8-21.9c-8.7-3.5-10.5-14.9-3.3-20.7c1.1-0.9,2.5-1.6,3.9-2.2c18.1-7.4,36.3-14.6,54.4-22.1c24-10,40.8-27.2,50.7-51.3c7.3-17.8,14.5-35.7,21.7-53.5c2.1-5.2,6.3-8.2,11.6-8.2c5.2,0,9.4,3,11.4,8.2c7.5,18.4,14.7,37,22.5,55.3c10,23.7,27.3,40.3,51.1,50c17.8,7.3,35.7,14.5,53.5,21.7c5,2,8,6.3,8,11.4c0,5.2-2.9,9.5-8,11.5c-17.9,7.3-35.8,14.5-53.7,21.8c-25.2,10.3-42.5,28.2-52.5,53.5c-6.8,17.3-14,34.5-21,51.7C224.7,392.1,220.5,395.1,215.4,395.1z"/>
                  <path d="M354.7,39.8c3.4,0,6.1,1.9,7.3,5.3c2.3,6.5,4.4,13.1,6.9,19.6c5.8,15.3,16.7,25.6,32.2,31c5.9,2.1,11.9,4,17.8,6.2c5.2,1.9,7,8,3.4,12.2c-0.9,1.1-2.4,2-3.8,2.5c-6.5,2.4-13.1,4.5-19.6,6.9c-15.2,5.8-25.3,16.6-30.7,31.9c-2.1,5.9-4.1,11.8-6.1,17.6c-1.3,3.6-3.9,5.6-7.4,5.6c-3.5,0-6.1-2-7.4-5.6c-2.7-7.5-5-15.1-8.1-22.4c-5.8-13.5-16.1-22.6-29.9-27.6c-6-2.2-12.1-4.2-18.2-6.4c-3.8-1.3-5.7-3.9-5.7-7.5c0-3.6,1.9-6.2,5.7-7.5c7.3-2.6,14.7-4.8,21.8-7.8c14-6,23.4-16.6,28.4-31c2.1-5.9,4.1-11.9,6.2-17.8C348.4,41.7,351.1,39.8,354.7,39.8z"/>
                  <path d="M362,321.5c3.4,0,6.1,1.9,7.3,5.3c2.3,6.5,4.4,13.1,6.9,19.6c5.8,15.3,16.7,25.6,32.2,31c5.9,2.1,11.9,4,17.8,6.2c5.2,1.9,7,8,3.4,12.2c-0.9,1.1-2.4,2-3.8,2.5c-6.5,2.4-13.1,4.5-19.6,6.9c-15.2,5.8-25.3,16.6-30.7,31.9c-2.1,5.9-4.1,11.8-6.1,17.6c-1.3,3.6-3.9,5.6-7.4,5.6c-3.5,0-6.1-2-7.4-5.6c-2.7-7.5-5-15.1-8.1-22.4c-5.8-13.5-16.1-22.6-29.9-27.6c-6-2.2-12.1-4.2-18.2-6.4c-3.8-1.3-5.7-3.9-5.7-7.5c0-3.6,1.9-6.2,5.7-7.5c7.3-2.6,14.7-4.8,21.8-7.8c14-6,23.4-16.6,28.4-31c2.1-5.9,4.1-11.9,6.2-17.8C355.8,323.3,358.5,321.4,362,321.5z"/>
                </svg>
              </div>
            </div>
          </div>
          <div class="hero__platform-btns" id="platform-btns">
            <button class="hero__platform-btn hero__platform-btn--active" data-mode="phone" aria-label="Phone. Click again to switch between iPhone and Android" title="Click again to switch iPhone / Android">
              <svg class="hero__pbtn-ios" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              <svg class="hero__pbtn-android" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.27-.86-.31-.16-.69-.04-.86.27l-1.87 3.23C14.89 8.35 13.48 8 12 8c-1.48 0-2.89.35-4.44.94L5.69 5.71c-.16-.31-.54-.43-.86-.27-.31.16-.43.55-.27.86l1.84 3.18C3.38 11.2 1.39 13.96 1 17h22c-.39-3.04-2.38-5.8-5.4-7.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/></svg>
              <span>Phone</span>
            </button>
            <button class="hero__platform-btn" data-mode="tablet" aria-label="Tablet">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="10" y1="18.5" x2="14" y2="18.5"/></svg>
              <span>Tablet</span>
            </button>
            <button class="hero__platform-btn" data-mode="desktop" aria-label="Desktop">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              <span>Desktop</span>
            </button>
            <button class="hero__platform-btn" data-mode="web" aria-label="Web">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
              <span>Web</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__capabilities reveal">
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">{heroCapCrmTitle}</span>
          <span class="hero__cap-sub">{heroCapCrmSub}</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">{heroCapEmailTitle}</span>
          <span class="hero__cap-sub">{heroCapEmailSub}</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">{heroCapFunnelsTitle}</span>
          <span class="hero__cap-sub">{heroCapFunnelsSub}</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4z"/><path d="M9 12h6l2 10H7l2-10z"/><circle cx="12" cy="5" r="1" fill="currentColor"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">{heroCapAiTitle}</span>
          <span class="hero__cap-sub">{heroCapAiSub}</span>
        </div>
      </div>
    </div>

    <div class="hero__scroll-indicator">
      <span class="hero__scroll-text">{heroScrollExplore}</span>
      <div class="hero__scroll-line"></div>
      <svg class="hero__scroll-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: block;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__water {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Canvas is created dynamically by water-ripple.js — styles are set inline
     in the script to avoid Astro scoping issues with dynamic elements. */

  .hero__grid-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(rgba(247, 244, 239, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 244, 239, 0.018) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-3xl) var(--space-xl);
    width: 100%;
  }

  /* Centered column — the phone is the hero: apps funnel into it on scroll */
  .hero__layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Grid children need min-width: 0 to prevent overflow from intrinsic sizing */
  .hero__layout > * {
    min-width: 0;
  }

  .hero__title {
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    margin-bottom: 0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    font-size: 1.25rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.7;
    margin-top: var(--space-md);
    max-width: 560px;
    margin-inline: auto;
    overflow-wrap: break-word;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* --- Phone Mockup --- */
  .hero__phone-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__phone {
    width: 320px;
    height: 640px;
    box-sizing: border-box;
    background: linear-gradient(165deg, rgba(247, 244, 239, 0.06) 0%, rgba(247, 244, 239, 0.02) 100%);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 36px;
    padding: 16px 16px 12px;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(247, 244, 239, 0.04),
      0 25px 80px rgba(0, 0, 0, 0.5),
      0 0 120px rgba(78, 216, 194, 0.08),
      inset 0 1px 0 rgba(247, 244, 239, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .hero__phone::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 37px;
    background: linear-gradient(165deg, rgba(247, 244, 239, 0.12) 0%, transparent 40%, rgba(78, 216, 194, 0.06) 100%);
    z-index: -1;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    padding: 1px;
  }

  .hero__phone-notch {
    width: 100px;
    height: 6px;
    background: rgba(247, 244, 239, 0.08);
    border-radius: 10px;
    margin: 0 auto 12px;
  }

  .hero__phone-time {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--reef-aqua);
    text-align: center;
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }

  .hero__phone-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 4px 12px;
    border-bottom: 1px solid rgba(247, 244, 239, 0.06);
    margin-bottom: 12px;
  }

  .hero__phone-logo {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 4px;
  }

  .hero__phone-app {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.6);
  }

  /* --- Notifications --- */
  .hero__notifs {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(to bottom, transparent 0%, black 2%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 2%, black 92%, transparent 100%);
    padding: 4px 0;
  }

  .hero__notifs::-webkit-scrollbar {
    width: 3px;
  }

  .hero__notifs::-webkit-scrollbar-track {
    background: transparent;
  }

  .hero__notifs::-webkit-scrollbar-thumb {
    background: rgba(78, 216, 194, 0.2);
    border-radius: 3px;
  }

  .hero__notifs::-webkit-scrollbar-thumb:hover {
    background: rgba(78, 216, 194, 0.4);
  }

  .hero__notif {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-sm);
    transition: all var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Glow effect is applied via JS inline styles for reliability */

  /* ══ DEVICE MORPH — phone ↔ tablet ↔ laptop ↔ web ══ */
  .hero__phone {
    transition:
      width 0.55s var(--ease-out),
      height 0.55s var(--ease-out),
      border-radius 0.55s var(--ease-out),
      padding 0.55s var(--ease-out);
  }

  /* Android — punch-hole camera instead of the notch bar */
  .hero__phone--android .hero__phone-notch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(247, 244, 239, 0.16);
  }

  /* Tablet — wider, softer corners, same feed (an iPad is a big phone) */
  .hero__phone--tablet {
    width: min(430px, 92vw);
    height: 580px;
    border-radius: 26px;
  }

  .hero__phone--tablet .hero__phone-notch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* Laptop — landscape screen, notifications become desktop toasts on the
     right, with a hinted dashboard behind them */
  .hero__phone--laptop,
  .hero__phone--web {
    width: min(600px, 92vw);
    height: 430px;
  }

  /* Desktop — Mac-style display with an aluminium chin */
  .hero__phone--laptop {
    border-radius: 16px;
    border-bottom: 14px solid rgba(247, 244, 239, 0.12);
  }

  /* Monitor stand: tapered neck + the base line at desk level,
     right where the keyboard would sit */
  .hero__phone-stand {
    display: none;
    flex-direction: column;
    align-items: center;
    margin-top: -2px;
  }

  .hero__phone--laptop + .hero__phone-stand {
    display: flex;
  }

  .hero__phone-stand i {
    width: 86px;
    height: 44px;
    background: linear-gradient(180deg, rgba(247, 244, 239, 0.12), rgba(247, 244, 239, 0.05));
    clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);
  }

  .hero__phone-stand span {
    width: 250px;
    height: 9px;
    border-radius: 5px;
    background: linear-gradient(180deg, rgba(247, 244, 239, 0.16), rgba(247, 244, 239, 0.08));
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .hero__phone--laptop .hero__phone-notch {
    display: none;
  }

  .hero__phone--laptop .hero__phone-time {
    position: absolute;
    top: 12px;
    right: 18px;
    font-size: 0.8rem;
    margin: 0;
    z-index: 2;
  }

  .hero__phone--laptop .hero__notifs,
  .hero__phone--web .hero__notifs {
    position: absolute;
    top: 102px;
    right: 16px;
    bottom: 16px;
    width: 240px;
    gap: 10px;
    padding: 0;
  }

  /* Roomier macOS banner padding */
  .hero__phone--laptop :global(.hero__notif),
  .hero__phone--web :global(.hero__notif) {
    padding: 11px 13px;
  }

  /* macOS-style notification banners — new ones slide in from the right
     at the top corner, translucent glass, no app-feed colour bar */
  @keyframes macNotifIn {
    0%   { transform: translateX(130%); opacity: 0; }
    70%  { transform: translateX(-3%); opacity: 1; }
    100% { transform: translateX(0); opacity: 1; }
  }

  .hero__phone--laptop :global(.hero__notif),
  .hero__phone--web :global(.hero__notif),
  .hero__phone--laptop :global(.hero__typing),
  .hero__phone--web :global(.hero__typing) {
    background: rgba(46, 54, 70, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(247, 244, 239, 0.12);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    animation: macNotifIn 0.5s cubic-bezier(0.2, 0.85, 0.3, 1) both;
  }

  /* Cascade politely when switching into Desktop / Web mode */
  .hero__phone--laptop :global(.hero__notif:nth-child(2)),
  .hero__phone--web :global(.hero__notif:nth-child(2)) { animation-delay: 0.06s; }
  .hero__phone--laptop :global(.hero__notif:nth-child(3)),
  .hero__phone--web :global(.hero__notif:nth-child(3)) { animation-delay: 0.12s; }
  .hero__phone--laptop :global(.hero__notif:nth-child(4)),
  .hero__phone--web :global(.hero__notif:nth-child(4)) { animation-delay: 0.18s; }
  .hero__phone--laptop :global(.hero__notif:nth-child(n+5)),
  .hero__phone--web :global(.hero__notif:nth-child(n+5)) { animation-delay: 0.24s; }

  /* Mac banners have no coloured left bar */
  .hero__phone--laptop :global(.hero__notif span[style*="width: 2px"]),
  .hero__phone--web :global(.hero__notif span[style*="width: 2px"]),
  .hero__phone--laptop :global(.hero__notif span[style*="width:2px"]),
  .hero__phone--web :global(.hero__notif span[style*="width:2px"]) {
    display: none;
  }

  .hero__phone--web .hero__notifs {
    top: 130px;
  }

  /* Faint dashboard skeleton on the left of the laptop/web screen */
  .hero__phone--laptop::after,
  .hero__phone--web::after {
    content: '';
    position: absolute;
    left: 16px;
    right: 272px;
    top: 102px;
    bottom: 16px;
    border-radius: 10px;
    border: 1px solid rgba(247, 244, 239, 0.06);
    background:
      linear-gradient(rgba(247, 244, 239, 0.05), rgba(247, 244, 239, 0.05)) 0 0 / 100% 30px no-repeat,
      linear-gradient(180deg, rgba(78, 216, 194, 0.45), rgba(78, 216, 194, 0.06)) 16px 100% / 26px 42% no-repeat,
      linear-gradient(180deg, rgba(78, 216, 194, 0.45), rgba(78, 216, 194, 0.06)) 52px 100% / 26px 62% no-repeat,
      linear-gradient(180deg, rgba(78, 216, 194, 0.45), rgba(78, 216, 194, 0.06)) 88px 100% / 26px 50% no-repeat,
      linear-gradient(180deg, rgba(78, 216, 194, 0.45), rgba(78, 216, 194, 0.06)) 124px 100% / 26px 76% no-repeat,
      linear-gradient(180deg, rgba(78, 216, 194, 0.45), rgba(78, 216, 194, 0.06)) 160px 100% / 26px 58% no-repeat;
  }

  .hero__phone--web::after {
    top: 130px;
  }

  /* Web — browser chrome with traffic lights and the app URL */
  .hero__phone--web {
    border-radius: 14px;
    padding-top: 48px;
  }

  .hero__phone--web .hero__phone-notch,
  .hero__phone--web .hero__phone-time {
    display: none;
  }

  .hero__phone-browserbar {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 36px;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    background: rgba(247, 244, 239, 0.05);
    border-bottom: 1px solid rgba(247, 244, 239, 0.08);
    z-index: 2;
  }

  .hero__phone--web .hero__phone-browserbar {
    display: flex;
  }

  .hero__phone-browserbar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero__phone-browserbar span:nth-child(1) { background: #ff5f57; }
  .hero__phone-browserbar span:nth-child(2) { background: #febc2e; }
  .hero__phone-browserbar span:nth-child(3) { background: #28c840; }

  .hero__phone-browserbar em {
    flex: 1;
    margin-left: 10px;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: rgba(247, 244, 239, 0.55);
    background: rgba(12, 14, 20, 0.5);
    border: 1px solid rgba(247, 244, 239, 0.07);
    border-radius: 7px;
    padding: 4px 12px;
    text-align: center;
  }

  /* Phone chip shows both OS marks — the active one lit, the other dimmed.
     Clicking Phone again swaps which OS is on screen. */
  .hero__platform-btn .hero__pbtn-ios,
  .hero__platform-btn .hero__pbtn-android {
    transition: opacity 0.25s ease;
  }

  .hero__platform-btn[data-mode="phone"]:not(.is-android) .hero__pbtn-android {
    opacity: 0.35;
  }

  .hero__platform-btn.is-android .hero__pbtn-ios {
    opacity: 0.35;
  }

  /* ─── STATS TICKER ─── */
  .hero__stats-ticker {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 6px 12px;
    background: rgba(78, 216, 194, 0.04);
    border-bottom: 1px solid rgba(247, 244, 239, 0.04);
    font-size: 0.625rem;
    color: rgba(247, 244, 239, 0.4);
    letter-spacing: 0.03em;
    font-family: var(--font-mono);
  }

  .hero__stat-item {
    display: flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
  }

  .hero__stat-val {
    color: var(--reef-aqua);
    font-weight: 600;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .hero__stat-val--bump {
    transform: scale(1.25);
    color: #fff;
  }

  .hero__stat-divider {
    width: 1px;
    height: 10px;
    background: rgba(247, 244, 239, 0.08);
    margin: 0 10px;
  }

  /* ─── TYPING INDICATOR ─── */
  .hero__typing {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-sm);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    align-items: center;
  }

  .hero__typing-dots {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .hero__typing-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--reef-aqua);
    opacity: 0.5;
    animation: typingBounce 1.2s ease-in-out infinite;
  }

  .hero__typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .hero__typing-dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .hero__typing-label {
    font-size: 0.6875rem;
    color: rgba(78, 216, 194, 0.6);
    font-style: italic;
  }

  /* ─── LOTUS PULSE ─── */
  .hero__phone-logo--pulse {
    animation: lotusPulse 0.8s ease-out;
  }

  @keyframes lotusPulse {
    0% { filter: drop-shadow(0 0 0 rgba(78, 216, 194, 0)); transform: scale(1); }
    30% { filter: drop-shadow(0 0 8px rgba(78, 216, 194, 0.6)); transform: scale(1.15); }
    100% { filter: drop-shadow(0 0 0 rgba(78, 216, 194, 0)); transform: scale(1); }
  }

  /* ─── QUIET HOURS NOTIFICATION ─── */
  .hero__notif--quiet {
    background: rgba(78, 216, 194, 0.06) !important;
    border-color: rgba(78, 216, 194, 0.2) !important;
    box-shadow: 0 0 12px 1px rgba(78, 216, 194, 0.12) !important;
  }

  .hero__notif::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    opacity: 0.6;
  }

  .hero__notif:hover {
    background: rgba(247, 244, 239, 0.07);
    border-color: rgba(247, 244, 239, 0.1);
  }

  .hero__notif:hover::before {
    opacity: 1;
  }

  .hero__notif-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
    overflow: hidden;
  }

  .hero__notif-icon svg {
    width: 14px !important;
    height: 14px !important;
    max-width: 14px;
    max-height: 14px;
    flex-shrink: 0;
  }

  .hero__notif-body {
    flex: 1;
    min-width: 0;
  }

  .hero__notif-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 2px;
  }

  .hero__notif-title {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--warm-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero__notif-time {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(247, 244, 239, 0.3);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__notif-text {
    font-size: 0.75rem;
    color: rgba(247, 244, 239, 0.45);
    line-height: 1.4;
  }

  /* --- Platform Cube --- */
  .hero__platforms {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: var(--space-md);
  }

  .hero__cube-stage {
    width: 72px;
    height: 72px;
    perspective: 600px;
    flex-shrink: 0;
  }

  .hero__cube {
    width: 72px;
    height: 72px;
    position: relative;
    transform-style: preserve-3d;
    animation: cubeTumble 20s linear infinite;
  }

  @keyframes cubeTumble {
    0%   { transform: rotateX(0deg)   rotateY(0deg)   rotateZ(0deg); }
    25%  { transform: rotateX(90deg)  rotateY(90deg)  rotateZ(0deg); }
    50%  { transform: rotateX(180deg) rotateY(180deg) rotateZ(90deg); }
    75%  { transform: rotateX(270deg) rotateY(270deg) rotateZ(0deg); }
    100% { transform: rotateX(360deg) rotateY(360deg) rotateZ(0deg); }
  }

  .hero__cube-face {
    position: absolute;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(12, 14, 20, 0.85);
    border: 1px solid rgba(78, 216, 194, 0.18);
    color: rgba(247, 244, 239, 0.7);
    box-shadow:
      inset 0 0 16px rgba(78, 216, 194, 0.06),
      0 0 8px rgba(78, 216, 194, 0.08);
    backdrop-filter: blur(4px);
  }

  .hero__cube-face--front  { transform: rotateY(0deg)    translateZ(36px); }
  .hero__cube-face--right  { transform: rotateY(90deg)   translateZ(36px); }
  .hero__cube-face--back   { transform: rotateY(180deg)  translateZ(36px); }
  .hero__cube-face--left   { transform: rotateY(270deg)  translateZ(36px); }
  .hero__cube-face--top    { transform: rotateX(90deg)   translateZ(36px); }
  .hero__cube-face--bottom { transform: rotateX(-90deg)  translateZ(36px); }

  /* Lotus top + bottom face gets a stronger aqua glow */
  .hero__cube-face--top,
  .hero__cube-face--bottom {
    color: var(--reef-aqua);
    background: rgba(12, 14, 20, 0.9);
    border-color: rgba(78, 216, 194, 0.35);
    box-shadow:
      inset 0 0 24px rgba(78, 216, 194, 0.12),
      0 0 16px rgba(78, 216, 194, 0.2),
      0 0 32px rgba(78, 216, 194, 0.08);
  }

  /* Platform selector buttons */
  .hero__platform-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }

  .hero__platform-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 8px;
    background: rgba(247, 244, 239, 0.04);
    color: rgba(247, 244, 239, 0.45);
    font-size: 0.65rem;
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .hero__platform-btn:hover {
    color: rgba(247, 244, 239, 0.7);
    border-color: rgba(78, 216, 194, 0.25);
    background: rgba(78, 216, 194, 0.06);
  }

  .hero__platform-btn--active {
    color: var(--reef-aqua);
    border-color: rgba(78, 216, 194, 0.35);
    background: rgba(78, 216, 194, 0.1);
    box-shadow: 0 0 12px rgba(78, 216, 194, 0.15);
  }

  /* When user selects a platform, pause the auto-tumble */
  .hero__cube--paused {
    animation-play-state: paused !important;
    transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* --- Capabilities Bar --- */
  .hero__capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .hero__cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-md);
    transition: all var(--duration-normal) var(--ease-out);
    min-width: 0;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__cap:hover {
    background: rgba(247, 244, 239, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(78, 216, 194, 0.08),
      inset 0 1px 0 rgba(247, 244, 239, 0.06);
  }

  .hero__cap-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(78, 216, 194, 0.1);
    border: 1px solid rgba(78, 216, 194, 0.12);
    color: var(--reef-aqua);
    flex-shrink: 0;
    box-shadow: 0 0 16px rgba(78, 216, 194, 0.08);
  }

  .hero__cap-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .hero__cap-title {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--warm-white);
    white-space: nowrap;
  }

  .hero__cap-sub {
    font-size: 0.75rem;
    color: rgba(247, 244, 239, 0.4);
    line-height: 1.4;
  }

  /* --- Scroll Indicator --- */
  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .hero__scroll-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(247, 244, 239, 0.3);
    transition: color var(--duration-fast);
  }

  .hero__scroll-indicator:hover .hero__scroll-text {
    color: var(--reef-aqua);
  }

  .hero__scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0));
    animation: lineGrow 2s ease-in-out infinite;
  }

  .hero__scroll-chevron {
    color: rgba(78, 216, 194, 0.5);
    animation: chevronBounce 2s ease-in-out infinite;
  }

  .hero__scroll-indicator:hover .hero__scroll-chevron {
    color: var(--reef-aqua);
  }

  @keyframes lineGrow {
    0%, 100% { opacity: 0.4; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  @keyframes chevronBounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @media (max-width: 1024px) {
    .hero__layout {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-lg);
    }

    .hero__title {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
    }

    .hero__subtitle {
      font-size: 1.125rem;
    }

    .hero__phone {
      width: 280px;
      height: 560px;
    }

    .hero__capabilities {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero__scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: var(--nav-height);
      padding-bottom: var(--space-xl);
    }

    .hero__inner {
      padding-block: var(--space-xl) var(--space-md);
    }

    .hero__layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .hero__content {
      text-align: center;
    }

    .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
      max-width: 90%;
      overflow-wrap: break-word;
    }

    .hero__cap-title,
    .hero__cap-sub {
      white-space: normal;
    }

    .hero__ctas {
      flex-direction: column;
      align-items: center;
    }

    .hero__ctas .btn {
      width: 100%;
      max-width: 320px;
      text-align: center;
      min-height: 48px;
    }

    .hero__phone-wrap {
      /* Text stays above phone on mobile -- natural document order */
      max-width: 100%;
      overflow: hidden;
    }

    .hero__phone {
      width: 260px;
      height: 520px;
    }

    .hero__platforms {
      margin-top: var(--space-sm);
      gap: 12px;
    }

    .hero__cube-stage {
      width: 56px;
      height: 56px;
    }

    .hero__cube {
      width: 56px;
      height: 56px;
    }

    .hero__cube-face {
      width: 56px;
      height: 56px;
      border-radius: 10px;
    }

    .hero__cube-face--front  { transform: rotateY(0deg)    translateZ(28px); }
    .hero__cube-face--right  { transform: rotateY(90deg)   translateZ(28px); }
    .hero__cube-face--back   { transform: rotateY(180deg)  translateZ(28px); }
    .hero__cube-face--left   { transform: rotateY(270deg)  translateZ(28px); }
    .hero__cube-face--top    { transform: rotateX(90deg)   translateZ(28px); }
    .hero__cube-face--bottom { transform: rotateX(-90deg)  translateZ(28px); }

    .hero__cube-face svg {
      width: 28px;
      height: 28px;
    }

    .hero__platform-btns {
      gap: 4px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero__platform-btn {
      padding: 6px 10px;
      font-size: 0.6rem;
      min-height: 44px;
    }

    .hero__platform-btn svg {
      width: 13px;
      height: 13px;
    }

    .hero__capabilities {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .hero__cap {
      padding: 0.75rem 1rem;
    }

    .hero__cap-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
    }

    .hero__cap-title {
      font-size: 0.8125rem;
    }

    .hero__cap-sub {
      font-size: 0.6875rem;
    }

    .hero__scroll-indicator {
      display: none;
    }

    /* Reduce background complexity on mobile for performance */
    .hero__grid-lines {
      background-size: 60px 60px;
    }
  }

  @media (max-width: 480px) {
    .hero__inner {
      padding-block: var(--space-lg) var(--space-sm);
    }

    .hero__layout {
      gap: var(--space-md);
    }

    .hero__title {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .hero__title br {
      display: none;
    }

    .hero__subtitle {
      font-size: 1rem;
      max-width: 100%;
    }

    .hero__capabilities {
      grid-template-columns: 1fr;
    }

    .hero__cap-title,
    .hero__cap-sub {
      white-space: normal;
    }

    .hero__phone {
      width: min(240px, calc(100vw - 6rem));
      height: auto;
      aspect-ratio: 1 / 2;
      max-height: 480px;
    }

    .hero__notif {
      padding: 8px 10px;
      gap: 8px;
    }

    .hero__notif-title {
      font-size: 0.75rem;
    }

    .hero__notif-text {
      font-size: 0.6875rem;
    }

    .hero__ctas .btn {
      width: 100%;
      max-width: none;
      text-align: center;
    }

    .hero__platform-btn span {
      display: none;
    }

    .hero__platform-btn {
      padding: 8px 10px;
      min-height: 40px;
      min-width: 40px;
      justify-content: center;
    }

    .hero__platform-btn svg {
      width: 16px;
      height: 16px;
    }

    .hero__stats-ticker {
      font-size: 0.5625rem;
      padding: 5px 8px;
    }

    .hero__stat-divider {
      margin: 0 6px;
    }

    /* Reduce grid lines on small screens for performance */
    .hero__grid-lines {
      display: none;
    }
  }

  /* Extra-small screens (320px) */
  @media (max-width: 360px) {
    .hero__phone {
      width: min(220px, calc(100vw - 5rem));
      max-height: 440px;
    }

    .hero__phone-notch {
      width: 80px;
      margin-bottom: 8px;
    }

    .hero__phone-time {
      font-size: 0.75rem;
      margin-bottom: 10px;
    }

    .hero__phone-header {
      padding: 0 2px 8px;
      margin-bottom: 8px;
    }

    .hero__notif {
      padding: 6px 8px;
      gap: 6px;
    }

    .hero__notif-icon {
      width: 24px;
      height: 24px;
      min-width: 24px;
      min-height: 24px;
      max-width: 24px;
      max-height: 24px;
    }

    .hero__notif-title {
      font-size: 0.6875rem;
    }

    .hero__notif-text {
      font-size: 0.625rem;
    }

    .hero__cube-stage {
      width: 48px;
      height: 48px;
    }

    .hero__cube {
      width: 48px;
      height: 48px;
    }

    .hero__cube-face {
      width: 48px;
      height: 48px;
      border-radius: 8px;
    }

    .hero__cube-face--front  { transform: rotateY(0deg)    translateZ(24px); }
    .hero__cube-face--right  { transform: rotateY(90deg)   translateZ(24px); }
    .hero__cube-face--back   { transform: rotateY(180deg)  translateZ(24px); }
    .hero__cube-face--left   { transform: rotateY(270deg)  translateZ(24px); }
    .hero__cube-face--top    { transform: rotateX(90deg)   translateZ(24px); }
    .hero__cube-face--bottom { transform: rotateX(-90deg)  translateZ(24px); }

    .hero__cube-face svg {
      width: 22px;
      height: 22px;
    }

    .hero__cap {
      padding: 0.625rem 0.75rem;
    }

    .hero__cap-icon {
      width: 30px;
      height: 30px;
    }

    .hero__cap-title {
      font-size: 0.75rem;
    }

    .hero__cap-sub {
      font-size: 0.625rem;
    }
  }

  /* Landscape mobile - short viewports */
  @media (max-height: 600px) and (orientation: landscape) {
    .hero {
      min-height: auto;
      padding-bottom: var(--space-md);
    }

    .hero__inner {
      padding-block: var(--space-md);
    }

    .hero__layout {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }

    .hero__phone {
      width: 180px;
      height: 360px;
    }

    .hero__title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }

    .hero__subtitle {
      font-size: 1rem;
      margin-top: var(--space-sm);
    }

    .hero__ctas {
      margin-top: var(--space-sm);
    }

    .hero__capabilities {
      margin-bottom: var(--space-sm);
      padding-top: var(--space-sm);
    }

    .hero__platforms {
      display: none;
    }

    .hero__grid-lines {
      display: none;
    }
  }

  /* ─── HERO INTRO SECTION ─── */
  .hero__intro {
    position: relative;
    width: 100%;
    min-height: calc(100vh - var(--nav-height));
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg) var(--space-lg) calc(var(--space-xl) + 48px);
  }

  .hero__integration-field {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: auto;
  }

  /* Soft dark pool behind the copy so it stays readable over the globe */
  .hero__intro-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse 420px 340px at 50% 47%,
      rgba(12, 14, 20, 0.8) 0%,
      rgba(12, 14, 20, 0.5) 55%,
      transparent 100%
    );
  }

  /* Framed glass panel — keeps the copy readable, and the drifting cubes
     bounce off this box instead of passing behind the letters */
  .hero__intro-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-lg) var(--space-xl);
    background: rgba(12, 14, 20, 0.62);
    border: 1px solid rgba(247, 244, 239, 0.09);
    border-radius: 28px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.35),
      0 0 60px rgba(78, 216, 194, 0.04),
      inset 0 1px 0 rgba(247, 244, 239, 0.06);
  }

  .hero__intro-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--reef-aqua);
    margin-bottom: var(--space-sm);
  }

  .hero__intro-headline {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--warm-white);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
  }

  /* Extend the clipped-background box so the last glyph (w) is never cut off
     by background-clip: text combined with negative letter-spacing */
  .hero__intro-headline :global(.gradient-text) {
    padding-right: 0.1em;
    margin-right: -0.1em;
  }

  .hero__intro-sub {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.72);
    max-width: 620px;
    margin: 0 0 var(--space-md);
  }

  /* Results grid — the "what's in it for me", right up front.
     Always 2x2: row one is the before/after story, row two the payoff. */
  .hero__intro-stats {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
    justify-items: center;
    gap: 14px 0;
    margin-bottom: 10px;
  }

  .hero__intro-stat:nth-child(3)::before {
    display: none;
  }

  .hero__intro-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 26px;
    position: relative;
  }

  .hero__intro-stat + .hero__intro-stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 60%;
    width: 1px;
    background: rgba(247, 244, 239, 0.12);
  }

  .hero__intro-stat-num {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--reef-aqua);
    text-shadow: 0 0 24px rgba(78, 216, 194, 0.35);
    white-space: nowrap;
  }

  /* The "before" number — washed out, so the DUSA number next to it pops */
  .hero__intro-stat--dim .hero__intro-stat-num {
    color: rgba(247, 244, 239, 0.35);
    text-shadow: none;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: rgba(247, 244, 239, 0.3);
  }

  .hero__intro-stat-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: rgba(247, 244, 239, 0.6);
    white-space: nowrap;
  }

  .hero__intro-statnote {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 244, 239, 0.35);
    margin: 0 0 var(--space-md);
  }

  .hero__intro-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .hero__intro-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 244, 239, 0.42);
    margin: 0;
  }

  .hero__intro-scroll {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 999px;
    background: rgba(12, 14, 20, 0.6);
    border: 1px solid rgba(247, 244, 239, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(247, 244, 239, 0.55);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .hero__intro-scroll:hover {
    color: var(--reef-aqua);
    border-color: rgba(78, 216, 194, 0.35);
  }

  .hero__intro-scroll svg {
    width: 18px;
    height: 18px;
    animation: introScrollBounce 2.2s ease-in-out infinite;
  }

  @keyframes introScrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* ── Sticky mobile CTA bar ── */
  .hero__sticky-cta {
    display: none;
  }

  @media (max-width: 768px) {
    .hero__sticky-cta {
      position: fixed;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      right: 84px; /* leave room for the chat launcher */
      z-index: 60;
      display: flex;
      gap: 8px;
      transform: translateY(140%);
      opacity: 0;
      transition: transform 0.35s ease, opacity 0.35s ease;
      pointer-events: none;
    }

    .hero__sticky-cta.is-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .hero__sticky-btn {
      flex: 1.4;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      border-radius: 999px;
      font-family: var(--font-headline);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--deep-black);
      background: linear-gradient(135deg, var(--reef-aqua), var(--mist-blue));
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35), 0 0 20px rgba(78, 216, 194, 0.25);
    }

    .hero__sticky-btn--ghost {
      flex: 1;
      color: var(--warm-white);
      background: rgba(12, 14, 20, 0.82);
      border: 1px solid rgba(247, 244, 239, 0.22);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
    }

    :global(html[data-theme="light"]) .hero__sticky-btn--ghost {
      color: var(--deep-black);
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(12, 14, 20, 0.18);
    }
  }

  @media (max-width: 768px) {
    .hero__intro {
      padding: var(--space-md) var(--space-sm) calc(var(--space-lg) + 44px);
    }

    .hero__intro-content {
      padding: var(--space-md) 14px;
      border-radius: 20px;
      width: 100%;
      max-width: 100%;
    }

    .hero__intro-headline {
      font-size: clamp(1.9rem, 8vw, 2.5rem);
    }

    .hero__intro-sub {
      font-size: 1rem;
      margin-bottom: 14px;
    }

    .hero__intro-stats {
      margin-bottom: 6px;
    }

    .hero__intro-statnote {
      margin-bottom: 14px;
    }

    .hero__intro-ctas {
      margin-bottom: 8px;
    }

    .hero__intro-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 0;
      width: 100%;
    }

    .hero__intro-stat {
      padding: 2px 6px;
      min-width: 0;
    }

    /* Labels must wrap on small screens — nowrap forces the whole
       panel wider than the viewport */
    .hero__intro-stat-label {
      white-space: normal;
      max-width: 150px;
      line-height: 1.35;
      text-align: center;
    }

    .hero__intro-stat-num {
      font-size: 1.55rem;
    }

    .hero__intro-note {
      max-width: 100%;
      letter-spacing: 0.05em;
      line-height: 1.6;
    }

    .hero__intro-stat {
      padding: 2px 14px;
    }

    /* Only vertical divider between columns, not rows */
    .hero__intro-stat:nth-child(3)::before {
      display: none;
    }

    .hero__intro-ctas {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .hero__intro-ctas .btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .hero {
    background: linear-gradient(180deg, #b8d8e8 0%, #d0e6ef 40%, #e4eff4 100%);
  }

  :global(html[data-theme="light"]) .hero__water {
    opacity: 1;
  }

  :global(html[data-theme="light"]) .hero__grid-lines {
    background-image:
      linear-gradient(rgba(12, 14, 20, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(12, 14, 20, 0.03) 1px, transparent 1px);
  }

  :global(html[data-theme="light"]) .hero__title {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .hero__subtitle {
    color: rgba(12, 14, 20, 0.55);
  }

  /* ── Light-mode phone: the device follows the site theme ── */
  :global(html[data-theme="light"]) .hero__phone {
    background: linear-gradient(165deg, #ffffff 0%, #eef2f5 100%);
    border-color: rgba(12, 14, 20, 0.14);
    box-shadow:
      0 0 0 1px rgba(12, 14, 20, 0.05),
      0 25px 80px rgba(12, 14, 20, 0.18),
      0 0 120px rgba(78, 216, 194, 0.08);
  }

  :global(html[data-theme="light"]) .hero__phone-notch {
    background: rgba(12, 14, 20, 0.18);
  }

  :global(html[data-theme="light"]) .hero__phone-time {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .hero__phone-app {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .hero__phone-header {
    border-bottom-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .hero__stats-ticker {
    background: rgba(26, 58, 92, 0.05);
    border-bottom-color: rgba(12, 14, 20, 0.05);
    color: rgba(12, 14, 20, 0.45);
  }

  :global(html[data-theme="light"]) .hero__stat-val {
    color: var(--deep-ocean);
  }

  /* Notification cards — dynamic elements carry inline colours,
     so text overrides need !important */
  :global(html[data-theme="light"]) .hero__phone :global(.hero__notif) {
    background: rgba(12, 14, 20, 0.045);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .hero__phone :global(.hero__notif-title) {
    color: #10141d !important;
