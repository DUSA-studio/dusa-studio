    slug: '/industries/construction',
    icon: 'M2 20h20M5 20V10l7-7 7 7v10M9 20v-6h6v6',
  },
  {
    title: 'Personal Trainers',
    desc: 'Lead magnet funnels, consultation booking, transformation showcases, and automated client check-ins.',
