---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IndustriesIndexPage from '../../../components/pages/IndustriesIndexPage.astro';
import { getRegion } from '../../../i18n/regions.js';
import t from '../../../i18n/translations/fi.json';
const region = getRegion('fi');
---

<BaseLayout t={t} title={t.industriesIndex.metaTitle} description={t.industriesIndex.metaDesc} lang={region.htmlLang} ogLocale={region.ogLocale} region="fi">
  <IndustriesIndexPage t={t} regionKey="fi" />
</BaseLayout>
