    /* ════════════════════════════════════════════════════════════════════
       The diorama. Clay-style: rounded boxes, soft shadows, flat colours.
       ════════════════════════════════════════════════════════════════════ */
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
