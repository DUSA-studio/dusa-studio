---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';

const painPoints = [
  {
    icon: 'M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Les prospects refroidissent pendant que vous etes sur le chantier',
    desc: 'Vous manquez des appels et des demandes parce que vous etes sur une echelle ou en reunion. Le temps de repondre, ils ont deja appele quelqu\'un d\'autre.',
  },
  {
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
    title: 'Devis envoyes mais jamais relances',
    desc: 'Vous passez du temps a preparer des devis detailles, puis vous oubliez de les relancer. Les chantiers vont au constructeur qui a relance en premier.',
  },
  {
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    title: 'Aucune communication sur les jalons du projet',
    desc: 'Les clients appellent pour demander des nouvelles parce qu\'il n\'y a aucun systeme pour les tenir informes. Cela vous fait perdre du temps et donne une image desorganisee.',
  },
  {
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Retards dans le recouvrement des paiements',
    desc: 'Les appels de fonds et les factures finales restent bloques parce qu\'il n\'y a pas de systeme de rappel automatise. La tresorerie en souffre pendant que vous relancez les paiements manuellement.',
  },
];

const features = [
  { title: 'Formulaires de capture de prospects', desc: 'Integrez des formulaires sur votre site web et vos reseaux sociaux qui vous notifient instantanement et ajoutent les prospects a votre pipeline. Plus aucune demande manquee.' },
  { title: 'Relances automatiques de devis', desc: 'Envoyez un devis et laissez le systeme relancer avec des rappels SMS et e-mail programmes. Arretez de perdre des chantiers a cause du silence.' },
  { title: 'Mises a jour des jalons du projet', desc: 'Notifiez automatiquement les clients lorsque vous atteignez des etapes cles. Fondations coulees, charpente montee, hors d\'eau, livraison. Les clients restent informes sans que vous ayez a decrocher le telephone.' },
  { title: 'Coordination des sous-traitants', desc: 'Tenez vos corps de metier au courant avec des notifications de planification automatisees et des mises a jour du projet. Moins de SMS, moins de demarrages rates.' },
  { title: 'Rappels de paiement', desc: 'Declenchez des rappels de facturation a chaque jalon. Les appels de fonds partent a temps, et les clients recoivent des relances en douceur avant tout retard.' },
  { title: 'Demandes d\'avis', desc: 'Apres la fin du projet, demandez automatiquement un avis Google aux clients satisfaits. Construisez votre reputation pendant que vous vous concentrez sur le prochain chantier.' },
];

const pipeline = [
  { stage: 'Prospect', desc: 'Nouvelle demande recue via formulaire, telephone ou recommandation' },
  { stage: 'Devis envoye', desc: 'Devis detaille prepare et transmis au client' },
  { stage: 'Approuve', desc: 'Le client accepte le devis et les travaux sont planifies' },
  { stage: 'En cours', desc: 'Chantier en cours avec des mises a jour de jalons envoyees automatiquement' },
  { stage: 'Reception provisoire', desc: 'Visite terminee, liste de reserves traitee' },
  { stage: 'Paiement final', desc: 'Facture finale envoyee avec relance automatique' },
];

const stats = [
  { value: '37%', label: 'des prospects du BTP refroidissent a cause de delais de reponse trop longs' },
  { value: '2.4x', label: 'plus rapide pour relancer les devis avec des rappels automatises' },
  { value: '89%', label: 'des clients preferent des mises a jour de jalons plutot que d\'avoir a appeler' },
];
---

<BaseLayout
  t={tData}
  title="CRM pour entreprises de construction | DUSA.studio"
  description="Arretez de perdre des prospects pendant que vous etes sur le chantier. DUSA offre aux entreprises de construction des relances de devis automatisees, des mises a jour de jalons et des rappels de paiement sur une seule plateforme."
>
  <!-- Hero -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Construction et BTP</span>
        <h1>Un CRM concu pour les <span class="gradient-text">entreprises de construction</span></h1>
        <p class="ind-hero__sub">
          Vous etes sur le chantier toute la journee. Vos prospects ne devraient pas avoir a attendre que vous rentriez chez vous pour avoir une reponse. DUSA automatise vos relances, tient vos clients informes a chaque jalon et s'assure qu'aucun devis ne reste sans suite.
        </p>
        <a href="/fr/start" class="btn btn--primary">Commencer</a>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ind-pain section--dark">
    <div class="container">
      <h2 class="ind-section-title">Ca vous parle ?</h2>
      <div class="ind-pain__grid">
        {painPoints.map((p) => (
          <div class="ind-pain__card">
            <div class="ind-pain__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </div>
            <h3 class="ind-pain__title">{p.title}</h3>
            <p class="ind-pain__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ind-solution section--dark">
    <div class="container">
      <h2 class="ind-section-title">Comment DUSA fonctionne pour la <span class="gradient-text">construction</span></h2>
      <p class="ind-solution__intro">Tout ce dont votre entreprise a besoin pour capter des prospects, conclure des devis et satisfaire vos clients de la premiere demande au paiement final.</p>
      <div class="ind-solution__grid">
        {features.map((f) => (
          <div class="ind-solution__item">
            <h3 class="ind-solution__item-title">{f.title}</h3>
            <p class="ind-solution__item-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ind-pipeline section--dark">
    <div class="container">
      <h2 class="ind-section-title">Votre pipeline construction</h2>
      <div class="ind-pipeline__track">
        {pipeline.map((p, i) => (
          <div class="ind-pipeline__stage">
            <div class="ind-pipeline__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ind-pipeline__stage-title">{p.stage}</h3>
            <p class="ind-pipeline__stage-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ind-stats section--dark">
    <div class="container">
      <div class="ind-stats__grid">
        {stats.map((s) => (
          <div class="ind-stats__item">
            <div class="ind-stats__value">{s.value}</div>
            <p class="ind-stats__label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Pret a arreter de perdre des prospects depuis le chantier ?</h2>
        <p class="ind-cta__desc">Configurez votre pipeline construction en moins d'une heure. Sans engagement, sans integration compliquee.</p>
        <div class="ind-cta__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/blog/crm-for-construction" class="ind-cta__link">Lire le guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://dusa.studio/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/fr/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Construction et BTP", "item": "https://dusa.studio/fr/industries/construction/" }
    ]
  })} />
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-lg);
  }

  /* ─── Section Titles ─── */
  .ind-section-title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* ─── Pain Points ─── */
  .ind-pain {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .ind-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }

  .ind-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-pain__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-sm);
  }

  .ind-pain__icon svg {
    width: 22px;
    height: 22px;
    color: var(--reef-aqua);
  }

  .ind-pain__title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-pain__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── Solution ─── */
  .ind-solution {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-solution__intro {
    text-align: center;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 560px;
    margin: calc(-1 * var(--space-md)) auto var(--space-xl);
    line-height: 1.65;
  }

  .ind-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .ind-solution__item {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast);
  }

  .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .ind-solution__item-title {
    font-family: var(--font-headline);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-solution__item-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.55);
  }

  /* ─── Pipeline ─── */
  .ind-pipeline {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-pipeline__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-md);
  }

  .ind-pipeline__stage {
    text-align: center;
    position: relative;
  }

  .ind-pipeline__stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.25rem;
    right: calc(-1 * var(--space-md) / 2);
    width: var(--space-md);
    height: 1px;
    background: rgba(78, 216, 194, 0.2);
  }

  .ind-pipeline__num {
    font-family: var(--font-mono, monospace);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--reef-aqua);
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }

  .ind-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.25rem;
  }

  .ind-pipeline__stage-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(247, 244, 239, 0.5);
  }

  /* ─── Stats ─── */
  .ind-stats {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .ind-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: center;
  }

  .ind-stats__item {
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .ind-stats__label {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-cta__desc {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .ind-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .ind-cta__link {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 500;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .ind-cta__link:hover {
    opacity: 0.75;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .ind-pain__grid {
      grid-template-columns: 1fr;
    }

    .ind-solution__grid {
      grid-template-columns: 1fr;
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(3, 1fr);
    }

    .ind-pipeline__stage:not(:last-child)::after {
      display: none;
    }

    .ind-stats__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }

    .ind-pipeline__track {
      grid-template-columns: repeat(2, 1fr);
    }

    .ind-pain__card,
    .ind-solution__item {
      padding: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-md);
    }
  }

  /* ─── Light Mode ─── */
  :global(html[data-theme="light"]) .ind-hero__content h1,
  :global(html[data-theme="light"]) .ind-section-title,
  :global(html[data-theme="light"]) .ind-pain__title,
  :global(html[data-theme="light"]) .ind-solution__item-title,
  :global(html[data-theme="light"]) .ind-pipeline__stage-title,
  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-hero__sub,
  :global(html[data-theme="light"]) .ind-pain__desc,
  :global(html[data-theme="light"]) .ind-solution__intro,
  :global(html[data-theme="light"]) .ind-solution__item-desc,
  :global(html[data-theme="light"]) .ind-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ind-stats__label,
  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .ind-pain__card,
  :global(html[data-theme="light"]) .ind-solution__item {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__card:hover,
  :global(html[data-theme="light"]) .ind-solution__item:hover {
    border-color: rgba(78, 216, 194, 0.35);
  }

  :global(html[data-theme="light"]) .ind-stats__item {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain,
  :global(html[data-theme="light"]) .ind-solution,
  :global(html[data-theme="light"]) .ind-pipeline,
  :global(html[data-theme="light"]) .ind-stats {
    border-top-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .ind-pain__icon {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-pain__icon svg {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-pipeline__num {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-stats__value {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__link {
    color: var(--deep-ocean);
  }
</style>
