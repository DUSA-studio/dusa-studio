---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';

const lang = 'es';
const region = 'es';

const title = 'CRM para Coaches y Consultores | DUSA.studio';
const description = 'Automatiza la captacion de leads, la incorporacion de clientes, la programacion de sesiones y las renovaciones de paquetes. DUSA es la plataforma de crecimiento todo en uno para coaches y consultores.';

const painPoints = [
  {
    icon: '📋',
    title: 'Mas administracion que coaching',
    desc: 'Te hiciste coach para ayudar a las personas, no para pasar la mitad de la semana entre facturas, agendas y correos de seguimiento.',
  },
  {
    icon: '📉',
    title: 'Flujo de leads inconsistente',
    desc: 'Algunos meses estan llenos. Otros, vacios. Sin un sistema, tu pipeline depende de referencias y de la suerte.',
  },
  {
    icon: '🚪',
    title: 'Sin sistema de incorporacion',
    desc: 'Cada nuevo cliente recibe una experiencia diferente. Formularios, correos de bienvenida y la preparacion de la primera sesion se hacen manualmente cada vez.',
  },
  {
    icon: '🗓️',
    title: 'Programacion manual de sesiones',
    desc: 'Correos de ida y vuelta para encontrar un horario. Recordatorios olvidados. Ausencias. Todo se traduce en ingresos perdidos y energia desperdiciada.',
  },
];

const features = [
  {
    title: 'Embudo de llamada de descubrimiento',
    desc: 'Una landing page, un formulario de reserva y una secuencia de confirmacion que convierte visitantes en llamadas de descubrimiento agendadas.',
  },
  {
    title: 'Secuencias de incorporacion',
    desc: 'Correos de bienvenida automatizados, formularios de ingreso, firma de contrato y preparacion de la primera sesion. Cada cliente recibe un inicio profesional y consistente.',
  },
  {
    title: 'Programacion y recordatorios de sesiones',
    desc: 'Los clientes reservan directamente desde tu calendario. Los recordatorios automaticos se envian 24 horas y 1 hora antes de cada sesion.',
  },
  {
    title: 'Seguimiento de progreso',
    desc: 'Etiqueta clientes por fase del programa, registra hitos y activa mensajes de seguimiento en los momentos clave.',
  },
  {
    title: 'Automatizacion de renovaciones',
    desc: 'Cuando un paquete de coaching esta por terminar, la comunicacion automatica comienza. Las conversaciones de renovacion arrancan sin que tengas que mover un dedo.',
  },
  {
    title: 'Recopilacion de testimonios',
    desc: 'Cuando termina un proceso de coaching, se solicitan testimonios y resenas automaticamente. Construye prueba social mientras la experiencia esta fresca.',
  },
];

const pipeline = [
  { stage: 'Llamada de descubrimiento', desc: 'El prospecto reserva y completa el formulario de ingreso' },
  { stage: 'Incorporado', desc: 'Contrato firmado, secuencia de bienvenida entregada' },
  { stage: 'Coaching activo', desc: 'Sesiones en curso, progreso registrado' },
  { stage: 'Renovacion de paquete', desc: 'Comunicacion automatica de renovacion al 80% de avance' },
  { stage: 'Alumni', desc: 'Testimonio recopilado, programa de referidos activado' },
  { stage: 'Referidos y Upsell', desc: 'Los clientes anteriores refieren nuevos leads y exploran programas avanzados. DUSA rastrea creditos de referidos y promueve ofertas premium.' },
];

const stats = [
  { value: '62%', label: 'de los coaches dice que el trabajo administrativo es su mayor consumidor de tiempo' },
  { value: '4x', label: 'mas llamadas de descubrimiento agendadas con un embudo automatizado' },
  { value: '35%', label: 'mayor tasa de renovacion con secuencias automatizadas de re-engagement' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://dusa.studio/es/' },
    { '@type': 'ListItem', position: 2, name: 'Industrias', item: 'https://dusa.studio/es/industries' },
    { '@type': 'ListItem', position: 3, name: 'Coaches y Consultores', item: 'https://dusa.studio/es/industries/coaches' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="co-hero section section--dark">
    <div class="container">
      <div class="co-hero__content">
        <span class="label">Coaches y Consultores</span>
        <h1>El <span class="gradient-text">CRM</span> que te permite enfocarte en el coaching</h1>
        <p class="co-hero__sub">
          Automatiza tu flujo de leads, incorporacion, agendamiento y renovaciones. Dedica tu tiempo a tus clientes, no a la administracion.
        </p>
        <div class="co-hero__actions">
          <a href="/es/start" class="btn btn--primary">Comenzar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="co-pain section section--dark">
    <div class="container">
      <div class="co-pain__header">
        <span class="label">El Problema</span>
        <h2>No empezaste a hacer coaching para <span class="gradient-text">hacer admin</span></h2>
        <p class="co-pain__intro">La mayoria de los coaches y consultores pierden horas cada semana en tareas que deberian estar automatizadas. Asi se ve eso.</p>
      </div>
      <div class="co-pain__grid">
        {painPoints.map((point) => (
          <div class="co-pain__card">
            <span class="co-pain__icon">{point.icon}</span>
            <h3 class="co-pain__card-title">{point.title}</h3>
            <p class="co-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="co-solution section section--dark">
    <div class="container">
      <div class="co-solution__header">
        <span class="label">La Solucion</span>
        <h2>Como funciona DUSA para <span class="gradient-text">coaches y consultores</span></h2>
        <p class="co-solution__intro">Una sola plataforma para gestionar todo el recorrido de tu cliente, desde el primer contacto hasta la referencia como alumni.</p>
      </div>
      <div class="co-solution__grid">
        {features.map((feature) => (
          <div class="co-solution__card">
            <h3 class="co-solution__card-title">{feature.title}</h3>
            <p class="co-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="co-pipeline section section--dark">
    <div class="container">
      <div class="co-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Tu <span class="gradient-text">pipeline de clientes</span> de un vistazo</h2>
      </div>
      <div class="co-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="co-pipeline__stage">
            <div class="co-pipeline__number">{i + 1}</div>
            <h3 class="co-pipeline__stage-title">{step.stage}</h3>
            <p class="co-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="co-stats section section--dark">
    <div class="container">
      <div class="co-stats__header">
        <span class="label">Impacto</span>
        <h2>Los numeros hablan <span class="gradient-text">por si solos</span></h2>
      </div>
      <div class="co-stats__grid">
        {stats.map((stat) => (
          <div class="co-stats__card">
            <span class="co-stats__value">{stat.value}</span>
            <p class="co-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="co-cta section section--dark">
    <div class="container">
      <div class="co-cta__box">
        <h2>Listo para <span class="gradient-text">hacer crecer tu practica</span>?</h2>
        <p class="co-cta__sub">Pon en marcha tu embudo de llamadas de descubrimiento, tus secuencias de incorporacion y la automatizacion de renovaciones en una sola plataforma.</p>
        <div class="co-cta__actions">
          <a href="/es/start" class="btn btn--primary">Comenzar</a>
          <a href="/blog/crm-for-coaches" class="btn btn--outline">Leer la guia</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .co-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .co-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .co-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .co-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .co-pain {
    padding: var(--space-2xl) 0;
  }
  .co-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .co-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .co-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .co-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .co-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .co-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .co-solution {
    padding: var(--space-2xl) 0;
  }
  .co-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .co-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .co-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .co-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .co-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .co-pipeline {
    padding: var(--space-2xl) 0;
  }
  .co-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .co-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .co-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .co-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .co-stats {
    padding: var(--space-2xl) 0;
  }
  .co-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .co-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .co-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .co-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .co-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .co-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .co-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .co-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .co-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .co-hero__content h1,
  :global(html[data-theme="light"]) .co-pain__header h2,
  :global(html[data-theme="light"]) .co-solution__header h2,
  :global(html[data-theme="light"]) .co-pipeline__header h2,
  :global(html[data-theme="light"]) .co-stats__header h2,
  :global(html[data-theme="light"]) .co-cta__box h2,
  :global(html[data-theme="light"]) .co-pain__card-title,
  :global(html[data-theme="light"]) .co-solution__card-title,
  :global(html[data-theme="light"]) .co-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .co-hero__sub,
  :global(html[data-theme="light"]) .co-pain__intro,
  :global(html[data-theme="light"]) .co-solution__intro,
  :global(html[data-theme="light"]) .co-pain__card-desc,
  :global(html[data-theme="light"]) .co-solution__card-desc,
  :global(html[data-theme="light"]) .co-pipeline__stage-desc,
  :global(html[data-theme="light"]) .co-stats__label,
  :global(html[data-theme="light"]) .co-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .co-pain__card,
  :global(html[data-theme="light"]) .co-solution__card,
  :global(html[data-theme="light"]) .co-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .co-pain__card:hover,
  :global(html[data-theme="light"]) .co-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .co-stats__card,
  :global(html[data-theme="light"]) .co-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .co-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .co-stats__value {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .co-pain__grid {
      grid-template-columns: 1fr;
    }
    .co-solution__grid {
      grid-template-columns: 1fr;
    }
    .co-stats__grid {
      grid-template-columns: 1fr;
    }
    .co-pipeline__stages {
      flex-direction: column;
    }
    .co-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .co-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
