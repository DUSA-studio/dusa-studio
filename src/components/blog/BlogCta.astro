---
// BlogCta.astro — end-of-post glass card: "Running a <industry> business?
// See what DUSA does for yours." Two actions (plan quiz, 30-minute call) and,
// when the post is about one industry, a link to that /industries page.
//
// Usage (inside BlogPostLayout, after the post body):
//   <BlogCta slug={slug} />                       industry derived from the slug
//   <BlogCta industry="salon" industryHref="/industries/salons" />
// Explicit props win over the slug lookup. Copy: Australian English, no em dashes.

interface Props {
  /** Plain industry label, e.g. "salon" or "real estate". Builds "Running a salon business?" */
  industry?: string;
  /** Link to the matching industry page, e.g. "/industries/salons". */
  industryHref?: string;
  /** Post slug; used to look up the industry when the props above are absent. */
  slug?: string;
  t?: Record<string, any>;
}
const { industry, industryHref, slug, t = {} } = Astro.props;
const s = t?.blogCta || {};

const BOOK_URL = 'https://link.dusa.studio/widget/bookings/dusa-demo';

// who: the phrase after "Running", name: plural for the industry link,
// ctx: the persona id used by the hero picker and plan quiz.
const BY_SLUG: Record<string, { who: string; name: string; href: string; ctx: string }> = {
  'crm-for-tradies': { who: 'a trades business', name: 'tradies', href: '/industries/tradies', ctx: 'tradies' },
  'crm-for-construction': { who: 'a construction business', name: 'construction', href: '/industries/construction', ctx: 'tradies' },
  'crm-for-cleaning-services': { who: 'a cleaning business', name: 'cleaning services', href: '/industries/cleaning-services', ctx: 'tradies' },
  'marketing-for-auto-repair': { who: 'an auto repair shop', name: 'auto repair', href: '/industries/auto-repair', ctx: 'tradies' },
  'crm-for-real-estate': { who: 'a real estate agency', name: 'real estate', href: '/industries/real-estate', ctx: 'real-estate' },
  'crm-for-property-managers': { who: 'a property management business', name: 'property managers', href: '/industries/property-managers', ctx: 'real-estate' },
  'salon-booking-automation': { who: 'a salon', name: 'salons', href: '/industries/salons', ctx: 'salons' },
  'dental-practice-marketing': { who: 'a dental practice', name: 'dentists', href: '/industries/dentists', ctx: 'clinics' },
  'marketing-automation-for-gyms': { who: 'a gym', name: 'gyms', href: '/industries/gyms', ctx: 'fitness' },
  'marketing-for-personal-trainers': { who: 'a personal training business', name: 'personal trainers', href: '/industries/personal-trainers', ctx: 'fitness' },
  'restaurant-customer-engagement': { who: 'a restaurant or cafe', name: 'restaurants', href: '/industries/restaurants', ctx: 'hospitality' },
  'crm-for-accountants': { who: 'an accounting practice', name: 'accountants', href: '/industries/accountants', ctx: 'other' },
  'crm-for-coaches': { who: 'a coaching business', name: 'coaches', href: '/industries/coaches', ctx: 'other' },
  'marketing-for-ecommerce': { who: 'an ecommerce store', name: 'ecommerce', href: '/industries/ecommerce', ctx: 'other' },
  'marketing-for-law-firms': { who: 'a law firm', name: 'law firms', href: '/industries/law-firms', ctx: 'other' },
  'photographer-client-management': { who: 'a photography business', name: 'photographers', href: '/industries/photographers', ctx: 'other' },
};

const hit = slug ? BY_SLUG[slug] : undefined;
const article = (w: string) => (/^[aeiou]/i.test(w) ? 'an' : 'a');
const who = industry
  ? `${article(industry)} ${industry} business`
  : (hit ? hit.who : (s.whoDefault || 'a business'));
const href = industryHref || (hit ? hit.href : '');
const linkName = industry || (hit ? hit.name : '');
const ctxId = hit && hit.ctx !== 'other' ? hit.ctx : '';
const bookHref = ctxId ? `${BOOK_URL}?industry=${encodeURIComponent(ctxId)}` : BOOK_URL;

const title = (s.titleTpl || 'Running {who}?').replace('{who}', who);
const titleAccent = s.titleAccent || 'See what DUSA does for yours.';
const body = s.body || 'One login for your leads, bookings, messages, reviews and payments, with AI that answers, follows up and books for you. Answer five quick questions and we will show you the plan that fits.';
const findPlan = s.findPlan || 'Find your plan';
const bookCall = s.bookCall || 'Book a 30-minute call';
const seeIndustry = (s.seeIndustryTpl || 'How DUSA works for {name}').replace('{name}', linkName);
---

<aside class="blog-cta" aria-labelledby="blog-cta-title" data-industry={ctxId || undefined}>
  <span class="blog-cta__glow" aria-hidden="true"></span>
  <h2 class="blog-cta__title" id="blog-cta-title">
    {title} <span class="gradient-text">{titleAccent}</span>
  </h2>
  <p class="blog-cta__body">{body}</p>
  <div class="blog-cta__btns">
    <a href="/#find-your-plan" class="btn btn--primary">{findPlan}</a>
    <a href={bookHref} target="_blank" rel="noopener noreferrer" class="btn btn--outline">{bookCall}</a>
  </div>
  {href && linkName && (
    <a class="blog-cta__link" href={href}>
      {seeIndustry}
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  )}
</aside>

<style>
  .blog-cta {
    position: relative;
    overflow: hidden;
    margin: var(--space-xl) 0 var(--space-lg);
    padding: var(--space-lg);
    border-radius: 24px;
    text-align: left;
    background: linear-gradient(160deg, rgba(26, 58, 92, 0.35), rgba(12, 14, 20, 0.6));
    border: 1px solid rgba(247, 244, 239, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(247, 244, 239, 0.08);
  }

  .blog-cta__glow {
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 140%;
    background: radial-gradient(circle, rgba(78, 216, 194, 0.16), transparent 65%);
    pointer-events: none;
  }

  .blog-cta > :not(.blog-cta__glow) {
    position: relative;
  }

  .blog-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--warm-white);
    margin: 0 0 var(--space-xs);
  }

  .blog-cta__body {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.72);
    margin: 0 0 var(--space-md);
    max-width: 600px;
  }

  .blog-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .blog-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--reef-aqua);
    text-decoration: none;
  }

  .blog-cta__link:hover,
  .blog-cta__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 560px) {
    .blog-cta { padding: var(--space-md) 18px; border-radius: 20px; }
    .blog-cta__btns .btn { width: 100%; white-space: normal; }
  }

  :global(html[data-theme="light"]) .blog-cta {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.78), rgba(228, 239, 244, 0.6));
    border-color: rgba(12, 14, 20, 0.08);
    box-shadow: 0 18px 50px rgba(12, 14, 20, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  :global(html[data-theme="light"]) .blog-cta__glow {
    background: radial-gradient(circle, rgba(106, 170, 207, 0.22), transparent 65%);
  }
  :global(html[data-theme="light"]) .blog-cta__title {
    color: var(--deep-black);
  }
  :global(html[data-theme="light"]) .blog-cta__body {
    color: rgba(12, 14, 20, 0.68);
  }
  :global(html[data-theme="light"]) .blog-cta__link {
    color: var(--deep-ocean);
  }
</style>
