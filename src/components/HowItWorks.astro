---
// HowItWorks.astro — Shift5-inspired numbered steps with per-row grid alignment
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;

const s = t?.howItWorks || {};
const hiwLabel = s.label || 'How It Works';
const hiwHeading = s.heading || 'Up and running';
const hiwHeadingAccent = s.headingAccent || 'in three steps.';
const hiwBookFreeDemo = s.bookFreeDemo || 'Book Your Free Demo';

const steps = [
  {
    num: '01',
    total: '03',
    title: s.step1Title || 'Book a Demo',
    desc: s.step1Desc || 'See the platform in action. We\'ll walk you through how DUSA fits your business. No pressure, no jargon.',
    label: s.step1Label || 'DEMO',
  },
  {
    num: '02',
    total: '03',
    title: s.step2Title || 'Get Set Up',
    desc: s.step2Desc || 'We handle the migration and setup. Your CRM, AI automations, and funnels, configured and ready to go within days.',
    label: s.step2Label || 'SETUP',
  },
  {
    num: '03',
    total: '03',
    title: s.step3Title || 'Start Growing',
    desc: s.step3Desc || 'Launch campaigns, capture leads, and let AI handle your follow-ups from day one. Watch your pipeline fill up.',
    label: s.step3Label || 'GROWTH',
  },
];
---

<section class="hiw section section--dark" id="how-it-works">
  <div class="container">
    <div class="hiw__header reveal">
      <span class="label">{hiwLabel}</span>
      <h2>{hiwHeading}<br/><span class="gradient-text">{hiwHeadingAccent}</span></h2>
    </div>

    <div class="hiw__grid">
      {steps.map((step, i) => (
        <>
          <div class="hiw__step reveal">
            <div class="hiw__step-counter">
              <span class="hiw__step-num">{step.num}</span>
              <span class="hiw__step-divider">/</span>
              <span class="hiw__step-total">{step.total}</span>
            </div>
            <div class="hiw__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>

          <div class={`hiw__node-cell hiw__node-cell--${i + 1} reveal-scale`} aria-hidden="true">
            <svg class="hiw__node-svg" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id={`glowGrad_${i}`}>
                  <stop offset="0%" stop-color="#4ED8C2" stop-opacity="0.2" />
                  <stop offset="60%" stop-color="#4ED8C2" stop-opacity="0.05" />
                  <stop offset="100%" stop-color="#4ED8C2" stop-opacity="0" />
                </radialGradient>
              </defs>

              {/* Ambient glow */}
              <circle class={`hiw__glow hiw__glow--${i + 1}`} cx="100" cy="95" r="98" fill={`url(#glowGrad_${i})`} opacity="0" />

              {/* Node rings */}
              <g class={`hiw__node hiw__node--${i + 1}`}>
                <circle cx="100" cy="95" r="76" stroke="rgba(78,216,194,0.2)" stroke-width="1" fill="none" stroke-dasharray="6 6" />
                <circle cx="100" cy="95" r="56" stroke="rgba(78,216,194,0.35)" stroke-width="1.5" fill="rgba(78,216,194,0.04)" />
                <circle cx="100" cy="95" r="40" stroke="#4ED8C2" stroke-width="2" fill="rgba(12,14,20,0.9)" />

                {/* Icon for each step */}
                {i === 0 && (
                  <g class="hiw__icon" transform="translate(76, 71) scale(2)" stroke="#4ED8C2" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" fill="none">
                    <rect x="1" y="3" width="22" height="18" rx="2" />
                    <path d="M1 9h22" />
                    <path d="M7 1v4" />
                    <path d="M17 1v4" />
                    <circle cx="12" cy="15" r="2" fill="#4ED8C2" opacity="0.4" />
                  </g>
                )}
                {i === 1 && (
                  <g class="hiw__icon" transform="translate(76, 71) scale(2)" stroke="#4ED8C2" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" fill="none">
                    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
                    <circle cx="12" cy="12" r="4" />
                  </g>
                )}
                {i === 2 && (
                  <g class="hiw__icon" transform="translate(76, 71) scale(2)" stroke="#4ED8C2" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" fill="none">
                    <path d="M3 20V4" />
                    <path d="M3 20h18" />
                    <path d="M7 14l4-4 3 3 5-7" />
                    <path d="M15 6h4v4" />
                  </g>
                )}

                <text x="100" y="195" text-anchor="middle" fill="rgba(247,244,239,0.5)" font-size="12" font-family="monospace" letter-spacing="0.12em" font-weight="500">{step.label}</text>
              </g>
            </svg>

            {/* Dashed connection line to next node */}
            {i < 2 && <div class="hiw__connector" />}
          </div>
        </>
      ))}

      <div class="hiw__cta reveal" style="margin-top: var(--space-xl);">
        <a href="#contact" class="btn btn--primary">{hiwBookFreeDemo}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hiw__header {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  /* ─── GRID: each step + node in same row ─── */
  .hiw__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-xl);
    align-items: center;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  .hiw__step {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
    align-items: start;
    transition: all var(--duration-normal) var(--ease-out);
    position: relative;
  }

  .hiw__step::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--reef-aqua), transparent);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .hiw__step:hover::before {
    width: 120px;
  }

  .hiw__step:last-of-type {
    border-bottom: 1px solid rgba(247, 244, 239, 0.06);
  }

  .hiw__step-counter {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-mono);
    padding-top: 0.25rem;
  }

  .hiw__step-num {
    font-size: 2rem;
    font-weight: 700;
    color: var(--reef-aqua);
    line-height: 1;
    font-family: var(--font-headline);
    text-shadow: 0 0 20px rgba(78, 216, 194, 0.2);
  }

  .hiw__step-divider {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.2);
  }

  .hiw__step-total {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.25);
  }

  .hiw__step-content {
    min-width: 0;
  }

  .hiw__step-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--warm-white);
  }

  .hiw__step-content p {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.7;
    max-width: 500px;
    overflow-wrap: break-word;
  }

  /* ─── NODE CELLS ─── */
  .hiw__node-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hiw__node-svg {
    width: 200px;
    height: auto;
  }

  /* ─── CONNECTOR LINES ─── */
  .hiw__connector {
    width: 2px;
    height: 40px;
    background: repeating-linear-gradient(
      to bottom,
      rgba(78, 216, 194, 0.3) 0px,
      rgba(78, 216, 194, 0.3) 6px,
      transparent 6px,
      transparent 12px
    );
    margin: -8px auto 0;
    position: relative;
  }

  /* ─── CTA ─── */
  .hiw__cta {
    grid-column: 1 / -1;
    text-align: center;
  }

  /* ─── NODE ANIMATIONS ─── */

  /* Outer dashed ring rotates slowly */
  .hiw__node circle:first-child {
    animation: hiwRingSpin 30s linear infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  .hiw__node--2 circle:first-child { animation-direction: reverse; }

  @keyframes hiwRingSpin {
    to { transform: rotate(360deg); }
  }

  /* Middle ring pulse */
  .hiw__node circle:nth-child(2) {
    animation: hiwRingPulse 3s ease-in-out infinite;
  }

  .hiw__node--2 circle:nth-child(2) { animation-delay: 1s; }
  .hiw__node--3 circle:nth-child(2) { animation-delay: 2s; }

  @keyframes hiwRingPulse {
    0%, 100% { stroke-opacity: 0.35; }
    50% { stroke-opacity: 0.7; }
  }

  /* Glow fade */
  .hiw__glow {
    animation: hiwGlow 5s ease-in-out infinite;
  }

  .hiw__glow--2 { animation-delay: 1.7s; }
  .hiw__glow--3 { animation-delay: 3.3s; }

  @keyframes hiwGlow {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .hiw__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 0 var(--space-lg);
    }

    .hiw__node-svg {
      width: 170px;
    }

    .hiw__step {
      grid-template-columns: 80px 1fr;
    }
  }

  @media (max-width: 768px) {
    .hiw__header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: var(--space-lg);
    }

    .hiw__grid {
      grid-template-columns: 1fr;
    }

    .hiw__node-cell {
      display: none;
    }

    .hiw__step {
      grid-template-columns: 80px 1fr;
      gap: var(--space-sm);
    }

    .hiw__step-num {
      font-size: 1.5rem;
    }

    .hiw__step-content h3 {
      font-size: 1.25rem;
    }

    .hiw__cta {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hiw__step {
      grid-template-columns: 68px 1fr;
      gap: 0.75rem;
      padding: var(--space-md) 0;
    }

    .hiw__step-num {
      font-size: 1.25rem;
    }

    .hiw__step-content h3 {
      font-size: 1.125rem;
    }

    .hiw__step-content p {
      font-size: 0.9375rem;
    }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .hiw__step {
    border-top-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .hiw__step:last-of-type {
    border-bottom-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .hiw__step-num {
    color: var(--deep-ocean);
    text-shadow: none;
  }

  :global(html[data-theme="light"]) .hiw__step-divider {
    color: rgba(12, 14, 20, 0.2);
  }

  :global(html[data-theme="light"]) .hiw__step-total {
    color: rgba(12, 14, 20, 0.25);
  }

  :global(html[data-theme="light"]) .hiw__step-content h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .hiw__step-content p {
    color: rgba(12, 14, 20, 0.55);
  }

  /* Light mode: Node rings */
  :global(html[data-theme="light"]) .hiw__node circle:first-child {
    stroke: rgba(26, 58, 92, 0.2);
  }

  :global(html[data-theme="light"]) .hiw__node circle:nth-child(2) {
    stroke: rgba(26, 58, 92, 0.3);
    fill: rgba(26, 58, 92, 0.04);
  }

  :global(html[data-theme="light"]) .hiw__node circle:nth-child(3) {
    stroke: var(--deep-ocean);
    fill: rgba(237, 233, 227, 0.95);
  }

  :global(html[data-theme="light"]) .hiw__icon {
    stroke: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .hiw__icon circle {
    fill: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .hiw__node text {
    fill: rgba(12, 14, 20, 0.45);
  }

  :global(html[data-theme="light"]) .hiw__glow {
    fill: rgba(106, 170, 207, 0.08);
  }

  :global(html[data-theme="light"]) .hiw__connector {
    background: repeating-linear-gradient(
      to bottom,
      rgba(26, 58, 92, 0.25) 0px,
      rgba(26, 58, 92, 0.25) 6px,
      transparent 6px,
      transparent 12px
    );
  }

  :global(html[data-theme="light"]) .hiw__step::before {
    background: linear-gradient(90deg, var(--deep-ocean), transparent);
  }
</style>
