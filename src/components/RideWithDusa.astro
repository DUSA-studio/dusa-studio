---
/**
 * RideWithDusa.astro (v2)
 *
 * The package builder as a short ride across town. A top-down night city
 * (think the old GTA view, kept very simple) with the DUSA car driving its
 * route, and a messages-app chat with your driver. Every answer moves the car
 * a block further; when you get home, the fare is your quote, priced from the
 * catalogue (src/data/catalogue-au.json).
 *
 * You can tap the quick replies or type with your keyboard; typed answers are
 * matched to the closest option.
 */
import catalogue from '../data/catalogue-au.json';
interface Props { webhook?: string; book?: string; growthLead?: string; phone?: string }
const {
  webhook = '',
  book = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  growthLead = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  phone = '+61 488 825 686',
} = Astro.props;
---

<section class="ride section section--dark" data-ride data-webhook={webhook} data-book={book} data-lead={growthLead} data-phone={phone}>
  <div class="container">
    <div class="ride__head">
      <span class="label">Build your engine</span>
      <h2 class="ride__h2">Need a lift? <span class="gradient-text">Hop in.</span></h2>
      <p class="ride__sub">Two minutes with your driver. Your quote is waiting when you get home.</p>
    </div>

    <div class="ride__stage" data-stage>
      <svg class="ride__map" data-map aria-hidden="true">
        <defs>
          <radialGradient id="mLamp" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffe2a8" stop-opacity=".45"/><stop offset="1" stop-color="#ffe2a8" stop-opacity="0"/></radialGradient>
          <radialGradient id="mHome" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffd59a" stop-opacity=".55"/><stop offset="1" stop-color="#ffd59a" stop-opacity="0"/></radialGradient>
          <radialGradient id="mSign" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#4ed8c2" stop-opacity=".8"/><stop offset="1" stop-color="#4ed8c2" stop-opacity="0"/></radialGradient>
          <linearGradient id="mBeam" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#fff6d8" stop-opacity=".5"/><stop offset="1" stop-color="#fff6d8" stop-opacity="0"/></linearGradient>
          <linearGradient id="mCar" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#16324f"/><stop offset=".5" stop-color="#2a5a8a"/><stop offset="1" stop-color="#16324f"/></linearGradient>
        </defs>
        <g data-world>
          <rect x="-400" y="-400" width="2200" height="2200" fill="#0b1220"/>
          <g data-city></g>
          <path data-route d="" fill="none" stroke="#4ed8c2" stroke-width="5" stroke-dasharray="2 16" stroke-linecap="round" opacity=".55"/>
          <g data-pickup>
            <circle r="34" fill="url(#mLamp)"/>
            <circle r="13" fill="#0f2440" stroke="#4ed8c2" stroke-width="3"/>
            <path d="M-13 0 H13 M0 -13 V13 M-9 -9 L9 9 M-9 9 L9 -9" stroke="#4ed8c2" stroke-width="1.4" opacity=".7"/>
            <circle r="4" fill="#d9a98a"/>
          </g>
          <g data-home>
            <circle r="90" fill="url(#mHome)"/>
            <rect x="-34" y="-30" width="68" height="60" rx="4" fill="#1a3a5c"/>
            <path d="M-34 -30 L0 0 L34 -30 Z M-34 30 L0 0 L34 30 Z" fill="#24507d"/>
            <path d="M-34 -30 L0 0 L-34 30 Z M34 -30 L0 0 L34 30 Z" fill="#1f4672"/>
            <rect x="-6" y="30" width="12" height="18" fill="#4ed8c2" opacity=".85"/>
          </g>
          <g data-car>
            <polygon points="-11,-26 11,-26 34,-120 -34,-120" fill="url(#mBeam)"/>
            <circle r="30" fill="url(#mSign)" opacity=".6"/>
            <rect x="-12" y="-23" width="24" height="46" rx="8" fill="url(#mCar)" stroke="#0a1626" stroke-width="1.5"/>
            <rect x="-9" y="-14" width="18" height="9" rx="3" fill="#0c1726"/>
            <rect x="-9" y="9" width="18" height="7" rx="3" fill="#0c1726"/>
            <rect x="-7" y="-3" width="14" height="6" rx="2" fill="#4ed8c2"/>
            <rect x="-10" y="-25" width="5" height="3" rx="1.5" fill="#fff6d8"/><rect x="5" y="-25" width="5" height="3" rx="1.5" fill="#fff6d8"/>
            <rect x="-10" y="22" width="5" height="3" rx="1.5" fill="#ff5a5a"/><rect x="5" y="22" width="5" height="3" rx="1.5" fill="#ff5a5a"/>
          </g>
        </g>
      </svg>
      <div class="ride__rain" aria-hidden="true"></div>
      <div class="ride__vignette" aria-hidden="true"></div>

      <div class="ride__app" data-app>
        <header class="ride__bar">
          <span class="ride__avatar"><img src="/lotus.svg" alt="" width="18" height="18" /></span>
          <span class="ride__bar-who"><b>Your DUSA driver</b><small data-status>Pulling up</small></span>
          <span class="ride__meter" data-meter hidden><small>Meter</small><b data-meter-val>$0</b></span>
        </header>
        <div class="ride__msgs" data-msgs aria-live="polite"></div>
        <div class="ride__quick" data-quick></div>
        <form class="ride__compose" data-compose>
          <input class="ride__input" data-input type="text" placeholder="Message your driver" autocomplete="off" aria-label="Message your driver" />
          <button class="ride__send" type="submit" aria-label="Send"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
      </div>
    </div>

    <script type="application/json" data-catalogue set:html={JSON.stringify(catalogue)} />
  </div>
</section>

<style>
  .ride { position: relative; }
  .ride__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-lg); }
  .ride__h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.1; margin: 0.6rem 0; color: var(--warm-white); }
  .ride__sub { color: rgba(247, 244, 239, 0.66); margin: 0 auto; }

  .ride__stage { position: relative; max-width: 1180px; margin: 0 auto; aspect-ratio: 16 / 10; border-radius: 28px; overflow: hidden; background: #0b1220; border: 1px solid rgba(247, 244, 239, 0.1); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4); }
  .ride__map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ride__rain { position: absolute; inset: 0; pointer-events: none; opacity: 0.35; background-image: repeating-linear-gradient(105deg, transparent 0 22px, rgba(190, 215, 240, 0.18) 22px 23px, transparent 23px 47px); background-size: 200% 200%; animation: rideRain 0.9s linear infinite; }
  @keyframes rideRain { to { background-position: -60px 140px; } }
  .ride__vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 35% 50%, transparent 40%, rgba(5, 8, 14, 0.65) 100%); }

  /* The phone: a messages app */
  .ride__app { position: absolute; top: 16px; right: 16px; bottom: 16px; width: min(380px, 44%); display: flex; flex-direction: column; border-radius: 26px; overflow: hidden; background: rgba(10, 16, 28, 0.78); backdrop-filter: blur(22px) saturate(150%); -webkit-backdrop-filter: blur(22px) saturate(150%); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.2), 0 24px 60px rgba(0, 0, 0, 0.5); color: #fff; }
  .ride__bar { display: flex; align-items: center; gap: 0.6rem; padding: 12px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .ride__avatar { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(160deg, #1f4472, #0f2440); box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.45); }
  .ride__avatar img { filter: invert(78%) sepia(30%) saturate(600%) hue-rotate(115deg); }
  .ride__bar-who b { display: block; font-size: 0.88rem; }
  .ride__bar-who small { display: block; font-size: 0.72rem; color: var(--reef-aqua); }
  .ride__meter { margin-left: auto; text-align: right; line-height: 1.1; }
  .ride__meter[hidden] { display: none; }
  .ride__meter small { display: block; font-size: 0.62rem; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; letter-spacing: 0.08em; }
  .ride__meter b { font-family: var(--font-headline); font-size: 1.05rem; color: var(--reef-aqua); font-variant-numeric: tabular-nums; }
  .ride__msgs { flex: 1; overflow-y: auto; padding: 14px 12px 6px; display: flex; flex-direction: column; gap: 6px; scroll-behavior: smooth; }
  :global(.ride__msg) { max-width: 82%; padding: 9px 13px; border-radius: 18px; font-size: 0.92rem; line-height: 1.35; animation: rideMsg 0.3s ease; }
  :global(.ride__msg--them) { align-self: flex-start; background: rgba(255, 255, 255, 0.1); border-bottom-left-radius: 6px; }
  :global(.ride__msg--me) { align-self: flex-end; background: linear-gradient(135deg, #4ed8c2, #3fb9a7); color: #06231e; border-bottom-right-radius: 6px; }
  :global(.ride__msg--typing) { display: inline-flex; gap: 4px; padding: 12px 14px; }
  :global(.ride__msg--typing i) { width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, 0.6); animation: rideDot 1s infinite; }
  :global(.ride__msg--typing i:nth-child(2)) { animation-delay: 0.15s; }
  :global(.ride__msg--typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes rideDot { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  @keyframes rideMsg { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  /* Proof card: three things that help */
  :global(.ride__card) { align-self: stretch; max-width: none; padding: 12px; border-radius: 16px; background: rgba(78, 216, 194, 0.08); box-shadow: inset 0 0 0 0.5px rgba(78, 216, 194, 0.4); animation: rideMsg 0.3s ease; }
  :global(.ride__card ol) { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; counter-reset: c; }
  :global(.ride__card li) { display: grid; grid-template-columns: 22px 1fr; gap: 8px; font-size: 0.88rem; line-height: 1.3; counter-increment: c; }
  :global(.ride__card li::before) { content: counter(c); width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 0.72rem; font-weight: 700; background: var(--reef-aqua); color: #06231e; }
  :global(.ride__card em) { display: block; font-style: normal; font-size: 0.7rem; color: var(--reef-aqua); margin-top: 2px; }
  /* Fare: a receipt in the chat */
  :global(.ride__fare) { align-self: stretch; max-width: none; padding: 14px 14px 12px; border-radius: 16px; background: #f7f4ef; color: #0c0e14; animation: rideMsg 0.4s ease; }
  :global(.ride__fare h4) { margin: 0; font-size: 0.7rem; letter-spacing: 0.2em; color: #1a3a5c; display: flex; justify-content: space-between; border-bottom: 2px dashed rgba(12, 14, 20, 0.18); padding-bottom: 6px; }
  :global(.ride__fare h4 span) { letter-spacing: 0.04em; font-weight: 500; color: rgba(12, 14, 20, 0.5); }
  :global(.ride__fare p) { margin: 6px 0 8px; font-size: 0.78rem; color: rgba(12, 14, 20, 0.6); }
  :global(.ride__fare ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 0.8rem; }
  :global(.ride__fare li) { display: flex; justify-content: space-between; gap: 8px; }
  :global(.ride__fare li.is-save) { color: #0f6b5c; }
  :global(.ride__fare .t) { display: flex; justify-content: space-between; align-items: baseline; margin-top: 8px; padding-top: 6px; border-top: 2px dashed rgba(12, 14, 20, 0.18); }
  :global(.ride__fare .t b) { font-family: var(--font-headline); font-size: 1.35rem; color: #1a3a5c; }
  :global(.ride__fare .s) { display: flex; justify-content: space-between; font-size: 0.82rem; margin-top: 2px; }
  :global(.ride__fare small) { display: block; margin-top: 8px; font-size: 0.68rem; color: rgba(12, 14, 20, 0.55); }
  :global(.ride__fare small b) { display: block; color: #1a3a5c; margin-top: 2px; }
  /* Quick replies and the keyboard */
  .ride__quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 6px 12px 4px; justify-content: flex-end; }
  .ride__quick:empty { display: none; }
  :global(.ride__chip) { appearance: none; border: 0; cursor: pointer; font: inherit; font-size: 0.84rem; color: #fff; padding: 7px 12px; border-radius: 100px; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.55); transition: background 0.15s, transform 0.12s; animation: rideMsg 0.25s ease backwards; }
  :global(.ride__chip:hover) { background: rgba(78, 216, 194, 0.18); }
  :global(.ride__chip:active) { transform: scale(0.96); }
  :global(.ride__chip.is-on) { background: rgba(78, 216, 194, 0.32); }
  :global(.ride__chip--go) { background: linear-gradient(135deg, #4ed8c2, #6aaacf); color: #06231e; font-weight: 600; box-shadow: none; }
  :global(.ride__chip--ghost) { box-shadow: none; color: rgba(255, 255, 255, 0.65); text-decoration: underline; text-underline-offset: 3px; background: none; }
  :global(.ride__chip em) { font-style: normal; font-size: 0.64rem; font-weight: 700; margin-left: 5px; padding: 1px 6px; border-radius: 100px; background: var(--reef-aqua); color: #06231e; white-space: nowrap; }
  .ride__compose { display: flex; gap: 8px; padding: 8px 10px 12px; }
  .ride__input { flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; color: #fff; padding: 10px 14px; border-radius: 100px; border: 0; outline: none; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.25); }
  .ride__input:focus { box-shadow: inset 0 0 0 1.5px var(--reef-aqua); }
  .ride__input::placeholder { color: rgba(255, 255, 255, 0.4); }
  .ride__send { width: 40px; height: 40px; flex: none; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; background: var(--reef-aqua); color: #06231e; }
  .ride__send:focus-visible, :global(.ride__chip:focus-visible) { outline: 2px solid #fff; outline-offset: 2px; }

  @media (max-width: 760px) {
    .ride__stage { aspect-ratio: auto; height: min(100svh, 820px); width: 100vw; margin-left: calc(50% - 50vw); border-radius: 0; border: 0; }
    .ride__app { top: 34%; left: 0; right: 0; bottom: 0; width: auto; border-radius: 22px 22px 0 0; }
    .ride__vignette { background: linear-gradient(180deg, rgba(5, 8, 14, 0.5) 0%, transparent 25%, transparent 70%, rgba(5, 8, 14, 0.6) 100%); }
    .ride__input { font-size: 16px; }
    .ride__compose { padding-right: 74px; }
  }
  @media (prefers-reduced-motion: reduce) { .ride__rain { animation: none; } }
  :global(html[data-theme="light"]) .ride__h2 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ride__sub { color: rgba(12, 14, 20, 0.66); }
</style>

<script>
  type Item = { service: string; size: string; incl: string; setup: number; monthly: number; guided: number | null };
  type Cat = { plans: { launchpad: number; starter: number; growth: number }; bundleDiscount: number; setupDiscount: number; items: Record<string, Item> };

  document.querySelectorAll<HTMLElement>('[data-ride]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cat = JSON.parse(root.querySelector('[data-catalogue]')!.textContent || '{}') as Cat;
    const msgs = root.querySelector<HTMLElement>('[data-msgs]')!;
    const quick = root.querySelector<HTMLElement>('[data-quick]')!;
    const form = root.querySelector<HTMLFormElement>('[data-compose]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const meter = root.querySelector<HTMLElement>('[data-meter]')!;
    const meterVal = root.querySelector<HTMLElement>('[data-meter-val]')!;
    const PHONE = root.dataset.phone || '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const money = (n: number) => (n < 0 ? '-$' : '$') + Math.abs(Math.round(n)).toLocaleString('en-AU');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 120) : ms));

    const lead: Record<string, any> = { name: '', business: '', industry: '', industryText: '', needs: [] as string[], seat: '', distance: '', email: '', phone: '', callOk: null };

    /* ══ What we say, kept short ══ */
    // id, label, keywords, plural, top three (need id + outcome)
    const INDUSTRIES: { id: string; label: string; kw: string[]; plural: string; top: [string, string][] }[] = [
      { id: 'trades', label: 'Trades', kw: ['trade', 'tradie', 'roof', 'plumb', 'electr', 'build', 'carpent', 'landscap', 'paint', 'tile', 'concret', 'construct', 'hvac', 'air con'], plural: 'tradies', top: [['calls', 'More time back'], ['followup', 'More profit'], ['reviews', 'Easier to win work']] },
      { id: 'beauty', label: 'Hair, beauty, spa', kw: ['hair', 'salon', 'beauty', 'spa', 'nail', 'lash', 'brow', 'inject', 'massage', 'barber', 'skin', 'clinic'], plural: 'salons and studios', top: [['comeback', 'More profit'], ['calls', 'More time back'], ['reviews', 'Easier to fill the book']] },
      { id: 'fitness', label: 'Health and fitness', kw: ['gym', 'fitness', 'trainer', ' pt', 'pilates', 'yoga', 'physio', 'chiro', 'health', 'crossfit'], plural: 'gyms and studios', top: [['followup', 'More profit'], ['comeback', 'Members who stay'], ['reviews', 'Easier to grow']] },
      { id: 'hospo', label: 'Café or restaurant', kw: ['cafe', 'café', 'restaurant', 'bar', 'food', 'coffee', 'bakery', 'hospo', 'catering'], plural: 'cafés and restaurants', top: [['reviews', 'More bookings'], ['comeback', 'More profit'], ['socials', 'Less to manage']] },
      { id: 'pro', label: 'Professional services', kw: ['account', 'law', 'legal', 'consult', 'bookkeep', 'agency', 'coach', 'finance', 'broker', 'advis'], plural: 'firms like yours', top: [['followup', 'More profit'], ['calls', 'More time back'], ['google', 'Easier to be found']] },
      { id: 'property', label: 'Real estate', kw: ['real estate', 'property', 'realtor', 'agent', 'rental'], plural: 'agents', top: [['followup', 'More listings'], ['calls', 'More time back'], ['comeback', 'More referrals']] },
      { id: 'retail', label: 'A shop', kw: ['shop', 'store', 'retail', 'ecommerce', 'e-commerce', 'boutique', 'online'], plural: 'shops like yours', top: [['comeback', 'More profit'], ['reviews', 'More trust'], ['socials', 'Less to manage']] },
      { id: 'other', label: 'Something else', kw: [], plural: 'businesses like yours', top: [['calls', 'More time back'], ['followup', 'More profit'], ['reviews', 'Less to manage']] },
    ];
    // need id, how it reads, catalogue codes
    const NEEDS: Record<string, { text: string; codes: string[]; short: string }> = {
      calls: { text: 'Every call answered, even mid-job', codes: ['AIR'], short: 'Never miss a call' },
      followup: { text: 'Every quote followed up for you', codes: ['FUP'], short: 'Follow up every quote' },
      reviews: { text: '5-star reviews on autopilot', codes: ['REV'], short: 'More 5-star reviews' },
      comeback: { text: 'Return business, no chasing', codes: ['DBR', 'EML'], short: 'Get return business' },
      google: { text: 'Found first on Google', codes: ['GBP', 'SEO'], short: 'Get found on Google' },
      newleads: { text: 'Ads that bring new enquiries', codes: ['GAD', 'MAD'], short: 'More new enquiries' },
      socials: { text: 'Socials posted for you', codes: ['SOC'], short: 'Socials done for me' },
      website: { text: 'A website that books work', codes: ['WEB'], short: 'A better website' },
    };
    const SEATS = [
      { id: 'back', label: "You drive, I'll sit back", tag: 'Best value', kw: ['back', 'you drive', 'done for', 'all of it'], reply: "Sit back then. I'll report in once a month." },
      { id: 'front', label: "You drive, I'll navigate", kw: ['navigat', 'front', 'approve', 'control'], reply: "Up front with me. You approve every turn." },
      { id: 'copilot', label: "I'll drive, you help", kw: ['help', 'support', 'ride', 'i drive', "i'll drive", 'shotgun'], reply: "You drive, I'll ride shotgun." },
      { id: 'self', label: 'Just the keys', kw: ['key', 'myself', 'diy', 'self', 'platform', 'software'], reply: "Keys are yours. Call me any time." },
    ];
    const DIST = [
      { id: 'S', label: 'Around the corner', kw: ['corner', 'small', 'basic', 'start', 'light'] },
      { id: 'M', label: 'Across town', kw: ['town', 'medium', 'steady', 'grow', 'mid'] },
      { id: 'L', label: 'The long haul', kw: ['long', 'haul', 'all', 'big', 'full', 'large', 'scale'] },
    ];
    const SEAT_NAME: Record<string, string> = { self: 'Self-drive', copilot: 'Co-pilot', back: 'Back seat', front: 'Front seat' };
    const PLAIN: Record<string, string> = {
      AIR: 'Every call answered', FUP: 'Every quote followed up', REV: '5-star reviews', GBP: 'Google Maps', SEO: 'Google search',
      DBR: 'Return business campaign', EML: 'Emails and texts to customers', GAD: 'Google Ads', MAD: 'Facebook and Instagram ads',
      SOC: 'Social media', WEB: 'Website', GRM: 'Monthly report and check-in', SUP: 'Help hours each month',
    };
    const SIZE: Record<string, string> = { S: 'Light', M: 'Steady', L: 'Full' };
    const matchOpt = <T extends { kw: string[] }>(text: string, opts: T[]) => { const t = ` ${text.toLowerCase()} `; return opts.find((o) => o.kw.some((k) => t.includes(k))); };

    /* ══ Price, from the catalogue ══ */
    const codesFor = (): string[] => {
      const d = lead.distance || 'S';
      const needs: string[] = lead.needs.length ? lead.needs : ['calls', 'followup'];
      const out: string[] = [];
      needs.forEach((n) => NEEDS[n]?.codes.forEach((c, k) => { if (k > 0 && d !== 'L') return; out.push(`${c}-${d}`); }));
      if (needs.includes('calls') && !needs.includes('followup')) out.push(`FUP-${d}`);
      return [...new Set(out)].filter((c) => cat.items[c]);
    };
    const quote = () => {
      const seat = lead.seat || 'back', d = lead.distance || 'S';
      const lines: { label: string; price: number; save?: boolean; oneoff?: number }[] = [];
      if (seat === 'self') {
        const [n, p] = d === 'S' ? ['Launchpad', cat.plans.launchpad] : d === 'M' ? ['Starter', cat.plans.starter] : ['Growth', cat.plans.growth];
        lines.push({ label: `DUSA ${n} plan`, price: p as number });
        return { lines, monthly: p as number, setup: 0, nudge: '' };
      }
      lines.push({ label: 'DUSA Growth plan', price: cat.plans.growth });
      let monthly = cat.plans.growth, setup = 0, nudge = '';
      if (seat === 'copilot') { const it = cat.items[`SUP-${d}`]; lines.push({ label: PLAIN.SUP, price: it.monthly }); return { lines, monthly: monthly + it.monthly, setup, nudge }; }
      const codes = codesFor(); if (seat === 'back') codes.push('GRM-S');
      let bolt = 0, boltFront = 0, set = 0;
      codes.forEach((c) => {
        const it = cat.items[c], base = c.split('-')[0];
        bolt += it.monthly; boltFront += it.guided ?? it.monthly; set += it.setup;
        if (it.monthly === 0) lines.push({ label: `${PLAIN[base]} (one-off)`, price: 0, oneoff: it.setup });
        else lines.push({ label: `${PLAIN[base]} · ${SIZE[it.size]}`, price: seat === 'front' ? (it.guided ?? it.monthly) : it.monthly });
      });
      if (seat === 'back') {
        const engine = Math.round((bolt * (1 - cat.bundleDiscount)) / 10) * 10 - 3;
        lines.push({ label: 'Growth Engine saving', price: engine - bolt, save: true });
        monthly += engine; setup = Math.round((set * (1 - cat.setupDiscount)) / 10) * 10;
      } else {
        const chk = cat.items['GRM-M'];
        lines.push({ label: 'Weekly check-ins and approvals', price: chk.monthly });
        monthly += boltFront + chk.monthly; setup = set;
        const back = cat.plans.growth + Math.round(((bolt + cat.items['GRM-S'].monthly) * (1 - cat.bundleDiscount)) / 10) * 10 - 3;
        if (back < monthly) nudge = `Same trip from the back seat: ${money(back)}/mo.`;
      }
      return { lines, monthly, setup, nudge };
    };

    /* ══ The city ══ */
    const svg = root.querySelector<SVGSVGElement>('[data-map]')!;
    const world = root.querySelector<SVGGElement>('[data-world]')!;
    const cityG = root.querySelector<SVGGElement>('[data-city]')!;
    const carG = root.querySelector<SVGGElement>('[data-car]')!;
    const routeEl = root.querySelector<SVGPathElement>('[data-route]')!;
    const G = 220, ROAD = 44, N = 7; // blocks
    let seed = 7; const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
    let city = '';
    for (let i = 0; i <= N; i++) { const p = i * G; city += `<rect x="${p - ROAD / 2}" y="-200" width="${ROAD}" height="${N * G + 400}" fill="#1a2433"/><rect x="-200" y="${p - ROAD / 2}" width="${N * G + 400}" height="${ROAD}" fill="#1a2433"/>`; }
    for (let i = 0; i <= N; i++) { const p = i * G; city += `<line x1="${p}" y1="-200" x2="${p}" y2="${N * G + 200}" stroke="#3b4c63" stroke-width="2" stroke-dasharray="14 16"/><line x1="-200" y1="${p}" x2="${N * G + 200}" y2="${p}" stroke="#3b4c63" stroke-width="2" stroke-dasharray="14 16"/>`; }
    const ROOFS = ['#16263b', '#1b2e47', '#132235', '#1f3550', '#182a40'];
    for (let bx = 0; bx < N; bx++) for (let by = 0; by < N; by++) {
      const x0 = bx * G + ROAD / 2 + 6, y0 = by * G + ROAD / 2 + 6, s = G - ROAD - 12;
      city += `<rect x="${x0 - 4}" y="${y0 - 4}" width="${s + 8}" height="${s + 8}" rx="6" fill="#222f40"/>`;
      if (rnd() < 0.16) { // park
        city += `<rect x="${x0}" y="${y0}" width="${s}" height="${s}" rx="10" fill="#183c35"/>`;
        for (let k = 0; k < 7; k++) { const tx = x0 + 18 + rnd() * (s - 36), ty = y0 + 18 + rnd() * (s - 36), r = 9 + rnd() * 10; city += `<circle cx="${tx + 3}" cy="${ty + 4}" r="${r}" fill="#0b1a18" opacity=".6"/><circle cx="${tx}" cy="${ty}" r="${r}" fill="${rnd() < 0.3 ? '#2f8f7c' : '#22695c'}"/>`; }
        continue;
      }
      const cols = rnd() < 0.5 ? 2 : 1, rows = rnd() < 0.5 ? 2 : 1, gap = 8, w = (s - gap * (cols - 1)) / cols, h = (s - gap * (rows - 1)) / rows;
      for (let c = 0; c < cols; c++) for (let r = 0; r < rows; r++) {
        const x = x0 + c * (w + gap), y = y0 + r * (h + gap);
        city += `<rect x="${x + 5}" y="${y + 6}" width="${w}" height="${h}" rx="4" fill="#05080d" opacity=".55"/><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="4" fill="${ROOFS[Math.floor(rnd() * ROOFS.length)]}" stroke="#2a3d55" stroke-width="1.5"/>`;
        if (rnd() < 0.6) city += `<rect x="${x + w * 0.2}" y="${y + h * 0.25}" width="${w * 0.18}" height="${h * 0.14}" rx="2" fill="#2a3d55"/>`;
        if (rnd() < 0.35) city += `<rect x="${x + w * 0.55}" y="${y + h * 0.55}" width="${w * 0.3}" height="${h * 0.25}" rx="3" fill="#1f5a52"/>`;
        if (rnd() < 0.25) city += `<circle cx="${x + w * 0.7}" cy="${y + h * 0.3}" r="${Math.min(w, h) * 0.08}" fill="#4ed8c2" opacity=".55"/>`;
      }
    }
    for (let i = 0; i <= N; i++) for (let j = 0; j <= N; j++) if ((i + j) % 2 === 0) city += `<circle cx="${i * G + ROAD / 2 + 4}" cy="${j * G + ROAD / 2 + 4}" r="46" fill="url(#mLamp)"/><circle cx="${i * G + ROAD / 2 + 4}" cy="${j * G + ROAD / 2 + 4}" r="3" fill="#ffe2a8"/>`;
    cityG.innerHTML = city;
    // The route: pickup bottom-left, home top-right, one block per answer.
    const ROUTE: [number, number][] = [[0, 6], [0, 5], [1, 5], [1, 4], [2, 4], [2, 3], [3, 3], [3, 2], [4, 2], [4, 1], [5, 1], [6, 1], [6, 0]].map(([a, b]) => [a * G, b * G]);
    const pickup: [number, number] = [ROUTE[0][0] + 0, ROUTE[0][1] + 56];
    const homeP: [number, number] = [ROUTE[ROUTE.length - 1][0] + 110, ROUTE[ROUTE.length - 1][1] - 0];
    root.querySelector('[data-pickup]')!.setAttribute('transform', `translate(${pickup[0] + 34} ${pickup[1]})`);
    root.querySelector('[data-home]')!.setAttribute('transform', `translate(${homeP[0] + 40} ${homeP[1] - 70})`);
    const PTS: [number, number][] = [pickup, ...ROUTE, homeP];
    routeEl.setAttribute('d', 'M' + PTS.map((p) => p.join(' ')).join(' L'));
    const segs = PTS.slice(1).map((p, i) => Math.hypot(p[0] - PTS[i][0], p[1] - PTS[i][1]));
    const TOTAL = segs.reduce((a, b) => a + b, 0);
    const at = (d: number) => { let i = 0; while (i < segs.length - 1 && d > segs[i]) { d -= segs[i]; i++; } const a = PTS[i], b = PTS[i + 1], k = Math.min(1, d / segs[i]); return { x: a[0] + (b[0] - a[0]) * k, y: a[1] + (b[1] - a[1]) * k, ang: Math.atan2(b[1] - a[1], b[0] - a[0]) }; };
    let carD = -260, targetD = 0, cam = { x: pickup[0], y: pickup[1], z: 1.5 }, ang = -Math.PI / 2;
    const STEPS = 9; let step = 0;
    const advance = (to?: number) => { step = to ?? Math.min(STEPS, step + 1); targetD = (TOTAL * step) / STEPS; };
    let W = 0, H = 0;
    const size = () => { const r = stage.getBoundingClientRect(); W = r.width; H = r.height; svg.setAttribute('viewBox', `0 0 ${W} ${H}`); };
    size(); addEventListener('resize', size);
    let last = performance.now(), visible = false;
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      const speed = 260;
      if (carD < targetD) carD = Math.min(targetD, carD + speed * dt * (reduced ? 20 : 1));
      const p = carD < 0 ? { x: pickup[0] + 0, y: pickup[1] - carD, ang: -Math.PI / 2 } : at(carD);
      let da = p.ang - ang; da = Math.atan2(Math.sin(da), Math.cos(da)); ang += da * Math.min(1, dt * 8);
      carG.setAttribute('transform', `translate(${p.x} ${p.y}) rotate(${(ang * 180) / Math.PI + 90})`);
      const phone = W < 760;
      const z = phone ? 1.25 : W > 1000 ? 1.6 : 1.4;
      cam.x += (p.x - cam.x) * Math.min(1, dt * 3); cam.y += (p.y - cam.y) * Math.min(1, dt * 3); cam.z += (z - cam.z) * Math.min(1, dt * 2);
      const cx = phone ? W / 2 : (W - Math.min(380, W * 0.44) - 16) / 2, cy = phone ? H * 0.19 : H / 2;
      world.setAttribute('transform', `translate(${cx} ${cy}) scale(${cam.z}) translate(${-cam.x} ${-cam.y})`);
      if (visible) requestAnimationFrame(tick);
    };

    /* ══ The chat ══ */
    const scroll = () => { msgs.scrollTop = msgs.scrollHeight; };
    const typingBubble = () => { const t = document.createElement('div'); t.className = 'ride__msg ride__msg--them ride__msg--typing'; t.innerHTML = '<i></i><i></i><i></i>'; msgs.appendChild(t); scroll(); return t; };
    const say = async (text: string, pause = 650) => {
      const t = typingBubble(); await wait(Math.min(1200, pause + text.length * 8)); t.remove();
      const m = document.createElement('div'); m.className = 'ride__msg ride__msg--them'; m.textContent = text; msgs.appendChild(m); scroll(); await wait(220);
    };
    const me = (text: string) => { const m = document.createElement('div'); m.className = 'ride__msg ride__msg--me'; m.textContent = text; msgs.appendChild(m); scroll(); };
    const card = async (html: string, cls = 'ride__card') => { const t = typingBubble(); await wait(700); t.remove(); const c = document.createElement('div'); c.className = cls; c.innerHTML = html; msgs.appendChild(c); scroll(); await wait(250); };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    let onType: ((v: string) => void) | null = null;
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value.trim(); if (!v || !onType) return; input.value = ''; onType(v); });
    const setInput = (placeholder: string, type = 'text') => { input.type = type; input.placeholder = placeholder; input.autocomplete = type === 'email' ? 'email' : type === 'tel' ? 'tel' : type === 'text' && placeholder.includes('name') ? 'given-name' : 'off'; };
    // Ask: quick replies and/or typing. Resolves with { value, label }.
    const ask = <T,>(opts: { label: string; value: T; tag?: string; cls?: string }[], o: { placeholder?: string; type?: string; free?: (v: string) => T | null; echo?: boolean } = {}) => new Promise<T>((resolve) => {
      quick.innerHTML = '';
      setInput(o.placeholder || 'Message your driver', o.type || 'text');
      const done = (v: T, label: string) => { quick.innerHTML = ''; onType = null; if (o.echo !== false) me(label); setInput('Message your driver'); resolve(v); };
      opts.forEach((op, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = `ride__chip ${op.cls || ''}`; b.style.animationDelay = `${i * 40}ms`; b.innerHTML = `${esc(op.label)}${op.tag ? `<em>${esc(op.tag)}</em>` : ''}`; b.addEventListener('click', () => done(op.value, op.label)); quick.appendChild(b); });
      requestAnimationFrame(scroll);
      onType = (v) => { const r = o.free ? o.free(v) : null; if (r !== null && r !== undefined) done(r, v); else { me(v); say("Sorry, didn't catch that. Tap one of these?"); } };
      if (!opts.length || o.type) setTimeout(() => { if (matchMedia('(hover: hover)').matches) input.focus({ preventScroll: true }); }, 60);
    });
    const multi = (keys: string[], preset: string[]) => new Promise<string[]>((resolve) => {
      quick.innerHTML = '';
      const chosen = new Set(preset);
      keys.forEach((k, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = `ride__chip${chosen.has(k) ? ' is-on' : ''}`; b.style.animationDelay = `${i * 30}ms`; b.textContent = NEEDS[k].short; b.addEventListener('click', () => { chosen.has(k) ? chosen.delete(k) : chosen.add(k); b.classList.toggle('is-on'); }); quick.appendChild(b); });
      const go = document.createElement('button'); go.type = 'button'; go.className = 'ride__chip ride__chip--go'; go.textContent = 'Done';
      go.addEventListener('click', () => { quick.innerHTML = ''; const v = [...chosen]; me(v.map((k) => NEEDS[k].short).join(', ') || 'Not sure yet'); resolve(v); });
      quick.appendChild(go); requestAnimationFrame(scroll);
      onType = (v) => { const t = v.toLowerCase(); Object.keys(NEEDS).forEach((k) => { if (NEEDS[k].short.toLowerCase().split(' ').some((w) => w.length > 4 && t.includes(w))) chosen.add(k); }); quick.innerHTML = ''; me(v); resolve([...chosen]); };
    });

    let meterNow = 0;
    const tickMeter = () => {
      meter.hidden = false;
      const to = quote().monthly, from = meterNow, t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / 700); meterNow = from + (to - from) * k; meterVal.textContent = `${money(meterNow)}/mo`; if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    };
    const send = async (event: string) => {
      const payload = { event, ...lead, codes: codesFor(), quote: quote(), page: location.pathname, at: new Date().toISOString() };
      (window as any).__rideLead = payload;
      const hook = root.dataset.webhook;
      if (!hook) { console.info('[ride] no webhook yet', payload); return; }
      try { await fetch(hook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }); } catch (e) { console.warn('[ride] send failed', e); }
    };

    /* ══ The ride ══ */
    const run = async () => {
      status.textContent = 'Pulling up';
      await wait(900);
      await say("Hey! Jump in out of the rain.");
      await say("I'm your DUSA driver. What's your name?");
      lead.name = (await ask<string>([], { placeholder: 'Your first name', free: (v) => v.split(' ')[0].replace(/^./, (c) => c.toUpperCase()) }));
      advance(); status.textContent = 'On the way';
      await say(`Lovely to meet you, ${lead.name}. What's your business called?`);
      lead.business = await ask<string>([], { placeholder: 'Business name', free: (v) => v });
      advance();
      await say(`${lead.business}. Love it. What do you do?`);
      const ind = await ask(INDUSTRIES.map((i) => ({ label: i.label, value: i.id })), { placeholder: 'Or type it', free: (v) => { lead.industryText = v; return matchOpt(v, INDUSTRIES)?.id || 'other'; } });
      lead.industry = ind; const I = INDUSTRIES.find((i) => i.id === ind)!;
      advance();
      await say(`We look after plenty of ${I.plural}, ${lead.name}.`);
      await card(`<ol>${I.top.map(([k, o]) => `<li><span>${esc(NEEDS[k].text)}<em>${esc(o)}</em></span></li>`).join('')}</ol>`);
      await say('Those three help them most. Sound like you?');
      const fit = await ask([{ label: 'Yes, all three', value: 'all' }, { label: 'Some of them', value: 'some' }, { label: 'Something else', value: 'else' }], { free: (v) => (/^(y|yes|yep|yeah|all)/i.test(v) ? 'all' : /some|few|two|one/i.test(v) ? 'some' : 'else') });
      const top = I.top.map(([k]) => k);
      if (fit === 'all') lead.needs = top;
      else if (fit === 'some') { await say('Tap the ones that fit.'); lead.needs = await multi(top, top); }
      else { await say('Tell me, or tap what fits.'); lead.needs = await multi(Object.keys(NEEDS), []); }
      advance();
      await say(lead.needs.length ? 'Easy. We fix those every day.' : "No worries. We'll start with never missing a call.");
      await say('So how do you want to get there?');
      lead.seat = await ask(SEATS.map((s) => ({ label: s.label, value: s.id, tag: s.tag })), { free: (v) => matchOpt(v, SEATS)?.id || null });
      const S = SEATS.find((s) => s.id === lead.seat)!;
      advance();
      await say(S.reply);
      await say('And how far are we going?');
      lead.distance = await ask(DIST.map((d) => ({ label: d.label, value: d.id })), { free: (v) => matchOpt(v, DIST)?.id || null });
      tickMeter(); advance(); send('profile');
      if (lead.seat !== 'self') { await say(`Right. For ${lead.business}: ${lead.needs.slice(0, 2).map((k: string) => NEEDS[k].short.toLowerCase()).join(' and ') || 'never miss a call'}.`); advance(); }
      advance(STEPS - 1);
      await wait(1600);
      status.textContent = 'Arriving';
      await say(`Here we are, ${lead.name}. Home.`);
      advance(STEPS);
      const q = quote(); lead.quote = q;
      await card(`<h4>DUSA FARE <span>#${String(Date.now()).slice(-5)}</span></h4><p>${esc(lead.name)}, ${esc(lead.business)} · ${SEAT_NAME[lead.seat]}</p><ul>${q.lines.map((l) => `<li class="${l.save ? 'is-save' : ''}"><span>${esc(l.label)}</span><b>${l.oneoff ? money(l.oneoff) + ' once' : money(l.price)}</b></li>`).join('')}</ul><div class="t"><span>Monthly</span><b>${money(q.monthly)}</b></div><div class="s"><span>Set-up, one-off</span><b>${q.setup ? money(q.setup) : 'None'}</b></div><small>AUD ex GST. Month to month. AI, SMS and ad spend at cost.${q.nudge ? `<b>${esc(q.nudge)}</b>` : ''}${lead.seat !== 'self' ? '<b>Rather drive yourself? DUSA from $47/mo.</b>' : ''}</small>`, 'ride__fare');
      status.textContent = 'Home';
      await say('Want this in your inbox?');
      const email = await ask<string>([{ label: 'Not now', value: '', cls: 'ride__chip--ghost' }], { placeholder: 'Your email', type: 'email', free: (v) => (/\S+@\S+\.\S+/.test(v) ? v : null) });
      lead.email = email; if (email) send('quote');
      await say(email ? 'Sent. Okay if we call to book your next pick-up?' : 'Okay if we call to book your next pick-up?');
      lead.callOk = await ask([{ label: 'Yes, call me', value: true }, { label: "I'll call you", value: false }], { free: (v) => (/^(y|yes|sure|ok|yep|yeah)/i.test(v) ? true : /^(n|no|nah)/i.test(v) ? false : null) });
      if (lead.callOk) {
        await say('Best number?');
        lead.phone = await ask<string>([], { placeholder: 'Mobile number', type: 'tel', free: (v) => (v.replace(/\D/g, '').length >= 8 ? v : null) });
        send('callback');
        await say(`Thanks ${lead.name}. Talk soon.`);
      } else {
        await say(`All good. Call us any time: ${PHONE}.`);
      }
      const doneFor = lead.seat === 'back' || lead.seat === 'front';
      const end = await ask([
        { label: doneFor ? 'Pay set-up and book kick-off' : 'Start my free trial', value: 'go', cls: 'ride__chip--go' },
        { label: 'Talk to the Growth Lead (10 min)', value: 'talk' },
        ...(lead.seat !== 'self' ? [{ label: 'Drive myself, from $47', value: 'self', cls: 'ride__chip--ghost' }] : []),
      ], { echo: false });
      send(end);
      if (end === 'talk') window.open(root.dataset.lead, '_blank', 'noopener');
      else location.href = end === 'go' && doneFor ? (root.dataset.book || '/start') : '/start';
    };

    let started = false;
    new IntersectionObserver((es) => es.forEach((e) => {
      const was = visible; visible = e.isIntersecting;
      if (visible && !was) { last = performance.now(); requestAnimationFrame(tick); }
      if (visible && !started && e.intersectionRatio > 0.45) { started = true; targetD = 0; run(); }
    }), { threshold: [0, 0.45] }).observe(stage);
    if (location.hostname === 'localhost') (window as any).__ride = { lead, quote, codesFor };
  });
</script>
