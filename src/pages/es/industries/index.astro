---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';

const lang = 'es';
const region = 'es';

const industries = [
  {
    title: 'Inmobiliaria',
    desc: 'Gestion de pipeline, seguimiento automatizado de visitas y matching de compradores para agentes que quieren cerrar mas ventas.',
    slug: '/es/industries/real-estate',
    icon: 'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z',
  },
  {
    title: 'Gimnasios y Fitness',
    desc: 'Onboarding de miembros, recordatorios de clases, campanas de recuperacion y seguimiento de referidos para reducir la desercion y llenar tus clases.',
    slug: '/es/industries/gyms',
    icon: 'M6.5 6.5h11M6 12h12M17.5 17.5h-11M20 21V3M4 21V3',
  },
  {
    title: 'Oficios y Servicios',
    desc: 'Respuesta automatica a llamadas perdidas, pipelines de cotizaciones, programacion de trabajos y recordatorios de pago para profesionales que no paran.',
