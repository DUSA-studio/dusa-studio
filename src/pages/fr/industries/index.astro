  {
    title: 'Garages automobiles',
    desc: 'Automatisation des rappels d\'entretien, campagnes saisonnieres, generation d\'avis et programmes de fidelite pour les mecaniciens.',
    slug: '/fr/industries/auto-repair',
    icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z',
  },
  {
    title: 'Coachs et consultants',
    desc: 'Tunnels d\'appels decouverte, sequences d\'onboarding, planification de seances et collecte de temoignages pour developper votre activite.',
    slug: '/fr/industries/coaches',
    icon: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z',
  },
  {
    title: 'E-commerce',
    desc: 'Sequences post-achat, automatisation des avis, parcours de ventes croisees, segmentation VIP et recompenses anniversaires.',
    slug: '/fr/industries/ecommerce',
    icon: 'M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0',
  },
];
---

<BaseLayout
  t={tData}
  title="Secteurs d'activite | DUSA.studio"
  description="DUSA est concu pour votre secteur. Decouvrez comment notre plateforme de croissance fonctionne pour l'immobilier, les artisans, les salles de sport, les restaurants, les salons, les dentistes et bien plus."
>
  <!-- Hero -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Secteurs d'activite</span>
        <h1>Concu pour <span class="gradient-text">votre</span> secteur</h1>
        <p class="ind-hero__sub">
          Chaque entreprise est differente. C'est pourquoi DUSA s'adapte a votre facon de travailler, avec des pipelines, des automatisations et des workflows concus pour votre secteur. Trouvez le votre ci-dessous.
        </p>
      </div>
    </div>
  </section>

  <!-- Industry Grid -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={ind.icon} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">En savoir plus &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Votre secteur n'apparait pas ?</h2>
        <p class="ind-cta__desc">DUSA fonctionne pour toute entreprise de services. Contactez-nous et nous vous montrerons comment il s'adapte a votre workflow.</p>
        <div class="ind-cta__buttons">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/fr/contact" class="btn btn--outline">Contactez-nous</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://dusa.studio/fr/" },
    { "@type": "ListItem", "position": 2, "name": "Secteurs d'activite", "item": "https://dusa.studio/fr/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
