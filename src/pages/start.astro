---
import BaseLayout from '../layouts/BaseLayout.astro';
import t from '../i18n/translations/en.json';
import { SAAS_PLANS } from '../config/saas-links';

const linksReady = SAAS_PLANS.every((p) => p.links.monthly !== '#pending');
---

<BaseLayout t={t} title="Start Your Free Trial | DUSA . studio" description="Get full access to DUSA's all-in-one growth platform free for 14 days. Cancel anytime. CRM, email, SMS, funnels, booking, and reputation management.">

  <!-- ─── HERO ─── -->
  <section class="trial-hero section section--dark">
    <div class="container">
      <div class="trial-hero__content">
        <span class="label">14-Day Free Trial</span>
        <h1>Start growing <span class="gradient-text">today</span></h1>
        <p class="trial-hero__sub">Pick a plan, activate your trial, and be inside your platform in minutes. $0 today. Cancel anytime before day 14 and pay nothing.</p>
        <div class="trial-hero__badges">
          <span class="trial-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            $0 today
          </span>
          <span class="trial-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
            Cancel anytime
          </span>
          <span class="trial-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Full access
          </span>
        </div>
      </div>
    </div>
  </section>

  {linksReady && (
  <!-- ─── PLAN CHOOSER: the activation path ─── -->
  <section class="activate section section--dark" style="padding-top:0;" id="activate">
    <div class="container">
      <div class="activate__toggle-wrap">
        <div class="activate__toggle" role="tablist" aria-label="Billing cycle">
          <button class="activate__toggle-btn is-active" id="cycle-monthly" role="tab" aria-selected="true">Monthly</button>
          <button class="activate__toggle-btn" id="cycle-annual" role="tab" aria-selected="false">Annual <span class="activate__toggle-badge">2 months free</span></button>
        </div>
      </div>

      <div class="activate__grid">
        {SAAS_PLANS.map((plan) => (
          <div class={`activate__card${plan.highlight ? ' activate__card--highlight' : ''}`} data-plan={plan.id}>
            {plan.highlight && <span class="activate__popular">Most popular</span>}
            <h3 class="activate__name">{plan.name}</h3>
            <p class="activate__blurb">{plan.blurb}</p>
            <div class="activate__price">
              <span class="activate__price-num" data-monthly={`$${plan.monthlyPrice}`} data-annual={`$${plan.annualPrice}`}>${plan.monthlyPrice}</span>
              <span class="activate__price-per" data-monthly="/month AUD" data-annual="/year AUD">/month AUD</span>
            </div>
            <ul class="activate__features">
              {plan.features.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a class={`btn ${plan.highlight ? 'btn--primary' : 'btn--outline'} activate__btn`} href={plan.links.monthly} data-monthly={plan.links.monthly} data-annual={plan.links.annual} target="_blank" rel="noopener">
              Start free trial
            </a>
            <p class="activate__note">14 days free &middot; then ${plan.monthlyPrice}/mo &middot; cancel anytime</p>
          </div>
        ))}
      </div>

      <p class="activate__assist">Not sure which plan? <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer">Book a free demo</a> or leave your details below and we'll set it up with you.</p>
    </div>
  </section>
  )}

  <!-- ─── FORM + VALUE PROPS ─── -->
  <section class="trial section section--dark" style="padding-top:0;" id="trial">
    <div class="container">
      <div class="trial__layout">
        <!-- Assisted path: lead form -->
        <div class="trial__form-wrap">
          <h2 class="trial__form-heading">Prefer it set up <span class="gradient-text">with you?</span></h2>
          <p class="trial__form-sub">Leave your details and we'll walk you through the platform and set up your trial together.</p>
          <form class="trial__form" id="trial-form">
            <div class="trial__field">
              <label class="trial__label" for="trial-fname">First Name *</label>
              <input type="text" id="trial-fname" name="firstName" class="trial__input" placeholder="Your first name" required autocomplete="given-name" />
            </div>

            <div class="trial__field">
              <label class="trial__label" for="trial-email">Email *</label>
              <input type="email" id="trial-email" name="email" class="trial__input" placeholder="you@example.com" required autocomplete="email" />
            </div>

            <div class="trial__field">
              <label class="trial__label" for="trial-business">Business Name *</label>
              <input type="text" id="trial-business" name="business" class="trial__input" placeholder="Your business name" required autocomplete="organization" />
            </div>

            <div class="trial__field">
              <label class="trial__label" for="trial-phone">Phone</label>
              <input type="tel" id="trial-phone" name="phone" class="trial__input" placeholder="+61 400 000 000" autocomplete="tel" />
            </div>

            <button type="submit" class="btn btn--primary trial__submit" id="trial-submit">Get Started</button>

            <div class="trial__status trial__status--success" id="trial-success" style="display:none;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>You're in! Check your email for login details.</span>
            </div>
            <div class="trial__status trial__status--error" id="trial-error" style="display:none;">
              <span>Something went wrong. Please email us at <a href="mailto:contact@dusa.studio">contact@dusa.studio</a> instead.</span>
            </div>
          </form>
        </div>

        <!-- Value Props -->
        <div class="trial__value">
          <div class="trial__value-item">
            <div class="trial__value-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </div>
            <div>
              <h4 class="trial__value-title">All 6 core systems included</h4>
              <p class="trial__value-text">CRM, marketing, funnels, booking, reputation, and AI chat in one place.</p>
            </div>
          </div>

          <div class="trial__value-item">
            <div class="trial__value-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M12 2l1.09 3.26L16 6l-2.18 2.18L14.36 12 12 10.09 9.64 12l.54-3.82L8 6l2.91-.74z"/><path d="M5 18l1.09-3.26L3 13l2.91-.74L5 9"/><path d="M19 18l-1.09-3.26L21 13l-2.91-.74L19 9"/></svg>
            </div>
            <div>
              <h4 class="trial__value-title">AI-powered automations from day one</h4>
              <p class="trial__value-text">Smart workflows that save you hours every week, active the moment you sign up.</p>
            </div>
          </div>

          <div class="trial__value-item">
            <div class="trial__value-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
            </div>
            <div>
              <h4 class="trial__value-title">Guided onboarding to get you results fast</h4>
              <p class="trial__value-text">We walk you through setup so you see value within your first week.</p>
            </div>
          </div>

          <div class="trial__value-item">
            <div class="trial__value-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h4 class="trial__value-title">Cancel anytime, no questions asked</h4>
              <p class="trial__value-text">Zero lock-in. If it's not the right fit, walk away with no strings attached.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Rotating Testimonials — full width below both columns -->
      <div class="trial__testimonials" id="trial-testimonials">
        <div class="trial__testimonial trial__testimonial--active" data-index="0">
          <blockquote class="trial__quote">
            "Within the first week, we had automated follow-ups running and booked three new clients. DUSA paid for itself before the trial was even over."
          </blockquote>
          <div class="trial__quote-author">
            <strong>Sarah M.</strong>
            <span>Beauty &amp; Wellness Studio</span>
          </div>
        </div>
        <div class="trial__testimonial" data-index="1">
          <blockquote class="trial__quote">
            "We used to spend hours chasing invoices and missed calls. Now the system handles it all. I actually take weekends off again."
          </blockquote>
          <div class="trial__quote-author">
            <strong>James T.</strong>
            <span>Residential Plumbing</span>
          </div>
        </div>
        <div class="trial__testimonial" data-index="2">
          <blockquote class="trial__quote">
            "Our Google reviews went from 12 to over 80 in three months. The automated review requests changed everything for our local visibility."
          </blockquote>
          <div class="trial__quote-author">
            <strong>Priya K.</strong>
            <span>Boutique Fitness Studio</span>
          </div>
        </div>
        <div class="trial__testimonial" data-index="3">
          <blockquote class="trial__quote">
            "I replaced four separate subscriptions with DUSA. One login, one bill, and everything actually talks to each other now."
          </blockquote>
          <div class="trial__quote-author">
            <strong>Marcus D.</strong>
            <span>Independent Financial Advisor</span>
          </div>
        </div>
        <div class="trial__testimonial" data-index="4">
          <blockquote class="trial__quote">
            "The AI chat captured leads while I was on set. I came back to three new bookings. That would never have happened before."
          </blockquote>
          <div class="trial__quote-author">
            <strong>Lena R.</strong>
            <span>Photography &amp; Creative Studio</span>
          </div>
        </div>
        <div class="trial__testimonial" data-index="5">
          <blockquote class="trial__quote">
            "Setting up funnels used to take us weeks with a developer. We built one in an afternoon and it converted better than anything before."
          </blockquote>
          <div class="trial__quote-author">
            <strong>Tom H.</strong>
            <span>E-commerce Brand Owner</span>
          </div>
        </div>
        <div class="trial__testimonial-dots" id="testimonial-dots"></div>
      </div>

      <p class="trial__legal trial__legal--wide">By signing up you agree to our <a href="/terms">Terms</a> and <a href="/privacy-policy">Privacy Policy</a></p>
    </div>
  </section>

  <!-- ─── WHAT YOU GET ─── -->
  <section class="trial-features section section--dark" id="features">
    <div class="container">
      <div class="trial-features__header">
        <span class="label">What You Get</span>
        <h2>Everything you need to grow, <span class="gradient-text">all in one place</span></h2>
      </div>
      <div class="trial-features__grid">
        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3 class="trial-features__title">CRM &amp; Pipeline Management</h3>
          <p class="trial-features__desc">Track every lead, deal, and customer interaction from one dashboard.</p>
        </div>

        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 class="trial-features__title">Email &amp; SMS Marketing</h3>
          <p class="trial-features__desc">Send targeted campaigns that turn leads into loyal customers.</p>
        </div>

        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3 class="trial-features__title">Booking &amp; Calendar</h3>
          <p class="trial-features__desc">Let clients book online, sync calendars, and automate reminders.</p>
        </div>

        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          </div>
          <h3 class="trial-features__title">Funnel &amp; Website Builder</h3>
          <p class="trial-features__desc">Build high-converting landing pages and sales funnels without code.</p>
        </div>

        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="trial-features__title">Reputation Management</h3>
          <p class="trial-features__desc">Collect reviews, monitor feedback, and build trust on autopilot.</p>
        </div>

        <div class="trial-features__card">
          <div class="trial-features__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
          </div>
          <h3 class="trial-features__title">AI Chat &amp; Automations</h3>
          <p class="trial-features__desc">Respond to leads instantly with AI, then hand off seamlessly when you're ready.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── BOTTOM CTA ─── -->
  <section class="trial-cta section section--dark">
    <div class="container">
      <div class="trial-cta__content">
        <h2>Still <span class="gradient-text">deciding?</span></h2>
        <p class="trial-cta__text">Prefer a guided walkthrough? Book a free demo and we'll show you the platform using your business as the example.</p>
        <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--primary">Book a Demo</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── HERO ─── */
  .trial-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .trial-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .trial-hero__sub {
    font-size: 1.25rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .trial-hero__badges {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .trial-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(247, 244, 239, 0.5);
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: 100px;
    padding: 0.5rem 1rem;
  }

  .trial-badge svg {
    color: var(--reef-aqua);
    flex-shrink: 0;
  }

  /* ─── LAYOUT ─── */
  .trial__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* ─── FORM ─── */
  .trial__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .trial__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .trial__label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 239, 0.4);
  }

  .trial__input {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--warm-white);
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    transition: all var(--duration-fast);
    width: 100%;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .trial__input::placeholder {
    color: rgba(247, 244, 239, 0.2);
  }

  .trial__input:focus {
    outline: none;
    border-color: var(--reef-aqua);
    background: rgba(78, 216, 194, 0.04);
    box-shadow: 0 0 0 3px rgba(78, 216, 194, 0.1);
  }

  .trial__submit {
    align-self: stretch;
    margin-top: var(--space-xs);
    text-align: center;
  }

  .trial__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trial__legal {
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.35);
    line-height: 1.6;
  }

  .trial__legal--wide {
    text-align: center;
    margin-top: var(--space-sm);
  }

  .trial__legal a {
    color: rgba(247, 244, 239, 0.5);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-fast);
  }

  .trial__legal a:hover {
    color: var(--reef-aqua);
  }

  .trial__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .trial__status--success {
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.2);
    color: var(--reef-aqua);
  }

  .trial__status--error {
    background: rgba(255, 100, 100, 0.08);
    border: 1px solid rgba(255, 100, 100, 0.2);
    color: #ff8a8a;
  }

  .trial__status--error a {
    color: var(--reef-aqua);
  }

  /* ─── VALUE PROPS ─── */
  .trial__value {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .trial__value-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
  }

  .trial__value-icon {
    color: var(--reef-aqua);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trial__value-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.25rem;
  }

  .trial__value-text {
    font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.6;
  }

  /* ─── ROTATING TESTIMONIALS ─── */
  .trial__testimonials {
    position: relative;
    margin-top: var(--space-xl);
    min-height: 120px;
  }

  .trial__testimonial {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    opacity: 0;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .trial__testimonial--active {
    opacity: 1;
    position: relative;
    left: auto;
    transform: none;
    pointer-events: auto;
  }

  .trial__quote {
    font-size: 1.0625rem;
    font-style: italic;
    color: rgba(247, 244, 239, 0.7);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .trial__quote-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .trial__quote-author strong {
    font-size: 0.9375rem;
    color: var(--warm-white);
    font-weight: 600;
  }

  .trial__quote-author span {
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.4);
  }

  .trial__testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: var(--space-md);
  }

  .trial__dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
