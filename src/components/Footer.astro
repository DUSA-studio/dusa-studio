<script>
  // Share buttons: point at the page being viewed, not just the homepage.
  function initFooterShare() {
    const bar = document.getElementById('footer-ai-bar');
    if (!bar) return;

    const url = encodeURIComponent(window.location.href);
    const li = document.getElementById('footer-share-li');
    const fb = document.getElementById('footer-share-fb');
    const x = document.getElementById('footer-share-x');
    if (li) li.setAttribute('href', 'https://www.linkedin.com/sharing/share-offsite/?url=' + url);
    if (fb) fb.setAttribute('href', 'https://www.facebook.com/sharer/sharer.php?u=' + url);
    if (x) x.setAttribute('href', 'https://twitter.com/intent/tweet?url=' + url);

    const copyBtn = document.getElementById('footer-copy-link');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          copyBtn.classList.add('is-copied');
          copyBtn.setAttribute('title', 'Copied!');
          setTimeout(function () {
            copyBtn.classList.remove('is-copied');
            copyBtn.setAttribute('title', 'Copy link');
          }, 1600);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterShare);
  } else {
    initFooterShare();
  }
</script>
