---
// FunnelGlass.astro — "Where does your money actually go?" as one glass vessel
// in two acts. Act 1: eight priced tools drop in and JAM in the neck, only a
// trickle escapes. Act 2: one connected DUSA atom (the apps as electrons on
// three orbits) passes straight through and bursts into money at the spout.
//
// Promoted from the staging branch (Direction D, Eliah's concept) with the
// reconciled $990 stack, chips kept inside the cone wall, a continuous pour,
// counting numbers, a light-mode display case and dictionary-driven copy.
//
// SVG + CSS only, no WebGL: chips stay crisp DOM text, zero bundle cost, and
// it degrades to a readable static state under prefers-reduced-motion.
import { STACK, DUSA_COST, STACK_TOTAL, SAVING, money } from '../config/stack-compare';
import { BRAND_MARKS } from '../config/brand-marks';
import { TOOL_MARKS } from '../config/tool-marks';

interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.funnelComparison || {};
const fcLabel = s.label || 'The real cost of scattered tools';
const fcHeading = s.heading || 'Where does your';
const fcHeadingAccent = s.headingAccent || 'money actually go?';
const jamNote = s.jamNote || 'Blocked. Nothing here talks to anything else.';
const fill = (str: string) => String(str)
  .replace('{total}', money(STACK_TOTAL)).replace('{dusa}', money(DUSA_COST)).replace('{saving}', money(SAVING));
const v1Title = fill(s.verdict1Title || '{total} in. A trickle out.');
const v1Sub = fill(s.verdict1Sub || 'Eight tools, eight logins, none of them connected. The work jams before it reaches you.');
const v2Title = fill(s.verdict2Title || '{dusa} in. All of it out.');
const v2Sub = fill(s.verdict2Sub || 'One connected platform, and the other {saving} a month stays yours.');
const tabTools = s.tabTools || 'Eight tools';
const tabPlatform = s.tabPlatform || 'One platform';
const perMonth = s.perMonth || '/mo';

const ELECTRON_NAMES = ['Stripe', 'Instagram', 'Google Calendar', 'Gmail', 'Facebook', 'WhatsApp', 'Shopify', 'PayPal'];
const MOONS = ELECTRON_NAMES.map((n) => BRAND_MARKS.find((m) => m.name === n)).filter(Boolean) as typeof BRAND_MARKS;

/* The atom. Three elliptical orbits at 0/60/120 degrees around a DUSA
   nucleus; the connected apps ride the orbits as electrons. Paths are in
   the atom box's own coordinates (240 x 240, centre 120,120) because
   offset-path: path() resolves against the containing block. */
const ATOM = 240, RX = 104, RY = 36;
const RINGS = [0, 60, 120].map((deg) => {
  const r = (deg * Math.PI) / 180, c = Math.cos(r), sn = Math.sin(r);
  const pt = (x: number, y: number) => `${(120 + x * c - y * sn).toFixed(1)} ${(120 + x * sn + y * c).toFixed(1)}`;
  return { deg, path: `M ${pt(-RX, 0)} A ${RX} ${RY} ${deg} 1 1 ${pt(RX, 0)} A ${RX} ${RY} ${deg} 1 1 ${pt(-RX, 0)}` };
});
const ORBIT_S = [9, 11.5, 13.5];
const ELECTRONS = MOONS.map((m, i) => {
  const ring = i % 3, k = Math.floor(i / 3), n = ring === 2 ? 2 : 3;
  return { m, ring, delay: -((k / n) * ORBIT_S[ring]).toFixed(2) };
});

/* Entry lane, and where each chip comes to rest once the neck is blocked.
   Deterministic so the jam looks designed rather than accidental. Resting
   x is kept inside the cone wall at that height (cube plus tag is ~40px
   half-width at jam scale; wall half-width runs 192px at y25, 153 at y32,
   121 at y38, 87 at y44, 60 at y49). */
const FALL = [
  { lane: -30, jamX:  -5, jamY: 44, rot: -10 },
  { lane:  14, jamX:   5, jamY: 43, rot:   8 },
  { lane:  -8, jamX:   0, jamY: 49, rot:   4 },
  { lane:  32, jamX:  11, jamY: 33, rot:  12 },
  { lane: -22, jamX: -11, jamY: 32, rot: -14 },
  { lane:   4, jamX:   1, jamY: 38, rot:  -5 },
  { lane:  26, jamX:  13, jamY: 26, rot:   7 },
  { lane: -14, jamX: -13, jamY: 25, rot:  -8 },
];
---

<section class="funnel section section--dark" id="funnel">
  <div class="container">
    <div class="funnel__header reveal">
      <span class="label">{fcLabel}</span>
      <h2>{fcHeading}<br/><span class="gradient-text">{fcHeadingAccent}</span></h2>
    </div>

    <div class="gf reveal" data-glass-funnel data-total={STACK_TOTAL} data-dusa={DUSA_COST} data-saving={SAVING}>
      <div class="gf__stage">
        <span class="gf__pool" aria-hidden="true"></span>
        <span class="gf__rimlight" aria-hidden="true"></span>

        <!-- ── The vessel ─────────────────────────────────────────────── -->
        <svg class="gf__vessel" viewBox="0 0 620 440" aria-hidden="true">
          <defs>
            <!-- Shading is one smooth sweep, lit from the upper left, and
                 the highlights stop well above the neck. Two bands meeting at
                 the neck with a dark trough between them read as a seam down
                 the middle of the glass, which is what the earlier version did. -->
            <linearGradient id="gfBody" x1="0" y1="0" x2="1" y2="0.35">
              <stop offset="0%"   stop-color="#9FEFE2" stop-opacity="0.30"/>
              <stop offset="28%"  stop-color="#FFFFFF" stop-opacity="0.10"/>
              <stop offset="62%"  stop-color="#4ED8C2" stop-opacity="0.07"/>
              <stop offset="100%" stop-color="#2E82B6" stop-opacity="0.24"/>
            </linearGradient>
            <linearGradient id="gfDepth" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0.06"/>
              <stop offset="70%"  stop-color="#4ED8C2" stop-opacity="0.04"/>
              <stop offset="100%" stop-color="#4ED8C2" stop-opacity="0.16"/>
            </linearGradient>
            <linearGradient id="gfRim" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#4ED8C2" stop-opacity="0.8"/>
              <stop offset="50%"  stop-color="#FFFFFF" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#2E82B6" stop-opacity="0.8"/>
            </linearGradient>
            <linearGradient id="gfSheen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset="25%"  stop-color="#FFFFFF" stop-opacity="0.26"/>
              <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
            </linearGradient>
            <!-- Highlights are blurred and clipped to the body, so they read
                 as light on glass rather than a pasted-on shape. -->
            <clipPath id="gfClip"><path d="M96,104 A214,44 0 0 0 524,104 L338,304 Q310,318 282,304 Z"/></clipPath>
            <filter id="gfSoft" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="5"/></filter>
          </defs>

          <!-- The body's top edge is the FRONT arc of the rim, not a straight
               chord: a chord draws a line straight across the opening and cuts
               the circle in two. Order matters: body, its shading, then the
               opening on top, then the front lip. -->
          <path class="gf__body" d="M96,104 A214,44 0 0 0 524,104 L338,304 Q310,318 282,304 Z"
                fill="url(#gfBody)" stroke="url(#gfRim)" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M96,104 A214,44 0 0 0 524,104 L338,304 Q310,318 282,304 Z" fill="url(#gfDepth)"/>
          <!-- One committed light source: a short specular on the left
               shoulder that fades out a third of the way down, and a faint
               bounce high on the far shoulder. Neither reaches the neck. -->
          <g clip-path="url(#gfClip)" filter="url(#gfSoft)">
            <path class="gf__sheen" d="M146,128 L184,126 L232,222 L212,226 Z" fill="url(#gfSheen)"/>
            <path d="M478,130 L494,128 L452,202 L440,204 Z" fill="url(#gfSheen)" fill-opacity="0.4"/>
          </g>

          <!-- The opening: back wall visible through the glass, a hairline
               inner rim for thickness, and the bright front lip. -->
          <ellipse cx="310" cy="104" rx="214" ry="44" fill="rgba(14,22,30,0.55)"
                   stroke="url(#gfRim)" stroke-width="1.5"/>
          <ellipse cx="310" cy="104" rx="214" ry="44" fill="url(#gfBody)" fill-opacity="0.6"/>
          <ellipse cx="310" cy="106" rx="204" ry="38" fill="none" stroke="#FFFFFF" stroke-opacity="0.14" stroke-width="1"/>
          <path d="M96,104 A214,44 0 0 0 524,104" fill="none"
                stroke="#FFFFFF" stroke-opacity="0.6" stroke-width="2.5" stroke-linecap="round"/>

          <path class="gf__spout" d="M282,304 L282,378 Q310,392 338,378 L338,304"
                fill="url(#gfBody)" stroke="url(#gfRim)" stroke-width="1.5"/>
          <path d="M287,312 L294,312 L294,374 L287,374 Z" fill="#FFFFFF" fill-opacity="0.12"/>
          <ellipse cx="310" cy="378" rx="28" ry="9"
                   fill="rgba(12,14,20,0.65)" stroke="url(#gfRim)" stroke-width="1.5"/>
        </svg>

        <!-- ── ACT 1: the tools ───────────────────────────────────────── -->
        <div class="gf__layer">
          {STACK.map((tool, i) => { const mk = TOOL_MARKS[tool.name] || { hex: '#4ED8C2', mono: tool.name[0] }; return (
            <span class="gf__chip"
                  style={`--lane:${FALL[i].lane}%;--jx:${FALL[i].jamX}%;--jy:${FALL[i].jamY}%;--rot:${FALL[i].rot}deg;--i:${i};--brand:${mk.hex};--spin:${(22 + (i * 7) % 16)}s;--tilt:${(i % 2 ? 1 : -1) * (24 + (i * 5) % 12)}deg`}>
              <span class="gf__cube">
                {['front', 'right', 'back', 'left', 'top', 'bottom'].map((face) => (
                  <span class={`gf__face gf__face--${face}`}>
                    {mk.path
                      ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={mk.path} fill="currentColor"/></svg>
                      : <b>{mk.mono}</b>}
                  </span>
                ))}
              </span>
              <span class="gf__tag"><i></i><span class="gf__tag-name">{tool.name}</span><span class="gf__tag-cost">{money(tool.cost)}</span></span>
            </span>
          ); })}
          <span class="gf__jam-note">{jamNote}</span>
        </div>

        <!-- ── ACT 2: the orb ─────────────────────────────────────────── -->
        <div class="gf__layer">
          <span class="gf__atom">
            <span class="gf__halo" aria-hidden="true"></span>
            <svg class="gf__orbits" viewBox={`0 0 ${ATOM} ${ATOM}`} aria-hidden="true">
              {RINGS.map((r) => (
                <g transform={`rotate(${r.deg} 120 120)`}>
                  <ellipse class="gf__orbit-line" cx="120" cy="120" rx={RX} ry={RY} fill="none"/>
                </g>
              ))}
            </svg>
            <span class="gf__nucleus">
              <b>DUSA</b>
              <i>{money(DUSA_COST)}{perMonth}</i>
            </span>
            {ELECTRONS.map((e, i) => (
              <span class="gf__electron" style={`offset-path: path('${RINGS[e.ring].path}'); --d:${ORBIT_S[e.ring]}s; --delay:${e.delay}s; --brand:${e.m.hex}; --spin:${30 + (i * 5) % 14}s; --tilt:${(i % 2 ? 1 : -1) * (24 + (i * 5) % 10)}deg`}>
                <span class="gf__cube gf__cube--sm">
                  {['front', 'right', 'back', 'left', 'top', 'bottom'].map((face) => (
                    <span class={`gf__face gf__face--${face}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={e.m.path} fill="currentColor"/></svg></span>
                  ))}
                </span>
              </span>
            ))}
          </span>
          <span class="gf__wake" aria-hidden="true"></span>
          <span class="gf__burst" aria-hidden="true"></span>
          <span class="gf__ring" aria-hidden="true"></span>
        </div>

        <!-- ── Output ─────────────────────────────────────────────────── -->
        <div class="gf__out" aria-hidden="true">
          {[0, 1, 2].map((n) => <span class="gf__coin gf__coin--dud" style={`--n:${n}`}>$</span>)}
          {Array.from({ length: 26 }).map((_, n) => <span class="gf__coin gf__coin--good" style={`--n:${n}`}>$</span>)}
        </div>

        <div class="gf__verdict">
          <p class="gf__v gf__v--1">
            <b><span class="gf__count" data-count={STACK_TOTAL}>{money(STACK_TOTAL)}</span> {v1Title.replace(money(STACK_TOTAL), '').trim()}</b>
            <span>{v1Sub}</span>
          </p>
          <p class="gf__v gf__v--2">
            <b><span class="gf__count" data-count={DUSA_COST}>{money(DUSA_COST)}</span> {v2Title.replace(money(DUSA_COST), '').trim()}</b>
            <span>{v2Sub}</span>
          </p>
        </div>
      </div>

      <div class="gf__controls">
        <button class="gf__tab" type="button" data-goto="1" aria-pressed="true"><i></i>{tabTools}</button>
        <button class="gf__tab" type="button" data-goto="2" aria-pressed="false"><i></i>{tabPlatform}</button>
        <span class="gf__bar" aria-hidden="true"><span class="gf__bar-fill"></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .funnel__header { text-align: center; max-width: 720px; margin: 0 auto var(--space-lg); }
  .funnel__header h2 { margin-top: var(--space-xs); }

  .gf { container-type: inline-size; }

  .gf__stage {
    position: relative; width: 100%; max-width: 660px; margin: 0 auto;
    aspect-ratio: 620 / 560;
  }
  .gf__vessel {
    position: absolute; inset: 0 0 auto; width: 100%; height: auto;
    filter: drop-shadow(0 20px 50px rgba(78, 216, 194, 0.16));
  }

  .gf__pool {
    position: absolute; left: 50%; top: 78%; width: 46%; height: 12%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(78, 216, 194, 0.22), rgba(78, 216, 194, 0) 70%);
    filter: blur(12px); opacity: 0.4;
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .gf[data-act="2"] .gf__pool { opacity: 1; transform: translateX(-50%) scale(1.25); }
  /* Whole-vessel glow that swells when the platform passes through. */
  .gf__rimlight {
    position: absolute; left: 50%; top: 36%; width: 70%; height: 46%;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(78, 216, 194, 0.18), rgba(46, 130, 182, 0.06) 45%, transparent 70%);
    filter: blur(24px); opacity: 0.35; transition: opacity 1.2s var(--ease-out);
  }
  .gf[data-act="1"] .gf__rimlight { opacity: 0.2; background: radial-gradient(ellipse at center, rgba(236, 132, 128, 0.16), transparent 70%); }
  .gf[data-act="2"] .gf__rimlight { opacity: 0.9; }

  .gf__layer { position: absolute; inset: 0; pointer-events: none; }

  /* ── Act 1: the tool cubes ─────────────────────────────────────────
     Same glass dice as the hero's integration field: fixed isometric
     tilt plus a slow Y spin, so two or three faces always show. The
     wrapper carries the fall (top/left/scale), the cube only spins. ── */
  .gf__chip {
    position: absolute; left: calc(50% + var(--lane)); top: 1%;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
    display: grid; justify-items: center; gap: 0.55rem;
    width: var(--cube, 62px);
    opacity: 0; will-change: top, left, transform;
  }
  .gf__cube {
    position: relative; width: var(--cube, 62px); height: var(--cube, 62px);
    transform-style: preserve-3d;
    animation: gfSpinY var(--spin, 26s) linear infinite;
  }
  @keyframes gfSpinY {
    from { transform: rotateX(var(--tilt, -28deg)) rotateY(0deg); }
    to   { transform: rotateX(var(--tilt, -28deg)) rotateY(360deg); }
  }
  .gf__face {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    border-radius: 22%;
    background: linear-gradient(150deg, rgba(34, 42, 58, 0.78), rgba(14, 18, 27, 0.92));
    border: 1px solid rgba(247, 244, 239, 0.14);
    color: rgba(247, 244, 239, 0.82);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset 0 0 16px color-mix(in srgb, var(--brand) 9%, transparent),
      0 0 0 0.5px color-mix(in srgb, var(--brand) 28%, transparent),
      0 6px 18px rgba(0, 0, 0, 0.3);
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  .gf__face svg { width: 56%; height: 56%; }
  .gf__cube--sm { --cube: 30px; width: 30px; height: 30px; }
  .gf__cube--sm .gf__face { border-radius: 26%; }
  .gf__cube--sm .gf__face svg { width: 52%; height: 52%; }
  .gf__face b { font-family: var(--font-headline); font-weight: 700; font-size: calc(var(--cube, 62px) * 0.4); letter-spacing: -0.02em; }
  .gf__face--front  { transform: rotateY(0deg)   translateZ(calc(var(--cube, 62px) / 2)); }
  .gf__face--right  { transform: rotateY(90deg)  translateZ(calc(var(--cube, 62px) / 2)); }
  .gf__face--back   { transform: rotateY(180deg) translateZ(calc(var(--cube, 62px) / 2)); }
  .gf__face--left   { transform: rotateY(270deg) translateZ(calc(var(--cube, 62px) / 2)); }
  .gf__face--top    { transform: rotateX(90deg)  translateZ(calc(var(--cube, 62px) / 2)); }
  .gf__face--bottom { transform: rotateX(-90deg) translateZ(calc(var(--cube, 62px) / 2)); }

  /* The price tag hangs off the cube on a short string: name and cost
     attached to the thing, not floating beside it. */
  .gf__tag {
    position: relative; display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.2rem 0.5rem; border-radius: 6px; white-space: nowrap;
    background: rgba(247, 244, 239, 0.96); color: #1B1F27;
    box-shadow: 0 4px 12px rgba(4, 8, 14, 0.5);
    font-family: var(--font-mono); font-size: 0.625rem; line-height: 1.3;
  }
  .gf__tag i {
    position: absolute; left: 50%; top: -0.55rem; width: 1px; height: 0.55rem;
    background: rgba(247, 244, 239, 0.55);
  }
  .gf__tag i::after {
    content: ''; position: absolute; left: -2px; top: -3px; width: 5px; height: 5px; border-radius: 50%;
    background: var(--brand);
  }
  .gf__tag-name { font-family: var(--font-body); font-weight: 600; font-size: 0.6875rem; }
  .gf__tag-cost { font-weight: 700; color: #B3261E; }

  .gf__jam-note {
    position: absolute; left: 50%; top: 61%; transform: translate(-50%, 0);
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(236, 132, 128, 0.9);
    white-space: nowrap; opacity: 0;
  }

  /* ── Act 2: the atom ───────────────────────────────────────────────
     DUSA is the nucleus; the connected apps are the electrons, riding
     three tilted orbits. It falls through the neck as one object. ── */
  .gf__atom {
    position: absolute; left: 50%; top: 1%;
    transform: translate(-50%, -50%) scale(var(--as, 1));
    width: 240px; height: 240px;
    opacity: 0; will-change: top, transform;
  }
  .gf__halo {
    position: absolute; inset: 26%; border-radius: 50%;
    background: radial-gradient(circle, rgba(78, 216, 194, 0.16), rgba(78, 216, 194, 0.04) 55%, transparent 72%);
    filter: blur(14px); animation: gfHalo 4s ease-in-out infinite;
  }
  @keyframes gfHalo { 0%, 100% { transform: scale(0.94); opacity: 0.8; } 50% { transform: scale(1.08); opacity: 1; } }
  .gf__orbits { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* Hairline orbits: one thin line each, lit slightly on the near side. */
  .gf__orbit-line { stroke: rgba(247, 244, 239, 0.22); stroke-width: 1; }
  .gf__nucleus {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: grid; justify-items: center; align-content: center; gap: 0.1rem;
    width: 92px; height: 92px; border-radius: 50%;
    background:
      radial-gradient(circle at 32% 24%, rgba(255,255,255,0.22), rgba(255,255,255,0.03) 38%, transparent 60%),
      radial-gradient(circle at 50% 110%, rgba(78,216,194,0.28), transparent 60%),
      linear-gradient(160deg, rgba(40, 50, 68, 0.8), rgba(14, 18, 27, 0.95));
    border: 1px solid rgba(247, 244, 239, 0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), inset 0 -10px 24px rgba(78,216,194,0.12), 0 0 34px rgba(78, 216, 194, 0.22), 0 18px 40px rgba(0, 0, 0, 0.45);
    animation: gfNucleus 4s ease-in-out infinite;
  }
  @keyframes gfNucleus {
    0%, 100% { box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), inset 0 -10px 24px rgba(78,216,194,0.12), 0 0 34px rgba(78, 216, 194, 0.22), 0 18px 40px rgba(0, 0, 0, 0.45); }
    50% { box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), inset 0 -10px 24px rgba(78,216,194,0.18), 0 0 48px rgba(78, 216, 194, 0.36), 0 18px 40px rgba(0, 0, 0, 0.45); }
  }
  .gf__nucleus b { font-family: var(--font-headline); font-weight: 700; font-size: 1.0625rem; letter-spacing: 0.08em; color: var(--warm-white); }
  .gf__nucleus i { font-style: normal; font-family: var(--font-mono); font-size: 0.5625rem; letter-spacing: 0.06em; color: rgba(247, 244, 239, 0.62); }
  /* Electrons are the same glass cubes as the tools, travelling the orbits
     and turning slowly as they go. offset-rotate keeps the cube upright. */
  .gf__electron {
    position: absolute; left: 0; top: 0; width: 30px; height: 30px; margin: -15px 0 0 -15px;
    display: grid; place-items: center;
    offset-rotate: 0deg; offset-distance: 0%;
    animation: gfElectron var(--d, 10s) linear infinite; animation-delay: var(--delay, 0s);
  }
  @keyframes gfElectron { to { offset-distance: 100%; } }
  @supports not (offset-path: path('M 0 0 L 1 1')) {
    .gf__electron { display: none; }
  }
  /* A glowing wake as the atom falls. */
  .gf__wake {
    position: absolute; left: 50%; top: 1%; width: 60px; height: 0;
    transform: translate(-50%, -100%);
    background: linear-gradient(to top, rgba(78, 216, 194, 0.35), transparent);
    filter: blur(8px); border-radius: 50%; opacity: 0;
  }

  .gf__burst {
    position: absolute; left: 50%; top: 68%; width: 150px; height: 150px;
    margin: -75px 0 0 -75px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.7), rgba(78,216,194,0.4) 40%, transparent 70%);
    opacity: 0; transform: scale(0.2);
  }
  .gf__ring {
    position: absolute; left: 50%; top: 68%; width: 60px; height: 60px;
    margin: -30px 0 0 -30px; border-radius: 50%;
    border: 2px solid rgba(78, 216, 194, 0.8); opacity: 0;
  }

  /* ── Output ────────────────────────────────────────────────────────── */
  .gf__out {
    position: absolute; left: 50%; top: 70%; transform: translateX(-50%);
    width: 240px; height: 26%; pointer-events: none;
  }
  .gf__coin { position: absolute; left: 50%; top: 0; opacity: 0; font-family: var(--font-mono); font-weight: 700; }
  .gf__coin--dud { font-size: 0.875rem; color: rgba(236, 132, 128, 0.8); }
  .gf__coin--good { font-size: 1.125rem; color: var(--reef-aqua); text-shadow: 0 0 12px rgba(78,216,194,0.6); }

  /* ── Verdict ───────────────────────────────────────────────────────── */
  .gf__verdict { position: absolute; left: 0; right: 0; bottom: 0; text-align: center; min-height: 5.5rem; }
  .gf__v { margin: 0; max-width: none; opacity: 0; position: absolute; left: 0; right: 0; bottom: 0; transition: opacity 0.6s var(--ease-out); }
  .gf__v b { display: block; font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .gf__v span { display: block; margin: 0.3rem auto 0; max-width: 46ch; font-size: 0.875rem; color: rgba(247,244,239,0.55); }
  .gf__v--1 b { color: rgba(236, 132, 128, 0.95); }
  .gf__v--2 b { color: var(--reef-aqua); }

  /* ── Act orchestration ─────────────────────────────────────────────── */
  .gf[data-act="1"] .gf__chip { animation: gfJam 4.2s cubic-bezier(0.4, 0, 0.6, 1) forwards; animation-delay: calc(var(--i) * 260ms); }
  .gf[data-act="1"] .gf__jam-note { animation: gfNote 5s ease-out 2.9s forwards; }
  .gf[data-act="1"] .gf__coin--dud { animation: gfDud 2.6s ease-in infinite; animation-delay: calc(3.4s + var(--n) * 900ms); }
  .gf[data-act="1"] .gf__v--1 { opacity: 1; transition-delay: 2.6s; }

  .gf[data-act="2"] .gf__atom { animation: gfAtomFall 3.4s cubic-bezier(0.4, 0, 0.6, 1) forwards; }
  .gf[data-act="2"] .gf__wake { animation: gfWake 3.4s cubic-bezier(0.4, 0, 0.6, 1) forwards; }
  .gf[data-act="2"] .gf__burst { animation: gfBurst 1.1s ease-out 2.9s forwards; }
  .gf[data-act="2"] .gf__ring { animation: gfRing 1.4s ease-out 2.95s forwards; }
  /* The pour keeps running for the rest of the act rather than stopping
     after one pass: a stream, not a handful. */
  .gf[data-act="2"] .gf__coin--good { animation: gfPour 1.9s ease-in infinite; animation-delay: calc(3.05s + var(--n) * 73ms); }
  .gf[data-act="2"] .gf__v--2 { opacity: 1; transition-delay: 3.2s; }

  /* Falls, hits the narrowing wall, then stalls where the neck blocks it.
     top/left drive the path: percentages inside translate() would resolve
     against the chip's own box, not the stage. */
  @keyframes gfJam {
    0%   { opacity: 0; top: 1%;  left: calc(50% + var(--lane)); transform: translate(-50%,-50%) scale(1) rotate(0deg); }
    9%   { opacity: 1; }
    46%  { opacity: 1; top: 30%; left: calc(50% + var(--lane) * 0.6); transform: translate(-50%,-50%) scale(0.86) rotate(calc(var(--rot) * 0.4)); }
    72%  { top: var(--jy); left: calc(50% + var(--jx)); transform: translate(-50%,-50%) scale(0.66) rotate(var(--rot)); }
    82%  { top: calc(var(--jy) - 1.5%); }
    100% { opacity: 1; top: var(--jy); left: calc(50% + var(--jx)); transform: translate(-50%,-50%) scale(0.66) rotate(var(--rot)); }
  }
  @keyframes gfNote { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes gfAtomFall {
    0%   { opacity: 0; top: 1%;  transform: translate(-50%,-50%) scale(var(--as, 1)); }
    10%  { opacity: 1; }
    52%  { opacity: 1; top: 34%; transform: translate(-50%,-50%) scale(calc(var(--as, 1) * 0.92)); }
    84%  { opacity: 1; top: 62%; transform: translate(-50%,-50%) scale(calc(var(--as, 1) * 0.42)); }
    100% { opacity: 0; top: 70%; transform: translate(-50%,-50%) scale(calc(var(--as, 1) * 0.2)); }
  }
  @keyframes gfWake {
    0%   { opacity: 0; top: 1%; height: 0; }
    20%  { opacity: 0.6; }
    52%  { top: 34%; height: 120px; opacity: 0.6; }
    84%  { top: 62%; height: 160px; opacity: 0.5; width: 30px; }
    100% { top: 70%; height: 120px; opacity: 0; width: 20px; }
  }
  @keyframes gfBurst { 0% { opacity: 0; transform: scale(0.2); } 35% { opacity: 0.9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.6); } }
  @keyframes gfRing { 0% { opacity: 0.9; transform: scale(0.3); } 100% { opacity: 0; transform: scale(4); } }
  @keyframes gfDud {
    0%   { opacity: 0; transform: translate(-50%, 0) scale(0.8); }
    18%  { opacity: 1; }
    60%  { opacity: 0; transform: translate(calc(-50% + 5px), 76px) scale(0.7); }
    100% { opacity: 0; transform: translate(calc(-50% + 5px), 76px) scale(0.7); }
  }
  @keyframes gfPour {
    0%   { opacity: 0; transform: translate(-50%, 0) scale(0.6); }
    14%  { opacity: 1; transform: translate(calc(-50% + (var(--n) - 13) * 4px), 20px) scale(1); }
    100% { opacity: 0; transform: translate(calc(-50% + (var(--n) - 13) * 12px), 116px) scale(0.85); }
  }

  /* ── Controls ──────────────────────────────────────────────────────── */
  .gf__controls { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin-top: var(--space-md); flex-wrap: wrap; }
  .gf__tab {
    display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer; min-height: 40px;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.6);
    background: rgba(247, 244, 239, 0.03); border: 1px solid rgba(247, 244, 239, 0.14);
    border-radius: 999px; padding: 0.42rem 0.9rem;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .gf__tab i { width: 7px; height: 7px; border-radius: 50%; background: rgba(247, 244, 239, 0.3); transition: background var(--duration-fast); }
  .gf__tab[aria-pressed="true"] { color: var(--warm-white); border-color: rgba(78,216,194,0.55); }
  .gf__tab[data-goto="1"][aria-pressed="true"] i { background: rgba(236, 132, 128, 0.95); }
  .gf__tab[data-goto="2"][aria-pressed="true"] i { background: var(--reef-aqua); }
  .gf__tab:hover { color: var(--warm-white); }
  .gf__bar { width: 90px; height: 2px; border-radius: 2px; background: rgba(247, 244, 239, 0.1); overflow: hidden; }
  .gf__bar-fill { display: block; width: 0; height: 100%; background: var(--reef-aqua); }
  .gf[data-act] .gf__bar-fill { animation: gfBar 9s linear forwards; }
  @keyframes gfBar { to { width: 100%; } }

  @container (max-width: 620px) {
    .gf__chip { --cube: 50px; gap: 0.45rem; }
    .gf__tag { font-size: 0.5625rem; padding: 0.15rem 0.4rem; }
    .gf__tag-name { font-size: 0.625rem; }
    .gf__atom { --as: 0.78; }
    .gf__v b { font-size: 1.2rem; }
    .gf__v span { font-size: 0.8125rem; }
    .gf__jam-note { font-size: 0.5625rem; }
  }
  @container (max-width: 420px) {
    .gf__chip { --cube: 40px; gap: 0.35rem; }
    .gf__tag { font-size: 0.5rem; }
    .gf__tag-name { font-size: 0.5625rem; }
    .gf__atom { --as: 0.6; }
    .gf__verdict { min-height: 6.5rem; }
  }

  /* ── Light mode: the vessel sits in a dark display case, so the glass
       and the glow keep their depth on a pale page. ─────────────────── */
  :global(html[data-theme="light"]) .gf__stage {
    background: radial-gradient(ellipse at 50% 30%, #17212B, #0C0E14 70%);
    border-radius: 28px; border: 1px solid rgba(12, 14, 20, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 24px 60px rgba(12, 14, 20, 0.18);
  }
  :global(html[data-theme="light"]) .gf__tab { color: rgba(12, 14, 20, 0.6); background: rgba(12, 14, 20, 0.03); border-color: rgba(12, 14, 20, 0.15); }
  :global(html[data-theme="light"]) .gf__tab i { background: rgba(12, 14, 20, 0.25); }
  :global(html[data-theme="light"]) .gf__tab[aria-pressed="true"] { color: var(--deep-black); border-color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .gf__tab:hover { color: var(--deep-black); }
  :global(html[data-theme="light"]) .gf__bar { background: rgba(12, 14, 20, 0.12); }
  :global(html[data-theme="light"]) .gf__bar-fill { background: var(--deep-ocean); }

  /* Motion is the whole mechanism, so without it state both outcomes plainly. */
  @media (prefers-reduced-motion: reduce) {
    .gf__chip, .gf__atom, .gf__coin, .gf__burst, .gf__ring, .gf__wake, .gf__halo, .gf__nucleus, .gf__electron,
    .gf__bar-fill, .gf__jam-note, .gf__cube { animation: none !important; }
    .gf__chip { opacity: 1; top: var(--jy); left: calc(50% + var(--jx)); transform: translate(-50%,-50%) scale(0.66) rotate(var(--rot)); }
    .gf__jam-note { opacity: 1; }
    .gf__atom, .gf__wake { display: none; }
    .gf__verdict { position: static; display: grid; gap: 0.9rem; margin-top: 1rem; min-height: 0; }
    .gf__v { position: static; opacity: 1; transition: none; }
    .gf__stage { aspect-ratio: auto; }
    .gf__vessel { position: relative; }
  }
</style>

<script>
  document.querySelectorAll('[data-glass-funnel]').forEach((root) => {
    const tabs = [...root.querySelectorAll('[data-goto]')];
    const counts = [...root.querySelectorAll('.gf__count')];
    const ACT_MS = 9000;
    let act = 1, timer = null, running = false, raf = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (n) => '$' + Math.round(n).toLocaleString('en-AU');

    /* The verdict figure counts up to its value as the act resolves, so the
       number arrives with the picture rather than sitting there beforehand. */
    const countTo = (el, target, delay, dur) => {
      if (!el || reduced) return;
      el.textContent = fmt(0);
      const t0 = performance.now() + delay;
      const step = (now) => {
        const p = Math.min(1, Math.max(0, (now - t0) / dur));
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(step);
    };

    /* Re-setting the same attribute will not restart a CSS animation: clear
       it, force a reflow, then set it. */
    const play = (n) => {
      act = n;
      root.removeAttribute('data-act');
      void root.offsetWidth;
      root.setAttribute('data-act', String(n));
      tabs.forEach((t) => t.setAttribute('aria-pressed', t.getAttribute('data-goto') === String(n) ? 'true' : 'false'));
      const el = counts[n - 1];
      if (el) countTo(el, Number(el.getAttribute('data-count')), n === 1 ? 2600 : 3200, 1400);
    };
    const queue = () => {
      clearTimeout(timer);
      timer = setTimeout(() => { play(act === 1 ? 2 : 1); queue(); }, ACT_MS);
    };
    const start = () => { if (running) return; running = true; play(act); queue(); };
    const stop = () => { running = false; clearTimeout(timer); };

    tabs.forEach((t) => t.addEventListener('click', () => {
      running = true;
      play(Number(t.getAttribute('data-goto')));
      queue();
    }));

    if (!('IntersectionObserver' in window)) { start(); return; }
    new IntersectionObserver((entries) => {
      entries.forEach((e) => { e.isIntersecting ? start() : stop(); });
    }, { threshold: 0.25 }).observe(root);
  });
</script>
