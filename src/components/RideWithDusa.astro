---
/**
 * RideWithDusa.astro (v4)
 *
 * The package builder as a short, white-glove ride, drawn in the SmashX
 * journey style (light isometric street, plain box car, low-poly trees).
 *
 * It is raining. The DUSA car pulls up, your Growth Lead steps out with an
 * umbrella, shields you, introduces herself and asks your name. She opens the
 * back door for you, closes it, folds the umbrella and gets in to drive. The
 * car only ever stops at red lights: each light is one quick question, and an
 * answer (or "Skip") turns it green. The weather clears as you go. At home,
 * your quote is waiting in the chat, priced from the catalogue
 * (src/data/catalogue-au.json).
 */
import catalogue from '../data/catalogue-au.json';
interface Props { webhook?: string; book?: string; growthLead?: string; phone?: string }
const {
  webhook = '',
  book = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  growthLead = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  phone = '+61 488 825 686',
} = Astro.props;
const CHAPTERS = ['Pick-up', 'Destination', 'Your line of work', 'Your ride', 'Your pace', 'Home'];
---

<section class="ride section section--dark" data-ride data-webhook={webhook} data-book={book} data-lead={growthLead} data-phone={phone}>
  <div class="container">
    <div class="ride__head">
      <span class="label">Build your engine</span>
      <h2 class="ride__h2">Need a lift? <span class="gradient-text">Hop in.</span></h2>
      <p class="ride__sub">A quick ride with your Growth Lead. Your quote is waiting when you get home.</p>
    </div>

    <div class="ride__stage" data-stage>
      <canvas class="ride__scene" data-scene aria-hidden="true"></canvas>

      <ol class="ride__chapters" data-chapters aria-hidden="true">
        {CHAPTERS.map((c, i) => <li class={i === 0 ? 'is-on' : ''}>{c}</li>)}
      </ol>

      <div class="ride__phone">
        <div class="ride__notch" aria-hidden="true"></div>
        <div class="ride__statusbar" aria-hidden="true"><span data-clock>7:42</span><span class="ride__sig"><i></i><i></i><i></i><b></b></span></div>
        <header class="ride__bar">
          <span class="ride__avatar"><img src="/lotus.svg" alt="" width="14" height="14" /></span>
          <span class="ride__bar-who"><b data-lead-name>Your Growth Lead</b><small data-status>Pulling up</small></span>
          <span class="ride__meter" data-meter hidden><small>Your engine</small><b data-meter-val>$0</b></span>
        </header>
        <div class="ride__msgs" data-msgs aria-live="polite"></div>
        <div class="ride__quick" data-quick></div>
        <form class="ride__compose" data-compose>
          <input class="ride__input" data-input type="text" placeholder="Message" autocomplete="off" aria-label="Message your Growth Lead" />
          <button class="ride__send" type="submit" aria-label="Send"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
        </form>
      </div>
    </div>

    <script type="application/json" data-catalogue set:html={JSON.stringify(catalogue)} />
  </div>
</section>

<style>
  .ride { position: relative; }
  .ride__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-lg); }
  .ride__h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.1; margin: 0.6rem 0; color: var(--warm-white); }
  .ride__sub { color: rgba(247, 244, 239, 0.66); margin: 0 auto; }

  .ride__stage { position: relative; max-width: 1180px; margin: 0 auto; aspect-ratio: 16 / 10; border-radius: 28px; overflow: hidden; background: #c9ced6; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35); }
  .ride__scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .ride__chapters { position: absolute; left: 16px; bottom: 16px; display: flex; flex-wrap: wrap; gap: 5px; margin: 0; padding: 0; list-style: none; z-index: 2; max-width: 62%; }
  :global(.ride__chapters li) { font-size: 0.74rem; font-weight: 500; padding: 5px 11px; border-radius: 100px; background: rgba(255, 255, 255, 0.85); color: #1a3a5c; box-shadow: inset 0 0 0 1px rgba(26, 58, 92, 0.14); transition: background 0.3s, color 0.3s; }
  :global(.ride__chapters li.is-done) { color: rgba(26, 58, 92, 0.45); }
  :global(.ride__chapters li.is-on) { background: #1a3a5c; color: #fff; box-shadow: none; }

  /* The phone: compact */
  .ride__phone { position: absolute; top: 10%; bottom: 10%; right: 3%; aspect-ratio: 9 / 18.5; max-width: 34%; display: flex; flex-direction: column; border-radius: 38px; border: 7px solid #0b0d12; overflow: hidden; background: linear-gradient(180deg, #1f4472 0%, #12294a 55%, #0c1b33 100%); box-shadow: 0 0 0 1.5px #3a3f4a, 0 26px 50px rgba(12, 26, 50, 0.35); color: #fff; z-index: 3; font-family: -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif; }
  .ride__notch { position: absolute; top: 7px; left: 50%; transform: translateX(-50%); width: 32%; height: 20px; border-radius: 16px; background: #0b0d12; z-index: 2; }
  .ride__statusbar { display: flex; justify-content: space-between; align-items: center; padding: 9px 18px 0 22px; font-size: 0.66rem; font-weight: 600; }
  .ride__sig { display: inline-flex; align-items: flex-end; gap: 2px; }
  .ride__sig i { width: 3px; background: #fff; border-radius: 1px; }
  .ride__sig i:nth-child(1) { height: 4px; } .ride__sig i:nth-child(2) { height: 6px; } .ride__sig i:nth-child(3) { height: 8px; }
  .ride__sig b { width: 16px; height: 8px; margin-left: 4px; border-radius: 3px; border: 1px solid rgba(255, 255, 255, 0.8); background: linear-gradient(90deg, #fff 70%, transparent 70%); background-clip: content-box; padding: 1px; }
  .ride__bar { display: flex; align-items: center; gap: 0.5rem; padding: 7px 12px 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .ride__avatar { width: 26px; height: 26px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #0f2440; box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.5); }
  .ride__avatar img { filter: invert(78%) sepia(30%) saturate(600%) hue-rotate(115deg); }
  .ride__bar-who b { display: block; font-size: 0.76rem; }
  .ride__bar-who small { display: block; font-size: 0.62rem; color: var(--reef-aqua); }
  .ride__meter { margin-left: auto; text-align: right; line-height: 1.1; }
  .ride__meter[hidden] { display: none; }
  .ride__meter small { display: block; font-size: 0.54rem; color: rgba(255, 255, 255, 0.55); }
  .ride__meter b { font-size: 0.86rem; color: var(--reef-aqua); font-variant-numeric: tabular-nums; }
  .ride__msgs { flex: 1; overflow-y: auto; padding: 10px 9px 4px; display: flex; flex-direction: column; gap: 4px; scroll-behavior: smooth; scrollbar-width: none; }
  .ride__msgs::-webkit-scrollbar { display: none; }
  :global(.ride__msg) { max-width: 86%; padding: 6px 10px; border-radius: 15px; font-size: 0.78rem; line-height: 1.3; animation: rideMsg 0.3s ease; }
  :global(.ride__msg--them) { align-self: flex-start; background: rgba(255, 255, 255, 0.14); border-bottom-left-radius: 5px; }
  :global(.ride__msg--me) { align-self: flex-end; background: #4ed8c2; color: #06231e; border-bottom-right-radius: 5px; }
  :global(.ride__msg--typing) { display: inline-flex; gap: 3px; padding: 9px 11px; }
  :global(.ride__msg--typing i) { width: 5px; height: 5px; border-radius: 50%; background: rgba(255, 255, 255, 0.6); animation: rideDot 1s infinite; }
  :global(.ride__msg--typing i:nth-child(2)) { animation-delay: 0.15s; }
  :global(.ride__msg--typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes rideDot { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  @keyframes rideMsg { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  :global(.ride__card) { align-self: stretch; padding: 8px 9px; border-radius: 13px; background: rgba(255, 255, 255, 0.1); box-shadow: inset 0 0 0 0.5px rgba(78, 216, 194, 0.5); animation: rideMsg 0.3s ease; font-size: 0.74rem; line-height: 1.3; }
  :global(.ride__card dl) { margin: 0; display: grid; gap: 6px; }
  :global(.ride__card dt) { font-weight: 700; color: var(--reef-aqua); }
  :global(.ride__card dd) { margin: 0; color: rgba(255, 255, 255, 0.85); }
  :global(.ride__fare) { align-self: stretch; padding: 10px 10px 8px; border-radius: 13px; background: #f7f4ef; color: #0c0e14; animation: rideMsg 0.4s ease; }
  :global(.ride__fare h4) { margin: 0; font-size: 0.6rem; letter-spacing: 0.16em; color: #1a3a5c; display: flex; justify-content: space-between; border-bottom: 2px dashed rgba(12, 14, 20, 0.18); padding-bottom: 4px; }
  :global(.ride__fare h4 span) { letter-spacing: 0.04em; font-weight: 500; color: rgba(12, 14, 20, 0.5); }
  :global(.ride__fare ul) { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; font-size: 0.7rem; }
  :global(.ride__fare li) { display: flex; justify-content: space-between; gap: 6px; }
  :global(.ride__fare li.is-save) { color: #0f6b5c; }
  :global(.ride__fare .t) { display: flex; justify-content: space-between; align-items: baseline; margin-top: 6px; padding-top: 4px; border-top: 2px dashed rgba(12, 14, 20, 0.18); font-size: 0.78rem; }
  :global(.ride__fare .t b) { font-family: var(--font-headline); font-size: 1.15rem; color: #1a3a5c; }
  :global(.ride__fare .s) { display: flex; justify-content: space-between; font-size: 0.72rem; }
  :global(.ride__fare small) { display: block; margin-top: 5px; font-size: 0.6rem; color: rgba(12, 14, 20, 0.55); }
  :global(.ride__fare small b) { display: block; color: #1a3a5c; margin-top: 2px; }
  .ride__quick { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 9px; justify-content: flex-end; }
  .ride__quick:empty { display: none; }
  :global(.ride__chip) { appearance: none; border: 0; cursor: pointer; font: inherit; font-size: 0.74rem; color: #fff; padding: 5px 10px; border-radius: 100px; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.6); transition: background 0.15s, transform 0.12s; animation: rideMsg 0.25s ease backwards; text-align: left; }
  :global(.ride__chip:hover) { background: rgba(78, 216, 194, 0.2); }
  :global(.ride__chip:active) { transform: scale(0.96); }
  :global(.ride__chip.is-on) { background: rgba(78, 216, 194, 0.35); }
  :global(.ride__chip--go) { background: #4ed8c2; color: #06231e; font-weight: 600; box-shadow: none; }
  :global(.ride__chip--ghost) { box-shadow: none; color: rgba(255, 255, 255, 0.7); text-decoration: underline; text-underline-offset: 3px; background: none; }
  :global(.ride__chip--pkg) { width: 100%; border-radius: 12px; padding: 6px 10px; }
  :global(.ride__chip--pkg b) { font-weight: 600; }
  :global(.ride__chip--pkg small) { display: flex; justify-content: space-between; gap: 6px; font-size: 0.66rem; color: rgba(255, 255, 255, 0.65); }
  :global(.ride__chip--pkg small i) { font-style: normal; color: var(--reef-aqua); white-space: nowrap; }
  :global(.ride__chip em) { font-style: normal; font-size: 0.56rem; font-weight: 700; margin-left: 5px; padding: 1px 5px; border-radius: 100px; background: var(--reef-aqua); color: #06231e; white-space: nowrap; }
  .ride__compose { display: flex; gap: 5px; padding: 5px 9px 12px; }
  .ride__input { flex: 1; min-width: 0; font: inherit; font-size: 0.8rem; color: #fff; padding: 7px 11px; border-radius: 100px; border: 0; outline: none; background: rgba(255, 255, 255, 0.1); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.3); }
  .ride__input:focus { box-shadow: inset 0 0 0 1.5px var(--reef-aqua); }
  .ride__input::placeholder { color: rgba(255, 255, 255, 0.45); }
  .ride__send { width: 28px; height: 28px; flex: none; align-self: center; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; background: var(--reef-aqua); color: #06231e; }
  .ride__send:focus-visible, :global(.ride__chip:focus-visible) { outline: 2px solid #fff; outline-offset: 2px; }

  @media (max-width: 760px) {
    .ride__stage { aspect-ratio: auto; height: min(100svh, 820px); width: 100vw; margin-left: calc(50% - 50vw); border-radius: 0; }
    .ride__phone { top: 50%; left: 0; right: 0; bottom: 0; max-width: none; aspect-ratio: auto; border: 0; border-radius: 22px 22px 0 0; box-shadow: 0 -10px 40px rgba(12, 26, 50, 0.25); }
    .ride__notch, .ride__statusbar { display: none; }
    .ride__bar { padding-top: 10px; }
    .ride__chapters { top: 10px; bottom: auto; left: 10px; right: 10px; max-width: none; gap: 3px; }
    :global(.ride__chapters li) { font-size: 0.6rem; padding: 3px 7px; }
    :global(.ride__msg) { font-size: 0.86rem; }
    :global(.ride__chip) { font-size: 0.8rem; }
    .ride__input { font-size: 16px; }
    .ride__compose { padding-right: 74px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
  }
  :global(html[data-theme="light"]) .ride__h2 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ride__sub { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .ride__stage { box-shadow: 0 30px 70px rgba(12, 14, 20, 0.16); }
</style>

<script>
  import * as T from 'three';
  type Item = { service: string; size: string; incl: string; setup: number; monthly: number; guided: number | null };
  type Cat = { plans: { starter: number; growth: number; scale: number }; bundleDiscount: number; setupDiscount: number; items: Record<string, Item> };

  document.querySelectorAll<HTMLElement>('[data-ride]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cat = JSON.parse(root.querySelector('[data-catalogue]')!.textContent || '{}') as Cat;
    const msgs = root.querySelector<HTMLElement>('[data-msgs]')!;
    const quick = root.querySelector<HTMLElement>('[data-quick]')!;
    const form = root.querySelector<HTMLFormElement>('[data-compose]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const meter = root.querySelector<HTMLElement>('[data-meter]')!;
    const meterVal = root.querySelector<HTMLElement>('[data-meter-val]')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapters] li')];
    const PHONE = root.dataset.phone || '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const money = (n: number) => (n < 0 ? '-$' : '$') + Math.abs(Math.round(n)).toLocaleString('en-AU');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 100) : ms));
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
    const ease = (k: number) => k * k * (3 - 2 * k);
    const chapter = (i: number) => chapters.forEach((c, k) => { c.classList.toggle('is-on', k === i); c.classList.toggle('is-done', k < i); });

    /* Your Growth Lead: a familiar name for where you are. */
    const REGION = (location.pathname.split('/')[1] || 'au').toLowerCase();
    const NAMES: Record<string, string> = { au: 'Sophie', uk: 'Emily', us: 'Sarah', no: 'Ingrid', fi: 'Aino', se: 'Elin', dk: 'Freja', nl: 'Sanne', de: 'Anna', fr: 'Camille', es: 'Lucía', it: 'Giulia', br: 'Ana', mx: 'Sofía' };
    const LEAD = NAMES[REGION] || NAMES.au;
    root.querySelector<HTMLElement>('[data-lead-name]')!.textContent = `${LEAD}, DUSA`;

    const lead: Record<string, any> = { name: '', business: '', industry: '', industryText: '', goals: [] as string[], needs: [] as string[], seat: '', distance: '', email: '', phone: '', growthLead: LEAD };

    /* ══ The words: short ══ */
    const GOALS: { id: string; label: string; needs: string[] }[] = [
      { id: 'customers', label: 'More customers', needs: ['newleads', 'google'] },
      { id: 'nomiss', label: 'Never miss a lead', needs: ['calls', 'followup'] },
      { id: 'repeat', label: 'Repeat business', needs: ['comeback'] },
      { id: 'reviews', label: 'More 5-star reviews', needs: ['reviews'] },
      { id: 'time', label: 'More time back', needs: ['calls', 'followup'] },
      { id: 'socials', label: 'Socials sorted', needs: ['socials'] },
      { id: 'website', label: 'A website that books work', needs: ['website'] },
    ];
    const INDUSTRIES: { id: string; label: string; kw: string[]; plural: string }[] = [
      { id: 'trades', label: 'Trades', kw: ['trade', 'tradie', 'roof', 'plumb', 'electr', 'build', 'carpent', 'landscap', 'paint', 'tile', 'concret', 'construct', 'hvac'], plural: 'tradies' },
      { id: 'beauty', label: 'Hair, beauty, spa', kw: ['hair', 'salon', 'beauty', 'spa', 'nail', 'lash', 'brow', 'inject', 'massage', 'barber', 'skin', 'clinic'], plural: 'salons and studios' },
      { id: 'fitness', label: 'Health and fitness', kw: ['gym', 'fitness', 'trainer', 'pilates', 'yoga', 'physio', 'chiro', 'health'], plural: 'gyms and studios' },
      { id: 'hospo', label: 'Café or restaurant', kw: ['cafe', 'café', 'restaurant', 'bar', 'food', 'coffee', 'bakery', 'hospo'], plural: 'cafés and restaurants' },
      { id: 'pro', label: 'Professional services', kw: ['account', 'law', 'legal', 'consult', 'bookkeep', 'agency', 'coach', 'finance', 'broker'], plural: 'firms like yours' },
      { id: 'property', label: 'Real estate', kw: ['real estate', 'property', 'agent', 'rental'], plural: 'agents' },
      { id: 'retail', label: 'A shop', kw: ['shop', 'store', 'retail', 'ecommerce', 'boutique', 'online'], plural: 'shops like yours' },
      { id: 'other', label: 'Something else', kw: [], plural: 'businesses like yours' },
    ];
    const NEED_CODES: Record<string, string[]> = { calls: ['AIR'], followup: ['FUP'], reviews: ['REV'], comeback: ['DBR', 'EML'], google: ['GBP', 'SEO'], newleads: ['GAD', 'MAD'], socials: ['SOC'], website: ['WEB'] };
    const SEATS = [
      { id: 'back', name: 'We drive, you relax', line: 'Done for you. Results and a monthly report.', more: 'We run everything you picked, end to end. You read one report a month. Best value, because there are no approval loops.', tag: 'Best value', kw: ['relax', 'back', 'done for', 'all of it'] },
      { id: 'front', name: 'We drive, you navigate', line: 'Done for you. You approve every step.', more: 'Same work, but you sign off every post, ad and campaign, with a weekly check-in. Costs a little more for the extra time.', kw: ['navigat', 'front', 'approve', 'control'] },
      { id: 'copilot', name: 'You drive, we help', line: 'You run DUSA, with monthly help hours.', more: 'You run the platform yourself. We set it up with you and give you help hours every month.', kw: ['help', 'support', 'co-pilot', 'copilot', 'shotgun'] },
      { id: 'self', name: 'Drive yourself', line: 'Just the DUSA platform. You run it.', more: 'The whole platform: CRM, inbox, bookings, payments, AI. You run it, we are a call away.', kw: ['key', 'myself', 'diy', 'self', 'platform', 'software'] },
    ];
    const PACES = [{ id: 'S', label: 'Steady' }, { id: 'M', label: 'Faster' }, { id: 'L', label: 'Fastest' }];
    const SEAT_NAME: Record<string, string> = { self: 'Drive yourself', copilot: 'You drive, we help', back: 'We drive, you relax', front: 'We drive, you navigate' };
    const PLAIN: Record<string, string> = {
      AIR: 'Every call answered', FUP: 'Every quote followed up', REV: '5-star reviews', GBP: 'Google Maps', SEO: 'Google search',
      DBR: 'Return business campaign', EML: 'Emails and texts to customers', GAD: 'Google Ads', MAD: 'Facebook and Instagram ads',
      SOC: 'Social media', WEB: 'Website', GRM: 'Monthly report', SUP: 'Help hours each month',
    };
    const matchOpt = <X extends { kw: string[] }>(text: string, opts: X[]) => { const t = ` ${text.toLowerCase()} `; return opts.find((o) => o.kw.some((k) => t.includes(k))); };

    /* ══ The price ══ */
    const needsFrom = (goals: string[]) => [...new Set(goals.flatMap((g) => GOALS.find((x) => x.id === g)?.needs || []))];
    const codesFor = (o: { distance?: string } = {}): string[] => {
      const d = o.distance || lead.distance || 'S';
      const needs: string[] = lead.needs.length ? lead.needs : ['calls', 'followup'];
      const out: string[] = [];
      needs.forEach((n) => NEED_CODES[n]?.forEach((c, k) => { if (k > 0 && d !== 'L') return; out.push(`${c}-${d}`); }));
      if (needs.includes('calls') && !needs.includes('followup')) out.push(`FUP-${d}`);
      return [...new Set(out)].filter((c) => cat.items[c]);
    };
    const quote = (o: { seat?: string; distance?: string } = {}): { lines: { label: string; price: number; save?: boolean; oneoff?: number }[]; monthly: number; setup: number; nudge: string } => {
      const seat = o.seat || lead.seat || 'back', d = o.distance || lead.distance || 'S';
      const lines: { label: string; price: number; save?: boolean; oneoff?: number }[] = [];
      if (seat === 'self') {
        const [n, p] = d === 'S' ? ['Starter', cat.plans.starter] : d === 'M' ? ['Growth', cat.plans.growth] : ['Scale', cat.plans.scale];
        lines.push({ label: `DUSA ${n} plan`, price: p as number });
        return { lines, monthly: p as number, setup: 0, nudge: '' };
      }
      lines.push({ label: 'DUSA Growth plan', price: cat.plans.growth });
      let monthly = cat.plans.growth, setup = 0, nudge = '';
      if (seat === 'copilot') { const it = cat.items[`SUP-${d}`]; lines.push({ label: PLAIN.SUP, price: it.monthly }); return { lines, monthly: monthly + it.monthly, setup, nudge }; }
      const codes = codesFor({ distance: d }); if (seat === 'back') codes.push('GRM-S');
      let bolt = 0, boltFront = 0, set = 0;
      codes.forEach((c) => {
        const it = cat.items[c], base = c.split('-')[0];
        bolt += it.monthly; boltFront += it.guided ?? it.monthly; set += it.setup;
        if (it.monthly === 0) lines.push({ label: `${PLAIN[base]} (one-off)`, price: 0, oneoff: it.setup });
        else lines.push({ label: PLAIN[base], price: seat === 'front' ? (it.guided ?? it.monthly) : it.monthly });
      });
      if (seat === 'back') {
        const engine = Math.round((bolt * (1 - cat.bundleDiscount)) / 10) * 10 - 3;
        lines.push({ label: 'Growth Engine saving', price: engine - bolt, save: true });
        monthly += engine; setup = Math.round((set * (1 - cat.setupDiscount)) / 10) * 10;
      } else {
        const chk = cat.items['GRM-M'];
        lines.push({ label: 'Weekly check-ins', price: chk.monthly });
        monthly += boltFront + chk.monthly; setup = set;
        const back = quote({ seat: 'back', distance: d }).monthly;
