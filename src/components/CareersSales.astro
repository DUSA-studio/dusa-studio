---
// Careers — sales contractor role.
//
// Copy note: written to sound like Eliah talking, not like a job ad. Short
// sentences, contractions, second person, concrete detail. Avoid the tidy
// three-part lists and balanced clauses that make marketing copy read as
// machine-written.
//
// The word "passive income" is used sparingly and never as a promise. The
// honest version of that idea is "sell it once, get paid every month it
// stays", which is true and says the same thing without the baggage the
// phrase carries in commission recruiting.
import {
  PLANS, SHARE, ANNUAL_MONTHS_CHARGED, QUOTA_PER_QUARTER,
  DEFAULT_CHURN, DEFAULT_SALES_PER_MONTH, PROJECTION_YEARS, REQUIREMENTS, money, monthly, upfront,
} from '../config/careers';

const APPLY = 'https://link.dusa.studio/widget/form/LbZWlJIZhj18dhmE4vID';
const pct = Math.round(SHARE * 100);
---

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="cr-hero section section--dark">
  <div class="container">
    <span class="label">Careers at DUSA</span>
    <h1>Sell it once.<br/><span class="gradient-text">Get paid every month.</span></h1>
    <p class="cr-hero__sub">
      We're looking for people who can sit down with a small business owner and
      show them what DUSA does. Sign one client and you take {pct}% of what they
      pay us. Not as a one-off. Every month they stay, that money keeps landing
      in your account.
    </p>
    <div class="cr-hero__cta">
      <a class="btn btn--primary" href={APPLY} target="_blank" rel="noopener">Apply to sell DUSA</a>
      <a class="btn btn--outline" href="#compounding">See what it builds to</a>
    </div>
  </div>
</section>

<!-- ── Why people do this ───────────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__pillars">
      <article>
        <h3>The money doesn't reset</h3>
        <p>
          Most sales jobs put you back on zero every month. This one doesn't.
          A client you signed last March is still paying you this March, and
          you haven't had to do anything about it.
        </p>
      </article>
      <article>
        <h3>Do it around everything else</h3>
        <p>
          Some of our people sell DUSA full time. Others have a job and fit a
          few conversations into their week. Nobody is checking your hours.
          What matters is that clients sign and clients stay.
        </p>
      </article>
      <article>
        <h3>Work wherever you want</h3>
        <p>
          Kitchen table, a cafe, a different country. We've never met most of
          the people we work with in person. It has not been a problem.
        </p>
      </article>
      <article>
        <h3>Or build a team under you</h3>
        <p>
          If you'd rather bring in your own sellers than only sell yourself,
          there's a way to do that and earn from what they close. It's not
          public yet. Ask us and we'll walk you through it.
        </p>
      </article>
    </div>
  </div>
</section>

<!-- ── The compounding story. Sits high on purpose: it is the strongest
     argument for the role and it is the one nobody sees coming. ────────── -->
<section class="cr section section--dark" id="compounding">
  <div class="container">
    <div class="cr__head">
      <span class="label">The bit worth understanding</span>
      <h2>Year one you're building it.<br/><span class="gradient-text">Year five it's still paying you.</span></h2>
      <p class="cr__sub">
        Year one is the graft. You start at zero and every client is one you
        had to go and win. Here's the difference: none of them disappear in
        January. Year two opens with everything year one built, and you're
        adding on top of that. It keeps going like that.
      </p>
    </div>

    <div class="grow" data-grow>
      <div class="grow__inputs">
        <label class="calc__row">
          <span class="calc__row-name">New clients a month<i>what a strong month looks like</i></span>
          <span class="calc__row-ctrl">
            <button type="button" data-g-step="rate:-1" aria-label="One fewer sale a month">&minus;</button>
            <input type="number" min="1" max="50" value={DEFAULT_SALES_PER_MONTH} data-g="rate" aria-label="New clients a month" />
            <button type="button" data-g-step="rate:1" aria-label="One more sale a month">+</button>
          </span>
        </label>

        <div class="grow__plans" role="group" aria-label="Which plan you mostly sell">
          <span class="grow__plans-label">Mostly selling</span>
          {PLANS.map((p, i) => (
            <button type="button" class={i === 1 ? 'is-on' : ''} data-g-plan={p.price}>{p.name}</button>
          ))}
        </div>

        <div class="grow__jump">
          <span>Year 2 alone is</span>
          <b data-g-mult>2.4x</b>
          <span>what you earn in year 1</span>
        </div>

        <!-- Kept available and disclosed, but not the headline. -->
        <details class="grow__adv">
          <summary>Assumptions</summary>
          <label class="calc__row">
            <span class="calc__row-name">Clients staying each month<i>set at 97%</i></span>
            <span class="calc__row-ctrl">
              <button type="button" data-g-step="churn:1" aria-label="Lower retention">&minus;</button>
              <input type="number" min="85" max="100" value={100 - Math.round(DEFAULT_CHURN * 100)} data-g="retention" aria-label="Percent of clients staying each month" />
              <span class="calc__row-unit">%</span>
              <button type="button" data-g-step="churn:-1" aria-label="Higher retention">+</button>
            </span>
          </label>
          <p>
            We set this high on purpose. When a client does leave, it's almost
            always because the business itself has closed, not because they
            found something better. Once a business is running its enquiries,
            bookings and invoicing through DUSA, leaving means rebuilding all
            of it somewhere else. Move the number and see it either way.
          </p>
        </details>
      </div>

      <div class="grow__out">
        <div class="grow__chart">
          {Array.from({ length: PROJECTION_YEARS }).map((_, i) => (
            <div class={`grow__col ${i === PROJECTION_YEARS - 1 ? 'is-hero' : ''}`}>
              <b data-g-val={i + 1}>$0</b>
              <i data-g-bar={i + 1}></i>
              <span>Yr {i + 1}</span>
            </div>
          ))}
        </div>

        <div class="grow__totals">
          <div>
            <span>Earned across {PROJECTION_YEARS} years</span>
            <b data-g-total>$0</b>
          </div>
          <div>
            <span>Month 60 run rate</span>
            <b><span data-g-run>$0</span>/mo</b>
          </div>
        </div>
        <p class="grow__run">
          from <b data-g-clients>0</b> clients still paying you, most of whom
          you signed years earlier.
        </p>
      </div>
    </div>

    <p class="grow__note">
      A model on our real prices, not a prediction, and not what any contractor
      has earned. It assumes you keep signing at that pace every month for five
      years, and that 97% of your clients stay put each month. Both are
      assumptions you can change under Assumptions.
    </p>

    <div class="grow__cta">
      <a class="btn btn--primary" href={APPLY} target="_blank" rel="noopener">Start building it</a>
    </div>
  </div>
</section>

<!-- ── How the money works ──────────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__head">
      <span class="label">How you get paid</span>
      <h2>Two ways a sale pays you</h2>
      <p class="cr__sub">
        Clients pick how they want to pay. Either way your cut is {pct}%, and
        either way it's sent once their money reaches us. No 60 day terms.
      </p>
    </div>

    <div class="cr__ways">
      <article class="cr__way">
        <span class="cr__way-tag">They pay monthly</span>
        <h3>{pct}% lands every month they stay</h3>
        <p>
          Their payment goes through, your cut follows. There's no cap on it
          and no expiry date while the licence is live and you're still
          selling with us. Ten clients on Growth is
          {money(monthly(PLANS[2]) * 10)} a month arriving whether you sold
          anything that month or not.
        </p>
      </article>

      <article class="cr__way">
        <span class="cr__way-tag">They pay a year upfront</span>
        <h3>{pct}% of the whole year, in one go</h3>
        <p>
          Annual clients get a discount, so they're charged the equivalent of
          {ANNUAL_MONTHS_CHARGED} months rather than 12. Your {pct}% comes off
          what they actually pay. One Growth client signing annually is
          {money(upfront(PLANS[2]))} in a single hit.
        </p>
      </article>
    </div>

    <div class="cr__rates">
      <div class="cr__rates-head">
        <span>Plan</span><span>They pay</span><span>You earn monthly</span><span>Or upfront on annual</span>
      </div>
      {PLANS.map((p) => (
        <div class="cr__rate">
          <span class="cr__rate-name">{p.name}<i>{p.blurb}</i></span>
          <span class="cr__rate-price" data-l="They pay"><em>{money(p.price)}<i>/mo</i></em></span>
          <span class="cr__rate-you" data-l="You earn"><em>{money(monthly(p))}<i>/mo, ongoing</i></em></span>
          <span class="cr__rate-you" data-l="Or upfront"><em>{money(upfront(p))}<i>one payment</i></em></span>
        </div>
      ))}
      <p class="cr__rates-note">
        AUD. Usage like SMS, calls and AI is billed to the client on top and
        isn't part of the licence revenue, so it isn't part of your share.
      </p>
    </div>
  </div>
</section>

<!-- ── Calculator 1: what a book is worth today ─────────────────────────── -->
<section class="cr section section--dark" id="maths">
  <div class="container">
    <div class="cr__head">
      <span class="label">Run your own numbers</span>
      <h2>What would <span class="gradient-text">your clients</span> be worth?</h2>
      <p class="cr__sub">
        Put in what you think you could sign. This is just arithmetic on our
        real prices. It isn't a forecast and it isn't a promise.
      </p>
    </div>

    <div class="calc" data-calc>
      <div class="calc__inputs">
        {PLANS.map((p) => (
          <label class="calc__row">
            <span class="calc__row-name">{p.name}<i>{money(p.price)}/mo</i></span>
            <span class="calc__row-ctrl">
              <button type="button" data-step={`${p.id}:-1`} aria-label={`One fewer ${p.name} client`}>&minus;</button>
              <input type="number" min="0" max="999" value={p.id === 'starter' ? 5 : 0}
                     data-plan={p.id} data-price={p.price} aria-label={`${p.name} clients`} />
              <button type="button" data-step={`${p.id}:1`} aria-label={`One more ${p.name} client`}>+</button>
            </span>
          </label>
        ))}
        <div class="calc__mode" role="group" aria-label="How your clients pay">
          <button type="button" class="is-on" data-mode="monthly">They pay monthly</button>
          <button type="button" data-mode="annual">They pay a year upfront</button>
        </div>
      </div>

      <div class="calc__out">
        <span class="calc__out-label" data-out-label>Every month</span>
        <strong class="calc__out-value" data-out-value>$298</strong>
        <span class="calc__out-sub" data-out-sub>from 5 clients</span>
        <div class="calc__out-year">
          <span data-out-year-label>Over 12 months</span>
          <b data-out-year>$3,576</b>
        </div>
        <p class="calc__out-note" data-out-note>
          Arrives each time their payments land, for as long as those licences
          stay active.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ── What you get ─────────────────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__head">
      <span class="label">What we do</span>
      <h2>You sell it. We look after the rest.</h2>
    </div>
    <div class="cr__grid">
      <article><h3>The pitch is a number</h3><p>Eight tools replaced by one, for less than they're paying now. You can do the maths on a napkin and it still works.</p></article>
      <article><h3>Setup isn't your job</h3><p>Once they sign, we take over. Migration, setup, training. You go back to selling.</p></article>
      <article><h3>We want them to stay as much as you do</h3><p>Your income depends on retention. So does ours. Nobody here is going to let a client drift.</p></article>
      <article><h3>Your own licence</h3><p>Run your pipeline on DUSA. Easier to sell something when you use it every day.</p></article>
      <article><h3>Something to send them</h3><p>Decks, comparison pages, live pricing. Whatever you need mid-conversation.</p></article>
      <article><h3>Paid when they pay</h3><p>Their money lands, yours goes out. We're not sitting on it for a month.</p></article>
    </div>
  </div>
</section>

<!-- ── What you need in place ───────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__head">
      <span class="label">Before you can invoice us</span>
      <h2>The paperwork side</h2>
      <p class="cr__sub">
        You're a contractor, so you send us invoices and you sort out your own
        tax. What you need to do that depends on where you are.
      </p>
    </div>
    <div class="cr__reqs">
      {REQUIREMENTS.map((r) => (
        <div class="cr__req">
          <span class="cr__req-region">{r.region}</span>
          <span class="cr__req-needs">{r.needs}</span>
        </div>
      ))}
    </div>
    <p class="cr__reqs-note">
      We don't withhold tax, pay super, or provide insurance. If you're not
      sure what applies to you, check with an accountant in your country
      before you apply. Not sure yet? Apply anyway and ask us.
    </p>
  </div>
</section>

<!-- ── The honest bit ───────────────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__head">
      <span class="label">Before you apply</span>
      <h2>The bits other ads leave out</h2>
      <p class="cr__sub">Rather you find out now than three months in.</p>
    </div>

    <div class="cr__terms">
      <article>
        <h3>There's no base</h3>
        <p>No retainer, no draw, no safety net. You get paid when clients pay. If you need money landing from week one, don't take this on.</p>
      </article>
      <article>
        <h3>You have to keep selling</h3>
        <p>{QUOTA_PER_QUARTER} new clients a quarter, so around one a month, to stay active and keep your {pct}%.</p>
      </article>
      <article>
        <h3>It stops when you stop</h3>
        <p>The ongoing {pct}% runs while the licence is live and while you're still selling with us. It isn't a royalty you keep after you leave.</p>
      </article>
      <article>
        <h3>You'll sign an NDA and a non-compete</h3>
        <p>The NDA covers our IP. The non-compete runs six months from the end of your engagement.</p>
      </article>
      <article>
        <h3>The first few months are slow</h3>
        <p>Recurring income is brilliant later and thin at the start. Month one is one client's worth. Go in expecting that.</p>
      </article>
      <article>
        <h3>You're representing us</h3>
        <p>These are people trusting us with their business. Overpromise to close a deal and we'll end the engagement.</p>
      </article>
    </div>
    <p class="cr__legal">
      Every figure here is arithmetic on our current AUD list prices, shown so
      you can see how commission is worked out. None of it is a forecast, a
      guarantee, or a statement of what any contractor has earned or will earn.
      The contractor agreement is what counts.
    </p>
  </div>
</section>

<!-- ── Fit ──────────────────────────────────────────────────────────────── -->
<section class="cr section section--dark">
  <div class="container">
    <div class="cr__head">
      <span class="label">Who this actually suits</span>
      <h2>You'll do well here if</h2>
    </div>
    <ul class="cr__fit">
      <li>You've sold to small business owners and you're not squeamish about talking money.</li>
      <li>You'd rather build something that pays every month than chase the next commission.</li>
      <li>You already know people, or you know an industry well enough to get in the door.</li>
      <li>Nobody needs to tell you what to do on a Tuesday.</li>
      <li>You're fine being judged on clients who stick around, not just deals signed.</li>
    </ul>
  </div>
</section>

<!-- ── CTA ──────────────────────────────────────────────────────────────── -->
<section class="cr-cta section section--dark">
  <div class="container">
    <h2>Think this is you?</h2>
    <p>Tell us who you'd sell to and how you'd go about it. We read everything that comes in.</p>
    <a class="btn btn--primary" href={APPLY} target="_blank" rel="noopener">Apply to sell DUSA</a>
    <p class="cr-cta__alt">
      Want to ask something first, or hear about running your own team?
      <a href="/contact" data-page="contact">Get in touch</a>.
    </p>
  </div>
</section>

<style>
  /* ── Theme tokens ──
     Every colour on this page resolves through these. The first version
     hardcoded dark-theme rgba values inline, which left seventeen elements at
     1:1 contrast in light mode — warm white text on a warm white page. Reef
     aqua is 1.61:1 on cream and cannot be used for text there at all, so light
     mode gets a darkened teal that clears AA. */
  .cr, .cr-hero, .cr-cta {
    --ink: var(--warm-white);
    --ink-soft: rgba(247, 244, 239, 0.62);
    --ink-mid: rgba(247, 244, 239, 0.5);
    --ink-faint: rgba(247, 244, 239, 0.4);
    --ink-dim: rgba(247, 244, 239, 0.34);
    --panel: rgba(247, 244, 239, 0.03);
    --panel-edge: rgba(247, 244, 239, 0.09);
    --rule: rgba(247, 244, 239, 0.07);
    --accent: var(--reef-aqua);
    --accent-soft: rgba(78, 216, 194, 0.5);
    --accent-wash: rgba(78, 216, 194, 0.06);
    --accent-edge: rgba(78, 216, 194, 0.22);
    --warn: rgba(240, 200, 140, 0.95);
    --warn-wash: rgba(232, 168, 78, 0.05);
    --warn-edge: rgba(232, 168, 78, 0.22);
    --field: rgba(12, 14, 20, 0.5);
  }
  :global(html[data-theme="light"]) .cr,
  :global(html[data-theme="light"]) .cr-hero,
  :global(html[data-theme="light"]) .cr-cta {
    --ink: var(--deep-black);
    --ink-soft: rgba(12, 14, 20, 0.7);
    --ink-mid: rgba(12, 14, 20, 0.62);
    --ink-faint: rgba(12, 14, 20, 0.55);
    --ink-dim: rgba(12, 14, 20, 0.5);
    --panel: rgba(12, 14, 20, 0.028);
    --panel-edge: rgba(12, 14, 20, 0.12);
    --rule: rgba(12, 14, 20, 0.09);
    --accent: #0F6E60;
    --accent-soft: rgba(15, 110, 96, 0.55);
    --accent-wash: rgba(15, 110, 96, 0.06);
    --accent-edge: rgba(15, 110, 96, 0.26);
    --warn: #8A5A0B;
    --warn-wash: rgba(176, 110, 16, 0.07);
    --warn-edge: rgba(176, 110, 16, 0.3);
    --field: #FFFFFF;
  }

  .cr-hero { padding-top: calc(var(--nav-height) + var(--space-xl)); text-align: center; }
  .cr-hero h1 { margin: var(--space-xs) 0 var(--space-sm); }
  .cr-hero__sub { max-width: 56ch; margin: 0 auto var(--space-lg); color: var(--ink-soft); font-size: 1.0625rem; }
  .cr-hero__cta { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; }

  .cr__pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .cr__pillars article {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--accent-wash); border: 1px solid var(--accent-edge);
  }
  .cr__pillars h3 { font-size: 1.0625rem; margin-bottom: 0.45rem; color: var(--ink); }
  .cr__pillars p { font-size: 0.9375rem; color: var(--ink-mid); max-width: none; }

  .cr__head { text-align: center; max-width: 720px; margin: 0 auto var(--space-lg); }
  .cr__head h2 { margin-top: var(--space-xs); }
  .cr__sub { color: var(--ink-mid); margin: var(--space-sm) auto 0; }

  .cr__ways { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .cr__way {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--panel); border: 1px solid var(--panel-edge);
  }
  .cr__way-tag {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }
  .cr__way h3 { font-size: 1.25rem; margin: 0.5rem 0 0.6rem; }
  .cr__way p { color: var(--ink-mid); font-size: 0.9375rem; max-width: none; }

  .cr__rates { margin-top: var(--space-lg); }
  .cr__rates-head, .cr__rate {
    display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr; gap: 1rem; align-items: center;
  }
  .cr__rates-head {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-dim);
    padding-bottom: 0.6rem; border-bottom: 1px solid var(--panel-edge);
  }
  .cr__rate { padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
  .cr__rate em { font-style: normal; display: grid; gap: 0.1rem; }
  .cr__rate i { font-style: normal; font-size: 0.6875rem; color: var(--ink-dim); }
  .cr__rate-name { display: grid; gap: 0.1rem; font-weight: 600; color: var(--ink); }
  .cr__rate-price { font-family: var(--font-mono); color: var(--ink-soft); }
  .cr__rate-you { font-family: var(--font-mono); font-weight: 700; color: var(--accent); }
  .cr__rates-note { margin-top: var(--space-sm); font-size: 0.8125rem; color: var(--ink-faint); max-width: none; }

  /* Calculators share the input styling. */
  .calc, .grow { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-md); }
  .calc__inputs, .calc__out, .grow__inputs, .grow__out {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--panel); border: 1px solid var(--panel-edge);
  }
  .calc__row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--rule);
  }
  .calc__row-name { display: grid; gap: 0.1rem; font-weight: 600; }
  .calc__row-name i { font-style: normal; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-faint); }
  .calc__row-ctrl { display: flex; align-items: center; gap: 0.4rem; }
  .calc__row-unit { font-family: var(--font-mono); color: var(--ink-faint); font-size: 0.875rem; }
  .calc__row-ctrl button {
    width: 32px; height: 32px; border-radius: 8px; cursor: pointer; flex-shrink: 0;
    background: var(--rule); border: 1px solid var(--panel-edge);
    color: var(--ink); font-size: 1rem; line-height: 1;
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .calc__row-ctrl button:hover { border-color: var(--accent-soft); color: var(--accent); }
  .calc__row-ctrl input {
    width: 60px; text-align: center; padding: 0.4rem;
    font-family: var(--font-mono); font-size: 1rem; color: var(--ink);
    background: var(--field); border: 1px solid var(--panel-edge); border-radius: 8px;
  }
  .calc__mode, .grow__plans { display: flex; gap: 0.5rem; margin-top: var(--space-sm); flex-wrap: wrap; align-items: center; }
  .calc__mode button, .grow__plans button {
    cursor: pointer; padding: 0.55rem 0.8rem;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; border-radius: 999px;
    background: var(--panel); border: 1px solid var(--panel-edge);
    color: var(--ink-mid);
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .calc__mode button { flex: 1; min-width: 150px; }
  .calc__mode button.is-on, .grow__plans button.is-on { color: var(--accent); border-color: var(--accent-soft); }
  .grow__plans-label {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-dim); width: 100%;
  }

  .calc__out { display: grid; align-content: center; justify-items: center; text-align: center; }
  .calc__out-label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .calc__out-value {
    font-family: var(--font-mono); font-weight: 700;
    font-size: clamp(2.5rem, 7vw, 4rem); line-height: 1.05;
    color: var(--accent); margin: 0.3rem 0 0.2rem;
  }
  .calc__out-sub { font-size: 0.875rem; color: var(--ink-mid); }
  .calc__out-year {
    display: flex; gap: 0.6rem; align-items: baseline; margin-top: var(--space-sm);
    padding-top: var(--space-sm); border-top: 1px solid var(--panel-edge);
    width: 100%; justify-content: center;
  }
  .calc__out-year span { font-size: 0.8125rem; color: var(--ink-faint); }
