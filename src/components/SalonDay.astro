        { from: 9.32, to: 9.58, who: cA, text: 'Um... my foils?' },
        { from: 10.6, to: 11.1, who: thera, text: 'No-show. Again.', thought: true },
        { from: 11.55, to: 11.95, who: owner, text: "Hi Jess, about last week's $180..." },
        { from: 13.45, to: 13.9, who: owner, text: 'Lunch later. DMs first.', thought: true },
