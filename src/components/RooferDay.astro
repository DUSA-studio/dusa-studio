      const partner = makePerson(0xe8907a, 0xd9a98a, false, 1.08); partner.g.visible = false; isle.add(partner.g);
      const kid = makePerson(0xf7c53a, 0xd9a98a, false, 0.7); kid.g.visible = false; isle.add(kid.g);
      const people = [roofer, crew1, crew2, partner, kid];

      /* A phone in the ute tray that rings. */
      const trayPhone = rbox(0.18, 0.36, 0.03, mat(0x14161c, { roughness: 0.4, metalness: 0.5 }), 0.02, 0, 0, 0);
      const ringLight = new THREE.PointLight(nice ? 0x4ed8c2 : 0xff6b5e, 0, 2.5); ringLight.position.set(UX, 1.1, UZ + 0.55); isle.add(ringLight);
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.02, 8, 40), new THREE.MeshBasicMaterial({ color: nice ? 0x4ed8c2 : 0xff6b5e, transparent: true, opacity: 0 }));
      ring.rotation.x = -Math.PI / 2; ring.position.set(UX, 0.82, UZ + 0.55); isle.add(ring);
      trayPhone.rotation.x = -Math.PI / 2; trayPhone.position.set(UX, 0.78, UZ + 0.55); isle.add(trayPhone);

      /* Targets per moment. Positions are on the island (y=0 is the grass). */
      const ROOF_Y = H + 1.35 - 0.1;
      type Target = { pos: THREE.Vector3; rot: number; pose: Pose; show?: boolean };
      const tg = (pos: THREE.Vector3, rot: number, pose: Pose, show = true): Target => ({ pos, rot, pose, show });
      const atRoof = (dx: number, dz = 0) => tg(V(HX + dx, ROOF_Y - Math.abs(dx) * 0.55, HZ + dz), 0.4, 'hammer');
      const byUte = (dx: number, dz: number, pose: Pose = 'stand', rot = -1.2) => tg(V(UX + dx, 0, UZ + dz), rot, pose);
      const LADDER_FOOT = tg(V(HX + W / 2 + 1.5, 0, HZ + 1.2), -2.4, 'stand');
      const SMOKO = { roofer: tg(V(2.6, 0, -3.0), 0.5, 'sitMug'), crew1: tg(V(1.5, 0, -2.5), 1.0, 'sitMug'), crew2: tg(V(3.7, 0, -2.55), -0.9, 'sitMug'), pace: tg(V(5.3, 0, 1.4), -2.2, 'phone') };
      const hidden = tg(V(0, -3, 0), 0, 'stand', false);
      const beats: { roofer: Target; crew1: Target; crew2: Target; partner: Target; kid: Target; smoko: boolean; home: boolean; ring: boolean }[] = [
        // 6:40 at the ute, unloading. Without: on the phone to voicemail.
        { roofer: nice ? byUte(-0.9, 2.1, 'carry', -0.4) : byUte(0.9, 2.3, 'phone', -2.6), crew1: byUte(-0.2, 2.0, 'carry', -0.9), crew2: byUte(0.9, 1.6, 'stand', -2.0), partner: hidden, kid: hidden, smoko: false, home: false, ring: false },
        // 9:15 on the roof. The phone rings in the ute.
        { roofer: atRoof(0.3), crew1: atRoof(-0.2, 1.0), crew2: LADDER_FOOT, partner: hidden, kid: hidden, smoko: false, home: false, ring: true },
        // 10:30 smoko. With: three on the esky. Without: two sit, the roofer paces with the phone.
        { roofer: nice ? SMOKO.roofer : SMOKO.pace, crew1: SMOKO.crew1, crew2: SMOKO.crew2, partner: hidden, kid: hidden, smoko: true, home: false, ring: false },
        // 11:30 back on the roof. Without: at the ute trying to write the quote.
        { roofer: nice ? atRoof(0.3) : byUte(0.9, 2.3, 'phone', -2.6), crew1: atRoof(-0.2, 1.0), crew2: LADDER_FOOT, partner: hidden, kid: hidden, smoko: false, home: false, ring: false },
        // 1:30 on the roof.
        { roofer: atRoof(0.3), crew1: atRoof(-0.2, 1.0), crew2: nice ? atRoof(0.1, -1.0) : byUte(0.9, 2.3, 'phone', -2.6), partner: hidden, kid: hidden, smoko: false, home: false, ring: !nice },
        // 4:45 packing up. Without: the roofer is still on the roof alone.
        { roofer: nice ? byUte(-0.9, 2.1, 'carry', -0.4) : atRoof(0.3), crew1: byUte(-0.2, 2.0, 'carry', -0.9), crew2: byUte(0.9, 1.6, 'stand', -2.0), partner: hidden, kid: hidden, smoko: false, home: false, ring: false },
        // 9:00 home. With: family at the table. Without: laptop.
        { roofer: tg(V(HX + (nice ? -0.55 : 0), 0.14, HZ + 2.7 + 0.6), Math.PI, nice ? 'sit' : 'laptop'), crew1: hidden, crew2: hidden, partner: nice ? tg(V(HX + 0.6, 0.14, HZ + 2.7 + 0.6), Math.PI, 'sit') : hidden, kid: nice ? tg(V(HX, 0.14, HZ + 2.7 - 0.6), 0, 'sit') : hidden, smoko: false, home: true, ring: false },
      ];

      /* Light by moment: sun position, warmth, night. */
      const sunPos = [V(-9, 3, 6), V(-6, 8, 5), V(-3, 10, 4), V(1, 11, 3), V(5, 9, 4), V(9, 4, 5), V(4, 6, -6)];
      const sunCol = [0xffb27a, 0xfff1dc, 0xffffff, 0xffffff, 0xfff4e4, 0xffa070, 0x6f86b8];
      const sunInt = [1.5, 2.3, 2.6, 2.7, 2.4, 1.8, 0.35];
      const hemiInt = [0.8, 1.1, 1.2, 1.2, 1.1, 0.9, 0.25];

      let beat = 0, lastT = 0, running = false, pingAt = -1e9;
      const cur = { sun: V(-6, 8, 5), col: new THREE.Color(0xffffff), sunI: 2, hemiI: 1, night: 0, smoko: 0, home: 0 };
      const setBeat = (b: number) => { beat = b; pingAt = performance.now(); people.forEach((p, i) => { const t = [beats[b].roofer, beats[b].crew1, beats[b].crew2, beats[b].partner, beats[b].kid][i]; p.setPose(t.pose); }); };

      const resize = () => {
        const w = stage.clientWidth, h = stage.clientHeight;
        renderer.setSize(w, h, false);
        const aspect = w / h;
        const halfW = aspect < 1 ? 7.6 : 9.6;
        camera.left = -halfW; camera.right = halfW; camera.top = halfW / aspect; camera.bottom = -halfW / aspect;
        camera.updateProjectionMatrix();
      };

      const frame = (now: number) => {
        if (!running) return;
        const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016); lastT = now;
        const B = beats[beat];
        const night = beat === 6 ? 1 : 0;
        // Lights ease toward the moment.
        cur.sun.lerp(sunPos[beat], 1 - Math.exp(-2 * dt));
        cur.col.lerp(new THREE.Color(sunCol[beat]), 1 - Math.exp(-2 * dt));
        cur.sunI = damp(cur.sunI, sunInt[beat], 2, dt); cur.hemiI = damp(cur.hemiI, hemiInt[beat], 2, dt);
        cur.night = damp(cur.night, night, 2, dt);
        sun.position.copy(cur.sun); sun.color.copy(cur.col); sun.intensity = cur.sunI; hemi.intensity = cur.hemiI;
        hemi.color.set(0xdff2ff).lerp(new THREE.Color(0x3b5a8c), cur.night);
        winM.emissiveIntensity = cur.night * (nice ? 1.4 : 0.35);
        warmLight.intensity = cur.night * 3.2; bulb.material.emissiveIntensity = cur.night * 1.5;
        coldLight.intensity = cur.night * 2.6; laptopScreen.material.emissiveIntensity = cur.night * 2.2;
        // Scene swaps.
        cur.smoko = damp(cur.smoko, B.smoko ? 1 : 0, 6, dt); smoko.scale.setScalar(Math.max(0.001, cur.smoko));
        cur.home = damp(cur.home, B.home ? 1 : 0, 5, dt); home.scale.setScalar(Math.max(0.001, cur.home));
        ladder.visible = cur.home < 0.5; trayPhone.visible = ring.visible = cur.home < 0.5;
        // People drift to their marks.
        const targets = [B.roofer, B.crew1, B.crew2, B.partner, B.kid];
        people.forEach((p, i) => {
          const t = targets[i];
          p.g.visible = t.show !== false || p.g.position.y > -2.5;
          const k = 1 - Math.exp(-3.5 * dt);
          p.g.userData.baseY = THREE.MathUtils.lerp(p.g.userData.baseY ?? t.pos.y, t.pos.y, k);
          p.g.position.x = THREE.MathUtils.lerp(p.g.position.x, t.pos.x, k);
          p.g.position.z = THREE.MathUtils.lerp(p.g.position.z, t.pos.z, k);
          let dr = t.rot - p.g.rotation.y; dr = Math.atan2(Math.sin(dr), Math.cos(dr));
          p.g.rotation.y += dr * k;
          p.tick(now, dt);
        });
        // Pacing without DUSA at smoko.
        if (!nice && beat === 2) roofer.g.position.x += Math.sin(now / 1200) * 0.004;
        // The tray phone pings when a moment lands.
        const since = (now - pingAt) / 1000;
        const pulse = B.ring ? (Math.sin(now / 180) * 0.5 + 0.5) : since < 1.4 ? 1 - since / 1.4 : 0;
        ring.material.opacity = pulse * 0.9; ring.scale.setScalar(1 + (1 - pulse) * 0.6);
        ringLight.intensity = pulse * 1.6;
        // The island breathes.
        isle.position.y = Math.sin(now / 2600) * 0.06;
        isle.rotation.y = 0.35 + Math.sin(now / 5200) * 0.015;
        // Camera: isometric, a touch closer at home.
        const zoom = 1 + cur.home * 0.22;
        // The island is turned 0.35 rad, so marks are rotated into world space before the camera looks at them.
        const rx = (x: number, z: number) => x * Math.cos(0.35) + z * Math.sin(0.35), rz = (x: number, z: number) => -x * Math.sin(0.35) + z * Math.cos(0.35);
        const hx = HX + 3.4, hz = HZ + 1.2;
        const cx = THREE.MathUtils.lerp(0, rx(hx, hz), cur.home), cz = THREE.MathUtils.lerp(0, rz(hx, hz), cur.home);
        camera.position.set(cx + 14, 12.5, cz + 14); camera.lookAt(cx, 0.3, cz); camera.zoom = zoom; camera.updateProjectionMatrix();
        renderer.render(scene, camera);
        requestAnimationFrame(frame);
      };
      const start = () => { if (running) return; running = true; lastT = performance.now(); resize(); requestAnimationFrame(frame); };
      const stop = () => { running = false; };
      setBeat(0);
      return { setBeat, resize, start, stop, renderOnce: () => { resize(); renderer.render(scene, camera); } };
    };

    const worlds = [makeWorld(false, canvases.off), makeWorld(true, canvases.on)];
    window.addEventListener('resize', () => worlds.forEach((w) => w.resize()));

    /* ── Timeline ── */
    let beat = 0, timer = 0, paused = false, started = false;
    const show = (b: number) => {
      beat = (b + N) % N;
      stage.setAttribute('data-beat', String(beat));
      worlds.forEach((w) => w.setBeat(beat));
      times.forEach((t, i) => {
        t.classList.toggle('is-on', i === beat); t.classList.toggle('is-past', i < beat);
        t.setAttribute('aria-selected', i === beat ? 'true' : 'false');
        const bar = t.querySelector<HTMLElement>('.ww__time-bar span');
        if (bar && i === beat) { bar.style.transition = 'none'; bar.style.width = '0'; void bar.offsetWidth; bar.style.transition = ''; bar.style.width = ''; }
      });
      pairs.forEach((p, i) => { if (i === beat) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); });
      clocks.forEach((c) => (c.textContent = times[beat].querySelector('b')?.firstChild?.textContent || ''));
      notifSets.forEach((set) => {
        const order: HTMLElement[] = [];
        set.forEach((n, i) => { if (i <= beat && i > beat - 3) order.push(n); else n.setAttribute('hidden', ''); });
        order.reverse().forEach((n, k) => { n.removeAttribute('hidden'); n.style.order = String(k); n.style.opacity = k === 0 ? '1' : k === 1 ? '0.85' : '0.65'; n.style.transform = k === 0 ? '' : `scale(${1 - k * 0.03})`; });
      });
    };
    const queue = () => { clearTimeout(timer); if (paused || reduced) return; timer = window.setTimeout(() => { show(beat + 1); queue(); }, HOLD); };
    const pause = () => { paused = true; clearTimeout(timer); };
    const resume = () => { paused = false; queue(); };
    times.forEach((t, i) => t.addEventListener('click', () => { show(i); queue(); }));
    stage.addEventListener('mouseenter', () => clearTimeout(timer));
    stage.addEventListener('mouseleave', () => { if (!dragging) queue(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : queue()));

    show(0);
    const start = () => {
      if (started) return; started = true;
      worlds.forEach((w) => w.start());
      queue();
      if (reduced) return;
      stage.classList.add('is-nudging');
      setTimeout(() => setX(62), 600);
      setTimeout(() => setX(44), 1500);
      setTimeout(() => setX(50), 2400);
      setTimeout(() => stage.classList.remove('is-nudging'), 3200);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) start(); else worlds.forEach((w) => w.stop()); if (e.isIntersecting && started) worlds.forEach((w) => w.start()); }), { threshold: 0.2 }).observe(stage);
    } else start();
  });
</script>
