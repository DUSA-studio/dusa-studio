---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/t.js';
import tData from '../../i18n/translations/de.json';

const lang = 'de';
const region = 'de';

const services = [
  { title: t(lang, 'services.service1Title'), desc: t(lang, 'services.service1Desc'), icon: 'M8 12h8M12 8v8', examples: [t(lang, 'services.service1Ex1'), t(lang, 'services.service1Ex2'), t(lang, 'services.service1Ex3'), t(lang, 'services.service1Ex4'), t(lang, 'services.service1Ex5')] },
  { title: t(lang, 'services.service2Title'), desc: t(lang, 'services.service2Desc'), icon: 'M13 10V3L4 14h7v7l9-11h-7z', examples: [t(lang, 'services.service2Ex1'), t(lang, 'services.service2Ex2'), t(lang, 'services.service2Ex3'), t(lang, 'services.service2Ex4'), t(lang, 'services.service2Ex5')] },
  { title: t(lang, 'services.service3Title'), desc: t(lang, 'services.service3Desc'), icon: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7M1 4h22M10 11v6M14 11v6', examples: [t(lang, 'services.service3Ex1'), t(lang, 'services.service3Ex2'), t(lang, 'services.service3Ex3'), t(lang, 'services.service3Ex4'), t(lang, 'services.service3Ex5')] },
  { title: t(lang, 'services.service4Title'), desc: t(lang, 'services.service4Desc'), icon: 'M18 20V10M12 20V4M6 20v-6', examples: [t(lang, 'services.service4Ex1'), t(lang, 'services.service4Ex2'), t(lang, 'services.service4Ex3'), t(lang, 'services.service4Ex4'), t(lang, 'services.service4Ex5')] },
  { title: t(lang, 'services.service5Title'), desc: t(lang, 'services.service5Desc'), icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6', examples: [t(lang, 'services.service5Ex1'), t(lang, 'services.service5Ex2'), t(lang, 'services.service5Ex3'), t(lang, 'services.service5Ex4'), t(lang, 'services.service5Ex5')] },
  { title: t(lang, 'services.service6Title'), desc: t(lang, 'services.service6Desc'), icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75', examples: [t(lang, 'services.service6Ex1'), t(lang, 'services.service6Ex2'), t(lang, 'services.service6Ex3'), t(lang, 'services.service6Ex4'), t(lang, 'services.service6Ex5')] },
];
---

<BaseLayout title={t(lang, 'services.metaTitle')} description={t(lang, 'services.metaDesc')} lang="de" ogLocale="de_DE" region={region} t={tData}>
  <section class="services-hero section section--dark">
    <div class="container">
      <div class="services-hero__content">
        <span class="label">{t(lang, 'services.eyebrow')}</span>
        <h1>{t(lang, 'services.title')} <span class="gradient-text">{t(lang, 'services.titleAccent')}</span>,<br />{t(lang, 'services.titleEnd')}</h1>
        <p class="services-hero__sub">{t(lang, 'services.sub')}</p>
      </div>
    </div>
  </section>
  <section class="services-grid section--dark">
    <div class="container">
      <div class="services-grid__cards">
        {services.map((s) => (
          <div class="services-card">
            <div class="services-card__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg></div>
            <h2 class="services-card__title">{s.title}</h2>
            <p class="services-card__desc">{s.desc}</p>
            <ul class="services-card__list">{s.examples.map((ex) => (<li>{ex}</li>))}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="services-process section--dark">
    <div class="container">
      <h2 class="services-process__title">{t(lang, 'services.processTitle')}</h2>
      <div class="services-process__steps">
        <div class="services-process__step"><div class="services-process__num">{t(lang, 'services.process1Num')}</div><h3 class="services-process__step-title">{t(lang, 'services.process1Title')}</h3><p class="services-process__step-desc">{t(lang, 'services.process1Desc')}</p></div>
        <div class="services-process__step"><div class="services-process__num">{t(lang, 'services.process2Num')}</div><h3 class="services-process__step-title">{t(lang, 'services.process2Title')}</h3><p class="services-process__step-desc">{t(lang, 'services.process2Desc')}</p></div>
        <div class="services-process__step"><div class="services-process__num">{t(lang, 'services.process3Num')}</div><h3 class="services-process__step-title">{t(lang, 'services.process3Title')}</h3><p class="services-process__step-desc">{t(lang, 'services.process3Desc')}</p></div>
        <div class="services-process__step"><div class="services-process__num">{t(lang, 'services.process4Num')}</div><h3 class="services-process__step-title">{t(lang, 'services.process4Title')}</h3><p class="services-process__step-desc">{t(lang, 'services.process4Desc')}</p></div>
      </div>
    </div>
  </section>
  <section class="services-cta section--dark">
    <div class="container">
      <div class="services-cta__box">
        <h2 class="services-cta__title">{t(lang, 'services.ctaTitle')}</h2>
        <p class="services-cta__desc">{t(lang, 'services.ctaDesc')}</p>
        <a href={`/${region}/contact`} class="btn btn--primary services-cta__btn">{t(lang, 'services.ctaBtn')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero { padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-2xl); text-align: center; }
  .services-hero__content { max-width: 700px; margin: 0 auto; text-align: center; }
  .services-hero__sub { max-width: 680px; margin: 0 auto; font-size: 1.125rem; line-height: 1.7; color: rgba(247, 244, 239, 0.65); }
  .services-grid { padding: var(--space-xl) 0 var(--space-2xl); }
  .services-grid__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .services-card { background: rgba(247, 244, 239, 0.03); border: 1px solid rgba(247, 244, 239, 0.06); border-radius: var(--radius-lg, 16px); padding: var(--space-lg); transition: border-color var(--duration-fast), transform var(--duration-fast); }
  .services-card:hover { border-color: rgba(78, 216, 194, 0.25); transform: translateY(-2px); }
  .services-card__icon-wrap { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(78, 216, 194, 0.08); border: 1px solid rgba(78, 216, 194, 0.15); border-radius: var(--radius-md, 8px); margin-bottom: var(--space-md); }
  .services-card__icon-wrap svg { width: 24px; height: 24px; color: var(--reef-aqua); }
  .services-card__title { font-family: var(--font-headline); font-size: 1.25rem; font-weight: 600; color: var(--warm-white); margin-bottom: var(--space-xs); }
  .services-card__desc { font-size: 1rem; line-height: 1.65; color: rgba(247, 244, 239, 0.6); margin-bottom: var(--space-md); }
  .services-card__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .services-card__list li { font-size: 0.875rem; color: rgba(247, 244, 239, 0.5); padding-left: 1.25rem; position: relative; }
  .services-card__list li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; border-radius: 50%; background: var(--reef-aqua); opacity: 0.5; }
  .services-process { padding: var(--space-2xl) 0; border-top: 1px solid rgba(247, 244, 239, 0.06); }
  .services-process__title { font-family: var(--font-headline); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; color: var(--warm-white); text-align: center; margin-bottom: var(--space-xl); }
  .services-process__steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
  .services-process__step { text-align: center; }
  .services-process__num { font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: var(--reef-aqua); opacity: 0.3; margin-bottom: var(--space-xs); }
  .services-process__step-title { font-family: var(--font-headline); font-size: 1.125rem; font-weight: 600; color: var(--warm-white); margin-bottom: var(--space-xs); }
  .services-process__step-desc { font-size: 0.9375rem; line-height: 1.6; color: rgba(247, 244, 239, 0.55); }
  .services-cta { padding: var(--space-xl) 0 var(--space-2xl); }
  .services-cta__box { text-align: center; padding: var(--space-xl); background: rgba(78, 216, 194, 0.04); border: 1px solid rgba(78, 216, 194, 0.12); border-radius: var(--radius-lg, 16px); }
  .services-cta__title { font-family: var(--font-headline); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--warm-white); margin-bottom: var(--space-xs); }
  .services-cta__desc { font-size: 1.0625rem; color: rgba(247, 244, 239, 0.6); margin-bottom: var(--space-lg); }
  .services-cta__btn { display: inline-block; }
  @media (max-width: 1024px) { .services-grid__cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .services-grid__cards { grid-template-columns: 1fr; } .services-process__steps { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); } }
  @media (max-width: 480px) { .services-process__steps { grid-template-columns: 1fr; } .services-hero { padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-lg); } }
  :global(html[data-theme="light"]) .services-card__title, :global(html[data-theme="light"]) .services-process__title, :global(html[data-theme="light"]) .services-process__step-title, :global(html[data-theme="light"]) .services-cta__title { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .services-hero__sub, :global(html[data-theme="light"]) .services-card__desc, :global(html[data-theme="light"]) .services-process__step-desc, :global(html[data-theme="light"]) .services-cta__desc { color: rgba(12, 14, 20, 0.65); }
  :global(html[data-theme="light"]) .services-card { background: rgba(12, 14, 20, 0.02); border-color: rgba(12, 14, 20, 0.08); }
  :global(html[data-theme="light"]) .services-card:hover { border-color: rgba(78, 216, 194, 0.35); }
  :global(html[data-theme="light"]) .services-card__list li { color: rgba(12, 14, 20, 0.55); }
  :global(html[data-theme="light"]) .services-cta__box { background: rgba(78, 216, 194, 0.06); border-color: rgba(78, 216, 194, 0.15); }
  :global(html[data-theme="light"]) .services-process { border-top-color: rgba(12, 14, 20, 0.08); }
</style>
