    let onType: ((v: string) => void) | null = null;
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value.trim(); if (!v || !onType) return; input.value = ''; onType(v); });
    const setInput = (placeholder: string, type = 'text') => { input.type = type; input.placeholder = placeholder; input.autocomplete = type === 'email' ? 'email' : type === 'tel' ? 'tel' : placeholder.includes('name') && !placeholder.includes('Business') ? 'given-name' : 'off'; };
    const ask = <X,>(opts: { label: string; value: X; tag?: string; cls?: string }[], o: { placeholder?: string; type?: string; free?: (v: string) => X | null; echo?: boolean } = {}) => new Promise<X>((resolve) => {
      quick.innerHTML = '';
      setInput(o.placeholder || 'Message', o.type || 'text');
      const done = (v: X, label: string) => { quick.innerHTML = ''; onType = null; if (o.echo !== false) me(label); setInput('Message'); resolve(v); };
      opts.forEach((op, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = `ride__chip ${op.cls || ''}`; b.style.animationDelay = `${i * 40}ms`; b.innerHTML = `${esc(op.label)}${op.tag ? `<em>${esc(op.tag)}</em>` : ''}`; b.addEventListener('click', () => done(op.value, op.label)); quick.appendChild(b); });
      requestAnimationFrame(scroll);
      onType = (v) => { const r = o.free ? o.free(v) : null; if (r !== null && r !== undefined) done(r, v); else { me(v); say("Sorry, didn't catch that. Tap one of these?"); } };
      if (!opts.length || o.type) setTimeout(() => { if (matchMedia('(hover: hover)').matches) input.focus({ preventScroll: true }); }, 60);
    });
    const multi = (keys: string[], preset: string[]) => new Promise<string[]>((resolve) => {
      quick.innerHTML = ''; const chosen = new Set(preset);
      keys.forEach((k, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = `ride__chip${chosen.has(k) ? ' is-on' : ''}`; b.style.animationDelay = `${i * 30}ms`; b.textContent = NEEDS[k].short; b.addEventListener('click', () => { chosen.has(k) ? chosen.delete(k) : chosen.add(k); b.classList.toggle('is-on'); }); quick.appendChild(b); });
      const go = document.createElement('button'); go.type = 'button'; go.className = 'ride__chip ride__chip--go'; go.textContent = 'Done';
      go.addEventListener('click', () => { quick.innerHTML = ''; const v = [...chosen]; me(v.map((k) => NEEDS[k].short).join(', ') || 'Not sure yet'); resolve(v); });
      quick.appendChild(go); requestAnimationFrame(scroll);
      onType = (v) => { const tl = v.toLowerCase(); Object.keys(NEEDS).forEach((k) => { if (NEEDS[k].short.toLowerCase().split(' ').some((w) => w.length > 4 && tl.includes(w))) chosen.add(k); }); quick.innerHTML = ''; me(v); resolve([...chosen]); };
    });
    let meterNow = 0;
    const tickMeter = () => { meter.hidden = false; const to = quote().monthly, from = meterNow, s0 = performance.now(); const st = (tt: number) => { const k = Math.min(1, (tt - s0) / 700); meterNow = from + (to - from) * k; meterVal.textContent = `${money(meterNow)}/mo`; if (k < 1) requestAnimationFrame(st); }; requestAnimationFrame(st); };
    const send = async (event: string) => {
      const payload = { event, ...lead, codes: codesFor(), quote: quote(), page: location.pathname, at: new Date().toISOString() };
      (window as any).__rideLead = payload;
      const hook = root.dataset.webhook;
      if (!hook) { console.info('[ride] no webhook yet', payload); return; }
      try { await fetch(hook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }); } catch (e) { console.warn('[ride] send failed', e); }
    };
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const setClock = () => { const d = new Date(); clock.textContent = `${d.getHours() % 12 || 12}:${String(d.getMinutes()).padStart(2, '0')}`; };
    setClock(); setInterval(setClock, 30000);

    /* ═════════ The ride ═════════ */
    const run = async () => {
      state.carTarget = PICK_X; chapter(0);
      await wait(2600);
      status.textContent = 'At the kerb';
      await say("Hey! Grab the umbrella.");
      await say("I'm your DUSA Growth Lead. Want a chat on the way, or straight to the price?");
      const mode = await ask([{ label: "Let's chat", value: 'chat' }, { label: 'Skip the small talk', value: 'quiet', cls: 'ride__chip--ghost' }], { free: (v) => (/skip|price|quick|straight/i.test(v) ? 'quiet' : 'chat') });
      lead.quiet = mode === 'quiet';
      await say(lead.quiet ? 'Easy. First name?' : "Lovely. What's your name?");
      chapter(1);
      lead.name = await ask<string>([], { placeholder: 'Your first name', free: (v) => v.trim().split(/\s+/)[0].replace(/^./, (c) => c.toUpperCase()) });
      if (!lead.quiet) await say(`Nice to meet you, ${lead.name}. Jump in, let's get you out of the rain.`);
      state.board = 0.01; await wait(1500); goStep(1); status.textContent = 'On the way';
      await say(lead.quiet ? 'Business name?' : "What's the business called?");
      lead.business = await ask<string>([], { placeholder: 'Business name', free: (v) => v });
      goStep(2);
      await say(lead.quiet ? 'What do you do?' : `${lead.business}. Love it. What do you do?`);
      const ind = await ask(INDUSTRIES.map((i) => ({ label: i.label, value: i.id })), { placeholder: 'Or type it', free: (v) => { lead.industryText = v; return matchOpt(v, INDUSTRIES)?.id || 'other'; } });
      lead.industry = ind; const I = INDUSTRIES.find((i) => i.id === ind)!;
      goStep(3); chapter(2);
      if (!lead.quiet) await say(`We look after plenty of ${I.plural}, ${lead.name}. What helps them most:`);
      await card(`<ol>${I.top.map(([k, o]) => `<li><span>${esc(NEEDS[k].text)}<em>${esc(o)}</em></span></li>`).join('')}</ol>`);
      await say(lead.quiet ? 'Want all three?' : 'Sound like you?');
      const fit = await ask([{ label: 'Yes, all three', value: 'all' }, { label: 'Some of them', value: 'some' }, { label: 'Something else', value: 'else' }], { free: (v) => (/^(y|yes|yep|yeah|all)/i.test(v) ? 'all' : /some|few|two|one/i.test(v) ? 'some' : 'else') });
      const top = I.top.map(([k]) => k);
      if (fit === 'all') lead.needs = top;
      else if (fit === 'some') { await say('Tap the ones that fit.'); lead.needs = await multi(top, top); }
      else { await say('Tap what fits.'); lead.needs = await multi(Object.keys(NEEDS), []); }
      goStep(4);
      if (!lead.quiet) await say(lead.needs.length ? 'Easy. We fix those every day.' : "No worries. We'll start with never missing a call.");
      chapter(3);
      await say('How do you want to get there?');
      lead.seat = await ask(SEATS.map((s) => ({ label: s.label, value: s.id, tag: s.tag })), { free: (v) => matchOpt(v, SEATS)?.id || null });
      const S = SEATS.find((s) => s.id === lead.seat)!;
      goStep(6);
      if (!lead.quiet) await say(S.reply);
      await say('And how far are we going?');
      lead.distance = await ask(DIST.map((d) => ({ label: d.label, value: d.id })), { free: (v) => matchOpt(v, DIST)?.id || null });
      tickMeter(); goStep(8); send('profile');
      if (!lead.quiet && lead.seat !== 'self') await say(`Right. For ${lead.business}: ${lead.needs.slice(0, 2).map((k: string) => NEEDS[k].short.toLowerCase()).join(' and ') || 'never miss a call'}.`);
      goStep(STEPS); chapter(4); status.textContent = 'Arriving';
      await wait(2600);
      await say(`Here we are, ${lead.name}. Home.`);
      const q = quote(); lead.quote = q;
      await card(`<h4>DUSA · YOUR TRIP <span>#${String(Date.now()).slice(-5)}</span></h4><p>${esc(lead.name)}, ${esc(lead.business)} · ${SEAT_NAME[lead.seat]}</p><ul>${q.lines.map((l) => `<li class="${l.save ? 'is-save' : ''}"><span>${esc(l.label)}</span><b>${l.oneoff ? money(l.oneoff) + ' once' : money(l.price)}</b></li>`).join('')}</ul><div class="t"><span>Monthly</span><b>${money(q.monthly)}</b></div><div class="s"><span>Set-up, one-off</span><b>${q.setup ? money(q.setup) : 'None'}</b></div><small>AUD ex GST. Month to month. AI, SMS and ad spend at cost.${q.nudge ? `<b>${esc(q.nudge)}</b>` : ''}${lead.seat !== 'self' ? '<b>Rather drive yourself? DUSA from $47/mo.</b>' : ''}</small>`, 'ride__fare');
      status.textContent = 'Home';
      await say('Want this in your inbox?');
      const email = await ask<string>([{ label: 'Not now', value: '', cls: 'ride__chip--ghost' }], { placeholder: 'Your email', type: 'email', free: (v) => (/\S+@\S+\.\S+/.test(v) ? v : null) });
      lead.email = email; if (email) send('quote');
      await say(email ? 'Sent. Okay if we give you a call?' : 'Okay if we give you a call?');
      lead.callOk = await ask([{ label: 'Yes, call me', value: true }, { label: "I'll call you", value: false }], { free: (v) => (/^(y|yes|sure|ok|yep|yeah)/i.test(v) ? true : /^(n|no|nah)/i.test(v) ? false : null) });
      if (lead.callOk) { await say('Best number?'); lead.phone = await ask<string>([], { placeholder: 'Mobile number', type: 'tel', free: (v) => (v.replace(/\D/g, '').length >= 8 ? v : null) }); send('callback'); await say(`Thanks ${lead.name}. Talk soon.`); }
      else await say(`All good. Call us any time: ${PHONE}.`);
      const doneFor = lead.seat === 'back' || lead.seat === 'front';
      const end = await ask([
        { label: doneFor ? 'Pay set-up and book kick-off' : 'Start my free trial', value: 'go', cls: 'ride__chip--go' },
        { label: 'Talk to the Growth Lead (10 min)', value: 'talk' },
        ...(lead.seat !== 'self' ? [{ label: 'Drive myself, from $47', value: 'self', cls: 'ride__chip--ghost' }] : []),
      ], { echo: false });
      send(end);
      if (end === 'talk') window.open(root.dataset.lead, '_blank', 'noopener');
      else location.href = end === 'go' && doneFor ? (root.dataset.book || '/start') : '/start';
    };

    let started = false;
    new IntersectionObserver((es) => es.forEach((e) => {
      const was = visible; visible = e.isIntersecting;
      if (visible && !was) { last = performance.now(); requestAnimationFrame(tick); }
      if (visible && !started && e.intersectionRatio > 0.45) { started = true; run(); }
    }), { threshold: [0, 0.45] }).observe(stage);
    renderer.render(scene, cam);
    if (location.hostname === 'localhost') (window as any).__ride = { lead, quote, codesFor, state, goStep };
    void phoneUI;
  });
</script>
