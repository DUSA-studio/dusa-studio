<script>
  // Play when the section enters, replay on re-entry (a once-only animation
  // you scrolled past can never be seen again on a review page).
  (function () {
    const el = document.querySelector('[data-week]');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { el.setAttribute('data-live', ''); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { el.setAttribute('data-live', ''); }
        else if (e.boundingClientRect.top > 0) { el.removeAttribute('data-live'); }
      });
    }, { threshold: 0.12 });
    io.observe(el);
  })();
</script>
