      const people: { p: ReturnType<typeof makePerson>; keys: Key[] }[] = [
        { p: owner, keys: sched.owner }, { p: thera, keys: sched.thera }, { p: nurse, keys: sched.nurse }, { p: cA, keys: sched.cA }, { p: cB, keys: sched.cB }, { p: cC, keys: sched.cC }, { p: cD, keys: sched.cD }, { p: cE, keys: sched.cE }, { p: cF, keys: sched.cF }, { p: cH, keys: sched.cH }, { p: partner, keys: sched.partner }, { p: kid, keys: sched.kid },
