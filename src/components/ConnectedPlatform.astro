    border-radius: 999px; padding: 0.1rem 0.4rem; margin-bottom: 0.1rem;
  }
  .cp__tip.is-ai .cp__tip-ai { display: inline-block; }
  .cp__tip-name {
    font-family: var(--font-headline); font-size: 0.9375rem; font-weight: 700;
    color: var(--warm-white); line-height: 1.2;
