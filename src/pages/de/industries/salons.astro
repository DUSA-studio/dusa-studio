---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';
---

<BaseLayout t={tData} title="Terminautomatisierung für Salons & Spas | DUSA . studio" description="Automatisieren Sie Buchungen, reduzieren Sie No-Shows und sorgen Sie dafür, dass Kunden wiederkommen. DUSA bietet Salons und Spas ein komplettes Wachstumssystem mit Erinnerungen, Wiederbuchungskampagnen und Bewertungsanfragen.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://dusa.studio/de/" },
      { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://dusa.studio/de/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Salons & Spas", "item": "https://dusa.studio/de/industries/salons/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Salons &amp; Spas</span>
        <h1>Schluss mit Umsatzverlusten durch<br/><span class="gradient-text">No-Shows und verpasste Wiederbuchungen</span></h1>
        <p class="industry-hero__sub">DUSA gibt Ihrem Salon ein einziges System, um jeden Platz zu füllen, Kunden zum Wiederkommen zu bewegen und einen Ruf aufzubauen, der automatisch wächst.</p>
        <div class="industry-hero__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Demo buchen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">Das Problem</span>
      <h2>Kommt Ihnen das bekannt vor?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">📵</div>
          <h3>No-Shows kosten Sie Umsatz</h3>
          <p>Leere Stühle bedeuten verlorenes Einkommen. Ohne automatische Erinnerungen vergessen Kunden ihren Termin, und Sie zahlen den Preis.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📞</div>
          <h3>Telefonspielchen bei jeder Buchung</h3>
          <p>Sie schneiden Haare, nicht Telefonate. Aber jeder verpasste Anruf ist ein potenzieller Kunde, der zur Konkurrenz geht.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🔄</div>
          <h3>Kunden vergessen, neu zu buchen</h3>
          <p>Der Termin war toll, aber der Alltag hat sie eingeholt. Ohne einen kleinen Anstoß werden aus Wochen schnell Monate ohne Kontakt.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📋</div>
          <h3>Keine Kundenpräferenzen gespeichert</h3>
          <p>Sich die Farbformel, den bevorzugten Stylisten und die Produktvorlieben jedes Kunden zu merken, wird ab einer gewissen Größe unmöglich.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">Die Lösung</span>
      <h2>So funktioniert DUSA für <span class="gradient-text">Salons und Spas</span></h2>
      <p class="solution__intro">Eine Plattform ersetzt Ihre Buchungs-App, Erinnerungs-SMS, Bewertungstools und Kunden-Tabellen.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Online-Buchung</h3>
          <p>Lassen Sie Kunden rund um die Uhr über Ihre Website, Instagram oder Google buchen. Keine Telefonanrufe nötig.</p>
        </div>
        <div class="solution-card">
          <h3>Automatische Erinnerungen</h3>
          <p>SMS- und E-Mail-Erinnerungen gehen vor jedem Termin automatisch raus. Reduzieren Sie No-Shows, ohne einen Finger zu rühren.</p>
        </div>
        <div class="solution-card">
          <h3>Wiederbuchungskampagnen</h3>
          <p>Wenn ein Kunde überfällig ist, sendet DUSA einen personalisierten Anstoß, um ihn zurück in den Stuhl zu bringen.</p>
        </div>
        <div class="solution-card">
          <h3>Kundenpräferenz-Notizen</h3>
          <p>Speichern Sie Farbformeln, Produktvorlieben und Sitzungsnotizen an einem Ort, auf den Ihr gesamtes Team zugreifen kann.</p>
        </div>
        <div class="solution-card">
          <h3>Bewertungsanfragen</h3>
          <p>Bitten Sie zufriedene Kunden automatisch nach ihrem Besuch um eine Google-Bewertung. Bauen Sie Ihren Ruf ganz automatisch auf.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Ihre Pipeline</span>
      <h2>Jeder Kunde, jede Phase, <span class="gradient-text">vollautomatisch</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Neuer Kunde</h3>
          <p>Anfrage kommt über Ihre Website, Social Media oder Empfehlung.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Gebucht</h3>
          <p>Kunde wählt Behandlung, Stylist und passende Zeit aus.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Besuch abgeschlossen</h3>
          <p>Termin erledigt. Bewertungsanfrage gesendet und Präferenzen gespeichert.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Wiederbuchung fällig</h3>
          <p>DUSA markiert den Kunden, wenn das Zeitfenster für den nächsten Besuch beginnt.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Wieder gebucht</h3>
          <p>Der Kunde kommt zurück. Der Kreislauf geht weiter und Ihr Stuhl bleibt besetzt.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Treue &amp; Empfehlung</h3>
          <p>Langzeitkunden verdienen Pramien und empfehlen Freunde. DUSA verfolgt Treue-Meilensteine und Empfehlungsgutschriften automatisch.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Ergebnisse</span>
      <h2>Entwickelt für Salons, die <span class="gradient-text">wachsen</span> wollen</h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">40%</div>
          <p>durchschnittliche Reduktion von No-Shows durch automatische Erinnerungen</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">3x</div>
          <p>mehr Google-Bewertungen innerhalb der ersten 90 Tage</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">60%</div>
          <p>der überfälligen Kunden buchen nach einem automatischen Anstoß erneut</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Bereit, jeden Stuhl zu füllen?</h2>
        <p>Bringen Sie Ihren Salon in weniger als einer Woche auf DUSA.</p>
        <div class="final-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/salon-booking-automation" class="btn btn--outline">Leitfaden lesen</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
