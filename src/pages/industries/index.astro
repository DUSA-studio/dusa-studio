    desc: 'Online booking, automated reminders, rebooking campaigns, and client preference tracking to fill every chair.',
    slug: '/industries/salons',
    icon: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
  },
  {
    title: 'Accountants',
    desc: 'Document collection automation, deadline reminders, and year-round client engagement beyond tax season.',
    slug: '/industries/accountants',
    icon: 'M4 2v20h16V8l-6-6H4zM14 2v6h6M8 13h8M8 17h8M8 9h2',
  },
  {
    title: 'Dental Practices',
    desc: 'Recall reminders, new patient acquisition, review generation, and treatment plan follow-ups on autopilot.',
    slug: '/industries/dentists',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Photographers',
