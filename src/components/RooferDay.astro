      li.className = 'ww__banner ww__banner--end';
      li.innerHTML = `<span class="ww__banner-icon ww__banner-icon--on"><img src="/dusa-logo.webp" alt="" width="22" height="22" decoding="async"></span><span class="ww__banner-body"><span class="ww__banner-row"><b>DUSA</b><em>now</em></span><span class="ww__banner-title"></span><span class="ww__banner-text"></span><span class="ww__banner-actions"><a class="ww__banner-btn ww__banner-btn--primary" href="/start" data-page="start"></a><a class="ww__banner-btn" target="_blank" rel="noopener noreferrer"></a></span></span>`;
      li.querySelector('.ww__banner-title')!.textContent = stage.dataset.endTitle || '';
