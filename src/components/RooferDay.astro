---
/**
 * RooferDay.astro
 *
 * Two roofers, the same Tuesday, side by side. One runs his business the old
 * way: the phone rings in the ute while he is on the roof, quotes go out at
 * 10pm, invoices on Sunday, and at 9pm he is still at the kitchen table.
 * The other has DUSA: every call is answered, every quote and invoice goes
 * out from the roof, and he is home for dinner. Same street, same job, same
 * hours of daylight. Only the admin is different, and over a year that is
 * the nicer house, the picket fence and the newer ute.
 *
 * One scroll drives both dioramas (Three.js, two viewports on one canvas).
 * Each roofer carries a phone that pulses when something lands on it and
 * floats up to the corner of its half when he cannot reach it. Six beats,
 * each a pair of cards: what happened without DUSA, what happened with it.
 * Reduced motion gets the cards as a plain list.
 */
interface Beat { time: string; off: { title: string; text: string; note: string }; on: { title: string; text: string; note: string } }
interface Props {
  eyebrow?: string;
  heading?: string;
  headingAccent?: string;
  labelOff?: string;
  labelOn?: string;
  hint?: string;
  cta?: string;
  ctaDemo?: string;
  beats?: Beat[];
}
const {
  eyebrow = 'Two roofers. Same Tuesday.',
  heading = 'Same jobs, same hours of daylight.',
  headingAccent = 'One of them has DUSA.',
  labelOff = 'Without DUSA',
  labelOn = 'With DUSA',
  hint = 'Scroll through the day',
  cta = 'Start free for 14 days',
  ctaDemo = 'Book a free demo',
  beats = [
    { time: '6:40am',
      off: { title: 'Three voicemails from last night.', text: 'He will call them back at lunch, if he remembers. Two have already rung the next roofer on the list.', note: 'Missed call (3)' },
      on:  { title: 'Three enquiries, all answered overnight.', text: 'DUSA replied in seconds, asked the right questions and offered times. He wakes up to two site visits booked.', note: 'Site visit booked, Thu 9am' } },
    { time: '9:15am',
      off: { title: 'On the roof. The phone rings in the ute.', text: 'It goes to voicemail. The customer does not leave one. That job is gone.', note: 'Missed call' },
      on:  { title: 'On the roof. The call is missed, the customer is not.', text: 'Eight seconds later they get a text from his number. They reply, and DUSA keeps the conversation going while his hands stay on the tools.', note: 'Reply sent in 8 sec' } },
    { time: '11:30am',
      off: { title: '"I will send the quote tonight."', text: 'It goes out at 10pm from the kitchen table, typed with two thumbs, if it goes out at all.', note: 'Quote: later' },
      on:  { title: 'Quote sent from the ute. Deposit paid by lunch.', text: 'He taps a template, DUSA fills in the numbers and sends it. They accept on their phone and pay the deposit.', note: 'Deposit received $1,200' } },
    { time: '1:30pm',
      off: { title: "Tomorrow's customer has no idea he is coming.", text: 'He meant to text them. Half of them will not be ready, and one will not be home.', note: 'Reminder: not sent' },
      on:  { title: "Tomorrow's customer gets a reminder.", text: 'Address, arrival time, what to move off the driveway. If they need to change it, one tap and his calendar updates itself.', note: 'Reminder sent, Thu 7am' } },
    { time: '4:45pm',
      off: { title: 'Job done. Invoice on Sunday. Paid in three weeks.', text: 'He stays on the roof until the light goes, because the next job is already behind.', note: 'Invoice: pending' },
      on:  { title: 'Invoice sent before he is off the ladder.', text: 'One tap. Paid by card while he packs the ute. The review request goes out two hours later on its own.', note: 'Invoice #2041 paid $4,800' } },
    { time: '9:00pm',
      off: { title: 'Kitchen table. Laptop. Quotes, invoices, follow-ups.', text: 'The kids are asleep. Same again tomorrow.', note: '4 follow-ups overdue' } ,
      on:  { title: 'Home by 5:30. Dinner with the family.', text: 'A five-star review landed and DUSA replied to it. Tomorrow is already booked. Nothing is waiting on the laptop.', note: 'New 5-star review on Google' } },
  ],
} = Astro.props;
const BOOK = 'https://link.dusa.studio/widget/bookings/dusa-demo';
---

<section class="rd" id="roofer-day" data-rd style={`--beats:${beats.length}`}>
  <div class="rd__stage">
    <div class="rd__sky" aria-hidden="true"></div>
    <canvas class="rd__canvas" data-rd-canvas aria-hidden="true"></canvas>
    <div class="rd__divider" aria-hidden="true"></div>

    <div class="rd__head">
      <span class="label">{eyebrow}</span>
      <h1 class="rd__h1">{heading} <span class="gradient-text">{headingAccent}</span></h1>
    </div>

    <div class="rd__clock glass-pill" aria-live="polite">
      <b data-rd-time>{beats[0].time}</b>
      <span data-rd-sky>Dawn</span>
    </div>

    <div class="rd__halves">
      {(['off', 'on'] as const).map((side) => (
        <div class={`rd__half rd__half--${side}`}>
          <span class={`rd__tag rd__tag--${side}`}><i aria-hidden="true"></i>{side === 'off' ? labelOff : labelOn}</span>
          <ol class="rd__cards" aria-label={side === 'off' ? labelOff : labelOn}>
            {beats.map((b, i) => (
              <li class="rd__card" data-beat={i} aria-current={i === 0 ? 'step' : undefined}>
                <span class="rd__card-time">{b.time}</span>
                <p class="rd__card-title">{b[side].title}</p>
                <p class="rd__card-text">{b[side].text}</p>
                <span class="rd__chip"><i aria-hidden="true"></i>{b[side].note}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <div class="rd__foot">
      <div class="rd__dots" aria-hidden="true">
        {beats.map((b, i) => <span class="rd__dot" data-dot={i}><em>{b.time}</em></span>)}
      </div>
      <p class="rd__hint" data-rd-hint>{hint}</p>
      <div class="rd__ctas">
        <a href="/start" data-page="start" class="btn btn--primary">{cta}</a>
        <a href={BOOK} target="_blank" rel="noopener noreferrer" class="btn btn--outline">{ctaDemo}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .rd {
    position: relative;
    height: calc(100vh * (var(--beats) + 1));
    height: calc(100svh * (var(--beats) + 1));
    margin: 0;
    --day: 0;
  }
  .rd__stage {
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
  }
  .rd__sky {
    position: absolute; inset: 0; pointer-events: none;
    opacity: var(--day);
    background: linear-gradient(180deg, rgba(106, 170, 207, 0.55) 0%, rgba(106, 170, 207, 0.22) 55%, rgba(78, 216, 194, 0.06) 100%);
    transition: opacity 0.2s linear;
  }
  .rd__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .rd__divider {
    position: absolute; left: 50%; top: 110px; bottom: 120px; width: 1px;
    background: linear-gradient(180deg, transparent, rgba(247, 244, 239, 0.22) 20%, rgba(247, 244, 239, 0.22) 80%, transparent);
    pointer-events: none;
  }

  /* ── Header, centred top ── */
  .rd__head {
    position: absolute; left: 0; right: 0; top: 74px;
    padding: var(--space-md) var(--space-md) 0;
    text-align: center; pointer-events: none;
  }
  .rd__head > * { pointer-events: auto; }
  .rd__head .label { margin-bottom: 0.5rem; }
  .rd__h1 { font-size: clamp(1.35rem, 2.3vw, 1.9rem); line-height: 1.2; margin: 0 auto; max-width: 720px; color: var(--warm-white); }

  /* ── Clock, top-right ── */
  .rd__clock { position: absolute; right: var(--space-md); top: calc(74px + var(--space-md)); gap: 0.6rem; padding: 0.5rem 0.95rem; }
  .rd__clock b { font-family: var(--font-headline); font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; }
  .rd__clock span { font-size: 0.75rem; color: rgba(247, 244, 239, 0.62); }

  /* ── The two halves ── */
  .rd__halves { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; pointer-events: none; }
  .rd__half { position: relative; }
  .rd__tag {
    position: absolute; left: var(--space-md); top: calc(74px + var(--space-md));
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.85rem; border-radius: 100px;
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.01em;
    border: 1px solid rgba(247, 244, 239, 0.16); background: rgba(12, 14, 20, 0.45);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: rgba(247, 244, 239, 0.8);
  }
  .rd__tag i { width: 8px; height: 8px; border-radius: 50%; background: rgba(247, 244, 239, 0.4); }
  .rd__tag--on { color: var(--warm-white); border-color: rgba(78, 216, 194, 0.4); }
  .rd__tag--on i { background: var(--reef-aqua); box-shadow: 0 0 10px rgba(78, 216, 194, 0.8); }
  .rd__half--on .rd__tag { left: auto; right: var(--space-md); top: calc(74px + var(--space-md) + 3rem); }

  .rd__cards {
    position: absolute; left: var(--space-md); right: var(--space-md); bottom: 128px;
    max-width: 420px; margin: 0 auto;
    list-style: none; padding: 0;
    display: grid;
  }
  .rd__card {
    grid-area: 1 / 1;
    padding: 1.05rem 1.2rem 1.1rem;
    border-radius: 18px;
    border: 1px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(135deg, rgba(12, 14, 20, 0.62), rgba(12, 14, 20, 0.45));
    backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.08), 0 20px 50px rgba(0, 0, 0, 0.35);
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
    pointer-events: none;
  }
  .rd__half--on .rd__card { border-color: rgba(78, 216, 194, 0.3); }
  .rd__card[aria-current="step"] { opacity: 1; transform: none; pointer-events: auto; }
  .rd__card-time { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(247, 244, 239, 0.5); }
  .rd__half--on .rd__card-time { color: var(--reef-aqua); }
  .rd__card-title { font-family: var(--font-headline); font-weight: 600; font-size: 1.0625rem; line-height: 1.3; color: var(--warm-white); margin: 0.3rem 0 0.35rem; max-width: none; }
  .rd__card-text { font-size: 0.875rem; line-height: 1.5; color: rgba(247, 244, 239, 0.68); margin: 0 0 0.75rem; max-width: none; }
  .rd__chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.75rem; border-radius: 100px;
    font-size: 0.78rem; font-weight: 500; color: rgba(247, 244, 239, 0.85);
    border: 1px solid rgba(247, 244, 239, 0.16); background: rgba(247, 244, 239, 0.05);
  }
  .rd__chip i { width: 7px; height: 7px; border-radius: 50%; background: #e8907a; box-shadow: 0 0 8px rgba(232, 144, 122, 0.8); }
  .rd__half--on .rd__chip { color: var(--warm-white); border-color: rgba(78, 216, 194, 0.35); background: rgba(78, 216, 194, 0.1); }
  .rd__half--on .rd__chip i { background: var(--reef-aqua); box-shadow: 0 0 10px rgba(78, 216, 194, 0.9); animation: rdPing 1.8s ease-in-out infinite; }
  @keyframes rdPing { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }

  /* ── Foot: dots, hint, CTAs ── */
  .rd__foot {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 0 var(--space-md) var(--space-md);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
  }
  .rd__dots { display: flex; gap: 0.5rem; align-items: center; }
  .rd__dot { position: relative; width: 10px; height: 10px; border-radius: 50%; background: rgba(247, 244, 239, 0.18); transition: background 0.3s, transform 0.3s; }
  .rd__dot em { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); font-style: normal; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: rgba(247, 244, 239, 0.55); opacity: 0; transition: opacity 0.3s; white-space: nowrap; }
  .rd__dot.is-on { background: var(--reef-aqua); transform: scale(1.3); box-shadow: 0 0 12px rgba(78, 216, 194, 0.6); }
  .rd__dot.is-on em { opacity: 1; }
  .rd__dot.is-past { background: rgba(78, 216, 194, 0.45); }
  .rd__hint { margin: 0; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(247, 244, 239, 0.5); transition: opacity 0.4s; max-width: none; }
  .rd__hint.is-done { opacity: 0; }
  .rd__ctas { display: flex; gap: var(--space-sm); }

  /* ── Phones: halves stack top and bottom, cards shrink to a line ── */
  @media (max-width: 900px) {
    .rd__halves { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
    .rd__divider { left: var(--space-sm); right: var(--space-sm); top: 50%; bottom: auto; width: auto; height: 1px; background: linear-gradient(90deg, transparent, rgba(247, 244, 239, 0.22) 20%, rgba(247, 244, 239, 0.22) 80%, transparent); }
    .rd__head { padding-top: var(--space-sm); }
    .rd__head .label { display: none; }
    .rd__h1 { font-size: 1.05rem; max-width: 300px; }
    .rd__clock { display: none; }
    .rd__tag { top: auto; bottom: calc(50% + 0.5rem); left: var(--space-sm); font-size: 0.72rem; padding: 0.3rem 0.65rem; }
    .rd__half--off .rd__tag { top: calc(74px + 3.4rem); bottom: auto; }
    .rd__half--on .rd__tag { top: 0.6rem; bottom: auto; left: var(--space-sm); right: auto; }
    .rd__cards { left: var(--space-sm); right: var(--space-sm); bottom: 0.5rem; max-width: none; }
    .rd__half--on .rd__cards { bottom: 3.6rem; }
    .rd__card { padding: 0.7rem 0.85rem 0.75rem; border-radius: 14px; }
    .rd__card-title { font-size: 0.9rem; margin: 0.15rem 0 0.25rem; }
    .rd__card-text { display: none; }
    .rd__chip { font-size: 0.72rem; padding: 0.25rem 0.6rem; }
    .rd__foot { padding: 0 var(--space-sm) 0.6rem; }
    .rd__hint, .rd__ctas { display: none; }
  }

  /* ── Reduced motion: the whole day as two lists ── */
  @media (prefers-reduced-motion: reduce) {
    .rd { height: auto; }
    .rd__stage { position: relative; height: auto; overflow: visible; padding: calc(74px + var(--space-xl)) var(--space-md) var(--space-xl); }
    .rd__canvas, .rd__sky, .rd__divider, .rd__clock { display: none; }
    .rd__head { position: static; padding: 0 0 var(--space-lg); }
    .rd__halves { position: static; gap: var(--space-md); pointer-events: auto; }
    .rd__tag { position: static; margin-bottom: var(--space-sm); }
    .rd__cards { position: static; max-width: none; display: grid; gap: var(--space-sm); }
    .rd__card { grid-area: auto; opacity: 1; transform: none; pointer-events: auto; }
    .rd__card-text { display: block; }
    .rd__foot { position: static; padding: var(--space-lg) 0 0; }
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .rd__h1 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .rd__sky { background: linear-gradient(180deg, rgba(106, 170, 207, 0.45) 0%, rgba(106, 170, 207, 0.15) 55%, rgba(255, 255, 255, 0) 100%); }
  :global(html[data-theme="light"]) .rd__divider { background: linear-gradient(180deg, transparent, rgba(12, 14, 20, 0.18) 20%, rgba(12, 14, 20, 0.18) 80%, transparent); }
  :global(html[data-theme="light"]) .rd__clock span { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .rd__tag { color: rgba(12, 14, 20, 0.8); border-color: rgba(12, 14, 20, 0.12); background: rgba(255, 255, 255, 0.55); }
  :global(html[data-theme="light"]) .rd__tag i { background: rgba(12, 14, 20, 0.3); }
  :global(html[data-theme="light"]) .rd__tag--on { color: var(--deep-black); border-color: rgba(26, 58, 92, 0.35); }
  :global(html[data-theme="light"]) .rd__tag--on i { background: var(--deep-ocean); box-shadow: none; }
  :global(html[data-theme="light"]) .rd__card { border-color: rgba(12, 14, 20, 0.12); background: linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.6)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 18px 44px rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .rd__half--on .rd__card { border-color: rgba(26, 58, 92, 0.3); }
  :global(html[data-theme="light"]) .rd__card-time { color: rgba(12, 14, 20, 0.5); }
  :global(html[data-theme="light"]) .rd__half--on .rd__card-time { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .rd__card-title { color: var(--deep-black); }
  :global(html[data-theme="light"]) .rd__card-text { color: rgba(12, 14, 20, 0.68); }
  :global(html[data-theme="light"]) .rd__chip { color: rgba(12, 14, 20, 0.8); border-color: rgba(12, 14, 20, 0.14); background: rgba(12, 14, 20, 0.04); }
  :global(html[data-theme="light"]) .rd__half--on .rd__chip { color: var(--deep-black); border-color: rgba(26, 58, 92, 0.3); background: rgba(26, 58, 92, 0.07); }
  :global(html[data-theme="light"]) .rd__half--on .rd__chip i { background: var(--deep-ocean); box-shadow: none; }
  :global(html[data-theme="light"]) .rd__dot { background: rgba(12, 14, 20, 0.15); }
  :global(html[data-theme="light"]) .rd__dot.is-on { background: var(--deep-ocean); box-shadow: none; }
  :global(html[data-theme="light"]) .rd__dot.is-past { background: rgba(26, 58, 92, 0.45); }
  :global(html[data-theme="light"]) .rd__dot em, :global(html[data-theme="light"]) .rd__hint { color: rgba(12, 14, 20, 0.55); }
</style>

<script>
  import * as THREE from 'three';

  const root = document.querySelector<HTMLElement>('[data-rd]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-rd-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && canvas && !reduced) {
    const stage = root.querySelector<HTMLElement>('.rd__stage')!;
    const halves = [...root.querySelectorAll<HTMLElement>('.rd__half')];
    const cardSets = halves.map((h) => [...h.querySelectorAll<HTMLElement>('[data-beat]')]);
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const timeEl = root.querySelector<HTMLElement>('[data-rd-time]')!;
    const skyEl = root.querySelector<HTMLElement>('[data-rd-sky]')!;
    const hintEl = root.querySelector<HTMLElement>('[data-rd-hint]')!;
    const BEATS = cardSets[0].length;
    const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';
    const notes = cardSets.map((set) => set.map((c) => ({ time: c.querySelector('.rd__card-time')?.textContent || '', text: c.querySelector('.rd__chip')?.textContent || '' })));

    /* ── Palette ── */
    const C = {
      ocean: 0x1a3a5c, mist: 0x6aaacf, aqua: 0x4ed8c2, warm: 0xf7f4ef, ink: 0x0c0e14, coral: 0xe8907a,
      groundNight: 0x1f2838, groundDay: 0x4a7a6c, groundLightNight: 0xb8c6d2, groundLightDay: 0xcfe3d6, roadNight: 0x2a3344, roadDay: 0x6b7686, roadLight: 0xb4bfc9,
      wall: 0xe9e4da, wallNice: 0xf4f1ea, roof: 0x2b4a6b, roofNice: 0x2f6a9c, trim: 0x9fb3c4, wood: 0xc9a27a, leaf: 0x2f6a62,
    };

    /* ── Renderer ── */
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
    renderer.setClearColor(0x000000, 0);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;
    renderer.setScissorTest(true);

    const mat = (color: number, extra: Partial<THREE.MeshStandardMaterialParameters> = {}) =>
      new THREE.MeshStandardMaterial({ color, roughness: 0.85, metalness: 0.05, ...extra });
    const box = (w: number, h: number, d: number, m: THREE.Material, x = 0, y = 0, z = 0, shadow = true) => {
      const o = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
      o.position.set(x, y, z); o.castShadow = shadow; o.receiveShadow = true; return o;
    };
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (a: number, b: number, v: number) => { const t = clamp01((v - a) / (b - a)); return t * t * (3 - 2 * t); };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const tmpCol = new THREE.Color();
    const mix = (a: number, b: number, t: number) => tmpCol.set(a).lerp(new THREE.Color(b), clamp01(t));

    /* ── A person: shirt, pants, head, hat ── */
    const person = (shirt: number, scale = 1, hat = true) => {
      const g = new THREE.Group();
      g.add(box(0.26, 0.4, 0.2, mat(shirt), 0, 0.5, 0));
      g.add(box(0.24, 0.32, 0.18, mat(0x3a4150), 0, 0.16, 0));
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.12, 14, 12), mat(0xd9b08c)); head.position.y = 0.82; head.castShadow = true; g.add(head);
      if (hat) g.add(box(0.3, 0.06, 0.3, mat(C.warm), 0, 0.93, 0));
      const arm = box(0.08, 0.34, 0.08, mat(shirt), 0.2, 0.62, 0);
      arm.geometry.translate(0, -0.14, 0); g.add(arm);
      g.scale.setScalar(scale);
      return { g, arm };
    };

    /* ── The phone: a real phone shape with a live screen ── */
    const makePhone = (nice: boolean) => {
      const g = new THREE.Group();
      const body = new THREE.Mesh(new THREE.BoxGeometry(0.62, 1.26, 0.08), mat(nice ? 0x1b2433 : 0x161a22, { roughness: 0.35, metalness: 0.4 }));
      body.castShadow = true; g.add(body);
      g.add(box(0.66, 1.3, 0.04, mat(nice ? 0x5b7ea0 : 0x3a4150, { roughness: 0.3, metalness: 0.6 }), 0, 0, -0.01, false));
      const cv = document.createElement('canvas'); cv.width = 256; cv.height = 520;
      const ctx = cv.getContext('2d')!;
      const tex = new THREE.CanvasTexture(cv); tex.colorSpace = THREE.SRGBColorSpace;
      const screen = new THREE.Mesh(new THREE.PlaneGeometry(0.56, 1.18), new THREE.MeshBasicMaterial({ map: tex, toneMapped: false }));
