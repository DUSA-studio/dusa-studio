  }

  .vcard__desc {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.55);
    line-height: 1.7;
    max-width: none;
  }

  .vcard--expanded .vcard__desc {
    color: rgba(247, 244, 239, 0.75);
  }

  .values__dots {
    position: absolute;
    bottom: -32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 20;
  }

  .values__dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    padding: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .values__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(12, 14, 20, 0.2);
    transition: all 0.3s var(--ease-out);
  }

  .values__dot--active::before {
    background: var(--deep-ocean);
    transform: scale(1.3);
  }

  .values__dot:hover::before {
    background: var(--reef-aqua);
    transform: scale(1.3);
  }

  html[data-theme="light"] .vcard {
    background: linear-gradient(145deg, #1e2128, #16181e);
    border-color: rgba(247, 244, 239, 0.06);
  }
  html[data-theme="light"] .vcard--expanded {
    border-color: rgba(78, 216, 194, 0.25);
  }

  /* Sydney */
  .sydney__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .sydney__content {
    max-width: 650px;
  }

  .sydney__desc {
    font-size: 1.0625rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
  }

  .sydney__actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .sydney__globe {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .globe-canvas {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
  }

  :global(html[data-theme="light"]) .about-hero__sub {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .origin__desc {
    color: rgba(12, 14, 20, 0.6);
  }
  :global(html[data-theme="light"]) .origin__tile {
    background: rgba(26, 58, 92, 0.04);
    border-color: rgba(26, 58, 92, 0.1);
  }
  :global(html[data-theme="light"]) .origin__tile-number {
    color: rgba(26, 58, 92, 0.12);
  }

  :global(html[data-theme="light"]) .sydney__desc {
    color: rgba(12, 14, 20, 0.6);
  }

  :global(html[data-theme="light"]) .values__dot:hover::before {
    background: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .vcard--expanded .vcard__badge {
    color: var(--deep-ocean);
    background: rgba(26, 58, 92, 0.12);
  }

  @media (max-width: 1024px) {
    .about-hero__sub {
      font-size: 1.125rem;
    }

    .origin__tile h3 {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 768px) {
    .origin__tiles {
      grid-template-columns: 1fr;
