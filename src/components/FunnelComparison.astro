---
// FunnelComparison.astro — Animated cost comparison: scattered tools vs DUSA

interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;

const s = t?.funnelComparison || {};
const fcLabel = s.label || 'The real cost of scattered tools';
const fcHeading = s.heading || 'Where does your';
const fcHeadingAccent = s.headingAccent || 'money actually go?';
const fcWithoutDusa = s.withoutDusa || 'Without DUSA';
const fcWithDusa = s.withDusa || 'With DUSA';
const fcScatteredSpend = s.scatteredSpend || 'Scattered spend';
const fcScatteredSub = s.scatteredSub || '8 logins, 8 bills, no unified view';
const fcAllInOneLabel = s.allInOneLabel || 'All-in-one growth stack';
const fcPlatformSub = s.platformSub || 'CRM, funnels, email, SMS, AI, reviews, scheduling, courses';
const fcUnifiedGrowth = s.unifiedGrowth || 'AI-powered growth';
const fcUnifiedSub = s.unifiedSub || 'Leads, bookings, revenue. AI does the rest.';
const fcGoingIn = s.goingIn || 'GOING IN';
const fcAiPowered = s.aiPowered || 'AI-POWERED';
const fcVs = s.vs || 'VS';
---

<section class="funnel section section--dark" id="funnel">
  <div class="container">
    <div class="funnel__header reveal">
      <span class="label">{fcLabel}</span>
      <h2>{fcHeading}<br/><span class="gradient-text">{fcHeadingAccent}</span></h2>
    </div>

    <div class="funnel__layout">
      <!-- ── COMPETITORS SIDE ── -->
      <div class="funnel__side funnel__side--left">
        <h3 class="funnel__tag funnel__tag--red">{fcWithoutDusa}</h3>

        <div class="funnel__pills">
          <span class="funnel__pill fpill" style="--i:0">HubSpot <b>$40</b></span>
          <span class="funnel__pill fpill" style="--i:1">Mailchimp <b>$85</b></span>
          <span class="funnel__pill fpill" style="--i:2">ClickFunnels <b>$135</b></span>
          <span class="funnel__pill fpill" style="--i:3">Birdeye <b>$349</b></span>
          <span class="funnel__pill fpill" style="--i:4">Skool <b>$139</b></span>
          <span class="funnel__pill fpill" style="--i:5">Zapier <b>$42</b></span>
          <span class="funnel__pill fpill" style="--i:6">Calendly <b>$24</b></span>
          <span class="funnel__pill fpill" style="--i:7">SimpleTexting <b>$55</b></span>
        </div>

        <!-- Dollars flowing IN — contained within funnel top opening -->
        <div class="funnel__rain funnel__rain--heavy">
          <span class="funnel__drop" style="--dx:-28%;--dd:0s;--dur:1.6s">$</span>
          <span class="funnel__drop" style="--dx:-10%;--dd:0.2s;--dur:1.4s">$</span>
          <span class="funnel__drop" style="--dx:5%;--dd:0.5s;--dur:1.7s">$</span>
          <span class="funnel__drop" style="--dx:20%;--dd:0.1s;--dur:1.5s">$</span>
          <span class="funnel__drop" style="--dx:-20%;--dd:0.7s;--dur:1.3s">$</span>
          <span class="funnel__drop" style="--dx:10%;--dd:0.35s;--dur:1.8s">$</span>
          <span class="funnel__drop" style="--dx:-3%;--dd:0.55s;--dur:1.5s">$</span>
          <span class="funnel__drop" style="--dx:28%;--dd:0.15s;--dur:1.6s">$</span>
          <span class="funnel__drop" style="--dx:0%;--dd:0.85s;--dur:1.4s">$</span>
          <span class="funnel__drop" style="--dx:-15%;--dd:0.45s;--dur:1.7s">$</span>
        </div>

        <!-- Funnel shape -->
        <div class="funnel__shape">
          <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" class="funnel__svg">
            <defs>
              <linearGradient id="funnelRedGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="rgba(232,82,78,0.15)"/>
                <stop offset="100%" stop-color="rgba(232,82,78,0.03)"/>
              </linearGradient>
            </defs>
            <path d="M10,10 Q10,0 20,0 L300,0 Q310,0 310,10 L230,170 Q225,185 210,185 L110,185 Q95,185 90,170 Z"
                  fill="url(#funnelRedGrad)" stroke="rgba(232,82,78,0.25)" stroke-width="1"/>
            <text x="160" y="78" text-anchor="middle" fill="rgba(232,82,78,0.95)"
                  font-family="Space Mono, monospace" font-size="18" font-weight="700" letter-spacing="0.05em">$1,074/MO</text>
            <text x="160" y="106" text-anchor="middle" fill="rgba(232,82,78,0.7)"
                  font-family="Space Mono, monospace" font-size="11" letter-spacing="0.15em">{fcGoingIn}</text>
          </svg>
        </div>

        <!-- Trickle out — sad tiny dollars -->
        <div class="funnel__output">
          <div class="funnel__trickle">
            <span class="funnel__out-drop funnel__out-drop--sad" style="--od:0s">$</span>
            <span class="funnel__out-drop funnel__out-drop--sad" style="--od:1.2s">$</span>
            <span class="funnel__out-drop funnel__out-drop--sad" style="--od:2.5s">$</span>
          </div>
          <div class="funnel__glow funnel__glow--red"></div>
          <span class="funnel__result funnel__result--red">{fcScatteredSpend}</span>
          <span class="funnel__result-sub">{fcScatteredSub}</span>
        </div>
      </div>

      <!-- ── VS BADGE ── -->
      <div class="funnel__vs">
        <div class="funnel__vs-line"></div>
        <span class="funnel__vs-badge">{fcVs}</span>
        <div class="funnel__vs-line"></div>
      </div>

      <!-- ── DUSA SIDE ── -->
      <div class="funnel__side funnel__side--right">
        <h3 class="funnel__tag funnel__tag--aqua">{fcWithDusa}</h3>

        <div class="funnel__platform fpill" style="--i:0">
          <span class="funnel__platform-label">{fcAllInOneLabel}</span>
          <span class="funnel__platform-name">
            <svg class="funnel__pill-star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="16" height="16">
              <path d="M215.4,395.1c-5.2,0-9.5-3-11.5-8c-7.2-17.8-14.5-35.7-21.7-53.5c-10-24.6-27.3-41.9-51.9-51.9c-17.9-7.3-35.9-14.6-53.8-21.9c-8.7-3.5-10.5-14.9-3.3-20.7c1.1-0.9,2.5-1.6,3.9-2.2c18.1-7.4,36.3-14.6,54.4-22.1c24-10,40.8-27.2,50.7-51.3c7.3-17.8,14.5-35.7,21.7-53.5c2.1-5.2,6.3-8.2,11.6-8.2c5.2,0,9.4,3,11.4,8.2c7.5,18.4,14.7,37,22.5,55.3c10,23.7,27.3,40.3,51.1,50c17.8,7.3,35.7,14.5,53.5,21.7c5,2,8,6.3,8,11.4c0,5.2-2.9,9.5-8,11.5c-17.9,7.3-35.8,14.5-53.7,21.8c-25.2,10.3-42.5,28.2-52.5,53.5c-6.8,17.3-14,34.5-21,51.7C224.7,392.1,220.5,395.1,215.4,395.1z" fill="currentColor"/>
            </svg>
            DUSA <b>$149/mo</b>
          </span>
          <span class="funnel__platform-sub">{fcPlatformSub}</span>
        </div>

        <!-- Single gentle dollar flowing in -->
        <div class="funnel__rain funnel__rain--light">
          <span class="funnel__drop funnel__drop--aqua" style="--dx:0%;--dd:0s;--dur:2s">$</span>
        </div>

        <!-- Funnel shape — same size as competitor, story told through input/output -->
        <div class="funnel__shape">
          <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" class="funnel__svg">
            <defs>
              <linearGradient id="funnelAquaGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="rgba(78,216,194,0.14)"/>
                <stop offset="100%" stop-color="rgba(78,216,194,0.04)"/>
              </linearGradient>
            </defs>
            <path d="M10,10 Q10,0 20,0 L300,0 Q310,0 310,10 L230,170 Q225,185 210,185 L110,185 Q95,185 90,170 Z"
                  fill="url(#funnelAquaGrad)" stroke="rgba(78,216,194,0.35)" stroke-width="1"/>
            <text x="160" y="78" text-anchor="middle" fill="rgba(78,216,194,0.95)"
                  font-family="Space Mono, monospace" font-size="18" font-weight="700" letter-spacing="0.05em">$149/MO</text>
            <text x="160" y="106" text-anchor="middle" fill="rgba(78,216,194,0.75)"
                  font-family="Space Mono, monospace" font-size="11" letter-spacing="0.15em">{fcAiPowered}</text>
          </svg>
        </div>

        <!-- Strong output — massive cascade of dollars -->
        <div class="funnel__output funnel__output--dusa">
          <div class="funnel__cascade">
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0s;--ox:-8px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.12s;--ox:6px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.24s;--ox:-2px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.36s;--ox:10px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.48s;--ox:-6px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.6s;--ox:2px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.72s;--ox:-10px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.84s;--ox:8px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:0.96s;--ox:0px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:1.08s;--ox:-4px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:1.2s;--ox:4px">$</span>
            <span class="funnel__out-drop funnel__out-drop--strong" style="--od:1.32s;--ox:-1px">$</span>
          </div>
          <div class="funnel__glow"></div>
          <span class="funnel__result funnel__result--aqua">{fcUnifiedGrowth}</span>
          <span class="funnel__result-sub">{fcUnifiedSub}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── LAYOUT ─── */
  .funnel {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .funnel__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }

  .funnel__layout {
    display: grid;
    grid-template-columns: 1fr 60px 1fr;
    gap: var(--space-md);
    align-items: stretch;
    max-width: 1000px;
    margin: 0 auto;
  }

  .funnel__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ─── TAG LABELS ─── */
  .funnel__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .funnel__tag--red { color: rgba(232, 82, 78, 0.9); }
  .funnel__tag--aqua { color: var(--reef-aqua); }

  /* ─── PILLS ─── */
  .funnel__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    justify-content: center;
    align-content: center;
    max-width: 380px;
    height: 100px;
    margin-bottom: var(--space-xs);
  }

  .funnel__pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    background: rgba(232, 82, 78, 0.05);
    border: 1px solid rgba(232, 82, 78, 0.18);
    color: rgba(247, 244, 239, 0.5);
    /* animation start state */
    opacity: 0;
    transform: translateY(-24px);
  }

  .funnel__pill b {
    font-weight: 700;
    color: rgba(232, 82, 78, 0.9);
  }

  /* ─── DUSA PLATFORM CARD ─── */
  .funnel__platform {
    width: 100%;
    max-width: 320px;
    height: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    background: rgba(78, 216, 194, 0.04);
    border: 1.5px solid rgba(78, 216, 194, 0.2);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    margin-bottom: var(--space-xs);
    opacity: 0;
    transform: translateY(-24px);
  }

  .funnel__platform-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(78, 216, 194, 0.55);
  }

  .funnel__platform-name {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--reef-aqua);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .funnel__platform-name b {
    font-weight: 700;
    color: var(--reef-aqua);
  }

  .funnel__platform-sub {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: rgba(78, 216, 194, 0.35);
    text-align: center;
    line-height: 1.4;
  }

  .funnel__pill-star {
    flex-shrink: 0;
  }

  /* ─── DOLLAR RAIN (flowing into funnel) ─── */
  .funnel__rain {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: 24px;
    overflow: hidden;
    margin-bottom: -4px;
  }

  .funnel__rain--light {
    max-width: 320px;
  }

  .funnel__rain--heavy {
    max-width: 320px;
  }

  .funnel__drop {
    position: absolute;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.875rem;
    color: rgba(232, 82, 78, 0.75);
    left: calc(50% + var(--dx, 0%));
    top: -12px;
    animation: rainDrop var(--dur, 1.5s) ease-in infinite;
    animation-delay: var(--dd, 0s);
    opacity: 0;
  }

  .funnel__drop--aqua {
    color: rgba(78, 216, 194, 0.5);
    font-size: 0.875rem;
  }

  @keyframes rainDrop {
    0%   { transform: translateY(0); opacity: 0; }
    12%  { opacity: 0.8; }
    70%  { opacity: 0.35; }
    100% { transform: translateY(24px); opacity: 0; }
  }

  /* ─── FUNNEL SHAPE ─── */
  .funnel__shape {
    width: 100%;
    max-width: 320px;
    opacity: 0;
    transform: scale(0.92);
  }

  .funnel__svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 20px rgba(0,0,0,0.15));
  }

  /* ─── VS BADGE ─── */
  .funnel__vs {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: center;
    margin-top: 60px;
    gap: 0;
  }

  .funnel__vs-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, rgba(247, 244, 239, 0.15), transparent);
  }

  .funnel__vs-badge {
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgba(247, 244, 239, 0.5);
    padding: 0.625rem 1rem;
    border: 1.5px solid rgba(247, 244, 239, 0.12);
    border-radius: 50%;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(247, 244, 239, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
    opacity: 0;
  }

  /* ─── OUTPUT SECTIONS ─── */
  .funnel__output {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    justify-content: flex-start;
    opacity: 0;
    margin-top: -2px;
    padding-top: 0.25rem;
  }

  /* Competitor trickle — narrow, from funnel bottom opening */
  .funnel__trickle {
    position: relative;
    width: 20px;
    height: 40px;
    overflow: hidden;
  }

  .funnel__out-drop--sad {
    position: absolute;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--error);
    left: 50%;
    top: -8px;
    transform: translateX(-50%);
    animation: sadDrip 4s ease-in infinite;
    animation-delay: var(--od, 0s);
    opacity: 0;
  }

  @keyframes sadDrip {
    0%   { top: -6px; opacity: 0; }
    15%  { opacity: 0.5; }
    50%  { opacity: 0.2; }
    100% { top: 30px; opacity: 0; }
  }

  /* DUSA cascade — constrained to funnel bottom width (~44% of funnel) */
  .funnel__cascade {
    position: relative;
    width: 80px;
    height: 40px;
    overflow: hidden;
  }

  .funnel__out-drop--strong {
    position: absolute;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.9rem;
    color: rgba(78, 216, 194, 0.8);
    left: calc(50% + var(--ox, 0px));
    top: -10px;
    transform: translateX(-50%);
    animation: strongFlow 1.2s ease-in infinite;
    animation-delay: var(--od, 0s);
    opacity: 0;
    text-shadow: 0 0 10px rgba(78, 216, 194, 0.4);
  }

  @keyframes strongFlow {
    0%   { top: -6px; opacity: 0; transform: translateX(-50%) scale(0.8); }
    10%  { opacity: 0.9; transform: translateX(-50%) scale(1); }
    60%  { opacity: 0.5; }
    100% { top: 34px; opacity: 0; transform: translateX(-50%) scale(0.7); }
  }

  /* Glow pool beneath cascade/trickle */
  .funnel__glow {
    width: 100px;
    height: 20px;
    background: radial-gradient(ellipse, rgba(78, 216, 194, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    animation: glowPulse 2s ease-in-out infinite;
    margin-top: -4px;
  }

  .funnel__glow--red {
    background: radial-gradient(ellipse, rgba(232, 82, 78, 0.25) 0%, transparent 70%);
    width: 60px;
    animation: glowPulseRed 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { transform: scaleX(0.8); opacity: 0.4; }
    50% { transform: scaleX(1.4); opacity: 0.8; }
  }

  @keyframes glowPulseRed {
    0%, 100% { transform: scaleX(0.7); opacity: 0.3; }
    50% { transform: scaleX(1.1); opacity: 0.5; }
  }

  /* Result labels */
  .funnel__result {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .funnel__result--red { color: rgba(232, 82, 78, 0.8); }
  .funnel__result--aqua { color: var(--reef-aqua); }

  .funnel__result-sub {
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.3);
    max-width: 200px;
    line-height: 1.5;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .funnel__layout {
      grid-template-columns: 1fr 40px 1fr;
      gap: var(--space-sm);
      max-width: 800px;
    }

    .funnel__vs {
      margin-top: 80px;
    }

    .funnel__shape {
      max-width: 260px;
    }

    .funnel__pills {
      max-width: 300px;
    }

    .funnel__platform {
      max-width: 260px;
    }
  }

  @media (max-width: 768px) {
    .funnel {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-xl);
    }

    .funnel__layout {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .funnel__vs {
      margin-top: 0;
      order: 2;
    }

    .funnel__side--left { order: 1; }
    .funnel__side--right { order: 3; }

    .funnel__pills { max-width: 300px; }
    .funnel__shape { max-width: 260px; }
    .funnel__platform { max-width: 260px; }
  }

  @media (max-width: 480px) {
    .funnel__shape {
      max-width: 220px;
    }

    .funnel__pills {
      max-width: 260px;
    }

    .funnel__pill {
      font-size: 0.6875rem;
      padding: 0.3rem 0.625rem;
    }

    .funnel__platform {
      max-width: 220px;
      height: 90px;
    }

    .funnel__platform-name {
      font-size: 0.9rem;
    }

    .funnel__result {
      font-size: 0.875rem;
    }

    .funnel__result-sub {
      font-size: 0.75rem;
    }
  }

  /* ─── LIGHT MODE ─── */

  /* Tag labels */
  :global(html[data-theme="light"]) .funnel__tag--red {
    color: rgba(200, 50, 46, 0.95);
  }
  :global(html[data-theme="light"]) .funnel__tag--aqua {
    color: #0e9a82;
  }

  /* Pills — competitor side */
  :global(html[data-theme="light"]) .funnel__pill {
    color: rgba(12, 14, 20, 0.75);
    background: rgba(232, 82, 78, 0.06);
    border-color: rgba(200, 50, 46, 0.25);
  }
  :global(html[data-theme="light"]) .funnel__pill b {
    color: rgba(200, 50, 46, 0.95);
  }

  /* DUSA platform card — deep-ocean blue tones */
  :global(html[data-theme="light"]) .funnel__platform {
    background: rgba(26, 58, 92, 0.06);
    border-color: rgba(26, 58, 92, 0.25);
  }
  :global(html[data-theme="light"]) .funnel__platform-label {
    color: rgba(26, 58, 92, 0.75);
  }
  :global(html[data-theme="light"]) .funnel__platform-name {
    color: var(--deep-ocean);
  }
