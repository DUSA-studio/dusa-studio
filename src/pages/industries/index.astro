    icon: 'M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M8.5 11a4 4 0 100-8 4 4 0 000 8zM20 8v6M23 11h-6',
  },
  {
    title: 'Cleaning Services',
    desc: 'Recurring booking management, quality follow-ups, crew scheduling, and upsell campaigns for cleaning businesses.',
    slug: '/industries/cleaning-services',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    title: 'Law Firms',
    desc: 'Intake form automation, case status updates, referral tracking, and thought leadership content within compliance.',
