---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import WhatIsDusa from '../../components/WhatIsDusa.astro';
import UnderwaterDive from '../../components/UnderwaterDive.astro';
import FunnelComparison from '../../components/FunnelComparison.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Onboarding from '../../components/Onboarding.astro';
import BrandCarousel from '../../components/BrandCarousel.astro';
import SocialProof from '../../components/SocialProof.astro';
import CTA from '../../components/CTA.astro';
import t from '../../i18n/translations/de.json';
---

<BaseLayout
  title="DUSA . studio | Wachstumsplattform für Kleine Unternehmen"
  description="Verwalten Sie Ihr Marketing, Ihren Vertrieb und das Kundengagement von einer einzigen Plattform. DUSA ist das All-in-One-Wachstumssystem für Unternehmen, die skalieren wollen."
  lang="de"
  ogLocale="de_DE"
  region="de"
  t={t}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "DUSA . studio",
    "url": "https://dusa.studio/de/",
    "logo": "https://dusa.studio/favicon.png",
    "description": "All-in-One-Wachstumsplattform für kleine Unternehmen. CRM, Marketing-Automatisierung, Vertriebspipelines und Kundengagement von einem einzigen Login.",
    "address": { "@type": "PostalAddress", "addressLocality": "Sydney", "addressRegion": "NSW", "addressCountry": "AU" },
    "sameAs": []
  })} />
  <Hero t={t} lang="de" />
  <Features t={t} />
  <SocialProof t={t} />
  <UnderwaterDive t={t} />
  <FunnelComparison t={t} />
  <WhatIsDusa t={t} />
  <HowItWorks t={t} />
  <Onboarding t={t} region="de" />
  <BrandCarousel t={t} />
  <CTA t={t} />
</BaseLayout>

<script>
  function initAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') { setTimeout(initAnimations, 100); return; }
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');
    gsap.set('.reveal, .reveal-left, .reveal-right, .reveal-scale', { visibility: 'visible' });
    const heroTl = gsap.timeline({
      scrollTrigger: { trigger: '.hero__inner', start: 'top 75%', once: true },
    });
    const heroLabel = document.querySelector('.hero .label');
    const heroTitle = document.querySelector('.hero__title');
    const heroSub = document.querySelector('.hero__subtitle');
    const heroPhone = document.querySelector('.hero__phone-wrap');
    const notifFeed = document.querySelector('#hero-notif-feed');
    if (notifFeed) { gsap.set(notifFeed, { opacity: 0 }); heroTl.to(notifFeed, { opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.6'); }
    const heroProof = document.querySelector('.hero__proof');
    const heroOnly = '.hero';
    gsap.utils.toArray('.reveal').forEach((el: Element) => { if ((el as HTMLElement).closest(heroOnly)) return; gsap.from(el, { y: 50, opacity: 0, duration: 0.8, ease: 'power4.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }); });
    gsap.utils.toArray('.reveal-left').forEach((el: Element) => { if ((el as HTMLElement).closest(heroOnly)) return; gsap.from(el, { x: -50, opacity: 0, duration: 1, ease: 'power4.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }); });
    gsap.utils.toArray('.reveal-right').forEach((el: Element) => { if ((el as HTMLElement).closest(heroOnly)) return; gsap.from(el, { x: 50, opacity: 0, duration: 1, ease: 'power4.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }); });
    gsap.utils.toArray('.reveal-scale').forEach((el: Element) => { if ((el as HTMLElement).closest(heroOnly)) return; gsap.from(el, { scale: 0.9, opacity: 0, duration: 1, ease: 'power4.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }); });
    document.querySelectorAll('.hiw__step-num').forEach((el) => { gsap.from(el, { scale: 0.3, opacity: 0, duration: 0.6, ease: 'back.out(2)', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }); });
    document.querySelectorAll('.proof__stat-value').forEach((el) => { gsap.from(el, { scale: 0.4, opacity: 0, y: 20, duration: 0.7, ease: 'back.out(2)', scrollTrigger: { trigger: el, start: 'top 88%', once: true } }); });
    document.querySelectorAll('.cta__expand-line').forEach((el) => { gsap.fromTo(el, { scaleY: 0 }, { scaleY: 1, duration: 1, ease: 'power2.out', transformOrigin: 'top center', scrollTrigger: { trigger: el, start: 'top 92%', once: true } }); });
    const nav = document.querySelector('.nav');
    if (nav) { ScrollTrigger.create({ start: 'top -80', onUpdate: (self) => { nav.classList.toggle('nav--scrolled', self.progress > 0); } }); }
    setTimeout(() => ScrollTrigger.refresh(), 500);
    setTimeout(() => ScrollTrigger.refresh(), 1500);
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initAnimations); } else { initAnimations(); }
  document.addEventListener('visibilitychange', function () { if (!document.hidden && typeof gsap !== 'undefined') { gsap.ticker.wake(); if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh(); } });
</script>
