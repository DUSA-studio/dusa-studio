<script define:vars={{ regionData }}>
  /* ── Region-aware interactive pricing JS ── */
  window.__dusaRegion = JSON.parse(regionData);
</script>

<script>
  function initPricingAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initPricingAnimations, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');

    gsap.set('.pricing-hero__content, .pricing-card, .replace__header, .rack-row, .replace__savings-callout, .support__card, .compare__table-wrap, .mps, .faq__item', {
      visibility: 'visible',
    });

    gsap.fromTo('.pricing-hero__content',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.1 }
    );

    gsap.fromTo('.pricing-card',
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, stagger: 0.12, ease: 'power3.out', delay: 0.3 }
    );

    const replaceHeader = document.querySelector('.replace__header');
    if (replaceHeader) {
      gsap.fromTo(replaceHeader, { y: 30, opacity: 0 }, {
        y: 0, opacity: 1, duration: 0.7, ease: 'power3.out',
        scrollTrigger: { trigger: replaceHeader, start: 'top 90%', once: true },
      });
    }

    document.querySelectorAll('.rack-row').forEach((el) => {
      gsap.fromTo(el, { x: 20, opacity: 0 }, {
        x: 0, opacity: 1, duration: 0.4, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 95%', once: true },
      });
    });

    const savingsCallout = document.querySelector('.replace__savings-callout');
    if (savingsCallout) {
      gsap.fromTo(savingsCallout, { y: 10, opacity: 0 }, {
        y: 0, opacity: 1, duration: 0.5, ease: 'power3.out',
        scrollTrigger: { trigger: savingsCallout, start: 'top 95%', once: true },
      });
    }

    document.querySelectorAll('.support__card').forEach((el) => {
      gsap.fromTo(el, { y: 30, opacity: 0 }, {
        y: 0, opacity: 1, duration: 0.5, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 92%', once: true },
      });
    });

    gsap.fromTo('.compare__table-wrap',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: '.compare__table-wrap', start: 'top 92%', once: true },
      }
    );

    var mpsEl = document.querySelector('.mps');
    if (mpsEl) {
      gsap.fromTo(mpsEl,
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: mpsEl, start: 'top 92%', once: true },
        }
      );
    }

    document.querySelectorAll('.faq__item').forEach((el) => {
      gsap.fromTo(el, { y: 20, opacity: 0 }, {
        y: 0, opacity: 1, duration: 0.4, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 95%', once: true },
      });
    });

    setTimeout(() => ScrollTrigger.refresh(), 500);
    setTimeout(() => ScrollTrigger.refresh(), 1500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPricingAnimations);
  } else {
    initPricingAnimations();
  }

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && typeof gsap !== 'undefined') {
      gsap.ticker.wake();
      ScrollTrigger.refresh();
    }
  });

  /* ── Interactive Tool Selector + Dynamic Server Rack ── */
  function initToolSelector() {
    const rackDiscs = document.getElementById('rackDiscs');
    const rackFrame = document.getElementById('rackFrame');
    const dusaBase = document.getElementById('dusaBase');
    const batteryWrap = document.getElementById('batteryWrap');
    const cableSvg = document.getElementById('cableSvg');
    const rackStatus = document.getElementById('rackStatus');
    const rackActivate = document.getElementById('rackActivate');
    const rackCenter = document.getElementById('rackCenter');
    if (!rackDiscs) return;
    let animating = false;

    const rd = window.__dusaRegion || { sym: '$', currency: 'AUD', rate: 1, prices: { launchpad: 47, starter: 149, growth: 297 } };
    const sym = rd.sym;

    function getDusaPrice(toolCount) {
      if (toolCount <= 0) return 0;
      if (toolCount === 1) return rd.prices.launchpad;
      return rd.prices.starter;
    }
    function getDusaTier(toolCount) {
      if (toolCount <= 0) return '';
      if (toolCount === 1) return 'Launchpad';
      return 'Starter';
    }

    function getActiveSelections() {
      const selections = [];
      rackDiscs.querySelectorAll('.rack-row').forEach(row => {
        const dusaInput = row.querySelector('.dusa-toggle__input');
        const isDusa = dusaInput && dusaInput.checked;
        const activeBtn = row.querySelector('.replace__tool-btn--active');
        if (activeBtn && activeBtn.dataset.tool !== 'na') {
          const cost = parseInt(activeBtn.dataset.cost);
          selections.push({
            name: activeBtn.dataset.name,
            cost: isDusa ? 0 : cost,
            originalCost: cost,
            feature: row.querySelector('.rack-row__feature')?.textContent || '',
            rowIdx: activeBtn.dataset.row,
            rowEl: row,
            dusa: isDusa,
          });
        }
        if (isDusa && (!activeBtn || activeBtn.dataset.tool === 'na')) {
          selections.push({
            name: 'N/A',
            cost: 0,
            originalCost: 0,
            feature: row.querySelector('.rack-row__feature')?.textContent || '',
            rowIdx: row.dataset.row,
            rowEl: row,
            dusa: true,
          });
        }
      });
      return selections;
    }

    function getDusaInterests() {
      const interests = [];
      rackDiscs.querySelectorAll('.dusa-toggle__input:checked').forEach(input => {
        interests.push(input.dataset.feature);
      });
      return interests;
    }

    function buildBattery(count) {
      batteryWrap.innerHTML = '';
      const barCount = Math.max(count, 6);
      for (let i = 0; i < barCount; i++) {
        const bar = document.createElement('div');
        bar.className = 'rack-bbar';
        batteryWrap.appendChild(bar);
      }
    }

    function rebuildRack() {
      if (animating) return;
      cableSvg.innerHTML = '';
      rackFrame.classList.remove('rack-frame--calm');
      dusaBase.classList.remove('dusa-base--active', 'dusa-base--merged');
      rackStatus.classList.remove('rack-status--active', 'rack-status--done');

      rackDiscs.querySelectorAll('.rack-row').forEach(row => {
        const dusaInput = row.querySelector('.dusa-toggle__input');
        const isDusa = dusaInput && dusaInput.checked;
        if (isDusa) {
          row.classList.remove('rack-row--hot', 'rack-row--off', 'rack-row--cool', 'rack-row--merged');
          row.classList.add('rack-row--dusa');
          return;
        }
        const activeBtn = row.querySelector('.replace__tool-btn--active');
        const isActive = activeBtn && activeBtn.dataset.tool !== 'na';
        row.classList.remove('rack-row--hot', 'rack-row--off', 'rack-row--cool', 'rack-row--merged', 'rack-row--dusa');
        row.classList.add(isActive ? 'rack-row--hot' : 'rack-row--off');
      });

      const selections = getActiveSelections();
      const dusaCount = selections.filter(s => s.dusa).length;
      const nonDusaCount = selections.filter(s => !s.dusa).length;
      const toolCount = selections.length;
      const dusaPrice = getDusaPrice(dusaCount > 0 ? Math.max(dusaCount, toolCount) : toolCount);

      const hasNonDusa = nonDusaCount > 0;
      rackFrame.classList.toggle('rack-frame--stressed', hasNonDusa);
      rackFrame.classList.toggle('rack-frame--calm', dusaCount > 0 && !hasNonDusa);
      rackActivate.classList.toggle('rack-activate--hide', nonDusaCount === 0);

      buildBattery(Math.max(toolCount + 2, 6));

      if (dusaCount > 0) {
        dusaBase.classList.add('dusa-base--active');
        const bars = batteryWrap.querySelectorAll('.rack-bbar');
        bars.forEach((b, i) => {
          b.classList.toggle('rack-bbar--lit', i < dusaCount);
        });
      } else {
        dusaBase.classList.remove('dusa-base--active');
      }

      if (toolCount === 0) {
        rackStatus.textContent = 'Select tools or toggle DUSA to build your stack.';
      } else if (dusaCount > 0 && nonDusaCount === 0) {
        rackStatus.classList.add('rack-status--done');
        rackStatus.textContent = dusaCount + ' system' + (dusaCount > 1 ? 's' : '') + ' covered by DUSA.';
      } else {
        const competitorCost = selections.filter(s => !s.dusa).reduce((s, t) => s + t.cost, 0);
        const msg = nonDusaCount + ' disconnected system' + (nonDusaCount > 1 ? 's' : '') + '. ' + sym + competitorCost + '/mo overhead.';
        if (dusaCount > 0) {
          rackStatus.textContent = msg + ' ' + dusaCount + ' covered by DUSA.';
        } else {
          rackStatus.textContent = msg;
        }
      }

      const totalOriginalCost = selections.reduce((s, t) => s + (t.originalCost || t.cost), 0);
      if (dusaCount > 0) {
        updateSavings(totalOriginalCost, getDusaPrice(toolCount));
      } else if (toolCount > 0) {
        const totalCost = selections.reduce((s, t) => s + t.cost, 0);
        updateSavings(totalCost, dusaPrice);
      }

      if (toolCount === 0) {
        updateSavings(0, 0);
      }
    }

    function updateTotalsAndRack() {
      rebuildRack();
    }

    function updateSavings(total, dusaPrice) {
      const saveEl = document.getElementById('replaceSave');
      if (!saveEl) return;
      const saving = total - dusaPrice;
      const tier = getDusaTier(getActiveSelections().length);
      if (dusaPrice === 0) {
        saveEl.innerHTML = 'Select tools to see your savings.';
      } else if (saving > 0) {
        saveEl.innerHTML = 'Save <strong>' + sym + saving + '/mo</strong> with DUSA ' + tier + ' at <strong>' + sym + dusaPrice + '/mo</strong>';
      } else {
        saveEl.innerHTML = 'Get everything above with DUSA ' + tier + ' at <strong>' + sym + dusaPrice + '/mo</strong>';
      }
    }

    rackDiscs.addEventListener('change', function(e) {
      const input = e.target.closest('.dusa-toggle__input');
      if (!input || animating) return;

      const toggle = input.closest('.dusa-toggle');
      const rowIdx = toggle.dataset.row;
      const row = rackDiscs.querySelector(`.rack-row[data-row="${rowIdx}"]`);
      if (!row) return;

      const costCell = row.querySelector('.rack-row__cost');
      const isOn = input.checked;

      if (isOn) {
        row.classList.remove('rack-row--hot', 'rack-row--off');
        row.classList.add('rack-row--dusa');
        if (costCell) {
          costCell.textContent = 'Included';
          costCell.classList.remove('rack-row__cost--neutral');
        }
      } else {
        row.classList.remove('rack-row--dusa');
        const activeBtn = row.querySelector('.replace__tool-btn--active');
        const isActive = activeBtn && activeBtn.dataset.tool !== 'na';
        row.classList.add(isActive ? 'rack-row--hot' : 'rack-row--off');
        if (costCell && activeBtn) {
          const cost = parseInt(activeBtn.dataset.cost);
          const isNA = activeBtn.dataset.tool === 'na' || cost === 0;
          costCell.textContent = isNA ? 'N/A' : sym + cost;
          costCell.classList.toggle('rack-row__cost--neutral', isNA);
        }
      }

      updateTotalsAndRack();
    });

    rackDiscs.addEventListener('click', function(e) {
      const btn = e.target.closest('.replace__tool-btn');
      if (!btn || animating) return;

      const rowIdx = btn.dataset.row;
      const row = rackDiscs.querySelector(`.rack-row[data-row="${rowIdx}"]`);
      if (!row) return;

      const dusaInput = row.querySelector('.dusa-toggle__input');
      if (dusaInput && dusaInput.checked) {
        dusaInput.checked = false;
        row.classList.remove('rack-row--dusa');
      }

      row.querySelectorAll('.replace__tool-btn').forEach(b => b.classList.remove('replace__tool-btn--active'));
      btn.classList.add('replace__tool-btn--active');

      const costCell = row.querySelector('.rack-row__cost');
      if (costCell) {
        const newCost = parseInt(btn.dataset.cost);
        const isNA = btn.dataset.tool === 'na' || newCost === 0;
        costCell.textContent = isNA ? 'N/A' : sym + newCost;
        costCell.classList.toggle('rack-row__cost--neutral', isNA);
      }

      updateTotalsAndRack();
    });

    rackActivate.addEventListener('click', async function() {
      if (animating) return;
      const selections = getActiveSelections();
      if (selections.length === 0) return;
      animating = true;
      rackActivate.classList.add('rack-activate--hide');

      const activeRows = selections.map(s => s.rowEl);
      const bars = batteryWrap.querySelectorAll('.rack-bbar');
      const totalCost = selections.reduce((s, t) => s + t.cost, 0);
      const dusaPrice = getDusaPrice(selections.length);

      rackStatus.textContent = 'Initializing DUSA platform...';
      rackStatus.classList.add('rack-status--active');

      bars.forEach(b => b.classList.add('rack-bbar--flicker'));
      await sleep(600);
      for (let i = 0; i < bars.length; i++) {
        bars[i].classList.remove('rack-bbar--flicker');
        bars[i].classList.add('rack-bbar--lit');
        await sleep(80);
      }
      await sleep(200);
      dusaBase.classList.add('dusa-base--active');
      await sleep(400);

      rackStatus.textContent = 'Connecting systems...';

      for (let step = 0; step < activeRows.length; step++) {
        const rowIdx = activeRows.length - 1 - step;
        const row = activeRows[rowIdx];
        const side = step % 2 === 0 ? 'right' : 'left';
        const fromEl = step === 0 ? dusaBase : activeRows[rowIdx + 1];

        await sleep(150);
        await drawCable(row, fromEl, side);
        await sleep(200);

        row.classList.remove('rack-row--hot');
        row.classList.add('rack-row--cool');

        await sleep(150);
      }

      await sleep(300);

      rackStatus.textContent = 'Unifying platform...';

      cableSvg.querySelectorAll('path').forEach(p => {
        p.style.transition = 'opacity 0.8s ease-out';
        p.style.opacity = '0';
      });

      await sleep(600);

      activeRows.forEach(row => {
        row.classList.add('rack-row--merged');
        const handle = row.querySelector('.rack-row__handle');
        if (handle) handle.style.opacity = '0';
      });

      rackFrame.classList.remove('rack-frame--stressed');
      rackFrame.classList.add('rack-frame--calm');
      dusaBase.classList.add('dusa-base--merged');

      await sleep(800);
      cableSvg.innerHTML = '';

      const saving = totalCost - dusaPrice;
      const yearly = saving * 12;
      rackStatus.classList.remove('rack-status--active');
      rackStatus.classList.add('rack-status--done');
      if (saving > 0) {
        rackStatus.textContent = 'Unified. You save ' + sym + saving + '/mo (' + sym + yearly + '/yr)';
      } else {
        rackStatus.textContent = 'Unified. One platform. ' + sym + dusaPrice + '/mo.';
      }

      animating = false;
      setTimeout(() => { rackActivate.classList.remove('rack-activate--hide'); }, 2000);
    });

    function elPos(el) {
      const outerRect = rackCenter.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return {
        cx: r.left + r.width / 2 - outerRect.left,
        cy: r.top + r.height / 2 - outerRect.top,
        top: r.top - outerRect.top,
        bottom: r.bottom - outerRect.top,
        left: r.left - outerRect.left,
        right: r.right - outerRect.left,
        w: r.width,
        h: r.height,
      };
    }

    async function drawCable(toDisc, fromEl, side) {
      const outerRect = rackCenter.getBoundingClientRect();
      const vw = outerRect.width;
      const vh = outerRect.height;
      cableSvg.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
      cableSvg.removeAttribute('width');
      cableSvg.removeAttribute('height');

      const to = elPos(toDisc);
      const from = elPos(fromEl);

      let sx, sy, ex, ey, cpx;
      sy = from.cy;
      ey = to.cy;

      if (side === 'right') {
        sx = from.right + 6;
        ex = to.right + 6;
        cpx = Math.max(sx, ex) + 30;
      } else {
        sx = from.left - 6;
        ex = to.left - 6;
        cpx = Math.min(sx, ex) - 30;
      }

      const d = `M ${sx} ${sy} C ${cpx} ${sy}, ${cpx} ${ey}, ${ex} ${ey}`;

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      const glow = document.createElementNS('http://www.w3.org/2000/svg', 'path');

      path.setAttribute('d', d);
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', '#4ED8C2');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('stroke-linecap', 'round');
      glow.setAttribute('d', d);
      glow.setAttribute('fill', 'none');
      glow.setAttribute('stroke', 'rgba(78,216,194,0.15)');
      glow.setAttribute('stroke-width', '6');
      glow.setAttribute('stroke-linecap', 'round');
      glow.style.opacity = '0';

      cableSvg.appendChild(glow);
      cableSvg.appendChild(path);

      const len = path.getTotalLength();
      path.style.strokeDasharray = len;
      path.style.strokeDashoffset = String(len);
      glow.style.strokeDasharray = len;
      glow.style.strokeDashoffset = String(len);

      requestAnimationFrame(() => { requestAnimationFrame(() => {
        path.style.transition = 'stroke-dashoffset 0.5s ease-out';
        glow.style.transition = 'stroke-dashoffset 0.5s ease-out, opacity 0.4s';
        path.style.strokeDashoffset = '0';
        glow.style.strokeDashoffset = '0';
        glow.style.opacity = '1';
      }); });

      await sleep(550);
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    rebuildRack();
  }

  function initExpandableRows() {
    const featureRows = document.querySelectorAll('.compare__feature-row');

    featureRows.forEach(row => {
      row.addEventListener('click', function() {
        const descRow = this.nextElementSibling;
        if (!descRow || !descRow.classList.contains('compare__desc-row')) return;

        const isOpen = descRow.classList.contains('compare__desc-row--open');

        document.querySelectorAll('.compare__desc-row--open').forEach(r => r.classList.remove('compare__desc-row--open'));
        document.querySelectorAll('.compare__feature-row--open').forEach(r => r.classList.remove('compare__feature-row--open'));

        if (!isOpen) {
          descRow.classList.add('compare__desc-row--open');
          this.classList.add('compare__feature-row--open');
        }
      });
    });
  }

  function getToolStack() {
    const tools = [];
    const rows = document.querySelectorAll('.rack-row');
    rows.forEach(row => {
      const activeBtn = row.querySelector('.replace__tool-btn--active');
      if (!activeBtn) return;
      const name = activeBtn.dataset.name;
      const cost = activeBtn.dataset.cost;
      const feature = row.querySelector('.rack-row__feature');
      const category = feature ? feature.textContent.trim() : '';
      if (name && name !== 'N/A') {
        tools.push({ tool: name, category: category, cost: cost });
      }
    });
    return tools;
  }

  function saveToolStack() {
    try {
      const stack = getToolStack();
      sessionStorage.setItem('dusa_tool_stack', JSON.stringify(stack));
      const tagList = stack.map(t => t.tool).join(', ');
      sessionStorage.setItem('dusa_tool_tags', tagList);
      const totalSpend = stack.reduce((sum, t) => sum + Number(t.cost || 0), 0);
      sessionStorage.setItem('dusa_current_spend', String(totalSpend));
    } catch(err) { /* silent */ }
  }

  document.querySelectorAll('.replace__tool-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      setTimeout(saveToolStack, 50);
    });
  });

  function initCtaCapture() {
    const ctaLinks = document.querySelectorAll('a[href*="bookings/dusa-demo"], a[href*="#contact"], a[href*="mailto:"], a[href*="/start"]');
    ctaLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        saveToolStack();

        const toggles = document.querySelectorAll('.dusa-toggle__input:checked');
        const interests = [];
        toggles.forEach(input => { interests.push(input.dataset.feature); });
        const interestStr = interests.join(', ');

        const stack = getToolStack();
        const toolTags = stack.map(t => t.tool).join(', ');
        const totalSpend = stack.reduce((sum, t) => sum + Number(t.cost || 0), 0);

        if (this.href && this.href.includes('bookings/dusa-demo')) {
          e.preventDefault();
          const url = new URL(this.href);
          if (interestStr) {
            url.searchParams.set('dusa_interests', interestStr);
            url.searchParams.set('dusa_count', String(interests.length));
          }
          if (toolTags) {
            url.searchParams.set('current_tools', toolTags);
            url.searchParams.set('current_spend', String(totalSpend));
          }
          window.open(url.toString(), '_blank');
          return;
        }

        if (this.href && this.href.startsWith('mailto:')) {
          e.preventDefault();
          const parts = [];
          if (interestStr) parts.push('Interested in: ' + interestStr);
          if (toolTags) parts.push('Current tools: ' + toolTags);
          const subject = encodeURIComponent('DUSA Enquiry - ' + parts.join(' | '));
          window.location.href = this.href + '?subject=' + subject;
          return;
        }

        if (interests.length > 0) {
          try { sessionStorage.setItem('dusa_interests', JSON.stringify(interests)); } catch(err) {}
        }
      });
    });
  }

  function initMobilePlanSelector() {
    var mps = document.getElementById('mobile-plan-selector');
    if (!mps) return;

    var rd = window.__dusaRegion || { sym: '$', currency: 'AUD', prices: { launchpad: 47, starter: 149, growth: 297 } };
    var s = rd.sym;

    // Detect regional prefix for /start links
    var regionMatch = window.location.pathname.match(/^\/(us|uk|es|mx|br|fr|de)(\/|$)/);
    var startLink = regionMatch ? '/' + regionMatch[1] + '/start' : '/start';

    var plans = [
      { name: 'Launchpad', price: s + rd.prices.launchpad, period: '/mo ' + rd.currency, cta: 'Start for ' + s + rd.prices.launchpad, ctaLink: startLink },
      { name: 'Starter', price: s + rd.prices.starter, period: '/mo ' + rd.currency, cta: 'Get Starter', ctaLink: startLink },
      { name: 'Growth', price: s + rd.prices.growth, period: '/mo ' + rd.currency, cta: 'Scale Faster', ctaLink: startLink },
      { name: 'Bespoke', price: 'Custom', period: '', cta: "Let's Talk", ctaLink: 'https://link.dusa.studio/widget/bookings/dusa-demo' }
    ];

    var categories = [
      { name: 'Core platform', features: [
        { label: 'CRM & pipeline management', vals: ['Pick 1', true, true, true] },
        { label: 'Funnel & website builder', vals: ['Pick 1', true, true, true] },
        { label: 'Email marketing', vals: ['Pick 1', true, true, true] },
        { label: 'SMS marketing', vals: ['Pick 1', true, true, true] },
        { label: 'Booking & calendar', vals: ['Pick 1', true, true, true] },
        { label: 'Social media planner', vals: ['Pick 1', true, true, true] },
        { label: 'Reputation management', vals: ['Pick 1', true, true, true] },
        { label: 'Invoicing & payments', vals: ['Pick 1', true, true, true] },
        { label: 'Forms & surveys', vals: ['Pick 1', true, true, true] },
      ]},
      { name: 'Automation & AI', features: [
        { label: 'Basic workflow automations', vals: [false, true, true, true] },
        { label: 'Multi-step automation builder', vals: [false, '5 workflows', 'Unlimited', 'Unlimited'] },
        { label: 'Trigger-based sequences', vals: [false, true, true, true] },
        { label: 'AI-powered auto-responses', vals: [false, false, true, true] },
        { label: 'AI content assistant', vals: [false, false, true, true] },
        { label: 'Conditional logic & branching', vals: [false, false, true, true] },
        { label: 'Custom automation builds', vals: [false, false, false, true] },
      ]},
      { name: 'Contacts & data', features: [
        { label: 'Contact records', vals: ['500', '2,500', 'Unlimited', 'Unlimited'] },
        { label: 'Custom fields', vals: ['10', '50', 'Unlimited', 'Unlimited'] },
        { label: 'Tags & segments', vals: [true, true, true, true] },
        { label: 'Import / export contacts', vals: [true, true, true, true] },
        { label: 'Lead scoring', vals: [false, false, true, true] },
        { label: 'Smart lists & filters', vals: [false, true, true, true] },
      ]},
      { name: 'Reporting & analytics', features: [
        { label: 'Basic dashboard', vals: [true, true, true, true] },
        { label: 'Campaign performance', vals: [false, true, true, true] },
        { label: 'Pipeline & revenue reporting', vals: [false, true, true, true] },
        { label: 'Custom dashboards', vals: [false, false, true, true] },
        { label: 'Attribution tracking', vals: [false, false, true, true] },
        { label: 'Scheduled report emails', vals: [false, false, true, true] },
      ]},
      { name: 'Support & community', features: [
        { label: 'Knowledge base & guides', vals: [true, true, true, true] },
        { label: 'AI assistant (24/7)', vals: [true, true, true, true] },
        { label: 'Community access', vals: [true, true, true, true] },
        { label: 'Email support', vals: [true, true, true, true] },
        { label: 'Priority support queue', vals: [false, false, true, true] },
        { label: 'Onboarding strategy session', vals: [false, false, true, true] },
        { label: 'Dedicated account manager', vals: [false, false, false, true] },
        { label: 'Phone support', vals: [false, false, false, true] },
        { label: 'Monthly strategy reviews', vals: [false, false, false, true] },
      ]},
      { name: 'Platform & integrations', features: [
        { label: 'Members portal access', vals: [true, true, true, true] },
        { label: 'Mobile app', vals: [true, true, true, true] },
        { label: 'Zapier integration', vals: [false, true, true, true] },
        { label: 'API access', vals: [false, false, true, true] },
        { label: 'Custom domain', vals: [false, true, true, true] },
        { label: 'White-label client portal', vals: [false, false, false, true] },
        { label: 'Multi-location management', vals: [false, false, false, true] },
        { label: 'Team user accounts', vals: [false, false, false, true] },
        { label: 'Custom integrations', vals: [false, false, false, true] },
      ]}
    ];

    var currentPlan = 0;
    var tabs = mps.querySelectorAll('.mps__tab');
    var priceEl = document.getElementById('mps-price');
    var featuresEl = document.getElementById('mps-features');
    var ctaEl = document.getElementById('mps-cta');

    var checkSvg = '<svg class="mps__row-icon mps__row-icon--check" viewBox="0 0 20 20" fill="none" width="20" height="20"><path d="M5 10l3.5 3.5L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    var dashSvg = '<svg class="mps__row-icon mps__row-icon--dash" viewBox="0 0 20 20" fill="none" width="20" height="20"><line x1="6" y1="10" x2="14" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

    function renderFeatures(idx) {
      var html = '';
      categories.forEach(function(cat) {
        html += '<p class="mps__cat-label">' + cat.name + '</p>';
        cat.features.forEach(function(f) {
          var v = f.vals[idx];
          var isOff = v === false;
          var icon = isOff ? dashSvg : checkSvg;
          var badge = '';
          if (typeof v === 'string') {
            badge = '<span class="mps__row-badge">' + v + '</span>';
          }
          html += '<div class="mps__row' + (isOff ? ' mps__row--off' : '') + '">';
          html += '<div class="mps__row-left">' + icon + '<span class="mps__row-label">' + f.label + '</span></div>';
          if (badge) html += badge;
          html += '</div>';
        });
      });
      featuresEl.innerHTML = html;
    }

    function selectPlan(idx) {
      currentPlan = idx;
      tabs.forEach(function(tab, i) {
        if (i === idx) {
          tab.classList.add('mps__tab--active');
        } else {
          tab.classList.remove('mps__tab--active');
        }
      });

      var p = plans[idx];
      if (p.price === 'Custom') {
        priceEl.innerHTML = '<span class="mps__price-amount">Custom</span>';
      } else {
        priceEl.innerHTML = '<span class="mps__price-amount">' + p.price + '</span><span class="mps__price-period">' + p.period + '</span>';
      }

      ctaEl.textContent = p.cta;
      ctaEl.href = p.ctaLink;
      if (p.ctaLink.startsWith('http')) {
        ctaEl.target = '_blank';
        ctaEl.rel = 'noopener';
      } else {
        ctaEl.removeAttribute('target');
        ctaEl.removeAttribute('rel');
      }

      renderFeatures(idx);
    }

    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() { selectPlan(i); });
    });

    var touchStartX = 0;
    var touchStartY = 0;
    mps.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    mps.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      var dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        if (dx < 0 && currentPlan < 3) selectPlan(currentPlan + 1);
        else if (dx > 0 && currentPlan > 0) selectPlan(currentPlan - 1);
      }
    }, { passive: true });

    selectPlan(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initToolSelector(); initExpandableRows(); initCtaCapture(); initMobilePlanSelector(); });
  } else {
    initToolSelector();
    initExpandableRows();
    initCtaCapture();
    initMobilePlanSelector();
  }
</script>
