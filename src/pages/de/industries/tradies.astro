---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';
---

<BaseLayout t={tData} title="CRM für Handwerker und Handwerksbetriebe | DUSA.studio" description="Verpassen Sie nie wieder eine Auftragsanfrage. Automatische Rückruf-SMS, Angebots-Pipeline, Terminplanung und Google-Bewertungsanfragen für Handwerker. Jetzt DUSA kostenlos testen.">

  <!-- Hero -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Handwerker</span>
        <h1>Mehr Aufträge gewinnen.<br/>Weniger <span class="gradient-text">Papierkram</span>.</h1>
        <p class="ind-hero__sub">
          Wenn Sie auf der Baustelle sind, gehen Anfragen verloren. DUSA fängt jede Anfrage ab, versendet Angebote und kümmert sich um die Nachverfolgung, damit Sie sich auf Ihre Arbeit konzentrieren können.
        </p>
        <a href="/de/start" class="btn btn--primary">Kostenlos starten</a>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ind-pain section--dark">
    <div class="container">
      <h2><span class="gradient-text">Kommt Ihnen das bekannt vor?</span></h2>
      <div class="ind-pain__cards">

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <h3 class="ind-pain__card-title">Verpasste Anrufe auf der Baustelle</h3>
          <p class="ind-pain__card-desc">Sie stehen auf der Leiter oder liegen unter der Spüle, wenn das Telefon klingelt. Bis Sie zurückrufen, hat der Kunde längst jemand anderen beauftragt.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </div>
          <h3 class="ind-pain__card-title">Angebote gehen in Nachrichten verloren</h3>
          <p class="ind-pain__card-desc">Sie senden ein Angebot per SMS und es verschwindet im Nichts. Keine Nachverfolgung, kein Follow-up, keine Ahnung, ob es überhaupt gelesen wurde.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
            </svg>
          </div>
          <h3 class="ind-pain__card-title">Kein Follow-up bei alten Anfragen</h3>
          <p class="ind-pain__card-desc">Die Küchenrenovierung von vor drei Monaten? Vergessen. Kein System, um Anfragen erneut aufzugreifen, die damals nicht bereit waren.</p>
        </div>

        <div class="ind-pain__card">
          <div class="ind-pain__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </div>
          <h3 class="ind-pain__card-title">Zahlungen hinterherlaufen</h3>
          <p class="ind-pain__card-desc">Der Auftrag ist erledigt, aber die Rechnung bleibt unbezahlt. Sie verschwenden Zeit mit Zahlungserinnerungen, anstatt den nächsten Auftrag zu beginnen.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ind-solution section--dark">
    <div class="container">
      <h2>So funktioniert DUSA für <span class="gradient-text">Handwerker</span></h2>
      <p class="ind-solution__sub">Entwickelt für die Arbeitsweise von Handwerkern. Auf der Baustelle, unterwegs, bei der Arbeit.</p>
      <div class="ind-solution__grid">

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Automatische Rückruf-SMS</h3>
          <p class="ind-solution__card-desc">Wenn Sie nicht ans Telefon gehen können, sendet DUSA sofort eine SMS an den Anrufer. "Hallo, ich bin gerade auf einer Baustelle. Ich rufe Sie innerhalb einer Stunde zurück." Das hält den Kontakt warm.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3h18v18H3zM3 9h18M9 21V9" />
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Angebots-Pipeline</h3>
          <p class="ind-solution__card-desc">Verfolgen Sie jedes Angebot von der Anfrage bis zur Zusage. Sehen Sie, welche Aufträge ausstehen, verfolgen Sie zum richtigen Zeitpunkt nach und verlieren Sie nie wieder einen Kontakt.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18" />
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Terminplanung</h3>
          <p class="ind-solution__card-desc">Planen Sie Aufträge, vergeben Sie Termine und halten Sie Ihren Kalender voll. Kunden erhalten automatische Bestätigungen und Erinnerungen, damit niemand etwas vergisst.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8" />
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Automatische Zahlungserinnerungen</h3>
          <p class="ind-solution__card-desc">Senden Sie Rechnungen über DUSA und lassen Sie das System die Zahlungsverfolgung für Sie übernehmen. Freundliche Erinnerungen werden planmäßig verschickt, bis der Auftrag bezahlt ist.</p>
        </div>

        <div class="ind-solution__card">
          <div class="ind-solution__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </div>
          <h3 class="ind-solution__card-title">Google-Bewertungsanfragen</h3>
          <p class="ind-solution__card-desc">Nach jedem abgeschlossenen Auftrag sendet DUSA eine Bewertungsanfrage. Bauen Sie Ihren Ruf mit jeder Fünf-Sterne-Bewertung weiter aus.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ind-pipeline section--dark">
    <div class="container">
      <h2>Von der Anfrage bis zur <span class="gradient-text">Bezahlung</span></h2>
      <div class="ind-pipeline__track">

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">01</div>
          <h3 class="ind-pipeline__step-title">Anfrage</h3>
          <p class="ind-pipeline__step-desc">Ein neuer Interessent ruft an, schreibt eine SMS oder füllt Ihr Formular aus. DUSA erfasst die Details und sendet sofort eine Antwort.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">02</div>
          <h3 class="ind-pipeline__step-title">Angebot gesendet</h3>
          <p class="ind-pipeline__step-desc">Sie senden ein Angebot über DUSA. Das System verfolgt, wann es geöffnet wird, und erinnert Sie an die Nachverfolgung.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">03</div>
          <h3 class="ind-pipeline__step-title">Angebot angenommen</h3>
          <p class="ind-pipeline__step-desc">Der Kunde sagt zu. DUSA führt den Vorgang weiter und bestätigt die Buchung.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">04</div>
          <h3 class="ind-pipeline__step-title">Auftrag geplant</h3>
          <p class="ind-pipeline__step-desc">Der Auftrag ist terminiert. Automatische Erinnerungen gehen sowohl an Sie als auch an den Kunden.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">05</div>
          <h3 class="ind-pipeline__step-title">Abgeschlossen</h3>
          <p class="ind-pipeline__step-desc">Die Arbeit ist erledigt. DUSA löst Ihre Rechnung und eine Google-Bewertungsanfrage aus.</p>
        </div>

        <div class="ind-pipeline__step">
          <div class="ind-pipeline__num">06</div>
          <h3 class="ind-pipeline__step-title">Bezahlt</h3>
          <p class="ind-pipeline__step-desc">Zahlung eingegangen. Der Auftrag wird abgeschlossen und fließt in Ihre Auswertungen ein.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ind-stats section--dark">
    <div class="container">
      <div class="ind-stats__grid">

        <div class="ind-stats__card">
          <span class="ind-stats__number">85%</span>
          <p class="ind-stats__label">der Kunden beauftragen den Handwerker, der zuerst antwortet</p>
        </div>

        <div class="ind-stats__card">
          <span class="ind-stats__number">4x</span>
          <p class="ind-stats__label">mehr Angebote angenommen durch rechtzeitige Nachverfolgung</p>
        </div>

        <div class="ind-stats__card">
          <span class="ind-stats__number">10 Std.</span>
          <p class="ind-stats__label">pro Woche eingespart bei Verwaltung und Nachfassen</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2>Bereit, Ihren Betrieb smarter zu führen?</h2>
        <p>Richten Sie Ihre Pipeline, Automatisierungen und Ihr Bewertungssystem in weniger als einer Stunde ein. Keine Vertragsbindung, kein Aufwand.</p>
        <div class="ind-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/crm-for-tradies" class="ind-cta__link">Leitfaden lesen &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://dusa.studio/de/" },
      { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://dusa.studio/de/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Handwerker", "item": "https://dusa.studio/de/industries/tradies" }
    ]
  })} />

</BaseLayout>

<style>
  /* Hero */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Pain Points */
  .ind-pain {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-pain h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .ind-pain__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }
  .ind-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s, transform 0.3s;
  }
  .ind-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ind-pain__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }
  .ind-pain__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }
  .ind-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-pain__card-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* Solution */
  .ind-solution {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xs);
  }
  .ind-solution__sub {
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-xl);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .ind-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .ind-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s, transform 0.3s;
  }
  .ind-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ind-solution__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }
  .ind-solution__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }
  .ind-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-solution__card-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
  }

  /* Pipeline - 6 steps for tradies */
  .ind-pipeline {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--warm-white);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .ind-pipeline__track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-md);
  }
  .ind-pipeline__step {
    text-align: center;
  }
  .ind-pipeline__num {
    font-family: var(--font-mono, monospace);
    font-size: 2rem;
    font-weight: 700;
    color: var(--reef-aqua);
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }
  .ind-pipeline__step-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-pipeline__step-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
  }

  /* Stats */
  .ind-stats {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }
  .ind-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    max-width: 800px;
    margin: 0 auto;
  }
  .ind-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ind-stats__number {
    display: block;
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }
  .ind-stats__label {
    font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.5;
  }

  /* CTA */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }
  .ind-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ind-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ind-cta__box p {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .ind-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }
  .ind-cta__link {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .ind-cta__link:hover {
    opacity: 0.7;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .ind-pain__cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .ind-pipeline__track {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-pain__cards {
      grid-template-columns: 1fr;
    }
    .ind-solution__grid {
      grid-template-columns: 1fr;
    }
    .ind-pipeline__track {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
    .ind-stats__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
    .ind-pipeline__track {
      grid-template-columns: 1fr;
    }
    .ind-pain__card,
    .ind-solution__card,
    .ind-stats__card {
      padding: var(--space-md);
    }
    .ind-cta__box {
      padding: var(--space-md);
    }
    .ind-cta__actions {
      flex-direction: column;
    }
  }

  /* Light Mode */
  :global(html[data-theme="light"]) .ind-hero__content h1,
  :global(html[data-theme="light"]) .ind-pain__card-title,
  :global(html[data-theme="light"]) .ind-solution__card-title,
  :global(html[data-theme="light"]) .ind-pipeline__step-title,
  :global(html[data-theme="light"]) .ind-pain h2,
  :global(html[data-theme="light"]) .ind-solution h2,
  :global(html[data-theme="light"]) .ind-pipeline h2,
  :global(html[data-theme="light"]) .ind-stats h2,
  :global(html[data-theme="light"]) .ind-cta__box h2 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-hero__sub,
  :global(html[data-theme="light"]) .ind-pain__card-desc,
  :global(html[data-theme="light"]) .ind-solution__card-desc,
  :global(html[data-theme="light"]) .ind-solution__sub,
  :global(html[data-theme="light"]) .ind-pipeline__step-desc,
