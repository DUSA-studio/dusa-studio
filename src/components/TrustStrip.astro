---
/**
 * TrustStrip.astro
 *
 * A slim glass bar that answers the "what happens if you disappear?" question
 * in one line: DUSA runs on HighLevel, and here are HighLevel's own published
 * numbers. The HighLevel mark is their official white logo exactly as supplied
 * (public/brand/highlevel-logo-white.svg): their brand kit forbids recolouring,
 * effects or redrawing it, so the glass is ours and the logo is theirs.
 *
 * Numbers are HighLevel's own, from gohighlevel.com (October 2026): 2.2 million
 * businesses, 7.3 billion leads generated, 179 million appointments booked,
 * US$5.2 billion in sales facilitated in 2025. Update `trust.stats` in the
 * dictionaries when they publish new ones.
 *
 * Renders nothing when the dictionary has no `trust` block, so locale pages
 * stay in their own language until the keys are translated.
 */
interface Props {
  t?: Record<string, any>;
  /** Tighter top margin when it sits directly under a hero. */
  tight?: boolean;
}
const { t = {}, tight = false } = Astro.props;
const s = t?.trust || null;
const show = !!s;

const lead = (s && s.lead) || 'Built on HighLevel';
const sub = (s && s.sub) || 'The platform under every DUSA account';
const stats: [string, string][] = (s && s.stats) || [
  ['2.2M', 'businesses'],
  ['7.3B', 'leads generated'],
  ['179M', 'appointments booked'],
  ['US$5.2B', 'in sales, 2025'],
];
const source = (s && s.source) || 'HighLevel, published figures';
const linkLabel = (s && s.link) || 'Why we tell you';
const linkHref = '/compare/highlevel';
---

{show && (
<section class={`trust${tight ? ' trust--tight' : ''}`} aria-label={(s && s.aria) || 'Platform trust facts'}>
  <div class="trust__bar">
    <a class="trust__brand" href={linkHref} data-page="compare/highlevel">
      <span class="trust__logo">
        <img src="/brand/highlevel-logo-white.svg" alt="HighLevel" width="172" height="38" loading="lazy" decoding="async" />
      </span>
      <span class="trust__words">
        <span class="trust__lead">{lead}</span>
        <span class="trust__sub">{sub}</span>
      </span>
    </a>
    <ul class="trust__stats" title={source}>
      {stats.map(([n, label]) => (
        <li class="trust__stat"><b>{n}</b><span>{label}</span></li>
      ))}
    </ul>
    <a class="trust__link" href={linkHref} data-page="compare/highlevel">{linkLabel} <span aria-hidden="true">&rarr;</span></a>
  </div>
</section>
)}

<style>
  .trust {
    position: relative;
    padding: 0 var(--space-md);
    margin: var(--space-lg) auto var(--space-xl);
    max-width: 1200px;
  }
  .trust--tight { margin-top: var(--space-md); }

  /* The bar: the same frosted glass recipe as the nav pills. */
  .trust__bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 68px;
    padding: 0.7rem 1.2rem 0.7rem 1rem;
    border-radius: 100px;
    border: 1.5px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(135deg, rgba(247, 244, 239, 0.07), rgba(247, 244, 239, 0.025));
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.08), 0 10px 40px rgba(0, 0, 0, 0.18);
  }

  .trust__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  /* The official mark, as supplied: white wordmark + the three arrows. It sits
     on a Space Blue plate (HighLevel's own primary background colour) so it
     reads the same in both themes without touching the artwork. */
  .trust__logo {
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 0.85rem;
    border-radius: 100px;
    background: #07223D;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 2px 10px rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
  }
  .trust__logo img { display: block; height: 20px; width: auto; }

  .trust__words { display: flex; flex-direction: column; line-height: 1.25; max-width: 200px; }
  .trust__lead {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--warm-white);
  }
  .trust__sub {
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.62);
  }

  /* Their numbers, as stat chips. */
  .trust__stats {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.4rem 0.5rem;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    justify-content: center;
  }
  .trust__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(78, 216, 194, 0.18);
    background: rgba(78, 216, 194, 0.06);
    white-space: nowrap;
  }
  .trust__stat b {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--warm-white);
    letter-spacing: -0.01em;
  }
  .trust__stat span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(247, 244, 239, 0.66);
  }
  .trust__link {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.5rem 0.25rem;
    transition: color var(--duration-fast);
  }
  .trust__link span { margin-left: 0.3em; }
  .trust__link:hover { color: var(--warm-white); }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .trust__bar { flex-wrap: wrap; border-radius: 28px; justify-content: center; row-gap: 0.75rem; padding: 0.9rem 1rem; }
    .trust__brand { width: 100%; justify-content: center; }
    .trust__stats { width: 100%; display: flex; flex-wrap: wrap; }
  }
  @media (max-width: 480px) {
    .trust { padding: 0 var(--space-sm); }
    .trust__brand { flex-direction: column; gap: 0.5rem; text-align: center; }
    .trust__stat { padding: 0.3rem 0.65rem; }
    .trust__stat b { font-size: 0.875rem; }
    .trust__stat span { font-size: 0.625rem; }
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .trust__bar {
    border-color: rgba(12, 14, 20, 0.1);
    background: linear-gradient(135deg, rgba(12, 14, 20, 0.04), rgba(12, 14, 20, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 10px 30px rgba(12, 14, 20, 0.06);
  }
  :global(html[data-theme="light"]) .trust__lead { color: var(--deep-black); }
  :global(html[data-theme="light"]) .trust__sub { color: rgba(12, 14, 20, 0.64); }
  :global(html[data-theme="light"]) .trust__stat { border-color: rgba(26, 58, 92, 0.18); background: rgba(26, 58, 92, 0.05); }
  :global(html[data-theme="light"]) .trust__stat b { color: var(--deep-black); }
  :global(html[data-theme="light"]) .trust__stat span { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .trust__link { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .trust__link:hover { color: var(--deep-black); }
</style>
