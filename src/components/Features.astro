<script>
  /* Swap the static lotus for the animated one only once the chip is close to
     the viewport. Runs independently of GSAP so a slow library never holds it up. */
  (function () {
    var el = document.getElementById('features-lotus');
    if (!el) return;
    var src = el.getAttribute('data-animated');
    if (!src) return;

    var reduceMotion = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;  // the still lotus is the correct end state here

    function load() {
      el.setAttributeNS('http://www.w3.org/1999/xlink', 'href', src);
      el.setAttribute('href', src);
    }

    if (!('IntersectionObserver' in window)) { load(); return; }

    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { load(); io.disconnect(); }
    }, { rootMargin: '200px' });
    io.observe(el);
  })();

  function initMoboAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initMoboAnimations, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');

    gsap.set('.mobo__header, .mobo__board, .mobo__footer', {
      visibility: 'visible',
    });

    /* Header */
    gsap.fromTo('.mobo__header',
      { y: 40, opacity: 0 },
      {
        y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: '.mobo__header', start: 'top 85%' }
      }
    );

    /* Board */
    gsap.fromTo('.mobo__board',
      { scale: 0.88, opacity: 0 },
      {
        scale: 1, opacity: 1, duration: 1, ease: 'power3.out',
        scrollTrigger: { trigger: '.mobo__stage', start: 'top 75%' }
      }
    );

    /* CPU chip */
    gsap.fromTo('.mobo__cpu-g',
      { scale: 0, opacity: 0, transformOrigin: '340px 340px' },
      {
        scale: 1, opacity: 1, duration: 0.6, delay: 0.3, ease: 'back.out(2)',
        scrollTrigger: { trigger: '.mobo__stage', start: 'top 70%' }
      }
    );

    /* Traces fade in */
    gsap.fromTo('.mobo__pcb .mobo__in, .mobo__pcb .mobo__out',
      { opacity: 0 },
      {
        opacity: 1, duration: 1.5, delay: 0.5, ease: 'power2.out',
        scrollTrigger: { trigger: '.mobo__stage', start: 'top 70%' }
      }
    );

    /* Nodes stagger */
    gsap.fromTo('.mobo__node',
      { opacity: 0, scale: 0.6 },
      {
        opacity: 1, scale: 1, duration: 0.5, stagger: 0.12, ease: 'back.out(1.6)',
        scrollTrigger: { trigger: '.mobo__stage', start: 'top 65%' }
      }
    );

    /* Footer */
    gsap.fromTo('.mobo__footer',
      { y: 20, opacity: 0 },
      {
        y: 0, opacity: 1, duration: 0.6, ease: 'power3.out',
        scrollTrigger: { trigger: '.mobo__footer', start: 'top 90%' }
      }
    );
  }

  document.addEventListener('DOMContentLoaded', initMoboAnimations);
  document.addEventListener('astro:page-load', initMoboAnimations);
</script>
