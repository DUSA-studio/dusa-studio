---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/t.js';
import tData from '../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';
---

<BaseLayout title={t(lang, 'onboarding.page.metaTitle')} description={t(lang, 'onboarding.page.metaDesc')} lang="fr" ogLocale="fr_FR" region={region} t={tData}>
  <section class="ob-hero section--dark">
    <div class="container">
      <p class="ob-hero__eyebrow">{t(lang, 'onboarding.page.eyebrow')}</p>
      <h1 class="ob-hero__title">{t(lang, 'onboarding.page.title')} <span class="text--aqua">{t(lang, 'onboarding.page.titleAccent')}</span></h1>
      <p class="ob-hero__sub">{t(lang, 'onboarding.page.sub')}</p>
    </div>
  </section>
  <section class="ob-timeline section--dark">
    <div class="container">
      <div class="ob-phase">
        <div class="ob-phase__marker"><div class="ob-phase__badge">{t(lang, 'onboarding.page.phase1Badge')}</div><div class="ob-phase__line"></div></div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">{t(lang, 'onboarding.page.phase1Title')}</h2>
          <p class="ob-phase__desc">{t(lang, 'onboarding.page.phase1Desc')}</p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase1Detail1Title')}</h3><p>{t(lang, 'onboarding.page.phase1Detail1Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase1Detail2Title')}</h3><p>{t(lang, 'onboarding.page.phase1Detail2Desc')}</p></div>
          </div>
        </div>
      </div>
      <div class="ob-phase">
        <div class="ob-phase__marker"><div class="ob-phase__badge">{t(lang, 'onboarding.page.phase2Badge')}</div><div class="ob-phase__line"></div></div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">{t(lang, 'onboarding.page.phase2Title')}</h2>
          <p class="ob-phase__desc">{t(lang, 'onboarding.page.phase2Desc')}</p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase2Detail1Title')}</h3><p>{t(lang, 'onboarding.page.phase2Detail1Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase2Detail2Title')}</h3><p>{t(lang, 'onboarding.page.phase2Detail2Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase2Detail3Title')}</h3><p>{t(lang, 'onboarding.page.phase2Detail3Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase2Detail4Title')}</h3><p>{t(lang, 'onboarding.page.phase2Detail4Desc')}</p></div>
          </div>
        </div>
      </div>
      <div class="ob-phase">
        <div class="ob-phase__marker"><div class="ob-phase__badge">{t(lang, 'onboarding.page.phase3Badge')}</div><div class="ob-phase__line"></div></div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">{t(lang, 'onboarding.page.phase3Title')}</h2>
          <p class="ob-phase__desc">{t(lang, 'onboarding.page.phase3Desc')}</p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase3Detail1Title')}</h3><p>{t(lang, 'onboarding.page.phase3Detail1Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase3Detail2Title')}</h3><p>{t(lang, 'onboarding.page.phase3Detail2Desc')}</p></div>
          </div>
        </div>
      </div>
      <div class="ob-phase">
        <div class="ob-phase__marker"><div class="ob-phase__badge ob-phase__badge--ongoing">{t(lang, 'onboarding.page.phase4Badge')}</div></div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">{t(lang, 'onboarding.page.phase4Title')}</h2>
          <p class="ob-phase__desc">{t(lang, 'onboarding.page.phase4Desc')}</p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase4Detail1Title')}</h3><p>{t(lang, 'onboarding.page.phase4Detail1Desc')}</p></div>
            <div class="ob-phase__detail"><h3>{t(lang, 'onboarding.page.phase4Detail2Title')}</h3><p>{t(lang, 'onboarding.page.phase4Detail2Desc')}</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="ob-cta section--dark">
    <div class="container">
      <div class="ob-cta__box">
        <h2 class="ob-cta__title">{t(lang, 'onboarding.page.ctaTitle')}</h2>
        <p class="ob-cta__desc">{t(lang, 'onboarding.page.ctaDesc')}</p>
        <div class="ob-cta__actions">
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--primary">{t(lang, 'onboarding.page.ctaBookDemo')}</a>
          <a href={`/${region}/pricing`} class="btn btn--outline">{t(lang, 'onboarding.page.ctaViewPricing')}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ob-hero { padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-2xl); text-align: center; }
  .ob-hero__eyebrow { font-family: var(--font-mono); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--reef-aqua); margin-bottom: var(--space-sm); }
  .ob-hero__title { font-family: var(--font-headline); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: var(--space-md); color: var(--warm-white); }
  .ob-hero__sub { max-width: 620px; margin: 0 auto; font-size: 1.125rem; line-height: 1.7; color: rgba(247, 244, 239, 0.65); }
  .ob-timeline { padding: var(--space-xl) 0 var(--space-2xl); }
  .ob-phase { display: flex; gap: var(--space-lg); margin-bottom: var(--space-xl); }
  .ob-phase:last-child { margin-bottom: 0; }
  .ob-phase__marker { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 80px; }
  .ob-phase__badge { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--reef-aqua); background: rgba(78, 216, 194, 0.08); border: 1px solid rgba(78, 216, 194, 0.2); border-radius: 100px; padding: 0.35em 0.85em; white-space: nowrap; }
  .ob-phase__badge--ongoing { background: rgba(106, 170, 207, 0.08); border-color: rgba(106, 170, 207, 0.2); color: var(--mist-blue); }
  .ob-phase__line { width: 1px; flex: 1; min-height: 40px; background: linear-gradient(180deg, rgba(78, 216, 194, 0.2), rgba(78, 216, 194, 0.03)); margin-top: var(--space-sm); }
  .ob-phase__body { flex: 1; padding-top: 0.15rem; }
  .ob-phase__title { font-family: var(--font-headline); font-size: 1.5rem; font-weight: 700; color: var(--warm-white); margin-bottom: var(--space-xs); }
  .ob-phase__desc { font-size: 1.0625rem; line-height: 1.65; color: rgba(247, 244, 239, 0.6); margin-bottom: var(--space-md); max-width: 600px; }
  .ob-phase__details { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  .ob-phase__detail { background: rgba(247, 244, 239, 0.025); border: 1px solid rgba(247, 244, 239, 0.05); border-radius: var(--radius-md, 8px); padding: var(--space-md); }
  .ob-phase__detail h3 { font-family: var(--font-headline); font-size: 0.9375rem; font-weight: 600; color: var(--warm-white); margin-bottom: 0.375rem; }
  .ob-phase__detail p { font-size: 0.875rem; line-height: 1.55; color: rgba(247, 244, 239, 0.5); }
  .ob-cta { padding: var(--space-xl) 0 var(--space-2xl); }
  .ob-cta__box { text-align: center; padding: var(--space-xl); background: rgba(78, 216, 194, 0.04); border: 1px solid rgba(78, 216, 194, 0.12); border-radius: var(--radius-lg, 16px); }
  .ob-cta__title { font-family: var(--font-headline); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--warm-white); margin-bottom: var(--space-xs); }
  .ob-cta__desc { font-size: 1.0625rem; color: rgba(247, 244, 239, 0.6); margin-bottom: var(--space-lg); }
  .ob-cta__actions { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; }
  .btn--outline { background: transparent; border: 1px solid rgba(247, 244, 239, 0.2); color: var(--warm-white); padding: 0.75em 1.5em; border-radius: var(--radius-md, 8px); font-family: var(--font-mono); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.04em; transition: all var(--duration-fast); cursor: pointer; }
  .btn--outline:hover { border-color: var(--reef-aqua); color: var(--reef-aqua); }
  @media (max-width: 768px) { .ob-phase { flex-direction: column; gap: var(--space-sm); } .ob-phase__marker { flex-direction: row; width: auto; gap: var(--space-sm); } .ob-phase__line { display: none; } .ob-phase__details { grid-template-columns: 1fr; } }
  :global(html[data-theme="light"]) .ob-hero__title, :global(html[data-theme="light"]) .ob-phase__title, :global(html[data-theme="light"]) .ob-cta__title, :global(html[data-theme="light"]) .ob-phase__detail h3 { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .ob-hero__sub, :global(html[data-theme="light"]) .ob-phase__desc, :global(html[data-theme="light"]) .ob-cta__desc { color: rgba(12, 14, 20, 0.65); }
  :global(html[data-theme="light"]) .ob-phase__detail { background: rgba(12, 14, 20, 0.02); border-color: rgba(12, 14, 20, 0.06); }
  :global(html[data-theme="light"]) .ob-phase__detail p { color: rgba(12, 14, 20, 0.55); }
  :global(html[data-theme="light"]) .ob-cta__box { background: rgba(78, 216, 194, 0.06); border-color: rgba(78, 216, 194, 0.15); }
  :global(html[data-theme="light"]) .btn--outline { border-color: rgba(12, 14, 20, 0.15); color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .btn--outline:hover { border-color: var(--reef-aqua); color: var(--reef-aqua); }
  @media (max-width: 480px) {
    .ob-hero { padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-lg); }
  }
</style>
