---
/**
 * DusaGuide: the floating glass guide (DUSA's face for its AI).
 * It rests bottom-left, waves hello, and when the visitor goes quiet it
 * floats to the most useful thing in view, points at it and says one short,
 * industry-aware line. Behaviour lives in /js/guide.v1.js. English pages only
 * until a locale's dictionary carries a `guide` block.
 *
 * Art: Higgsfield renders in media-src/guide (four poses, transparent).
 */
import { PERSONA_ICONS } from '../../config/industry-icons';
interface Props { t?: Record<string, any>; lang?: string; }
const { t = {}, lang = 'en' } = Astro.props;
const g = t?.guide || null;
const on = !!g || lang === 'en';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const quiet = /^\/(start|thank-you|terms|privacy-policy|onboarding|preview)(\/|$)/.test(path);
const BOOK_URL = 'https://link.dusa.studio/widget/bookings/dusa-demo';

const copy = {
  name: 'DUSA guide',
  open: 'Open the DUSA guide',
  close: 'Close',
  hide: 'Hide the guide',
  show: 'Show the DUSA guide',
  ai: 'AI guide',
  intro: "Hi, I'm your DUSA guide. Tell me what kind of business you run and I'll show you what DUSA does for it.",
  introKnown: "Welcome back. I've kept everything set up for your {biz}.",
  menu: 'How can I help?',
  aShow: 'Show me what it does for my business',
  aPlan: 'Find my plan',
  aBook: 'Book a 30-minute call',
  aPricing: 'See pricing',
  picked: {
    tradies: "For trades, a missed call is a missed job. DUSA's AI answers while you're on the tools, books the job in and chases the invoice.",
    salons: 'For salons, it comes down to full chairs. DUSA sends the reminders, prompts the rebooking and asks happy clients for a review.',
    clinics: "For clinics, no-shows hurt most. DUSA reminds patients, sends intake forms ahead and recalls them when they're due.",
    hospitality: 'For venues, the fastest reply wins the booking. DUSA answers every enquiry quickly and replies to every review.',
    'real-estate': 'For agencies, the first reply often wins the listing. DUSA answers every enquiry day or night and keeps contacts warm.',
    fitness: 'For gyms and studios, it is all about keeping members. DUSA follows up trials, nudges check-ins and invites lapsed members back.',
    other: 'Whatever you run, DUSA puts your leads, bookings, messages, reviews and payments in one place, with AI doing the follow-up.',
  },
  biz: { tradies: 'trade business', salons: 'salon', clinics: 'clinic', hospitality: 'venue', 'real-estate': 'agency', fitness: 'gym or studio', other: 'business', default: 'business' },
  tips: {
    platform: 'This wheel is everything your {biz} runs on, behind one login. Tap a slice to see what is inside.',
    funnel: 'Most owners pay for around eight tools that never talk to each other. Watch what one platform changes.',
    quiz: 'Not sure which plan fits? Five quick questions and I will match one to your {biz}.',
    proof: 'These are real reviews of HighLevel, the platform DUSA is built on. Tap any one to read the original.',
    steps: 'Getting started is three steps, and we set it up with you on a 30-minute call.',
    cta: 'Want to see it running for your {biz}? Book a 30-minute call and we will walk you through it.',
    pricing: 'The plans differ mostly by how much the AI does for you. Growth is where it starts answering your calls and chats.',
    services: 'Rather not do it yourself? These are the things our team can set up, run or build for your {biz}.',
  },
  ...(g || {}),
};
const data = JSON.stringify({ book: BOOK_URL, copy, icons: PERSONA_ICONS });
---

{on && !quiet && (
  <>
    <aside class="dzg" id="dz-guide" aria-label={copy.name} hidden>
      <div class="dzg__bubble" id="dzg-bubble" hidden>
        <button type="button" class="dzg__x" id="dzg-x" aria-label={copy.close}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <p class="dzg__tag"><img src="/media/guide/glass-lotus-sm.webp" width="16" height="16" alt="" />{copy.ai}</p>
        <p class="dzg__msg" id="dzg-msg" role="status" aria-live="polite"></p>
        <div class="dzg__actions" id="dzg-actions"></div>
        <button type="button" class="dzg__hide" id="dzg-hide" hidden>{copy.hide}</button>
      </div>
      <button type="button" class="dzg__bot" id="dzg-bot" aria-label={copy.open} aria-expanded="false" aria-controls="dzg-bubble">
        <span class="dzg__float">
          <img class="dzg__pose is-on" data-pose="idle" src="/media/guide/guide-idle.webp" width="200" height="200" alt="" decoding="async" />
          <img class="dzg__pose" data-pose="wave" data-src="/media/guide/guide-wave.webp" width="200" height="200" alt="" decoding="async" />
          <img class="dzg__pose" data-pose="point" data-src="/media/guide/guide-point.webp" width="200" height="200" alt="" decoding="async" />
          <img class="dzg__pose" data-pose="down" data-src="/media/guide/guide-down.webp" width="200" height="200" alt="" decoding="async" />
        </span>
      </button>
    </aside>
    <button type="button" class="dzg-launch" id="dzg-launch" aria-label={copy.show} title={copy.show} hidden>
      <img src="/media/guide/glass-lotus-sm.webp" width="34" height="34" alt="" />
    </button>
    <script type="application/json" id="dz-guide-data" set:html={data}></script>
    <script is:inline src="/js/guide.v1.js" defer></script>
  </>
)}

<style is:global>
  .dzg {
    position: fixed; left: 0; top: 0; z-index: 900;
    width: var(--dzg-size, 150px); height: var(--dzg-size, 150px);
    transform: translate3d(var(--dzg-x, 16px), var(--dzg-y, 100vh), 0);
    transition: transform 1.1s cubic-bezier(0.22, 0.9, 0.24, 1);
    pointer-events: none;
    will-change: transform;
  }
  .dzg[hidden], .dzg-launch[hidden], .dzg__bubble[hidden], .dzg__hide[hidden] { display: none !important; }
  .dzg.is-instant { transition: none; }
  .dzg__bot {
    position: absolute; inset: 0; padding: 0; border: 0; background: none; cursor: pointer;
    pointer-events: auto; border-radius: 40%;
    -webkit-tap-highlight-color: transparent;
  }
  .dzg__bot:focus-visible { outline: 2px solid var(--reef-aqua); outline-offset: 4px; }
  .dzg__float { position: absolute; inset: 0; display: block; animation: dzgBob 4.2s ease-in-out infinite; transform-origin: 50% 80%; }
  .dzg.is-flying .dzg__float { animation: dzgFly 1.1s ease-in-out; }
  .dzg__pose {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    opacity: 0; transition: opacity 0.28s ease;
    filter: drop-shadow(0 10px 18px rgba(8, 30, 44, 0.35));
    user-select: none; -webkit-user-drag: none;
  }
  .dzg__pose.is-on { opacity: 1; }
  .dzg[data-mirror="true"] .dzg__pose { transform: scaleX(-1); }
  .dzg__bot:hover .dzg__float { animation-duration: 2.2s; }
  @keyframes dzgBob { 0%, 100% { transform: translateY(0) rotate(-1.5deg); } 50% { transform: translateY(-9px) rotate(1.5deg); } }
  @keyframes dzgFly { 0% { transform: translateY(0) rotate(0); } 35% { transform: translateY(-14px) rotate(var(--dzg-lean, 8deg)); } 100% { transform: translateY(0) rotate(0); } }

  /* Speech bubble: bold glass card */
  .dzg__bubble {
    position: absolute; bottom: calc(100% - 6px); left: 22%;
    width: min(300px, calc(100vw - 28px));
    padding: 14px 16px 14px;
    border-radius: 20px 20px 20px 6px;
    color: var(--warm-white);
    background: linear-gradient(150deg, rgba(30, 44, 62, 0.9), rgba(12, 16, 24, 0.92));
    border: 1px solid rgba(247, 244, 239, 0.16);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
    pointer-events: auto;
    animation: dzgPop 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.2);
    transform-origin: 10% 100%;
  }
  .dzg[data-side="tr"] .dzg__bubble { left: auto; right: 22%; border-radius: 20px 20px 6px 20px; transform-origin: 90% 100%; }
  .dzg[data-side="bl"] .dzg__bubble { bottom: auto; top: calc(100% - 6px); border-radius: 6px 20px 20px 20px; transform-origin: 10% 0; }
  .dzg[data-side="br"] .dzg__bubble { bottom: auto; top: calc(100% - 6px); left: auto; right: 22%; border-radius: 20px 6px 20px 20px; transform-origin: 90% 0; }
  @keyframes dzgPop { from { opacity: 0; transform: scale(0.86) translateY(8px); } to { opacity: 1; transform: none; } }
  .dzg__tag { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--reef-aqua); max-width: none; }
  .dzg__msg { margin: 0; padding-right: 14px; font-size: 0.95rem; line-height: 1.45; max-width: none; color: inherit; }
  .dzg__x { position: absolute; top: 8px; right: 8px; width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgba(247, 244, 239, 0.08); color: inherit; cursor: pointer; }
  .dzg__x:hover { background: rgba(247, 244, 239, 0.16); }
  .dzg__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .dzg__actions:empty { display: none; }
  .dzg__act {
    display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 14px;
    border-radius: 999px; font-family: var(--font-headline); font-size: 0.86rem; font-weight: 500; cursor: pointer;
    color: var(--warm-white); background: rgba(247, 244, 239, 0.07); border: 1px solid rgba(247, 244, 239, 0.18);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .dzg__act:hover { border-color: rgba(78, 216, 194, 0.6); background: rgba(78, 216, 194, 0.12); }
  .dzg__act--primary { color: var(--deep-black); background: linear-gradient(135deg, var(--reef-aqua), var(--mist-blue)); border-color: transparent; }
  .dzg__act--primary:hover { color: var(--deep-black); filter: brightness(1.06); }
  .dzg__act svg { width: 15px; height: 15px; }
  .dzg__hide { margin-top: 10px; padding: 0; border: 0; background: none; cursor: pointer; font-size: 0.78rem; color: rgba(247, 244, 239, 0.6); text-decoration: underline; text-underline-offset: 3px; }
  .dzg__hide:hover { color: var(--warm-white); }

  html[data-theme="light"] .dzg__bubble {
    color: var(--deep-black);
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.92), rgba(247, 244, 239, 0.86));
    border-color: rgba(12, 14, 20, 0.1);
    box-shadow: 0 18px 50px rgba(26, 58, 92, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  html[data-theme="light"] .dzg__tag { color: var(--deep-ocean); }
  html[data-theme="light"] .dzg__x { background: rgba(12, 14, 20, 0.06); }
  html[data-theme="light"] .dzg__act { color: var(--deep-black); background: rgba(12, 14, 20, 0.04); border-color: rgba(12, 14, 20, 0.16); }
  html[data-theme="light"] .dzg__act--primary { color: var(--deep-black); background: linear-gradient(135deg, var(--reef-aqua), var(--mist-blue)); border-color: transparent; }
  html[data-theme="light"] .dzg__hide { color: rgba(12, 14, 20, 0.6); }

  /* What the guide is pointing at */
  .dzg-target { outline: 2px solid rgba(78, 216, 194, 0.85); outline-offset: 8px; border-radius: 18px; animation: dzgRing 1.6s ease-in-out 3; }
  @keyframes dzgRing { 0%, 100% { outline-color: rgba(78, 216, 194, 0.15); } 50% { outline-color: rgba(78, 216, 194, 0.95); } }

  /* Launcher left behind when the guide is hidden */
  .dzg-launch {
    position: fixed; left: 14px; bottom: 18px; z-index: 899; width: 48px; height: 48px; padding: 0;
    display: grid; place-items: center; cursor: pointer; border-radius: 50%;
    background: rgba(18, 26, 38, 0.7); border: 1px solid rgba(247, 244, 239, 0.16);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  html[data-theme="light"] .dzg-launch { background: rgba(255, 255, 255, 0.75); border-color: rgba(12, 14, 20, 0.1); }

  @media (max-width: 760px) {
    .dzg { --dzg-size: 92px; }
    .dzg__bubble { left: 10%; }
    .dzg-launch { bottom: 84px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dzg { transition: none; }
    .dzg__float, .dzg.is-flying .dzg__float { animation: none; }
    .dzg__bubble { animation: none; }
    .dzg-target { animation: none; }
  }
  @media print { .dzg, .dzg-launch { display: none !important; } }
</style>
