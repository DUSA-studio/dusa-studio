---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';

const title = 'CRM für Hausverwaltungen | DUSA.studio';
const description = 'Automatisieren Sie Mieterkommunikation, Wartungsanfragen, Mietvertragsverlängerungen und Mieteinzug. DUSA ist die All-in-One-Wachstumsplattform für Hausverwaltungen.';

const painPoints = [
  {
    icon: '📨',
    title: 'Verstreute Mieterkommunikation',
    desc: 'Nachrichten von Mietern verteilen sich auf E-Mail, Telefon, SMS und Portale. Nichts wird zentral erfasst, und so gehen Dinge unter.',
  },
  {
    icon: '🔧',
    title: 'Wartungsanfragen gehen in E-Mails verloren',
    desc: 'Reparaturanfragen kommen aus allen Richtungen, ohne System zum Priorisieren, Zuweisen oder Nachverfolgen. Mieter werden frustriert. Sie bekommen die Schuld.',
  },
  {
    icon: '📅',
    title: 'Manuelle Mietvertragsverlängerung',
    desc: 'Tabellen und Kalendererinnerungen sind keine Verlängerungsstrategie. Mietverträge laufen aus, Mieter ziehen aus, und Leerstände kosten Sie Tausende.',
  },
  {
    icon: '💸',
    title: 'Verspäteter Mieteinzug',
    desc: 'Jeden Monat manuell der Miete hinterherzulaufen kostet Zeit und sorgt für unangenehme Gespräche. Automatische Erinnerungen lösen beide Probleme.',
  },
];

const features = [
  {
    title: 'Mieter-Lifecycle-Automatisierung',
    desc: 'Von der Anfrage über den Einzug bis zur Verlängerung. Jede Phase wird abgebildet und automatisiert. Kein Mieter geht verloren.',
  },
  {
    title: 'Wartungsanfragen-Pipeline',
    desc: 'Mieter reichen Anfragen über ein Formular ein. Sie priorisieren, weisen zu und verfolgen die Lösung über ein zentrales Dashboard.',
  },
  {
    title: 'Mieterinnerungs-Sequenzen',
    desc: 'Automatische SMS- und E-Mail-Erinnerungen werden vor Fälligkeit, am Fälligkeitstag und bei verspäteter Zahlung versendet.',
  },
  {
    title: 'Mietvertragsverlängerungs-Kampagnen',
    desc: 'Starten Sie die Verlängerungsansprache 90 Tage vor Ablauf eines Mietvertrags. Automatisieren Sie Nachfassaktionen, bis der Mieter bestätigt.',
  },
  {
    title: 'Eigentümerberichte',
    desc: 'Erstellen Sie monatliche Eigentümerberichte mit Belegungsquoten, Wartungsupdates und Mieteinzugsübersichten.',
  },
];

const pipeline = [
  { stage: 'Anfrage', desc: 'Neuer Mieter füllt ein Interessenformular aus' },
  { stage: 'Bewerbung', desc: 'Hintergrund- und Bonitätsprüfung läuft' },
  { stage: 'Vertrag unterzeichnet', desc: 'Mietvertrag abgeschlossen, Einzug geplant' },
  { stage: 'Aktiver Mieter', desc: 'Laufende Kommunikation und Wartung' },
  { stage: 'Verlängerung fällig', desc: 'Automatische Ansprache beginnt bei 90 Tagen' },
  { stage: 'Verlängert', desc: 'Mietvertrag verlängert, Zyklus läuft weiter' },
];

const stats = [
  { value: '73%', label: 'der Mieter bevorzugen digitale Kommunikation gegenüber Telefonaten' },
  { value: '2.5x', label: 'schnellere Wartungslösung mit automatisierter Triage' },
  { value: '40%', label: 'weniger verspätete Mietzahlungen durch automatische Erinnerungen' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://dusa.studio/de/' },
    { '@type': 'ListItem', position: 2, name: 'Branchen', item: 'https://dusa.studio/de/industries' },
    { '@type': 'ListItem', position: 3, name: 'Hausverwaltungen', item: 'https://dusa.studio/de/industries/property-managers' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="pm-hero section section--dark">
    <div class="container">
      <div class="pm-hero__content">
        <span class="label">Hausverwaltung</span>
        <h1>Die <span class="gradient-text">Wachstumsplattform</span> für Hausverwaltungen</h1>
        <p class="pm-hero__sub">
          Automatisieren Sie Mieterkommunikation, Wartungsabläufe, Mietvertragsverlängerungen und Mieteinzug. Alles auf einer Plattform.
        </p>
        <div class="pm-hero__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pm-pain section section--dark">
    <div class="container">
      <div class="pm-pain__header">
        <span class="label">Das Problem</span>
        <h2>Hausverwaltung <span class="gradient-text">ertrinkt in Verwaltungsaufgaben</span></h2>
        <p class="pm-pain__intro">Die meisten Hausverwaltungen kämpfen mit unzusammenhängenden Tools und manuellen Prozessen. So sieht das aus.</p>
      </div>
      <div class="pm-pain__grid">
        {painPoints.map((point) => (
          <div class="pm-pain__card">
            <span class="pm-pain__icon">{point.icon}</span>
            <h3 class="pm-pain__card-title">{point.title}</h3>
            <p class="pm-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="pm-solution section section--dark">
    <div class="container">
      <div class="pm-solution__header">
        <span class="label">Die Lösung</span>
        <h2>So funktioniert DUSA für <span class="gradient-text">Hausverwaltungen</span></h2>
        <p class="pm-solution__intro">Eine Plattform für jede Mieterinteraktion, von der ersten Anfrage bis zur Mietvertragsverlängerung.</p>
      </div>
      <div class="pm-solution__grid">
        {features.map((feature) => (
          <div class="pm-solution__card">
            <h3 class="pm-solution__card-title">{feature.title}</h3>
            <p class="pm-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pm-pipeline section section--dark">
    <div class="container">
      <div class="pm-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Ihre <span class="gradient-text">Mieter-Pipeline</span> auf einen Blick</h2>
      </div>
      <div class="pm-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="pm-pipeline__stage">
            <div class="pm-pipeline__number">{i + 1}</div>
            <h3 class="pm-pipeline__stage-title">{step.stage}</h3>
            <p class="pm-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="pm-stats section section--dark">
    <div class="container">
      <div class="pm-stats__header">
        <span class="label">Wirkung</span>
        <h2>Die Zahlen sprechen <span class="gradient-text">für sich</span></h2>
      </div>
      <div class="pm-stats__grid">
        {stats.map((stat) => (
          <div class="pm-stats__card">
            <span class="pm-stats__value">{stat.value}</span>
            <p class="pm-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pm-cta section section--dark">
    <div class="container">
      <div class="pm-cta__box">
        <h2>Bereit, Ihre <span class="gradient-text">Hausverwaltung</span> zu optimieren?</h2>
        <p class="pm-cta__sub">Bringen Sie Mieter-Pipeline, Wartungsabläufe und Verlängerungskampagnen auf einer Plattform zum Laufen.</p>
        <div class="pm-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/crm-for-property-managers" class="btn btn--outline">Leitfaden lesen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .pm-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .pm-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .pm-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .pm-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pm-pain {
    padding: var(--space-2xl) 0;
  }
  .pm-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .pm-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .pm-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .pm-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .pm-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .pm-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .pm-solution {
    padding: var(--space-2xl) 0;
  }
  .pm-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .pm-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .pm-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .pm-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .pm-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .pm-pipeline {
    padding: var(--space-2xl) 0;
  }
  .pm-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .pm-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .pm-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .pm-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .pm-stats {
    padding: var(--space-2xl) 0;
  }
  .pm-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .pm-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .pm-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .pm-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .pm-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .pm-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .pm-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .pm-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .pm-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .pm-hero__content h1,
  :global(html[data-theme="light"]) .pm-pain__header h2,
  :global(html[data-theme="light"]) .pm-solution__header h2,
  :global(html[data-theme="light"]) .pm-pipeline__header h2,
  :global(html[data-theme="light"]) .pm-stats__header h2,
  :global(html[data-theme="light"]) .pm-cta__box h2,
  :global(html[data-theme="light"]) .pm-pain__card-title,
  :global(html[data-theme="light"]) .pm-solution__card-title,
  :global(html[data-theme="light"]) .pm-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .pm-hero__sub,
  :global(html[data-theme="light"]) .pm-pain__intro,
  :global(html[data-theme="light"]) .pm-solution__intro,
  :global(html[data-theme="light"]) .pm-pain__card-desc,
  :global(html[data-theme="light"]) .pm-solution__card-desc,
  :global(html[data-theme="light"]) .pm-pipeline__stage-desc,
  :global(html[data-theme="light"]) .pm-stats__label,
  :global(html[data-theme="light"]) .pm-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .pm-pain__card,
  :global(html[data-theme="light"]) .pm-solution__card,
  :global(html[data-theme="light"]) .pm-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .pm-pain__card:hover,
  :global(html[data-theme="light"]) .pm-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .pm-stats__card,
  :global(html[data-theme="light"]) .pm-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .pm-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .pm-stats__value {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .pm-cta__actions .btn--outline {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pm-pain__grid {
      grid-template-columns: 1fr;
    }
    .pm-solution__grid {
      grid-template-columns: 1fr;
    }
    .pm-stats__grid {
      grid-template-columns: 1fr;
    }
    .pm-pipeline__stages {
      flex-direction: column;
    }
    .pm-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .pm-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
