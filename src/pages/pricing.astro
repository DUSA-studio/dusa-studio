---
/**
 * /pricing (Australia, AUD). Thin wrapper over the shared PricingContent so the
 * English page and the 13 regional pages are one source of truth. The English
 * dictionary carries no pricing.data block, so the English arrays inside the
 * component render as written.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingContent from '../components/PricingContent.astro';
import { getRegion, getRegionPrices } from '../i18n/regions.js';
import t from '../i18n/translations/en.json';

const region = getRegion('au');
const prices = getRegionPrices('au');
---
<BaseLayout
  title="Pricing | DUSA . studio - Plans from $149/mo AUD"
  description="Simple, transparent pricing. The whole platform from $149/mo AUD with unlimited users and contacts. CRM, email, SMS, funnels, booking and reputation in one place, with Ask AI on every plan and your AI Employee on Growth."
  t={t}
>
  <PricingContent region={region} t={t} prices={prices} regionKey="au" />
</BaseLayout>
