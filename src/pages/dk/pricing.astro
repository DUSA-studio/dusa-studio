---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingContent from '../../components/PricingContent.astro';
import { getRegion, convertPrice } from '../../i18n/regions.js';
import t from '../../i18n/translations/da.json';

const region = getRegion('dk');
const prices = {
  launchpad: convertPrice(47, 'dk'),
  starter: convertPrice(149, 'dk'),
  growth: convertPrice(297, 'dk'),
};
---
<BaseLayout
  title={t.pricing.metaTitle}
  description={t.pricing.metaDescription}
  lang={region.htmlLang}
  ogLocale={region.ogLocale}
  t={t}
>
  <PricingContent region={region} t={t} prices={prices} regionKey="dk" />
</BaseLayout>
