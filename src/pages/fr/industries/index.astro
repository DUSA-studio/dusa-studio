---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { INDUSTRY_ICONS } from '../../../config/industry-icons';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';

const industries = [
  {
    title: 'Immobilier',
    desc: 'Gestion de pipeline, suivis automatiques apres les visites et matching acheteurs pour les agents qui veulent conclure plus de ventes.',
    slug: '/fr/industries/real-estate',
  },
  {
    title: 'Salles de sport et fitness',
    desc: 'Accueil des membres, rappels de cours, campagnes de reconquete et suivi des parrainages pour reduire le taux de desabonnement et remplir vos cours.',
    slug: '/fr/industries/gyms',
  },
  {
    title: 'Artisans et metiers du batiment',
    desc: 'Rappel automatique des appels manques, pipelines de devis, planification des interventions et relances de factures pour les artisans toujours sur le terrain.',
    slug: '/fr/industries/tradies',
  },
  {
    title: 'Restaurants',
    desc: 'Rappels de reservation, demandes d\'avis apres la visite, campagnes anniversaires et programmes de fidelite numeriques.',
    slug: '/fr/industries/restaurants',
  },
  {
    title: 'Salons de coiffure et spas',
    desc: 'Reservation en ligne, rappels automatiques, campagnes de reprise de rendez-vous et suivi des preferences clients pour remplir chaque poste.',
    slug: '/fr/industries/salons',
  },
  {
    title: 'Cabinets comptables',
    desc: 'Automatisation de la collecte de documents, rappels d\'echeances et engagement client tout au long de l\'annee, au-dela de la periode fiscale.',
    slug: '/fr/industries/accountants',
  },
  {
    title: 'Cabinets dentaires',
    desc: 'Rappels de bilan, acquisition de nouveaux patients, generation d\'avis et suivis de plans de traitement en pilote automatique.',
    slug: '/fr/industries/dentists',
  },
  {
    title: 'Photographes',
    desc: 'Reponses automatiques aux demandes, workflows de contrats, rappels de seances, livraison de galeries et sequences de vente additionnelle de tirages.',
    slug: '/fr/industries/photographers',
  },
  {
    title: 'Construction et BTP',
    desc: 'Suivi des prospects, relances de devis, communication sur les jalons de projet et encaissement des paiements pour les constructeurs.',
    slug: '/fr/industries/construction',
  },
  {
    title: 'Coachs sportifs',
    desc: 'Tunnels de vente avec lead magnets, prise de rendez-vous de consultation, vitrines de transformations et bilans clients automatises.',
    slug: '/fr/industries/personal-trainers',
  },
  {
    title: 'Services de nettoyage',
    desc: 'Gestion des reservations recurrentes, suivis qualite, planification des equipes et campagnes de vente additionnelle pour les entreprises de nettoyage.',
    slug: '/fr/industries/cleaning-services',
  },
  {
    title: 'Cabinets d\'avocats',
    desc: 'Automatisation des formulaires d\'accueil, mises a jour sur l\'etat des dossiers, suivi des recommandations et contenu de reference dans le respect de la conformite.',
    slug: '/fr/industries/law-firms',
  },
  {
    title: 'Gestionnaires immobiliers',
    desc: 'Automatisation du cycle de vie des locataires, pipelines de demandes de maintenance, rappels de loyer et campagnes de renouvellement de bail.',
    slug: '/fr/industries/property-managers',
  },
  {
    title: 'Garages automobiles',
    desc: 'Automatisation des rappels d\'entretien, campagnes saisonnieres, generation d\'avis et programmes de fidelite pour les mecaniciens.',
    slug: '/fr/industries/auto-repair',
  },
  {
    title: 'Coachs et consultants',
    desc: 'Tunnels d\'appels decouverte, sequences d\'onboarding, planification de seances et collecte de temoignages pour developper votre activite.',
    slug: '/fr/industries/coaches',
  },
  {
    title: 'E-commerce',
    desc: 'Sequences post-achat, automatisation des avis, parcours de ventes croisees, segmentation VIP et recompenses anniversaires.',
    slug: '/fr/industries/ecommerce',
  },
];
---

<BaseLayout
  t={tData}
  title="Secteurs d'activite | DUSA.studio"
  description="DUSA est concu pour votre secteur. Decouvrez comment notre plateforme de croissance fonctionne pour l'immobilier, les artisans, les salles de sport, les restaurants, les salons, les dentistes et bien plus."
>
  <!-- Hero -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Secteurs d'activite</span>
        <h1>Concu pour <span class="gradient-text">votre</span> secteur</h1>
        <p class="ind-hero__sub">
          Chaque entreprise est differente. C'est pourquoi DUSA s'adapte a votre facon de travailler, avec des pipelines, des automatisations et des workflows concus pour votre secteur. Trouvez le votre ci-dessous.
        </p>
      </div>
    </div>
  </section>

  <!-- Industry Grid -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={INDUSTRY_ICONS[ind.slug.split('/').pop()]} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">En savoir plus &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Votre secteur n'apparait pas ?</h2>
        <p class="ind-cta__desc">DUSA fonctionne pour toute entreprise de services. Contactez-nous et nous vous montrerons comment il s'adapte a votre workflow.</p>
        <div class="ind-cta__buttons">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/fr/contact" class="btn btn--outline">Contactez-nous</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://dusa.studio/fr/" },
    { "@type": "ListItem", "position": 2, "name": "Secteurs d'activite", "item": "https://dusa.studio/fr/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
