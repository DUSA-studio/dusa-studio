---
/**
 * WeekWithDusa.astro
 *
 * The home page centrepiece: one customer's week, told as seven glass
 * notification cards that light up in sequence as the section scrolls into
 * view. Pure outcomes, no feature names. Replaces the glass funnel.
 *
 * Mechanics: transform/opacity only, an IntersectionObserver toggles `is-live`
 * (so it replays on re-entry), a progress rail fills behind the cards, and
 * the whole thing degrades to a static list under prefers-reduced-motion.
 */
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.week || {};

const eyebrow = s.eyebrow || 'A week with DUSA';
const heading = s.heading || 'You do the work.';
const headingAccent = s.headingAccent || 'DUSA does the chasing.';
const sub = s.sub || 'One customer, start to finish. Every line here happens without you touching a thing.';
const verdict = s.verdict || 'That is one customer. DUSA does it for every one of them, from one login.';
const ctaLabel = s.cta || 'See it on your business';
const ctaDemo = s.ctaDemo || 'Book a free demo';

type Beat = { when: string; title: string; text: string; icon: string; tone?: 'you' | 'dusa' | 'customer' };
const beats: Beat[] = s.beats || [
  { when: 'Monday 9:02pm', title: 'A new customer calls. You miss it.', text: 'Eight seconds later DUSA texts them back from your number and asks what they need.', icon: 'phone', tone: 'dusa' },
  { when: 'Monday 9:04pm', title: 'They reply by text.', text: 'The AI answers their questions, offers Thursday at 10, and books it straight into your calendar.', icon: 'chat', tone: 'dusa' },
  { when: 'Wednesday 4:00pm', title: 'Reminder sent.', text: 'They get a text the day before with the address and a way to reschedule. No-shows stop.', icon: 'bell', tone: 'dusa' },
  { when: 'Thursday 11:30am', title: 'Job done. Invoice sent from your phone.', text: 'One tap. Paid by card before you have packed the van.', icon: 'card', tone: 'you' },
  { when: 'Thursday 6:00pm', title: 'Review request goes out.', text: 'Two hours later a five-star review lands on Google, and DUSA replies to it for you.', icon: 'star', tone: 'customer' },
  { when: 'Friday 8:00am', title: 'The next customer finds you.', text: 'That review moved you up the map. A new enquiry comes in before your first coffee.', icon: 'map', tone: 'customer' },
  { when: 'Next month', title: 'They come back.', text: 'A text about your winter special. They book again. No ad spend, no chasing.', icon: 'repeat', tone: 'dusa' },
];

const ICONS: Record<string, string> = {
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z',
  chat: 'M21 12a8 8 0 01-8 8H8l-5 3 1.5-4.5A8 8 0 1121 12zM8 11h.01M12 11h.01M16 11h.01',
  bell: 'M6 16V11a6 6 0 1112 0v5l2 2H4l2-2zM10 21a2 2 0 004 0',
  card: 'M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2zM3 10h18M7 15h4',
  star: 'M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z',
  map: 'M12 21s-6-5.3-6-10a6 6 0 1112 0c0 4.7-6 10-6 10zM12 13a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  repeat: 'M17 2l4 4-4 4M3 11V9a4 4 0 014-4h14M7 22l-4-4 4-4M21 13v2a4 4 0 01-4 4H3',
};

/* Line-art scenes, one per beat, drawn in the empty column beside the card.
   Stroke only, 1.6px, in the brand palette: warm white for the world, reef
   aqua for what DUSA does, mist blue for the customer. Each scene draws on
   once (class "d", ordered by --o) and then loops a six-second mini story
   (classes below, all transform/opacity). Words inside the scenes come from
   `week.scene` in the dictionary so they translate with the rest. */
const L = Object.assign({
  calling: 'New client calling', missed: 'Missed', smsA: 'Sorry we missed you,', smsB: 'how can we help?', later: '8 sec later',
  askA: 'Can you do', askB: 'Thursday?', replyA: 'Thursday 10am', replyB: 'is yours. Booked!', thu: 'Thu 10am',
  toast: 'Tomorrow, 10am', bell: 'Reminder',
  invoice: 'Invoice', amount: '$480', tap: 'Tap to pay', paid: 'Paid',
  replied: 'DUSA replied',
  enquiry: 'New enquiry', rank: 'Higher on the map',
  next: 'Next month', again: 'Booked again',
}, s.scene || {});
const SVG = (inner: string) => `<svg viewBox="0 0 200 130" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
const SCENES: Record<string, string> = {
  phone: SVG(`
    <g class="ph">
      <rect class="d" style="--o:0" x="22" y="10" width="56" height="110" rx="10"/>
      <path class="d" style="--o:0" d="M42 17h16"/>
      <g class="call">
        <circle class="d a" style="--o:1" cx="50" cy="44" r="11"/>
        <path class="d a" style="--o:1" d="M50 39.5a3.6 3.6 0 1 1 0 7.2a3.6 3.6 0 0 1 0-7.2M43.5 52a8.5 8.5 0 0 1 13 0"/>
        <text class="t" x="50" y="66" text-anchor="middle">${L.calling.split(' ').slice(0, -1).join(' ')}</text>
        <text class="t" x="50" y="77" text-anchor="middle">${L.calling.split(' ').slice(-1)[0]}</text>
        <circle class="d a" style="--o:2" cx="50" cy="100" r="9"/>
        <path class="d a" style="--o:2" d="M46.5 97.5h2l1 2.5-1.2.8a5 5 0 0 0 2.4 2.4l.8-1.2 2.5 1v2a1 1 0 0 1-1 1a7.5 7.5 0 0 1-7.5-7.5a1 1 0 0 1 1-1z"/>
      </g>
      <g class="missed">
        <text class="t tb" x="50" y="72" text-anchor="middle">${L.missed}</text>
        <path class="b" d="M44 94l12 12M56 94l-12 12"/>
      </g>
    </g>
    <path class="rg a" d="M90 44a18 18 0 0 1 0 28"/>
    <path class="rg rg--2 a" d="M100 36a30 30 0 0 1 0 44"/>
    <g class="sms">
      <path class="a" d="M100 70h82a8 8 0 0 1 8 8v22a8 8 0 0 1-8 8h-58l-12 10v-10h-12a8 8 0 0 1-8-8V78a8 8 0 0 1 8-8z"/>
      <text class="t ta" x="110" y="85">${L.smsA}</text>
      <text class="t ta" x="110" y="97">${L.smsB}</text>
      <text class="t tm" x="190" y="124" text-anchor="end">${L.later}</text>
    </g>`),
  chat: SVG(`
    <g class="bub bub--c">
      <path class="d b" style="--o:0" d="M14 14h84a7 7 0 0 1 7 7v18a7 7 0 0 1-7 7H36l-10 8v-8h-5a7 7 0 0 1-7-7V21a7 7 0 0 1 7-7z"/>
      <text class="t tb" x="24" y="28">${L.askA}</text>
      <text class="t tb" x="24" y="40">${L.askB}</text>
    </g>
    <g class="bub bub--d">
      <path class="d a" style="--o:1" d="M100 56h84a7 7 0 0 1 7 7v18a7 7 0 0 1-7 7h-5v8l-10-8h-69a7 7 0 0 1-7-7V63a7 7 0 0 1 7-7z"/>
      <g class="dots"><circle class="dt" cx="132" cy="72" r="2.4"/><circle class="dt dt--2" cx="142" cy="72" r="2.4"/><circle class="dt dt--3" cx="152" cy="72" r="2.4"/></g>
      <g class="reply"><text class="t ta" x="110" y="70">${L.replyA}</text><text class="t ta" x="110" y="82">${L.replyB}</text></g>
    </g>
    <g class="cal">
      <rect class="d" style="--o:2" x="28" y="76" width="56" height="42" rx="6"/>
      <path class="d" style="--o:2" d="M28 88h56M40 72v8M72 72v8"/>
      <text class="t tm" x="56" y="100" text-anchor="middle">${L.thu}</text>
      <path class="tick a" d="M49 109l5 5 11-11"/>
    </g>`),
  bell: SVG(`
    <rect class="d" style="--o:0" x="60" y="8" width="80" height="114" rx="10"/>
    <path class="d" style="--o:0" d="M90 15h20"/>
    <g class="toast">
      <rect class="a" x="66" y="24" width="68" height="38" rx="6"/>
      <path class="a" d="M78 31a4 4 0 0 1 4 4v4l1.5 1.5h-11L74 39v-4a4 4 0 0 1 4-4zM76.5 42a1.5 1.5 0 0 0 3 0"/>
      <text class="t tm" x="88" y="39">${L.bell}</text>
      <text class="t ts" x="72" y="55">${L.toast}</text>
    </g>
    <g class="swing"><path class="d" style="--o:1" d="M100 74a10 10 0 0 1 10 10v10l4 4H86l4-4V84a10 10 0 0 1 10-10zM96 100a4 4 0 0 0 8 0"/></g>
    <path class="rg a" d="M126 80a16 16 0 0 1 0 22"/>
    <path class="rg rg--2 a" d="M74 80a16 16 0 0 0 0 22"/>`),
  card: SVG(`
    <g class="inv">
      <path class="d" style="--o:0" d="M20 14h56l16 16v86H20z"/>
      <path class="d" style="--o:0" d="M76 14v16h16"/>
      <path class="d" style="--o:1" d="M32 46h44M32 58h44M32 70h28"/>
      <text class="t tm" x="32" y="92">${L.invoice}</text>
      <text class="t" x="32" y="106">${L.amount}</text>
    </g>
    <g class="term">
      <rect class="d" style="--o:2" x="110" y="46" width="72" height="46" rx="7"/>
      <path class="d" style="--o:2" d="M110 60h72"/>
      <text class="t tm" x="146" y="80" text-anchor="middle">${L.tap}</text>
    </g>
    <g class="swipe">
      <rect class="a" x="124" y="18" width="44" height="26" rx="4"/><path class="a" d="M124 26h44M130 38h10"/>
    </g>
    <g class="paid">
      <circle class="a" cx="128" cy="110" r="10"/><path class="a tick" d="M122.5 110l4 4 8-8"/>
      <text class="t ta" x="144" y="114">${L.paid}</text>
    </g>`),
  star: SVG(`
    <rect class="d" style="--o:0" x="16" y="14" width="168" height="102" rx="10"/>
    <circle class="d b" style="--o:1" cx="36" cy="36" r="9"/>
    <path class="d b" style="--o:1" d="M36 32.5a2.8 2.8 0 1 1 0 5.6a2.8 2.8 0 0 1 0-5.6M31 42a6.5 6.5 0 0 1 10 0"/>
    <path class="d" style="--o:1" d="M52 32h52M52 41h34"/>
    <g class="stars">
      <path class="st" d="M36 56l3 6 6.5 1-4.7 4.4 1.1 6.4L36 70.8l-5.9 3 1.1-6.4-4.7-4.4 6.5-1z"/>
      <path class="st" d="M62 56l3 6 6.5 1-4.7 4.4 1.1 6.4L62 70.8l-5.9 3 1.1-6.4-4.7-4.4 6.5-1z"/>
      <path class="st" d="M88 56l3 6 6.5 1-4.7 4.4 1.1 6.4L88 70.8l-5.9 3 1.1-6.4-4.7-4.4 6.5-1z"/>
      <path class="st" d="M114 56l3 6 6.5 1-4.7 4.4 1.1 6.4L114 70.8l-5.9 3 1.1-6.4-4.7-4.4 6.5-1z"/>
      <path class="st" d="M140 56l3 6 6.5 1-4.7 4.4 1.1 6.4L140 70.8l-5.9 3 1.1-6.4-4.7-4.4 6.5-1z"/>
    </g>
    <path class="d" style="--o:2" d="M28 86h110M28 95h70"/>
    <g class="rep">
      <rect class="a" x="100" y="100" width="72" height="14" rx="7"/>
      <text class="t ta" x="136" y="110" text-anchor="middle">${L.replied}</text>
    </g>`),
  map: SVG(`
    <path class="d" style="--o:0" d="M10 118l44-16 46 16 44-16M22 30c26 10 40 38 34 64M86 18c30 8 52 30 58 60"/>
    <g class="drop">
      <path class="d a" style="--o:1" d="M80 86s-20-18-20-34a20 20 0 0 1 40 0c0 16-20 34-20 34z"/>
      <circle class="d a" style="--o:1" cx="80" cy="52" r="7"/>
    </g>
    <ellipse class="ripple a" cx="80" cy="88" rx="10" ry="4"/>
    <ellipse class="ripple ripple--2 a" cx="80" cy="88" rx="20" ry="8"/>
    <g class="rank">
      <path class="d" style="--o:2" d="M136 76l16-14 10 8 18-20"/>
      <path class="d" style="--o:3" d="M172 50h8v8"/>
      <text class="t tm" x="180" y="88" text-anchor="end">${L.rank}</text>
    </g>
    <g class="lead">
      <rect class="a" x="108" y="100" width="80" height="16" rx="8"/>
      <text class="t ta" x="148" y="111" text-anchor="middle">${L.enquiry}</text>
    </g>`),
  repeat: SVG(`
    <g class="orbit">
      <path class="d a" style="--o:0" d="M150 65a50 50 0 0 1-86 35M50 65a50 50 0 0 1 86-35"/>
      <path class="d a" style="--o:1" d="M128 24l12 8-8 12M72 106l-12-8 8-12"/>
    </g>
    <rect class="d" style="--o:2" x="72" y="44" width="56" height="42" rx="6"/>
    <path class="d" style="--o:2" d="M72 56h56M84 40v8M116 40v8"/>
    <text class="t tm" x="100" y="68" text-anchor="middle">${L.next}</text>
    <path class="tick a" d="M93 78l5 5 11-11"/>
    <g class="again">
      <rect class="a" x="60" y="112" width="80" height="16" rx="8"/>
      <text class="t ta" x="100" y="123" text-anchor="middle">${L.again}</text>
    </g>`),
};
const toneLabel: Record<string, string> = { you: s.toneYou || 'You', dusa: s.toneDusa || 'DUSA', customer: s.toneCustomer || 'Customer' };
---

<section class="week section section--dark" id="week" data-week>
  <div class="container">
    <div class="week__header">
      <span class="label">{eyebrow}</span>
      <h2>{heading}<br/><span class="gradient-text">{headingAccent}</span></h2>
      <p class="week__sub">{sub}</p>
    </div>

    <ol class="week__list" aria-label={eyebrow}>
      <span class="week__rail" aria-hidden="true"><span class="week__rail-fill"></span></span>
      {beats.map((b, i) => (
        <li class={`week__beat week__beat--${b.tone || 'dusa'}`} style={`--i:${i}`}>
          <span class="week__dot" aria-hidden="true"></span>
          <div class="week__scene" aria-hidden="true" set:html={SCENES[b.icon] || SCENES.chat} />
          <div class="week__card">
            <div class="week__card-top">
              <span class="week__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[b.icon] || ICONS.chat} /></svg>
              </span>
              <span class="week__when">{b.when}</span>
              <span class="week__who">{toneLabel[b.tone || 'dusa']}</span>
            </div>
            <p class="week__title">{b.title}</p>
            <p class="week__text">{b.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="week__verdict">
      <p class="week__verdict-text">{verdict}</p>
      <div class="week__ctas">
        <a href="/industries" data-page="industries" class="btn btn--primary">{ctaLabel}</a>
        <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">{ctaDemo}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .week { position: relative; overflow: hidden; }
  .week__header { text-align: center; max-width: 640px; margin: 0 auto var(--space-2xl); }
  .week__header h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .week__sub { font-size: 1.125rem; color: rgba(247, 244, 239, 0.66); line-height: 1.7; margin: var(--space-sm) auto 0; }

  /* ── The timeline ── */
  .week__list {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0.5rem 0;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .week__rail {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: rgba(247, 244, 239, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .week__rail-fill {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, var(--reef-aqua), var(--mist-blue));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 5s linear;
  }
  .week[data-live] .week__rail-fill { transform: scaleY(1); }

  .week__beat {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    column-gap: 3rem;
  }
  .week__beat:nth-child(odd) .week__card { grid-column: 1; grid-row: 1; }
  .week__beat:nth-child(even) .week__card { grid-column: 2; grid-row: 1; }
  .week__beat:nth-child(odd) .week__scene { grid-column: 2; grid-row: 1; justify-self: start; }
  .week__beat:nth-child(even) .week__scene { grid-column: 1; grid-row: 1; justify-self: end; }

  /* ── Line-art scene ──
     The SVG is injected with set:html, so its parts are reached with :global.
     --sa is DUSA's accent (reef aqua in the dark, deep ocean in the light),
     --sb is the customer's (mist blue), the base stroke is the world. Every
     loop runs on one shared six-second clock (--cycle) starting once the
     scene has drawn on, so each scene tells its story and repeats. */
  .week__scene {
    --sa: var(--reef-aqua);
    --sb: var(--mist-blue);
    --cycle: 6s;
    --start: calc(var(--i) * 0.6s + 1.7s);
    width: 240px; max-width: 100%;
    color: rgba(247, 244, 239, 0.72);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 0.6s + 0.5s);
  }
  .week[data-live] .week__scene { opacity: 1; transform: none; }
  .week__scene :global(svg) { width: 100%; height: auto; display: block; overflow: visible; }
  .week__scene :global(.a) { stroke: var(--sa); }
  .week__scene :global(.b) { stroke: var(--sb); }
  .week__scene :global(.t) { font-family: var(--font-body); font-size: 8.5px; font-weight: 600; fill: currentColor; stroke: none; letter-spacing: 0.01em; }
  .week__scene :global(.ta) { fill: var(--sa); }
  .week__scene :global(.tb) { fill: var(--sb); }
  .week__scene :global(.ts) { font-size: 7.6px; }
  .week__scene :global(.tm) { font-size: 7px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.75; }

  /* draw-on: every .d path reveals in order (--o), after its card lands */
  .week__scene :global(.d) { stroke-dasharray: 340; stroke-dashoffset: 340; }
  .week[data-live] .week__scene :global(.d) {
    animation: weekDraw 0.9s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 0.6s + 0.6s + var(--o, 0) * 0.26s);
  }
  @keyframes weekDraw { to { stroke-dashoffset: 0; } }

  /* Loop parts start hidden or at rest and only move once the section is live. */
  .week__scene :global(.rg), .week__scene :global(.ripple), .week__scene :global(.tick),
  .week__scene :global(.missed), .week__scene :global(.sms), .week__scene :global(.reply),
  .week__scene :global(.paid), .week__scene :global(.rep), .week__scene :global(.lead),
  .week__scene :global(.again), .week__scene :global(.toast), .week__scene :global(.swipe) { opacity: 0; }
  .week__scene :global(.tick) { stroke-dasharray: 40; stroke-dashoffset: 40; }
  .week__scene :global(.st) { fill: transparent; stroke: currentColor; transform-origin: center; transform-box: fill-box; }
  .week__scene :global(.dt) { fill: var(--sa); stroke: none; opacity: 0.35; }

  /* Shared loop timing */
  .week[data-live] .week__scene :global(.loop),
  .week[data-live] .week__scene :global(.ph), .week[data-live] .week__scene :global(.rg),
  .week[data-live] .week__scene :global(.call), .week[data-live] .week__scene :global(.missed),
  .week[data-live] .week__scene :global(.sms), .week[data-live] .week__scene :global(.dots),
  .week[data-live] .week__scene :global(.dt), .week[data-live] .week__scene :global(.reply),
  .week[data-live] .week__scene :global(.tick), .week[data-live] .week__scene :global(.toast),
  .week[data-live] .week__scene :global(.swing), .week[data-live] .week__scene :global(.swipe),
  .week[data-live] .week__scene :global(.paid), .week[data-live] .week__scene :global(.st),
  .week[data-live] .week__scene :global(.rep), .week[data-live] .week__scene :global(.drop),
  .week[data-live] .week__scene :global(.ripple), .week[data-live] .week__scene :global(.lead),
  .week[data-live] .week__scene :global(.orbit), .week[data-live] .week__scene :global(.again) {
    animation-duration: var(--cycle);
    animation-delay: var(--start);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    animation-fill-mode: backwards;
  }

  /* 1. Monday 9:02pm: the phone rings, goes unanswered, DUSA texts back. */
  .week__scene :global(.ph) { transform-origin: 50px 65px; }
  .week[data-live] .week__scene :global(.ph) { animation-name: wkShake; }
  @keyframes wkShake {
    0%, 2%, 6%, 10%, 14%, 18%, 22%, 26%, 30%, 34% { transform: rotate(0); }
    4%, 12%, 20%, 28% { transform: rotate(-2.5deg); }
    8%, 16%, 24%, 32% { transform: rotate(2.5deg); }
    36%, 100% { transform: rotate(0); }
  }
  .week__scene :global(.rg) { transform-origin: 80px 58px; }
  .week[data-live] .week__scene :global(.rg) { animation-name: wkRing; }
  .week[data-live] .week__scene :global(.rg--2) { animation-name: wkRing2; }
  @keyframes wkRing { 0%, 36% { opacity: 0; } 3%, 11%, 19%, 27% { opacity: 1; } 7%, 15%, 23%, 31% { opacity: 0.15; } 37%, 100% { opacity: 0; } }
  @keyframes wkRing2 { 0%, 36% { opacity: 0; } 5%, 13%, 21%, 29% { opacity: 0.8; } 9%, 17%, 25%, 33% { opacity: 0.1; } 37%, 100% { opacity: 0; } }
  .week[data-live] .week__scene :global(.call) { animation-name: wkCall; }
  @keyframes wkCall { 0%, 38% { opacity: 1; } 42%, 100% { opacity: 0; } }
  .week[data-live] .week__scene :global(.missed) { animation-name: wkMissed; }
