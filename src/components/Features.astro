---
// Features.astro — Motherboard: DUSA is the CPU, services are peripheral ICs
// Data pulses IN from each peripheral independently (chaotic)
// Every 1.5s DUSA pushes unified data OUT to all peripherals simultaneously
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;

const s = t?.features || {};
const featLabel = s.label || 'The Platform';
const featHeading = s.heading || 'Everything';
const featHeadingAccent = s.headingAccent || 'connects.';
const featSub = s.sub || 'Six systems. One processor. DUSA connects every part of your business on a single board.';
const node1Title = s.node1Title || 'CRM & Contacts';
const node1Desc = s.node1Desc || 'AI scores leads. You close deals.';
const node2Title = s.node2Title || 'AI Automations';
const node2Desc = s.node2Desc || 'Set it once. AI handles the rest.';
const node3Title = s.node3Title || 'Email & SMS';
const node3Desc = s.node3Desc || 'AI writes, sends, and optimises.';
const node4Title = s.node4Title || 'Funnels & Pages';
const node4Desc = s.node4Desc || 'Pages that convert. No dev needed.';
const node5Title = s.node5Title || 'Scheduling';
const node5Desc = s.node5Desc || 'Clients book. AI handles the rest.';
const node6Title = s.node6Title || 'Payments';
const node6Desc = s.node6Desc || 'Get paid faster. AI chases the rest.';
const featFooter = s.footerText || 'One platform. No duct tape. No switching tabs. Just growth.';
const featCta = s.ctaText || 'See it in action';
---

<section class="mobo section section--dark" id="features">
  <div class="container">
    <div class="mobo__header">
      <span class="label">{featLabel}</span>
      <h2>{featHeading}<br/><span class="gradient-text">{featHeadingAccent}</span></h2>
      <p class="mobo__sub">{featSub}</p>
    </div>

    <div class="mobo__stage">
      <div class="mobo__board">

        <!-- ═══ PCB SVG ═══ -->
        <svg class="mobo__pcb" viewBox="0 0 680 680" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <pattern id="pcbDots" width="20" height="20" patternUnits="userSpaceOnUse">
              <circle cx="10" cy="10" r="0.6" fill="rgba(78,216,194,0.1)"/>
            </pattern>
            <filter id="pulseGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="3.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- PCB grid -->
          <rect width="680" height="680" fill="url(#pcbDots)"/>

          <!-- Silkscreen text (subtle, inside board area) -->
          <text x="340" y="668" fill="rgba(78,216,194,0.12)" font-family="monospace" font-size="7" letter-spacing="0.1em" text-anchor="middle">DUSA-MB REV 1.0</text>

          <!-- ═══ DECORATIVE VIAS ═══ -->
          <g opacity="0.3">
            <circle cx="160" cy="140" r="4" stroke="#4ED8C2" stroke-width="0.7" fill="none"/><circle cx="160" cy="140" r="1.5" fill="#4ED8C2"/>
            <circle cx="520" cy="140" r="4" stroke="#4ED8C2" stroke-width="0.7" fill="none"/><circle cx="520" cy="140" r="1.5" fill="#4ED8C2"/>
            <circle cx="520" cy="540" r="4" stroke="#4ED8C2" stroke-width="0.7" fill="none"/><circle cx="520" cy="540" r="1.5" fill="#4ED8C2"/>
            <circle cx="160" cy="540" r="4" stroke="#4ED8C2" stroke-width="0.7" fill="none"/><circle cx="160" cy="540" r="1.5" fill="#4ED8C2"/>
            <circle cx="280" cy="200" r="3.5" stroke="#4ED8C2" stroke-width="0.6" fill="none"/><circle cx="280" cy="200" r="1.2" fill="#4ED8C2"/>
            <circle cx="400" cy="200" r="3.5" stroke="#4ED8C2" stroke-width="0.6" fill="none"/><circle cx="400" cy="200" r="1.2" fill="#4ED8C2"/>
            <circle cx="400" cy="480" r="3.5" stroke="#4ED8C2" stroke-width="0.6" fill="none"/><circle cx="400" cy="480" r="1.2" fill="#4ED8C2"/>
            <circle cx="280" cy="480" r="3.5" stroke="#4ED8C2" stroke-width="0.6" fill="none"/><circle cx="280" cy="480" r="1.2" fill="#4ED8C2"/>
            <circle cx="340" cy="180" r="3" stroke="#4ED8C2" stroke-width="0.5" fill="none"/><circle cx="340" cy="180" r="1" fill="#4ED8C2"/>
            <circle cx="340" cy="500" r="3" stroke="#4ED8C2" stroke-width="0.5" fill="none"/><circle cx="340" cy="500" r="1" fill="#4ED8C2"/>
            <circle cx="180" cy="340" r="3" stroke="#4ED8C2" stroke-width="0.5" fill="none"/><circle cx="180" cy="340" r="1" fill="#4ED8C2"/>
            <circle cx="500" cy="340" r="3" stroke="#4ED8C2" stroke-width="0.5" fill="none"/><circle cx="500" cy="340" r="1" fill="#4ED8C2"/>
          </g>

          <!-- ═══ DECORATIVE COMPONENTS ═══ -->
          <g opacity="0.2" stroke="#4ED8C2" stroke-width="0.8" fill="none">
            <rect x="180" y="258" width="8" height="4" rx="1"/><rect x="490" y="258" width="8" height="4" rx="1"/>
            <rect x="180" y="418" width="8" height="4" rx="1"/><rect x="490" y="418" width="8" height="4" rx="1"/>
            <rect x="368" y="160" width="4" height="8" rx="1"/><rect x="368" y="512" width="4" height="8" rx="1"/>
            <rect x="300" y="440" width="8" height="4" rx="1"/><rect x="440" y="248" width="4" height="8" rx="1"/>
          </g>

          <!-- ═══ DECORATIVE TRACE STUBS ═══ -->
          <g stroke="rgba(78,216,194,0.22)" stroke-width="1.5" stroke-linecap="round">
            <path d="M340,150 L380,150 L380,168"/>
            <path d="M340,530 L300,530 L300,512"/>
            <path d="M500,195 L500,162 L518,162"/>
            <path d="M500,505 L500,538 L518,538"/>
            <path d="M180,195 L180,162 L162,162"/>
            <path d="M180,505 L180,538 L162,538"/>
          </g>

          <!-- ═══ MAIN TRACES ═══ -->
          <!-- Glow layer -->
          <g stroke="rgba(78,216,194,0.12)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round">
            <path d="M340,96 L340,272"/>
            <path d="M551,195 L460,195 L460,320 L385,320"/>
            <path d="M551,505 L460,505 L460,360 L385,360"/>
            <path d="M340,584 L340,385"/>
            <path d="M129,505 L220,505 L220,360 L295,360"/>
            <path d="M129,195 L220,195 L220,320 L295,320"/>
          </g>
          <!-- Trace lines -->
          <g stroke="rgba(78,216,194,0.45)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M340,96 L340,272"/>
            <path d="M551,195 L460,195 L460,320 L385,320"/>
            <path d="M551,505 L460,505 L460,360 L385,360"/>
            <path d="M340,584 L340,385"/>
            <path d="M129,505 L220,505 L220,360 L295,360"/>
            <path d="M129,195 L220,195 L220,320 L295,320"/>
          </g>
          <!-- Parallel secondary traces (offset 8px) -->
          <g stroke="rgba(78,216,194,0.18)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M348,96 L348,258 L360,258"/>
            <path d="M551,203 L468,203 L468,328 L385,328"/>
            <path d="M551,497 L452,497 L452,352 L385,352"/>
            <path d="M332,584 L332,420 L320,420"/>
            <path d="M129,497 L212,497 L212,352 L295,352"/>
            <path d="M129,203 L228,203 L228,328 L295,328"/>
          </g>
          <!-- Turn pads -->
          <g fill="rgba(78,216,194,0.15)" stroke="rgba(78,216,194,0.35)" stroke-width="1">
            <circle cx="460" cy="195" r="4.5"/><circle cx="460" cy="320" r="4.5"/>
            <circle cx="460" cy="505" r="4.5"/><circle cx="460" cy="360" r="4.5"/>
            <circle cx="220" cy="505" r="4.5"/><circle cx="220" cy="360" r="4.5"/>
            <circle cx="220" cy="195" r="4.5"/><circle cx="220" cy="320" r="4.5"/>
          </g>

          <!-- ═══ CPU CHIP ═══ -->
          <g class="mobo__cpu-g">
            <!-- Package constant glow -->
            <rect x="291" y="291" width="98" height="98" rx="5" fill="none" stroke="rgba(78,216,194,0.15)" stroke-width="6" filter="url(#pulseGlow)"/>
            <!-- Package -->
            <rect x="295" y="295" width="90" height="90" rx="3" fill="rgba(12,14,20,0.95)" stroke="rgba(78,216,194,0.45)" stroke-width="1.5"/>
            <!-- Pin 1 notch -->
            <circle cx="301" cy="301" r="3" fill="none" stroke="rgba(78,216,194,0.3)" stroke-width="0.7"/>
            <!-- Pin arrays -->
            <g opacity="0.35" fill="#4ED8C2">
              <!-- Top pins -->
              <rect x="312" y="292" width="3" height="7" rx="0.5"/><rect x="322" y="292" width="3" height="7" rx="0.5"/>
              <rect x="332" y="292" width="3" height="7" rx="0.5"/><rect x="342" y="292" width="3" height="7" rx="0.5"/>
              <rect x="352" y="292" width="3" height="7" rx="0.5"/><rect x="362" y="292" width="3" height="7" rx="0.5"/>
              <rect x="372" y="292" width="3" height="7" rx="0.5"/>
              <!-- Bottom pins -->
              <rect x="312" y="381" width="3" height="7" rx="0.5"/><rect x="322" y="381" width="3" height="7" rx="0.5"/>
              <rect x="332" y="381" width="3" height="7" rx="0.5"/><rect x="342" y="381" width="3" height="7" rx="0.5"/>
              <rect x="352" y="381" width="3" height="7" rx="0.5"/><rect x="362" y="381" width="3" height="7" rx="0.5"/>
              <rect x="372" y="381" width="3" height="7" rx="0.5"/>
              <!-- Left pins -->
              <rect x="292" y="312" width="7" height="3" rx="0.5"/><rect x="292" y="322" width="7" height="3" rx="0.5"/>
              <rect x="292" y="332" width="7" height="3" rx="0.5"/><rect x="292" y="342" width="7" height="3" rx="0.5"/>
              <rect x="292" y="352" width="7" height="3" rx="0.5"/><rect x="292" y="362" width="7" height="3" rx="0.5"/>
              <rect x="292" y="372" width="7" height="3" rx="0.5"/>
              <!-- Right pins -->
              <rect x="381" y="312" width="7" height="3" rx="0.5"/><rect x="381" y="322" width="7" height="3" rx="0.5"/>
              <rect x="381" y="332" width="7" height="3" rx="0.5"/><rect x="381" y="342" width="7" height="3" rx="0.5"/>
              <rect x="381" y="352" width="7" height="3" rx="0.5"/><rect x="381" y="362" width="7" height="3" rx="0.5"/>
              <rect x="381" y="372" width="7" height="3" rx="0.5"/>
            </g>
            <!-- Inner die -->
            <rect x="315" y="315" width="50" height="50" rx="2" fill="rgba(78,216,194,0.06)" stroke="rgba(78,216,194,0.4)" stroke-width="1"/>
            <!-- Die flash (pulses every 1.5s) -->
            <rect x="315" y="315" width="50" height="50" rx="2" fill="none" stroke="#4ED8C2" stroke-width="2.5" opacity="0">
              <animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0;0;0.9;0.15;0" keyTimes="0;0.72;0.82;0.94;1"/>
            </rect>
            <!-- DUSA logo -->
            <!-- Deferred: an SVG <image> loads eagerly with the document, so the
                 96KB animation used to download during the homepage's initial
                 load even though this chip sits well below the fold. The static
                 lotus shows immediately; the animation swaps in on approach. -->
            <image id="features-lotus" href="/dusa-logo.webp" data-animated="/dusa-logo-animated.webp" x="314" y="314" width="52" height="52"/>
            <!-- CPU label tab (extends above package) -->
            <rect x="312" y="272" width="56" height="23" rx="2" fill="rgba(12,14,20,0.95)" stroke="rgba(78,216,194,0.45)" stroke-width="1.5"/>
            <text x="340" y="288" text-anchor="middle" fill="#4ED8C2" font-family="var(--font-headline), sans-serif" font-size="12" font-weight="700" letter-spacing="0.2em">DUSA</text>
          </g>

          <!-- CPU pulse ring (expands every 1.5s, starts from full chip+label area) -->
          <rect x="295" y="272" width="90" height="113" rx="6" fill="none" stroke="#4ED8C2" stroke-width="1.5" opacity="0">
            <animate attributeName="x" dur="1.5s" repeatCount="indefinite" values="295;265;265" keyTimes="0;0.5;1"/>
            <animate attributeName="y" dur="1.5s" repeatCount="indefinite" values="272;252;252" keyTimes="0;0.5;1"/>
            <animate attributeName="width" dur="1.5s" repeatCount="indefinite" values="90;150;150" keyTimes="0;0.5;1"/>
            <animate attributeName="height" dur="1.5s" repeatCount="indefinite" values="113;173;173" keyTimes="0;0.5;1"/>
            <animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.35;0;0" keyTimes="0;0.5;1"/>
          </rect>

          <!-- ═══ INBOUND PULSES (chaotic, varied timing) ═══ -->
          <g class="mobo__in">
            <!-- T1 CRM (2.0s) -->
            <circle r="2.5" fill="#6AAACF" opacity="0"><animateMotion dur="2.0s" repeatCount="indefinite" path="M340,96 L340,272"/><animate attributeName="opacity" dur="2.0s" repeatCount="indefinite" values="0;0.85;0.85;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#4ED8C2" opacity="0"><animateMotion dur="2.0s" repeatCount="indefinite" begin="1.0s" path="M340,96 L340,272"/><animate attributeName="opacity" dur="2.0s" repeatCount="indefinite" begin="1.0s" values="0;0.7;0.7;0" keyTimes="0;0.08;0.85;1"/></circle>
            <!-- T2 AI Auto (2.6s) -->
            <circle r="2.5" fill="#4ED8C2" opacity="0"><animateMotion dur="2.6s" repeatCount="indefinite" path="M551,195 L460,195 L460,320 L385,320"/><animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" values="0;0.8;0.8;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#6AAACF" opacity="0"><animateMotion dur="2.6s" repeatCount="indefinite" begin="1.3s" path="M551,195 L460,195 L460,320 L385,320"/><animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" begin="1.3s" values="0;0.65;0.65;0" keyTimes="0;0.08;0.85;1"/></circle>
            <!-- T3 Email (2.4s) -->
            <circle r="2.5" fill="#6AAACF" opacity="0"><animateMotion dur="2.4s" repeatCount="indefinite" path="M551,505 L460,505 L460,360 L385,360"/><animate attributeName="opacity" dur="2.4s" repeatCount="indefinite" values="0;0.8;0.8;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#4ED8C2" opacity="0"><animateMotion dur="2.4s" repeatCount="indefinite" begin="1.2s" path="M551,505 L460,505 L460,360 L385,360"/><animate attributeName="opacity" dur="2.4s" repeatCount="indefinite" begin="1.2s" values="0;0.65;0.65;0" keyTimes="0;0.08;0.85;1"/></circle>
            <!-- T4 Funnels (2.2s) -->
            <circle r="2.5" fill="#4ED8C2" opacity="0"><animateMotion dur="2.2s" repeatCount="indefinite" path="M340,584 L340,385"/><animate attributeName="opacity" dur="2.2s" repeatCount="indefinite" values="0;0.85;0.85;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#6AAACF" opacity="0"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.1s" path="M340,584 L340,385"/><animate attributeName="opacity" dur="2.2s" repeatCount="indefinite" begin="1.1s" values="0;0.7;0.7;0" keyTimes="0;0.08;0.85;1"/></circle>
            <!-- T5 Scheduling (2.8s) -->
            <circle r="2.5" fill="#6AAACF" opacity="0"><animateMotion dur="2.8s" repeatCount="indefinite" path="M129,505 L220,505 L220,360 L295,360"/><animate attributeName="opacity" dur="2.8s" repeatCount="indefinite" values="0;0.8;0.8;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#4ED8C2" opacity="0"><animateMotion dur="2.8s" repeatCount="indefinite" begin="1.4s" path="M129,505 L220,505 L220,360 L295,360"/><animate attributeName="opacity" dur="2.8s" repeatCount="indefinite" begin="1.4s" values="0;0.65;0.65;0" keyTimes="0;0.08;0.85;1"/></circle>
            <!-- T6 Payments (3.0s) -->
            <circle r="2.5" fill="#4ED8C2" opacity="0"><animateMotion dur="3.0s" repeatCount="indefinite" path="M129,195 L220,195 L220,320 L295,320"/><animate attributeName="opacity" dur="3.0s" repeatCount="indefinite" values="0;0.8;0.8;0" keyTimes="0;0.08;0.85;1"/></circle>
            <circle r="2" fill="#6AAACF" opacity="0"><animateMotion dur="3.0s" repeatCount="indefinite" begin="1.5s" path="M129,195 L220,195 L220,320 L295,320"/><animate attributeName="opacity" dur="3.0s" repeatCount="indefinite" begin="1.5s" values="0;0.65;0.65;0" keyTimes="0;0.08;0.85;1"/></circle>
          </g>

          <!-- ═══ OUTBOUND PULSES (unified, every 1.5s) ═══ -->
          <g class="mobo__out" filter="url(#pulseGlow)">
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M340,272 L340,96"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M385,320 L460,320 L460,195 L551,195"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M385,360 L460,360 L460,505 L551,505"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M340,385 L340,584"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M295,360 L220,360 L220,505 L129,505"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
            <circle r="3" fill="#4ED8C2"><animateMotion dur="1.5s" repeatCount="indefinite" path="M295,320 L220,320 L220,195 L129,195"/><animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.9;0.8;0;0" keyTimes="0;0.55;0.75;1"/></circle>
          </g>
        </svg>

        <!-- ═══ HTML NODES ═══ -->
        <div class="mobo__node mobo__node--1">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="mobo__node-title">{node1Title}</h3>
          <p class="mobo__node-desc">{node1Desc}</p>
        </div>

        <div class="mobo__node mobo__node--2">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
          </div>
          <h3 class="mobo__node-title">{node2Title}</h3>
          <p class="mobo__node-desc">{node2Desc}</p>
        </div>

        <div class="mobo__node mobo__node--3">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h3 class="mobo__node-title">{node3Title}</h3>
          <p class="mobo__node-desc">{node3Desc}</p>
        </div>

        <div class="mobo__node mobo__node--4">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </div>
          <h3 class="mobo__node-title">{node4Title}</h3>
          <p class="mobo__node-desc">{node4Desc}</p>
        </div>

        <div class="mobo__node mobo__node--5">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <h3 class="mobo__node-title">{node5Title}</h3>
          <p class="mobo__node-desc">{node5Desc}</p>
        </div>

        <div class="mobo__node mobo__node--6">
          <div class="mobo__chip-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/><line x1="6" y1="15" x2="10" y2="15"/>
