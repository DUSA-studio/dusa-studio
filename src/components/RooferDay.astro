      };
      tree(-6.0, -2.6, 1.0); tree(6.0, 3.6, 1.15); tree(0.9, 3.9, 0.8); tree(-1.6, -2.4, 0.7);
      for (let i = 0; i < 7; i++) { const f = sph(0.09, mat(P.flower[i % 3]), HX - 1.9 + i * 0.3, 0.09, HZ + D / 2 + 0.45 + (i % 2) * 0.2); f.castShadow = false; home.add(f); }
      if (nice) {
        const fenceM = mat(0xf7f4ef, { roughness: 0.6 });
        for (let fx = -2.4; fx <= 6.2; fx += 0.3) { if (Math.abs(fx - 2.4) < 0.5) continue; home.add(rbox(0.09, 0.55, 0.05, fenceM, 0.03, HX + fx, 0.28, HZ + 4.0)); }
        home.add(rbox(4.2, 0.05, 0.04, fenceM, 0.02, HX - 0.3, 0.36, HZ + 4.0), rbox(3.2, 0.05, 0.04, fenceM, 0.02, HX + 4.6, 0.36, HZ + 4.0));
      }

      /* The ute, parked in the customer's driveway by day and at home by night. */
      const ute = new THREE.Group(); isle.add(ute);
      const uteM = mat(P.ute, { roughness: nice ? 0.35 : 0.6, metalness: nice ? 0.3 : 0.1 });
      ute.add(rbox(2.3, 0.5, 1.15, uteM, 0.1, 0, 0.5, 0));
      ute.add(rbox(1.0, 0.64, 1.1, uteM, 0.12, 0.5, 1.04, 0));
      ute.add(rbox(0.96, 0.4, 1.0, mat(0xbfe6f5, { roughness: 0.15, metalness: 0.4 }), 0.08, 0.5, 1.08, 0));
      ute.add(rbox(1.0, 0.36, 1.08, mat(P.uteDark), 0.06, -0.55, 0.9, 0));
      const lampM = mat(0xfff2c2, { emissive: 0xfff2c2, emissiveIntensity: 0.3 });
      ute.add(rbox(0.15, 0.06, 0.4, lampM, 0.02, 1.16, 0.55, 0.3), rbox(0.15, 0.06, 0.4, lampM, 0.02, 1.16, 0.55, -0.3));
      if (nice) { const rk = mat(0xc8ced6, { metalness: 0.6, roughness: 0.3 }); ute.add(rbox(1.1, 0.05, 0.06, rk, 0.02, 0.5, 1.4, 0.38), rbox(1.1, 0.05, 0.06, rk, 0.02, 0.5, 1.4, -0.38), rbox(0.08, 0.1, 1.2, rk, 0.02, 1.2, 0.33, 0)); }
      const tyreM = mat(0x1d1f24, { roughness: 0.9 }), hubM = mat(0xc8ced6, { metalness: 0.6, roughness: 0.3 });
      const wheels: THREE.Mesh[] = [];
      for (const [wx, wz] of [[-0.75, 0.6], [-0.75, -0.6], [0.75, 0.6], [0.75, -0.6]]) { const t = cyl(0.28, 0.28, 0.22, tyreM, wx, 0.28, wz, 28); t.rotation.x = Math.PI / 2; ute.add(t); wheels.push(t); const h = cyl(0.13, 0.13, 0.24, hubM, wx, 0.28, wz, 20); h.rotation.x = Math.PI / 2; ute.add(h); }
      ute.position.set(UX, 0, UZ); ute.rotation.y = Math.PI / 2;

      /* Smoko: esky, crates, thermos. */
      const smoko = new THREE.Group(); isle.add(smoko);
      smoko.add(rbox(0.8, 0.5, 0.5, mat(P.esky), 0.08, 0, 0.25, 0), rbox(0.84, 0.1, 0.54, mat(0xf2ece0), 0.04, 0, 0.53, 0));
      smoko.add(rbox(0.55, 0.45, 0.55, mat(0xc9a27a), 0.05, -1.1, 0.225, 0.5), rbox(0.55, 0.45, 0.55, mat(0xc9a27a), 0.05, 1.1, 0.225, 0.45));
      smoko.add(cyl(0.1, 0.1, 0.36, mat(nice ? 0x4ed8c2 : 0x8a8f96), 0.25, 0.76, -0.1));
      smoko.position.set(2.6, 0, -3.0); smoko.scale.setScalar(0.001);

      /* Home: the deck and the table, a lamp or a laptop. */
      home.add(rbox(4.6, 0.14, 2.6, mat(P.deck), 0.05, HX, 0.07, HZ + 2.7));
      const table = new THREE.Group(); table.position.set(HX, 0.14, HZ + 2.7); home.add(table);
      table.add(rbox(1.5, 0.08, 0.8, mat(0xd9b48a), 0.03, 0, 0.72, 0));
      for (const [tx, tz] of [[-0.65, 0.3], [0.65, 0.3], [-0.65, -0.3], [0.65, -0.3]]) table.add(rbox(0.07, 0.7, 0.07, mat(0x8b6a4b), 0.02, tx, 0.35, tz));
      const laptopScreen = new THREE.Mesh(new RoundedBoxGeometry(0.5, 0.34, 0.03, 2, 0.02), new THREE.MeshStandardMaterial({ color: 0x1c2a3e, emissive: 0x9fd8ff, emissiveIntensity: 0 }));
      laptopScreen.position.set(0, 0.95, -0.25); laptopScreen.rotation.x = -0.3;
      const coldLight = new THREE.PointLight(0x9fd8ff, 0, 4, 2); coldLight.position.set(0, 1.1, 0.2);
      const warmLight = new THREE.PointLight(0xffb36b, 0, 5, 2); warmLight.position.set(0, 1.4, 0);
      const bulb = sph(0.06, mat(0xffe3a3, { emissive: 0xffd58a, emissiveIntensity: 0 }), 0, 1.36, 0);
      if (nice) { table.add(cyl(0.03, 0.04, 0.6, mat(0x8b6a4b), 0, 1.05, 0), cyl(0.18, 0.1, 0.18, mat(0xf2ece0), 0, 1.42, 0), warmLight, bulb); for (const [px, pz] of [[-0.45, 0.15], [0.45, 0.15], [0, -0.2]]) table.add(cyl(0.11, 0.11, 0.02, mat(0xf7f4ef), px, 0.77, pz)); }
      else table.add(laptopScreen, rbox(0.5, 0.02, 0.34, mat(0xb8bfc8, { metalness: 0.5 }), 0.01, 0, 0.78, -0.08), coldLight);
      home.scale.setScalar(0.001);

      /* People */
      const roofer = makePerson(P.shirt, P.vest, P.hat, 0xd9a98a, true, 1.15); isle.add(roofer.g);
      const crew1 = makePerson(nice ? 0x6aaacf : 0x8a9099, P.vest, P.hat, 0xc98a6a, true, 1.15); crew1.g.userData.phase = 1.2; isle.add(crew1.g);
      const crew2 = makePerson(nice ? 0xf7f4ef : 0xa39f96, P.vest, P.hat, 0x8a5a3c, true, 1.15); crew2.g.userData.phase = 2.4; isle.add(crew2.g);
      const partner = makePerson(nice ? 0x6aaacf : 0x9a948c, 0, 0, 0xd9a98a, false, 1.08); isle.add(partner.g);
      const kid = makePerson(nice ? 0x4ed8c2 : 0xb0aaa0, 0, 0, 0xd9a98a, false, 0.7); isle.add(kid.g);
      [partner, kid].forEach((p) => { p.g.children.forEach((c) => { if ((c as THREE.Mesh).geometry instanceof RoundedBoxGeometry && c.position.y > 0.8 && c.position.y < 0.9) c.visible = false; }); });

      /* The phone in the ute tray. It rings; red or mint. */
      const ringC = nice ? 0x4ed8c2 : 0xff6b5e;
      const trayPhone = rbox(0.18, 0.36, 0.03, mat(0x14161c, { roughness: 0.4, metalness: 0.5 }), 0.02, 0, 0, 0);
      trayPhone.rotation.x = -Math.PI / 2; trayPhone.position.set(UX, 0.78, UZ + 0.55); isle.add(trayPhone);
      const ringLight = new THREE.PointLight(ringC, 0, 2.5); ringLight.position.set(UX, 1.1, UZ + 0.55); isle.add(ringLight);
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.02, 8, 40), new THREE.MeshBasicMaterial({ color: ringC, transparent: true, opacity: 0 }));
      ring.rotation.x = -Math.PI / 2; ring.position.set(UX, 0.82, UZ + 0.55); isle.add(ring);

      /* ── Marks and schedules. Hours of the day → where each person is. ── */
      const ROOF_Y = H + 1.35 - 0.1;
      type Mark = { p: THREE.Vector3; r: number; pose: Pose };
      const M = (p: THREE.Vector3, r: number, pose: Pose): Mark => ({ p, r, pose });
      const roofAt = (dx: number, dz = 0, pose: Pose = 'hammer') => M(V(HX + dx, ROOF_Y - Math.abs(dx) * 0.55, HZ + dz), 0.4, pose);
      const ladderFoot = M(V(HX + W / 2 + 1.5, 0, HZ + 1.2), -2.4, 'stand');
      const uteBack = (dx: number, dz: number, pose: Pose = 'stand', r = -1.2) => M(V(UX + dx, 0, UZ + dz), r, pose);
      const smokoSeat = [M(V(2.6, 0, -3.0), 0.5, 'sitMug'), M(V(1.5, 0, -2.5), 1.0, 'sitMug'), M(V(3.7, 0, -2.55), -0.9, 'sitMug')];
      const pace = M(V(5.3, 0, 1.4), -2.2, 'phone');
      const tableSeat = (dx: number, dz: number, r: number, pose: Pose) => M(V(HX + dx, 0.14, HZ + 2.7 + dz), r, pose);
      const away = M(V(0, -3, 0), 0, 'stand');
      type Key = [number, Mark];
      const sched = {
        roofer: nice ? [
          [6.5, uteBack(-0.9, 2.1, 'carry', -0.4)], [7.1, uteBack(-0.9, 2.1, 'carry', -0.4)], [7.4, ladderFoot], [7.7, roofAt(0.3)], [10.35, roofAt(0.3)], [10.5, smokoSeat[0]], [11.2, smokoSeat[0]], [11.4, ladderFoot], [11.65, roofAt(0.3)], [16.3, roofAt(0.3)], [16.5, ladderFoot], [16.8, uteBack(-0.9, 2.1, 'carry', -0.4)], [17.3, uteBack(-0.9, 2.1, 'carry', -0.4)], [17.6, away], [18.5, away], [18.8, tableSeat(-0.55, 0.6, Math.PI, 'sit')], [21.5, tableSeat(-0.55, 0.6, Math.PI, 'sit')],
        ] : [
          [6.5, uteBack(0.9, 2.3, 'phone', -2.6)], [7.4, uteBack(0.9, 2.3, 'phone', -2.6)], [7.7, ladderFoot], [8.0, roofAt(0.3)], [9.2, roofAt(0.3)], [9.3, ladderFoot], [9.45, uteBack(0.9, 2.3, 'phone', -2.6)], [9.9, uteBack(0.9, 2.3, 'phone', -2.6)], [10.05, ladderFoot], [10.3, roofAt(0.3)], [10.45, roofAt(0.3)], [10.55, ladderFoot], [10.7, pace], [11.3, pace], [11.45, ladderFoot], [11.7, roofAt(0.3)], [12.3, roofAt(0.3)], [12.4, ladderFoot], [12.55, uteBack(0.9, 2.3, 'phone', -2.6)], [13.1, uteBack(0.9, 2.3, 'phone', -2.6)], [13.25, ladderFoot], [13.5, roofAt(0.3)], [13.9, roofAt(0.3)], [14.0, ladderFoot], [14.15, uteBack(0.9, 2.3, 'phone', -2.6)], [14.6, uteBack(0.9, 2.3, 'phone', -2.6)], [14.75, ladderFoot], [15.0, roofAt(0.3)], [17.9, roofAt(0.3)], [18.1, ladderFoot], [18.3, uteBack(-0.9, 2.1, 'carry', -0.4)], [18.5, away], [19.4, away], [19.7, tableSeat(0, 0.6, Math.PI, 'laptop')], [21.5, tableSeat(0, 0.6, Math.PI, 'laptop')],
        ],
        crew1: [
          [6.5, uteBack(-0.2, 2.0, 'carry', -0.9)], [7.2, uteBack(-0.2, 2.0, 'carry', -0.9)], [7.5, ladderFoot], [7.8, roofAt(-0.2, 1.0)], [10.35, roofAt(-0.2, 1.0)], [10.55, smokoSeat[1]], [11.2, smokoSeat[1]], [11.45, ladderFoot], [11.7, roofAt(-0.2, 1.0)], [16.3, roofAt(-0.2, 1.0)], [16.55, ladderFoot], [16.8, uteBack(-0.2, 2.0, 'carry', -0.9)], [17.5, uteBack(-0.2, 2.0, 'stand', -0.9)], [17.8, away], [21.5, away],
        ] as Key[],
        crew2: [
          [6.5, uteBack(0.9, 1.6, 'stand', -2.0)], [7.3, uteBack(0.9, 1.6, 'carry', -2.0)], [7.6, ladderFoot], [10.35, ladderFoot], [10.6, smokoSeat[2]], [11.2, smokoSeat[2]], [11.5, ladderFoot], [13.4, ladderFoot], [13.7, roofAt(0.1, -1.0)], [16.3, roofAt(0.1, -1.0)], [16.6, ladderFoot], [16.9, uteBack(0.9, 1.6, 'stand', -2.0)], [17.5, uteBack(0.9, 1.6, 'stand', -2.0)], [17.8, away], [21.5, away],
        ] as Key[],
        partner: nice ? [[6.5, away], [18.6, away], [18.9, tableSeat(0.6, 0.6, Math.PI, 'sit')], [21.5, tableSeat(0.6, 0.6, Math.PI, 'sit')]] as Key[] : [[6.5, away], [21.5, away]] as Key[],
        kid: nice ? [[6.5, away], [18.6, away], [19.0, tableSeat(0, -0.6, 0, 'sit')], [21.5, tableSeat(0, -0.6, 0, 'sit')]] as Key[] : [[6.5, away], [21.5, away]] as Key[],
      };
      // Without DUSA, the crew wait around at smoko and at the end of the day while the boss is on the phone.
      if (!nice) { sched.crew2[2] = [7.6, ladderFoot]; }
      const people: { p: ReturnType<typeof makePerson>; keys: Key[] }[] = [
        { p: roofer, keys: sched.roofer as Key[] }, { p: crew1, keys: sched.crew1 }, { p: crew2, keys: sched.crew2 }, { p: partner, keys: sched.partner }, { p: kid, keys: sched.kid },
      ];
      const place = (keys: Key[], h: number) => {
        let i = 0; while (i < keys.length - 2 && h >= keys[i + 1][0]) i++;
        const [h0, a] = keys[i], [h1, b] = keys[i + 1];
        const t = clamp01((h - h0) / Math.max(0.0001, h1 - h0));
        const moving = a.p.distanceToSquared(b.p) > 0.01;
        const pos = a.p.clone().lerp(b.p, moving ? smooth(0, 1, t) : t);
        // Climbing: lift through the arc so nobody walks through the wall.
        if (moving && Math.abs(a.p.y - b.p.y) > 1) pos.y = Math.max(a.p.y, b.p.y) * Math.sin(t * Math.PI / 2) ** 0.6 * (b.p.y > a.p.y ? 1 : 0) + (b.p.y > a.p.y ? 0 : Math.max(a.p.y, b.p.y) * Math.cos(t * Math.PI / 2) ** 0.6);
        const speed = moving ? a.p.distanceTo(b.p) / (h1 - h0) : 0;
        let rot = moving ? Math.atan2(b.p.x - a.p.x, b.p.z - a.p.z) : b.r;
        if (moving && t > 0.9) rot = b.r;
        return { pos, rot, pose: moving ? ('walk' as Pose) : (t < 1 ? b.pose : b.pose), speed, nextPose: b.pose };
      };
      // Roof progress: tiles go on while the boss is on the roof. Precomputed per hour.
      const onRoofHours: number[] = []; let acc = 0;
      for (let h = 6.5; h <= 21.5; h += 0.05) { const s = place(sched.roofer as Key[], h); if (!s.pose.startsWith('walk') && s.nextPose === 'hammer' && s.pos.y > 2) acc += 0.05; onRoofHours.push(acc); }
      const total = nice ? onRoofHours[onRoofHours.length - 1] * 0.95 : onRoofHours[onRoofHours.length - 1] * 1.75; // the DUSA roof finishes; the other does not
      const progressAt = (h: number) => clamp01(onRoofHours[Math.min(onRoofHours.length - 1, Math.max(0, Math.round((h - 6.5) / 0.05)))] / total);

      let lastT = 0, running = false, pingAt = -1e9, shownBeat = -1;
      const cur = { night: 0, smoko: 0, home: 0, driveOff: 0 };
      const resize = () => {
        const w = stage.clientWidth, h = stage.clientHeight; renderer.setSize(w, h, false);
        const aspect = w / h; const halfW = aspect < 1 ? 7.4 : 9.4;
        camera.left = -halfW; camera.right = halfW; camera.top = halfW / aspect; camera.bottom = -halfW / aspect; camera.updateProjectionMatrix();
      };
      const setBeat = (b: number) => { if (b !== shownBeat) { shownBeat = b; pingAt = performance.now(); } };

      const frame = (now: number, h: number, dt: number, b: number) => {
        setBeat(b);
        // Sun on its arc, warm at the ends, blue at night.
        const sunT = clamp01((h - 6) / 13), elev = Math.sin(sunT * Math.PI);
        const night = smooth(18.2, 19.4, h), dawn = 1 - smooth(6.5, 8.5, h), dusk = smooth(16.5, 18.3, h) * (1 - night);
        cur.night = night;
        sun.position.set(Math.cos(Math.PI - sunT * Math.PI) * 10, 2 + elev * 10, 5 + elev * 2);
        sun.intensity = 0.35 + elev * 2.4 * (1 - night);
        sun.color.set(0xffffff).lerp(new THREE.Color(0xffa070), Math.max(dawn, dusk) * 0.8).lerp(new THREE.Color(0x6f86b8), night);
        hemi.intensity = 0.3 + elev * 0.9 * (1 - night) + 0.05 * night;
        hemi.color.set(0xdff2ff).lerp(new THREE.Color(0x3b5a8c), night);
        homeWin.emissiveIntensity = night * (nice ? 1.4 : 0.35);
        warmLight.intensity = night * 3.2; bulb.material.emissiveIntensity = night * 1.5;
        coldLight.intensity = night * 2.6; laptopScreen.material.emissiveIntensity = night * 2.2;
        // Scene swaps on the clock: smoko props, then the drive home at dusk.
        const smokoAmt = smooth(10.4, 10.55, h) * (1 - smooth(11.25, 11.4, h));
        cur.smoko = damp(cur.smoko, smokoAmt, 8, dt); smoko.scale.setScalar(Math.max(0.001, cur.smoko));
        const homeAmt = nice ? smooth(17.9, 18.5, h) : smooth(18.8, 19.4, h);
        cur.home = damp(cur.home, homeAmt, 6, dt);
        job.scale.setScalar(Math.max(0.001, 1 - cur.home)); home.scale.setScalar(Math.max(0.001, cur.home));
        // The ute leaves for home and arrives at the other end.
        const leave = nice ? 17.55 : 18.45, arrive = nice ? 18.6 : 19.5;
        const drive = smooth(leave, leave + 0.25, h) * (1 - smooth(arrive - 0.25, arrive, h));
        const parkedHome = smooth(arrive - 0.25, arrive, h);
        ute.position.set(UX, 0, UZ + drive * 8 + parkedHome * 0.0);
        ute.visible = drive < 0.98 || parkedHome > 0.02;
        ute.rotation.y = Math.PI / 2 + Math.PI * smooth(leave, leave + 0.25, h) * (1 - parkedHome) ;
        if (drive > 0.02 && drive < 0.98) wheels.forEach((w) => (w.rotation.y += dt * 12));
        trayPhone.visible = ring.visible = cur.home < 0.5;
        // Tiles.
        const prog = progressAt(h), nOn = prog * tiles.length;
        tiles.forEach((t, i) => { const want = i < nOn ? 1 : 0.001; t.scale.setScalar(damp(t.scale.x, want, 10, dt)); });
        // People follow their schedules.
        people.forEach(({ p, keys }) => {
          const s = place(keys, h);
          p.g.position.x = s.pos.x; p.g.position.z = s.pos.z; p.g.userData.baseY = s.pos.y;
          let dr = s.rot - p.g.rotation.y; dr = Math.atan2(Math.sin(dr), Math.cos(dr)); p.g.rotation.y += dr * (1 - Math.exp(-8 * dt));
          p.setPose(s.pose === 'walk' ? 'stand' : s.pose);
          p.setWalk(s.speed, !nice && p === roofer && s.speed > 0 ? 1 : 0);
          p.g.visible = s.pos.y > -2.5;
          p.tick(now, dt);
        });
        // The tray phone rings on the moments, and keeps ringing all day without DUSA.
        const since = (now - pingAt) / 1000;
        const ringing = !nice && (Math.sin(h * 9) > 0.55) ? Math.sin(now / 160) * 0.5 + 0.5 : 0;
        const pulse = Math.max(ringing, since < 1.4 ? 1 - since / 1.4 : 0);
        ring.material.opacity = pulse * 0.9; ring.scale.setScalar(1 + (1 - pulse) * 0.6); ringLight.intensity = pulse * 1.6;
        // The island breathes.
        isle.position.y = Math.sin(now / 2600) * 0.06; isle.rotation.y = 0.35 + Math.sin(now / 5200) * 0.015;
        // Camera: isometric, sitting low in the frame so the phone up top covers nothing that matters.
        const rx = (x: number, z: number) => x * Math.cos(0.35) + z * Math.sin(0.35), rz = (x: number, z: number) => -x * Math.sin(0.35) + z * Math.cos(0.35);
        const hx = HX + 3.4, hz = HZ + 1.2;
        const cx = THREE.MathUtils.lerp(0, rx(hx, hz), cur.home), cz = THREE.MathUtils.lerp(0, rz(hx, hz), cur.home);
        camera.position.set(cx + 14, 12.5, cz + 14); camera.lookAt(cx, 1.1 - cur.home * 0.5, cz); camera.zoom = 1 + cur.home * 0.22; camera.updateProjectionMatrix();
        renderer.render(scene, camera);
      };
      return { frame, resize, start: () => { running = true; }, stop: () => { running = false; }, get running() { return running; } };
    };

    const worlds = [makeWorld(false, canvases.off), makeWorld(true, canvases.on)];
    window.addEventListener('resize', () => worlds.forEach((w) => w.resize()));

    /* ── UI per beat: the line under the island, the banner, the timeline ── */
    const showBeat = (b: number) => {
      if (b === beat) return;
      beat = b;
      stage.setAttribute('data-beat', String(beat));
      times.forEach((t, i) => { t.classList.toggle('is-on', i === beat); t.setAttribute('aria-selected', i === beat ? 'true' : 'false'); });
      lines.forEach((l, i) => { if (i === beat) l.removeAttribute('hidden'); else l.setAttribute('hidden', ''); });
      banner(beat);
      if (beat < N - 1) clearEnd();
    };
    times.forEach((t, i) => t.addEventListener('click', () => { hour = MARKS[i] + 0.001; }));
    stage.addEventListener('mouseenter', () => { paused = true; });
    stage.addEventListener('mouseleave', () => { paused = false; });
    document.addEventListener('visibilitychange', () => { paused = document.hidden; });

    /* ── The loop ── */
    let lastT = 0;
    const loop = (now: number) => {
      if (!playing) return;
      const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016); lastT = now;
      if (!paused && !reduced) { hour += dt * 1000 / LOOP_MS * (DAY1 - DAY0); if (hour >= DAY1) hour = DAY0; }
      const b = beatOf(hour);
      showBeat(b);
      const next = b < N - 1 ? MARKS[b + 1] : DAY1;
      bars.forEach((bar, i) => { bar.style.transition = 'none'; bar.style.width = i < b ? '100%' : i === b ? `${clamp01((hour - MARKS[b]) / (next - MARKS[b])) * 100}%` : '0'; });
      if (hour >= 21.0 && beat === N - 1) endBanner();
      worlds.forEach((w) => w.frame(now, hour, dt, b));
      requestAnimationFrame(loop);
    };
    const start = () => {
      if (!started) { started = true; setWorld('off'); }
      if (playing) return; playing = true; lastT = performance.now(); worlds.forEach((w) => w.resize()); requestAnimationFrame(loop);
    };
    const stop = () => { playing = false; };
    worlds.forEach((w) => w.resize());
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.2 }).observe(stage);
      // Deep in the stage, the site steps aside: the nav fades so the banners read as the phone's.
      new IntersectionObserver((entries) => entries.forEach((e) => document.documentElement.classList.toggle('ww-immersed', e.isIntersecting)), { threshold: 0.72 }).observe(stage);
    } else start();
  });
