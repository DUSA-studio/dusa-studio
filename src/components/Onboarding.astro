---
// Onboarding.astro — Visual onboarding journey timeline
interface Props {
  t?: Record<string, any>;
  region?: string;
}
const { t = {}, region = '' } = Astro.props;

const s = t?.onboarding?.component || {};
const c = t?.common || {};
const obCtaBookDemo = s.ctaBookDemo || c.bookFreeDemo || 'Book Your Free Demo';
const obCtaLearnMore = s.ctaLearnMore || 'Learn more about onboarding';
const regionPrefix = region ? `/${region}` : '';
const obEyebrow = s.eyebrow || 'Your Onboarding Journey';
const obTitle = s.title || 'From sign-up to';
const obTitleAccent = s.titleAccent || 'launch';
const obTitleEnd = s.titleEnd || 'in two weeks.';
const obSub = s.sub || 'You do not need to figure it out alone. We handle the setup, migration, and training so you can focus on running your business.';
const obSupportAiTitle = s.supportAiTitle || 'AI Support';
const obSupportAiDesc = s.supportAiDesc || 'Available on all plans, 24/7.';
const obSupportManagerTitle = s.supportManagerTitle || 'Dedicated Account Manager';
const obSupportManagerDesc = s.supportManagerDesc || 'For Growth and Bespoke plan members.';

const steps = [
  {
    num: '01',
    title: s.step1Title || 'Book Your Demo',
    desc: s.step1Desc || 'A quick 15-minute call to understand your business. We learn what you need, show you the platform, and answer every question.',
    time: s.step1Time || '15 min',
  },
  {
    num: '02',
    title: s.step2Title || 'Onboarding Setup',
    desc: s.step2Desc || 'We configure your DUSA workspace. CRM, automations, email templates, funnels, and integrations, all set up for you within the first week.',
    time: s.step2Time || 'Week 1',
  },
  {
    num: '03',
    title: s.step3Title || 'Migration and Training',
    desc: s.step3Desc || 'We move your contacts, campaigns, and data from your old tools. Then walk your team through everything so you are confident from day one.',
    time: s.step3Time || 'Week 2',
  },
  {
    num: '04',
    title: s.step4Title || 'Launch and Grow',
    desc: s.step4Desc || 'You are live. AI support is always available, and our team checks in to make sure everything is running smoothly. Time to grow.',
    time: s.step4Time || 'Ongoing',
  },
];
---

<section class="onboarding section--dark" id="onboarding">
  <div class="container">
    <p class="onboarding__eyebrow">{obEyebrow}</p>
    <h2 class="onboarding__title">
      {obTitle} <span class="text--aqua">{obTitleAccent}</span> {obTitleEnd}
    </h2>
    <p class="onboarding__sub">
      {obSub}
    </p>

    <div class="onboarding__timeline">
      {steps.map((step, i) => (
        <div class="onboarding__step">
          <div class="onboarding__step-marker">
            <span class="onboarding__step-num">{step.num}</span>
            {i < steps.length - 1 && <div class="onboarding__step-line" />}
          </div>
          <div class="onboarding__step-content">
            <div class="onboarding__step-header">
              <h3 class="onboarding__step-title">{step.title}</h3>
              <span class="onboarding__step-time">{step.time}</span>
            </div>
            <p class="onboarding__step-desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="onboarding__support">
      <div class="onboarding__support-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
        <div>
          <strong>{obSupportAiTitle}</strong>
          <span>{obSupportAiDesc}</span>
        </div>
      </div>
      <div class="onboarding__support-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
        </svg>
        <div>
          <strong>{obSupportManagerTitle}</strong>
          <span>{obSupportManagerDesc}</span>
        </div>
      </div>
    </div>

    <div class="onboarding__cta">
      <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--primary">{obCtaBookDemo}</a>
      <a href={`${regionPrefix}/onboarding`} class="onboarding__learn-more">{obCtaLearnMore} →</a>
    </div>
  </div>
</section>

<style>
  .onboarding {
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(247, 244, 239, 0.04);
  }

  .onboarding__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--reef-aqua);
    text-align: center;
    margin-bottom: var(--space-xs);
  }

  .onboarding__title {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .onboarding__sub {
    max-width: 560px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.6);
  }

  /* ─── Timeline ─── */
  .onboarding__timeline {
    max-width: 640px;
    margin: 0 auto var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .onboarding__step {
    display: flex;
    gap: var(--space-md);
    position: relative;
  }

  .onboarding__step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 48px;
  }

  .onboarding__step-num {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(78, 216, 194, 0.3);
    background: rgba(78, 216, 194, 0.06);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--reef-aqua);
  }

  .onboarding__step-line {
    width: 1px;
    flex: 1;
    min-height: 24px;
    background: linear-gradient(180deg, rgba(78, 216, 194, 0.25), rgba(78, 216, 194, 0.05));
  }

  .onboarding__step-content {
    padding-bottom: var(--space-lg);
    padding-top: 0.5rem;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .onboarding__step-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: 0.375rem;
  }

  .onboarding__step-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--warm-white);
  }

  .onboarding__step-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--reef-aqua);
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: 100px;
    padding: 0.15em 0.65em;
  }

  .onboarding__step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    max-width: 480px;
  }

  /* ─── Support Badges ─── */
  .onboarding__support {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .onboarding__support-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-md, 8px);
  }

  .onboarding__support-item svg {
    color: var(--reef-aqua);
    flex-shrink: 0;
  }

  .onboarding__support-item strong {
    display: block;
    font-size: 0.875rem;
    color: var(--warm-white);
    font-weight: 600;
  }

  .onboarding__support-item span {
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.45);
  }

  /* ─── CTA ─── */
  .onboarding__cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .onboarding__learn-more {
    font-size: 0.9375rem;
    color: var(--reef-aqua);
    opacity: 0.75;
    transition: opacity var(--duration-fast);
    padding: 0.75rem 0;
    display: inline-block;
    min-height: 44px;
  }

  .onboarding__learn-more:hover {
    opacity: 1;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .onboarding {
      padding: var(--space-xl) 0;
    }

    .onboarding__support {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .onboarding {
      padding: var(--space-lg) 0;
    }

    .onboarding__step-marker {
      width: 40px;
    }

    .onboarding__step-num {
      width: 40px;
      height: 40px;
      font-size: 0.75rem;
    }

    .onboarding__step-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }

  /* ─── Light Mode ─── */
  :global(html[data-theme="light"]) .onboarding__title,
  :global(html[data-theme="light"]) .onboarding__step-title,
  :global(html[data-theme="light"]) .onboarding__support-item strong {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .onboarding__sub,
  :global(html[data-theme="light"]) .onboarding__step-desc {
    color: rgba(12, 14, 20, 0.6);
  }

  :global(html[data-theme="light"]) .onboarding__support-item {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.06);
  }

  :global(html[data-theme="light"]) .onboarding__support-item span {
    color: rgba(12, 14, 20, 0.5);
  }

  :global(html[data-theme="light"]) .onboarding {
    border-top-color: rgba(12, 14, 20, 0.06);
  }

  :global(html[data-theme="light"]) .onboarding__eyebrow {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .onboarding__step-num {
    color: var(--deep-ocean);
    border-color: rgba(26, 58, 92, 0.2);
    background: rgba(26, 58, 92, 0.06);
  }

  :global(html[data-theme="light"]) .onboarding__step-line {
    background: linear-gradient(180deg, rgba(26, 58, 92, 0.3), rgba(26, 58, 92, 0.05));
  }

  :global(html[data-theme="light"]) .onboarding__step-time {
    color: var(--deep-ocean);
    background: rgba(26, 58, 92, 0.06);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .onboarding__support-item svg {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .onboarding__learn-more {
    color: var(--deep-ocean);
  }
</style>
