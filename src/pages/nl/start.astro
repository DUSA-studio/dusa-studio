---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StartPage from '../../components/pages/StartPage.astro';
import { getRegion } from '../../i18n/regions.js';
import t from '../../i18n/translations/nl.json';
const region = getRegion('nl');
---

<BaseLayout t={t} title={t.start.metaTitle} description={t.start.metaDesc} lang={region.htmlLang} ogLocale={region.ogLocale} region="nl">
  <StartPage t={t} regionKey="nl" />
</BaseLayout>
