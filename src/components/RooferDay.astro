      o.position.set(x, y, z); o.castShadow = true; o.receiveShadow = true; return o;
    };
    const cap = (r: number, len: number, m: THREE.Material) => { const o = new THREE.Mesh(new THREE.CapsuleGeometry(r, len, 6, 12), m); o.castShadow = true; o.receiveShadow = true; return o; };

    /* Two palettes: the brand on the DUSA side, the same scene gone bland on the other. */
    const PAL = {
      on:  { grass: 0x49b39a, grassTop: 0x5cc9ad, soil: 0x1a3a5c, road: 0x4a5d75, dash: 0xf7f4ef, drive: 0x9fbfd6, wall: 0xf7f4ef, roof: 0x1a3a5c, frame: 0x1a3a5c, door: 0x4ed8c2, ute: 0x6aaacf, uteDark: 0x1a3a5c, tree: 0x2f8f7c, treeTrunk: 0x6b4a36, vest: 0x4ed8c2, hat: 0xf7f4ef, shirt: 0x1a3a5c, home: 0xf7f4ef, homeRoof: 0x1a3a5c, deck: 0xd9b48a, esky: 0x1a3a5c, flower: [0x4ed8c2, 0xf7f4ef, 0x6aaacf] },
      off: { grass: 0x8e9a8a, grassTop: 0x9aa697, soil: 0x5e5752, road: 0x5b5f66, dash: 0xc9c5bd, drive: 0x8d9299, wall: 0xd9d4ca, roof: 0x5b6572, frame: 0x6b7280, door: 0x6b7280, ute: 0x6e7784, uteDark: 0x3c424c, tree: 0x6f8a78, treeTrunk: 0x6b5a4c, vest: 0xb8a46a, hat: 0xb9b4a8, shirt: 0x7d8490, home: 0xcfc8ba, homeRoof: 0x6b6f78, deck: 0xa8927a, esky: 0x6b7280, flower: [0xb9b4a8, 0xa8927a, 0x9aa697] },
    };

    /* A person: capsule body, round head, hard hat, limbs that pose and walk. */
    type Pose = 'stand' | 'hammer' | 'phone' | 'sit' | 'sitMug' | 'laptop' | 'carry' | 'walk';
    const makePerson = (shirt: number, vestC: number, hatC: number, skin = 0xd9a98a, hat = true, scale = 1) => {
      const g = new THREE.Group();
      const shirtM = mat(shirt), vestM = mat(vestC), skinM = mat(skin), pantsM = mat(0x3b4555), hatM = mat(hatC);
      const body = cap(0.21, 0.36, shirtM); body.position.y = 0.86; g.add(body);
      const vest = rbox(0.34, 0.3, 0.26, vestM, 0.06, 0, 0.84, 0.03); vest.scale.set(1, 1, 0.75); g.add(vest);
      const head = sph(0.17, skinM, 0, 1.3, 0); g.add(head);
      const top = new THREE.Group(); top.position.y = 1.3; g.add(top);
      if (hat) { const dome = new THREE.Mesh(new THREE.SphereGeometry(0.2, 24, 12, 0, Math.PI * 2, 0, Math.PI / 2), hatM); dome.position.y = 0.03; dome.castShadow = true; top.add(dome, cyl(0.25, 0.25, 0.04, hatM, 0, 0.03, 0)); }
      else { const hair = new THREE.Mesh(new THREE.SphereGeometry(0.18, 24, 12, 0, Math.PI * 2, 0, Math.PI / 2.1), mat(0x4a3326)); hair.position.y = 0.01; top.add(hair); }
      const arm = (side: number) => { const p = new THREE.Group(); p.position.set(side * 0.26, 1.0, 0); const a = cap(0.065, 0.34, shirtM); a.position.y = -0.22; p.add(a); p.add(sph(0.07, skinM, 0, -0.44, 0)); g.add(p); return p; };
      const leg = (side: number) => { const p = new THREE.Group(); p.position.set(side * 0.11, 0.56, 0); const l = cap(0.085, 0.34, pantsM); l.position.y = -0.24; p.add(l); p.add(rbox(0.17, 0.1, 0.26, mat(0x2a2522), 0.04, 0, -0.5, 0.04)); g.add(p); return p; };
      const armL = arm(-1), armR = arm(1), legL = leg(-1), legR = leg(1);
      const held = new THREE.Group(); held.position.set(0, -0.44, 0); armR.add(held);
      const mug = cyl(0.06, 0.05, 0.1, mat(0xf7f4ef), 0, 0, 0.02); mug.visible = false; held.add(mug);
      const phone = rbox(0.09, 0.17, 0.02, mat(0x14161c, { roughness: 0.4, metalness: 0.5 }), 0.01, 0, 0.02, 0.05); phone.visible = false; held.add(phone);
      const phoneGlow = new THREE.PointLight(0xffffff, 0, 1.2); phoneGlow.position.set(0, 0.05, 0.12); phone.add(phoneGlow);
      g.scale.setScalar(scale);
      const T = { armL: V(), armR: V(), legL: V(), legR: V(), bodyY: 0, mug: false, phone: false };
      let pose: Pose = 'stand', walkSpeed = 0, rush = 0;
      const setPose = (p: Pose) => {
        pose = p; T.mug = p === 'sitMug'; T.phone = p === 'phone'; T.bodyY = 0;
        T.armL.set(0.15, 0, 0.25); T.armR.set(-0.15, 0, -0.25); T.legL.set(0, 0, 0.05); T.legR.set(0, 0, -0.05);
        if (p === 'phone') { T.armR.set(-2.5, 0.2, -0.9); T.armL.set(0.3, 0, 0.3); }
        if (p === 'sit' || p === 'sitMug' || p === 'laptop') { T.bodyY = -0.12; T.legL.set(-1.25, 0, 0.12); T.legR.set(-1.25, 0, -0.12); T.armL.set(-0.9, 0, 0.3); T.armR.set(-0.9, 0, -0.3); }
        if (p === 'sitMug') T.armR.set(-1.6, 0.3, -0.5);
        if (p === 'laptop') { T.armL.set(-1.3, 0, 0.1); T.armR.set(-1.3, 0, -0.1); }
        if (p === 'carry') { T.armL.set(-1.2, 0, 0.1); T.armR.set(-1.2, 0, -0.1); }
      };
      const setWalk = (speed: number, r: number) => { walkSpeed = speed; rush = r; };
      const tick = (now: number, dt: number) => {
        const k = 7;
        const lr = (grp: THREE.Group, t: THREE.Vector3, sx = 0) => { grp.rotation.x = damp(grp.rotation.x, t.x + sx, k, dt); grp.rotation.y = damp(grp.rotation.y, t.y, k, dt); grp.rotation.z = damp(grp.rotation.z, t.z, k, dt); };
        const sw = walkSpeed > 0.01 ? Math.sin(now / (rush ? 70 : 110)) * (0.55 + rush * 0.3) : 0;
        const hammer = pose === 'hammer' ? -0.9 + Math.sin(now / 150) * 0.8 : 0;
