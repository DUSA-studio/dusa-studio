---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingContent from '../../components/PricingContent.astro';
import { getRegion, convertPrice } from '../../i18n/regions.js';
import t from '../../i18n/translations/nl.json';

const region = getRegion('nl');
const prices = {
  launchpad: convertPrice(47, 'nl'),
  starter: convertPrice(149, 'nl'),
  growth: convertPrice(297, 'nl'),
};
---
<BaseLayout
  title={t.pricing.metaTitle}
  description={t.pricing.metaDescription}
  lang={region.htmlLang}
  ogLocale={region.ogLocale}
  t={t}
>
  <PricingContent region={region} t={t} prices={prices} regionKey="nl" />
</BaseLayout>
