  html[data-theme="light"] .pricing-card__badge--entry:hover { background: var(--deep-ocean); color: var(--warm-white); border-color: var(--deep-ocean); box-shadow: 0 0 24px rgba(26, 58, 92, 0.5), 0 0 60px rgba(26, 58, 92, 0.15); transform: translateX(-50%) translateY(-2px) scale(1.05); }
