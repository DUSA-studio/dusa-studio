---
// FunnelGlass.astro — "Where does your money actually go?"
// v2 (Nov 2026): a Higgsfield-rendered film replaces the SVG funnel. Eight
// cracked glass tools leak money and fail to connect, then fuse into one
// glowing DUSA cube. The captions under the film follow its timeline:
// the stack cost while the tools leak, the DUSA cost once they fuse.
// The film is muted, looped, lazy-started when on screen, and falls back to
// the final still under prefers-reduced-motion.
import { DUSA_COST, STACK_TOTAL, SAVING, money } from '../config/stack-compare';

interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.funnelComparison || {};
const fcLabel = s.label || 'The real cost of scattered tools';
const fcHeading = s.heading || 'Where does your';
const fcHeadingAccent = s.headingAccent || 'money actually go?';
const fill = (str: string) => String(str)
  .replace('{total}', money(STACK_TOTAL)).replace('{dusa}', money(DUSA_COST)).replace('{saving}', money(SAVING));
const v1Title = fill(s.verdict1Title || '{total} in. A trickle out.');
const v1Sub = fill(s.verdict1Sub || 'Eight tools, eight logins, none of them connected. The work jams before it reaches you.');
const v2Title = fill(s.verdict2Title || '{dusa} in. All of it out.');
const v2Sub = fill(s.verdict2Sub || 'One connected platform, and the other {saving} a month stays yours.');
const tabTools = s.tabTools || 'Eight tools';
const tabPlatform = s.tabPlatform || 'One platform';
const perMonth = s.perMonth || '/mo';
---

<section class="funnel section section--dark" id="funnel">
  <div class="container">
    <div class="funnel__header reveal">
      <span class="label">{fcLabel}</span>
      <h2>{fcHeading}<br/><span class="gradient-text">{fcHeadingAccent}</span></h2>
    </div>

    <figure class="cf reveal" data-cost-film>
      <div class="cf__frame">
        <video class="cf__video" muted playsinline loop preload="none"
          poster="/media/cost-film-start.webp" aria-hidden="true">
          <source src="/media/cost-film-sm.mp4" type="video/mp4" media="(max-width: 640px)" />
          <source src="/media/cost-film.mp4" type="video/mp4" />
        </video>
        <img class="cf__still" src="/media/cost-film-end.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <div class="cf__shade" aria-hidden="true"></div>

        <figcaption class="cf__caption" aria-live="polite">
          <div class="cf__verdict cf__verdict--tools is-on">
            <strong>{v1Title}</strong>
            <span>{v1Sub}</span>
          </div>
          <div class="cf__verdict cf__verdict--dusa">
            <strong>{v2Title}</strong>
            <span>{v2Sub}</span>
          </div>
        </figcaption>
      </div>

      <div class="cf__compare" role="group" aria-label={`${tabTools} vs ${tabPlatform}`}>
        <div class="cf__pill cf__pill--tools is-on">
          <i aria-hidden="true"></i>
          <span class="cf__pill-name">{tabTools}</span>
          <b>{money(STACK_TOTAL)}<small>{perMonth}</small></b>
        </div>
        <div class="cf__progress" aria-hidden="true"><span></span></div>
        <div class="cf__pill cf__pill--dusa">
          <i aria-hidden="true"></i>
          <span class="cf__pill-name">{tabPlatform}</span>
          <b>{money(DUSA_COST)}<small>{perMonth}</small></b>
        </div>
      </div>
    </figure>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-cost-film]');
    if (!root) return;
    const video = root.querySelector('video') as HTMLVideoElement;
    const tools = root.querySelectorAll('.cf__verdict--tools, .cf__pill--tools');
    const dusa = root.querySelectorAll('.cf__verdict--dusa, .cf__pill--dusa');
    const bar = root.querySelector('.cf__progress span') as HTMLElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SWITCH = 0.48; // share of the film where the tools start fusing

    const show = (isDusa: boolean) => {
      tools.forEach((el) => el.classList.toggle('is-on', !isDusa));
      dusa.forEach((el) => el.classList.toggle('is-on', isDusa));
    };

    if (reduced || !video) {
      root.classList.add('is-still');
      show(true);
      if (bar) bar.style.transform = 'scaleX(1)';
      return;
    }

    let raf = 0;
    const tick = () => {
      const d = video.duration || 8;
      const p = Math.min(1, video.currentTime / d);
      if (bar) bar.style.transform = `scaleX(${p.toFixed(3)})`;
      show(p >= SWITCH);
      raf = requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          if (video.preload !== 'auto') { video.preload = 'auto'; video.load(); }
          video.play().catch(() => {});
          cancelAnimationFrame(raf); raf = requestAnimationFrame(tick);
        } else {
          video.pause(); cancelAnimationFrame(raf);
        }
      });
    }, { threshold: 0.35 });
    io.observe(root);
  })();
</script>

<style>
  .funnel__header { text-align: center; margin-bottom: var(--space-lg); }
  .funnel__header h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.05; margin-top: 0.7rem; }

  .cf { margin: 0 auto; max-width: 1080px; }
  .cf__frame {
    position: relative; overflow: hidden; border-radius: 30px; aspect-ratio: 16 / 9; background: #0b1420;
    border: 1px solid rgba(247, 244, 239, 0.12);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.12), 0 50px 120px -40px rgba(0, 0, 0, 0.75), 0 0 140px -30px rgba(78, 216, 194, 0.25);
  }
  .cf__video, .cf__still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .cf__still { opacity: 0; }
  .cf.is-still .cf__still { opacity: 1; }
  .cf.is-still .cf__video { display: none; }
  .cf__shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(7, 12, 20, 0) 45%, rgba(7, 12, 20, 0.55) 72%, rgba(7, 12, 20, 0.88) 100%); }

  .cf__caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 6% 5.5%; display: grid; text-align: center; }
  .cf__verdict { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 0.4rem; align-items: center; opacity: 0; transform: translateY(10px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .cf__verdict.is-on { opacity: 1; transform: none; }
  .cf__verdict strong { font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.15rem, 2.6vw, 2rem); letter-spacing: 0.02em; }
  .cf__verdict span { max-width: 560px; font-size: clamp(0.85rem, 1.4vw, 1.02rem); line-height: 1.5; color: rgba(247, 244, 239, 0.78); }
  .cf__verdict--tools strong { color: #ff9b73; text-shadow: 0 0 24px rgba(255, 120, 80, 0.35); }
  .cf__verdict--dusa strong { color: #4ED8C2; text-shadow: 0 0 24px rgba(78, 216, 194, 0.45); }

  .cf__compare { display: flex; align-items: center; justify-content: center; gap: 0.9rem; margin-top: 1.1rem; flex-wrap: wrap; }
  .cf__pill {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.6rem 1rem 0.6rem 0.85rem; border-radius: 999px;
    border: 1px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(140deg, rgba(247, 244, 239, 0.08), rgba(247, 244, 239, 0.02));
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    opacity: 0.55; transition: opacity 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .cf__pill.is-on { opacity: 1; }
  .cf__pill i { width: 8px; height: 8px; border-radius: 50%; }
  .cf__pill--tools i { background: #ff9b73; }
  .cf__pill--dusa i { background: #4ED8C2; box-shadow: 0 0 10px #4ED8C2; }
  .cf__pill--tools.is-on { border-color: rgba(255, 155, 115, 0.5); }
  .cf__pill--dusa.is-on { border-color: rgba(78, 216, 194, 0.55); box-shadow: 0 0 24px -6px rgba(78, 216, 194, 0.5); }
  .cf__pill-name { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(247, 244, 239, 0.75); }
  .cf__pill b { font-family: var(--font-headline); font-size: 1.05rem; }
  .cf__pill b small { font-size: 0.72rem; opacity: 0.6; margin-left: 1px; }
  .cf__progress { width: 90px; height: 2px; border-radius: 2px; background: rgba(247, 244, 239, 0.15); overflow: hidden; }
  .cf__progress span { display: block; height: 100%; background: linear-gradient(90deg, #ff9b73, #4ED8C2); transform-origin: left; transform: scaleX(0); }

  :global(html[data-theme="light"]) .cf__frame { border-color: rgba(255, 255, 255, 0.9); box-shadow: 0 0 0 1px rgba(26, 58, 92, 0.1), 0 50px 110px -40px rgba(26, 58, 92, 0.45); }
  :global(html[data-theme="light"]) .cf__pill { border-color: rgba(255, 255, 255, 0.95); background: linear-gradient(140deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.5)); box-shadow: 0 0 0 1px rgba(26, 58, 92, 0.08); }
  :global(html[data-theme="light"]) .cf__pill-name { color: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .cf__pill b { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cf__pill--dusa.is-on { border-color: rgba(26, 58, 92, 0.35); }
  :global(html[data-theme="light"]) .cf__progress { background: rgba(12, 14, 20, 0.12); }

  @media (max-width: 640px) {
    .cf__frame { border-radius: 20px; aspect-ratio: 4 / 5; }
    .cf__video, .cf__still { object-position: 50% 40%; }
    .cf__caption { padding: 0 6% 8%; }
    .cf__progress { display: none; }
  }
</style>
