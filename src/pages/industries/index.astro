---
import BaseLayout from '../../layouts/BaseLayout.astro';
import t from '../../i18n/translations/en.json';

const industries = [
  {
    title: 'Real Estate',
    desc: 'Pipeline management, automated open home follow-ups, and buyer matching for agents who want to close more deals.',
    slug: '/industries/real-estate',
    icon: 'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z',
  },
  {
    title: 'Gyms and Fitness',
    desc: 'Member onboarding, class reminders, win-back campaigns, and referral tracking to reduce churn and fill classes.',
    slug: '/industries/gyms',
    icon: 'M6.5 6.5h11M6 12h12M17.5 17.5h-11M20 21V3M4 21V3',
  },
  {
    title: 'Trades',
    desc: 'Missed call text-back, quote pipelines, job scheduling, and invoice reminders for tradies who are too busy on the tools.',
    slug: '/industries/tradies',
    icon: 'M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z',
  },
  {
    title: 'Restaurants',
    desc: 'Reservation reminders, post-visit review requests, birthday campaigns, and digital loyalty programs.',
    slug: '/industries/restaurants',
    icon: 'M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3',
  },
  {
