---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';

const lang = 'de';
const region = 'de';

const title = 'Marketing-Automatisierung für E-Commerce | DUSA.studio';
const description = 'Verlassene Warenkörbe zurückgewinnen, Post-Purchase-Engagement automatisieren und VIP-Treueprogramme aufbauen. DUSA ist die All-in-One-Wachstumsplattform für E-Commerce-Marken.';

const painPoints = [
  {
    icon: '🛒',
    title: 'Verlassene Warenkörbe ohne Follow-up',
    desc: 'Eine einzelne Wiederherstellungs-E-Mail reicht nicht aus. Die meisten Plattformen hören dort auf und lassen Tausende Euro an Umsatz in verlassenen Warenkörben liegen.',
  },
  {
    icon: '📦',
    title: 'Kein Post-Purchase-Engagement',
    desc: 'Der Kauf passiert und dann Stille. Keine Danke-Sequenz, kein Cross-Selling, keine Bewertungsanfrage. Sie lassen Folgeeinnahmen auf dem Tisch liegen.',
  },
  {
    icon: '👑',
    title: 'Keine VIP-Segmentierung',
    desc: 'Ihre besten Kunden bekommen die gleiche Erfahrung wie alle anderen. Keine Anerkennung, keine exklusiven Angebote, kein Grund, treu zu bleiben.',
  },
  {
    icon: '🔄',
    title: 'Niedrige Wiederkaufrate',
    desc: 'Einen neuen Kunden zu gewinnen kostet fünfmal mehr als einen bestehenden zu halten. Ohne Re-Engagement-Flows kommen die meisten Käufer nie zurück.',
  },
];

const features = [
  {
    title: 'Warenkorbabbruch-Wiederherstellung',
    desc: 'Mehrstufige Wiederherstellungssequenzen über E-Mail und SMS. Zeitgesteuerte Erinnerungen, Rabattanreize und Dringlichkeitsauslöser, die Käufer zurückbringen.',
  },
  {
    title: 'Post-Purchase-Sequenzen',
    desc: 'Danke-E-Mails, Versandupdates, Nutzungstipps und Zufriedenheitschecks. Halten Sie das Gespräch nach dem Kauf am Laufen.',
  },
  {
    title: 'Automatische Bewertungsanfragen',
    desc: 'Fordern Sie Bewertungen automatisch zum perfekten Zeitpunkt an, nach der Lieferung und bevor die Begeisterung nachlässt. Bauen Sie Social Proof auf Autopilot auf.',
  },
  {
    title: 'Cross-Selling und Upselling',
    desc: 'Empfehlen Sie ergänzende Produkte basierend auf der Kaufhistorie. Lösen Sie Upsell-Angebote aus, wenn Kunden bestimmte Ausgabenschwellen erreichen.',
  },
  {
    title: 'VIP-Stufenverwaltung',
    desc: 'Segmentieren Sie Kunden nach Lebenszeitwert. Schalten Sie exklusive Vorteile, frühzeitigen Zugang und personalisierte Angebote für Ihre Top-Kunden frei.',
  },
  {
    title: 'Geburtstagsprämien',
    desc: 'Automatische Geburtstagsnachrichten mit exklusiven Rabattcodes. Eine kleine Geste, die Treue und Wiederkäufe fördert.',
  },
];

const pipeline = [
  { stage: 'Erster Kauf', desc: 'Kunde schließt seine erste Bestellung ab' },
  { stage: 'Wiederkäufer', desc: 'Zweiter Kauf innerhalb von 90 Tagen' },
  { stage: 'Treuer Kunde', desc: 'Drei oder mehr Bestellungen, engagiert mit E-Mails' },
  { stage: 'VIP', desc: 'Top 10% nach Gesamtausgaben, exklusive Vorteile freigeschaltet' },
  { stage: 'Markenbotschafter', desc: 'Schreibt Bewertungen, empfiehlt Freunden, teilt in sozialen Medien' },
  { stage: 'Ruckgewinnung', desc: 'Ein fruherer Kaufer ist inaktiv geworden. DUSA lost eine personalisierte Reaktivierungskampagne mit massgeschneiderten Produktempfehlungen aus.' },
];

const stats = [
  { value: '69%', label: 'durchschnittliche Warenkorbabbruchrate im gesamten E-Commerce' },
  { value: '5x', label: 'günstiger, einen bestehenden Kunden zu halten als einen neuen zu gewinnen' },
  { value: '306%', label: 'höherer Lebenszeitwert bei Kunden, die einem VIP-Programm beitreten' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://dusa.studio/de/' },
    { '@type': 'ListItem', position: 2, name: 'Branchen', item: 'https://dusa.studio/de/industries' },
    { '@type': 'ListItem', position: 3, name: 'E-Commerce', item: 'https://dusa.studio/de/industries/ecommerce' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="ec-hero section section--dark">
    <div class="container">
      <div class="ec-hero__content">
        <span class="label">E-Commerce</span>
        <h1><span class="gradient-text">Marketing-Automatisierung</span> für E-Commerce-Marken</h1>
        <p class="ec-hero__sub">
          Verlassene Warenkörbe zurückgewinnen, Post-Purchase-Beziehungen pflegen und Einmalkäufer in lebenslange Markenbotschafter verwandeln.
        </p>
        <div class="ec-hero__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ec-pain section section--dark">
    <div class="container">
      <div class="ec-pain__header">
        <span class="label">Das Problem</span>
        <h2>Sie verlieren Umsatz <span class="gradient-text">nach dem Klick</span></h2>
        <p class="ec-pain__intro">Die meisten E-Commerce-Marken konzentrieren sich auf Traffic und ignorieren alles, was nach dem ersten Besuch passiert. Das kostet Sie bares Geld.</p>
      </div>
      <div class="ec-pain__grid">
        {painPoints.map((point) => (
          <div class="ec-pain__card">
            <span class="ec-pain__icon">{point.icon}</span>
            <h3 class="ec-pain__card-title">{point.title}</h3>
            <p class="ec-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ec-solution section section--dark">
    <div class="container">
      <div class="ec-solution__header">
        <span class="label">Die Lösung</span>
        <h2>So funktioniert DUSA für <span class="gradient-text">E-Commerce</span></h2>
        <p class="ec-solution__intro">Automatisierte Flows, die Besucher zu Käufern, Käufer zu Stammkunden und Stammkunden zu Markenbotschaftern machen.</p>
      </div>
      <div class="ec-solution__grid">
        {features.map((feature) => (
          <div class="ec-solution__card">
            <h3 class="ec-solution__card-title">{feature.title}</h3>
            <p class="ec-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ec-pipeline section section--dark">
    <div class="container">
      <div class="ec-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Ihre <span class="gradient-text">Customer Journey</span> auf einen Blick</h2>
      </div>
      <div class="ec-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="ec-pipeline__stage">
            <div class="ec-pipeline__number">{i + 1}</div>
            <h3 class="ec-pipeline__stage-title">{step.stage}</h3>
            <p class="ec-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ec-stats section section--dark">
    <div class="container">
      <div class="ec-stats__header">
        <span class="label">Wirkung</span>
        <h2>Die Zahlen sprechen für <span class="gradient-text">sich selbst</span></h2>
      </div>
      <div class="ec-stats__grid">
        {stats.map((stat) => (
          <div class="ec-stats__card">
            <span class="ec-stats__value">{stat.value}</span>
            <p class="ec-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ec-cta section section--dark">
    <div class="container">
      <div class="ec-cta__box">
        <h2>Bereit, Ihren <span class="gradient-text">E-Commerce-Umsatz zu steigern</span>?</h2>
        <p class="ec-cta__sub">Starten Sie Ihre Warenkorbwiederherstellung, Post-Purchase-Flows und Ihr VIP-Programm auf einer Plattform.</p>
        <div class="ec-cta__actions">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/blog/marketing-for-ecommerce" class="btn btn--outline">Leitfaden lesen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .ec-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ec-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ec-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .ec-pain {
    padding: var(--space-2xl) 0;
  }
  .ec-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .ec-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .ec-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .ec-solution {
    padding: var(--space-2xl) 0;
  }
  .ec-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .ec-pipeline {
    padding: var(--space-2xl) 0;
  }
  .ec-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .ec-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .ec-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .ec-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .ec-stats {
    padding: var(--space-2xl) 0;
  }
  .ec-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ec-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .ec-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .ec-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .ec-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .ec-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .ec-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .ec-hero__content h1,
  :global(html[data-theme="light"]) .ec-pain__header h2,
  :global(html[data-theme="light"]) .ec-solution__header h2,
  :global(html[data-theme="light"]) .ec-pipeline__header h2,
  :global(html[data-theme="light"]) .ec-stats__header h2,
  :global(html[data-theme="light"]) .ec-cta__box h2,
  :global(html[data-theme="light"]) .ec-pain__card-title,
  :global(html[data-theme="light"]) .ec-solution__card-title,
  :global(html[data-theme="light"]) .ec-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-hero__sub,
  :global(html[data-theme="light"]) .ec-pain__intro,
  :global(html[data-theme="light"]) .ec-solution__intro,
  :global(html[data-theme="light"]) .ec-pain__card-desc,
  :global(html[data-theme="light"]) .ec-solution__card-desc,
  :global(html[data-theme="light"]) .ec-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ec-stats__label,
  :global(html[data-theme="light"]) .ec-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .ec-pain__card,
  :global(html[data-theme="light"]) .ec-solution__card,
  :global(html[data-theme="light"]) .ec-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .ec-pain__card:hover,
  :global(html[data-theme="light"]) .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .ec-stats__card,
  :global(html[data-theme="light"]) .ec-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .ec-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-stats__value {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-cta__actions .btn--outline {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ec-pain__grid {
      grid-template-columns: 1fr;
    }
    .ec-solution__grid {
      grid-template-columns: 1fr;
    }
    .ec-stats__grid {
      grid-template-columns: 1fr;
    }
    .ec-pipeline__stages {
      flex-direction: column;
    }
    .ec-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .ec-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
