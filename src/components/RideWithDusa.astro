---
/**
 * RideWithDusa.astro (v3)
 *
 * The package builder as a short ride, drawn in the same simple style as the
 * SmashX "how it works" journey: a light isometric street (plain boxes, flat
 * low-poly trees, soft shadows), one navy DUSA car with a lit roof sign and the
 * logo on the door, and a phone on the right where you chat with your Growth
 * Lead. It is raining when you are picked up; the weather clears as the ride
 * goes on. Every answer moves the car further down the road, and when you get
 * home your quote is waiting in the chat, priced from the catalogue
 * (src/data/catalogue-au.json).
 *
 * Tap the quick replies or type with the keyboard (typed answers are matched to
 * the closest option). "Skip the small talk" keeps it to the questions only.
 */
import catalogue from '../data/catalogue-au.json';
interface Props { webhook?: string; book?: string; growthLead?: string; phone?: string }
const {
  webhook = '',
  book = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  growthLead = 'https://link.dusa.studio/widget/bookings/dusa-demo',
  phone = '+61 488 825 686',
} = Astro.props;
const CHAPTERS = ['Pick-up', 'About you', 'What you need', 'Your route', 'Home'];
---

<section class="ride section section--dark" data-ride data-webhook={webhook} data-book={book} data-lead={growthLead} data-phone={phone}>
  <div class="container">
    <div class="ride__head">
      <span class="label">Build your engine</span>
      <h2 class="ride__h2">Need a lift? <span class="gradient-text">Hop in.</span></h2>
      <p class="ride__sub">Two minutes with your Growth Lead. Your quote is waiting when you get home.</p>
    </div>

    <div class="ride__stage" data-stage>
      <canvas class="ride__scene" data-scene aria-hidden="true"></canvas>

      <ol class="ride__chapters" data-chapters aria-hidden="true">
        {CHAPTERS.map((c, i) => <li class={i === 0 ? 'is-on' : ''}>{c}</li>)}
      </ol>

      <div class="ride__phone" data-phone-ui>
        <div class="ride__notch" aria-hidden="true"></div>
        <div class="ride__statusbar" aria-hidden="true"><span data-clock>7:42</span><span class="ride__sig"><i></i><i></i><i></i><b></b></span></div>
        <header class="ride__bar">
          <span class="ride__avatar"><img src="/lotus.svg" alt="" width="16" height="16" /></span>
          <span class="ride__bar-who"><b>Your Growth Lead</b><small data-status>Pulling up</small></span>
          <span class="ride__meter" data-meter hidden><small>Your engine</small><b data-meter-val>$0</b></span>
        </header>
        <div class="ride__msgs" data-msgs aria-live="polite"></div>
        <div class="ride__quick" data-quick></div>
        <form class="ride__compose" data-compose>
          <input class="ride__input" data-input type="text" placeholder="Message" autocomplete="off" aria-label="Message your Growth Lead" />
          <button class="ride__send" type="submit" aria-label="Send"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
        </form>
      </div>
    </div>

    <script type="application/json" data-catalogue set:html={JSON.stringify(catalogue)} />
  </div>
</section>

<style>
  .ride { position: relative; }
  .ride__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-lg); }
  .ride__h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.1; margin: 0.6rem 0; color: var(--warm-white); }
  .ride__sub { color: rgba(247, 244, 239, 0.66); margin: 0 auto; }

  .ride__stage { position: relative; max-width: 1180px; margin: 0 auto; aspect-ratio: 16 / 10; border-radius: 28px; overflow: hidden; background: #e9eaec; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35); }
  .ride__scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* Chapter pills, bottom left */
  .ride__chapters { position: absolute; left: 18px; bottom: 18px; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; z-index: 2; }
  :global(.ride__chapters li) { font-size: 0.8rem; font-weight: 500; padding: 6px 12px; border-radius: 100px; background: rgba(255, 255, 255, 0.85); color: #1a3a5c; box-shadow: inset 0 0 0 1px rgba(26, 58, 92, 0.14); transition: background 0.3s, color 0.3s; }
  :global(.ride__chapters li.is-done) { color: rgba(26, 58, 92, 0.5); }
  :global(.ride__chapters li.is-on) { background: #1a3a5c; color: #fff; box-shadow: none; }

  /* The phone */
  .ride__phone { position: absolute; top: 4%; bottom: 4%; right: 3%; aspect-ratio: 9 / 19; max-width: 46%; display: flex; flex-direction: column; border-radius: 46px; border: 9px solid #0b0d12; overflow: hidden; background: linear-gradient(180deg, #1f4472 0%, #12294a 55%, #0c1b33 100%); box-shadow: 0 0 0 1.5px #3a3f4a, 0 30px 60px rgba(12, 26, 50, 0.35); color: #fff; z-index: 3; font-family: -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif; }
  .ride__notch { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 34%; height: 24px; border-radius: 20px; background: #0b0d12; z-index: 2; }
  .ride__statusbar { display: flex; justify-content: space-between; align-items: center; padding: 12px 22px 2px 26px; font-size: 0.72rem; font-weight: 600; }
  .ride__sig { display: inline-flex; align-items: flex-end; gap: 2px; }
  .ride__sig i { width: 3px; background: #fff; border-radius: 1px; }
  .ride__sig i:nth-child(1) { height: 4px; } .ride__sig i:nth-child(2) { height: 6px; } .ride__sig i:nth-child(3) { height: 8px; }
  .ride__sig b { width: 18px; height: 9px; margin-left: 5px; border-radius: 3px; border: 1px solid rgba(255, 255, 255, 0.8); background: linear-gradient(90deg, #fff 70%, transparent 70%); background-clip: content-box; padding: 1px; }
  .ride__bar { display: flex; align-items: center; gap: 0.55rem; padding: 8px 14px 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .ride__avatar { width: 30px; height: 30px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #0f2440; box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.5); }
  .ride__avatar img { filter: invert(78%) sepia(30%) saturate(600%) hue-rotate(115deg); }
  .ride__bar-who b { display: block; font-size: 0.82rem; }
  .ride__bar-who small { display: block; font-size: 0.68rem; color: var(--reef-aqua); }
  .ride__meter { margin-left: auto; text-align: right; line-height: 1.1; }
  .ride__meter[hidden] { display: none; }
  .ride__meter small { display: block; font-size: 0.58rem; color: rgba(255, 255, 255, 0.55); }
  .ride__meter b { font-size: 0.95rem; color: var(--reef-aqua); font-variant-numeric: tabular-nums; }
  .ride__msgs { flex: 1; overflow-y: auto; padding: 12px 10px 6px; display: flex; flex-direction: column; gap: 5px; scroll-behavior: smooth; scrollbar-width: none; }
  .ride__msgs::-webkit-scrollbar { display: none; }
  :global(.ride__msg) { max-width: 84%; padding: 8px 12px; border-radius: 17px; font-size: 0.86rem; line-height: 1.32; animation: rideMsg 0.3s ease; }
  :global(.ride__msg--them) { align-self: flex-start; background: rgba(255, 255, 255, 0.14); border-bottom-left-radius: 5px; }
  :global(.ride__msg--me) { align-self: flex-end; background: #4ed8c2; color: #06231e; border-bottom-right-radius: 5px; }
  :global(.ride__msg--typing) { display: inline-flex; gap: 4px; padding: 11px 13px; }
  :global(.ride__msg--typing i) { width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, 0.6); animation: rideDot 1s infinite; }
  :global(.ride__msg--typing i:nth-child(2)) { animation-delay: 0.15s; }
  :global(.ride__msg--typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes rideDot { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  @keyframes rideMsg { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  :global(.ride__card) { align-self: stretch; padding: 10px 11px; border-radius: 15px; background: rgba(255, 255, 255, 0.1); box-shadow: inset 0 0 0 0.5px rgba(78, 216, 194, 0.5); animation: rideMsg 0.3s ease; }
  :global(.ride__card ol) { margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; counter-reset: c; }
  :global(.ride__card li) { display: grid; grid-template-columns: 20px 1fr; gap: 8px; font-size: 0.82rem; line-height: 1.28; counter-increment: c; }
  :global(.ride__card li::before) { content: counter(c); width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 0.68rem; font-weight: 700; background: var(--reef-aqua); color: #06231e; }
  :global(.ride__card em) { display: block; font-style: normal; font-size: 0.68rem; color: var(--reef-aqua); margin-top: 1px; }
  :global(.ride__fare) { align-self: stretch; padding: 12px 12px 10px; border-radius: 15px; background: #f7f4ef; color: #0c0e14; animation: rideMsg 0.4s ease; }
  :global(.ride__fare h4) { margin: 0; font-size: 0.66rem; letter-spacing: 0.18em; color: #1a3a5c; display: flex; justify-content: space-between; border-bottom: 2px dashed rgba(12, 14, 20, 0.18); padding-bottom: 5px; }
  :global(.ride__fare h4 span) { letter-spacing: 0.04em; font-weight: 500; color: rgba(12, 14, 20, 0.5); }
  :global(.ride__fare p) { margin: 5px 0 7px; font-size: 0.74rem; color: rgba(12, 14, 20, 0.6); }
  :global(.ride__fare ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 0.76rem; }
  :global(.ride__fare li) { display: flex; justify-content: space-between; gap: 8px; }
  :global(.ride__fare li.is-save) { color: #0f6b5c; }
  :global(.ride__fare .t) { display: flex; justify-content: space-between; align-items: baseline; margin-top: 7px; padding-top: 5px; border-top: 2px dashed rgba(12, 14, 20, 0.18); }
  :global(.ride__fare .t b) { font-family: var(--font-headline); font-size: 1.25rem; color: #1a3a5c; }
  :global(.ride__fare .s) { display: flex; justify-content: space-between; font-size: 0.78rem; margin-top: 2px; }
  :global(.ride__fare small) { display: block; margin-top: 7px; font-size: 0.64rem; color: rgba(12, 14, 20, 0.55); }
  :global(.ride__fare small b) { display: block; color: #1a3a5c; margin-top: 2px; }
  .ride__quick { display: flex; flex-wrap: wrap; gap: 5px; padding: 4px 10px; justify-content: flex-end; }
  .ride__quick:empty { display: none; }
  :global(.ride__chip) { appearance: none; border: 0; cursor: pointer; font: inherit; font-size: 0.8rem; color: #fff; padding: 6px 11px; border-radius: 100px; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1px rgba(78, 216, 194, 0.6); transition: background 0.15s, transform 0.12s; animation: rideMsg 0.25s ease backwards; }
  :global(.ride__chip:hover) { background: rgba(78, 216, 194, 0.2); }
  :global(.ride__chip:active) { transform: scale(0.96); }
  :global(.ride__chip.is-on) { background: rgba(78, 216, 194, 0.35); }
  :global(.ride__chip--go) { background: #4ed8c2; color: #06231e; font-weight: 600; box-shadow: none; }
  :global(.ride__chip--ghost) { box-shadow: none; color: rgba(255, 255, 255, 0.7); text-decoration: underline; text-underline-offset: 3px; background: none; }
  :global(.ride__chip em) { font-style: normal; font-size: 0.6rem; font-weight: 700; margin-left: 5px; padding: 1px 6px; border-radius: 100px; background: var(--reef-aqua); color: #06231e; white-space: nowrap; }
  .ride__compose { display: flex; gap: 6px; padding: 6px 10px 16px; }
  .ride__input { flex: 1; min-width: 0; font: inherit; font-size: 0.88rem; color: #fff; padding: 8px 13px; border-radius: 100px; border: 0; outline: none; background: rgba(255, 255, 255, 0.1); box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.3); }
  .ride__input:focus { box-shadow: inset 0 0 0 1.5px var(--reef-aqua); }
  .ride__input::placeholder { color: rgba(255, 255, 255, 0.45); }
  .ride__send { width: 32px; height: 32px; flex: none; align-self: center; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; background: var(--reef-aqua); color: #06231e; }
  .ride__send:focus-visible, :global(.ride__chip:focus-visible) { outline: 2px solid #fff; outline-offset: 2px; }

  @media (max-width: 760px) {
    .ride__stage { aspect-ratio: auto; height: min(100svh, 820px); width: 100vw; margin-left: calc(50% - 50vw); border-radius: 0; }
    .ride__phone { top: 38%; left: 0; right: 0; bottom: 0; max-width: none; aspect-ratio: auto; border: 0; border-radius: 24px 24px 0 0; box-shadow: 0 -10px 40px rgba(12, 26, 50, 0.25); }
    .ride__notch, .ride__statusbar { display: none; }
    .ride__bar { padding-top: 12px; }
    .ride__chapters { top: 12px; bottom: auto; left: 10px; right: 10px; gap: 4px; }
    :global(.ride__chapters li) { font-size: 0.66rem; padding: 4px 8px; }
    .ride__input { font-size: 16px; }
    .ride__compose { padding-right: 74px; padding-bottom: max(14px, env(safe-area-inset-bottom)); }
  }
  :global(html[data-theme="light"]) .ride__h2 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ride__sub { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .ride__stage { box-shadow: 0 30px 70px rgba(12, 14, 20, 0.16); }
</style>

<script>
  import * as T from 'three';
  type Item = { service: string; size: string; incl: string; setup: number; monthly: number; guided: number | null };
  type Cat = { plans: { launchpad: number; starter: number; growth: number }; bundleDiscount: number; setupDiscount: number; items: Record<string, Item> };

  document.querySelectorAll<HTMLElement>('[data-ride]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cat = JSON.parse(root.querySelector('[data-catalogue]')!.textContent || '{}') as Cat;
    const msgs = root.querySelector<HTMLElement>('[data-msgs]')!;
    const quick = root.querySelector<HTMLElement>('[data-quick]')!;
    const form = root.querySelector<HTMLFormElement>('[data-compose]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const meter = root.querySelector<HTMLElement>('[data-meter]')!;
    const meterVal = root.querySelector<HTMLElement>('[data-meter-val]')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapters] li')];
    const phoneUI = root.querySelector<HTMLElement>('[data-phone-ui]')!;
    const PHONE = root.dataset.phone || '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const money = (n: number) => (n < 0 ? '-$' : '$') + Math.abs(Math.round(n)).toLocaleString('en-AU');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 120) : ms));
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
    const chapter = (i: number) => chapters.forEach((c, k) => { c.classList.toggle('is-on', k === i); c.classList.toggle('is-done', k < i); });

    const lead: Record<string, any> = { name: '', business: '', industry: '', industryText: '', needs: [] as string[], seat: '', distance: '', email: '', phone: '', callOk: null, quiet: false };

    /* ══ The words ══ */
    const INDUSTRIES: { id: string; label: string; kw: string[]; plural: string; top: [string, string][] }[] = [
      { id: 'trades', label: 'Trades', kw: ['trade', 'tradie', 'roof', 'plumb', 'electr', 'build', 'carpent', 'landscap', 'paint', 'tile', 'concret', 'construct', 'hvac', 'air con'], plural: 'tradies', top: [['calls', 'More time back'], ['followup', 'More profit'], ['reviews', 'Easier to win work']] },
      { id: 'beauty', label: 'Hair, beauty, spa', kw: ['hair', 'salon', 'beauty', 'spa', 'nail', 'lash', 'brow', 'inject', 'massage', 'barber', 'skin', 'clinic'], plural: 'salons and studios', top: [['comeback', 'More profit'], ['calls', 'More time back'], ['reviews', 'Easier to fill the book']] },
      { id: 'fitness', label: 'Health and fitness', kw: ['gym', 'fitness', 'trainer', ' pt', 'pilates', 'yoga', 'physio', 'chiro', 'health', 'crossfit'], plural: 'gyms and studios', top: [['followup', 'More profit'], ['comeback', 'Members who stay'], ['reviews', 'Easier to grow']] },
      { id: 'hospo', label: 'Café or restaurant', kw: ['cafe', 'café', 'restaurant', 'bar', 'food', 'coffee', 'bakery', 'hospo', 'catering'], plural: 'cafés and restaurants', top: [['reviews', 'More bookings'], ['comeback', 'More profit'], ['socials', 'Less to manage']] },
      { id: 'pro', label: 'Professional services', kw: ['account', 'law', 'legal', 'consult', 'bookkeep', 'agency', 'coach', 'finance', 'broker', 'advis'], plural: 'firms like yours', top: [['followup', 'More profit'], ['calls', 'More time back'], ['google', 'Easier to be found']] },
      { id: 'property', label: 'Real estate', kw: ['real estate', 'property', 'realtor', 'agent', 'rental'], plural: 'agents', top: [['followup', 'More listings'], ['calls', 'More time back'], ['comeback', 'More referrals']] },
      { id: 'retail', label: 'A shop', kw: ['shop', 'store', 'retail', 'ecommerce', 'e-commerce', 'boutique', 'online'], plural: 'shops like yours', top: [['comeback', 'More profit'], ['reviews', 'More trust'], ['socials', 'Less to manage']] },
      { id: 'other', label: 'Something else', kw: [], plural: 'businesses like yours', top: [['calls', 'More time back'], ['followup', 'More profit'], ['reviews', 'Less to manage']] },
    ];
    const NEEDS: Record<string, { text: string; codes: string[]; short: string }> = {
      calls: { text: 'Every call answered, even mid-job', codes: ['AIR'], short: 'Never miss a call' },
      followup: { text: 'Every quote followed up for you', codes: ['FUP'], short: 'Follow up every quote' },
      reviews: { text: '5-star reviews on autopilot', codes: ['REV'], short: 'More 5-star reviews' },
      comeback: { text: 'Return business, no chasing', codes: ['DBR', 'EML'], short: 'Get return business' },
      google: { text: 'Found first on Google', codes: ['GBP', 'SEO'], short: 'Get found on Google' },
      newleads: { text: 'Ads that bring new enquiries', codes: ['GAD', 'MAD'], short: 'More new enquiries' },
      socials: { text: 'Socials posted for you', codes: ['SOC'], short: 'Socials done for me' },
      website: { text: 'A website that books work', codes: ['WEB'], short: 'A better website' },
    };
    const SEATS = [
      { id: 'back', label: 'You drive, I sit back', tag: 'Best value', kw: ['back', 'you drive', 'done for', 'all of it'], reply: "Sit back then. I'll report in once a month." },
      { id: 'front', label: "You drive, I'll navigate", kw: ['navigat', 'front', 'approve', 'control'], reply: 'Up front with me. You approve every turn.' },
      { id: 'copilot', label: "I'll drive, you help", kw: ['help', 'support', 'i drive', "i'll drive", 'shotgun'], reply: "You drive, I'll ride shotgun." },
      { id: 'self', label: 'Just the keys', kw: ['key', 'myself', 'diy', 'self', 'platform', 'software'], reply: 'Keys are yours. Call me any time.' },
    ];
    const DIST = [
      { id: 'S', label: 'Around the corner', kw: ['corner', 'small', 'basic', 'start', 'light'] },
      { id: 'M', label: 'Across town', kw: ['town', 'medium', 'steady', 'grow', 'mid'] },
      { id: 'L', label: 'The long haul', kw: ['long', 'haul', 'all', 'big', 'full', 'large', 'scale'] },
    ];
    const SEAT_NAME: Record<string, string> = { self: 'Self-drive', copilot: 'Co-pilot', back: 'Back seat', front: 'Front seat' };
    const PLAIN: Record<string, string> = {
      AIR: 'Every call answered', FUP: 'Every quote followed up', REV: '5-star reviews', GBP: 'Google Maps', SEO: 'Google search',
      DBR: 'Return business campaign', EML: 'Emails and texts to customers', GAD: 'Google Ads', MAD: 'Facebook and Instagram ads',
      SOC: 'Social media', WEB: 'Website', GRM: 'Monthly report and check-in', SUP: 'Help hours each month',
    };
    const SIZE: Record<string, string> = { S: 'Light', M: 'Steady', L: 'Full' };
    const matchOpt = <X extends { kw: string[] }>(text: string, opts: X[]) => { const t = ` ${text.toLowerCase()} `; return opts.find((o) => o.kw.some((k) => t.includes(k))); };

    /* ══ The price ══ */
    const codesFor = (): string[] => {
      const d = lead.distance || 'S';
      const needs: string[] = lead.needs.length ? lead.needs : ['calls', 'followup'];
      const out: string[] = [];
      needs.forEach((n) => NEEDS[n]?.codes.forEach((c, k) => { if (k > 0 && d !== 'L') return; out.push(`${c}-${d}`); }));
      if (needs.includes('calls') && !needs.includes('followup')) out.push(`FUP-${d}`);
      return [...new Set(out)].filter((c) => cat.items[c]);
    };
    const quote = () => {
      const seat = lead.seat || 'back', d = lead.distance || 'S';
      const lines: { label: string; price: number; save?: boolean; oneoff?: number }[] = [];
      if (seat === 'self') {
        const [n, p] = d === 'S' ? ['Launchpad', cat.plans.launchpad] : d === 'M' ? ['Starter', cat.plans.starter] : ['Growth', cat.plans.growth];
        lines.push({ label: `DUSA ${n} plan`, price: p as number });
        return { lines, monthly: p as number, setup: 0, nudge: '' };
      }
      lines.push({ label: 'DUSA Growth plan', price: cat.plans.growth });
      let monthly = cat.plans.growth, setup = 0, nudge = '';
      if (seat === 'copilot') { const it = cat.items[`SUP-${d}`]; lines.push({ label: PLAIN.SUP, price: it.monthly }); return { lines, monthly: monthly + it.monthly, setup, nudge }; }
      const codes = codesFor(); if (seat === 'back') codes.push('GRM-S');
      let bolt = 0, boltFront = 0, set = 0;
      codes.forEach((c) => {
        const it = cat.items[c], base = c.split('-')[0];
        bolt += it.monthly; boltFront += it.guided ?? it.monthly; set += it.setup;
        if (it.monthly === 0) lines.push({ label: `${PLAIN[base]} (one-off)`, price: 0, oneoff: it.setup });
        else lines.push({ label: `${PLAIN[base]} · ${SIZE[it.size]}`, price: seat === 'front' ? (it.guided ?? it.monthly) : it.monthly });
      });
      if (seat === 'back') {
        const engine = Math.round((bolt * (1 - cat.bundleDiscount)) / 10) * 10 - 3;
        lines.push({ label: 'Growth Engine saving', price: engine - bolt, save: true });
        monthly += engine; setup = Math.round((set * (1 - cat.setupDiscount)) / 10) * 10;
      } else {
        const chk = cat.items['GRM-M'];
        lines.push({ label: 'Weekly check-ins and approvals', price: chk.monthly });
        monthly += boltFront + chk.monthly; setup = set;
        const back = cat.plans.growth + Math.round(((bolt + cat.items['GRM-S'].monthly) * (1 - cat.bundleDiscount)) / 10) * 10 - 3;
        if (back < monthly) nudge = `Same trip from the back seat: ${money(back)}/mo.`;
