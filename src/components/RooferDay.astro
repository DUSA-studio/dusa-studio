    /* ════════════════════════════════════════════════════════════════════
       The diorama. Clay-style: rounded boxes, soft shadows, flat colours.
       ════════════════════════════════════════════════════════════════════ */
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (a: number, b: number, v: number) => { const t = clamp01((v - a) / (b - a)); return t * t * (3 - 2 * t); };
    const damp = (a: number, b: number, k: number, dt: number) => a + (b - a) * (1 - Math.exp(-k * dt));
    const V = (x = 0, y = 0, z = 0) => new THREE.Vector3(x, y, z);

    const mat = (color: number, extra: Partial<THREE.MeshStandardMaterialParameters> = {}) =>
      new THREE.MeshStandardMaterial({ color, roughness: 0.8, metalness: 0.02, ...extra });
    const rbox = (w: number, h: number, d: number, m: THREE.Material, r = 0.08, x = 0, y = 0, z = 0) => {
      const o = new THREE.Mesh(new RoundedBoxGeometry(w, h, d, 3, Math.min(r, Math.min(w, h, d) / 2)), m);
      o.position.set(x, y, z); o.castShadow = true; o.receiveShadow = true; return o;
    };
    const cyl = (rt: number, rb: number, h: number, m: THREE.Material, x = 0, y = 0, z = 0, seg = 24) => {
      const o = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg), m);
      o.position.set(x, y, z); o.castShadow = true; o.receiveShadow = true; return o;
    };
    const sph = (r: number, m: THREE.Material, x = 0, y = 0, z = 0) => {
