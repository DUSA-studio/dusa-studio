---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INDUSTRY_ICONS } from '../../config/industry-icons';
import t from '../../i18n/translations/en.json';

const industries = [
  {
    title: 'Real Estate',
    desc: 'Pipeline management, automated open home follow-ups, and buyer matching for agents who want to close more deals.',
    slug: '/industries/real-estate',
  },
  {
    title: 'Gyms and Fitness',
    desc: 'Member onboarding, class reminders, win-back campaigns, and referral tracking to reduce churn and fill classes.',
    slug: '/industries/gyms',
  },
  {
    title: 'Trades',
    desc: 'Missed call text-back, quote pipelines, job scheduling, and invoice reminders for tradies who are too busy on the tools.',
    slug: '/industries/tradies',
  },
  {
    title: 'Restaurants',
    desc: 'Reservation reminders, post-visit review requests, birthday campaigns, and digital loyalty programs.',
    slug: '/industries/restaurants',
  },
  {
    title: 'Salons and Spas',
    desc: 'Online booking, automated reminders, rebooking campaigns, and client preference tracking to fill every chair.',
    slug: '/industries/salons',
  },
  {
    title: 'Accountants',
    desc: 'Document collection automation, deadline reminders, and year-round client engagement beyond tax season.',
    slug: '/industries/accountants',
  },
  {
    title: 'Dental Practices',
    desc: 'Recall reminders, new patient acquisition, review generation, and treatment plan follow-ups on autopilot.',
    slug: '/industries/dentists',
  },
  {
    title: 'Photographers',
    desc: 'Enquiry autoresponders, contract workflows, session reminders, gallery delivery, and print upsell sequences.',
    slug: '/industries/photographers',
  },
  {
    title: 'Construction',
    desc: 'Lead tracking, quote follow-ups, project milestone communication, and payment collection for builders.',
    slug: '/industries/construction',
  },
  {
    title: 'Personal Trainers',
    desc: 'Lead magnet funnels, consultation booking, transformation showcases, and automated client check-ins.',
    slug: '/industries/personal-trainers',
  },
  {
    title: 'Cleaning Services',
    desc: 'Recurring booking management, quality follow-ups, crew scheduling, and upsell campaigns for cleaning businesses.',
    slug: '/industries/cleaning-services',
  },
  {
    title: 'Law Firms',
    desc: 'Intake form automation, case status updates, referral tracking, and thought leadership content within compliance.',
    slug: '/industries/law-firms',
  },
  {
    title: 'Property Managers',
    desc: 'Tenant lifecycle automation, maintenance request pipelines, rent reminders, and lease renewal campaigns.',
    slug: '/industries/property-managers',
  },
  {
    title: 'Auto Repair',
    desc: 'Service reminder automation, seasonal campaigns, review generation, and loyalty programs for mechanics.',
    slug: '/industries/auto-repair',
  },
  {
    title: 'Coaches and Consultants',
    desc: 'Discovery call funnels, onboarding sequences, session scheduling, and testimonial collection to scale your practice.',
    slug: '/industries/coaches',
  },
  {
    title: 'E-commerce',
    desc: 'Post-purchase sequences, review automation, cross-sell flows, VIP segmentation, and birthday rewards.',
    slug: '/industries/ecommerce',
  },
];
---

<BaseLayout
  t={t}
  title="Industries | DUSA.studio"
  description="DUSA is built for your industry. Explore how our growth platform works for real estate, trades, gyms, restaurants, salons, dentists, and more."
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Industries</span>
        <h1>Built for <span class="gradient-text">your</span> industry</h1>
        <p class="ind-hero__sub">
          Every business is different. That is why DUSA adapts to the way you work, with pipelines, automations, and workflows designed for your specific industry. Find yours below.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Industry Grid ═══ -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={INDUSTRY_ICONS[ind.slug.split('/').pop()]} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Do not see your industry?</h2>
        <p class="ind-cta__desc">DUSA works for any service-based business. Get in touch and we will show you how it fits your workflow.</p>
        <div class="ind-cta__buttons">
          <a href="/start" class="btn btn--primary">Get Started</a>
          <a href="/contact" class="btn btn--outline">Talk to Us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dusa.studio/" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
