  // Live clock for phone mockup
  function updatePhoneClock() {
    const el = document.getElementById('hero-phone-clock');
    if (!el) return;
    const now = new Date();
    const h = now.getHours();
    const m = now.getMinutes().toString().padStart(2, '0');
    const hour12 = h % 12 || 12;
    el.textContent = `${hour12}:${m}`;
  }
  updatePhoneClock();
  setInterval(updatePhoneClock, 10000);

