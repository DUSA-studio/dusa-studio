      ladder.position.set(HX + W / 2 + 1.15, 0, HZ + 0.5); ladder.rotation.z = 0.42; job.add(ladder);
      job.add(rbox(0.9, 0.4, 0.6, mat(P.roof), 0.05, HX + W / 2 + 2.3, 0.2, HZ + 2.0)); // a stack of tiles waiting

      /* Trees, flowers */
      const tree = (x: number, z: number, s = 1) => {
        const g = new THREE.Group(); g.add(cyl(0.1 * s, 0.13 * s, 0.9 * s, mat(P.treeTrunk), 0, 0.45 * s, 0));
        const lm = mat(P.tree);
        g.add(sph(0.62 * s, lm, 0, 1.25 * s, 0), sph(0.48 * s, lm, 0.42 * s, 1.0 * s, 0.2 * s), sph(0.45 * s, lm, -0.4 * s, 1.05 * s, -0.2 * s), sph(0.4 * s, lm, 0.05 * s, 1.72 * s, -0.05 * s));
