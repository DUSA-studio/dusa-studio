---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';

const title = 'Automacao de Marketing para E-Commerce | DUSA.studio';
const description = 'Recupere carrinhos abandonados, automatize o engajamento pos-compra e crie programas de fidelidade VIP. O DUSA e a plataforma de crescimento tudo-em-um para marcas de e-commerce.';

const painPoints = [
  {
    icon: '🛒',
    title: 'Carrinhos Abandonados Sem Acompanhamento',
    desc: 'Um unico email de recuperacao nao e suficiente. A maioria das plataformas para por ai, deixando milhares de reais em receita parados em carrinhos abandonados.',
  },
  {
    icon: '📦',
    title: 'Sem Engajamento Pos-Compra',
    desc: 'A venda acontece e depois silencio. Sem sequencia de agradecimento, sem cross-sell, sem solicitacao de avaliacao. Voce esta deixando receita recorrente na mesa.',
  },
  {
    icon: '👑',
    title: 'Sem Segmentacao VIP',
    desc: 'Seus melhores clientes recebem a mesma experiencia que todos os outros. Sem reconhecimento, sem ofertas exclusivas, sem motivo para permanecer fiel.',
  },
  {
    icon: '🔄',
    title: 'Baixa Taxa de Recompra',
    desc: 'Adquirir um novo cliente custa cinco vezes mais do que reter um existente. Sem fluxos de reengajamento, a maioria dos compradores nunca volta.',
  },
];

const features = [
  {
    title: 'Recuperacao de Carrinho Abandonado',
    desc: 'Sequencias de recuperacao em multiplas etapas por email e SMS. Lembretes programados, incentivos de desconto e gatilhos de urgencia que trazem compradores de volta.',
  },
  {
    title: 'Sequencias Pos-Compra',
    desc: 'Emails de agradecimento, atualizacoes de envio, dicas de uso e check-ins de satisfacao. Mantenha a conversa apos a venda.',
  },
  {
    title: 'Automacao de Solicitacao de Avaliacoes',
    desc: 'Solicite avaliacoes automaticamente no momento perfeito, apos a entrega e antes de a empolgacao passar. Construa prova social no piloto automatico.',
  },
  {
    title: 'Fluxos de Cross-Sell e Upsell',
    desc: 'Recomende produtos complementares com base no historico de compras. Dispare ofertas de upsell quando clientes atingirem limites de gastos especificos.',
  },
  {
    title: 'Gestao de Niveis VIP',
    desc: 'Segmente clientes por valor vitalicio. Desbloqueie vantagens exclusivas, acesso antecipado e ofertas personalizadas para seus maiores compradores.',
  },
  {
    title: 'Recompensas de Aniversario',
    desc: 'Mensagens automaticas de aniversario com codigos de desconto exclusivos. Um pequeno gesto que gera fidelidade e compras recorrentes.',
  },
];

const pipeline = [
  { stage: 'Primeira Compra', desc: 'Cliente conclui seu primeiro pedido' },
  { stage: 'Comprador Recorrente', desc: 'Segunda compra em ate 90 dias' },
  { stage: 'Cliente Fiel', desc: 'Tres ou mais pedidos, engajado com emails' },
  { stage: 'VIP', desc: 'Top 10% em valor vitalicio, vantagens exclusivas desbloqueadas' },
  { stage: 'Defensor da Marca', desc: 'Deixa avaliacoes, indica amigos, compartilha nas redes' },
  { stage: 'Reconquista', desc: 'Um comprador anterior parou de comprar. O DUSA aciona uma campanha de reengajamento personalizada com recomendacoes de produtos sob medida.' },
];

const stats = [
  { value: '69%', label: 'taxa media de abandono de carrinho em todo o e-commerce' },
  { value: '5x', label: 'mais barato reter um cliente existente do que adquirir um novo' },
  { value: '306%', label: 'maior valor vitalicio de clientes que aderem a um programa VIP' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dusa.studio/' },
    { '@type': 'ListItem', position: 2, name: 'Industrias', item: 'https://dusa.studio/br/industries' },
    { '@type': 'ListItem', position: 3, name: 'E-Commerce', item: 'https://dusa.studio/br/industries/ecommerce' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="ec-hero section section--dark">
    <div class="container">
      <div class="ec-hero__content">
        <span class="label">E-Commerce</span>
        <h1><span class="gradient-text">Automacao de marketing</span> para marcas de e-commerce</h1>
        <p class="ec-hero__sub">
          Recupere carrinhos abandonados, cultive relacionamentos pos-compra e transforme compradores unicos em defensores da marca para a vida toda.
        </p>
        <div class="ec-hero__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ec-pain section section--dark">
    <div class="container">
      <div class="ec-pain__header">
        <span class="label">O Problema</span>
        <h2>Voce esta perdendo receita <span class="gradient-text">apos o clique</span></h2>
        <p class="ec-pain__intro">A maioria das marcas de e-commerce foca em trafego e ignora tudo que acontece apos a primeira visita. Veja quanto isso custa.</p>
      </div>
      <div class="ec-pain__grid">
        {painPoints.map((point) => (
          <div class="ec-pain__card">
            <span class="ec-pain__icon">{point.icon}</span>
            <h3 class="ec-pain__card-title">{point.title}</h3>
            <p class="ec-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ec-solution section section--dark">
    <div class="container">
      <div class="ec-solution__header">
        <span class="label">A Solucao</span>
        <h2>Como o DUSA funciona para <span class="gradient-text">e-commerce</span></h2>
        <p class="ec-solution__intro">Fluxos automatizados que transformam visitantes em compradores, compradores em clientes recorrentes e clientes recorrentes em defensores da marca.</p>
      </div>
      <div class="ec-solution__grid">
        {features.map((feature) => (
          <div class="ec-solution__card">
            <h3 class="ec-solution__card-title">{feature.title}</h3>
            <p class="ec-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ec-pipeline section section--dark">
    <div class="container">
      <div class="ec-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>A <span class="gradient-text">jornada do cliente</span> em um relance</h2>
      </div>
      <div class="ec-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="ec-pipeline__stage">
            <div class="ec-pipeline__number">{i + 1}</div>
            <h3 class="ec-pipeline__stage-title">{step.stage}</h3>
            <p class="ec-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ec-stats section section--dark">
    <div class="container">
      <div class="ec-stats__header">
        <span class="label">Impacto</span>
        <h2>Os numeros falam por <span class="gradient-text">si mesmos</span></h2>
      </div>
      <div class="ec-stats__grid">
        {stats.map((stat) => (
          <div class="ec-stats__card">
            <span class="ec-stats__value">{stat.value}</span>
            <p class="ec-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ec-cta section section--dark">
    <div class="container">
      <div class="ec-cta__box">
        <h2>Pronto para aumentar sua <span class="gradient-text">receita de e-commerce</span>?</h2>
        <p class="ec-cta__sub">Tenha sua recuperacao de carrinho, fluxos pos-compra e programa VIP funcionando em uma so plataforma.</p>
        <div class="ec-cta__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
          <a href="/blog/marketing-for-ecommerce" class="btn btn--outline">Leia o guia</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .ec-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ec-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ec-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .ec-pain {
    padding: var(--space-2xl) 0;
  }
  .ec-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .ec-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .ec-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .ec-solution {
    padding: var(--space-2xl) 0;
  }
  .ec-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .ec-pipeline {
    padding: var(--space-2xl) 0;
  }
  .ec-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .ec-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .ec-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .ec-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .ec-stats {
    padding: var(--space-2xl) 0;
  }
  .ec-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ec-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .ec-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .ec-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .ec-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .ec-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .ec-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .ec-hero__content h1,
  :global(html[data-theme="light"]) .ec-pain__header h2,
  :global(html[data-theme="light"]) .ec-solution__header h2,
  :global(html[data-theme="light"]) .ec-pipeline__header h2,
  :global(html[data-theme="light"]) .ec-stats__header h2,
  :global(html[data-theme="light"]) .ec-cta__box h2,
  :global(html[data-theme="light"]) .ec-pain__card-title,
  :global(html[data-theme="light"]) .ec-solution__card-title,
  :global(html[data-theme="light"]) .ec-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-hero__sub,
  :global(html[data-theme="light"]) .ec-pain__intro,
  :global(html[data-theme="light"]) .ec-solution__intro,
  :global(html[data-theme="light"]) .ec-pain__card-desc,
  :global(html[data-theme="light"]) .ec-solution__card-desc,
  :global(html[data-theme="light"]) .ec-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ec-stats__label,
  :global(html[data-theme="light"]) .ec-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .ec-pain__card,
  :global(html[data-theme="light"]) .ec-solution__card,
  :global(html[data-theme="light"]) .ec-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .ec-pain__card:hover,
  :global(html[data-theme="light"]) .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .ec-stats__card,
  :global(html[data-theme="light"]) .ec-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .ec-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-stats__value {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ec-pain__grid {
      grid-template-columns: 1fr;
    }
    .ec-solution__grid {
      grid-template-columns: 1fr;
    }
    .ec-stats__grid {
      grid-template-columns: 1fr;
    }
    .ec-pipeline__stages {
      flex-direction: column;
    }
    .ec-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .ec-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
