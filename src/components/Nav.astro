---
// Nav.astro — Sticky navigation with logo + CTA

interface Props {
  t?: Record<string, any>;
}

const { t = {} } = Astro.props;

const n = t?.nav || {};
const pricingLabel = n.pricing || 'Pricing';
const servicesLabel = n.services || 'Services';
const contactLabel = n.contact || 'Contact';
const loginLabel = n.logIn || 'Log in';
const getStartedLabel = n.getStarted || 'Get Started';
const industriesLabel = n.industries || 'Industries';
const regionLabel = n.region || 'Region';
const themeLabel = n.theme || 'Theme';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const industryLinks = [
  { label: 'Real Estate', slug: '/industries/real-estate' },
  { label: 'Gyms & Fitness', slug: '/industries/gyms' },
  { label: 'Trades', slug: '/industries/tradies' },
  { label: 'Restaurants', slug: '/industries/restaurants' },
  { label: 'Salons & Spas', slug: '/industries/salons' },
  { label: 'Accountants', slug: '/industries/accountants' },
  { label: 'Dental Practices', slug: '/industries/dentists' },
  { label: 'Photographers', slug: '/industries/photographers' },
  { label: 'Construction', slug: '/industries/construction' },
  { label: 'Personal Trainers', slug: '/industries/personal-trainers' },
  { label: 'Cleaning Services', slug: '/industries/cleaning-services' },
  { label: 'Law Firms', slug: '/industries/law-firms' },
  { label: 'Property Managers', slug: '/industries/property-managers' },
  { label: 'Auto Repair', slug: '/industries/auto-repair' },
  { label: 'Coaches', slug: '/industries/coaches' },
  { label: 'E-commerce', slug: '/industries/ecommerce' },
];
---

<nav class="nav" id="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo">
      <span class="nav__logo-text">
        <span class="nav__logo-shimmer">DUSA</span>
        <span class="nav__logo-dot" aria-hidden="true">.</span>
        <span class="nav__logo-shimmer">studio</span>
      </span>
    </a>

    <div class="nav__links">
      <a href="/pricing" data-page="pricing" class={`nav__link ${currentPath === '/pricing' ? 'nav__link--active' : ''}`}>{pricingLabel}</a>
      <a href="/services" data-page="services" class={`nav__link ${currentPath === '/services' ? 'nav__link--active' : ''}`}>{servicesLabel}</a>
      <div class="nav__dropdown-wrap" id="industries-wrap">
        <button class={`nav__link nav__link--dropdown ${currentPath.startsWith('/industries') ? 'nav__link--active' : ''}`} id="industries-toggle" aria-expanded="false" aria-haspopup="true">
          {industriesLabel}
          <svg class="nav__dropdown-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav__dropdown" id="industries-dropdown">
          <div class="nav__dropdown-grid">
            {industryLinks.map((ind) => (
              <a href={ind.slug} data-page={ind.slug.replace(/^\//, '')} class="nav__dropdown-item">{ind.label}</a>
            ))}
          </div>
          <div class="nav__dropdown-footer">
            <a href="/industries" data-page="industries" class="nav__dropdown-all">View all industries &rarr;</a>
          </div>
        </div>
      </div>
      <a href="/contact" data-page="contact" class={`nav__link ${currentPath === '/contact' ? 'nav__link--active' : ''}`}>{contactLabel}</a>
    </div>

    <div class="nav__right">
      <a href="https://app.dusa.studio" class="nav__login" target="_blank" rel="noopener noreferrer">{loginLabel}</a>
      <div class="nav__region-wrap" id="region-wrap">
        <button class="nav__region-btn" id="region-toggle" aria-label="Select region and language" title="Region">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </button>
        <div class="nav__region-dropdown" id="region-dropdown">
          <div class="nav__region-label">{regionLabel}</div>
          <button class="nav__region-option" data-region="au"><span class="nav__region-flag">🇦🇺</span> Australia <span class="nav__region-currency">AUD</span></button>
          <button class="nav__region-option" data-region="us"><span class="nav__region-flag">🇺🇸</span> United States <span class="nav__region-currency">USD</span></button>
          <button class="nav__region-option" data-region="uk"><span class="nav__region-flag">🇬🇧</span> United Kingdom <span class="nav__region-currency">GBP</span></button>
          <div class="nav__region-divider"></div>
          <button class="nav__region-option" data-region="es"><span class="nav__region-flag">🇪🇸</span> España <span class="nav__region-currency">EUR</span></button>
          <button class="nav__region-option" data-region="mx"><span class="nav__region-flag">🇲🇽</span> México <span class="nav__region-currency">MXN</span></button>
          <button class="nav__region-option" data-region="br"><span class="nav__region-flag">🇧🇷</span> Brasil <span class="nav__region-currency">BRL</span></button>
          <button class="nav__region-option" data-region="fr"><span class="nav__region-flag">🇫🇷</span> France <span class="nav__region-currency">EUR</span></button>
          <button class="nav__region-option" data-region="de"><span class="nav__region-flag">🇩🇪</span> Deutschland <span class="nav__region-currency">EUR</span></button>
        </div>
      </div>
      <a href="/start" class="btn btn--primary nav__cta">{getStartedLabel}</a>
      <button class="nav__theme-toggle" id="theme-toggle" aria-label="Toggle light/dark mode" title="Toggle theme">
        <svg class="nav__theme-icon nav__theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="nav__theme-icon nav__theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </div>

    <div class="nav__mobile-bar">
      <a href="https://app.dusa.studio" class="nav__mobile-login" target="_blank" rel="noopener noreferrer">{loginLabel}</a>
      <button class="nav__theme-toggle nav__theme-toggle--bar" id="bar-theme-toggle" aria-label="Toggle light/dark mode">
        <svg class="nav__theme-icon nav__theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="nav__theme-icon nav__theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <button class="nav__mobile-toggle" id="nav-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="nav__mobile" id="nav-mobile">
    <a href="/pricing" data-page="pricing" class={`nav__mobile-link ${currentPath === '/pricing' ? 'nav__mobile-link--active' : ''}`}>{pricingLabel}</a>
    <a href="/services" data-page="services" class={`nav__mobile-link ${currentPath === '/services' ? 'nav__mobile-link--active' : ''}`}>{servicesLabel}</a>
    <div class="nav__mobile-accordion" id="mobile-industries">
      <button class={`nav__mobile-link nav__mobile-link--accordion ${currentPath.startsWith('/industries') ? 'nav__mobile-link--active' : ''}`} id="mobile-industries-toggle">
        {industriesLabel}
        <svg class="nav__mobile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav__mobile-sub" id="mobile-industries-sub">
        {industryLinks.map((ind) => (
          <a href={ind.slug} data-page={ind.slug.replace(/^\//, '')} class="nav__mobile-sub-link">{ind.label}</a>
        ))}
        <a href="/industries" data-page="industries" class="nav__mobile-sub-link nav__mobile-sub-link--all">View all &rarr;</a>
      </div>
    </div>
    <a href="/contact" data-page="contact" class={`nav__mobile-link ${currentPath === '/contact' ? 'nav__mobile-link--active' : ''}`}>{contactLabel}</a>
    <a href="https://app.dusa.studio" class="nav__mobile-link" target="_blank" rel="noopener noreferrer">{loginLabel}</a>
    <div class="nav__mobile-region" id="mobile-region">
      <span class="nav__mobile-theme-label">{regionLabel}</span>
      <select class="nav__region-select" id="mobile-region-select">
        <option value="au">🇦🇺 Australia (AUD)</option>
        <option value="us">🇺🇸 USA (USD)</option>
        <option value="uk">🇬🇧 UK (GBP)</option>
        <option value="es">🇪🇸 España (EUR)</option>
        <option value="mx">🇲🇽 México (MXN)</option>
        <option value="br">🇧🇷 Brasil (BRL)</option>
        <option value="fr">🇫🇷 France (EUR)</option>
        <option value="de">🇩🇪 Deutschland (EUR)</option>
      </select>
    </div>
    <div class="nav__mobile-theme" id="mobile-theme-toggle">
      <span class="nav__mobile-theme-label">{themeLabel}</span>
      <button class="nav__theme-toggle nav__theme-toggle--mobile" aria-label="Toggle light/dark mode">
        <svg class="nav__theme-icon nav__theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="nav__theme-icon nav__theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </div>
    <a href="/start" class="btn btn--primary nav__mobile-cta">{getStartedLabel}</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
    height: var(--nav-height);
    transition: all 0.6s var(--ease-out);
  }

  .nav--scrolled {
    background: rgba(12, 14, 20, 0.8);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: 1px solid rgba(247, 244, 239, 0.06);
    box-shadow:
      0 4px 30px rgba(0, 0, 0, 0.3),
      0 1px 0 rgba(78, 216, 194, 0.05);
  }

  .nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    position: relative;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--warm-white);
    transition: opacity var(--duration-fast);
  }

  .nav__logo:hover {
    opacity: 0.85;
  }

  .nav__logo-text {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav__logo-dot {
    color: var(--reef-aqua);
    font-weight: 700;
    margin: 0 -0.05rem;
  }

  /* Shimmer sweep animation */
  @keyframes shimmerSweep {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .nav__logo-shimmer {
    background: linear-gradient(
      90deg,
      var(--mist-blue) 0%,
      var(--mist-blue) 35%,
      var(--reef-aqua) 50%,
      var(--mist-blue) 65%,
      var(--mist-blue) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 4s ease-in-out infinite;
  }

  .nav__links {
    display: flex;
    flex: 1;
    justify-content: center;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 2rem);
    padding: 0 1rem;
  }

  .nav__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.7);
    transition: color var(--duration-fast);
    position: relative;
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--reef-aqua);
    transition: width var(--duration-fast) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--warm-white);
  }

  .nav__link:hover::after {
    width: 100%;
  }

  .nav__link--active {
    color: var(--warm-white);
  }

  .nav__link--active::after {
    width: 100%;
  }

  /* ─── Industries Dropdown ─── */
  .nav__dropdown-wrap {
    position: relative;
  }

  .nav__link--dropdown {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .nav__dropdown-chevron {
    transition: transform var(--duration-fast);
    flex-shrink: 0;
  }

  .nav__dropdown-wrap.is-open .nav__dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    width: 480px;
    background: rgba(12, 14, 20, 0.88);
    backdrop-filter: blur(24px) saturate(1.3);
    -webkit-backdrop-filter: blur(24px) saturate(1.3);
    border: 1px solid rgba(78, 216, 194, 0.1);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--duration-fast), visibility var(--duration-fast), transform var(--duration-fast);
    transform: translateX(-50%) translateY(8px);
    z-index: 1001;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(247, 244, 239, 0.03) inset,
      0 1px 0 rgba(247, 244, 239, 0.04) inset;
  }

  .nav__dropdown-wrap.is-open .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav__dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.125rem;
  }

  .nav__dropdown-item {
    font-size: 0.875rem;
    color: rgba(247, 244, 239, 0.6);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    transition: background var(--duration-fast), color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__dropdown-item:hover {
    background: rgba(78, 216, 194, 0.1);
    color: var(--reef-aqua);
    transform: translateX(2px);
  }

  .nav__dropdown-footer {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(78, 216, 194, 0.08);
    text-align: center;
  }

  .nav__dropdown-all {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--reef-aqua);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .nav__dropdown-all:hover {
    opacity: 0.8;
  }

  /* ─── Mobile Industries Accordion ─── */
  .nav__mobile-accordion {
    display: flex;
    flex-direction: column;
  }

  .nav__mobile-link--accordion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
  }

  .nav__mobile-chevron {
    transition: transform var(--duration-fast);
    flex-shrink: 0;
  }

  .nav__mobile-accordion.is-open .nav__mobile-chevron {
    transform: rotate(180deg);
  }

  .nav__mobile-sub {
    display: none;
    flex-direction: column;
    padding-left: 1rem;
    padding-bottom: 0.5rem;
  }

  .nav__mobile-accordion.is-open .nav__mobile-sub {
    display: flex;
  }

  .nav__mobile-sub-link {
    font-size: 0.875rem;
    color: rgba(247, 244, 239, 0.55);
    padding: 0.4rem 0;
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .nav__mobile-sub-link:hover {
    color: var(--warm-white);
  }

  .nav__mobile-sub-link--all {
    color: var(--reef-aqua);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__login {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.6);
    transition: color var(--duration-fast);
    white-space: nowrap;
    margin-right: 0.25rem;
  }

  .nav__login:hover {
    color: var(--reef-aqua);
  }

  .nav__cta {
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
  }

  .nav__mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
  }

  .nav__mobile-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--warm-white);
    transition: all var(--duration-fast);
    border-radius: 2px;
    transform-origin: center;
  }

  /* Animate hamburger to X when menu is open */
  .nav__mobile-toggle.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .nav__mobile-toggle.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-md);
    padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    background: rgba(12, 14, 20, 0.98);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
    max-height: calc(100vh - var(--nav-height));
    max-height: calc(100dvh - var(--nav-height));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .nav__mobile.active {
    display: flex;
  }

  .nav__mobile-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.125rem;
    color: rgba(247, 244, 239, 0.7);
    padding: 0.75rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(247, 244, 239, 0.06);
    transition: color var(--duration-fast);
  }

  .nav__mobile-link:hover {
    color: var(--reef-aqua);
  }

  .nav__mobile-link--active {
    color: var(--reef-aqua);
  }

  @media (max-width: 1200px) {
    .nav__right {
      gap: 0.5rem;
    }

    .nav__link {
      font-size: 0.9375rem;
    }

    .nav__login {
      font-size: 0.875rem;
    }
  }

  @media (max-width: 1024px) {
    .nav__link {
      font-size: 0.8125rem;
    }

    .nav__cta {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }

    .nav__logo {
      font-size: 1.35rem;
    }

    .nav__login {
      font-size: 0.75rem;
    }

    .nav__right {
      gap: 0.375rem;
    }
  }

  /* ─── REGION SELECTOR ─── */
  .nav__region-wrap {
    position: relative;
  }

  .nav__region-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(247, 244, 239, 0.06);
    border: 1px solid rgba(247, 244, 239, 0.1);
    color: rgba(247, 244, 239, 0.6);
    transition: all var(--duration-fast) var(--ease-out);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

