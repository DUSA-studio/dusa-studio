          [6.5, tray[1]('carry')], [7.2, tray[1]('carry')], [7.5, ladderFoot], [7.8, roofAt(0.5, 1.1)], [9.25, roofAt(0.5, 1.1)], [9.3, roofWait(0.5, 1.1)], [10.05, roofWait(0.5, 1.1)], [10.3, roofAt(0.5, 1.1)], [10.45, roofAt(0.5, 1.1)], [10.55, smokoSeat[1]], [11.2, smokoSeat[1]], [11.45, ladderFoot], [11.7, roofAt(0.5, 1.1)], [12.3, roofAt(0.5, 1.1)], [12.4, ladderFoot], [12.55, smokoSeat[1]], [13.1, smokoSeat[1]], [13.25, ladderFoot], [13.5, roofAt(0.5, 1.1)], [13.9, roofAt(0.5, 1.1)], [14.0, roofWait(0.5, 1.1)], [14.75, roofWait(0.5, 1.1)], [15.0, roofAt(0.5, 1.1)], [17.75, roofAt(0.5, 1.1)], [17.95, ladderFoot], [18.2, tray[1]('stand')], [18.4, tray[1]('stand')], [18.43, away], [21.5, away],
        ]) as Key[],
        crew2: (nice ? [
          [6.5, tray[2]('stand')], [7.3, tray[2]('carry')], [7.6, stackMark], ...ferry(7.7, 10.3), [10.35, stackMark], [10.6, smokoSeat[2]], [11.2, smokoSeat[2]], [11.5, stackMark], ...ferry(11.6, 12.4), [12.5, smokoSeat[2]], [13.0, smokoSeat[2]], [13.2, stackMark], ...ferry(13.3, 16.2), [16.4, ladderFoot], [16.9, tray[2]('stand')], [17.6, tray[2]('stand')], [17.65, away], [21.5, away],
        ] : [
          [6.5, tray[2]('stand')], [7.3, tray[2]('carry')], [7.6, stackMark], ...ferry(7.8, 9.2), [9.3, ladderWait], [10.05, ladderWait], [10.3, stackMark], [10.45, stackMark], [10.6, smokoSeat[2]], [11.2, smokoSeat[2]], [11.5, stackMark], ...ferry(11.7, 12.3), [12.5, smokoSeat[2]], [13.1, smokoSeat[2]], [13.3, ladderWait], [13.5, stackMark], ...ferry(13.55, 13.9), [14.0, ladderWait], [14.75, ladderWait], [15.0, stackMark], ...ferry(15.05, 17.7), [17.8, ladderFoot], [18.1, tray[2]('stand')], [18.4, tray[2]('stand')], [18.43, away], [21.5, away],
        ]) as Key[],
        partner: nice ? [[6.5, away], [LEAVE + 1.4, away], [LEAVE + 1.45, seatsOn.partner], [21.5, seatsOn.partner]] as Key[] : [[6.5, away], [LEAVE + 1.4, away], [LEAVE + 1.45, seatsOff.partner], [21.5, seatsOff.partner]] as Key[],
        kid: nice ? [[6.5, away], [LEAVE + 1.4, away], [LEAVE + 1.45, seatsOn.kid], [21.5, seatsOn.kid]] as Key[] : [[6.5, away], [LEAVE + 1.4, away], [LEAVE + 1.45, seatsOff.kid], [21.5, seatsOff.kid]] as Key[],
        // The customer comes out of the front door at the end of the day: a thank-you gift, or a complaint.
        customer: nice ? [[6.5, away], [16.45, away], [16.5, inside], [16.6, inside], [16.8, door('gift')], [17.05, door('gift')], [17.1, door('stand')], [17.45, door('stand')], [17.6, inside], [17.7, away], [21.5, away]] as Key[] : [[6.5, away], [16.65, away], [16.7, inside], [16.8, inside], [17.0, door('angry')], [17.8, door('angry')], [17.95, inside], [18.05, away], [21.5, away]] as Key[],
      };
      const people: { p: ReturnType<typeof makePerson>; keys: Key[] }[] = [
        { p: roofer, keys: sched.roofer as Key[] }, { p: crew1, keys: sched.crew1 }, { p: crew2, keys: sched.crew2 }, { p: partner, keys: sched.partner }, { p: kid, keys: sched.kid }, { p: customer, keys: sched.customer },
      ];
      /* What they say. Hours, who, the line, and whether it is said or thought. */
      type Line = { from: number; to: number; who: ReturnType<typeof makePerson>; text: string; thought?: boolean };
      const lines: Line[] = nice ? [
        { from: 9.05, to: 9.28, who: crew1, text: "Boss, what's next?" },
        { from: 9.35, to: 9.6, who: roofer, text: 'Tiles. DUSA has the phone.' },
        { from: 10.6, to: 10.95, who: crew2, text: 'Sam booked in?' },
        { from: 11.02, to: 11.25, who: roofer, text: 'Yep. Priya too.' },
        { from: 12.6, to: 12.95, who: crew1, text: 'Lunch. Dave paid the deposit.' },
        { from: 16.85, to: 17.12, who: customer, text: 'Done already? Thank you!' },
        { from: 17.2, to: 17.45, who: roofer, text: 'Easy. Cheers!' },
        { from: 19.2, to: 19.8, who: kid, text: "Dad's home!" },
        { from: 19.9, to: 20.6, who: partner, text: 'Dinner is on the table.' },
      ] : [
        { from: 9.05, to: 9.25, who: crew1, text: "Boss, what's next?" },
        { from: 9.3, to: 9.5, who: roofer, text: 'One minute. Missed a prospect.' },
        { from: 9.55, to: 9.9, who: roofer, text: 'Voicemail. Next one.', thought: true },
        { from: 9.6, to: 10.0, who: crew1, text: 'Guess we wait.' },
        { from: 10.75, to: 11.25, who: roofer, text: 'Still no answer.', thought: true },
        { from: 12.6, to: 13.05, who: roofer, text: 'No lunch. Where is that quote?', thought: true },
        { from: 12.7, to: 13.2, who: crew2, text: 'Boss, eat something.' },
        { from: 14.2, to: 14.55, who: roofer, text: 'Voicemail. Again.', thought: true },
        { from: 17.0, to: 17.45, who: customer, text: 'You said today!' },
        { from: 17.5, to: 17.85, who: roofer, text: 'Nearly there...' },
      ];
      const project = (p: THREE.Object3D, up: number) => { const v = new THREE.Vector3(0, up, 0); p.localToWorld(v); v.project(camera); return v; };
      const place = (keys: Key[], h: number) => {
        let i = 0; while (i < keys.length - 2 && h >= keys[i + 1][0]) i++;
        const [h0, a] = keys[i], [h1, b] = keys[i + 1];
        const t = clamp01((h - h0) / Math.max(0.0001, h1 - h0));
        // In or out of the scene: nobody walks up through the ground. Shrink away, pop up at the other end.
        if (a.p.y < -2.5 || b.p.y < -2.5) { const here = t < 0.5 ? a : b; return { pos: here.p.clone(), rot: here.r, pose: here.pose, speed: 0, nextPose: b.pose, fade: t < 0.5 ? 1 - t * 2 : t * 2 - 1 }; }
        const moving = a.p.distanceToSquared(b.p) > 0.01;
        const tt = moving ? smooth(0, 1, t) : t;
        let pos = a.p.clone().lerp(b.p, tt);
        let rot = moving ? Math.atan2(b.p.x - a.p.x, b.p.z - a.p.z) : b.r;
        // Between ground and roof, everyone goes via the top of the ladder: up it, then across the roof.
        const climb = moving && Math.abs(a.p.y - b.p.y) > 1;
        if (climb) {
          const up = b.p.y > a.p.y;
          if (tt < 0.5) { pos = a.p.clone().lerp(up ? LT : LT, tt * 2); if (up) pos.y = a.p.y + (LT.y - a.p.y) * tt * 2; rot = up ? -Math.PI / 2 : Math.atan2(LT.x - a.p.x, LT.z - a.p.z); }
          else { pos = LT.clone().lerp(b.p, (tt - 0.5) * 2); rot = up ? Math.atan2(b.p.x - LT.x, b.p.z - LT.z) : -Math.PI / 2; }
          if (!up && tt >= 0.5) pos.y = LT.y + (b.p.y - LT.y) * (tt - 0.5) * 2;
        }
        const speed = moving ? a.p.distanceTo(b.p) / (h1 - h0) : 0;
        if (moving && t > 0.9) rot = b.r;
        const keep = a.pose === 'carry' || (a.pose === b.pose && (a.pose === 'phone' || a.pose === 'gift'));
        return { pos, rot, pose: moving ? ((keep ? a.pose : 'walk') as Pose) : b.pose, speed, nextPose: b.pose, fade: 1 };
      };
      // Roof progress: tiles go on while the boss is on the roof. Precomputed per hour.
      const onRoofHours: number[] = []; let acc = 0;
      for (let h = 6.5; h <= 21.5; h += 0.05) { const s = place(sched.roofer as Key[], h); if (!s.pose.startsWith('walk') && s.nextPose === 'hammer' && s.pos.y > 2) acc += 0.05; onRoofHours.push(acc); }
      const total = nice ? onRoofHours[onRoofHours.length - 1] * 0.95 : onRoofHours[onRoofHours.length - 1] * 1.75; // the DUSA roof finishes; the other does not
      const progressAt = (h: number) => clamp01(onRoofHours[Math.min(onRoofHours.length - 1, Math.max(0, Math.round((h - 6.5) / 0.05)))] / total);

      let lastT = 0, running = false, pingAt = -1e9, shownBeat = -1;
      const cur = { night: 0, smoko: 0, home: 0, job: 1, driveOff: 0 };
      const resize = () => {
        const w = stage.clientWidth, h = stage.clientHeight; renderer.setSize(w, h, false);
        const aspect = w / h; const halfW = aspect < 1 ? 6.4 : 9.4;
        camera.left = -halfW; camera.right = halfW; camera.top = halfW / aspect; camera.bottom = -halfW / aspect; camera.updateProjectionMatrix();
      };
      const setBeat = (b: number) => { if (b !== shownBeat) { shownBeat = b; pingAt = performance.now(); } };

      const frame = (now: number, h: number, dt: number, b: number) => {
        setBeat(b);
        // Sun on its arc, warm at the ends, blue at night.
        const sunT = clamp01((h - 6) / 13), elev = Math.sin(sunT * Math.PI);
        const night = smooth(18.2, 19.4, h), dawn = 1 - smooth(6.5, 8.5, h), dusk = smooth(16.5, 18.3, h) * (1 - night);
        cur.night = night;
        sun.position.set(Math.cos(Math.PI - sunT * Math.PI) * 10, 2 + elev * 10, 5 + elev * 2);
        sun.intensity = 0.35 + (elev * 2.0 + dawn * 1.3) * (1 - night);
        sun.color.set(0xffffff).lerp(new THREE.Color(0xffc090), Math.max(dawn, dusk) * 0.7).lerp(new THREE.Color(0x6f86b8), night);
        hemi.intensity = 0.3 + (elev * 0.8 + dawn * 0.7) * (1 - night) + 0.05 * night;
        hemi.color.set(0xdff2ff).lerp(new THREE.Color(0x3b5a8c), night);
        warmLight.intensity = night * (nice ? 3.4 : 2.6); bulb.material.emissiveIntensity = night * 1.5;
        coldLight.intensity = nice ? 0 : night * 6;
        tvScreen.material.emissiveIntensity = night * (nice ? 0.15 : 1.6); tvLight.intensity = night * (nice ? 0 : 4.5); laptopScreen.material.emissiveIntensity = nice ? 0 : night * 2.2;
        // Smoko props come and go on the clock.
        const smokoAmt = smooth(10.4, 10.55, h) * (1 - smooth(11.25, 11.4, h)) + smooth(12.4, 12.55, h) * (1 - smooth(13.05, 13.2, h));
        cur.smoko = damp(cur.smoko, smokoAmt, 8, dt); smoko.scale.setScalar(Math.max(0.001, cur.smoko));
        // Knock-off: the ute reverses out, heads down the road, and the whole island turns over
        // under it to the street he lives on; the ute keeps driving and turns into his driveway.
        const T = h - LEAVE;
        const flip = smooth(0.3, 1.0, T);
        const homeAmt = smooth(0.55, 0.95, T), jobAmt = 1 - smooth(0.3, 0.6, T);
        cur.home = damp(cur.home, homeAmt, 10, dt); cur.job = damp(cur.job, jobAmt, 10, dt);
        // The two sets swap while the island turns: the job sinks into the ground first, then the home rises in place.
        // Squashed flat, a set still leaves its footprint on the grass, so it also drops below the turf and hides early.
        job.scale.y = Math.max(0.001, cur.job); job.position.y = -0.3 * (1 - cur.job); job.visible = cur.job > 0.08;
        home.scale.y = Math.max(0.001, cur.home); home.position.y = -0.3 * (1 - cur.home); home.visible = cur.home > 0.08;
        let moving = false;
        if (T > 0 && T <= 0.25) { const k = smooth(0, 0.25, T); ute.position.set(UX, 0, THREE.MathUtils.lerp(UZ, -3.7, k)); ute.rotation.y = -Math.PI / 2; moving = true; }
        else if (T > 0.25 && T <= 1.05) { const k = smooth(0.25, 1.05, T); ute.position.set(THREE.MathUtils.lerp(UX, 1.1, k), 0, -3.7); ute.rotation.y = THREE.MathUtils.lerp(-Math.PI / 2, -Math.PI, smooth(0.25, 0.4, T)); moving = true; }
        else if (T > 1.05 && T <= 1.3) { const k = smooth(1.05, 1.3, T); ute.position.set(1.1, 0, THREE.MathUtils.lerp(-3.7, -1.7, k)); ute.rotation.y = THREE.MathUtils.lerp(-Math.PI, -Math.PI / 2, smooth(1.05, 1.15, T)); moving = true; }
        else if (T > 1.3) { ute.position.set(1.1, 0, -1.7); ute.rotation.y = -Math.PI / 2; }
        else { ute.position.set(UX, 0, UZ); ute.rotation.y = -Math.PI / 2; }
        if (moving) wheels.forEach((w) => (w.rotation.y += dt * 12));
        // The customer's front door swings open while she is out.
        const doorAmt = nice ? smooth(16.6, 16.75, h) * (1 - smooth(17.6, 17.75, h)) : smooth(16.8, 16.95, h) * (1 - smooth(17.95, 18.1, h));
        jobHouse.hinge.rotation.y = damp(jobHouse.hinge.rotation.y, -1.7 * doorAmt, 8, dt);
        // Tiles.
        const prog = progressAt(h), nOn = prog * tiles.length;
        tiles.forEach((t, i) => { const want = i < nOn ? 1 : 0.001; t.scale.setScalar(damp(t.scale.x, want, 10, dt)); });
        // People follow their schedules.
        people.forEach(({ p, keys }) => {
          const s = place(keys, h);
          p.g.position.x = s.pos.x; p.g.position.z = s.pos.z; p.g.userData.baseY = s.pos.y;
          let dr = s.rot - p.g.rotation.y; dr = Math.atan2(Math.sin(dr), Math.cos(dr)); p.g.rotation.y += dr * (1 - Math.exp(-8 * dt));
          p.setPose(s.pose === 'walk' ? 'stand' : s.pose);
          p.setWalk(s.speed, !nice && p === roofer && s.speed > 0 ? 1 : 0);
          p.g.scale.setScalar((p.g.userData.scale ?? 1) * Math.max(0.001, s.fade));
          p.g.visible = s.pos.y > -2.5 && s.fade > 0.02;
          p.tick(now, dt);
        });
        // The island breathes.
        isle.position.y = Math.sin(now / 2600) * 0.06; isle.rotation.y = 0.35 + Math.PI * flip + Math.sin(now / 5200) * 0.015;
        // Camera: isometric, sitting low in the frame so the phone up top covers nothing that matters.
        const rx = (x: number, z: number) => x * Math.cos(0.35) + z * Math.sin(0.35), rz = (x: number, z: number) => -x * Math.sin(0.35) + z * Math.cos(0.35);
        const hx = HX + 1.4, hz = HZ + 1.0;
        const cx = THREE.MathUtils.lerp(0, rx(hx, hz), cur.home), cz = THREE.MathUtils.lerp(0, rz(hx, hz), cur.home);
        // On phones the evening banner sits over the top of the stage, so the home is framed lower.
        const portrait = stage.clientWidth < stage.clientHeight;
        camera.position.set(cx + 14, 12.5, cz + 14); camera.lookAt(cx, 1.1 + cur.home * (portrait ? 2.4 : 0.6), cz); camera.zoom = 1 + cur.home * 0.3; camera.updateProjectionMatrix();
        renderer.render(scene, camera);
        // Bubbles for this hour, with their screen anchors.
        return lines.filter((l) => h >= l.from && h < l.to).map((l) => ({ key: `${nice ? 'on' : 'off'}-${l.from}-${l.text}`, text: l.text, thought: !!l.thought, ndc: project(l.who.g, 2.05) }));
      };
      return { frame, resize, start: () => { running = true; }, stop: () => { running = false; }, get running() { return running; } };
    };

    const worlds = [makeWorld(false, canvases.off), makeWorld(true, canvases.on)];
    window.addEventListener('resize', () => worlds.forEach((w) => w.resize()));

    /* ── UI per beat: the line under the island, the banner, the timeline ── */
    const showBeat = (b: number) => {
      if (b === beat) return;
      beat = b;
      stage.setAttribute('data-beat', String(beat));
      times.forEach((t, i) => { t.classList.toggle('is-on', i === beat); t.setAttribute('aria-selected', i === beat ? 'true' : 'false'); });
      lines.forEach((l, i) => { if (i === beat) l.removeAttribute('hidden'); else l.setAttribute('hidden', ''); });
      banner(beat);
      if (beat < N - 1) clearEnd();
    };
    times.forEach((t, i) => t.addEventListener('click', () => { hour = MARKS[i] + 0.001; }));
    document.addEventListener('visibilitychange', () => { paused = document.hidden; });
    let hold = false;
    if (location.hostname === 'localhost') (window as any).__ww = { set: (h: number, w?: 'on' | 'off') => { hour = h; hold = true; if (w) setWorld(w); }, play: () => { hold = false; } };

    /* ── Bubbles: DOM elements that follow heads around the island ── */
    const bubbleBox = root.querySelector<HTMLElement>('[data-bubbles]')!;
    const live = new Map<string, HTMLElement>();
    const drawBubbles = (list: { key: string; text: string; thought: boolean; ndc: THREE.Vector3 }[], now: number) => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const keep = new Set<string>();
      // Keep bubbles clear of the notification stack (desktop: top-right of the stage).
      const sr = stage.getBoundingClientRect(), br = bannerList.children.length ? bannerList.getBoundingClientRect() : null;
      const avoid = br && br.width > 0 ? { l: br.left - sr.left - 10, b: br.bottom - sr.top + 10, wide: br.width > W * 0.7 } : null;
      list.forEach((b) => {
        keep.add(b.key);
        let el = live.get(b.key);
        if (!el) { el = document.createElement('div'); el.className = `ww__bubble ww__bubble--${world}${b.thought ? ' ww__bubble--thought' : ''}`; el.textContent = b.text; bubbleBox.appendChild(el); live.set(b.key, el); }
        let x = ((b.ndc.x + 1) / 2) * W, y = ((1 - b.ndc.y) / 2) * H - 8;
        const half = el.offsetWidth / 2 || 60, hgt = el.offsetHeight || 32;
        if (avoid && y - hgt < avoid.b && x + half > avoid.l) { if (avoid.wide) y = avoid.b + hgt; else x = avoid.l - half; }
        x = Math.min(W - half - 6, Math.max(half + 6, x)); y = Math.max(hgt + 14, y);
        el.style.left = `${x}px`; el.style.top = `${y}px`;
      });
      live.forEach((el, key) => { if (!keep.has(key)) { live.delete(key); el.classList.add('is-out'); el.dataset.out = String(now); } });
      // Sweep: anything fading for longer than its transition is gone, timers or not.
      bubbleBox.querySelectorAll<HTMLElement>('.is-out').forEach((el) => { if (now - Number(el.dataset.out || 0) > 320) el.remove(); });
    };

    /* ── The loop ── */
    let lastT = 0;
    const loop = (now: number) => {
      if (!playing) return;
      const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016); lastT = now;
      // The evening lingers: once everyone is home the clock runs at a third of the pace so the ending can be read.
      if (!paused && !reduced && !hold) { hour += dt * 1000 / LOOP_MS * (DAY1 - DAY0) * (hour >= 20.4 ? 0.33 : 1); if (hour >= DAY1) hour = DAY0; }
      const b = beatOf(hour);
      showBeat(b);
      const next = b < N - 1 ? MARKS[b + 1] : DAY1;
      bars.forEach((bar, i) => { bar.style.transition = 'none'; bar.style.width = i < b ? '100%' : i === b ? `${clamp01((hour - MARKS[b]) / (next - MARKS[b])) * 100}%` : '0'; });
      if (hour >= 21.0 && beat === N - 1) endBanner();
      const active = worlds.map((w) => w.frame(now, hour, dt, b));
      drawBubbles(active[world === 'on' ? 1 : 0], now);
      requestAnimationFrame(loop);
    };
    const start = () => {
      if (!started) { started = true; setWorld('off'); }
      if (playing) return; playing = true; lastT = performance.now(); worlds.forEach((w) => w.resize()); requestAnimationFrame(loop);
    };
    const stop = () => { playing = false; };
    worlds.forEach((w) => w.resize());
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.2 }).observe(stage);
      // Deep in the stage, the site steps aside: the nav fades so the banners read as the phone's.
      new IntersectionObserver((entries) => entries.forEach((e) => document.documentElement.classList.toggle('ww-immersed', e.isIntersecting)), { threshold: 0.72 }).observe(stage);
    } else start();
  });
</script>
