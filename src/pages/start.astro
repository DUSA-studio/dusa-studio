<script>
  // ─── Plan chooser: billing toggle + ?plan= preselect ───
  function initActivate() {
    const section = document.getElementById('activate');
    if (!section) return;

    const mBtn = document.getElementById('cycle-monthly');
    const aBtn = document.getElementById('cycle-annual');

    function setCycle(cycle) {
      const monthly = cycle === 'monthly';
      mBtn.classList.toggle('is-active', monthly);
      aBtn.classList.toggle('is-active', !monthly);
      mBtn.setAttribute('aria-selected', monthly ? 'true' : 'false');
      aBtn.setAttribute('aria-selected', monthly ? 'false' : 'true');
      section.querySelectorAll('[data-monthly]').forEach(function (el) {
        const val = el.getAttribute(monthly ? 'data-monthly' : 'data-annual');
        if (el.tagName === 'A') el.setAttribute('href', val);
        else el.textContent = val;
      });
    }

    mBtn.addEventListener('click', function () { setCycle('monthly'); });
    aBtn.addEventListener('click', function () { setCycle('annual'); });

    // Preselect the plan passed from pricing cards (/start?plan=starter)
    const wanted = new URLSearchParams(window.location.search).get('plan');
    if (wanted) {
      const card = section.querySelector('[data-plan="' + wanted + '"]');
      if (card) card.classList.add('is-preselected');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initActivate);
  } else {
    initActivate();
  }
</script>

<script>
  function initTrialAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initTrialAnimations, 100);
      return;
    }
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');

    // Above-the-fold (hero, form, plan chooser) renders with no animation:
    // a stalled tween must never blank the money page. Below-the-fold
    // sections get a light scroll-in that starts VISIBLE and only moves.
    gsap.from('.trial-features__header', {
      y: 24, duration: 0.6, ease: 'power3.out',
      scrollTrigger: { trigger: '.trial-features__header', start: 'top 85%', once: true }
    });

    gsap.from('.trial-features__card', {
      y: 20, duration: 0.5, stagger: 0.08, ease: 'power3.out',
      scrollTrigger: { trigger: '.trial-features__grid', start: 'top 85%', once: true }
    });

    gsap.from('.trial-cta__content', {
      y: 20, duration: 0.6, ease: 'power3.out',
      scrollTrigger: { trigger: '.trial-cta__content', start: 'top 85%', once: true }
    });
  }
  initTrialAnimations();

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && typeof gsap !== 'undefined') {
      gsap.ticker.wake();
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    }
  });

  // ─── TRIAL FORM SUBMISSION ───
  const trialForm = document.getElementById('trial-form');
  const trialSubmitBtn = document.getElementById('trial-submit');
  const trialSuccess = document.getElementById('trial-success');
  const trialError = document.getElementById('trial-error');

  trialForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!e.target.checkValidity()) {
      e.target.reportValidity();
      return;
    }
    trialSuccess.style.display = 'none';
    trialError.style.display = 'none';

    const formData = new FormData(trialForm);
    const data = {
      firstName: formData.get('firstName'),
      email: formData.get('email'),
      business: formData.get('business'),
      phone: formData.get('phone'),
    };

    // Pull tool stack from sessionStorage (set on pricing page)
    try {
      const toolTags = sessionStorage.getItem('dusa_tool_tags');
      const toolStack = sessionStorage.getItem('dusa_tool_stack');
      const currentSpend = sessionStorage.getItem('dusa_current_spend');
      const interests = sessionStorage.getItem('dusa_interests');
      if (toolTags) data.current_tools = toolTags;
      if (toolStack) data.tool_stack = JSON.parse(toolStack);
      if (currentSpend) data.current_spend = currentSpend;
      if (interests) data.dusa_interests = JSON.parse(interests);
    } catch(err) { /* silent */ }

    trialSubmitBtn.disabled = true;
    trialSubmitBtn.textContent = 'Setting up your account...';

    try {
      const res = await fetch('https://services.leadconnectorhq.com/hooks/rUKGht903K7MlneMT1NF/webhook-trigger/2f41fe3b-9c02-4958-acb1-2637525558de', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = '/thank-you';
      } else {
        trialError.style.display = 'flex';
      }
    } catch (err) {
      trialError.style.display = 'flex';
    } finally {
      trialSubmitBtn.disabled = false;
      trialSubmitBtn.textContent = 'Get Started';
    }
  });

  // ─── ROTATING TESTIMONIALS ───
  (function initTestimonialCarousel() {
    const container = document.getElementById('trial-testimonials');
    if (!container) return;

    const testimonials = container.querySelectorAll('.trial__testimonial');
    const dotsContainer = document.getElementById('testimonial-dots');
    let currentIndex = 0;
    let interval;

    // Build dots
    testimonials.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'trial__dot' + (i === 0 ? ' trial__dot--active' : '');
      dot.setAttribute('aria-label', 'Testimonial ' + (i + 1));
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    });

    function goTo(index) {
      testimonials[currentIndex].classList.remove('trial__testimonial--active');
      dotsContainer.children[currentIndex].classList.remove('trial__dot--active');
      currentIndex = index;
      testimonials[currentIndex].classList.add('trial__testimonial--active');
      dotsContainer.children[currentIndex].classList.add('trial__dot--active');
      resetInterval();
    }

    function next() {
      goTo((currentIndex + 1) % testimonials.length);
    }

    function resetInterval() {
      clearInterval(interval);
      interval = setInterval(next, 5000);
    }

    resetInterval();
  })();
</script>
