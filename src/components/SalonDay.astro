    const worlds = [makeWorld(false, canvases.off), makeWorld(true, canvases.on)];
    window.addEventListener('resize', () => worlds.forEach((w) => w.resize()));

    /* ── UI per beat: the line under the island, the banner, the timeline ── */
    const showBeat = (b: number) => {
