---
/**
 * IndustryPicker.astro
 *
 * "I run a..." The fastest route from "what is this?" to "that's me": a row of
 * glass chips, one per industry page, placed high on the home page. Labels
 * come from nav.industryLabels so every locale that has industry pages reads
 * them in its own language.
 */
import { INDUSTRY_ICONS } from '../config/industry-icons';
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.pick || {};
const IL: Record<string, string> = t?.nav?.industryLabels || {};
const lead = s.lead || 'I run a';
const more = s.more || 'Something else';
const sub = s.sub || 'Pick yours and see your week with DUSA.';
const order = ['tradies', 'salons', 'dentists', 'gyms', 'real-estate', 'restaurants', 'accountants', 'cleaning-services', 'photographers', 'personal-trainers', 'coaches', 'law-firms', 'property-managers', 'auto-repair', 'construction', 'ecommerce'];
const fallback: Record<string, string> = {
  'tradies': 'trade business', 'salons': 'salon or spa', 'dentists': 'dental practice', 'gyms': 'gym or studio', 'real-estate': 'real estate agency', 'restaurants': 'restaurant or cafe', 'accountants': 'accounting practice', 'cleaning-services': 'cleaning business', 'photographers': 'photography studio', 'personal-trainers': 'PT business', 'coaches': 'coaching business', 'law-firms': 'law firm', 'property-managers': 'property management agency', 'auto-repair': 'auto repair shop', 'construction': 'construction company', 'ecommerce': 'online store',
};
const chips = order.map((slug) => ({ slug, label: (s.labels && s.labels[slug]) || fallback[slug] || IL[slug] || slug, icon: INDUSTRY_ICONS[slug] }));
---

<section class="pick section--dark" aria-label={lead}>
  <div class="container">
    <div class="pick__row">
      <span class="pick__lead">{lead}<span class="pick__cursor" aria-hidden="true"></span></span>
      <ul class="pick__chips">
        {chips.map((c) => (
          <li>
            <a class="pick__chip" href={`/industries/${c.slug}`} data-page={`industries/${c.slug}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
              <span>{c.label}</span>
            </a>
          </li>
        ))}
        <li><a class="pick__chip pick__chip--more" href="/industries" data-page="industries"><span>{more} &rarr;</span></a></li>
      </ul>
    </div>
    <p class="pick__sub">{sub}</p>
  </div>
</section>

<style>
  .pick { padding: var(--space-md) 0 var(--space-xl); }
  .pick__row { display: flex; align-items: flex-start; gap: 1rem 1.25rem; flex-wrap: wrap; justify-content: center; }
  .pick__lead {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--warm-white);
    padding: 0.45rem 0;
    white-space: nowrap;
  }
  .pick__cursor { display: inline-block; width: 2px; height: 1.1em; margin-left: 0.35rem; vertical-align: -0.2em; background: var(--reef-aqua); animation: pickBlink 1.1s steps(2, start) infinite; }
  @keyframes pickBlink { to { visibility: hidden; } }
  .pick__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; max-width: 900px; }
  .pick__chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.5rem 0.9rem 0.5rem 0.75rem;
    border-radius: 100px;
    border: 1px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(135deg, rgba(247, 244, 239, 0.07), rgba(247, 244, 239, 0.025));
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    color: rgba(247, 244, 239, 0.82);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.2;
    min-height: 40px;
    transition: border-color var(--duration-fast), background var(--duration-fast), color var(--duration-fast), transform var(--duration-fast);
  }
  .pick__chip svg { width: 16px; height: 16px; color: var(--reef-aqua); flex-shrink: 0; }
  .pick__chip:hover { border-color: rgba(78, 216, 194, 0.5); background: rgba(78, 216, 194, 0.1); color: var(--warm-white); transform: translateY(-1px); }
  .pick__chip--more { border-style: dashed; color: rgba(247, 244, 239, 0.62); }
  .pick__sub { text-align: center; font-size: 0.875rem; color: rgba(247, 244, 239, 0.55); margin: var(--space-md) auto 0; max-width: none; }

  @media (max-width: 768px) {
    .pick__row { flex-direction: column; align-items: center; }
    .pick__chips { justify-content: center; }
    .pick__chip { font-size: 0.875rem; }
  }
  @media (prefers-reduced-motion: reduce) { .pick__cursor { animation: none; } }

  :global(html[data-theme="light"]) .pick__lead { color: var(--deep-black); }
  :global(html[data-theme="light"]) .pick__cursor { background: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__chip { border-color: rgba(12, 14, 20, 0.12); background: rgba(12, 14, 20, 0.03); color: rgba(12, 14, 20, 0.78); }
  :global(html[data-theme="light"]) .pick__chip svg { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__chip:hover { border-color: rgba(26, 58, 92, 0.5); background: rgba(26, 58, 92, 0.07); color: var(--deep-black); }
  :global(html[data-theme="light"]) .pick__chip--more { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .pick__sub { color: rgba(12, 14, 20, 0.58); }
</style>
