    };
    const dismiss = (el: HTMLElement) => { if (!el.isConnected || el.classList.contains('ww__banner--end')) return; el.classList.add('is-out'); window.setTimeout(() => el.remove(), 380); };
    let ended = false;
    const endBanner = () => {
      if (ended) return; ended = true;
