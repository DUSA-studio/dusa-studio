---
// ConnectedPlatform.astro — capability wheel + integrations grid.
//
// Structure: hub (DUSA) → AI band spanning every domain → six capability
// domains → the capabilities inside each. AI features sit inside the domains
// they actually serve and are tagged, so the "AI runs through everything"
// claim in the band is backed by named features rather than asserted.
import { BRAND_MARKS, WORDMARK_ONLY } from '../config/brand-marks';

interface Props { t?: Record<string, any>; }
const { t = {} } = Astro.props;
const c = t?.connected || {};

const eyebrow = c.eyebrow || 'One Platform';
const heading = c.heading || 'Everything';
const headingAccent = c.headingAccent || 'connected';
const sub = c.sub || 'The systems that run your business, and the apps they plug into.';
const gridHeading = c.gridHeading || 'Connects with';
const note = c.note || 'Plus 1,000+ more through Zapier and Make.';
const aiBandLabel = c.aiBand || 'AI ACROSS EVERYTHING';

/* ai: true marks a capability that is AI-powered. */
const DOMAINS = [
  { name: 'Capture', color: '#F0B24A', items: [
    { l: 'Funnels &\nlanding pages' }, { l: 'Websites\n& blogs' }, { l: 'Forms &\nsurveys' },
    { l: 'Chat widget', ai: true }, { l: 'Missed-call\ntext back' },
  ]},
  { name: 'Sales &\nPayments', color: '#D4956B', items: [
    { l: 'CRM &\npipelines' }, { l: 'Booking &\ncalendars' }, { l: 'Estimates\n& invoices' },
    { l: 'Payment\nlinks' }, { l: 'Subscriptions' },
  ]},
  { name: 'Conversations', color: '#6AAACF', items: [
    { l: 'Unified\ninbox' }, { l: 'Email' }, { l: 'SMS & MMS' },
    { l: 'Conversation\nAI', ai: true }, { l: 'Voice AI', ai: true },
  ]},
  { name: 'Marketing\n& Social', color: '#9B6BDB', items: [
    { l: 'Email\ncampaigns' }, { l: 'Social\nplanner' },
    { l: 'Content AI', ai: true }, { l: 'Memberships\n& courses' },
  ]},
  { name: 'Automation', color: '#4ED8C2', items: [
    { l: 'Workflows\n& triggers' }, { l: 'Smart\nfollow-up', ai: true },
    { l: 'Lead\nrouting' }, { l: 'Task\nautomation' },
  ]},
  { name: 'Reputation\n& Insight', color: '#36CDA4', items: [
    { l: 'Review\nrequests' }, { l: 'AI review\nreplies', ai: true },
    { l: 'Dashboards' }, { l: 'Attribution' },
  ]},
];

/* ─── Geometry, computed at build time so the SVG ships static ─── */
const CX = 340, CY = 340;
const R_HUB = 62, R_AI0 = 68, R_AI1 = 92, R_D0 = 98, R_D1 = 178, R_C0 = 182, R_C1 = 292;
const GAP = 0.012;

const pol = (r: number, a: number) => [CX + r * Math.cos(a), CY + r * Math.sin(a)];
function arc(r0: number, r1: number, a0: number, a1: number) {
  const [x0, y0] = pol(r1, a0), [x1, y1] = pol(r1, a1);
  const [x2, y2] = pol(r0, a1), [x3, y3] = pol(r0, a0);
  const laf = a1 - a0 > Math.PI ? 1 : 0;
  return `M${x0},${y0}A${r1},${r1} 0 ${laf} 1 ${x1},${y1}L${x2},${y2}A${r0},${r0} 0 ${laf} 0 ${x3},${y3}Z`;
}
const rgba = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
};

const total = DOMAINS.reduce((s, d) => s + d.items.length, 0);
let cursor = -Math.PI / 2;
const segments: any[] = [];

DOMAINS.forEach((d, di) => {
  const span = (d.items.length / total) * Math.PI * 2;
  const a0 = cursor, a1 = cursor + span;
  const mid = (a0 + a1) / 2;
  const [lx, ly] = pol((R_D0 + R_D1) / 2, mid);
  let deg = (mid * 180) / Math.PI;
  segments.push({
    kind: 'domain', di, d: arc(R_D0, R_D1, a0 + GAP, a1 - GAP),
    fill: rgba(d.color, 0.92), label: d.name, lx, ly,
    rot: deg > 90 && deg < 270 ? deg + 180 : deg, color: d.color,
  });

  const iSpan = span / d.items.length;
  d.items.forEach((it: any, ii: number) => {
    const b0 = a0 + ii * iSpan, b1 = b0 + iSpan;
    const m2 = (b0 + b1) / 2;
    const [ix, iy] = pol((R_C0 + R_C1) / 2, m2);
    let dg = (m2 * 180) / Math.PI;
    segments.push({
      kind: 'cap', di, d: arc(R_C0, R_C1, b0 + GAP, b1 - GAP),
      fill: it.ai ? 'rgba(78,216,194,0.16)' : rgba(d.color, 0.2),
      stroke: it.ai ? 'rgba(78,216,194,0.55)' : rgba(d.color, 0.42),
      label: it.l, lx: ix, ly: iy, ai: !!it.ai,
      rot: dg > 90 && dg < 270 ? dg + 180 : dg,
    });
  });
  cursor = a1;
});

const aiRing = arc(R_AI0, R_AI1, -Math.PI / 2 + 0.02, -Math.PI / 2 + Math.PI * 2 - 0.02);
---

<section class="cp section section--dark" id="connected-platform">
  <div class="container">
    <div class="cp__head reveal">
      <span class="label">{eyebrow}</span>
      <h2>{heading} <span class="gradient-text">{headingAccent}</span></h2>
      <p class="cp__sub">{sub}</p>
    </div>

    <div class="cp__body">
      <div class="cp__wheel-col reveal">
        <svg class="cp__wheel" viewBox="0 0 680 680" role="img"
             aria-label="DUSA capability wheel: six domains with AI spanning all of them">
          <title>What DUSA does</title>
          <desc>
            Six capability domains around a central hub, with an AI band spanning
            all of them: Capture, Sales and Payments, Conversations, Marketing and
            Social, Automation, and Reputation and Insight.
          </desc>

          <!-- AI band: continuous, spans every domain -->
          <path d={aiRing} fill="rgba(78,216,194,0.14)" stroke="rgba(78,216,194,0.45)" stroke-width="1" />
          <path id="cp-ai-path" d={`M ${CX - (R_AI0 + R_AI1) / 2},${CY} a ${(R_AI0 + R_AI1) / 2},${(R_AI0 + R_AI1) / 2} 0 1,1 ${(R_AI0 + R_AI1)},0`} fill="none" />
          <text class="cp__ai-label" font-size="8.5" letter-spacing="2.4" fill="#4ED8C2">
            <textPath href="#cp-ai-path" startOffset="50%" text-anchor="middle">{aiBandLabel}</textPath>
          </text>

          {segments.map((s) => (
            <path class={`cp__seg cp__seg--d${s.di}`} d={s.d} fill={s.fill}
                  stroke={s.stroke || 'none'} stroke-width={s.stroke ? 1 : 0} />
          ))}

          {segments.map((s) => (
            <g class={`cp__seg cp__seg--d${s.di}`}>
              <text x={s.lx} y={s.ly} text-anchor="middle" dominant-baseline="middle"
                    transform={`rotate(${s.rot} ${s.lx} ${s.ly})`}
                    font-size={s.kind === 'domain' ? 12 : 9}
                    font-weight={s.kind === 'domain' ? 700 : 500}
                    fill={s.kind === 'domain' ? '#0C0E14' : (s.ai ? '#8FF0DF' : 'rgba(247,244,239,0.9)')}>
                {s.label.split('\n').map((line: string, i: number, arr: string[]) => (
                  <tspan x={s.lx} dy={i === 0 ? -((arr.length - 1) * (s.kind === 'domain' ? 12 : 9) * 0.55) : (s.kind === 'domain' ? 13 : 10)}>{line}</tspan>
                ))}
              </text>
            </g>
          ))}

          <circle cx={CX} cy={CY} r={R_HUB} fill="#0C0E14" stroke="rgba(78,216,194,0.3)" stroke-width="1" />
          <text x={CX} y={CY - 5} text-anchor="middle" class="cp__hub-name">DUSA</text>
          <text x={CX} y={CY + 13} text-anchor="middle" class="cp__hub-sub">ONE LOGIN</text>
        </svg>

        <div class="cp__legend">
          {DOMAINS.map((d, i) => (
            <button class="cp__lg" data-domain={i} type="button">
              <i style={`background:${d.color}`}></i>{d.name.replace('\n', ' ')}
            </button>
          ))}
        </div>
      </div>

      <div class="cp__grid-col reveal">
        <div class="cp__grid-head">{gridHeading}</div>
        <div class="cp__grid">
          {BRAND_MARKS.map((b) => (
            <div class="cp__chip" title={b.name}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={b.path} /></svg>
              <span>{b.name}</span>
            </div>
          ))}
          {WORDMARK_ONLY.map((n) => (
            <div class="cp__chip cp__chip--word" title={n}><span>{n}</span></div>
          ))}
        </div>
        <p class="cp__note">{note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cp__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-lg); }
  .cp__head h2 { font-weight: 600; margin-top: var(--space-xs); }
  .cp__sub { color: rgba(247, 244, 239, 0.55); margin-top: var(--space-sm); font-size: 1.0625rem; }

  .cp__body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .cp__wheel { width: 100%; height: auto; display: block; }
  .cp__ai-label { font-family: var(--font-mono); }
  .cp__hub-name { font-family: var(--font-headline); font-size: 20px; font-weight: 700; fill: var(--warm-white); }
  .cp__hub-sub { font-family: var(--font-mono); font-size: 7.5px; letter-spacing: 1.8px; fill: rgba(78, 216, 194, 0.85); }

  .cp__seg { transition: opacity var(--duration-normal) var(--ease-out); }
  .cp__wheel-col.is-dim .cp__seg:not(.is-on) { opacity: 0.15; }

  .cp__legend { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: var(--space-md); }
  .cp__lg {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: inherit; font-size: 0.75rem; color: rgba(247, 244, 239, 0.65);
    background: rgba(247, 244, 239, 0.04); border: 1px solid rgba(247, 244, 239, 0.09);
    border-radius: 999px; padding: 0.35rem 0.7rem; cursor: pointer;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .cp__lg:hover, .cp__lg:focus-visible { color: var(--warm-white); border-color: rgba(78, 216, 194, 0.4); }
  .cp__lg i { width: 8px; height: 8px; border-radius: 2px; }

  .cp__grid-head {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.4); margin-bottom: var(--space-sm);
  }
  .cp__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .cp__chip {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
    background: rgba(247, 244, 239, 0.045); border: 1px solid rgba(247, 244, 239, 0.09);
    border-radius: var(--radius-sm, 10px); padding: 0.75rem 0.4rem; min-height: 68px;
    transition: border-color var(--duration-fast), background var(--duration-fast);
  }
  .cp__chip:hover { border-color: rgba(78, 216, 194, 0.4); background: rgba(78, 216, 194, 0.06); }
  .cp__chip svg { width: 20px; height: 20px; }
  .cp__chip svg path { fill: rgba(247, 244, 239, 0.75); transition: fill var(--duration-fast); }
  .cp__chip:hover svg path { fill: var(--warm-white); }
  .cp__chip span { font-size: 0.6875rem; color: rgba(247, 244, 239, 0.6); text-align: center; line-height: 1.25; }
  .cp__chip--word span { font-weight: 600; font-size: 0.75rem; color: rgba(247, 244, 239, 0.72); }
  .cp__note { font-size: 0.75rem; color: rgba(247, 244, 239, 0.38); margin-top: var(--space-sm); text-align: center; }

  @media (max-width: 1024px) {
    .cp__body { grid-template-columns: 1fr; gap: var(--space-lg); }
    .cp__wheel { max-width: 560px; margin: 0 auto; }
  }
  @media (max-width: 700px) {
    /* Rotated capability labels stop being legible below this width, so the
       outer ring is hidden and the detail moves to the list underneath. */
    .cp__wheel { max-width: 340px; }
    .cp__seg--cap-text { display: none; }
    .cp__grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .cp__sub { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cp__hub-name { fill: var(--deep-black); }
  :global(html[data-theme="light"]) .cp__chip { background: rgba(12, 14, 20, 0.03); border-color: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cp__chip svg path { fill: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .cp__chip span { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cp__lg { color: rgba(12, 14, 20, 0.65); border-color: rgba(12, 14, 20, 0.12); }
</style>

<script>
  (function () {
    const col = document.querySelector('.cp__wheel-col');
    if (!col) return;
    const clear = () => {
      col.classList.remove('is-dim');
      col.querySelectorAll('.cp__seg').forEach((s) => s.classList.remove('is-on'));
    };
    col.querySelectorAll('.cp__lg').forEach((btn) => {
      const on = () => {
        clear();
        col.classList.add('is-dim');
        col.querySelectorAll('.cp__seg--d' + btn.getAttribute('data-domain'))
           .forEach((s) => s.classList.add('is-on'));
      };
      btn.addEventListener('mouseenter', on);
      btn.addEventListener('focus', on);
      btn.addEventListener('mouseleave', clear);
      btn.addEventListener('blur', clear);
    });
  })();
</script>
