---
/**
 * PricingContent.astro
 *
 * Shared pricing page content used by all locale-specific pricing pages.
 * Accepts region config, translations, and pre-converted prices as props.
 *
 * The tool replacement comparison costs and feature comparison table
 * remain in English (tool names are brand names) but currency values
 * are converted using the provided convertPrice function.
 */
import { convertPrice } from '../i18n/regions.js';
import { getRegionalCompetitors } from '../i18n/competitors.js';

interface Props {
  region: {
    lang: string;
    label: string;
    currency: string;
    symbol: string;
    locale: string;
    rate: number;
  };
  t: Record<string, any>;
  prices: {
    launchpad: number;
    starter: number;
    growth: number;
  };
  regionKey: string;
}

const { region, t, prices, regionKey } = Astro.props;

const p = t.pricing;
const sym = region.symbol;

/* Regional competitors for this market */
const competitors = getRegionalCompetitors(regionKey);
const topCompetitors = competitors.slice(0, 4);
const hasLocalCompetitors = topCompetitors.some((c: any) => c.local);
const langPrefix = region.lang === 'en' ? '' : `/${regionKey}`;

/* Helper to convert a tool comparison cost from AUD */
function convertToolCost(audCost: number): number {
  if (region.rate === 1) return audCost;
  return Math.round(audCost * region.rate);
}

const tiers = [
  {
    id: 'launchpad',
    name: p.tierLaunchpad,
    price: String(prices.launchpad),
    period: p.perMonth,
    tagline: p.launchpadTagline,
    description: p.launchpadDesc,
    highlights: [
      '1 core system of your choice',
      '9 systems to choose from',
      'Full dashboard access',
      'Basic analytics',
      'AI chat support',
      'Community access',
    ],
    cta: p.getStarted,
    ctaLink: '/start',
    highlight: false,
    badge: p.badgeEntry,
    style: 'entry',
  },
  {
    id: 'starter',
    name: p.tierStarter,
    price: String(prices.starter),
    period: p.perMonth,
    tagline: p.starterTagline,
    description: p.starterDesc,
    highlights: [
      'All 9 core systems included',
      'CRM + pipeline management',
      'Email & SMS marketing',
      'Funnel & website builder',
      'Booking, social & reputation',
      'Invoicing, forms & surveys',
      'Workflow automations',
      'AI chat support',
    ],
    cta: p.getStarted,
    ctaLink: '/start',
    highlight: false,
    badge: null,
    style: 'default',
  },
  {
    id: 'growth',
    name: p.tierGrowth,
    price: String(prices.growth),
    period: p.perMonth,
    tagline: p.growthTagline,
    description: p.growthDesc,
    highlights: [
      'Everything in Starter',
      'Unlimited contacts & workflows',
      'Advanced automation builder',
      'AI-powered responses',
      'Custom reporting dashboards',
      'Priority support',
      'Onboarding strategy session',
      'Dedicated community channel',
    ],
    cta: p.getStarted,
    ctaLink: '/start',
    highlight: true,
    badge: p.badgeBestValue,
    style: 'pop',
  },
  {
    id: 'bespoke',
    name: p.tierBespoke,
    price: null,
    period: null,
    tagline: p.bespokeTagline,
    description: p.bespokeDesc,
    highlights: [
      'Everything in Growth',
      'Multi-location support',
      'Team user accounts',
      'Custom integrations',
      'Dedicated account manager',
      'Monthly strategy reviews',
      'Custom automation builds',
      'Phone support line',
    ],
    cta: p.letsTalk,
    ctaLink: 'https://link.dusa.studio/widget/bookings/dusa-demo',
    highlight: false,
    badge: p.badgeCustom,
    style: 'premium',
  },
];

/* ─── Tool Replacement Comparison (base costs in AUD, converted for display) ─── */
const replacements = [
