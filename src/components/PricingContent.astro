  html[data-theme="light"] .pricing-card__badge--default:hover { background: var(--mist-blue); color: var(--warm-white); border-color: var(--mist-blue); box-shadow: 0 0 24px rgba(106, 170, 207, 0.55), 0 0 60px rgba(106, 170, 207, 0.2); transform: translateX(-50%) translateY(-2px) scale(1.05); }
