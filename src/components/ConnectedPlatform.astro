  /* ─── Hover hint: mint, and under the graphic where it can be read ─── */
  .cp__hint {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    width: fit-content; margin: var(--space-md) auto 0; padding: 0.4rem 0.95rem;
    font-size: 0.75rem; color: #8FF2E1; max-width: none;
    background: rgba(78, 216, 194, 0.07);
    border: 1px solid rgba(78, 216, 194, 0.28);
    border-radius: 999px;
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-lip);
  }
  .cp__hint i {
    width: 6px; height: 6px; border-radius: 50%; background: var(--reef-aqua);
    box-shadow: 0 0 8px rgba(78, 216, 194, 0.9);
    animation: cpPulse 2.4s ease-in-out infinite;
  }
  @keyframes cpPulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
  :global(html[data-theme="light"]) .cp__hint {
    color: #0B5F55; background: rgba(78, 216, 194, 0.14);
    border-color: rgba(27, 156, 139, 0.4);
  }

  .cp__head { text-align: center; max-width: 680px; margin: 0 auto var(--space-md); }
  .cp__head h2 { font-weight: 600; margin-top: var(--space-xs); }
  .cp__sub { color: rgba(247, 244, 239, 0.55); margin: var(--space-sm) auto 0; font-size: 1.0625rem; max-width: 52ch; }

  .cp__stats {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 0 var(--space-lg);
    margin: var(--space-lg) auto 0; width: fit-content;
    padding: 0.85rem var(--space-md);
    background: var(--glass-bg); border: 1px solid var(--glass-edge);
    border-radius: 16px; box-shadow: var(--glass-lip);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
  }
  .cp__stat { text-align: center; position: relative; padding: 0 var(--space-sm); }
  .cp__stat + .cp__stat::before {
    content: ''; position: absolute; left: 0; top: 18%; height: 64%; width: 1px;
    background: rgba(247, 244, 239, 0.12);
  }
  .cp__stat dt {
    font-family: var(--font-headline); font-size: 1.875rem; font-weight: 700; line-height: 1.1;
    background: linear-gradient(150deg, var(--warm-white) 0%, var(--mist-blue) 70%, var(--reef-aqua) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .cp__stat dd {
    margin: 2px 0 0; font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: rgba(247, 244, 239, 0.42);
  }

  /* ─── Wheel ─── */
  .cp__stage { position: relative; max-width: 780px; margin: 0 auto; container-type: inline-size; }
  .cp__aura {
    position: absolute; inset: -12%;
    background: radial-gradient(circle at 50% 50%,
      rgba(78, 216, 194, 0.14) 0%, rgba(26, 58, 92, 0.18) 40%, rgba(12, 14, 20, 0) 70%);
    filter: blur(22px); pointer-events: none; z-index: 0;
  }
  .cp__wheel { position: relative; z-index: 1; width: 100%; height: auto; display: block; }

  .cp__dom-text { font-family: var(--font-headline); font-size: 15px; font-weight: 700; fill: #0C0E14; letter-spacing: 0.05em; }
  .cp__cap-text { font-family: var(--font-body); font-size: 11.5px; font-weight: 500; fill: rgba(247, 244, 239, 0.86); }
  .cp__cap-text.is-ai-text { fill: #A6F5E7; }
  .cp__ai-label { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 1.6px; fill: #8FF2E1; }
  .cp__ai-dash { transform-origin: center; animation: cpSpin 50s linear infinite; }

  /* ─── Agent journeys ───
     The dot follows the channel between tiles, slows as it is routed at the
     core, then continues out to its destination. */
  .cp__flows { pointer-events: none; }
  .cp__flow {
    offset-rotate: 0deg; opacity: 0;
    animation: cpFlow var(--dur, 6s) linear var(--delay, 0s) infinite;
  }
  @keyframes cpFlow {
    0%   { offset-distance: 0%;   opacity: 0; }
    7%   { opacity: 1; }
    38%  { offset-distance: 44%; }
    54%  { offset-distance: 56%; }
    93%  { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  /* Without motion-path support the dots would stack at the SVG origin. */
  @supports not (offset-path: path('M0,0 L1,1')) { .cp__flows { display: none; } }

  /* Core motion: a slow sweep, a counter-rotating inner ring, and a glow that
     breathes, so the middle has depth without competing with the readout. */
  .cp__sweep { transform-origin: 380px 380px; animation: cpSpin 14s linear infinite; }
  .cp__core-dash { transform-origin: 380px 380px; animation: cpSpin 26s linear infinite reverse; }
