---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { INDUSTRY_ICONS } from '../../../config/industry-icons';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/de.json';
const lang = 'de';
const region = 'de';

const industries = [
  {
    title: 'Immobilien',
    desc: 'Pipeline-Management, automatisierte Nachfassaktionen nach Besichtigungen und Käufer-Matching für Makler, die mehr Abschlüsse erzielen wollen.',
    slug: '/de/industries/real-estate',
  },
  {
    title: 'Fitnessstudios',
    desc: 'Mitglieder-Onboarding, Kurserinnerungen, Rückgewinnungskampagnen und Empfehlungstracking, um Abwanderung zu reduzieren und Kurse zu füllen.',
    slug: '/de/industries/gyms',
  },
  {
    title: 'Handwerk',
    desc: 'Verpasste-Anruf-SMS, Angebotspipelines, Terminplanung und Rechnungserinnerungen für Handwerker, die zu beschäftigt auf der Baustelle sind.',
    slug: '/de/industries/tradies',
  },
  {
    title: 'Restaurants',
    desc: 'Reservierungserinnerungen, Bewertungsanfragen nach dem Besuch, Geburtstagskampagnen und digitale Treueprogramme.',
    slug: '/de/industries/restaurants',
  },
  {
    title: 'Salons und Spas',
    desc: 'Online-Buchung, automatische Erinnerungen, Wiederbuchungskampagnen und Kundenpräferenz-Tracking, um jeden Platz zu füllen.',
    slug: '/de/industries/salons',
  },
  {
    title: 'Steuerberater',
    desc: 'Automatisierte Dokumentenerfassung, Fristenerinnerungen und ganzjährige Mandantenbindung über die Steuersaison hinaus.',
    slug: '/de/industries/accountants',
  },
  {
    title: 'Zahnarztpraxen',
    desc: 'Recall-Erinnerungen, Neupatientengewinnung, Bewertungsgenerierung und automatische Nachverfolgung von Behandlungsplänen.',
    slug: '/de/industries/dentists',
  },
  {
    title: 'Fotografen',
    desc: 'Automatische Antworten auf Anfragen, Vertragsworkflows, Terminerinnerungen, Galerieversand und Print-Upsell-Sequenzen.',
    slug: '/de/industries/photographers',
  },
  {
    title: 'Bauunternehmen',
    desc: 'Lead-Tracking, Angebotsnachverfolgung, Meilenstein-Kommunikation und Zahlungseinzug für Bauunternehmer.',
    slug: '/de/industries/construction',
  },
  {
    title: 'Personal Trainer',
    desc: 'Lead-Magnet-Funnels, Beratungsbuchung, Transformations-Showcases und automatisierte Kunden-Check-ins.',
    slug: '/de/industries/personal-trainers',
  },
  {
    title: 'Reinigungsdienste',
    desc: 'Verwaltung wiederkehrender Buchungen, Qualitätsnachfragen, Teamplanung und Upsell-Kampagnen für Reinigungsunternehmen.',
    slug: '/de/industries/cleaning-services',
  },
  {
    title: 'Anwaltskanzleien',
    desc: 'Automatisierte Aufnahmeformulare, Fallstatus-Updates, Empfehlungstracking und Thought-Leadership-Inhalte im Rahmen der Compliance.',
    slug: '/de/industries/law-firms',
  },
  {
    title: 'Hausverwaltungen',
    desc: 'Automatisierung des Mieter-Lebenszyklus, Wartungsanfrage-Pipelines, Mieterinnerungen und Mietvertragsverlängerungskampagnen.',
    slug: '/de/industries/property-managers',
  },
  {
    title: 'Autowerkstätten',
    desc: 'Automatische Serviceerinnerungen, saisonale Kampagnen, Bewertungsgenerierung und Treueprogramme für Werkstätten.',
    slug: '/de/industries/auto-repair',
  },
  {
    title: 'Coaches und Berater',
    desc: 'Discovery-Call-Funnels, Onboarding-Sequenzen, Terminplanung und Testimonial-Sammlung, um Ihre Praxis zu skalieren.',
    slug: '/de/industries/coaches',
  },
  {
    title: 'E-Commerce',
    desc: 'Post-Purchase-Sequenzen, Bewertungsautomatisierung, Cross-Sell-Flows, VIP-Segmentierung und Geburtstagsbelohnungen.',
    slug: '/de/industries/ecommerce',
  },
];
---

<BaseLayout
  t={tData}
  title="Branchen | DUSA.studio"
  description="DUSA ist für Ihre Branche gemacht. Entdecken Sie, wie unsere Wachstumsplattform für Immobilien, Handwerk, Fitnessstudios, Restaurants, Salons, Zahnarztpraxen und mehr funktioniert."
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Branchen</span>
        <h1>Gemacht für <span class="gradient-text">Ihre</span> Branche</h1>
        <p class="ind-hero__sub">
          Jedes Unternehmen ist anders. Deshalb passt sich DUSA an Ihre Arbeitsweise an, mit Pipelines, Automatisierungen und Workflows, die speziell für Ihre Branche entwickelt wurden. Finden Sie Ihre Branche unten.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Industry Grid ═══ -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={INDUSTRY_ICONS[ind.slug.split('/').pop()]} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">Mehr erfahren &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">Ihre Branche nicht dabei?</h2>
        <p class="ind-cta__desc">DUSA funktioniert für jedes dienstleistungsbasierte Unternehmen. Kontaktieren Sie uns und wir zeigen Ihnen, wie es in Ihren Workflow passt.</p>
        <div class="ind-cta__buttons">
          <a href="/de/start" class="btn btn--primary">Jetzt starten</a>
          <a href="/de/contact" class="btn btn--outline">Kontakt aufnehmen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://dusa.studio/de/" },
    { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://dusa.studio/de/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
