    transition: opacity 0.16s var(--ease-out);
  }
  .cp__readout-detail { opacity: 0; }
  .cp__readout.is-detail .cp__readout-default { opacity: 0; }
  .cp__readout.is-detail .cp__readout-detail { opacity: 1; }
  .cp__readout-brand {
    font-family: var(--font-headline); font-size: 4cqw; font-weight: 700;
    letter-spacing: 0.02em; line-height: 1;
    background: linear-gradient(150deg, var(--warm-white) 0%, var(--mist-blue) 72%, var(--reef-aqua) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .cp__readout-sub { font-family: var(--font-mono); font-size: 1.2cqw; letter-spacing: 0.22em; color: rgba(78, 216, 194, 0.95); }
  .cp__readout-hint {
    display: inline-flex; align-items: center; gap: 0.4em; opacity: 0.75;
    font-size: 1.15cqw; color: rgba(247, 244, 239, 0.3); margin-top: 0.35rem; }
  .cp__readout-hint i {
    width: 0.45em; height: 0.45em; border-radius: 50%; background: var(--reef-aqua);
    animation: cpPulse 2.4s ease-in-out infinite;
  }
  @keyframes cpPulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  .cp__readout-domain { font-family: var(--font-mono); font-size: 1.2cqw; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(78, 216, 194, 0.9); }
  .cp__readout-name { font-family: var(--font-headline); font-size: 2.5cqw; font-weight: 700; color: var(--warm-white); line-height: 1.15; }
  .cp__readout-desc { font-size: 1.6cqw; line-height: 1.35; color: rgba(247, 244, 239, 0.62); margin-top: 0.2rem; }


  /* ─── Item tooltip ───
     Sits beside the tile it describes, because that is where the eye already
     is. The hub therefore shows only the domain while hovering, so the two are
     not saying the same thing twice. */
  .cp__tip {
    position: fixed; z-index: 40; left: 0; top: 0;
    display: grid; gap: 0.15rem; justify-items: start;
    max-width: 13.5rem; padding: 0.7rem 0.9rem;
