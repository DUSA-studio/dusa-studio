---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';

const title = 'Marketing para Oficinas Mecanicas | DUSA.studio';
const description = 'Automatize lembretes de revisao, solicitacoes de avaliacao e programas de fidelidade. O DUSA e a plataforma de crescimento tudo-em-um para oficinas mecanicas.';

const painPoints = [
  {
    icon: '🔩',
    title: 'Clientes So Aparecem Quando Algo Quebra',
    desc: 'Sem comunicacao proativa, seu negocio depende inteiramente de emergencias. Voce perde receita de manutencao preventiva todo mes.',
  },
  {
    icon: '⏰',
    title: 'Sem Sistema de Lembrete de Revisao',
    desc: 'Troca de oleo, rodizio de pneus, revisoes agendadas. Seus clientes esquecem, e voce nao tem como lembra-los automaticamente.',
  },
  {
    icon: '⭐',
    title: 'Poucas Avaliacoes Online',
    desc: 'Clientes satisfeitos vao embora sem que ninguem peca uma avaliacao. Enquanto isso, o unico cliente insatisfeito encontra o Google sozinho.',
  },
  {
    icon: '🎁',
    title: 'Sem Programa de Fidelidade',
    desc: 'Clientes recorrentes recebem a mesma experiencia que os de primeira vez. Nao ha recompensa pela fidelidade e nenhum motivo para escolher voce em vez da oficina ao lado.',
  },
];

const features = [
  {
    title: 'Automacao de Lembretes de Revisao',
    desc: 'Lembretes automaticos por SMS e email para troca de oleo, rodizio de pneus e revisoes agendadas com base em tempo ou quilometragem.',
  },
  {
    title: 'Campanhas Sazonais',
    desc: 'Campanhas prontas para troca de pneus no inverno, verificacao de arrefecimento no verao e preparacao para viagens de feriado. Lance em minutos.',
  },
  {
    title: 'Automacao de Solicitacao de Avaliacoes',
    desc: 'Envie automaticamente solicitacoes de avaliacao apos cada servico concluido. Construa sua reputacao no Google no piloto automatico.',
  },
  {
    title: 'Recompensas de Fidelidade',
    desc: 'Acompanhe visitas e recompense clientes recorrentes com descontos, servicos gratuitos ou agendamento prioritario. Mantenha-os voltando.',
  },
  {
    title: 'Historico do Veiculo',
    desc: 'Cada servico, cada peca, cada anotacao registrada por veiculo. Saiba exatamente o que foi feito e quando, para cada cliente.',
  },
];

const pipeline = [
  { stage: 'Primeira Visita', desc: 'Cliente chega na oficina ou agenda online' },
  { stage: 'Revisao Pendente', desc: 'Data da proxima revisao calculada automaticamente' },
  { stage: 'Lembrete Enviado', desc: 'SMS ou email enviado no momento certo' },
  { stage: 'Agendado', desc: 'Cliente confirma seu agendamento' },
  { stage: 'Revisao Concluida', desc: 'Servico realizado, solicitacao de avaliacao enviada' },
  { stage: 'Proxima Revisao', desc: 'Ciclo reinicia para a proxima janela de servico' },
];

const stats = [
  { value: '68%', label: 'dos clientes esquecem a revisao de rotina sem um lembrete' },
  { value: '3.2x', label: 'mais visitas recorrentes com lembretes automaticos de revisao' },
  { value: '85%', label: 'dos consumidores confiam em avaliacoes online tanto quanto recomendacoes pessoais' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dusa.studio/' },
    { '@type': 'ListItem', position: 2, name: 'Industrias', item: 'https://dusa.studio/br/industries' },
    { '@type': 'ListItem', position: 3, name: 'Oficinas Mecanicas', item: 'https://dusa.studio/br/industries/auto-repair' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="ar-hero section section--dark">
    <div class="container">
      <div class="ar-hero__content">
        <span class="label">Oficinas Mecanicas</span>
        <h1><span class="gradient-text">Automacao de marketing</span> para oficinas mecanicas</h1>
        <p class="ar-hero__sub">
          Transforme clientes de emergencia em clientes fieis com lembretes automaticos de revisao, solicitacoes de avaliacao e recompensas.
        </p>
        <div class="ar-hero__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ar-pain section section--dark">
    <div class="container">
      <div class="ar-pain__header">
        <span class="label">O Problema</span>
        <h2>A maioria das oficinas espera o <span class="gradient-text">telefone tocar</span></h2>
        <p class="ar-pain__intro">Marketing reativo significa receita imprevisivel. Veja o que acontece quando voce nao tem um sistema para trazer clientes de volta.</p>
      </div>
      <div class="ar-pain__grid">
        {painPoints.map((point) => (
          <div class="ar-pain__card">
            <span class="ar-pain__icon">{point.icon}</span>
            <h3 class="ar-pain__card-title">{point.title}</h3>
            <p class="ar-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ar-solution section section--dark">
    <div class="container">
      <div class="ar-solution__header">
        <span class="label">A Solucao</span>
        <h2>Como o DUSA funciona para <span class="gradient-text">oficinas mecanicas</span></h2>
        <p class="ar-solution__intro">Marketing proativo que traz clientes de volta antes mesmo de pensarem na concorrencia.</p>
      </div>
      <div class="ar-solution__grid">
        {features.map((feature) => (
          <div class="ar-solution__card">
            <h3 class="ar-solution__card-title">{feature.title}</h3>
            <p class="ar-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ar-pipeline section section--dark">
    <div class="container">
      <div class="ar-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Seu <span class="gradient-text">pipeline de servicos</span> em um relance</h2>
      </div>
      <div class="ar-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="ar-pipeline__stage">
            <div class="ar-pipeline__number">{i + 1}</div>
            <h3 class="ar-pipeline__stage-title">{step.stage}</h3>
            <p class="ar-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ar-stats section section--dark">
    <div class="container">
      <div class="ar-stats__header">
        <span class="label">Impacto</span>
        <h2>Os numeros falam por <span class="gradient-text">si mesmos</span></h2>
      </div>
      <div class="ar-stats__grid">
        {stats.map((stat) => (
          <div class="ar-stats__card">
            <span class="ar-stats__value">{stat.value}</span>
            <p class="ar-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ar-cta section section--dark">
    <div class="container">
      <div class="ar-cta__box">
        <h2>Pronto para lotar suas <span class="gradient-text">baias de servico</span>?</h2>
        <p class="ar-cta__sub">Tenha seus lembretes de revisao, automacao de avaliacoes e programa de fidelidade funcionando em uma so plataforma.</p>
        <div class="ar-cta__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
          <a href="/blog/marketing-for-auto-repair" class="btn btn--outline">Leia o guia</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .ar-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ar-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ar-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ar-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .ar-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .ar-pain {
    padding: var(--space-2xl) 0;
  }
  .ar-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ar-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ar-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ar-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .ar-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ar-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ar-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .ar-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ar-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .ar-solution {
    padding: var(--space-2xl) 0;
  }
  .ar-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ar-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ar-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ar-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ar-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ar-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ar-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ar-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .ar-pipeline {
    padding: var(--space-2xl) 0;
  }
  .ar-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ar-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ar-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .ar-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .ar-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .ar-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ar-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .ar-stats {
    padding: var(--space-2xl) 0;
  }
  .ar-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ar-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ar-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ar-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ar-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .ar-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .ar-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .ar-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .ar-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .ar-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .ar-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .ar-hero__content h1,
  :global(html[data-theme="light"]) .ar-pain__header h2,
  :global(html[data-theme="light"]) .ar-solution__header h2,
  :global(html[data-theme="light"]) .ar-pipeline__header h2,
  :global(html[data-theme="light"]) .ar-stats__header h2,
  :global(html[data-theme="light"]) .ar-cta__box h2,
  :global(html[data-theme="light"]) .ar-pain__card-title,
  :global(html[data-theme="light"]) .ar-solution__card-title,
  :global(html[data-theme="light"]) .ar-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ar-hero__sub,
  :global(html[data-theme="light"]) .ar-pain__intro,
  :global(html[data-theme="light"]) .ar-solution__intro,
  :global(html[data-theme="light"]) .ar-pain__card-desc,
  :global(html[data-theme="light"]) .ar-solution__card-desc,
  :global(html[data-theme="light"]) .ar-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ar-stats__label,
  :global(html[data-theme="light"]) .ar-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .ar-pain__card,
  :global(html[data-theme="light"]) .ar-solution__card,
  :global(html[data-theme="light"]) .ar-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .ar-pain__card:hover,
  :global(html[data-theme="light"]) .ar-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .ar-stats__card,
  :global(html[data-theme="light"]) .ar-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .ar-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ar-stats__value {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ar-pain__grid {
      grid-template-columns: 1fr;
    }
    .ar-solution__grid {
      grid-template-columns: 1fr;
    }
    .ar-stats__grid {
      grid-template-columns: 1fr;
    }
    .ar-pipeline__stages {
      flex-direction: column;
    }
    .ar-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .ar-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
