---
// DIRECTION A — "The Receipt" (v2)
//
// v1 put two receipts side by side, which meant the reader had to cross-
// reference two cards to work out that DUSA covers the same jobs. v2 is a
// SINGLE ledger with aligned rows: one scan left to right per line, from the
// job, to what you pay for it today, to "included". Nothing to hold in memory.
//
// The job column leads rather than the brand name, because the argument is
// "you are paying eight times for eight jobs", not "we have heard of Birdeye".
import { STACK, DUSA_COST, STACK_TOTAL, SAVING, MULTIPLE, money } from '../../config/stack-compare';
---

<div class="rc">
  <div class="rc__sheet">

    <div class="rc__cols" role="presentation">
      <span class="rc__col">What it does</span>
      <span class="rc__col">What you pay today</span>
      <span class="rc__col rc__col--aqua">With DUSA</span>
    </div>

    <ul class="rc__rows">
      {STACK.map((tool, i) => (
        <li class="rc__row" style={`--i:${i}`}>
          <span class="rc__job">{tool.job}</span>
          <span class="rc__today">
            <span class="rc__brand">{tool.name}</span>
            <span class="rc__dots" aria-hidden="true"></span>
            <span class="rc__cost">{money(tool.cost)}</span>
          </span>
          <span class="rc__inc">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="rc__tick">
              <path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Included
          </span>
        </li>
      ))}

      <!-- The one row that is not a swap. It is what the stack cannot buy. -->
      <li class="rc__row rc__row--bonus">
        <span class="rc__job">AI</span>
        <span class="rc__today rc__today--none">
          <span class="rc__brand">Not available</span>
          <span class="rc__dots" aria-hidden="true"></span>
          <span class="rc__cost rc__cost--none">&mdash;</span>
        </span>
        <span class="rc__inc">
          <svg viewBox="0 0 16 16" aria-hidden="true" class="rc__tick">
            <path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Answers, books, follows up
        </span>
      </li>
    </ul>

    <div class="rc__rule" aria-hidden="true"></div>

    <div class="rc__totals">
      <span class="rc__job rc__job--total">Every month</span>
      <span class="rc__total rc__total--red">
        <b>{money(STACK_TOTAL)}</b>
        <em>{STACK.length} logins, {STACK.length} bills</em>
      </span>
      <span class="rc__total rc__total--aqua">
        <b>{money(DUSA_COST)}</b>
        <em>One login, one bill</em>
      </span>
    </div>

  </div>

  <p class="rc__payoff">
    You keep <b>{money(SAVING)}</b> a month.
    <span>The scattered stack costs {MULTIPLE}x more and still does less.</span>
  </p>
</div>

<style>
  .rc { container-type: inline-size; }

  .rc__sheet {
    background: rgba(247, 244, 239, 0.02);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 14px; padding: 1.5rem 1.6rem 1.4rem;
  }

  /* One grid definition drives the headers, every row and the totals, so the
     three columns cannot drift out of alignment. Alignment IS the clarity. */
  .rc__cols, .rc__row, .rc__totals {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 14rem;
    gap: 1.4rem; align-items: center;
  }

  .rc__cols {
    padding-bottom: 0.7rem; margin-bottom: 0.3rem;
    border-bottom: 1px solid rgba(247, 244, 239, 0.1);
  }
  .rc__col {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.38);
  }
  .rc__col--aqua { color: rgba(78, 216, 194, 0.8); }

  .rc__rows { list-style: none; padding: 0; margin: 0; }
  .rc__row {
    padding: 0.5rem 0; border-bottom: 1px solid rgba(247, 244, 239, 0.05);
  }
  .rc__row:last-child { border-bottom: 0; }

  .rc__job {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.72);
  }

  .rc__today { display: grid; grid-template-columns: auto 1fr auto; gap: 0.6rem; align-items: baseline; }
  .rc__brand { font-size: 0.875rem; color: rgba(247, 244, 239, 0.6); }
  /* A leader line is what makes a row read as a bill rather than a table. */
  .rc__dots {
    border-bottom: 1px dotted rgba(247, 244, 239, 0.18);
    transform: translateY(-0.25em);
  }
  .rc__cost {
    font-family: var(--font-mono); font-size: 0.9375rem;
    color: rgba(232, 82, 78, 0.95); font-variant-numeric: tabular-nums;
  }
  .rc__today--none .rc__brand { color: rgba(232, 82, 78, 0.7); font-style: italic; }
  .rc__cost--none { color: rgba(247, 244, 239, 0.25); }

  .rc__inc {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.8125rem; color: var(--reef-aqua);
  }
  .rc__tick { width: 15px; height: 15px; flex-shrink: 0; }

  .rc__row--bonus { background: rgba(78, 216, 194, 0.045); }

  .rc__rule {
    height: 1px; margin: 0.9rem 0 0.9rem;
    background: repeating-linear-gradient(90deg,
      rgba(247, 244, 239, 0.28) 0 6px, transparent 6px 12px);
  }

  .rc__job--total { color: rgba(247, 244, 239, 0.5); }
  .rc__total { display: grid; gap: 0.1rem; }
  .rc__total b {
    font-family: var(--font-mono); font-weight: 700; font-size: 2rem;
    line-height: 1; font-variant-numeric: tabular-nums;
  }
  .rc__total em {
    font-style: normal; font-size: 0.75rem; color: rgba(247, 244, 239, 0.4);
  }
  .rc__total--red b { color: rgba(232, 82, 78, 0.95); }
  .rc__total--aqua b { color: var(--reef-aqua); }
  .rc__total--aqua em { color: rgba(166, 245, 231, 0.65); }

  .rc__payoff {
    margin: 1.6rem auto 0; text-align: center; max-width: none;
    font-size: 1.375rem; color: rgba(247, 244, 239, 0.8);
  }
  .rc__payoff b {
    font-family: var(--font-mono); font-weight: 700; font-size: 2.4rem;
    color: var(--reef-aqua); display: block; line-height: 1.15;
  }
  .rc__payoff span {
    display: block; margin-top: 0.35rem; font-size: 0.9375rem;
    color: rgba(247, 244, 239, 0.45);
  }

  /* Below this the three columns stop being scannable across, so each row
     becomes its own small block with the labels carried inline. */
  @container (max-width: 720px) {
    .rc__cols { display: none; }
    .rc__row, .rc__totals {
      grid-template-columns: 1fr; gap: 0.3rem;
      padding: 0.8rem 0;
    }
    .rc__job { color: rgba(247, 244, 239, 0.85); }
    .rc__inc::before {
      content: 'With DUSA:';
      font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(247, 244, 239, 0.35);
      margin-right: 0.1rem;
    }
    .rc__totals { gap: 0.9rem; }
    .rc__total b { font-size: 1.75rem; }
    .rc__payoff b { font-size: 2rem; }
  }
</style>
