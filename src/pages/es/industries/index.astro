---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { INDUSTRY_ICONS } from '../../../config/industry-icons';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';

const lang = 'es';
const region = 'es';

const industries = [
  {
    title: 'Inmobiliaria',
    desc: 'Gestion de pipeline, seguimiento automatizado de visitas y matching de compradores para agentes que quieren cerrar mas ventas.',
    slug: '/es/industries/real-estate',
  },
  {
    title: 'Gimnasios y Fitness',
    desc: 'Onboarding de miembros, recordatorios de clases, campanas de recuperacion y seguimiento de referidos para reducir la desercion y llenar tus clases.',
    slug: '/es/industries/gyms',
  },
  {
    title: 'Oficios y Servicios',
    desc: 'Respuesta automatica a llamadas perdidas, pipelines de cotizaciones, programacion de trabajos y recordatorios de pago para profesionales que no paran.',
    slug: '/es/industries/tradies',
  },
  {
    title: 'Restaurantes',
    desc: 'Recordatorios de reservas, solicitudes de resenas post-visita, campanas de cumpleanos y programas de fidelidad digital.',
    slug: '/es/industries/restaurants',
  },
  {
    title: 'Salones y Spas',
    desc: 'Reservas online, recordatorios automaticos, campanas de reagendamiento y seguimiento de preferencias para llenar cada silla.',
    slug: '/es/industries/salons',
  },
  {
    title: 'Contadores',
    desc: 'Automatizacion de recoleccion de documentos, recordatorios de vencimientos y comunicacion continua con clientes mas alla de la temporada fiscal.',
    slug: '/es/industries/accountants',
  },
  {
    title: 'Consultorios Dentales',
    desc: 'Recordatorios de control, captacion de nuevos pacientes, generacion de resenas y seguimiento de planes de tratamiento en piloto automatico.',
    slug: '/es/industries/dentists',
  },
  {
    title: 'Fotografos',
    desc: 'Respuestas automaticas a consultas, flujos de contratos, recordatorios de sesiones, entrega de galerias y secuencias de venta de impresiones.',
    slug: '/es/industries/photographers',
  },
  {
    title: 'Construccion',
    desc: 'Seguimiento de prospectos, follow-up de presupuestos, comunicacion de hitos del proyecto y cobro de pagos para constructoras.',
    slug: '/es/industries/construction',
  },
  {
    title: 'Entrenadores Personales',
    desc: 'Funnels con lead magnets, reserva de consultas, showcases de transformaciones y check-ins automatizados con clientes.',
    slug: '/es/industries/personal-trainers',
  },
  {
    title: 'Servicios de Limpieza',
    desc: 'Gestion de reservas recurrentes, seguimiento de calidad, programacion de equipos y campanas de upsell para empresas de limpieza.',
    slug: '/es/industries/cleaning-services',
  },
  {
    title: 'Firmas Legales',
    desc: 'Automatizacion de formularios de intake, actualizaciones de estado de casos, seguimiento de referidos y contenido de liderazgo dentro del cumplimiento normativo.',
    slug: '/es/industries/law-firms',
  },
  {
    title: 'Administradores de Propiedades',
    desc: 'Automatizacion del ciclo de vida del inquilino, pipelines de solicitudes de mantenimiento, recordatorios de alquiler y campanas de renovacion de contrato.',
    slug: '/es/industries/property-managers',
  },
  {
    title: 'Talleres Mecanicos',
    desc: 'Automatizacion de recordatorios de servicio, campanas estacionales, generacion de resenas y programas de fidelidad para mecanicos.',
    slug: '/es/industries/auto-repair',
  },
  {
    title: 'Coaches y Consultores',
    desc: 'Funnels de llamadas de descubrimiento, secuencias de onboarding, programacion de sesiones y recoleccion de testimonios para escalar tu practica.',
    slug: '/es/industries/coaches',
  },
  {
    title: 'E-commerce',
    desc: 'Secuencias post-compra, automatizacion de resenas, flujos de venta cruzada, segmentacion VIP y recompensas de cumpleanos.',
    slug: '/es/industries/ecommerce',
  },
];
---

<BaseLayout
  t={tData}
  title="Industrias | DUSA.studio"
  description="DUSA esta disenado para tu industria. Descubre como nuestra plataforma de crecimiento funciona para inmobiliarias, oficios, gimnasios, restaurantes, salones, dentistas y mas."
  lang="es"
  ogLocale="es_ES"
  region={region}
>
  <!-- ═══ Hero ═══ -->
  <section class="ind-hero section section--dark">
    <div class="container">
      <div class="ind-hero__content">
        <span class="label">Industrias</span>
        <h1>Disenado para <span class="gradient-text">tu</span> industria</h1>
        <p class="ind-hero__sub">
          Cada negocio es diferente. Por eso DUSA se adapta a tu forma de trabajar, con pipelines, automatizaciones y flujos de trabajo disenados para tu industria. Encuentra la tuya a continuacion.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Industry Grid ═══ -->
  <section class="ind-grid section--dark">
    <div class="container">
      <div class="ind-grid__cards">
        {industries.map((ind) => (
          <a href={ind.slug} class="ind-card">
            <div class="ind-card__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={INDUSTRY_ICONS[ind.slug.split('/').pop()]} />
              </svg>
            </div>
            <h2 class="ind-card__title">{ind.title}</h2>
            <p class="ind-card__desc">{ind.desc}</p>
            <span class="ind-card__link">Conocer mas &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ind-cta section--dark">
    <div class="container">
      <div class="ind-cta__box">
        <h2 class="ind-cta__title">No ves tu industria?</h2>
        <p class="ind-cta__desc">DUSA funciona para cualquier negocio de servicios. Contactanos y te mostramos como se adapta a tu flujo de trabajo.</p>
        <div class="ind-cta__buttons">
          <a href="/es/start" class="btn btn--primary">Comenzar</a>
          <a href="/es/contact" class="btn btn--outline">Hablar con Nosotros</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://dusa.studio/es/" },
    { "@type": "ListItem", "position": 2, "name": "Industrias", "item": "https://dusa.studio/es/industries/" }
  ]
}
</script>

<style>
  /* ─── Hero ─── */
  .ind-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }

  .ind-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .ind-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Grid ─── */
  .ind-grid {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ind-grid__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .ind-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }

  .ind-card__icon-wrap {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }

  .ind-card__icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--reef-aqua);
  }

  .ind-card__title {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ind-card__desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(247, 244, 239, 0.55);
    flex: 1;
  }

  .ind-card__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--reef-aqua);
    transition: opacity var(--duration-fast);
  }

  .ind-card:hover .ind-card__link {
    opacity: 0.8;
  }

  /* ─── CTA ─── */
  .ind-cta {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .ind-cta__box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-2xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ind-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .ind-cta__desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .ind-cta__buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Light mode ─── */
  :global(html[data-theme="light"]) .ind-hero__sub {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .ind-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .ind-card__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
  }

  :global(html[data-theme="light"]) .ind-cta__title {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-cta__desc {
    color: rgba(30, 30, 30, 0.6);
  }

  :global(html[data-theme="light"]) .ind-hero__content h1 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ind-card__icon-wrap svg {
    color: var(--deep-ocean);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ind-grid__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ind-grid__cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .ind-grid__cards {
      grid-template-columns: 1fr;
    }

    .ind-hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
      padding-bottom: var(--space-md);
    }

    .ind-cta__box {
      padding: var(--space-lg);
    }
  }
</style>
