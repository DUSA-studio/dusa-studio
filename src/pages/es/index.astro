---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import WhatIsDusa from '../../components/WhatIsDusa.astro';
import UnderwaterDive from '../../components/UnderwaterDive.astro';
import FunnelComparison from '../../components/FunnelComparison.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Onboarding from '../../components/Onboarding.astro';
import BrandCarousel from '../../components/BrandCarousel.astro';
import SocialProof from '../../components/SocialProof.astro';
import CTA from '../../components/CTA.astro';
import t from '../../i18n/translations/es.json';
---

<BaseLayout
  title="DUSA . studio | Plataforma de Crecimiento para Pequeñas Empresas"
  description="Gestiona tu marketing, ventas e interacción con clientes desde una sola plataforma. DUSA es el sistema de crecimiento todo en uno creado para empresas que quieren escalar sin la complejidad."
  lang="es"
  ogLocale="es_ES"
  region="es"
  t={t}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "DUSA . studio",
    "url": "https://dusa.studio/es/",
    "logo": "https://dusa.studio/favicon.png",
    "description": "Plataforma de crecimiento todo en uno para pequeñas empresas. CRM, automatización de marketing, pipelines de ventas e interacción con clientes desde un solo acceso.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Sydney",
      "addressRegion": "NSW",
      "addressCountry": "AU"
    },
    "sameAs": []
  })} />
  <Hero t={t} lang="es" />
  <Features t={t} />
  <SocialProof t={t} />
  <UnderwaterDive t={t} />
  <FunnelComparison t={t} />
  <WhatIsDusa t={t} />
  <HowItWorks t={t} />
  <Onboarding t={t} region="es" />
  <BrandCarousel t={t} />
  <CTA t={t} />
</BaseLayout>

<script>
  function initAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initAnimations, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');

    gsap.set('.reveal, .reveal-left, .reveal-right, .reveal-scale', {
      visibility: 'visible',
    });

    const heroTl = gsap.timeline({
      scrollTrigger: { trigger: '.hero__inner', start: 'top 75%', once: true },
    });

    const heroLabel = document.querySelector('.hero .label');
    if (heroLabel) {
    }

    const heroTitle = document.querySelector('.hero__title');
    if (heroTitle) {
    }

    const heroSub = document.querySelector('.hero__subtitle');
    if (heroSub) {
    }

    const heroPhone = document.querySelector('.hero__phone-wrap');
    if (heroPhone) {
    }

    const notifFeed = document.querySelector('#hero-notif-feed');
    if (notifFeed) {
      gsap.set(notifFeed, { opacity: 0 });
      heroTl.to(notifFeed, { opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.6');
    }

    const heroProof = document.querySelector('.hero__proof');
    if (heroProof) {
    }

    const heroOnly = '.hero';
    gsap.utils.toArray('.reveal').forEach((el: Element) => {
      if ((el as HTMLElement).closest(heroOnly)) return;
      gsap.from(el, {
        y: 50, opacity: 0, duration: 0.8, ease: 'power4.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    gsap.utils.toArray('.reveal-left').forEach((el: Element) => {
      if ((el as HTMLElement).closest(heroOnly)) return;
      gsap.from(el, {
        x: -50, opacity: 0, duration: 1, ease: 'power4.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    gsap.utils.toArray('.reveal-right').forEach((el: Element) => {
      if ((el as HTMLElement).closest(heroOnly)) return;
      gsap.from(el, {
        x: 50, opacity: 0, duration: 1, ease: 'power4.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    gsap.utils.toArray('.reveal-scale').forEach((el: Element) => {
      if ((el as HTMLElement).closest(heroOnly)) return;
      gsap.from(el, {
        scale: 0.9, opacity: 0, duration: 1, ease: 'power4.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    document.querySelectorAll('.hiw__step-num').forEach((el) => {
      gsap.from(el, {
        scale: 0.3, opacity: 0, duration: 0.6, ease: 'back.out(2)',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      });
    });

    document.querySelectorAll('.proof__stat-value').forEach((el) => {
      gsap.from(el, {
        scale: 0.4, opacity: 0, y: 20, duration: 0.7,
        ease: 'back.out(2)',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });

    document.querySelectorAll('.cta__expand-line').forEach((el) => {
      gsap.fromTo(el, { scaleY: 0 }, {
        scaleY: 1, duration: 1, ease: 'power2.out',
        transformOrigin: 'top center',
        scrollTrigger: { trigger: el, start: 'top 92%', once: true },
      });
    });

    const funnelSection = document.querySelector('.funnel');
    if (funnelSection) {
      const leftPills = funnelSection.querySelectorAll('.funnel__side--left .fpill');
      if (leftPills.length) {
        gsap.to(leftPills, {
          opacity: 1, y: 0, duration: 0.45, stagger: 0.08, ease: 'bounce.out',
          scrollTrigger: { trigger: '.funnel__layout', start: 'top 95%', once: true },
        });
      }

      const dusaPlatform = funnelSection.querySelector('.funnel__platform');
      if (dusaPlatform) {
        gsap.to(dusaPlatform, {
          opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.7,
          scrollTrigger: { trigger: '.funnel__layout', start: 'top 95%', once: true },
        });
      }

      const funnelShapes = funnelSection.querySelectorAll('.funnel__shape');
      if (funnelShapes.length) {
        gsap.to(funnelShapes, {
          opacity: 1, scale: 1, duration: 0.8, stagger: 0.15, ease: 'power4.out',
          scrollTrigger: { trigger: '.funnel__layout', start: 'top 90%', once: true },
          delay: 0.2,
        });
      }

      const vsBadge = funnelSection.querySelector('.funnel__vs-badge');
      if (vsBadge) {
        gsap.to(vsBadge, {
          opacity: 1, scale: 1, duration: 0.6, ease: 'back.out(2)',
          scrollTrigger: { trigger: '.funnel__layout', start: 'top 88%', once: true },
          delay: 0.4,
        });
        gsap.set(vsBadge, { scale: 0.5 });
      }

      const outputs = funnelSection.querySelectorAll('.funnel__output');
      if (outputs.length) {
        gsap.to(outputs, {
          opacity: 1, duration: 0.7, stagger: 0.25, ease: 'power3.out',
          scrollTrigger: { trigger: '.funnel__output', start: 'top 95%', once: true },
          delay: 0.3,
        });
      }
    }

    document.querySelectorAll('.hiw__step').forEach((step) => {
      gsap.fromTo(step, { backgroundSize: '0% 1px' }, {
        backgroundSize: '100% 1px', duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: step, start: 'top 85%', once: true },
      });
    });

    const nav = document.querySelector('.nav');
    if (nav) {
      ScrollTrigger.create({
        start: 'top -80',
        onUpdate: (self) => {
          nav.classList.toggle('nav--scrolled', self.progress > 0);
        },
      });
    }

    setTimeout(() => ScrollTrigger.refresh(), 500);
    setTimeout(() => ScrollTrigger.refresh(), 1500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && typeof gsap !== 'undefined') {
      gsap.ticker.wake();
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    }
  });
</script>
