---
// CTA.astro — Final call-to-action + hint at expanded services
---

<section class="cta section section--sand" id="contact">
  <div class="container">
    <div class="cta__content reveal">
      <a href="#contact" class="label label--cta">Ready?</a>
      <h2>Stop juggling tools.<br/><span style="color: var(--deep-ocean);">Start growing.</span></h2>
      <p class="cta__desc">
        Book a free demo and see how DUSA's AI-powered platform can replace your scattered stack
        with one intelligent system. Set up in days, not months.
      </p>
      <div class="cta__actions">
        <a href="https://dusa.studio/booking" class="btn btn--dark">Book Your Free Demo</a>
        <a href="mailto:contact@dusa.studio" class="btn btn--outline-dark">Email Us</a>
      </div>
    </div>

    <div class="cta__expand reveal">
      <div class="cta__expand-line"></div>
      <p class="cta__expand-text">
        And when you're ready for more. Custom AI solutions, social media management,
        advanced integrations, and dedicated IT support. <strong>We've got you covered.</strong>
      </p>
    </div>
  </div>
</section>

<style>
  .label--cta {
    background: var(--deep-ocean);
    color: var(--warm-white);
    border-color: var(--deep-ocean);
    font-size: 0.9375rem;
    padding: 0.5rem 1.5rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }

  .label--cta:hover {
    background: var(--reef-aqua);
    border-color: var(--reef-aqua);
    color: var(--deep-black);
    box-shadow: 0 0 20px rgba(78, 216, 194, 0.35), 0 0 40px rgba(78, 216, 194, 0.15);
    transform: translateY(-2px);
  }

  .label--cta:hover::before {
    background: var(--deep-ocean);
    box-shadow: 0 0 8px rgba(26, 58, 92, 0.4);
  }

  .cta__content {
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  .cta__content h2 {
    color: var(--deep-black);
  }

  .cta__desc {
    font-size: 1.125rem;
    color: rgba(12, 14, 20, 0.55);
    line-height: 1.7;
    margin: var(--space-sm) auto var(--space-lg);
    max-width: 520px;
  }

  .cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn--outline-dark {
    border: 1.5px solid rgba(12, 14, 20, 0.15);
    color: var(--deep-black);
    padding: 0.875rem 2rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 1.0625rem;
    transition: all var(--duration-fast) var(--ease-out);
    text-decoration: none;
    display: inline-block;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .btn--outline-dark:hover {
    border-color: var(--deep-ocean);
    color: var(--deep-ocean);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(26, 58, 92, 0.1);
  }

  .cta__expand {
    margin-top: var(--space-2xl);
    text-align: center;
    position: relative;
  }

  .cta__expand-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--reef-aqua) 60%, var(--deep-ocean));
    margin: 0 auto var(--space-md);
    opacity: 0.6;
  }

  .cta__expand-text {
    font-size: 1rem;
    color: rgba(12, 14, 20, 0.45);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .cta__expand-text strong {
    color: var(--deep-ocean);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .cta__actions {
      flex-direction: column;
      align-items: center;
    }

    .cta__desc {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .cta__actions .btn,
    .cta__actions .btn--outline-dark {
      width: 100%;
      text-align: center;
    }
  }
</style>
