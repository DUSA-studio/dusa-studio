---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    title: '5 tools every sole operator should replace with one platform',
    excerpt: 'If you\'re paying for a CRM, email tool, calendar app, funnel builder, and review manager separately, you\'re overspending by hundreds per month. Here\'s how to consolidate.',
    category: 'Growth',
    date: '2026-04-20',
    slug: '#',
    readTime: '5 min',
  },
  {
    title: 'How to automate your follow-up without sounding like a robot',
    excerpt: 'Automated sequences don\'t have to feel cold. Learn how to build nurture workflows that sound like you, respond at the right time, and convert leads while you sleep.',
    category: 'Automation',
    date: '2026-04-14',
    slug: '#',
    readTime: '7 min',
  },
  {
    title: 'Reputation management: why your Google reviews matter more than your website',
    excerpt: 'For local businesses, reviews are the new homepage. We break down how to systematically collect, respond to, and leverage reviews for growth.',
    category: 'Marketing',
    date: '2026-04-07',
    slug: '#',
    readTime: '6 min',
  },
  {
    title: 'The real cost of disconnected tools (and what to do about it)',
    excerpt: 'We calculated the true cost of running separate CRM, email, scheduling, and funnel tools. Spoiler: it\'s not just the subscription fees that hurt.',
    category: 'Strategy',
    date: '2026-03-28',
    slug: '#',
    readTime: '4 min',
  },
  {
    title: 'Getting started with DUSA: a step-by-step setup guide',
    excerpt: 'From signing up to sending your first campaign, here\'s everything you need to know to get the DUSA platform running for your business in under 48 hours.',
    category: 'Getting Started',
    date: '2026-03-20',
    slug: '#',
    readTime: '8 min',
  },
  {
    title: 'Booking systems that convert: how to stop losing leads to scheduling friction',
    excerpt: 'Every extra step between "I\'m interested" and "I\'m booked" costs you money. Learn how to build frictionless booking flows that capture more appointments.',
    category: 'Growth',
    date: '2026-03-14',
    slug: '#',
    readTime: '5 min',
  },
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Blog | DUSA . studio" description="Growth strategies, platform tips, and marketing insights for small businesses and sole operators. From the DUSA . studio team.">

  <section class="blog-hero section section--dark">
    <div class="container">
      <div class="blog-hero__content">
        <span class="label">Blog</span>
        <h1>Insights for<br/><span class="gradient-text">growing businesses</span></h1>
        <p class="blog-hero__sub">Practical strategies, platform tips, and marketing know-how for sole operators and small teams.</p>
      </div>
    </div>
  </section>

  <section class="blog-list section section--dark" style="padding-top:0;">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post, i) => (
          <a href={post.slug} class={`blog-card ${i === 0 ? 'blog-card--featured' : ''}`}>
            <div class="blog-card__meta">
              <span class="blog-card__category">{post.category}</span>
              <span class="blog-card__date">{formatDate(post.date)}</span>
            </div>
            <h3 class="blog-card__title">{post.title}</h3>
            <p class="blog-card__excerpt">{post.excerpt}</p>
            <span class="blog-card__read">{post.readTime} read</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .blog-hero {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
  }

  .blog-hero__content {
    max-width: 600px;
  }

  .blog-hero__sub {
    font-size: 1.25rem;
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .blog-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: all var(--duration-normal) var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .blog-card:hover {
    border-color: rgba(78, 216, 194, 0.2);
    background: rgba(247, 244, 239, 0.05);
    transform: translateY(-3px);
  }

  .blog-card--featured {
    grid-column: 1 / -1;
    padding: var(--space-xl);
  }

  .blog-card--featured .blog-card__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .blog-card__category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--reef-aqua);
    padding: 0.25rem 0.625rem;
    border: 1px solid rgba(78, 216, 194, 0.2);
    border-radius: var(--radius-full);
  }

  .blog-card__date {
    font-size: 0.875rem;
    color: rgba(247, 244, 239, 0.3);
  }

  .blog-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .blog-card__excerpt {
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.7;
    flex-grow: 1;
    margin-bottom: var(--space-sm);
  }

  .blog-card__read {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card--featured {
      padding: var(--space-lg);
    }

    .blog-hero__sub {
      font-size: 1.0625rem;
    }

    .blog-card__title {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    .blog-card {
      padding: var(--space-md);
    }
  }

  /* GSAP-animated elements hidden until JS runs */
  .blog-hero__content,
  .blog-card {
    visibility: hidden;
  }
</style>

<script>
  function initBlogAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initBlogAnimations, 100);
      return;
    }
    gsap.registerPlugin(ScrollTrigger);
    gsap.set('.blog-hero__content, .blog-card', {
      visibility: 'visible',
    });
    gsap.from('.blog-hero__content', {
      y: 30, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.1,
    });
    gsap.from('.blog-card', {
      y: 25, opacity: 0, duration: 0.5, stagger: 0.08, ease: 'power3.out', delay: 0.3,
    });
  }
  initBlogAnimations();

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && typeof gsap !== 'undefined') {
      gsap.ticker.wake();
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    }
  });
</script>
