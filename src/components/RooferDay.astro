        const bob = walkSpeed > 0.01 ? Math.abs(Math.sin(now / (rush ? 70 : 110))) * (0.03 + rush * 0.03) : 0;
        body.position.y = 0.86 + by + bob; vest.position.y = 0.84 + by + bob; head.position.y = 1.3 + by + bob; top.position.y = 1.3 + by + bob;
        armL.position.y = 1.0 + by + bob; armR.position.y = 1.0 + by + bob;
        // A stressed head: quick glances when rushing.
        top.rotation.y = rush ? Math.sin(now / 420) * 0.5 : damp(top.rotation.y, 0, 4, dt);
        head.rotation.y = top.rotation.y;
        mug.visible = T.mug; phone.visible = T.phone; phoneGlow.intensity = T.phone ? 0.6 : 0;
        g.position.y = (g.userData.baseY ?? 0) + Math.sin(now / 700 + (g.userData.phase ?? 0)) * 0.01;
      };
      return { g, setPose, setWalk, tick };
    };

    /* A world: the island, the customer's house by day, the roofer's own home at night. */
    const makeWorld = (nice: boolean, canvas: HTMLCanvasElement) => {
      const P = nice ? PAL.on : PAL.off;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setClearColor(0x000000, 0);
      renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.15;

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 100);
      const hemi = new THREE.HemisphereLight(0xdff2ff, 0x5b7c6a, 1.1); scene.add(hemi);
      const sun = new THREE.DirectionalLight(0xffffff, 2.2);
      sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048);
      sun.shadow.camera.left = -10; sun.shadow.camera.right = 10; sun.shadow.camera.top = 10; sun.shadow.camera.bottom = -10;
      sun.shadow.camera.near = 1; sun.shadow.camera.far = 60; sun.shadow.bias = -0.0006; sun.shadow.normalBias = 0.04; sun.shadow.radius = 4;
      scene.add(sun, sun.target);
      const fill = new THREE.DirectionalLight(0x9fd8ff, 0.35); fill.position.set(-6, 4, -8); scene.add(fill);

      const isle = new THREE.Group(); scene.add(isle);
      isle.add(rbox(13, 0.5, 9, mat(P.grassTop), 0.22, 0, -0.25, 0));
      isle.add(rbox(12.7, 1.1, 8.7, mat(P.soil), 0.3, 0, -1.05, 0));
      const shadowTex = (() => { const c = document.createElement('canvas'); c.width = c.height = 256; const g = c.getContext('2d')!; const r = g.createRadialGradient(128, 128, 20, 128, 128, 128); r.addColorStop(0, 'rgba(0,0,0,0.55)'); r.addColorStop(1, 'rgba(0,0,0,0)'); g.fillStyle = r; g.fillRect(0, 0, 256, 256); return new THREE.CanvasTexture(c); })();
      const drop = new THREE.Mesh(new THREE.PlaneGeometry(18, 13), new THREE.MeshBasicMaterial({ map: shadowTex, transparent: true, depthWrite: false }));
      drop.rotation.x = -Math.PI / 2; drop.position.y = -2.4; scene.add(drop);
      // Road and driveway sit clearly above the grass so nothing flickers.
      isle.add(rbox(13, 0.1, 1.7, mat(P.road), 0.04, 0, 0.05, -3.7));
      for (let i = -5.6; i <= 5.6; i += 1.4) isle.add(rbox(0.6, 0.04, 0.08, mat(P.dash), 0.01, i, 0.11, -3.7));
      const UX = 4.6, UZ = -1.2;
      isle.add(rbox(2.6, 0.1, 3.6, mat(P.drive), 0.04, UX, 0.05, UZ - 0.5));

      /* Scene sets: the job (customer's house) and home (the roofer's own). */
      const job = new THREE.Group(); isle.add(job);
      const home = new THREE.Group(); isle.add(home);
      const HX = -4.0, HZ = 0.3, H = 2.1, W = 3.6, D = 2.9;

      const house = (parent: THREE.Group, wall: number, roofC: number, door: number, winM: THREE.Material, bare: boolean) => {
        const g = new THREE.Group(); g.position.set(HX, 0, HZ); parent.add(g);
        g.add(rbox(W, H, D, mat(wall), 0.08, 0, H / 2, 0));
        const shape = new THREE.Shape(); shape.moveTo(-W / 2 - 0.35, 0); shape.lineTo(W / 2 + 0.35, 0); shape.lineTo(0, 1.35); shape.closePath();
        const geo = new THREE.ExtrudeGeometry(shape, { depth: D + 0.6, bevelEnabled: true, bevelThickness: 0.04, bevelSize: 0.04, bevelSegments: 2 }); geo.translate(0, 0, -(D + 0.6) / 2);
        const roof = new THREE.Mesh(geo, mat(bare ? 0xd9b48a : roofC, { roughness: 0.65 })); roof.position.y = H; roof.castShadow = true; roof.receiveShadow = true; g.add(roof);
        if (bare) { const bm = mat(0xc49a6c); for (let i = -1.2; i <= 1.2; i += 0.6) { const b = rbox(0.06, 0.05, D + 0.7, bm, 0.02, 0, 0, 0); b.position.set(i, H + 1.35 - Math.abs(i) * (1.35 / (W / 2 + 0.35)) + 0.04, 0); g.add(b); } }
        g.add(rbox(W + 0.75, 0.12, 0.14, mat(0xffffff), 0.04, 0, H + 0.02, D / 2 + 0.33));
        g.add(rbox(0.42, 0.7, 0.42, mat(0xcfc7bb), 0.05, W * 0.28, H + 1.0, -0.4));
        const frameM = mat(P.frame);
        for (const wx of [-1.05, 1.05]) { g.add(rbox(0.9, 0.78, 0.08, frameM, 0.03, wx, H * 0.6, D / 2 + 0.03)); g.add(rbox(0.76, 0.64, 0.1, winM, 0.02, wx, H * 0.6, D / 2 + 0.05)); }
        g.add(rbox(0.74, 1.3, 0.1, mat(door), 0.04, 0, 0.65, D / 2 + 0.05));
        g.add(sph(0.04, mat(0xffe08a, { metalness: 0.8, roughness: 0.3 }), 0.24, 0.68, D / 2 + 0.11));
        return { g, roof };
      };
      const jobWin = new THREE.MeshStandardMaterial({ color: 0x1c2a3e, roughness: 0.25, metalness: 0.1 });
      const homeWin = new THREE.MeshStandardMaterial({ color: 0x1c2a3e, emissive: 0xffc97a, emissiveIntensity: 0, roughness: 0.25, metalness: 0.1 });
      const jobHouse = house(job, 0xe9e3d6, P.roof, 0x6b7280, jobWin, true);
      const ownHome = house(home, P.home, P.homeRoof, P.door, homeWin, false);

      /* Roof tiles go on row by row as the day goes. Near slope first, then the far one. */
      const tiles: THREE.Mesh[] = [];
      const tileM = mat(P.roof, { roughness: 0.6 });
      const slope = Math.atan2(1.35, W / 2 + 0.35);
      const run = Math.hypot(1.35, W / 2 + 0.35);
      for (const side of [1, -1]) for (let r = 0; r < 4; r++) for (let c = 0; c < 6; c++) {
