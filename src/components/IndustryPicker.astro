---
/**
 * IndustryPicker.astro
 *
 * "I run a ______". A big centred sentence the visitor can finish by typing.
 * As they type, the industry chips that do not fit grey out and the closest
 * one lights up; Enter (or a tap) takes them to that industry page. Free text
 * is matched against each industry's label plus a synonym list (roofer,
 * sparky, barber, physio...) with a forgiving fuzzy score, so "roofer" lands
 * on Trades and "nails" on Salons. Nothing matches: the hint offers the
 * closest guess and the all-industries page.
 */
import { INDUSTRY_ICONS } from '../config/industry-icons';
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.pick || {};
const IL: Record<string, string> = t?.nav?.industryLabels || {};
const lead = s.lead || 'I run a';
const placeholder = s.placeholder || 'plumbing business, salon, clinic...';
const more = s.more || 'Something else';
const sub = s.sub || 'Type what you do, or pick it below, and see your week with DUSA.';
const hintEnter = s.hintEnter || 'Press Enter for';
const hintClosest = s.hintClosest || 'Closest match:';
const hintNone = s.hintNone || 'We have not written yours up yet. Start with the closest, or';
const hintAll = s.hintAll || 'see every industry';
const order = ['tradies', 'salons', 'dentists', 'gyms', 'real-estate', 'restaurants', 'accountants', 'cleaning-services', 'photographers', 'personal-trainers', 'coaches', 'law-firms', 'property-managers', 'auto-repair', 'construction', 'ecommerce'];
const fallback: Record<string, string> = {
  'tradies': 'trade business', 'salons': 'salon or spa', 'dentists': 'dental practice', 'gyms': 'gym or studio', 'real-estate': 'real estate agency', 'restaurants': 'restaurant or cafe', 'accountants': 'accounting practice', 'cleaning-services': 'cleaning business', 'photographers': 'photography studio', 'personal-trainers': 'PT business', 'coaches': 'coaching business', 'law-firms': 'law firm', 'property-managers': 'property management agency', 'auto-repair': 'auto repair shop', 'construction': 'construction company', 'ecommerce': 'online store',
};
/* Plain-English synonyms per industry. Lowercase, single words or short phrases. */
const SYN: Record<string, string[]> = {
  'tradies': ['trade', 'tradie', 'tradesman', 'tradesperson', 'plumber', 'plumbing', 'electrician', 'sparky', 'sparkie', 'roofer', 'roofing', 'carpenter', 'chippy', 'chippie', 'painter', 'painting', 'tiler', 'tiling', 'landscaper', 'landscaping', 'gardener', 'lawn', 'mowing', 'handyman', 'hvac', 'air conditioning', 'aircon', 'solar', 'pest control', 'locksmith', 'plasterer', 'concreter', 'fencing', 'glazier', 'pool', 'removalist', 'removals', 'arborist', 'tree'],
  'salons': ['salon', 'spa', 'hair', 'hairdresser', 'barber', 'barbershop', 'beauty', 'beautician', 'nails', 'nail', 'lashes', 'lash', 'brows', 'waxing', 'massage', 'tanning', 'tattoo', 'makeup', 'cosmetic', 'skin', 'day spa', 'aesthetics'],
  'dentists': ['dental', 'dentist', 'orthodontist', 'clinic', 'medical', 'doctor', 'gp', 'physio', 'physiotherapist', 'chiro', 'chiropractor', 'osteo', 'podiatrist', 'optometrist', 'vet', 'veterinary', 'psychologist', 'allied health', 'health'],
  'gyms': ['gym', 'fitness', 'studio', 'crossfit', 'pilates', 'yoga', 'martial arts', 'boxing', 'dance', 'swim', 'swimming', 'f45'],
  'real-estate': ['real estate', 'realty', 'agent', 'agency', 'property', 'buyers agent', 'mortgage', 'broker'],
  'restaurants': ['restaurant', 'cafe', 'coffee', 'bar', 'pub', 'bistro', 'food', 'catering', 'caterer', 'bakery', 'pizza', 'takeaway', 'hospitality', 'venue', 'winery', 'brewery'],
  'accountants': ['accountant', 'accounting', 'bookkeeper', 'bookkeeping', 'tax', 'cpa', 'financial', 'finance', 'advisor', 'adviser', 'planner', 'insurance'],
  'cleaning-services': ['cleaning', 'cleaner', 'commercial cleaning', 'window cleaning', 'carpet', 'pressure washing', 'bond cleaning', 'housekeeping', 'laundry'],
  'photographers': ['photographer', 'photography', 'videographer', 'video', 'film', 'creative', 'design', 'designer', 'wedding', 'studio', 'drone'],
  'personal-trainers': ['personal trainer', 'pt', 'trainer', 'coach', 'nutrition', 'nutritionist', 'dietitian', 'wellness'],
  'coaches': ['coach', 'coaching', 'consultant', 'consulting', 'mentor', 'course', 'courses', 'speaker', 'training', 'tutor', 'tutoring', 'education', 'school'],
  'law-firms': ['law', 'lawyer', 'legal', 'solicitor', 'conveyancer', 'conveyancing', 'barrister', 'firm'],
  'property-managers': ['property manager', 'property management', 'strata', 'rentals', 'rental', 'airbnb', 'holiday rentals', 'landlord', 'body corporate'],
  'auto-repair': ['auto', 'mechanic', 'mechanical', 'car', 'cars', 'automotive', 'repair', 'tyres', 'tyre', 'panel', 'smash', 'detailing', 'detailer', 'towing', 'motorbike', 'caravan'],
  'construction': ['construction', 'builder', 'building', 'renovation', 'renovations', 'developer', 'civil', 'architect', 'kitchens', 'bathrooms', 'home builder'],
  'ecommerce': ['ecommerce', 'e-commerce', 'online store', 'shop', 'shopify', 'store', 'retail', 'retailer', 'boutique', 'brand', 'products', 'dropshipping', 'wholesale'],
};
const chips = order.map((slug) => ({ slug, label: (s.labels && s.labels[slug]) || fallback[slug] || IL[slug] || slug, icon: INDUSTRY_ICONS[slug], syn: SYN[slug] || [] }));
const data = JSON.stringify(chips.map((c) => ({ slug: c.slug, label: c.label, syn: c.syn })));
---

<section class="pick section--dark" aria-label={lead} data-pick>
  <div class="container">
    <form class="pick__line" id="pick-form" autocomplete="off">
      <label class="pick__lead" for="pick-input">{lead}</label>
      <span class="pick__field">
        <input class="pick__input" id="pick-input" type="text" placeholder={placeholder} aria-label={`${lead}...`} aria-describedby="pick-hint" spellcheck="false" />
        <span class="pick__cursor" aria-hidden="true"></span>
      </span>
    </form>
    <p class="pick__hint" id="pick-hint" aria-live="polite" data-enter={hintEnter} data-closest={hintClosest} data-none={hintNone} data-all={hintAll}>{sub}</p>

    <ul class="pick__chips" id="pick-chips">
      {chips.map((c) => (
        <li>
          <a class="pick__chip" href={`/industries/${c.slug}`} data-page={`industries/${c.slug}`} data-slug={c.slug}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
            <span>{c.label}</span>
          </a>
        </li>
      ))}
      <li><a class="pick__chip pick__chip--more" href="/industries" data-page="industries" data-slug="all"><span>{more} &rarr;</span></a></li>
    </ul>
  </div>
  <script type="application/json" id="pick-data" set:html={data} />
</section>

<style>
  .pick { padding: var(--space-xl) 0 var(--space-xl); }

  /* The sentence: big, centred, typeable. */
  .pick__line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.6ch;
    flex-wrap: wrap;
    margin: 0 auto var(--space-sm);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--warm-white);
  }
  .pick__lead { cursor: text; }
  .pick__field { position: relative; display: inline-flex; align-items: baseline; min-width: 8ch; max-width: 100%; }
  .pick__input {
    font: inherit;
    letter-spacing: inherit;
    color: var(--reef-aqua);
    background: transparent;
    border: 0;
    border-bottom: 3px solid rgba(78, 216, 194, 0.35);
    padding: 0 0 0.1em;
    width: 14ch;
    max-width: 90vw;
    outline: none;
    caret-color: var(--reef-aqua);
    transition: border-color var(--duration-fast), width 0.25s var(--ease-out);
  }
  .pick__input::placeholder { color: rgba(247, 244, 239, 0.28); font-weight: 600; }
  .pick__input:focus { border-bottom-color: var(--reef-aqua); }
  .pick__input:focus::placeholder { color: rgba(247, 244, 239, 0.18); }
  .pick__cursor { display: none; }

  .pick__hint {
    text-align: center;
    font-size: 1rem;
    color: rgba(247, 244, 239, 0.62);
    margin: 0 auto var(--space-lg);
    max-width: none;
    min-height: 1.6em;
  }
  .pick__hint b { color: var(--reef-aqua); font-weight: 600; }
  .pick__hint a { color: var(--warm-white); text-decoration: underline; text-underline-offset: 2px; }

  /* Chips: dim the ones that do not fit, light the best. */
  .pick__chips { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; max-width: 960px; }
  .pick__chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 0.95rem 0.55rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(247, 244, 239, 0.14);
    background: linear-gradient(135deg, rgba(247, 244, 239, 0.07), rgba(247, 244, 239, 0.025));
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    color: rgba(247, 244, 239, 0.82);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.2;
    min-height: 42px;
    transition: border-color 0.25s, background 0.25s, color 0.25s, opacity 0.3s, transform 0.25s, filter 0.3s;
  }
  .pick__chip svg { width: 16px; height: 16px; color: var(--reef-aqua); flex-shrink: 0; transition: color 0.25s; }
  .pick__chip:hover { border-color: rgba(78, 216, 194, 0.5); background: rgba(78, 216, 194, 0.1); color: var(--warm-white); transform: translateY(-1px); }
  .pick__chip--more { border-style: dashed; color: rgba(247, 244, 239, 0.62); }
  .pick__chip.is-dim { opacity: 0.28; filter: saturate(0); transform: none; }
  .pick__chip.is-dim svg { color: rgba(247, 244, 239, 0.5); }
  .pick__chip.is-best { border-color: var(--reef-aqua); background: rgba(78, 216, 194, 0.16); color: var(--warm-white); box-shadow: 0 0 0 4px rgba(78, 216, 194, 0.12), 0 8px 24px rgba(78, 216, 194, 0.18); transform: translateY(-2px) scale(1.04); }

  @media (max-width: 768px) {
    .pick { padding-top: var(--space-lg); }
    .pick__line { font-size: clamp(1.75rem, 8vw, 2.4rem); }
    .pick__input { width: 12ch; }
    .pick__chip { font-size: 0.875rem; min-height: 40px; }
  }

  :global(html[data-theme="light"]) .pick__line { color: var(--deep-black); }
  :global(html[data-theme="light"]) .pick__input { color: var(--deep-ocean); border-bottom-color: rgba(26, 58, 92, 0.3); caret-color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__input:focus { border-bottom-color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__input::placeholder { color: rgba(12, 14, 20, 0.3); }
  :global(html[data-theme="light"]) .pick__hint { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .pick__hint b { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__hint a { color: var(--deep-black); }
  :global(html[data-theme="light"]) .pick__chip { border-color: rgba(12, 14, 20, 0.12); background: rgba(12, 14, 20, 0.03); color: rgba(12, 14, 20, 0.78); }
  :global(html[data-theme="light"]) .pick__chip svg { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .pick__chip:hover { border-color: rgba(26, 58, 92, 0.5); background: rgba(26, 58, 92, 0.07); color: var(--deep-black); }
  :global(html[data-theme="light"]) .pick__chip--more { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .pick__chip.is-best { border-color: var(--deep-ocean); background: rgba(26, 58, 92, 0.1); color: var(--deep-black); box-shadow: 0 0 0 4px rgba(26, 58, 92, 0.1), 0 8px 24px rgba(26, 58, 92, 0.15); }
</style>

<script>
  (function () {
    const root = document.querySelector('[data-pick]');
    if (!root) return;
    const input = root.querySelector('#pick-input');
    const hint = root.querySelector('#pick-hint');
    const form = root.querySelector('#pick-form');
    const chipEls = Array.from(root.querySelectorAll('.pick__chip[data-slug]'));
    const data = JSON.parse(root.querySelector('#pick-data').textContent || '[]');
    const defaultHint = hint.textContent;
    const T = { enter: hint.dataset.enter, closest: hint.dataset.closest, none: hint.dataset.none, all: hint.dataset.all };
    const byslug = Object.fromEntries(chipEls.map((el) => [el.dataset.slug, el]));

    const norm = (s) => s.toLowerCase().replace(/[^a-z0-9\s-]/g, ' ').replace(/\s+/g, ' ').trim();
    const stem = (w) => w.replace(/(ies)$/, 'y').replace(/(sses|ches|shes|xes)$/, (m) => m.slice(0, -2)).replace(/s$/, '');

    // Damerau-free Levenshtein, small strings only.
    function lev(a, b) {
      const m = a.length, n = b.length; if (!m) return n; if (!n) return m;
      let prev = Array.from({ length: n + 1 }, (_, i) => i);
      for (let i = 1; i <= m; i++) {
        const cur = [i];
        for (let j = 1; j <= n; j++) cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        prev = cur;
      }
      return prev[n];
    }
    function wordScore(q, w) {
      if (!q || !w) return 0;
      if (w === q) return 1;
      if (w.startsWith(q)) return 0.9;
      if (q.length >= 4 && w.includes(q)) return 0.75;
      if (q.length >= 4 && q.includes(w) && w.length >= 4) return 0.7;
      const d = lev(q, w); const tol = q.length <= 4 ? 1 : q.length <= 7 ? 2 : 3;
      if (d <= tol) return 0.6 - d * 0.1;
      return 0;
    }
    function score(q, item) {
      const terms = [item.label, ...item.syn].map(norm);
      const qs = stem(q);
      let best = 0;
      for (const term of terms) {
        // whole phrase
        best = Math.max(best, wordScore(q, term), wordScore(qs, stem(term)));
        // per word of the term (so "plumbing business" hits "plumbing")
        for (const w of term.split(' ')) best = Math.max(best, wordScore(q, w), wordScore(qs, stem(w)));
        if (best >= 1) break;
      }
      return best;
    }
    function rank(raw) {
      const q = norm(raw);
      if (!q) return null;
      // Score on the full query and on each typed word; take the best of either.
      const words = q.split(' ').filter((w) => w.length >= 2 && !['a', 'an', 'the', 'my', 'business', 'company', 'shop', 'small', 'local'].includes(w));
      return data.map((item) => {
        let s = score(q, item);
        for (const w of words) s = Math.max(s, score(w, item) * 0.95);
        return { slug: item.slug, label: item.label, s };
      }).sort((a, b) => b.s - a.s);
    }
    function render(raw) {
      const ranked = rank(raw);
      chipEls.forEach((el) => el.classList.remove('is-dim', 'is-best'));
      if (!ranked) { hint.textContent = defaultHint; input.style.width = ''; return; }
      input.style.width = Math.max(8, Math.min(28, raw.length + 2)) + 'ch';
      const top = ranked[0];
      const matches = ranked.filter((r) => r.s >= 0.5).map((r) => r.slug);
      if (top.s >= 0.5) {
        chipEls.forEach((el) => { if (!matches.includes(el.dataset.slug) && el.dataset.slug !== 'all') el.classList.add('is-dim'); });
        byslug[top.slug].classList.add('is-best');
        hint.innerHTML = (top.s >= 0.9 ? T.enter : T.closest) + ' <b>' + top.label + '</b>';
      } else {
        chipEls.forEach((el) => { if (el.dataset.slug !== top.slug && el.dataset.slug !== 'all') el.classList.add('is-dim'); });
        byslug[top.slug].classList.add('is-best');
        hint.innerHTML = T.none + ' <a href="/industries" data-page="industries">' + T.all + '</a>. ' + T.closest + ' <b>' + top.label + '</b>';
      }
    }
    input.addEventListener('input', () => render(input.value));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const best = root.querySelector('.pick__chip.is-best') || byslug.all;
      if (best) window.location.href = best.getAttribute('href');
    });
  })();
</script>
