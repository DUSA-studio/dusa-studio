  @media (max-width: 480px) {
    .about-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-lg);
    }

    .sydney__actions .btn {
      width: 100%;
      text-align: center;
    }

    .vcard {
      padding: 1.25rem 1.5rem;
    }
  }

  .about-hero__content,
  .origin__header,
  .origin__tiles,
  .values__layout,
  .sydney__content,
  .sydney__globe {
    visibility: hidden;
  }
</style>

<script>
  function initAboutAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initAboutAnimations, 100);
      return;
    }
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('gsap-ready');
    gsap.set('.about-hero__content, .origin__header, .origin__tiles, .values__layout, .sydney__content, .sydney__globe', {
      visibility: 'visible',
    });

    gsap.fromTo('.about-hero__content',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.1 },
    );

    gsap.fromTo('.origin__header',
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out',
        scrollTrigger: { trigger: '.origin__header', start: 'top 90%', once: true } },
    );
    document.querySelectorAll('.origin__tile').forEach(function(tile, i) {
      gsap.fromTo(tile,
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out', delay: i * 0.15,
          scrollTrigger: { trigger: '.origin__tiles', start: 'top 85%', once: true } },
      );
    });

    setTimeout(() => ScrollTrigger.refresh(), 500);
    setTimeout(() => ScrollTrigger.refresh(), 1500);

    gsap.fromTo('.sydney__content',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: '.sydney__content', start: 'top 90%', once: true } },
    );

    var globeEl = document.querySelector('.sydney__globe');
    var canvas = document.getElementById('globeCanvas');
    var geoDataEl = document.getElementById('geoData');
    if (globeEl && canvas && geoDataEl) {
      var ctx = canvas.getContext('2d');
      var geoData = JSON.parse(geoDataEl.textContent || '{}');
      var GR = 168, CX = 240, CY = 240;
      var dpr = window.devicePixelRatio || 1;

      canvas.width = 480 * dpr;
      canvas.height = 480 * dpr;
      ctx.scale(dpr, dpr);

      var START_LON = -30;
      var END_LON = 151.2093;
      var CENTER_LAT = -33.8688;
      var globeProgress = { lon: START_LON };

      function gProj(lat, lon, cLon) {
        var lr = lat * Math.PI / 180;
        var dr = lon * Math.PI / 180 - cLon * Math.PI / 180;
        var latR = CENTER_LAT * Math.PI / 180;
        var sinL = Math.sin(latR), cosL = Math.cos(latR);
        var cosC = sinL * Math.sin(lr) + cosL * Math.cos(lr) * Math.cos(dr);
        if (cosC <= 0) return null;
        return [
          CX + GR * Math.cos(lr) * Math.sin(dr),
          CY - GR * (cosL * Math.sin(lr) - sinL * Math.cos(lr) * Math.cos(dr))
        ];
      }

      function isLight() {
        return document.documentElement.getAttribute('data-theme') === 'light';
      }

      function drawGlobe(cLon) {
        var light = isLight();
        var accentR = light ? 'rgba(26,58,92,' : 'rgba(78,216,194,';
        var accentSolid = light ? '#1A3A5C' : '#4ED8C2';
        var bgDark = light ? 'rgba(237,233,227,' : 'rgba(12,14,20,';

        ctx.clearRect(0, 0, 480, 480);

        var atmo = ctx.createRadialGradient(CX, CY, GR * 0.7, CX, CY, 200);
        atmo.addColorStop(0, 'transparent');
        atmo.addColorStop(0.85, accentR + '0.02)');
        atmo.addColorStop(0.95, accentR + '0.05)');
        atmo.addColorStop(1, accentR + '0.015)');
        ctx.fillStyle = atmo;
        ctx.beginPath(); ctx.arc(CX, CY, 200, 0, Math.PI * 2); ctx.fill();

        ctx.strokeStyle = accentR + '0.1)';
        ctx.lineWidth = 0.8;
        ctx.beginPath(); ctx.arc(CX, CY, GR, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = bgDark + '0.1)';
        ctx.fill();

        ctx.save();
        ctx.beginPath(); ctx.arc(CX, CY, GR, 0, Math.PI * 2); ctx.clip();

        ctx.strokeStyle = accentR + '0.06)';
        ctx.lineWidth = 0.4;
        ctx.setLineDash([2, 6]);
        var latDegs = [-60, -30, 0, 30, 60];
        for (var li = 0; li < latDegs.length; li++) {
          var pts = [];
          for (var lo = -180; lo <= 180; lo += 5) {
            var p = gProj(latDegs[li], lo, cLon);
            if (p) pts.push(p);
          }
          if (pts.length > 1) {
            ctx.beginPath(); ctx.moveTo(pts[0][0], pts[0][1]);
            for (var pi = 1; pi < pts.length; pi++) {
              var dx = pts[pi][0] - pts[pi-1][0], dy = pts[pi][1] - pts[pi-1][1];
              if (dx*dx + dy*dy > 2500) { ctx.moveTo(pts[pi][0], pts[pi][1]); continue; }
              ctx.lineTo(pts[pi][0], pts[pi][1]);
            }
            ctx.stroke();
          }
        }

        var lonDegs = [-150,-120,-90,-60,-30,0,30,60,90,120,150,180];
        for (var mi = 0; mi < lonDegs.length; mi++) {
          var mpts = [];
          for (var la = -90; la <= 90; la += 5) {
            var mp = gProj(la, lonDegs[mi], cLon);
            if (mp) mpts.push(mp);
          }
          if (mpts.length > 1) {
            ctx.beginPath(); ctx.moveTo(mpts[0][0], mpts[0][1]);
            for (var mj = 1; mj < mpts.length; mj++) {
              var mdx = mpts[mj][0] - mpts[mj-1][0], mdy = mpts[mj][1] - mpts[mj-1][1];
              if (mdx*mdx + mdy*mdy > 2500) { ctx.moveTo(mpts[mj][0], mpts[mj][1]); continue; }
              ctx.lineTo(mpts[mj][0], mpts[mj][1]);
            }
            ctx.stroke();
          }
        }
        ctx.setLineDash([]);

        var seaSp = 14;
        ctx.fillStyle = accentR + '0.06)';
        for (var sr = 0; sr <= Math.ceil(GR * 2 / seaSp); sr++) {
          var sy = CY - GR + sr * seaSp;
          var sxOff = sr % 2 === 0 ? 0 : seaSp / 2;
          for (var sc = 0; sc <= Math.ceil(GR * 2 / seaSp); sc++) {
            var sx = CX - GR + sc * seaSp + sxOff;
            var sdx = sx - CX, sdy = sy - CY;
            var sdist = Math.sqrt(sdx*sdx + sdy*sdy);
            if (sdist > GR - 4) continue;
            ctx.beginPath(); ctx.arc(sx, sy, 0.6, 0, Math.PI * 2); ctx.fill();
          }
        }

        for (var name in geoData) {
          var data = geoData[name];
          var isAus = !!data.aus;
          var cpts = data.pts;
          var visPts = [];
          for (var ci = 0; ci < cpts.length; ci++) {
            var cp = gProj(cpts[ci][0], cpts[ci][1], cLon);
            if (cp) visPts.push(cp);
          }
          if (visPts.length < 3) continue;

          ctx.beginPath();
          ctx.moveTo(visPts[0][0], visPts[0][1]);
          for (var cj = 1; cj < visPts.length; cj++) {
            ctx.lineTo(visPts[cj][0], visPts[cj][1]);
          }
          ctx.closePath();

          if (isAus) {
            ctx.fillStyle = accentR + '0.08)';
            ctx.fill();
            ctx.strokeStyle = accentSolid;
            ctx.lineWidth = 1.2;
            ctx.globalAlpha = 0.9;
            ctx.stroke();
            ctx.globalAlpha = 1;
          } else {
            ctx.fillStyle = accentR + '0.04)';
            ctx.fill();
            ctx.strokeStyle = accentR + '0.4)';
            ctx.lineWidth = 0.8;
            ctx.setLineDash([2, 2]);
            ctx.stroke();
            ctx.setLineDash([]);
          }
        }

        var limb = ctx.createRadialGradient(CX, CY, 0, CX, CY, GR);
        limb.addColorStop(0, 'transparent');
        limb.addColorStop(0.5, 'transparent');
        limb.addColorStop(0.75, bgDark + (light ? '0.1)' : '0.25)'));
        limb.addColorStop(0.9, bgDark + (light ? '0.25)' : '0.6)'));
        limb.addColorStop(1, bgDark + (light ? '0.4)' : '0.85)'));
        ctx.fillStyle = limb;
        ctx.beginPath(); ctx.arc(CX, CY, GR, 0, Math.PI * 2); ctx.fill();

        var sydPt = gProj(-33.8688, 151.2093, cLon);
        if (sydPt) {
          var pingTime = (Date.now() % 2800) / 2800;
          for (var ri = 0; ri < 3; ri++) {
            var rPhase = (pingTime + ri * 0.32) % 1;
            var rr = 4 + rPhase * 22;
            var rAlpha = 0.8 * (1 - rPhase);
            if (rAlpha > 0.01) {
              ctx.beginPath(); ctx.arc(sydPt[0], sydPt[1], rr, 0, Math.PI * 2);
              ctx.strokeStyle = accentSolid;
              ctx.lineWidth = 1;
              ctx.globalAlpha = rAlpha;
              ctx.stroke();
              ctx.globalAlpha = 1;
            }
          }
          ctx.beginPath(); ctx.arc(sydPt[0], sydPt[1], 5, 0, Math.PI * 2);
          ctx.fillStyle = accentSolid;
          ctx.shadowColor = accentSolid;
          ctx.shadowBlur = 10;
          ctx.fill();
          ctx.shadowBlur = 0;
          ctx.beginPath(); ctx.arc(sydPt[0], sydPt[1], 2, 0, Math.PI * 2);
          ctx.fillStyle = light ? '#0C0E14' : '#F7F4EF';
          ctx.fill();
        }

        ctx.restore();

        if (sydPt) {
          var cx1 = sydPt[0] + 80, cy1 = sydPt[1] + 55;
          var cx2 = cx1 + 90;
          ctx.beginPath();
          ctx.moveTo(sydPt[0], sydPt[1]);
          ctx.lineTo(cx1, cy1);
          ctx.lineTo(cx2, cy1);
          ctx.strokeStyle = accentR + '0.6)';
          ctx.lineWidth = 1;
          ctx.setLineDash([2, 3]);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.beginPath(); ctx.arc(cx1, cy1, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = accentSolid;
          ctx.globalAlpha = 0.5;
          ctx.fill();
          ctx.globalAlpha = 1;

          ctx.font = '600 11px monospace';
          ctx.fillStyle = accentSolid;
          ctx.textAlign = 'start';
          ctx.fillText('SYDNEY', cx1 + 8, cy1 - 6);
          ctx.font = '8px monospace';
          ctx.fillStyle = accentR + '0.6)';
          ctx.fillText('33.87° S  151.21° E', cx1 + 8, cy1 + 8);
        }

        ctx.save();
        ctx.translate(CX, CY);
        ctx.rotate(-20 * Math.PI / 180);
        ctx.beginPath();
        ctx.ellipse(0, 0, 210, 85, 0, 0, Math.PI * 2);
        ctx.strokeStyle = accentR + '0.04)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
        ctx.restore();
      }

      drawGlobe(START_LON);

      gsap.fromTo(globeEl,
        { scale: 0.85, opacity: 0 },
        { scale: 1, opacity: 1, duration: 1.2, ease: 'power3.out',
          scrollTrigger: { trigger: globeEl, start: 'top 90%', once: true } },
      );

      gsap.fromTo(globeProgress,
        { lon: START_LON },
        { lon: END_LON, ease: 'none',
          scrollTrigger: {
            trigger: '.sydney',
            start: 'top 95%',
            end: 'center center',
            scrub: 1.5,
            onUpdate: function() { drawGlobe(globeProgress.lon); },
          },
        },
      );

      var pingsActive = false;
      function animatePings() {
        if (!pingsActive) return;
        drawGlobe(globeProgress.lon);
        requestAnimationFrame(animatePings);
      }
      ScrollTrigger.create({
        trigger: '.sydney',
        start: 'top bottom',
        end: 'bottom top',
        onEnter: function() { pingsActive = true; animatePings(); },
        onLeave: function() { pingsActive = false; },
        onEnterBack: function() { pingsActive = true; animatePings(); },
        onLeaveBack: function() { pingsActive = false; },
      });

      var observer = new MutationObserver(function() { drawGlobe(globeProgress.lon); });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  }
  initAboutAnimations();

  (function () {
    const cards = document.querySelectorAll('.vcard');
    const dots = document.querySelectorAll('.values__dot');
    if (!cards.length) return;

    let current = 0;
    let paused = false;
    let pauseTimer = null;
    const total = cards.length;
    const CYCLE_MS = 4500;

    function setPositions() {
      cards.forEach((card, i) => {
        const offset = (i - current + total) % total;
        card.setAttribute('data-pos', offset);
        card.classList.toggle('vcard--expanded', offset === 0);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('values__dot--active', i === current);
      });
    }

    function advance() {
      current = (current + 1) % total;
      setPositions();
    }

    function goTo(index) {
      current = index;
      setPositions();
      paused = true;
      clearTimeout(pauseTimer);
      pauseTimer = setTimeout(() => { paused = false; }, 8000);
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-vcard'));
        if (idx !== current) goTo(idx);
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goTo(parseInt(dot.getAttribute('data-dot')));
      });
    });

    const stack = document.getElementById('valuesStack');
    let touchStartX = 0;
    let touchStartY = 0;
    let isSwiping = false;

    if (stack) {
      stack.addEventListener('touchstart', function (e) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = true;
      }, { passive: true });

      stack.addEventListener('touchend', function (e) {
        if (!isSwiping) return;
        isSwiping = false;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) {
            goTo((current + 1) % total);
          } else {
            goTo((current - 1 + total) % total);
          }
        }
      }, { passive: true });
    }

    setPositions();

    setInterval(() => {
      if (!paused) advance();
    }, CYCLE_MS);
  })();

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && typeof gsap !== 'undefined') {
      gsap.ticker.wake();
      ScrollTrigger.refresh();
    }
  });
</script>
