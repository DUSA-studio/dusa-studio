---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';

const title = 'CRM para Coaches e Consultores | DUSA.studio';
const description = 'Automatize geracao de leads, onboarding de clientes, agendamento de sessoes e renovacao de pacotes. O DUSA e a plataforma de crescimento tudo-em-um para coaches e consultores.';

const painPoints = [
  {
    icon: '📋',
    title: 'Mais Burocracia do que Coaching',
    desc: 'Voce se tornou coach para ajudar pessoas, nao para gastar metade da semana com notas fiscais, agendamentos e emails de acompanhamento.',
  },
  {
    icon: '📉',
    title: 'Fluxo de Leads Inconsistente',
    desc: 'Alguns meses estao lotados. Outros, vazios. Sem um sistema, seu pipeline depende de indicacoes e sorte.',
  },
  {
    icon: '🚪',
    title: 'Sem Sistema de Onboarding',
    desc: 'Cada novo cliente recebe uma experiencia diferente. Formularios de entrada, emails de boas-vindas e preparacao para a primeira sessao acontecem manualmente toda vez.',
  },
  {
    icon: '🗓️',
    title: 'Agendamento Manual de Sessoes',
    desc: 'Emails de ida e volta para achar um horario. Lembretes esquecidos. Faltas. Tudo isso se acumula em receita perdida e energia desperdicada.',
  },
];

const features = [
  {
    title: 'Funil de Chamada de Descoberta',
    desc: 'Uma landing page, formulario de agendamento e sequencia de confirmacao que transforma visitantes do site em chamadas de descoberta agendadas.',
  },
  {
    title: 'Sequencias de Onboarding de Clientes',
    desc: 'Emails de boas-vindas automaticos, formularios de entrada, assinatura de contrato e preparacao para a primeira sessao. Cada cliente recebe um inicio consistente e profissional.',
  },
  {
    title: 'Agendamento de Sessoes e Lembretes',
    desc: 'Clientes agendam diretamente pela sua agenda. Lembretes automaticos sao enviados 24 horas e 1 hora antes de cada sessao.',
  },
  {
    title: 'Acompanhamento de Progresso',
    desc: 'Classifique clientes por estagio do programa, acompanhe marcos e dispare mensagens de check-in nos momentos certos.',
  },
  {
    title: 'Automacao de Renovacao de Pacotes',
    desc: 'Quando um pacote de coaching esta chegando ao fim, a comunicacao automatica comeca. Conversas de renovacao iniciam sem voce levantar um dedo.',
  },
  {
    title: 'Coleta de Depoimentos',
    desc: 'Apos o termino de um engajamento de coaching, solicite automaticamente depoimentos e avaliacoes. Construa prova social enquanto a experiencia esta fresca.',
  },
];

const pipeline = [
  { stage: 'Chamada de Descoberta', desc: 'Prospect agenda e preenche formulario de entrada' },
  { stage: 'Integrado', desc: 'Contrato assinado, sequencia de boas-vindas entregue' },
  { stage: 'Coaching Ativo', desc: 'Sessoes em andamento, progresso acompanhado' },
  { stage: 'Renovacao de Pacote', desc: 'Comunicacao automatica de renovacao em 80% de conclusao' },
  { stage: 'Alumni', desc: 'Depoimento coletado, programa de indicacao ativado' },
  { stage: 'Indicacoes e Upsell', desc: 'Clientes anteriores indicam novos leads e exploram programas avancados. O DUSA rastreia creditos de indicacao e promove ofertas premium.' },
];

const stats = [
  { value: '62%', label: 'dos coaches dizem que trabalho administrativo e seu maior consumidor de tempo' },
  { value: '4x', label: 'mais chamadas de descoberta agendadas com funil automatizado' },
  { value: '35%', label: 'maior taxa de renovacao com sequencias automaticas de reengajamento' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dusa.studio/' },
    { '@type': 'ListItem', position: 2, name: 'Industrias', item: 'https://dusa.studio/br/industries' },
    { '@type': 'ListItem', position: 3, name: 'Coaches e Consultores', item: 'https://dusa.studio/br/industries/coaches' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="co-hero section section--dark">
    <div class="container">
      <div class="co-hero__content">
        <span class="label">Coaches e Consultores</span>
        <h1>O <span class="gradient-text">CRM</span> que permite voce focar no coaching</h1>
        <p class="co-hero__sub">
          Automatize seu fluxo de leads, onboarding, agendamento e renovacoes. Gaste seu tempo com clientes, nao com burocracia.
        </p>
        <div class="co-hero__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="co-pain section section--dark">
    <div class="container">
      <div class="co-pain__header">
        <span class="label">O Problema</span>
        <h2>Voce nao comecou a fazer coaching para <span class="gradient-text">fazer burocracia</span></h2>
        <p class="co-pain__intro">A maioria dos coaches e consultores perde horas toda semana com tarefas que deveriam ser automatizadas. Veja como isso se parece.</p>
      </div>
      <div class="co-pain__grid">
        {painPoints.map((point) => (
          <div class="co-pain__card">
            <span class="co-pain__icon">{point.icon}</span>
            <h3 class="co-pain__card-title">{point.title}</h3>
            <p class="co-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="co-solution section section--dark">
    <div class="container">
      <div class="co-solution__header">
        <span class="label">A Solucao</span>
        <h2>Como o DUSA funciona para <span class="gradient-text">coaches e consultores</span></h2>
        <p class="co-solution__intro">Uma plataforma para gerenciar toda a jornada do cliente, do primeiro contato a indicacao como alumni.</p>
      </div>
      <div class="co-solution__grid">
        {features.map((feature) => (
          <div class="co-solution__card">
            <h3 class="co-solution__card-title">{feature.title}</h3>
            <p class="co-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="co-pipeline section section--dark">
    <div class="container">
      <div class="co-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Seu <span class="gradient-text">pipeline de clientes</span> em um relance</h2>
      </div>
      <div class="co-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="co-pipeline__stage">
            <div class="co-pipeline__number">{i + 1}</div>
            <h3 class="co-pipeline__stage-title">{step.stage}</h3>
            <p class="co-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="co-stats section section--dark">
    <div class="container">
      <div class="co-stats__header">
        <span class="label">Impacto</span>
        <h2>Os numeros falam por <span class="gradient-text">si mesmos</span></h2>
      </div>
      <div class="co-stats__grid">
        {stats.map((stat) => (
          <div class="co-stats__card">
            <span class="co-stats__value">{stat.value}</span>
            <p class="co-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="co-cta section section--dark">
    <div class="container">
      <div class="co-cta__box">
        <h2>Pronto para <span class="gradient-text">crescer sua pratica</span>?</h2>
        <p class="co-cta__sub">Tenha seu funil de chamada de descoberta, sequencias de onboarding e automacao de renovacao funcionando em uma so plataforma.</p>
        <div class="co-cta__actions">
          <a href="/br/start" class="btn btn--primary">Comecar</a>
          <a href="/blog/crm-for-coaches" class="btn btn--outline">Leia o guia</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .co-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .co-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .co-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .co-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .co-pain {
    padding: var(--space-2xl) 0;
  }
  .co-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .co-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .co-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .co-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .co-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .co-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .co-solution {
    padding: var(--space-2xl) 0;
  }
  .co-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .co-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .co-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .co-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .co-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .co-pipeline {
    padding: var(--space-2xl) 0;
  }
  .co-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .co-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .co-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .co-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .co-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .co-stats {
    padding: var(--space-2xl) 0;
  }
  .co-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .co-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .co-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .co-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .co-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .co-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .co-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .co-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .co-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .co-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .co-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .co-hero__content h1,
  :global(html[data-theme="light"]) .co-pain__header h2,
  :global(html[data-theme="light"]) .co-solution__header h2,
  :global(html[data-theme="light"]) .co-pipeline__header h2,
  :global(html[data-theme="light"]) .co-stats__header h2,
  :global(html[data-theme="light"]) .co-cta__box h2,
  :global(html[data-theme="light"]) .co-pain__card-title,
  :global(html[data-theme="light"]) .co-solution__card-title,
  :global(html[data-theme="light"]) .co-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .co-hero__sub,
  :global(html[data-theme="light"]) .co-pain__intro,
  :global(html[data-theme="light"]) .co-solution__intro,
  :global(html[data-theme="light"]) .co-pain__card-desc,
  :global(html[data-theme="light"]) .co-solution__card-desc,
  :global(html[data-theme="light"]) .co-pipeline__stage-desc,
  :global(html[data-theme="light"]) .co-stats__label,
  :global(html[data-theme="light"]) .co-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .co-pain__card,
  :global(html[data-theme="light"]) .co-solution__card,
  :global(html[data-theme="light"]) .co-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .co-pain__card:hover,
  :global(html[data-theme="light"]) .co-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .co-stats__card,
  :global(html[data-theme="light"]) .co-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .co-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .co-stats__value {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .co-pain__grid {
      grid-template-columns: 1fr;
    }
    .co-solution__grid {
      grid-template-columns: 1fr;
    }
    .co-stats__grid {
      grid-template-columns: 1fr;
    }
    .co-pipeline__stages {
      flex-direction: column;
    }
    .co-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .co-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>
