---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';

const title = 'CRM pour gestionnaires immobiliers | DUSA.studio';
const description = 'Automatisez la communication avec les locataires, les demandes de maintenance, les renouvellements de bail et le recouvrement des loyers. DUSA est la plateforme de croissance tout-en-un conçue pour les gestionnaires immobiliers.';

const painPoints = [
  {
    icon: '📨',
    title: 'Communication locataire dispersée',
    desc: 'Les messages des locataires sont répartis entre email, téléphone, SMS et portails. Rien n\'est centralisé, et des demandes passent entre les mailles du filet.',
  },
  {
    icon: '🔧',
    title: 'Demandes de maintenance perdues dans les emails',
    desc: 'Les demandes de réparation arrivent de partout sans aucun système pour les prioriser, les attribuer ou les suivre. Les locataires sont frustrés. Vous êtes blâmé.',
  },
  {
    icon: '📅',
    title: 'Suivi manuel des renouvellements de bail',
    desc: 'Les tableurs et les rappels de calendrier ne constituent pas une stratégie de renouvellement. Les baux expirent, les locataires partent et les vacances vous coûtent des milliers d\'euros.',
  },
  {
    icon: '💸',
    title: 'Recouvrement de loyers en retard',
    desc: 'Relancer les loyers manuellement chaque mois fait perdre du temps et crée des conversations gênantes. Les rappels automatisés résolvent les deux problèmes.',
  },
];

const features = [
  {
    title: 'Automatisation du cycle de vie locataire',
    desc: 'De la demande à l\'emménagement jusqu\'au renouvellement, chaque étape est cartographiée et automatisée. Aucun locataire ne passe entre les mailles du filet.',
  },
  {
    title: 'Pipeline de demandes de maintenance',
    desc: 'Les locataires soumettent leurs demandes via un formulaire. Vous triez, attribuez et suivez la résolution depuis un tableau de bord unique.',
  },
  {
    title: 'Séquences de rappel de loyer',
    desc: 'Des rappels automatisés par SMS et email sont envoyés avant la date d\'échéance, le jour de l\'échéance et en cas de retard de paiement.',
  },
  {
    title: 'Campagnes de renouvellement de bail',
    desc: 'Déclenchez une communication de renouvellement 90 jours avant l\'expiration du bail. Automatisez les relances jusqu\'à ce que le locataire confirme.',
  },
  {
    title: 'Rapports pour les propriétaires',
    desc: 'Générez des rapports mensuels pour les propriétaires avec les taux d\'occupation, les mises à jour de maintenance et les synthèses de recouvrement des loyers.',
  },
];

const pipeline = [
  { stage: 'Demande', desc: 'Le nouveau locataire remplit un formulaire d\'intérêt' },
  { stage: 'Candidature', desc: 'Vérifications d\'antécédents et de solvabilité en cours' },
  { stage: 'Bail signé', desc: 'Contrat exécuté, emménagement planifié' },
  { stage: 'Locataire actif', desc: 'Communication continue et gestion de la maintenance' },
  { stage: 'Renouvellement dû', desc: 'Communication automatique lancée à 90 jours' },
  { stage: 'Renouvelé', desc: 'Bail prolongé, le cycle continue' },
];

const stats = [
  { value: '73%', label: 'des locataires préfèrent la communication numérique aux appels téléphoniques' },
  { value: '2.5x', label: 'résolution de maintenance plus rapide avec le triage automatisé' },
  { value: '40%', label: 'de réduction des retards de paiement de loyer grâce aux rappels automatisés' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://dusa.studio/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://dusa.studio/fr/industries' },
    { '@type': 'ListItem', position: 3, name: 'Gestionnaires immobiliers', item: 'https://dusa.studio/fr/industries/property-managers' },
  ],
});
---

<BaseLayout t={tData} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="pm-hero section section--dark">
    <div class="container">
      <div class="pm-hero__content">
        <span class="label">Gestion immobilière</span>
        <h1>La <span class="gradient-text">plateforme de croissance</span> conçue pour les gestionnaires immobiliers</h1>
        <p class="pm-hero__sub">
          Automatisez la communication avec les locataires, les processus de maintenance, les renouvellements de bail et le recouvrement des loyers. Le tout depuis une seule plateforme.
        </p>
        <div class="pm-hero__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pm-pain section section--dark">
    <div class="container">
      <div class="pm-pain__header">
        <span class="label">Le problème</span>
        <h2>La gestion immobilière est <span class="gradient-text">noyée sous l'administratif</span></h2>
        <p class="pm-pain__intro">La plupart des gestionnaires immobiliers sont coincés entre des outils déconnectés et des processus manuels. Voici à quoi cela ressemble.</p>
      </div>
      <div class="pm-pain__grid">
        {painPoints.map((point) => (
          <div class="pm-pain__card">
            <span class="pm-pain__icon">{point.icon}</span>
            <h3 class="pm-pain__card-title">{point.title}</h3>
            <p class="pm-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="pm-solution section section--dark">
    <div class="container">
      <div class="pm-solution__header">
        <span class="label">La solution</span>
        <h2>Comment DUSA fonctionne pour les <span class="gradient-text">gestionnaires immobiliers</span></h2>
        <p class="pm-solution__intro">Une seule plateforme pour gérer chaque interaction locataire, de la première demande au renouvellement du bail.</p>
      </div>
      <div class="pm-solution__grid">
        {features.map((feature) => (
          <div class="pm-solution__card">
            <h3 class="pm-solution__card-title">{feature.title}</h3>
            <p class="pm-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pm-pipeline section section--dark">
    <div class="container">
      <div class="pm-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Votre <span class="gradient-text">pipeline locataire</span> en un coup d'oeil</h2>
      </div>
      <div class="pm-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="pm-pipeline__stage">
            <div class="pm-pipeline__number">{i + 1}</div>
            <h3 class="pm-pipeline__stage-title">{step.stage}</h3>
            <p class="pm-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="pm-stats section section--dark">
    <div class="container">
      <div class="pm-stats__header">
        <span class="label">Impact</span>
        <h2>Les chiffres parlent <span class="gradient-text">d'eux-mêmes</span></h2>
      </div>
      <div class="pm-stats__grid">
        {stats.map((stat) => (
          <div class="pm-stats__card">
            <span class="pm-stats__value">{stat.value}</span>
            <p class="pm-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pm-cta section section--dark">
    <div class="container">
      <div class="pm-cta__box">
        <h2>Prêt à simplifier votre <span class="gradient-text">gestion immobilière</span> ?</h2>
        <p class="pm-cta__sub">Lancez votre pipeline locataire, vos processus de maintenance et vos campagnes de renouvellement sur une seule plateforme.</p>
        <div class="pm-cta__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/blog/crm-for-property-managers" class="btn btn--outline">Lire le guide</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .pm-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .pm-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .pm-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .pm-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pm-pain {
    padding: var(--space-2xl) 0;
  }
  .pm-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .pm-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .pm-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .pm-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .pm-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .pm-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .pm-solution {
    padding: var(--space-2xl) 0;
  }
  .pm-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .pm-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .pm-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .pm-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .pm-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .pm-pipeline {
    padding: var(--space-2xl) 0;
  }
  .pm-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .pm-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .pm-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .pm-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .pm-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .pm-stats {
    padding: var(--space-2xl) 0;
  }
  .pm-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .pm-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .pm-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .pm-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .pm-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .pm-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .pm-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .pm-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .pm-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .pm-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .pm-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .pm-hero__content h1,
  :global(html[data-theme="light"]) .pm-pain__header h2,
  :global(html[data-theme="light"]) .pm-solution__header h2,
  :global(html[data-theme="light"]) .pm-pipeline__header h2,
  :global(html[data-theme="light"]) .pm-stats__header h2,
  :global(html[data-theme="light"]) .pm-cta__box h2,
  :global(html[data-theme="light"]) .pm-pain__card-title,
  :global(html[data-theme="light"]) .pm-solution__card-title,
  :global(html[data-theme="light"]) .pm-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .pm-hero__sub,
  :global(html[data-theme="light"]) .pm-pain__intro,
  :global(html[data-theme="light"]) .pm-solution__intro,
  :global(html[data-theme="light"]) .pm-pain__card-desc,
  :global(html[data-theme="light"]) .pm-solution__card-desc,
  :global(html[data-theme="light"]) .pm-pipeline__stage-desc,
  :global(html[data-theme="light"]) .pm-stats__label,
  :global(html[data-theme="light"]) .pm-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .pm-pain__card,
  :global(html[data-theme="light"]) .pm-solution__card,
  :global(html[data-theme="light"]) .pm-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .pm-pain__card:hover,
  :global(html[data-theme="light"]) .pm-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .pm-stats__card,
  :global(html[data-theme="light"]) .pm-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .pm-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .pm-stats__value {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pm-pain__grid {
      grid-template-columns: 1fr;
    }
    .pm-solution__grid {
      grid-template-columns: 1fr;
    }
    .pm-stats__grid {
      grid-template-columns: 1fr;
    }
    .pm-pipeline__stages {
      flex-direction: column;
    }
    .pm-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .pm-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }
</style>