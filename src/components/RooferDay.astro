---
/**
 * RooferDay.astro
 *
 * A roofer's Tuesday, with and without DUSA, in one picture. An iPhone sits
 * in the middle of an illustrated scene and a divider runs straight through
 * it. Left of the line is the day without DUSA (red: missed, later, overdue),
 * right of the line is the same day with it (green: replied, booked, paid).
 * Drag the line and red turns green.
 *
 * The day plays on its own: six moments on a timeline under the phone,
 * advancing every few seconds, tap any time to jump. Each moment swaps the
 * notifications on both halves of the phone and nudges the scene (sun, ute,
 * evening). The last moment is 9pm: a laptop at the kitchen table on the
 * left, the family on the deck on the right.
 *
 * All HTML/SVG/CSS. No 3D, no scroll-jacking. The two halves are the same
 * markup rendered twice, the right copy clipped by the slider, so every row
 * lines up and the line cuts through each one.
 */
interface Moment { time: string; off: { app: string; title: string; body: string; line: string }; on: { app: string; title: string; body: string; line: string } }
interface Props {
  eyebrow?: string;
  heading?: string;
  headingAccent?: string;
  sub?: string;
  labelOff?: string;
  labelOn?: string;
  date?: string;
  cta?: string;
  ctaDemo?: string;
  moments?: Moment[];
}
const {
  eyebrow = "A roofer's Tuesday",
  heading = 'Slide to see your Tuesday',
  headingAccent = 'with DUSA.',
  sub = 'Same roofer, same jobs, same phone. Only the admin is different.',
  labelOff = 'Without DUSA',
  labelOn = 'With DUSA',
  date = 'Tuesday 21 October',
  cta = 'Start free for 14 days',
  ctaDemo = 'Book a free demo',
  moments = [
    { time: '6:40',
      off: { app: 'Phone', title: 'Voicemail (3)', body: 'Sam, Priya, unknown. Call back at lunch.', line: 'Three voicemails. Two have already rung the next roofer.' },
      on:  { app: 'DUSA', title: 'Site visits booked', body: 'Sam, Thu 9:00am. Priya, Fri 7:30am.', line: 'Three enquiries answered overnight. Two site visits booked.' } },
    { time: '9:15',
      off: { app: 'Phone', title: 'Missed call', body: 'Dave M. No voicemail.', line: 'Phone rang in the ute. Job gone.' },
      on:  { app: 'DUSA', title: 'Replied in 8 seconds', body: 'Dave M: "Re-roof in Belmont, can you quote?"', line: 'Texted back in 8 seconds. Job booked.' } },
    { time: '11:30',
      off: { app: 'Reminders', title: 'Send Dave the quote', body: 'Tonight. If there is time.', line: 'Quote goes out at 10pm from the kitchen table.' },
      on:  { app: 'DUSA', title: 'Deposit received', body: '$1,200 from Dave M. Job booked Monday.', line: 'Quote sent from the ute. Deposit paid by lunch.' } },
    { time: '1:30',
      off: { app: 'Reminders', title: "Text tomorrow's customer", body: 'Harbour St. Confirm 7am.', line: "Tomorrow's customer has no idea he is coming." },
      on:  { app: 'DUSA', title: 'Reminder sent', body: 'Thu 7:00am, 14 Harbour St. Confirmed.', line: "Tomorrow's customer is confirmed. Driveway cleared." } },
    { time: '4:45',
      off: { app: 'Reminders', title: 'Invoice Harbour St', body: 'Sunday. Paid in three weeks.', line: 'Invoice on Sunday. Paid in three weeks.' },
      on:  { app: 'DUSA', title: 'Invoice #2041 paid', body: '$4,800 by card. Review request queued.', line: 'Invoice sent from the ladder. Paid before the ute is packed.' } },
    { time: '9:00',
      off: { app: 'Reminders', title: '4 follow-ups overdue', body: 'Quotes, invoices, Priya, Sam.', line: 'Kitchen table. Laptop. Same again tomorrow.' },
      on:  { app: 'DUSA', title: 'New 5-star review', body: '"Booked in minutes." Reply posted.', line: 'Home by 5:30. Review landed, replied. Tomorrow booked.' } },
  ],
} = Astro.props;
const BOOK = 'https://link.dusa.studio/widget/bookings/dusa-demo';
const pm = (i: number) => i >= 3;
const clock = (m: Moment, i: number) => m.time;
const ampm = (i: number) => (pm(i) ? 'pm' : 'am');

/* One scene, drawn once, stamped into both layers. The `only-off` and
   `only-on` classes hide parts per layer: the laptop glow versus the family,
   the bin versus the picket fence. */
const scene = `
<svg class="ww__svg" viewBox="0 0 1200 675" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="skyG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="sky1"/><stop offset="1" class="sky2"/>
    </linearGradient>
    <radialGradient id="sunG" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#ffd58a" stop-opacity="0.9"/><stop offset="1" stop-color="#ffd58a" stop-opacity="0"/></radialGradient>
    <radialGradient id="warmG" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#ffb36b" stop-opacity="0.55"/><stop offset="1" stop-color="#ffb36b" stop-opacity="0"/></radialGradient>
    <radialGradient id="coldG" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#9fd8ff" stop-opacity="0.55"/><stop offset="1" stop-color="#9fd8ff" stop-opacity="0"/></radialGradient>
  </defs>
  <rect class="sky" width="1200" height="675" fill="url(#skyG)"/>
  <g class="stars">
    <circle cx="120" cy="80" r="1.6"/><circle cx="300" cy="140" r="1.2"/><circle cx="520" cy="60" r="1.4"/><circle cx="700" cy="120" r="1"/><circle cx="900" cy="70" r="1.6"/><circle cx="1050" cy="160" r="1.2"/><circle cx="1130" cy="60" r="1"/><circle cx="200" cy="210" r="1"/><circle cx="820" cy="190" r="1.3"/><circle cx="1000" cy="250" r="0.9"/>
  </g>
  <g class="sun"><circle class="sunHalo" r="110" fill="url(#sunG)"/><circle r="26" class="sunBall"/></g>
  <g class="moon"><circle r="18" class="moonBall"/></g>
  <path class="hill" d="M0 470 C 200 430 380 440 600 455 C 820 470 1000 440 1200 460 L1200 675 L0 675 Z"/>
  <path class="road" d="M0 560 L1200 540 L1200 600 L0 620 Z"/>
  <path class="roadLine" d="M40 590 L160 587 M240 585 L360 582 M440 580 L560 577 M640 575 L760 572 M840 570 L960 567 M1040 565 L1160 562"/>

  <!-- Job site: house, ladder, roofer on the roof -->
  <g class="job">
    <g class="tree" transform="translate(150 455)"><path d="M0 0v-40"/><circle cy="-70" r="34"/></g>
    <g class="tree" transform="translate(1080 445)"><path d="M0 0v-36"/><circle cy="-62" r="30"/></g>
    <g class="house" transform="translate(330 300)">
      <path class="wall" d="M-120 160 V40 H120 V160 Z"/>
      <path class="roof" d="M-150 44 L0 -60 L150 44 Z"/>
      <path d="M-150 44 H150"/>
      <rect x="-88" y="70" width="40" height="36" rx="3" class="win"/>
      <rect x="48" y="70" width="40" height="36" rx="3" class="win"/>
      <rect x="-18" y="96" width="36" height="64" rx="3" class="door"/>
      <rect x="60" y="-40" width="20" height="40" class="chim"/>
      <!-- ladder on the side wall -->
      <g class="ladder" transform="translate(-150 160) rotate(-20)">
        <path d="M-9 0 V-150 M9 0 V-150"/>
        <path d="M-9 -20 H9 M-9 -45 H9 M-9 -70 H9 M-9 -95 H9 M-9 -120 H9"/>
      </g>
      <!-- roofer, sitting astride the ridge -->
      <g class="roofer" transform="translate(-40 -40)">
        <circle cx="0" cy="-30" r="10"/>
        <path class="hat" d="M-13 -36 Q0 -48 13 -36"/>
        <path d="M0 -20 V8 M0 -8 L-14 10 M0 8 L-10 26 M0 8 L12 24"/>
        <g class="arm"><path d="M0 -14 L16 -2"/><path class="hammer" d="M16 -2 L26 -12 M22 -16 L30 -8"/></g>
      </g>
      <!-- the phone, down in the ute: rings on the left only -->
    </g>
    <g class="ute" transform="translate(840 560)">
      <path class="body" d="M-110 -6 H-20 V-46 H40 L70 -16 H110 V-6 Q118 -6 118 2 V14 H-118 V2 Q-118 -6 -110 -6 Z"/>
      <path class="glass" d="M-12 -40 H34 L58 -16 H-12 Z"/>
      <circle cx="-72" cy="16" r="16"/><circle cx="72" cy="16" r="16"/>
      <circle cx="-72" cy="16" r="6"/><circle cx="72" cy="16" r="6"/>
      <path class="rack only-on" d="M-18 -50 H42"/>
      <g class="ring only-off" transform="translate(-60 -30)"><path d="M14 -10 a16 16 0 0 1 0 20"/><path d="M22 -18 a28 28 0 0 1 0 36"/></g>
      <g class="reply only-on" transform="translate(-60 -34)"><path d="M-26 -8 h40 a6 6 0 0 1 6 6 v12 a6 6 0 0 1 -6 6 h-28 l-8 7 v-7 h-4 a6 6 0 0 1 -6 -6 v-12 a6 6 0 0 1 6 -6z"/><path d="M-18 2 h22 M-18 8 h14"/></g>
    </g>
    <g class="customer only-off" transform="translate(990 540)">
      <circle cy="-70" r="9"/><path d="M0 -61 V-32 M0 -50 L-12 -36 M0 -50 L12 -38 M0 -32 L-9 -8 M0 -32 L9 -8"/>
      <path class="walk" d="M24 -56 l10 -6 M24 -44 l12 -2 M24 -32 l10 6"/>
    </g>
  </g>

  <!-- Home, 9pm: left is a laptop at the table, right is the family on the deck -->
  <g class="home">
    <g class="tree" transform="translate(120 450)"><path d="M0 0v-44"/><circle cy="-76" r="36"/></g>
    <g class="tree only-on" transform="translate(1010 455)"><path d="M0 0v-34"/><circle cy="-60" r="28"/></g>
    <g class="house" transform="translate(300 300)">
      <path class="wall" d="M-140 160 V40 H140 V160 Z"/>
      <path class="roof" d="M-170 44 L0 -70 L170 44 Z"/>
      <path d="M-170 44 H170"/>
      <rect x="-104" y="70" width="44" height="38" rx="3" class="win winCold only-off"/>
      <rect x="-104" y="70" width="44" height="38" rx="3" class="win winWarm only-on"/>
      <rect x="60" y="70" width="44" height="38" rx="3" class="win winWarm"/>
      <rect x="-20" y="96" width="40" height="64" rx="3" class="door doorNice"/>
      <rect x="70" y="-46" width="22" height="46" class="chim"/>
      <!-- deck and table out front -->
      <path class="deck" d="M-170 160 H190 V176 H-170 Z"/>
      <g class="table" transform="translate(40 140)">
        <path d="M-40 0 H40 M-32 0 V28 M32 0 V28"/>
        <!-- without: laptop, cold glow -->
        <g class="only-off"><circle class="glow cold" cx="0" cy="-10" r="60" fill="url(#coldG)" stroke="none"/><path class="laptop" d="M-18 0 V-22 H14 V0 M-20 0 H16"/></g>
        <!-- with: lamp, warm glow, plates -->
        <g class="only-on"><circle class="glow warm" cx="0" cy="-14" r="80" fill="url(#warmG)" stroke="none"/><path d="M0 0 V-26 M-10 -26 H10 L6 -36 H-6 Z"/><circle cx="-22" cy="-3" r="5"/><circle cx="22" cy="-3" r="5"/></g>
      </g>
      <!-- the roofer at the table (both), partner and kid (right only) -->
      <g class="person" transform="translate(-10 122)"><circle cy="-30" r="9"/><path d="M0 -21 V4 M0 -12 L-12 0 M0 -12 L12 -2 M0 4 L-8 20 M0 4 L8 20"/></g>
      <g class="person only-on" transform="translate(92 122)"><circle cy="-30" r="9"/><path d="M0 -21 V4 M0 -12 L12 0 M0 -12 L-12 -2 M0 4 L-8 20 M0 4 L8 20"/></g>
      <g class="person only-on" transform="translate(50 134)"><circle cy="-20" r="6.5"/><path d="M0 -13 V2 M0 -7 L-8 0 M0 -7 L8 0 M0 2 L-5 12 M0 2 L5 12"/></g>
    </g>
    <!-- picket fence, right only -->
    <g class="fence only-on" transform="translate(300 500)">
      <path d="M-220 0 H220 M-220 -14 H220"/>
      <path d="M-210 4 V-26 l5 -6 l5 6 V4 M-180 4 V-26 l5 -6 l5 6 V4 M-150 4 V-26 l5 -6 l5 6 V4 M-120 4 V-26 l5 -6 l5 6 V4 M-90 4 V-26 l5 -6 l5 6 V4 M-60 4 V-26 l5 -6 l5 6 V4 M70 4 V-26 l5 -6 l5 6 V4 M100 4 V-26 l5 -6 l5 6 V4 M130 4 V-26 l5 -6 l5 6 V4 M160 4 V-26 l5 -6 l5 6 V4 M190 4 V-26 l5 -6 l5 6 V4"/>
    </g>
    <g class="bin only-off" transform="translate(470 500)"><path d="M-14 0 V-30 H14 V0 Z M-18 -30 H18"/></g>
    <g class="ute" transform="translate(880 560)">
      <path class="body" d="M-110 -6 H-20 V-46 H40 L70 -16 H110 V-6 Q118 -6 118 2 V14 H-118 V2 Q-118 -6 -110 -6 Z"/>
      <path class="glass" d="M-12 -40 H34 L58 -16 H-12 Z"/>
      <circle cx="-72" cy="16" r="16"/><circle cx="72" cy="16" r="16"/>
      <circle cx="-72" cy="16" r="6"/><circle cx="72" cy="16" r="6"/>
      <path class="rack only-on" d="M-18 -50 H42"/>
    </g>
  </g>
</svg>`;
---

<section class="ww section section--dark" id="roofer-day" data-ww>
  <div class="container">
    <div class="ww__header">
      <span class="label">{eyebrow}</span>
      <h1 class="ww__h1">{heading} <span class="gradient-text">{headingAccent}</span></h1>
      <p class="ww__sub">{sub}</p>
    </div>

    <div class="ww__stage" data-stage data-beat="0" style="--x: 50%">
      {(['off', 'on'] as const).map((side) => (
        <div class={`ww__layer ww__layer--${side}`} aria-hidden={side === 'off' ? undefined : 'true'}>
          <Fragment set:html={scene.split('skyG').join('skyG-' + side).split('sunG').join('sunG-' + side).split('warmG').join('warmG-' + side).split('coldG').join('coldG-' + side)} />
          <div class={`ph ph--${side}`}>
            <div class="ph__frame">
              <div class="ph__screen">
                <div class="ph__island"></div>
                <div class="ph__lock">
                  <span class="ph__date">{date}</span>
                  <span class="ph__clock" data-clock>{moments[0].time}</span>
                </div>
                <ol class="ph__notifs">
                  {moments.map((m, i) => (
                    <li class="ph__notif" data-notif={i} hidden={i !== 0 ? true : undefined}>
                      <span class={`ph__icon ph__icon--${side}`}>
                        {side === 'on'
                          ? <img src="/dusa-logo.webp" alt="" width="20" height="20" loading="lazy" decoding="async" />
                          : <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>}
                      </span>
                      <span class="ph__body">
                        <span class="ph__row"><b>{m[side].app}</b><em>now</em></span>
                        <span class="ph__title">{m[side].title}</span>
                        <span class="ph__text">{m[side].body}</span>
                      </span>
                    </li>
                  ))}
                </ol>
                <div class="ph__home"></div>
              </div>
            </div>
          </div>
        </div>
      ))}

      <span class="ww__tag ww__tag--off"><i aria-hidden="true"></i>{labelOff}</span>
      <span class="ww__tag ww__tag--on"><i aria-hidden="true"></i>{labelOn}</span>

      <div class="ww__handle" data-handle role="slider" tabindex="0" aria-label="Slide between without and with DUSA" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-orientation="horizontal">
        <span class="ww__line"></span>
        <span class="ww__grip" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"/></svg>
        </span>
      </div>
    </div>

    <div class="ww__timeline" role="tablist" aria-label="Moments of the day">
      {moments.map((m, i) => (
        <button type="button" class={`ww__time${i === 0 ? ' is-on' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-time={i}>
          <span class="ww__time-bar" aria-hidden="true"><span></span></span>
          <b>{clock(m, i)}<small>{ampm(i)}</small></b>
        </button>
      ))}
    </div>

    <div class="ww__lines" aria-live="polite">
      {moments.map((m, i) => (
        <div class="ww__pair" data-pair={i} hidden={i !== 0 ? true : undefined}>
          <p class="ww__line-off"><i aria-hidden="true"></i>{m.off.line}</p>
          <p class="ww__line-on"><i aria-hidden="true"></i>{m.on.line}</p>
        </div>
      ))}
    </div>

    <div class="ww__ctas">
      <a href="/start" data-page="start" class="btn btn--primary">{cta}</a>
      <a href={BOOK} target="_blank" rel="noopener noreferrer" class="btn btn--outline">{ctaDemo}</a>
    </div>
  </div>
</section>

<style>
  .ww { position: relative; padding-top: calc(74px + var(--space-xl)); overflow: hidden; }
  .ww__header { text-align: center; max-width: 680px; margin: 0 auto var(--space-lg); }
  .ww__h1 { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.1; margin: 0 0 0.6rem; color: var(--warm-white); }
  .ww__sub { font-size: 1.0625rem; color: rgba(247, 244, 239, 0.66); margin: 0 auto; max-width: 520px; }

  /* ── Stage: two layers, the right one clipped at --x ── */
  .ww__stage {
    position: relative;
    width: 100%; max-width: 1100px; margin: 0 auto;
    aspect-ratio: 16 / 10;
    border-radius: 28px;
    overflow: hidden;
    background: var(--deep-black);
    border: 1px solid rgba(247, 244, 239, 0.1);
    box-shadow: inset 0 1px 0 rgba(247, 244, 239, 0.06), 0 30px 80px rgba(0, 0, 0, 0.35);
    touch-action: pan-y;
    user-select: none; -webkit-user-select: none;
    cursor: ew-resize;
  }
  .ww__layer { position: absolute; inset: 0; }
  .ww__layer--on { clip-path: inset(0 0 0 var(--x)); }
  :global(.ww__svg) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* The world: line art in warm white, with the sky and sun following the clock. */
  :global(.ww__svg) { --sky1: #0e1a2b; --sky2: #1a2a40; --ink: rgba(247, 244, 239, 0.78); --fill: rgba(247, 244, 239, 0.05); }
  .ww__layer--on :global(.ww__svg) { --ink: rgba(247, 244, 239, 0.88); }
  :global(.ww__svg .sky1) { stop-color: var(--sky1); transition: stop-color 1.4s ease; }
  :global(.ww__svg .sky2) { stop-color: var(--sky2); transition: stop-color 1.4s ease; }
  :global(.ww__svg :where(path, circle:not(.glow):not(.sunHalo), rect:not(.sky))) { fill: none; stroke: var(--ink); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  :global(.ww__svg .sky) { stroke: none; }
  :global(.ww__svg .stars circle) { fill: rgba(247, 244, 239, 0.9); stroke: none; opacity: 0; transition: opacity 1.4s; }
  :global(.ww__svg .hill) { fill: rgba(78, 216, 194, 0.08); stroke: rgba(247, 244, 239, 0.28); transition: fill 1.4s; }
  :global(.ww__svg .road) { fill: rgba(247, 244, 239, 0.05); stroke: rgba(247, 244, 239, 0.22); }
  :global(.ww__svg .roadLine) { stroke: rgba(247, 244, 239, 0.3); stroke-dasharray: none; }
  :global(.ww__svg .wall) { fill: var(--fill); }
  :global(.ww__svg .roof) { fill: rgba(106, 170, 207, 0.14); }
  .ww__layer--on :global(.ww__svg .roof) { fill: rgba(78, 216, 194, 0.16); }
  :global(.ww__svg .win) { fill: rgba(12, 14, 20, 0.5); transition: fill 1.4s; }
  :global(.ww__svg .door) { fill: rgba(26, 58, 92, 0.6); }
  .ww__layer--on :global(.ww__svg .doorNice) { fill: rgba(78, 216, 194, 0.55); }
  :global(.ww__svg .chim) { fill: var(--fill); }
  :global(.ww__svg .deck) { fill: rgba(201, 162, 122, 0.18); stroke: rgba(201, 162, 122, 0.6); }
  :global(.ww__svg .tree circle) { fill: rgba(47, 106, 98, 0.35); }
  :global(.ww__svg .ute .body) { fill: rgba(26, 58, 92, 0.6); }
  .ww__layer--on :global(.ww__svg .ute .body) { fill: rgba(106, 170, 207, 0.55); }
  :global(.ww__svg .ute .glass) { fill: rgba(159, 216, 234, 0.35); }
  :global(.ww__svg .sunBall) { fill: #ffd58a; stroke: none; }
  :global(.ww__svg .moonBall) { fill: #dde7f5; stroke: none; }
  :global(.ww__svg .sun), :global(.ww__svg .moon) { transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.4s; }
  :global(.ww__svg .glow) { stroke: none; }
  :global(.ww__svg .hat) { stroke-width: 3; }
  :global(.ww__svg .ring), :global(.ww__svg .reply) { stroke: var(--accent); }
  :global(.ww__svg .ring path) { animation: wwRing 1.6s ease-out infinite; }
  :global(.ww__svg .ring path:nth-child(2)) { animation-delay: 0.3s; }
  @keyframes wwRing { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  :global(.ww__svg .arm) { transform-box: fill-box; transform-origin: 2% 12%; animation: wwHammer 0.9s ease-in-out infinite; }
  @keyframes wwHammer { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(-28deg); } }
  :global(.ww__svg .customer) { animation: wwWalk 6s linear infinite; }
  @keyframes wwWalk { 0%, 30% { transform: translate(990px, 540px); opacity: 1; } 100% { transform: translate(1240px, 540px); opacity: 0; } }
  .ww__layer--off { --accent: #ff6b5e; }
  .ww__layer--on { --accent: #4ed8c2; }

  /* Only-left / only-right parts */
  .ww__layer--off :global(.ww__svg .only-on) { display: none; }
  .ww__layer--on :global(.ww__svg .only-off) { display: none; }

  /* The two scenes: job by day, home at 9pm */
  :global(.ww__svg .home) { opacity: 0; transition: opacity 1s; }
  :global(.ww__svg .job) { opacity: 1; transition: opacity 1s; }
  .ww__stage[data-beat="5"] :global(.ww__svg .home) { opacity: 1; }
  .ww__stage[data-beat="5"] :global(.ww__svg .job) { opacity: 0; }

  /* Clock-driven sky and sun. The sun walks an arc from left to right. */
  .ww__stage[data-beat="0"] :global(.ww__svg) { --sky1: #2b2f4a; --sky2: #8d6b7a; }
  .ww__stage[data-beat="1"] :global(.ww__svg) { --sky1: #4a86b8; --sky2: #a9cfe4; }
  .ww__stage[data-beat="2"] :global(.ww__svg) { --sky1: #4f93c7; --sky2: #bcdcef; }
  .ww__stage[data-beat="3"] :global(.ww__svg) { --sky1: #4a8cc0; --sky2: #b6d6ea; }
  .ww__stage[data-beat="4"] :global(.ww__svg) { --sky1: #3d5f8f; --sky2: #e2a06b; }
  .ww__stage[data-beat="5"] :global(.ww__svg) { --sky1: #070b14; --sky2: #16233a; }
  .ww__stage[data-beat="0"] :global(.ww__svg .sun) { transform: translate(140px, 440px); }
  .ww__stage[data-beat="1"] :global(.ww__svg .sun) { transform: translate(330px, 200px); }
  .ww__stage[data-beat="2"] :global(.ww__svg .sun) { transform: translate(600px, 90px); }
  .ww__stage[data-beat="3"] :global(.ww__svg .sun) { transform: translate(820px, 130px); }
  .ww__stage[data-beat="4"] :global(.ww__svg .sun) { transform: translate(1060px, 380px); }
  .ww__stage[data-beat="5"] :global(.ww__svg .sun) { transform: translate(1200px, 560px); opacity: 0; }
  :global(.ww__svg .moon) { transform: translate(1000px, 700px); opacity: 0; }
  .ww__stage[data-beat="5"] :global(.ww__svg .moon) { transform: translate(980px, 120px); opacity: 1; }
  .ww__stage[data-beat="5"] :global(.ww__svg .stars circle) { opacity: 1; }
  .ww__stage[data-beat="5"] :global(.ww__svg .winWarm) { fill: rgba(255, 201, 122, 0.85); }
  .ww__stage[data-beat="5"] :global(.ww__svg .winCold) { fill: rgba(159, 216, 255, 0.75); }
  .ww__stage[data-beat="5"] :global(.ww__svg .hill) { fill: rgba(78, 216, 194, 0.04); }
  /* Without DUSA is a little greyer. The line makes the point before the words do. */
  .ww__layer--off :global(.ww__svg) { filter: saturate(0.55) brightness(0.82); }

  /* ── The iPhone ── */
  .ph {
    position: absolute; left: 50%; top: 50%;
    width: 256px; aspect-ratio: 9 / 19.5;
    transform: translate(-50%, -50%);
    font-family: -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif;
  }
  .ph__frame {
    position: absolute; inset: 0;
    border-radius: 48px;
    background: linear-gradient(160deg, #3a3c43, #1a1b20 40%, #26272d 100%);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.22),
      inset 0 0 0 4px #121318,
      0 1px 0 rgba(255, 255, 255, 0.12),
      0 40px 90px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(78, 216, 194, 0.08);
  }
  /* side buttons */
  .ph__frame::before { content: ''; position: absolute; left: -3px; top: 22%; width: 3px; height: 26px; border-radius: 2px 0 0 2px; background: #2c2d33; box-shadow: 0 46px 0 #2c2d33, 0 86px 0 #2c2d33; }
  .ph__frame::after { content: ''; position: absolute; right: -3px; top: 30%; width: 3px; height: 52px; border-radius: 0 2px 2px 0; background: #2c2d33; }
  .ph__screen {
    position: absolute; inset: 9px;
    border-radius: 40px;
    overflow: hidden;
    background: radial-gradient(120% 70% at 50% 0%, #27405e 0%, #0f1a2b 55%, #0a0f18 100%);
    color: #fff;
  }
  .ph--on .ph__screen { background: radial-gradient(120% 70% at 50% 0%, #1c4a4f 0%, #0f2432 55%, #0a0f18 100%); }
  .ph--off .ph__screen { background: radial-gradient(120% 70% at 50% 0%, #3b2c35 0%, #1a1420 55%, #0b0a10 100%); }
  .ph__island { position: absolute; left: 50%; top: 12px; width: 92px; height: 28px; transform: translateX(-50%); border-radius: 20px; background: #000; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .ph__lock { position: absolute; left: 0; right: 0; top: 52px; text-align: center; line-height: 1; }
  .ph__date { display: block; font-size: 13px; font-weight: 500; letter-spacing: 0.01em; color: rgba(255, 255, 255, 0.8); }
  .ph__clock { display: block; font-size: 68px; font-weight: 600; letter-spacing: -0.03em; color: #fff; margin-top: 4px; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25); }
  .ph__notifs { position: absolute; left: 10px; right: 10px; top: 168px; margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; }
  .ph__notif {
    display: grid; grid-template-columns: 36px 1fr; gap: 10px; align-items: start;
    padding: 10px 12px 11px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.18);
    animation: phIn 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ph__notif[hidden] { display: none; }
  @keyframes phIn { from { opacity: 0; transform: translateY(-10px) scale(0.97); } to { opacity: 1; transform: none; } }
  .ph__icon { width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; overflow: hidden; }
  .ph__icon--off { background: linear-gradient(160deg, #ff6b5e, #d93b2f); color: #fff; }
  .ph__icon--on { background: linear-gradient(160deg, #35e0b8, #1a3a5c); }
  .ph__icon img { width: 22px; height: 22px; }
  .ph__body { display: grid; gap: 2px; min-width: 0; }
  .ph__row { display: flex; justify-content: space-between; align-items: baseline; }
  .ph__row b { font-size: 12px; font-weight: 600; color: rgba(255, 255, 255, 0.92); }
  .ph__row em { font-style: normal; font-size: 11px; color: rgba(255, 255, 255, 0.55); }
  .ph__title { font-size: 13px; font-weight: 600; color: #fff; line-height: 1.25; }
  .ph--off .ph__title { color: #ffb3aa; }
  .ph--on .ph__title { color: #8ff2e1; }
  .ph__text { font-size: 12px; color: rgba(255, 255, 255, 0.78); line-height: 1.3; }
  .ph__home { position: absolute; left: 50%; bottom: 8px; width: 110px; height: 5px; border-radius: 3px; background: rgba(255, 255, 255, 0.85); transform: translateX(-50%); }

  /* ── Labels, handle ── */
  .ww__tag {
    position: absolute; top: 14px;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.85rem; border-radius: 100px;
    font-size: 0.8125rem; font-weight: 600;
    border: 1px solid rgba(247, 244, 239, 0.16); background: rgba(12, 14, 20, 0.5);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: rgba(247, 244, 239, 0.9); pointer-events: none;
  }
  .ww__tag i { width: 8px; height: 8px; border-radius: 50%; }
  .ww__tag--off { left: 14px; }
  .ww__tag--off i { background: #ff6b5e; box-shadow: 0 0 10px rgba(255, 107, 94, 0.8); }
  .ww__tag--on { right: 14px; }
  .ww__tag--on i { background: #30d158; box-shadow: 0 0 10px rgba(48, 209, 88, 0.8); }

  .ww__handle { position: absolute; top: 0; bottom: 0; left: var(--x); width: 0; outline: none; }
  .ww__line { position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: rgba(247, 244, 239, 0.9); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25), 0 0 18px rgba(247, 244, 239, 0.5); }
  .ww__grip {
    position: absolute; left: 50%; top: 50%; width: 52px; height: 52px;
    transform: translate(-50%, -50%);
    border-radius: 50%; display: grid; place-items: center;
    color: var(--deep-black);
    background: linear-gradient(160deg, #ffffff, #d9e4ea);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), inset 0 1px 0 #fff;
    transition: transform 0.2s;
  }
  .ww__stage.is-dragging .ww__grip, .ww__handle:focus-visible .ww__grip { transform: translate(-50%, -50%) scale(1.08); }
  .ww__handle:focus-visible .ww__line { background: var(--reef-aqua); }
  .ww__stage.is-nudging .ww__handle { transition: left 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .ww__stage.is-nudging .ww__layer--on { transition: clip-path 0.7s cubic-bezier(0.22, 1, 0.36, 1); }

  /* ── Timeline ── */
  .ww__timeline { display: flex; gap: 0.5rem; max-width: 1100px; margin: var(--space-md) auto 0; }
  .ww__time { flex: 1; background: none; border: 0; padding: 0.25rem 0 0; cursor: pointer; color: rgba(247, 244, 239, 0.5); font: inherit; text-align: left; }
  .ww__time b { display: block; font-family: var(--font-headline); font-weight: 600; font-size: 0.95rem; margin-top: 0.45rem; transition: color 0.3s; }
  .ww__time b small { font-size: 0.7em; margin-left: 1px; font-weight: 500; }
  .ww__time-bar { display: block; height: 3px; border-radius: 2px; background: rgba(247, 244, 239, 0.12); overflow: hidden; }
  .ww__time-bar span { display: block; height: 100%; width: 0; background: var(--reef-aqua); }
  .ww__time.is-past .ww__time-bar span { width: 100%; }
  .ww__time.is-on { color: var(--warm-white); }
  .ww__time.is-on .ww__time-bar span { width: 100%; transition: width var(--hold, 6s) linear; }
  .ww__time:hover b { color: var(--warm-white); }

  /* ── The one-liners ── */
  .ww__lines { max-width: 1100px; margin: var(--space-md) auto 0; }
  .ww__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .ww__pair[hidden] { display: none; }
  .ww__pair p { margin: 0; display: flex; gap: 0.6rem; align-items: flex-start; font-size: 1rem; line-height: 1.45; max-width: none; }
  .ww__pair i { flex-shrink: 0; width: 9px; height: 9px; border-radius: 50%; margin-top: 0.45rem; }
  .ww__line-off { color: rgba(247, 244, 239, 0.66); }
  .ww__line-off i { background: #ff6b5e; }
  .ww__line-on { color: var(--warm-white); font-weight: 500; }
  .ww__line-on i { background: #30d158; box-shadow: 0 0 10px rgba(48, 209, 88, 0.7); }
  .ww__ctas { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; margin-top: var(--space-lg); }

  /* ── Phones ── */
  @media (max-width: 760px) {
    .ww { padding-top: calc(74px + var(--space-lg)); }
    .ww__stage { aspect-ratio: 4 / 5; border-radius: 22px; }
    .ph { width: 166px; transform: translate(-50%, -46%); }
    .ph__frame { border-radius: 32px; }
    .ph__screen { inset: 6px; border-radius: 27px; }
    .ph__island { width: 58px; height: 18px; top: 8px; }
    .ph__lock { top: 32px; }
    .ph__clock { font-size: 44px; }
    .ph__date { font-size: 9.5px; }
    .ph__notifs { top: 106px; left: 6px; right: 6px; gap: 5px; }
    .ph__notif { padding: 7px 8px 8px; border-radius: 13px; grid-template-columns: 24px 1fr; gap: 7px; }
    .ph__icon { width: 24px; height: 24px; border-radius: 6px; }
    .ph__icon img { width: 15px; height: 15px; }
    .ph__icon svg { width: 13px; height: 13px; }
    .ph__row b { font-size: 9.5px; } .ph__row em { font-size: 8.5px; }
    .ph__title { font-size: 10.5px; } .ph__text { font-size: 9.5px; }
    .ph__home { width: 70px; height: 4px; bottom: 6px; }
    .ww__tag { top: 10px; font-size: 0.72rem; padding: 0.3rem 0.65rem; }
    .ww__tag--off { left: 10px; } .ww__tag--on { right: 10px; }
    .ww__grip { width: 44px; height: 44px; }
    .ww__time b { font-size: 0.8rem; }
    .ww__pair { grid-template-columns: 1fr; gap: 0.5rem; }
    .ww__pair p { font-size: 0.9375rem; }
    .ww__ctas .btn { width: 100%; text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ww__svg *) { animation: none !important; transition: none !important; }
    .ph__notif { animation: none; }
    .ww__time.is-on .ww__time-bar span { transition: none; }
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .ww__h1 { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ww__sub { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .ww__stage { background: #0f1a2b; border-color: rgba(12, 14, 20, 0.1); box-shadow: 0 30px 70px rgba(12, 14, 20, 0.18); }
  :global(html[data-theme="light"]) .ww__time { color: rgba(12, 14, 20, 0.5); }
  :global(html[data-theme="light"]) .ww__time.is-on, :global(html[data-theme="light"]) .ww__time:hover b { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ww__time-bar { background: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .ww__time-bar span { background: var(--deep-ocean); }
  :global(html[data-theme="light"]) .ww__line-off { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .ww__line-on { color: var(--deep-black); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ww]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const handle = root.querySelector<HTMLElement>('[data-handle]')!;
    const times = [...root.querySelectorAll<HTMLButtonElement>('[data-time]')];
    const pairs = [...root.querySelectorAll<HTMLElement>('[data-pair]')];
    const clocks = [...root.querySelectorAll<HTMLElement>('[data-clock]')];
    const notifSets = [...root.querySelectorAll<HTMLElement>('.ph__notifs')].map((ol) => [...ol.querySelectorAll<HTMLElement>('[data-notif]')]);
    const N = times.length;
    const HOLD = 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    stage.style.setProperty('--hold', `${HOLD}ms`);

    /* ── Slider ── */
    let x = 50, dragging = false;
    const setX = (v: number) => {
      x = Math.min(96, Math.max(4, v));
      stage.style.setProperty('--x', `${x}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(x)));
    };
    const fromEvent = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); return ((e.clientX - r.left) / r.width) * 100; };
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      dragging = true; stage.classList.add('is-dragging'); stage.classList.remove('is-nudging');
      stage.setPointerCapture(e.pointerId); setX(fromEvent(e)); pause();
    });
    stage.addEventListener('pointermove', (e) => { if (dragging) setX(fromEvent(e)); });
    const endDrag = () => { if (!dragging) return; dragging = false; stage.classList.remove('is-dragging'); resume(); };
    stage.addEventListener('pointerup', endDrag); stage.addEventListener('pointercancel', endDrag);
    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 3;
      if (e.key === 'ArrowLeft') { setX(x - step); e.preventDefault(); }
      if (e.key === 'ArrowRight') { setX(x + step); e.preventDefault(); }
      if (e.key === 'Home') { setX(4); e.preventDefault(); }
      if (e.key === 'End') { setX(96); e.preventDefault(); }
    });

    /* ── Timeline ── */
    let beat = 0, timer = 0, paused = false, started = false;
    const show = (b: number) => {
      beat = (b + N) % N;
      stage.setAttribute('data-beat', String(beat));
      times.forEach((t, i) => {
        t.classList.toggle('is-on', i === beat); t.classList.toggle('is-past', i < beat);
        t.setAttribute('aria-selected', i === beat ? 'true' : 'false');
        const bar = t.querySelector<HTMLElement>('.ww__time-bar span');
        if (bar && i === beat) { bar.style.transition = 'none'; bar.style.width = '0'; void bar.offsetWidth; bar.style.transition = ''; bar.style.width = ''; }
      });
      pairs.forEach((p, i) => { if (i === beat) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); });
      clocks.forEach((c) => (c.textContent = times[beat].querySelector('b')?.firstChild?.textContent || ''));
      // The phone shows the newest moment on top, with the two before it beneath.
      notifSets.forEach((set) => {
        const order: HTMLElement[] = [];
        set.forEach((n, i) => { if (i <= beat && i > beat - 3) order.push(n); else n.setAttribute('hidden', ''); });
        order.reverse().forEach((n, k) => { n.removeAttribute('hidden'); n.style.order = String(k); n.style.opacity = k === 0 ? '1' : k === 1 ? '0.85' : '0.65'; n.style.transform = k === 0 ? '' : `scale(${1 - k * 0.03})`; });
      });
    };
    const queue = () => { clearTimeout(timer); if (paused || reduced) return; timer = window.setTimeout(() => { show(beat + 1); queue(); }, HOLD); };
    const pause = () => { paused = true; clearTimeout(timer); };
    const resume = () => { paused = false; queue(); };
    times.forEach((t, i) => t.addEventListener('click', () => { show(i); queue(); }));
    stage.addEventListener('mouseenter', () => clearTimeout(timer));
    stage.addEventListener('mouseleave', () => { if (!dragging) queue(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : queue()));

    /* ── Start when seen; nudge the handle once so people know it moves ── */
    show(0);
    const start = () => {
      if (started) return; started = true;
      queue();
      if (reduced) return;
      stage.classList.add('is-nudging');
      setTimeout(() => setX(62), 600);
      setTimeout(() => setX(44), 1500);
      setTimeout(() => setX(50), 2400);
      setTimeout(() => stage.classList.remove('is-nudging'), 3200);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) start(); }), { threshold: 0.35 }).observe(stage);
    } else start();
  });
</script>
