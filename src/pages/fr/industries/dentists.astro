---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/fr.json';

const lang = 'fr';
const region = 'fr';
---

<BaseLayout t={tData} title="Automatisation marketing pour cabinets dentaires | DUSA . studio" description="Automatisez les rappels de controle, generez plus d'avis et relancez les plans de traitement. DUSA offre aux cabinets dentaires un systeme complet de croissance patient.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://dusa.studio/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/fr/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Cabinets dentaires", "item": "https://dusa.studio/fr/industries/dentists/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Cabinets dentaires</span>
        <h1>Gardez chaque fauteuil occupe et<br/><span class="gradient-text">chaque rappel a jour</span></h1>
        <p class="industry-hero__sub">DUSA automatise les rappels de controle, l'accueil des nouveaux patients, le suivi des traitements et la generation d'avis pour que votre equipe puisse se concentrer sur les soins.</p>
        <div class="industry-hero__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Reserver une demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">Le probleme</span>
      <h2>Ca vous parle ?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">🦷</div>
          <h3>Des patients en retard pour leurs controles</h3>
          <p>Les visites semestrielles glissent a douze mois, puis dix-huit. Sans relances automatiques, les patients disparaissent et le chiffre d'affaires baisse.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📉</div>
          <h3>Acquisition de nouveaux patients insuffisante</h3>
          <p>Vous comptez sur le bouche-a-oreille sans systeme pour l'amplifier. Les demandes arrivent lentement et les concurrents mieux positionnes en ligne l'emportent.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">⭐</div>
          <h3>Peu d'avis en ligne</h3>
          <p>Les patients satisfaits repartent sans laisser d'avis. Pendant ce temps, le seul patient mecontent domine votre fiche Google.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📋</div>
          <h3>Plans de traitement sans suivi</h3>
          <p>Vous presentez un plan de traitement et le patient dit qu'il va y reflechir. Sans relance, ce plan prend la poussiere.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">La solution</span>
      <h2>Comment DUSA fonctionne pour les <span class="gradient-text">cabinets dentaires</span></h2>
      <p class="solution__intro">Une seule plateforme remplace votre systeme de rappels, vos outils d'avis, votre communication patient et vos tableurs marketing.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Automatisation des rappels de controle</h3>
          <p>Des sequences automatiques par SMS et e-mail ramenent les patients pour leurs visites semestrielles sans que votre equipe ait a les relancer.</p>
        </div>
        <div class="solution-card">
          <h3>Parcours d'accueil nouveau patient</h3>
          <p>De la premiere demande au premier rendez-vous, les nouveaux patients beneficient d'un accueil fluide qui inspire confiance.</p>
        </div>
        <div class="solution-card">
          <h3>Generation d'avis</h3>
          <p>Apres chaque visite, les patients satisfaits recoivent une invitation simple a laisser un avis Google. Votre note progresse en pilote automatique.</p>
        </div>
        <div class="solution-card">
          <h3>Suivi des plans de traitement</h3>
          <p>Les patients qui ont dit "laissez-moi y reflechir" recoivent des relances douces et programmees jusqu'a ce qu'ils prennent rendez-vous ou declinent.</p>
        </div>
        <div class="solution-card">
          <h3>Rappels de mutuelle</h3>
          <p>Rappelez aux patients que leurs avantages mutuels vont bientot expirer pour qu'ils en profitent avant de les perdre.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Votre pipeline</span>
      <h2>Chaque patient, chaque etape, <span class="gradient-text">rien n'est oublie</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Nouveau patient</h3>
          <p>Une demande arrive via votre site, Google ou une recommandation.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Premiere visite</h3>
          <p>Premier rendez-vous effectue. Parcours d'accueil et demande d'avis envoyes.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Plan de traitement</h3>
          <p>Traitement recommande presente. Le suivi automatique commence si le rendez-vous n'est pas pris immediatement.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Soins en cours</h3>
          <p>Visites regulieres suivies. Rappels de mutuelle et d'avantages envoyes au bon moment.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Controle a prevoir</h3>
          <p>Rappel semestriel declenche. Le patient recoit une sequence jusqu'a ce qu'il prenne son prochain rendez-vous.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Parrainages et Avis</h3>
          <p>Les patients satisfaits laissent des avis et parrainent leur famille. DUSA envoie des demandes d avis apres chaque visite et suit les sources de parrainage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultats</span>
      <h2>Concu pour les cabinets qui veulent <span class="gradient-text">grandir</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">35%</div>
          <p>d'augmentation du respect des controles grace aux rappels automatiques</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">4x</div>
          <p>plus d'avis Google dans les 90 premiers jours</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">25%</div>
          <p>des plans de traitement en attente convertis grace aux sequences de suivi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Pret a remplir chaque fauteuil ?</h2>
        <p>Lancez votre cabinet sur DUSA en moins d'une semaine.</p>
        <div class="final-cta__actions">
          <a href="/fr/start" class="btn btn--primary">Commencer</a>
          <a href="/blog/dental-practice-marketing" class="btn btn--outline">Lire le guide</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>