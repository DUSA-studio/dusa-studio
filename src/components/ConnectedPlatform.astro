  }
  /* Selected segments light up in their own colour rather than just brightening. */
  .cp__stage.is-dim .cp__seg.is-on {
    filter: brightness(1.22) drop-shadow(0 0 7px var(--glow, #4ED8C2));
  }
  .cp__stage.is-dim .cp__cap.is-ai.is-on {
    filter: brightness(1.3) drop-shadow(0 0 11px #4ED8C2);
  }
  .cp__seg { transition: opacity 0.22s var(--ease-out); }
  .cp--anim .cp__seg { opacity: 0; transform: scale(0.965); transform-origin: 380px 380px; }
  .cp--anim.is-in .cp__seg {
    opacity: 1; transform: scale(1);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 22ms);
  }
  .cp__stage.is-dim .cp__seg:not(.is-on) { opacity: 0.1; }

  /* ─── Hub readout ─── */
  .cp__readout {
    position: absolute; z-index: 2; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 24%; height: 14cqw; text-align: center; pointer-events: none;
  }
  /* Both panes occupy the same grid cell, so swapping them cannot reflow the
     hub. Only opacity changes, which is why hovering across segments no longer
