---
// SetupSteps.astro — "Up and running in three steps".
// v3 (Nov 2026): three keycaps on a rail. Each step is a frosted key (the
// same recipe as the site's buttons, borrowed from the HELM keys) with a
// number and a one-word label, a title and one sentence. Key 1 is lit
// because that is where you start. Dashes flow along the rail from one key
// to the next. No cards, no mock screens, no script.
interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;
const s = t?.howItWorks || {};
const label = s.label || 'How It Works';
const heading = s.heading || 'Up and running';
const headingAccent = s.headingAccent || 'in three steps.';
const cta = s.bookFreeDemo || 'Book Your Free Demo';
const ctaAlt = s.orTrial || 'or start a 14-day free trial';
const note = s.setupNote || 'Most businesses are live inside their first week.';
const BOOK_URL = 'https://link.dusa.studio/widget/bookings/dusa-demo';

const steps = [
  {
    n: '1',
    key: s.setup1Key || 'book',
    title: s.setup1Title || 'Book a 30-minute call',
    desc: s.setup1Desc || 'We look at how your business runs today and show you exactly what DUSA will do for it.',
    you: s.setup1You || 'You: 30 minutes',
  },
  {
    n: '2',
    key: s.setup2Key || 'connect',
    title: s.setup2Title || 'Connect your accounts',
    desc: s.setup2Desc || 'Google, Meta, your calendar and payments, one click each. We help you bring your contacts across and switch on your first automations.',
    you: s.setup2You || 'You: a few clicks',
  },
  {
    n: '3',
    key: s.setup3Key || 'go',
    title: s.setup3Title || 'Log in and go',
    desc: s.setup3Desc || 'Open DUSA on your phone or laptop. Leads, bookings and reviews land in one place, with AI handling the follow-up.',
    you: s.setup3You || 'You: one login',
  },
];
---

<section class="ss section section--dark" id="how-it-works">
  <div class="container">
    <div class="ss__header reveal">
      <span class="label" data-icon="flag">{label}</span>
      <h2>{heading}<br/><span class="gradient-text">{headingAccent}</span></h2>
    </div>

    <ol class="ss__grid reveal">
      {steps.map((st, i) => (
        <li class="ss__stage">
          {i === 0 ? (
            <a class="ss__key ss__key--lit" href={BOOK_URL} target="_blank" rel="noopener noreferrer" aria-label={st.title}>
              <b>{st.n}</b><i>{st.key}</i>
            </a>
          ) : (
            <span class="ss__key" aria-hidden="true"><b>{st.n}</b><i>{st.key}</i></span>
          )}
          <div class="ss__text">
            <h3 class="ss__title">{st.title}</h3>
            <p class="ss__desc">{st.desc}</p>
            <span class="ss__you">{st.you}</span>
          </div>
        </li>
      ))}
    </ol>

    <div class="ss__cta reveal">
      <p class="ss__note">{note}</p>
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn--primary">{cta}</a>
      <a href="/start" data-page="start" class="ss__cta-alt">{ctaAlt} &rarr;</a>
    </div>
  </div>
</section>

<style>
  .ss__header { text-align: center; max-width: 720px; margin: 0 auto clamp(2.5rem, 5vw, 4rem); }
  .ss__header h2 { margin-top: var(--space-xs); }

  .ss__grid {
    --ss-gap: clamp(1.5rem, 4vw, 3.5rem);
    --ss-key: 88px;
    list-style: none; margin: 0 auto; padding: 0; max-width: 1080px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ss-gap);
  }
  .ss__stage { position: relative; display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }

  /* ── the keycap: frosted top on a skirt, like every button on the site ── */
  .ss__key {
    position: relative; z-index: 1; flex: none; display: grid; place-items: center;
    width: var(--ss-key); height: var(--ss-key); border-radius: calc(var(--ss-key) * 0.26);
    color: var(--gl-ink); text-decoration: none;
    background:
      radial-gradient(120% 90% at 0% 0%, var(--gl-sheen), transparent 60%),
      linear-gradient(160deg, rgba(var(--gl-tint), var(--gl-key-top)), rgba(var(--gl-tint), var(--gl-key-bot)) 78%);
    border: 1px solid var(--gl-edge);
    box-shadow:
      inset 0 1px 0 var(--gl-edge-hi),
      inset 0 -1px 0 var(--gl-skirt-hi),
      0 6px 0 -0.5px var(--gl-skirt),
      0 22px 26px -16px var(--gl-key-shadow);
    transition: transform 0.18s cubic-bezier(0.2, 0.75, 0.2, 1), box-shadow 0.18s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .ss__key b {
    font-family: var(--font-headline); font-weight: 700; font-size: calc(var(--ss-key) * 0.42); line-height: 1;
    letter-spacing: -0.03em; transform: translateY(-8%);
  }
  .ss__key i {
    position: absolute; left: 14%; bottom: 12%; font-style: normal; font-family: var(--font-mono);
    font-size: 11px; line-height: 1; letter-spacing: 0.02em; opacity: 0.72;
  }
  .ss__key--lit {
    color: var(--deep-black);
    background: linear-gradient(135deg, var(--reef-aqua), var(--mist-blue));
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.62),
      inset 0 -2px 0 rgba(6, 68, 60, 0.2),
      0 6px 0 -0.5px var(--gl-primary-skirt),
      0 22px 26px -16px rgba(var(--gl-lit), 0.45);
  }
  @media (hover: hover) {
    a.ss__key:hover {
      transform: translateY(2px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.7),
        inset 0 -2px 0 rgba(6, 68, 60, 0.2),
        0 4px 0 -0.5px var(--gl-primary-skirt),
        0 18px 24px -16px rgba(var(--gl-lit), 0.5);
    }
  }
  a.ss__key:active {
    transform: translateY(6px);
    box-shadow: inset 0 2px 6px rgba(6, 68, 60, 0.35), 0 0 0 0 var(--gl-primary-skirt), 0 6px 12px -10px rgba(var(--gl-lit), 0.6);
  }
  a.ss__key:focus-visible { outline: 2px solid var(--reef-aqua); outline-offset: 4px; }

  /* ── the rail: dashes that flow from one key to the next ── */
  .ss__stage:not(:last-child)::after {
    content: ''; position: absolute; pointer-events: none;
    top: calc(var(--ss-key) / 2 - 1px); left: calc(var(--ss-key) + 16px); right: calc(var(--ss-gap) * -1 + 16px); height: 2px;
    color: rgba(247, 244, 239, 0.34);
    background: repeating-linear-gradient(90deg, currentColor 0 7px, transparent 7px 16px);
    background-size: 16px 2px; animation: ssFlowX 1.1s linear infinite;
  }
  @keyframes ssFlowX { to { background-position: 16px 0; } }
  @keyframes ssFlowY { to { background-position: 0 16px; } }

  .ss__text { margin-top: 1.75rem; }
  .ss__title { font-size: clamp(1.25rem, 1.7vw, 1.5rem); line-height: 1.2; margin: 0 0 0.6rem; color: var(--warm-white); }
  .ss__desc { font-size: 1.0625rem; line-height: 1.6; color: rgba(247, 244, 239, 0.74); margin: 0 0 1rem; max-width: 34ch; }
  .ss__you {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--reef-aqua);
  }
  .ss__you::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .ss__cta { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .ss__note { margin: 0 0 0.5rem; font-size: 1.0625rem; color: rgba(247, 244, 239, 0.8); text-align: center; max-width: none; }
  .ss__cta-alt { font-size: 0.9375rem; color: rgba(247, 244, 239, 0.62); text-decoration: none; transition: color var(--duration-fast); }
  .ss__cta-alt:hover { color: var(--reef-aqua); }

  /* ── tablets and phones: the rail turns and runs down the left ── */
  @media (max-width: 820px) {
    .ss__grid { --ss-key: 64px; --ss-gap: 2rem; grid-template-columns: minmax(0, 1fr); max-width: 480px; }
    .ss__stage { flex-direction: row; align-items: flex-start; gap: 1.1rem; }
    .ss__text { margin-top: 0.15rem; min-width: 0; }
    .ss__key i { display: none; }
    .ss__key b { transform: none; }
    .ss__desc { max-width: none; font-size: 1rem; margin-bottom: 0.75rem; }
    .ss__stage:not(:last-child)::after {
      top: calc(var(--ss-key) + 14px); bottom: calc(var(--ss-gap) * -1 + 8px); left: calc(var(--ss-key) / 2 - 1px); right: auto;
      width: 2px; height: auto;
      background: repeating-linear-gradient(180deg, currentColor 0 7px, transparent 7px 16px);
      background-size: 2px 16px; animation-name: ssFlowY;
    }
  }

  /* ── Light mode ─────────────────────────────────────────────────────── */
  :global(html[data-theme="light"]) .ss__title { color: var(--deep-black); }
  :global(html[data-theme="light"]) .ss__desc { color: rgba(12, 14, 20, 0.72); }
  :global(html[data-theme="light"]) .ss__you { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .ss__note { color: rgba(12, 14, 20, 0.78); }
  :global(html[data-theme="light"]) .ss__cta-alt { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .ss__cta-alt:hover { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .ss__stage:not(:last-child)::after { color: rgba(26, 58, 92, 0.34); }

  @media (prefers-reduced-motion: reduce) {
    .ss__stage::after { animation: none !important; }
    .ss__key { transition: none; }
  }
</style>
