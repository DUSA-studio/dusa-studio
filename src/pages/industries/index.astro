    icon: 'M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z',
  },
  {
    title: 'Property Managers',
    desc: 'Tenant lifecycle automation, maintenance request pipelines, rent reminders, and lease renewal campaigns.',
