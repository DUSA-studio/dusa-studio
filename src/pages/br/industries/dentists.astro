---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/pt.json';

const lang = 'pt';
const region = 'br';
---

<BaseLayout t={tData} title="Automacao de Marketing para Clinicas Odontologicas | DUSA.studio" description="Automatize lembretes de retorno, gere mais avaliacoes e acompanhe planos de tratamento. O DUSA oferece um sistema completo de crescimento para clinicas odontologicas.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dusa.studio/br/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://dusa.studio/br/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Clinicas Odontologicas", "item": "https://dusa.studio/br/industries/dentists/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Clinicas Odontologicas</span>
        <h1>Mantenha todas as cadeiras ocupadas e<br/><span class="gradient-text">cada retorno em dia</span></h1>
        <p class="industry-hero__sub">O DUSA automatiza lembretes de retorno, onboarding de novos pacientes, acompanhamento de tratamentos e geracao de avaliacoes para que sua equipe possa focar no atendimento.</p>
        <div class="industry-hero__actions">
          <a href="/br/start" class="btn btn--primary">Comece agora</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Agende uma demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">O Problema</span>
      <h2>Parece familiar?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">🦷</div>
          <h3>Pacientes atrasados para retorno</h3>
          <p>Retornos de seis meses viram doze, depois dezoito. Sem lembretes automaticos, os pacientes somem e a receita cai.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📉</div>
          <h3>Baixa aquisicao de novos pacientes</h3>
          <p>Voce depende do boca a boca, mas nao tem um sistema para amplifica-lo. As consultas chegam devagar e concorrentes com melhor presenca online vencem.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">⭐</div>
          <h3>Poucas avaliacoes online</h3>
          <p>Pacientes satisfeitos vao embora sem avaliar. Enquanto isso, aquele unico paciente insatisfeito domina sua ficha no Google.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📋</div>
          <h3>Planos de tratamento sem acompanhamento</h3>
          <p>Voce apresenta um plano de tratamento e o paciente diz que vai pensar. Sem acompanhamento, aquele plano fica esquecido.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">A Solucao</span>
      <h2>Como o DUSA funciona para <span class="gradient-text">clinicas odontologicas</span></h2>
      <p class="solution__intro">Uma plataforma substitui seu sistema de retorno, ferramentas de avaliacao, comunicacao com pacientes e planilhas de marketing.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Automacao de lembretes de retorno</h3>
          <p>Sequencias automaticas de SMS e e-mail trazem os pacientes de volta para seus retornos semestrais sem sua equipe precisar correr atras.</p>
        </div>
        <div class="solution-card">
          <h3>Sequencia de boas-vindas para novos pacientes</h3>
          <p>Da primeira consulta ate a primeira sessao, novos pacientes recebem uma experiencia de onboarding fluida que constroi confianca.</p>
        </div>
        <div class="solution-card">
          <h3>Geracao de avaliacoes</h3>
          <p>Apos cada visita, pacientes satisfeitos recebem um convite simples para deixar uma avaliacao no Google. Sua nota sobe no piloto automatico.</p>
        </div>
        <div class="solution-card">
          <h3>Acompanhamento de planos de tratamento</h3>
          <p>Pacientes que disseram "vou pensar" recebem acompanhamentos gentis e programados ate agendarem ou declinarem.</p>
        </div>
        <div class="solution-card">
          <h3>Lembretes de plano de saude</h3>
          <p>Lembre os pacientes quando os beneficios do convenio estao prestes a expirar para que eles utilizem antes de perder.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Seu Pipeline</span>
      <h2>Cada paciente, cada etapa, <span class="gradient-text">sem perder nada</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Novo Paciente</h3>
          <p>Consulta chega pelo seu site, Google ou indicacao.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Primeira Consulta</h3>
          <p>Primeira sessao realizada. Sequencia de boas-vindas e solicitacao de avaliacao enviadas.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Plano de Tratamento</h3>
          <p>Tratamento recomendado apresentado. Acompanhamento automatico comeca se nao for agendado imediatamente.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Acompanhamento Continuo</h3>
          <p>Visitas regulares rastreadas. Lembretes de convenio e beneficios enviados no momento certo.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Retorno Pendente</h3>
          <p>Retorno semestral acionado. Paciente recebe uma sequencia ate agendar o proximo check-up.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Indicacoes e Avaliacoes</h3>
          <p>Pacientes satisfeitos deixam avaliacoes e indicam familiares. O DUSA envia solicitacoes de avaliacao pos-consulta e rastreia fontes de indicacao.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultados</span>
      <h2>Feito para clinicas que querem <span class="gradient-text">crescer</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">35%</div>
          <p>de aumento na adesao a retornos com lembretes automaticos</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">4x</div>
          <p>mais avaliacoes no Google nos primeiros 90 dias</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">25%</div>
          <p>dos planos de tratamento pendentes convertidos com sequencias de acompanhamento</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Pronto para lotar todas as cadeiras?</h2>
        <p>Tenha sua clinica rodando no DUSA em menos de uma semana.</p>
        <div class="final-cta__actions">
          <a href="/br/start" class="btn btn--primary">Comece agora</a>
          <a href="/blog/dental-practice-marketing" class="btn btn--outline">Leia o guia</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
