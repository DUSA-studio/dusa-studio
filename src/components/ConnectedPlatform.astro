---
// ConnectedPlatform.astro — capability wheel + integrations marquee.
//
// Layout: single centred column. An earlier two-column version put the wheel
// beside a tall grid of 26 near-identical chips, which unbalanced the section
// and made the grid the weakest thing on screen. The wheel now gets the full
// width as the hero object, and the integrations run underneath as a moving
// band, which reads as evidence rather than a list.
//
// Colour logic: the six domains sit in a TIGHT Mist Blue band, not a wide
// light-to-dark ramp — a wide ramp forced the label colour to flip between
// domains and looked half-lit. That keeps Reef Aqua free to mean exactly one
// thing: AI.
import { BRAND_MARKS, WORDMARK_ONLY } from '../config/brand-marks';
import { DOMAINS } from '../config/capabilities';

interface Props { t?: Record<string, any>; }
const { t = {} } = Astro.props;
const c = t?.connected || {};

const eyebrow = c.eyebrow || 'One Platform';
const heading = c.heading || 'Everything';
const headingAccent = c.headingAccent || 'connected';
const sub = c.sub || 'The systems that run your business, and the apps they plug into.';
const gridHeading = c.gridHeading || 'Connects with';
const note = c.note || 'Plus 1,000+ more through Zapier and Make.';
const ctaLabel = c.cta || 'See everything included';
const aiBandLabel = c.aiBand || 'AI · ACROSS EVERYTHING';
const hubHint = c.hubHint || 'Hover the ring';

const AQUA = '#4ED8C2';

/* ─── Geometry, resolved at build time so the SVG ships static ─── */
const VB = 760, CX = 380, CY = 380;
const R_HUB = 84, R_AI0 = 90, R_AI1 = 118, R_D0 = 124, R_D1 = 198, R_C0 = 202, R_C1 = 332;
const GAP = 0.010;

const pol = (r: number, a: number) => [CX + r * Math.cos(a), CY + r * Math.sin(a)];
function arc(r0: number, r1: number, a0: number, a1: number) {
  const [x0, y0] = pol(r1, a0), [x1, y1] = pol(r1, a1);
  const [x2, y2] = pol(r0, a1), [x3, y3] = pol(r0, a0);
  const laf = a1 - a0 > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r1},${r1} 0 ${laf} 1 ${x1.toFixed(2)},${y1.toFixed(2)}` +
         `L${x2.toFixed(2)},${y2.toFixed(2)}A${r0},${r0} 0 ${laf} 0 ${x3.toFixed(2)},${y3.toFixed(2)}Z`;
}
function arcPath(r: number, a0: number, a1: number, flip: boolean) {
  const [s0, s1] = flip ? [a1, a0] : [a0, a1];
  const [x0, y0] = pol(r, s0), [x1, y1] = pol(r, s1);
  const laf = Math.abs(a1 - a0) > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r},${r} 0 ${laf} ${flip ? 0 : 1} ${x1.toFixed(2)},${y1.toFixed(2)}`;
}
const rgba = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
};

const totalCaps = DOMAINS.reduce((s, d) => s + d.items.length, 0);
const aiCount = DOMAINS.reduce((s, d) => s + d.items.filter((i) => i.ai).length, 0);
const allApps = [...BRAND_MARKS.map((b) => ({ name: b.name, hex: b.hex, path: b.path })),
                 ...WORDMARK_ONLY.map((n) => ({ name: n, hex: '', path: '' }))];
const appCount = allApps.length;
/* Two marquee rows travelling in opposite directions. */
const rowA = allApps.filter((_, i) => i % 2 === 0);
const rowB = allApps.filter((_, i) => i % 2 === 1);

let cursor = -Math.PI / 2;
const domainSegs: any[] = [];
const capSegs: any[] = [];
let capIndex = 0;

DOMAINS.forEach((d, di) => {
  const span = (d.items.length / totalCaps) * Math.PI * 2;
  const a0 = cursor, a1 = cursor + span;
  const mid = (a0 + a1) / 2;
  const m = ((mid % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
  const flip = m > 0 && m < Math.PI;
  const rLabel = (R_D0 + R_D1) / 2 + (flip ? 5 : -5);
  domainSegs.push({
    di, d: arc(R_D0, R_D1, a0 + GAP, a1 - GAP),
    label: d.name, color: d.color,
    textPath: arcPath(rLabel, a0 + GAP, a1 - GAP, flip),
  });

  const iSpan = span / d.items.length;
  d.items.forEach((it, ii) => {
    const b0 = a0 + ii * iSpan, b1 = b0 + iSpan;
    const m2 = (b0 + b1) / 2;
    const [ix, iy] = pol((R_C0 + R_C1) / 2, m2);
    const dg = (m2 * 180) / Math.PI;
    capSegs.push({
      di, i: capIndex++, d: arc(R_C0, R_C1, b0 + GAP, b1 - GAP),
      fill: it.ai ? rgba(AQUA, 0.3) : rgba(d.color, 0.34),
      stroke: it.ai ? rgba(AQUA, 0.95) : rgba(d.color, 0.62),
      label: it.l, plain: it.l.replace('\n', ' '), desc: it.d,
      domain: d.name, lx: ix, ly: iy, ai: !!it.ai,
      rot: dg > 90 && dg < 270 ? dg + 180 : dg,
    });
  });
  cursor = a1;
});

const aiRing = arc(R_AI0, R_AI1, -Math.PI / 2 + 0.012, -Math.PI / 2 + Math.PI * 2 - 0.012);
const aiMidR = (R_AI0 + R_AI1) / 2 + 2;
const aiTextPath = `M ${CX - aiMidR},${CY} A ${aiMidR},${aiMidR} 0 0 1 ${CX + aiMidR},${CY}`;

const STATS = [
  { n: '6', l: 'core domains' },
  { n: String(totalCaps), l: 'capabilities' },
  { n: String(aiCount), l: 'AI powered' },
  { n: `${appCount}+`, l: 'integrations' },
];
---

<section class="cp section section--dark" id="connected-platform">
  <div class="container">
    <div class="cp__head reveal">
      <span class="label">{eyebrow}</span>
      <h2>{heading} <span class="gradient-text">{headingAccent}</span></h2>
      <p class="cp__sub">{sub}</p>
      <dl class="cp__stats">
        {STATS.map((s) => (
          <div class="cp__stat"><dt>{s.n}</dt><dd>{s.l}</dd></div>
        ))}
      </dl>
    </div>

    <div class="cp__stage reveal">
      <span class="cp__aura" aria-hidden="true"></span>

      <svg class="cp__wheel" viewBox={`0 0 ${VB} ${VB}`} role="img" aria-labelledby="cp-title">
        <title id="cp-title">What DUSA does: six capability domains with AI running through them</title>

        <defs>
          <radialGradient id="cpAura" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color={AQUA} stop-opacity="0.18" />
            <stop offset="52%" stop-color="#1A3A5C" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#0C0E14" stop-opacity="0" />
          </radialGradient>
          <filter id="cpSoftGlow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="2.6" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          {DOMAINS.map((d, i) => (
            <linearGradient id={`cpD${i}`} x1="0%" y1="0%" x2="20%" y2="100%">
              <stop offset="0%" stop-color={d.color} stop-opacity="1" />
              <stop offset="100%" stop-color={d.color} stop-opacity="0.66" />
            </linearGradient>
          ))}
        </defs>

        <circle cx={CX} cy={CY} r={R_C1 + 26} fill="url(#cpAura)" />

        <g class="cp__ticks" aria-hidden="true">
          {capSegs.map((_, i) => {
            const a = -Math.PI / 2 + (i / capSegs.length) * Math.PI * 2;
            const [x1, y1] = pol(R_C1 + 9, a);
            const [x2, y2] = pol(R_C1 + 15, a);
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={rgba(AQUA, 0.3)} stroke-width="1" />;
          })}
        </g>
        <circle cx={CX} cy={CY} r={R_C1 + 19} fill="none" stroke="rgba(247,244,239,0.08)" stroke-width="1" />

        {capSegs.map((s) => (
          <path class={`cp__seg cp__cap cp__seg--d${s.di} ${s.ai ? 'is-ai' : ''}`}
                style={`--i:${s.i}`} d={s.d} fill={s.fill} stroke={s.stroke} stroke-width="1"
                data-name={s.plain} data-desc={s.desc} data-domain-name={s.domain} data-ai={s.ai ? '1' : '0'} />
        ))}

        {domainSegs.map((s) => (
          <path class={`cp__seg cp__dom cp__seg--d${s.di}`} style={`--i:${s.di}`}
                d={s.d} fill={`url(#cpD${s.di})`} stroke="rgba(12,14,20,0.4)" stroke-width="1" />
        ))}

        <g class="cp__ai">
          <path d={aiRing} fill={rgba(AQUA, 0.17)} stroke={rgba(AQUA, 0.8)}
                stroke-width="1.25" filter="url(#cpSoftGlow)" />
          <circle class="cp__ai-dash" cx={CX} cy={CY} r={R_AI1 - 1} fill="none"
                  stroke={rgba(AQUA, 0.45)} stroke-width="1" stroke-dasharray="2 10" stroke-linecap="round" />
          <path id="cpAiPath" d={aiTextPath} fill="none" />
          <text class="cp__ai-label" filter="url(#cpSoftGlow)">
            <textPath href="#cpAiPath" startOffset="50%" text-anchor="middle">{aiBandLabel}</textPath>
          </text>
        </g>

        {capSegs.map((s) => (
          <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.i}`} aria-hidden="true">
            <text class={`cp__cap-text ${s.ai ? 'is-ai-text' : ''}`} x={s.lx} y={s.ly}
                  text-anchor="middle" dominant-baseline="middle"
                  transform={`rotate(${s.rot} ${s.lx} ${s.ly})`}>
              {s.label.split('\n').map((line: string, i: number, arr: string[]) => (
                <tspan x={s.lx} dy={i === 0 ? -((arr.length - 1) * 6) : 12}>{line}</tspan>
              ))}
            </text>
          </g>
        ))}
        {domainSegs.map((s) => (
          <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.di}`} aria-hidden="true">
            <path id={`cpDomPath${s.di}`} d={s.textPath} fill="none" />
            <text class="cp__dom-text">
              <textPath href={`#cpDomPath${s.di}`} startOffset="50%" text-anchor="middle">{s.label}</textPath>
            </text>
          </g>
        ))}

        <circle cx={CX} cy={CY} r={R_HUB} fill="#0C0E14" stroke={rgba(AQUA, 0.45)} stroke-width="1" />
        <circle cx={CX} cy={CY} r={R_HUB - 8} fill="none" stroke="rgba(247,244,239,0.08)" stroke-width="1" />
      </svg>

      <!-- Hub readout: HTML rather than SVG text so descriptions can wrap. -->
      <div class="cp__readout" aria-live="polite">
        <div class="cp__readout-default">
          <span class="cp__readout-brand">DUSA</span>
          <span class="cp__readout-sub">ONE LOGIN</span>
          <span class="cp__readout-hint">{hubHint}</span>
        </div>
        <div class="cp__readout-detail" hidden>
          <span class="cp__readout-domain"></span>
          <span class="cp__readout-name"></span>
          <span class="cp__readout-desc"></span>
        </div>
      </div>
    </div>

    <div class="cp__legend reveal">
      {DOMAINS.map((d, i) => (
        <button class="cp__lg" data-domain={i} type="button" style={`--lg:${d.color}`}>
          <i></i>{d.name}<b>{d.items.length}</b>
        </button>
      ))}
      <span class="cp__lg cp__lg--ai"><i></i>AI powered<b>{aiCount}</b></span>
    </div>

    <!-- The full model as text: readable by screen readers and crawlers. -->
    <div class="cp__sr">
      {DOMAINS.map((d) => (
        <div>
          <h3>{d.name}</h3>
          <ul>
            {d.items.map((it) => (
              <li>{it.l.replace('\n', ' ')}: {it.d}{it.ai ? ' (AI powered)' : ''}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="cp__apps reveal">
      <div class="cp__apps-head">
        <span class="cp__apps-line" aria-hidden="true"></span>
        <span class="cp__apps-title">{gridHeading} <b>{appCount}+</b></span>
        <span class="cp__apps-line" aria-hidden="true"></span>
      </div>

      <div class="cp__marquee">
        {[rowA, rowB].map((row, ri) => (
          <div class={`cp__row cp__row--${ri}`}>
            <div class="cp__track">
              {[...row, ...row].map((a) => (
                <span class={`cp__chip ${a.path ? '' : 'cp__chip--word'}`} style={`--brand:${a.hex || '#4ED8C2'}`}>
                  {a.path && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={a.path} /></svg>}
                  <span>{a.name}</span>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="cp__note">{note}</p>
      <a href="/services" class="cp__cta">{ctaLabel} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  .cp__head { text-align: center; max-width: 680px; margin: 0 auto var(--space-lg); }
  .cp__head h2 { font-weight: 600; margin-top: var(--space-xs); }
  .cp__sub { color: rgba(247, 244, 239, 0.55); margin: var(--space-sm) auto 0; font-size: 1.0625rem; max-width: 52ch; }

  .cp__stats { display: flex; justify-content: center; flex-wrap: wrap; gap: 0 var(--space-lg); margin: var(--space-lg) 0 0; }
  .cp__stat { text-align: center; position: relative; padding: 0 var(--space-sm); }
  .cp__stat + .cp__stat::before {
    content: ''; position: absolute; left: 0; top: 18%; height: 64%; width: 1px;
    background: rgba(247, 244, 239, 0.12);
  }
  .cp__stat dt { font-family: var(--font-headline); font-size: 1.75rem; font-weight: 700; color: var(--warm-white); line-height: 1.1; }
  .cp__stat dd {
    margin: 2px 0 0; font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: rgba(247, 244, 239, 0.42);
  }

  /* ─── Wheel ─── */
  .cp__stage { position: relative; max-width: 780px; margin: 0 auto; }
  .cp__aura {
    position: absolute; inset: -12%;
    background: radial-gradient(circle at 50% 50%,
      rgba(78, 216, 194, 0.14) 0%, rgba(26, 58, 92, 0.18) 40%, rgba(12, 14, 20, 0) 70%);
    filter: blur(22px); pointer-events: none; z-index: 0;
  }
  .cp__wheel { position: relative; z-index: 1; width: 100%; height: auto; display: block; }

  .cp__dom-text { font-family: var(--font-headline); font-size: 13px; font-weight: 700; fill: #0C0E14; letter-spacing: 0.01em; }
  .cp__cap-text { font-family: var(--font-body); font-size: 11px; font-weight: 500; fill: rgba(247, 244, 239, 0.94); }
  .cp__cap-text.is-ai-text { fill: #A6F5E7; }
  .cp__ai-label { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 1.6px; fill: #8FF2E1; }
  .cp__ai-dash { transform-origin: center; animation: cpSpin 50s linear infinite; }
  @keyframes cpSpin { to { transform: rotate(360deg); } }

  .cp__cap { cursor: pointer; }
  .cp__seg { transition: opacity var(--duration-normal) var(--ease-out), filter var(--duration-normal) var(--ease-out); }
  .cp--anim .cp__seg { opacity: 0; transform: scale(0.965); transform-origin: 380px 380px; }
  .cp--anim.is-in .cp__seg {
    opacity: 1; transform: scale(1);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 22ms);
  }
  .cp__stage.is-dim .cp__seg:not(.is-on) { opacity: 0.1; }
  .cp__stage.is-dim .cp__seg.is-on { filter: brightness(1.18); }

  /* ─── Hub readout ─── */
  .cp__readout {
    position: absolute; z-index: 2; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 19%; text-align: center; pointer-events: none;
  }
  .cp__readout > div { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .cp__readout > div[hidden] { display: none; }
  .cp__readout-brand { font-family: var(--font-headline); font-size: clamp(1.1rem, 2.6vw, 1.75rem); font-weight: 700; color: var(--warm-white); letter-spacing: 0.02em; line-height: 1; }
  .cp__readout-sub { font-family: var(--font-mono); font-size: clamp(0.42rem, 0.85vw, 0.55rem); letter-spacing: 0.22em; color: rgba(78, 216, 194, 0.95); }
  .cp__readout-hint { font-size: clamp(0.42rem, 0.8vw, 0.55rem); color: rgba(247, 244, 239, 0.3); margin-top: 0.35rem; }
  .cp__readout-domain { font-family: var(--font-mono); font-size: clamp(0.4rem, 0.78vw, 0.5rem); letter-spacing: 0.18em; text-transform: uppercase; color: rgba(78, 216, 194, 0.9); }
  .cp__readout-name { font-family: var(--font-headline); font-size: clamp(0.72rem, 1.5vw, 1rem); font-weight: 700; color: var(--warm-white); line-height: 1.15; }
  .cp__readout-desc { font-size: clamp(0.5rem, 1vw, 0.7rem); line-height: 1.35; color: rgba(247, 244, 239, 0.62); margin-top: 0.2rem; }

  /* ─── Legend ─── */
  .cp__legend { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: var(--space-lg); }
  .cp__lg {
    display: inline-flex; align-items: center; gap: 0.45rem; font-family: inherit; font-size: 0.75rem;
    color: rgba(247, 244, 239, 0.66); background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.1); border-radius: 999px;
    padding: 0.4rem 0.5rem 0.4rem 0.8rem; cursor: pointer;
    transition: color var(--duration-fast), border-color var(--duration-fast), background var(--duration-fast);
  }
  .cp__lg i { width: 8px; height: 8px; border-radius: 50%; background: var(--lg, var(--mist-blue)); flex-shrink: 0; }
  .cp__lg b {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 400; color: rgba(247, 244, 239, 0.5);
    background: rgba(247, 244, 239, 0.07); border-radius: 999px; padding: 1px 6px; margin-left: 0.15rem;
  }
  .cp__lg:hover, .cp__lg:focus-visible { color: var(--warm-white); border-color: var(--lg, var(--reef-aqua)); background: rgba(247, 244, 239, 0.07); }
  .cp__lg--ai { cursor: default; border-color: rgba(78, 216, 194, 0.4); color: rgba(166, 245, 231, 0.95); }
  .cp__lg--ai i { background: var(--reef-aqua); box-shadow: 0 0 9px rgba(78, 216, 194, 0.95); }

  .cp__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ─── Integrations marquee ─── */
  .cp__apps { margin-top: var(--space-xl); }
  .cp__apps-head { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .cp__apps-line { flex: 1; height: 1px; background: rgba(247, 244, 239, 0.1); }
  .cp__apps-title {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.45); white-space: nowrap;
  }
  .cp__apps-title b { color: var(--reef-aqua); font-weight: 400; }

  .cp__marquee {
    display: flex; flex-direction: column; gap: 0.5rem; overflow: hidden;
    width: 100vw; max-width: 100vw;
    margin-left: 50%; transform: translateX(-50%);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .cp__row { overflow: hidden; }
  .cp__track { display: flex; gap: 0.5rem; width: max-content; animation: cpMarquee 46s linear infinite; }
  .cp__row--1 .cp__track { animation-duration: 58s; animation-direction: reverse; }
  .cp__marquee:hover .cp__track { animation-play-state: paused; }
  @keyframes cpMarquee { to { transform: translateX(-50%); } }

  .cp__chip {
    display: inline-flex; align-items: center; gap: 0.5rem; flex-shrink: 0;
    background: rgba(247, 244, 239, 0.045);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(247, 244, 239, 0.09); border-radius: 999px;
    padding: 0.55rem 1rem;
    transition: border-color var(--duration-fast), background var(--duration-fast);
  }
  .cp__chip:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    background: color-mix(in srgb, var(--brand) 10%, transparent);
  }
  .cp__chip svg { width: 17px; height: 17px; flex-shrink: 0; }
  .cp__chip svg path { fill: rgba(247, 244, 239, 0.7); transition: fill var(--duration-fast); }
  .cp__chip:hover svg path { fill: var(--brand); }
  .cp__chip > span { font-size: 0.75rem; color: rgba(247, 244, 239, 0.62); white-space: nowrap; }
  .cp__chip:hover > span { color: var(--warm-white); }
  .cp__chip--word > span { font-weight: 600; }

  .cp__note { font-size: 0.75rem; color: rgba(247, 244, 239, 0.38); margin: var(--space-md) auto 0; text-align: center; max-width: none; }
  .cp__cta {
    display: block; text-align: center; margin-top: var(--space-xs);
    font-size: 0.875rem; font-weight: 500; color: var(--reef-aqua);
    text-decoration: none; transition: opacity var(--duration-fast);
  }
  .cp__cta:hover { opacity: 0.75; }

  /* ─── Responsive ─── */
  @media (max-width: 700px) {
    /* Rotated capability labels stop being legible here, so the outer ring
       becomes a quiet colour band and the legend carries the detail. */
    .cp__stage { max-width: 400px; }
    .cp__cap-text { display: none; }
    .cp__dom-text { font-size: 15px; }
    .cp__readout { width: 26%; }
    .cp__readout-hint { display: none; }
    .cp__stats { gap: 0 var(--space-sm); }
    .cp__stat dt { font-size: 1.375rem; }
    .cp__chip { padding: 0.45rem 0.8rem; }
    .cp__chip > span { font-size: 0.6875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp__ai-dash, .cp__track { animation: none; }
    .cp--anim .cp__seg { opacity: 1; transform: none; }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .cp__sub { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cp__stat dt { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cp__stat dd { color: rgba(12, 14, 20, 0.45); }
  :global(html[data-theme="light"]) .cp__stat + .cp__stat::before { background: rgba(12, 14, 20, 0.14); }
  :global(html[data-theme="light"]) .cp__cap-text { fill: rgba(12, 14, 20, 0.85); }
  :global(html[data-theme="light"]) .cp__cap-text.is-ai-text { fill: #0E7568; }
  :global(html[data-theme="light"]) .cp__ai-label { fill: #0E7568; }
  :global(html[data-theme="light"]) .cp__aura { opacity: 0.5; }
  :global(html[data-theme="light"]) .cp__chip { background: rgba(12, 14, 20, 0.03); border-color: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cp__chip svg path { fill: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .cp__chip > span { color: rgba(12, 14, 20, 0.62); }
  :global(html[data-theme="light"]) .cp__chip:hover > span { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cp__lg { color: rgba(12, 14, 20, 0.68); border-color: rgba(12, 14, 20, 0.12); }
  :global(html[data-theme="light"]) .cp__lg b { color: rgba(12, 14, 20, 0.5); background: rgba(12, 14, 20, 0.06); }
  :global(html[data-theme="light"]) .cp__apps-title { color: rgba(12, 14, 20, 0.5); }
  :global(html[data-theme="light"]) .cp__apps-line { background: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cp__note { color: rgba(12, 14, 20, 0.45); }
</style>

<script>
  (function () {
    const section = document.getElementById('connected-platform');
    if (!section) return;
    const stage = section.querySelector('.cp__stage');
    const svg = section.querySelector('.cp__wheel');
    const readout = section.querySelector('.cp__readout');
    if (!stage || !svg || !readout) return;

    const def = readout.querySelector('.cp__readout-default');
    const det = readout.querySelector('.cp__readout-detail');
    const elDomain = readout.querySelector('.cp__readout-domain');
    const elName = readout.querySelector('.cp__readout-name');
    const elDesc = readout.querySelector('.cp__readout-desc');

    /* Arm the entrance only now that JS is running, so the wheel can never be
       left hidden by CSS that nothing undoes. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && 'IntersectionObserver' in window) {
      svg.classList.add('cp--anim');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { svg.classList.add('is-in'); io.disconnect(); } });
      }, { threshold: 0.15 });
      io.observe(svg);
      setTimeout(() => svg.classList.add('is-in'), 2500);
    }

    const clear = () => {
      stage.classList.remove('is-dim');
      stage.querySelectorAll('.cp__seg').forEach((s) => s.classList.remove('is-on'));
      def.hidden = false;
      det.hidden = true;
    };

    const focusDomain = (di) => {
      stage.classList.add('is-dim');
      stage.querySelectorAll('.cp__seg').forEach((s) => s.classList.remove('is-on'));
      stage.querySelectorAll('.cp__seg--d' + di).forEach((s) => s.classList.add('is-on'));
    };

    /* Hovering a capability turns the hub into a readout for it. */
    section.querySelectorAll('.cp__cap').forEach((seg) => {
      const show = () => {
        focusDomain(seg.className.baseVal.match(/cp__seg--d(\d+)/)[1]);
        elDomain.textContent = seg.getAttribute('data-ai') === '1'
          ? 'AI · ' + seg.getAttribute('data-domain-name')
          : seg.getAttribute('data-domain-name');
        elName.textContent = seg.getAttribute('data-name');
        elDesc.textContent = seg.getAttribute('data-desc');
        def.hidden = true;
        det.hidden = false;
      };
      seg.addEventListener('mouseenter', show);
      seg.addEventListener('mouseleave', clear);
    });

    section.querySelectorAll('.cp__lg[data-domain]').forEach((btn) => {
      const on = () => focusDomain(btn.getAttribute('data-domain'));
      btn.addEventListener('mouseenter', on);
      btn.addEventListener('focus', on);
      btn.addEventListener('mouseleave', clear);
      btn.addEventListener('blur', clear);
    });
  })();
</script>
