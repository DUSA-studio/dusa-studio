---
import BaseLayout from '../layouts/BaseLayout.astro';
import t from '../i18n/translations/en.json';
---

<BaseLayout
  t={t}
  title="Onboarding | DUSA.studio"
  description="See exactly what happens when you join DUSA. From your first demo call to full platform launch, we handle the setup so you can focus on growing your business."
>
  <!-- ═══ Hero ═══ -->
  <section class="ob-hero section--dark">
    <div class="container">
      <p class="ob-hero__eyebrow">Onboarding</p>
      <h1 class="ob-hero__title">
        We set it up. <span class="text--aqua">You grow.</span>
      </h1>
      <p class="ob-hero__sub">
        Most platforms hand you a login and say "good luck." We do the opposite. Your DUSA workspace is configured, populated, and ready to use before you touch a thing.
      </p>
    </div>
  </section>

  <!-- ═══ Timeline Detail ═══ -->
  <section class="ob-timeline section--dark">
    <div class="container">

      <div class="ob-phase">
        <div class="ob-phase__marker">
          <div class="ob-phase__badge">Day 1</div>
          <div class="ob-phase__line"></div>
        </div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">Discovery and Demo</h2>
          <p class="ob-phase__desc">
            Everything starts with a 15-minute call. We learn about your business, the tools you currently use, the problems you want to solve, and what success looks like for you.
          </p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail">
              <h3>What we cover</h3>
              <p>Your business model, current tech stack, pain points, growth goals, and which DUSA features align with your needs.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>What you get</h3>
              <p>A live walkthrough of the platform tailored to your business. Real examples, not a generic slide deck.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="ob-phase">
        <div class="ob-phase__marker">
          <div class="ob-phase__badge">Week 1</div>
          <div class="ob-phase__line"></div>
        </div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">Platform Setup</h2>
          <p class="ob-phase__desc">
            Once you are on board, our team gets to work configuring your DUSA workspace. We handle the technical setup so you are not spending hours figuring out settings menus.
          </p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail">
              <h3>CRM configuration</h3>
              <p>Custom fields, pipelines, tags, and contact stages built around your sales process.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>Automation sequences</h3>
              <p>Follow-up emails, SMS reminders, lead nurturing workflows. Configured and ready to run.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>Funnels and forms</h3>
              <p>Landing pages, booking forms, and lead capture funnels built to your brand.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>Integrations</h3>
              <p>Connected to your calendar, email, payment processor, and any other tools you need.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="ob-phase">
        <div class="ob-phase__marker">
          <div class="ob-phase__badge">Week 2</div>
          <div class="ob-phase__line"></div>
        </div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">Migration and Training</h2>
          <p class="ob-phase__desc">
            Moving from another platform? We transfer your contacts, campaigns, templates, and historical data. Then we walk your team through everything so you are confident using the system.
          </p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail">
              <h3>Data migration</h3>
              <p>Contacts, deals, email templates, and campaign history, all cleaned and mapped into DUSA.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>Team training</h3>
              <p>A hands-on walkthrough for you and your team. Not a recorded webinar. Live guidance tailored to your setup.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="ob-phase">
        <div class="ob-phase__marker">
          <div class="ob-phase__badge ob-phase__badge--ongoing">Ongoing</div>
        </div>
        <div class="ob-phase__body">
          <h2 class="ob-phase__title">Launch and Support</h2>
          <p class="ob-phase__desc">
            You are live. From here, our AI support assistant is available around the clock. For Growth and Bespoke plan members, your dedicated account manager checks in regularly to optimise your setup and help you get the most from the platform.
          </p>
          <div class="ob-phase__details">
            <div class="ob-phase__detail">
              <h3>AI support, 24/7</h3>
              <p>Get answers instantly. Our AI assistant is trained on the entire DUSA platform and can help with setup, troubleshooting, and best practices.</p>
            </div>
            <div class="ob-phase__detail">
              <h3>Dedicated account manager</h3>
              <p>For Growth and Bespoke plan members. Monthly check-ins, proactive optimisation, and a direct line to someone who knows your business.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="ob-cta section--dark">
    <div class="container">
      <div class="ob-cta__box">
        <h2 class="ob-cta__title">Ready to get started?</h2>
        <p class="ob-cta__desc">Book a free demo and see exactly how DUSA fits your business.</p>
        <div class="ob-cta__actions">
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--primary">Book Your Free Demo</a>
          <a href="/pricing" class="btn btn--outline">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .ob-hero {
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-2xl);
    text-align: center;
  }

  .ob-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--reef-aqua);
    margin-bottom: var(--space-sm);
  }

  .ob-hero__title {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .ob-hero__sub {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(247, 244, 239, 0.65);
  }

  /* ─── Timeline ─── */
  .ob-timeline {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ob-phase {
    display: flex;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .ob-phase:last-child {
    margin-bottom: 0;
  }

  .ob-phase__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 80px;
  }

  .ob-phase__badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--reef-aqua);
    background: rgba(78, 216, 194, 0.08);
    border: 1px solid rgba(78, 216, 194, 0.2);
    border-radius: 100px;
    padding: 0.35em 0.85em;
    white-space: nowrap;
  }

  .ob-phase__badge--ongoing {
    background: rgba(106, 170, 207, 0.08);
    border-color: rgba(106, 170, 207, 0.2);
    color: var(--mist-blue);
  }

  .ob-phase__line {
    width: 1px;
    flex: 1;
    min-height: 40px;
    background: linear-gradient(180deg, rgba(78, 216, 194, 0.2), rgba(78, 216, 194, 0.03));
    margin-top: var(--space-sm);
  }

  .ob-phase__body {
    flex: 1;
    padding-top: 0.15rem;
  }

  .ob-phase__title {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ob-phase__desc {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-md);
    max-width: 600px;
  }

  .ob-phase__details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .ob-phase__detail {
    background: rgba(247, 244, 239, 0.025);
    border: 1px solid rgba(247, 244, 239, 0.05);
    border-radius: var(--radius-md, 8px);
    padding: var(--space-md);
  }

  .ob-phase__detail h3 {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--warm-white);
    margin-bottom: 0.375rem;
  }

  .ob-phase__detail p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(247, 244, 239, 0.5);
  }

  /* ─── CTA ─── */
  .ob-cta {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .ob-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }

  .ob-cta__title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .ob-cta__desc {
    font-size: 1.0625rem;
    color: rgba(247, 244, 239, 0.6);
    margin-bottom: var(--space-lg);
  }

  .ob-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn--outline {
    background: transparent;
    border: 1px solid rgba(247, 244, 239, 0.2);
    color: var(--warm-white);
    padding: 0.75em 1.5em;
    border-radius: var(--radius-md, 8px);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: all var(--duration-fast);
    cursor: pointer;
  }

  .btn--outline:hover {
    border-color: var(--reef-aqua);
    color: var(--reef-aqua);
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .ob-phase {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .ob-phase__marker {
      flex-direction: row;
      width: auto;
      gap: var(--space-sm);
    }

    .ob-phase__line {
      display: none;
    }

    .ob-phase__details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .ob-hero {
      padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-lg);
    }
  }

  /* ─── Light Mode ─── */
  :global(html[data-theme="light"]) .ob-hero__title,
  :global(html[data-theme="light"]) .ob-phase__title,
  :global(html[data-theme="light"]) .ob-cta__title,
  :global(html[data-theme="light"]) .ob-phase__detail h3 {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ob-hero__sub,
  :global(html[data-theme="light"]) .ob-phase__desc,
  :global(html[data-theme="light"]) .ob-cta__desc {
    color: rgba(12, 14, 20, 0.65);
  }

  :global(html[data-theme="light"]) .ob-phase__detail {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.06);
  }

  :global(html[data-theme="light"]) .ob-phase__detail p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .ob-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.15);
  }

  :global(html[data-theme="light"]) .btn--outline {
    border-color: rgba(12, 14, 20, 0.15);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .btn--outline:hover {
    border-color: var(--reef-aqua);
    color: var(--reef-aqua);
  }
</style>
