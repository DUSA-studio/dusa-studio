---
import BaseLayout from '../../layouts/BaseLayout.astro';
import t from '../../i18n/translations/en.json';

const title = 'Marketing Automation for E-Commerce | DUSA.studio';
const description = 'Recover abandoned carts, automate post-purchase engagement, and build VIP loyalty programs. DUSA is the all-in-one growth platform built for e-commerce brands.';

const painPoints = [
  {
    icon: '🛒',
    title: 'Abandoned Carts With No Follow-Up',
    desc: 'A single recovery email is not enough. Most platforms stop there, leaving thousands of dollars in revenue sitting in abandoned carts.',
  },
  {
    icon: '📦',
    title: 'No Post-Purchase Engagement',
    desc: 'The sale happens and then silence. No thank-you sequence, no cross-sell, no review request. You are leaving repeat revenue on the table.',
  },
  {
    icon: '👑',
    title: 'No VIP Segmentation',
    desc: 'Your best customers get the same experience as everyone else. No recognition, no exclusive offers, no reason to stay loyal.',
  },
  {
    icon: '🔄',
    title: 'Low Repeat Purchase Rate',
    desc: 'Acquiring a new customer costs five times more than retaining one. Without re-engagement flows, most buyers never come back.',
  },
];

const features = [
  {
    title: 'Abandoned Cart Recovery',
    desc: 'Multi-step recovery sequences across email and SMS. Timed reminders, discount incentives, and urgency triggers that bring shoppers back.',
  },
  {
    title: 'Post-Purchase Sequences',
    desc: 'Thank-you emails, shipping updates, usage tips, and satisfaction check-ins. Keep the conversation going after the sale.',
  },
  {
    title: 'Review Request Automation',
    desc: 'Automatically request reviews at the perfect moment, after delivery and before the excitement fades. Build social proof on autopilot.',
  },
  {
    title: 'Cross-Sell and Upsell Flows',
    desc: 'Recommend complementary products based on purchase history. Trigger upsell offers when customers hit specific spending thresholds.',
  },
  {
    title: 'VIP Tier Management',
    desc: 'Segment customers by lifetime value. Unlock exclusive perks, early access, and personalised offers for your top spenders.',
  },
  {
    title: 'Birthday Rewards',
    desc: 'Automated birthday messages with exclusive discount codes. A small gesture that drives loyalty and repeat purchases.',
  },
];

const pipeline = [
  { stage: 'First Purchase', desc: 'Customer completes their first order' },
  { stage: 'Repeat Buyer', desc: 'Second purchase within 90 days' },
  { stage: 'Loyal Customer', desc: 'Three or more orders, engaged with emails' },
  { stage: 'VIP', desc: 'Top 10% by lifetime spend, exclusive perks unlocked' },
  { stage: 'Brand Advocate', desc: 'Leaves reviews, refers friends, shares on social' },
  { stage: 'Win-Back', desc: 'A past buyer has gone quiet. DUSA triggers a personalised re-engagement campaign with tailored product recommendations.' },
];

const stats = [
  { value: '69%', label: 'average cart abandonment rate across all e-commerce' },
  { value: '5x', label: 'cheaper to retain an existing customer than acquire a new one' },
  { value: '306%', label: 'higher lifetime value from customers who join a VIP program' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dusa.studio/' },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://dusa.studio/industries' },
    { '@type': 'ListItem', position: 3, name: 'E-Commerce', item: 'https://dusa.studio/industries/ecommerce' },
  ],
});
---

<BaseLayout t={t} title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- Hero -->
  <section class="ec-hero section section--dark">
    <div class="container">
      <div class="ec-hero__content">
        <span class="label">E-Commerce</span>
        <h1><span class="gradient-text">Marketing automation</span> for e-commerce brands</h1>
        <p class="ec-hero__sub">
          Recover abandoned carts, nurture post-purchase relationships, and turn one-time buyers into lifelong brand advocates.
        </p>
        <div class="ec-hero__actions">
          <a href="/start" class="btn btn--primary">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="ec-pain section section--dark">
    <div class="container">
      <div class="ec-pain__header">
        <span class="label">The Problem</span>
        <h2>You are losing revenue <span class="gradient-text">after the click</span></h2>
        <p class="ec-pain__intro">Most e-commerce brands focus on traffic and ignore everything that happens after the first visit. Here is what that costs you.</p>
      </div>
      <div class="ec-pain__grid">
        {painPoints.map((point) => (
          <div class="ec-pain__card">
            <span class="ec-pain__icon">{point.icon}</span>
            <h3 class="ec-pain__card-title">{point.title}</h3>
            <p class="ec-pain__card-desc">{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="ec-solution section section--dark">
    <div class="container">
      <div class="ec-solution__header">
        <span class="label">The Solution</span>
        <h2>How DUSA works for <span class="gradient-text">e-commerce</span></h2>
        <p class="ec-solution__intro">Automated flows that turn browsers into buyers, buyers into repeat customers, and repeat customers into brand advocates.</p>
      </div>
      <div class="ec-solution__grid">
        {features.map((feature) => (
          <div class="ec-solution__card">
            <h3 class="ec-solution__card-title">{feature.title}</h3>
            <p class="ec-solution__card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="ec-pipeline section section--dark">
    <div class="container">
      <div class="ec-pipeline__header">
        <span class="label">Pipeline</span>
        <h2>Your <span class="gradient-text">customer journey</span> at a glance</h2>
      </div>
      <div class="ec-pipeline__stages">
        {pipeline.map((step, i) => (
          <div class="ec-pipeline__stage">
            <div class="ec-pipeline__number">{i + 1}</div>
            <h3 class="ec-pipeline__stage-title">{step.stage}</h3>
            <p class="ec-pipeline__stage-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="ec-stats section section--dark">
    <div class="container">
      <div class="ec-stats__header">
        <span class="label">Impact</span>
        <h2>The numbers speak for <span class="gradient-text">themselves</span></h2>
      </div>
      <div class="ec-stats__grid">
        {stats.map((stat) => (
          <div class="ec-stats__card">
            <span class="ec-stats__value">{stat.value}</span>
            <p class="ec-stats__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ec-cta section section--dark">
    <div class="container">
      <div class="ec-cta__box">
        <h2>Ready to grow your <span class="gradient-text">e-commerce revenue</span>?</h2>
        <p class="ec-cta__sub">Get your cart recovery, post-purchase flows, and VIP program running in one platform.</p>
        <div class="ec-cta__actions">
          <a href="/start" class="btn btn--primary">Get Started</a>
          <a href="/blog/marketing-for-ecommerce" class="btn btn--outline">Read the guide</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .ec-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
  }
  .ec-hero__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .ec-hero__content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.7;
    margin-top: var(--space-sm);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .ec-pain {
    padding: var(--space-2xl) 0;
  }
  .ec-pain__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pain__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pain__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-pain__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .ec-pain__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-pain__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-pain__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .ec-pain__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pain__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Solution */
  .ec-solution {
    padding: var(--space-2xl) 0;
  }
  .ec-solution__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-solution__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-solution__intro {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
  }
  .ec-solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-solution__card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.25);
    transform: translateY(-2px);
  }
  .ec-solution__card-title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-solution__card-desc {
    color: rgba(247, 244, 239, 0.6);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Pipeline */
  .ec-pipeline {
    padding: var(--space-2xl) 0;
  }
  .ec-pipeline__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-pipeline__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-pipeline__stages {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
  }
  .ec-pipeline__stage {
    flex: 1;
    min-width: 160px;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
  }
  .ec-pipeline__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    color: var(--reef-aqua);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 auto var(--space-sm);
  }
  .ec-pipeline__stage-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }
  .ec-pipeline__stage-desc {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stats */
  .ec-stats {
    padding: var(--space-2xl) 0;
  }
  .ec-stats__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }
  .ec-stats__header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--warm-white);
    margin-top: var(--space-sm);
  }
  .ec-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .ec-stats__card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
  }
  .ec-stats__value {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--reef-aqua);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .ec-stats__label {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA */
  .ec-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .ec-cta__box {
    text-align: center;
    padding: var(--space-xl);
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-lg, 16px);
    max-width: 700px;
    margin: 0 auto;
  }
  .ec-cta__box h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--warm-white);
  }
  .ec-cta__sub {
    color: rgba(247, 244, 239, 0.6);
    margin-top: var(--space-sm);
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .ec-cta__actions {
    margin-top: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .ec-hero__content h1,
  :global(html[data-theme="light"]) .ec-pain__header h2,
  :global(html[data-theme="light"]) .ec-solution__header h2,
  :global(html[data-theme="light"]) .ec-pipeline__header h2,
  :global(html[data-theme="light"]) .ec-stats__header h2,
  :global(html[data-theme="light"]) .ec-cta__box h2,
  :global(html[data-theme="light"]) .ec-pain__card-title,
  :global(html[data-theme="light"]) .ec-solution__card-title,
  :global(html[data-theme="light"]) .ec-pipeline__stage-title {
    color: var(--deep-ocean);
  }
  :global(html[data-theme="light"]) .ec-hero__sub,
  :global(html[data-theme="light"]) .ec-pain__intro,
  :global(html[data-theme="light"]) .ec-solution__intro,
  :global(html[data-theme="light"]) .ec-pain__card-desc,
  :global(html[data-theme="light"]) .ec-solution__card-desc,
  :global(html[data-theme="light"]) .ec-pipeline__stage-desc,
  :global(html[data-theme="light"]) .ec-stats__label,
  :global(html[data-theme="light"]) .ec-cta__sub {
    color: rgba(12, 14, 20, 0.65);
  }
  :global(html[data-theme="light"]) .ec-pain__card,
  :global(html[data-theme="light"]) .ec-solution__card,
  :global(html[data-theme="light"]) .ec-pipeline__stage {
    background: rgba(12, 14, 20, 0.02);
    border-color: rgba(12, 14, 20, 0.08);
  }
  :global(html[data-theme="light"]) .ec-pain__card:hover,
  :global(html[data-theme="light"]) .ec-solution__card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }
  :global(html[data-theme="light"]) .ec-stats__card,
  :global(html[data-theme="light"]) .ec-cta__box {
    background: rgba(78, 216, 194, 0.06);
    border-color: rgba(78, 216, 194, 0.18);
  }
  :global(html[data-theme="light"]) .ec-pipeline__number {
    background: rgba(78, 216, 194, 0.2);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ec-pain__grid {
      grid-template-columns: 1fr;
    }
    .ec-solution__grid {
      grid-template-columns: 1fr;
    }
    .ec-stats__grid {
      grid-template-columns: 1fr;
    }
    .ec-pipeline__stages {
      flex-direction: column;
    }
    .ec-pipeline__stage {
      min-width: unset;
    }
  }
  @media (max-width: 480px) {
    .ec-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }
  }

  :global(html[data-theme="light"]) .ec-pain__icon,
  :global(html[data-theme="light"]) .ec-solution__card::before {
    background: rgba(26, 58, 92, 0.08);
    border-color: rgba(26, 58, 92, 0.15);
  }

  :global(html[data-theme="light"]) .ec-stats__value {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .ec-cta__actions .btn--outline {
    color: var(--deep-ocean);
  }
</style>
