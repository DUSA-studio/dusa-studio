    };

    /* A person: capsule body, round head, hard hat, arms and legs that pose. */
    type Pose = 'stand' | 'hammer' | 'phone' | 'sit' | 'sitMug' | 'laptop' | 'carry';
    const makePerson = (shirt: number, skin = 0xd9a98a, hat = true, scale = 1) => {
      const g = new THREE.Group();
      const shirtM = mat(shirt), vestM = mat(0xf7c53a), skinM = mat(skin), pantsM = mat(0x3b4555), hatM = mat(0xf7c53a);
