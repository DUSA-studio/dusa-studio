---
// ConnectedPlatform.astro — capability wheel + integrations grid.
//
// Colour logic: the six domains sit in a TIGHT Mist Blue band rather than a
// full light-to-dark ramp. The wide ramp looked half-lit, because pale domains
// needed dark labels and dark domains needed light ones, so the diagram never
// settled. Keeping every domain in the same luminance range means one label
// colour throughout, and it leaves Reef Aqua free to mean exactly one thing:
// AI. Anything glowing aqua here is AI, which is what lets the band read as a
// claim with evidence rather than decoration.
import { BRAND_MARKS, WORDMARK_ONLY } from '../config/brand-marks';

interface Props { t?: Record<string, any>; }
const { t = {} } = Astro.props;
const c = t?.connected || {};

const eyebrow = c.eyebrow || 'One Platform';
const heading = c.heading || 'Everything';
const headingAccent = c.headingAccent || 'connected';
const sub = c.sub || 'The systems that run your business, and the apps they plug into.';
const gridHeading = c.gridHeading || 'Connects with';
const note = c.note || 'Plus 1,000+ more through Zapier and Make.';
const ctaLabel = c.cta || 'See everything included';
const aiBandLabel = c.aiBand || 'AI  ·  ACROSS  EVERYTHING  ·  ';

const AQUA = '#4ED8C2';

const DOMAINS = [
  { name: 'Capture', color: '#A3D3EC', items: [
    { l: 'Funnels &\nlanding pages' }, { l: 'Websites\n& blogs' }, { l: 'Forms &\nsurveys' },
    { l: 'Chat widget', ai: true }, { l: 'Missed-call\ntext back' },
  ]},
  { name: 'Sales & Payments', color: '#8DC4E3', items: [
    { l: 'CRM &\npipelines' }, { l: 'Booking &\ncalendars' }, { l: 'Estimates\n& invoices' },
    { l: 'Payment\nlinks' }, { l: 'Subscriptions' },
  ]},
  { name: 'Conversations', color: '#78B5D9', items: [
    { l: 'Unified\ninbox' }, { l: 'Email' }, { l: 'SMS & MMS' },
    { l: 'Conversation\nAI', ai: true }, { l: 'Voice AI', ai: true },
  ]},
  { name: 'Marketing & Social', color: '#64A6CE', items: [
    { l: 'Email\ncampaigns' }, { l: 'Social\nplanner' },
    { l: 'Content AI', ai: true }, { l: 'Memberships\n& courses' },
  ]},
  { name: 'Automation', color: '#5397C2', items: [
    { l: 'Workflows\n& triggers' }, { l: 'Smart\nfollow-up', ai: true },
    { l: 'Lead\nrouting' }, { l: 'Task\nautomation' },
  ]},
  { name: 'Reputation', color: '#4589B4', items: [
    { l: 'Review\nrequests' }, { l: 'AI review\nreplies', ai: true },
    { l: 'Dashboards' }, { l: 'Attribution' },
  ]},
];

/* ─── Geometry, resolved at build time so the SVG ships static ─── */
const VB = 760, CX = 380, CY = 380;
const R_HUB = 78, R_AI0 = 84, R_AI1 = 114, R_D0 = 120, R_D1 = 196, R_C0 = 200, R_C1 = 330;
const GAP = 0.010;

const pol = (r: number, a: number) => [CX + r * Math.cos(a), CY + r * Math.sin(a)];
function arc(r0: number, r1: number, a0: number, a1: number) {
  const [x0, y0] = pol(r1, a0), [x1, y1] = pol(r1, a1);
  const [x2, y2] = pol(r0, a1), [x3, y3] = pol(r0, a0);
  const laf = a1 - a0 > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r1},${r1} 0 ${laf} 1 ${x1.toFixed(2)},${y1.toFixed(2)}` +
         `L${x2.toFixed(2)},${y2.toFixed(2)}A${r0},${r0} 0 ${laf} 0 ${x3.toFixed(2)},${y3.toFixed(2)}Z`;
}
function arcPath(r: number, a0: number, a1: number, flip: boolean) {
  const [s0, s1] = flip ? [a1, a0] : [a0, a1];
  const [x0, y0] = pol(r, s0), [x1, y1] = pol(r, s1);
  const laf = Math.abs(a1 - a0) > Math.PI ? 1 : 0;
  return `M${x0.toFixed(2)},${y0.toFixed(2)}A${r},${r} 0 ${laf} ${flip ? 0 : 1} ${x1.toFixed(2)},${y1.toFixed(2)}`;
}
const rgba = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
};

const totalCaps = DOMAINS.reduce((s, d) => s + d.items.length, 0);
const aiCount = DOMAINS.reduce((s, d) => s + d.items.filter((i: any) => i.ai).length, 0);
const appCount = BRAND_MARKS.length + WORDMARK_ONLY.length;

let cursor = -Math.PI / 2;
const domainSegs: any[] = [];
const capSegs: any[] = [];
let capIndex = 0;

DOMAINS.forEach((d, di) => {
  const span = (d.items.length / totalCaps) * Math.PI * 2;
  const a0 = cursor, a1 = cursor + span;
  const mid = (a0 + a1) / 2;
  // Flip the text path on the lower half so labels never read upside down.
  const m = ((mid % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
  const flip = m > 0 && m < Math.PI;
  const rLabel = (R_D0 + R_D1) / 2 + (flip ? 5 : -5);
  domainSegs.push({
    di, d: arc(R_D0, R_D1, a0 + GAP, a1 - GAP),
    label: d.name, color: d.color,
    textPath: arcPath(rLabel, a0 + GAP, a1 - GAP, flip),
  });

  const iSpan = span / d.items.length;
  d.items.forEach((it: any, ii: number) => {
    const b0 = a0 + ii * iSpan, b1 = b0 + iSpan;
    const m2 = (b0 + b1) / 2;
    const [ix, iy] = pol((R_C0 + R_C1) / 2, m2);
    const dg = (m2 * 180) / Math.PI;
    capSegs.push({
      di, i: capIndex++, d: arc(R_C0, R_C1, b0 + GAP, b1 - GAP),
      fill: it.ai ? rgba(AQUA, 0.3) : rgba(d.color, 0.34),
      stroke: it.ai ? rgba(AQUA, 0.95) : rgba(d.color, 0.62),
      label: it.l, lx: ix, ly: iy, ai: !!it.ai,
      rot: dg > 90 && dg < 270 ? dg + 180 : dg,
    });
  });
  cursor = a1;
});

const aiRing = arc(R_AI0, R_AI1, -Math.PI / 2 + 0.012, -Math.PI / 2 + Math.PI * 2 - 0.012);
const aiMidR = (R_AI0 + R_AI1) / 2 + 3;
const aiTextPath = `M ${CX},${CY - aiMidR} A ${aiMidR},${aiMidR} 0 1,1 ${CX - 0.01},${CY - aiMidR} Z`;

const STATS = [
  { n: '6', l: 'core domains' },
  { n: String(totalCaps), l: 'capabilities' },
  { n: String(aiCount), l: 'AI powered' },
  { n: `${appCount}+`, l: 'integrations' },
];
---

<section class="cp section section--dark" id="connected-platform">
  <div class="container">
    <div class="cp__head reveal">
      <span class="label">{eyebrow}</span>
      <h2>{heading} <span class="gradient-text">{headingAccent}</span></h2>
      <p class="cp__sub">{sub}</p>
      <dl class="cp__stats">
        {STATS.map((s) => (
          <div class="cp__stat">
            <dt>{s.n}</dt><dd>{s.l}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="cp__body">
      <div class="cp__wheel-col reveal">
        <div class="cp__stage">
          <span class="cp__aura" aria-hidden="true"></span>
          <svg class="cp__wheel" viewBox={`0 0 ${VB} ${VB}`} role="img"
               aria-labelledby="cp-title cp-desc">
            <title id="cp-title">What DUSA does</title>
            <desc id="cp-desc">
              Six capability domains around a central hub, with an AI layer spanning
              all of them: Capture, Sales and Payments, Conversations, Marketing and
              Social, Automation, and Reputation.
            </desc>

            <defs>
              <radialGradient id="cpAura" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color={AQUA} stop-opacity="0.18" />
                <stop offset="52%" stop-color="#1A3A5C" stop-opacity="0.12" />
                <stop offset="100%" stop-color="#0C0E14" stop-opacity="0" />
              </radialGradient>
              <filter id="cpSoftGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="2.6" result="b" />
                <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
              {DOMAINS.map((d, i) => (
                <linearGradient id={`cpD${i}`} x1="0%" y1="0%" x2="20%" y2="100%">
                  <stop offset="0%" stop-color={d.color} stop-opacity="1" />
                  <stop offset="100%" stop-color={d.color} stop-opacity="0.66" />
                </linearGradient>
              ))}
            </defs>

            <circle cx={CX} cy={CY} r={R_C1 + 26} fill="url(#cpAura)" />

            <g class="cp__ticks" aria-hidden="true">
              {capSegs.map((_, i) => {
                const a = -Math.PI / 2 + (i / capSegs.length) * Math.PI * 2;
                const [x1, y1] = pol(R_C1 + 9, a);
                const [x2, y2] = pol(R_C1 + 15, a);
                return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={rgba(AQUA, 0.3)} stroke-width="1" />;
              })}
            </g>
            <circle cx={CX} cy={CY} r={R_C1 + 19} fill="none"
                    stroke="rgba(247,244,239,0.08)" stroke-width="1" />

            <!-- capability ring -->
            {capSegs.map((s) => (
              <path class={`cp__seg cp__cap cp__seg--d${s.di} ${s.ai ? 'is-ai' : ''}`}
                    style={`--i:${s.i}`} d={s.d} fill={s.fill}
                    stroke={s.stroke} stroke-width="1" />
            ))}

            <!-- domain ring -->
            {domainSegs.map((s) => (
              <path class={`cp__seg cp__dom cp__seg--d${s.di}`} style={`--i:${s.di}`}
                    d={s.d} fill={`url(#cpD${s.di})`}
                    stroke="rgba(12,14,20,0.4)" stroke-width="1" />
            ))}

            <!-- AI layer -->
            <g class="cp__ai">
              <path d={aiRing} fill={rgba(AQUA, 0.17)} stroke={rgba(AQUA, 0.8)}
                    stroke-width="1.25" filter="url(#cpSoftGlow)" />
              <circle class="cp__ai-dash" cx={CX} cy={CY} r={R_AI1 - 1} fill="none"
                      stroke={rgba(AQUA, 0.45)} stroke-width="1"
                      stroke-dasharray="2 10" stroke-linecap="round" />
              <path id="cpAiPath" d={aiTextPath} fill="none" />
              <text class="cp__ai-label" filter="url(#cpSoftGlow)">
                <textPath href="#cpAiPath" startOffset="0%"
                          textLength={(2 * Math.PI * aiMidR).toFixed(1)}
                          lengthAdjust="spacing">
                  {aiBandLabel.repeat(2)}
                </textPath>
              </text>
            </g>

            <!-- labels last so nothing overlaps them -->
            {capSegs.map((s) => (
              <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.i}`} aria-hidden="true">
                <text class={`cp__cap-text ${s.ai ? 'is-ai-text' : ''}`} x={s.lx} y={s.ly}
                      text-anchor="middle" dominant-baseline="middle"
                      transform={`rotate(${s.rot} ${s.lx} ${s.ly})`}>
                  {s.label.split('\n').map((line: string, i: number, arr: string[]) => (
                    <tspan x={s.lx} dy={i === 0 ? -((arr.length - 1) * 6) : 12}>{line}</tspan>
                  ))}
                </text>
              </g>
            ))}
            {domainSegs.map((s) => (
              <g class={`cp__seg cp__seg--d${s.di}`} style={`--i:${s.di}`} aria-hidden="true">
                <path id={`cpDomPath${s.di}`} d={s.textPath} fill="none" />
                <text class="cp__dom-text">
                  <textPath href={`#cpDomPath${s.di}`} startOffset="50%" text-anchor="middle">
                    {s.label}
                  </textPath>
                </text>
              </g>
            ))}

            <!-- hub -->
            <circle cx={CX} cy={CY} r={R_HUB} fill="#0C0E14"
                    stroke={rgba(AQUA, 0.45)} stroke-width="1" />
            <circle cx={CX} cy={CY} r={R_HUB - 8} fill="none"
                    stroke="rgba(247,244,239,0.08)" stroke-width="1" />
            <text x={CX} y={CY - 4} text-anchor="middle" class="cp__hub-name">DUSA</text>
            <text x={CX} y={CY + 30} text-anchor="middle" class="cp__hub-sub">ONE LOGIN</text>
          </svg>
        </div>

        <div class="cp__legend">
          {DOMAINS.map((d, i) => (
            <button class="cp__lg" data-domain={i} type="button" style={`--lg:${d.color}`}>
              <i></i>{d.name.replace('\n', ' ')}
              <b>{d.items.length}</b>
            </button>
          ))}
          <span class="cp__lg cp__lg--ai"><i></i>AI powered<b>{aiCount}</b></span>
        </div>
      </div>

      <div class="cp__grid-col reveal">
        <div class="cp__grid-head">
          <span>{gridHeading}</span>
          <span class="cp__grid-count">{appCount}+</span>
        </div>
        <div class="cp__grid">
          {BRAND_MARKS.map((b) => (
            <div class="cp__chip" title={b.name} style={`--brand:${b.hex}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={b.path} /></svg>
              <span>{b.name}</span>
            </div>
          ))}
          {WORDMARK_ONLY.map((n) => (
            <div class="cp__chip cp__chip--word" title={n}><span>{n}</span></div>
          ))}
        </div>
        <p class="cp__note">{note}</p>
        <a href="/services" class="cp__cta">{ctaLabel} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cp__head { text-align: center; max-width: 680px; margin: 0 auto var(--space-xl); }
  .cp__head h2 { font-weight: 600; margin-top: var(--space-xs); }
  .cp__sub { color: rgba(247, 244, 239, 0.55); margin-top: var(--space-sm); font-size: 1.0625rem; }

  /* ─── Stat strip: states the scale the wheel then proves ─── */
  .cp__stats {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 0 var(--space-lg); margin: var(--space-lg) 0 0;
  }
  .cp__stat { text-align: center; position: relative; padding: 0 var(--space-sm); }
  .cp__stat + .cp__stat::before {
    content: ''; position: absolute; left: 0; top: 18%; height: 64%;
    width: 1px; background: rgba(247, 244, 239, 0.12);
  }
  .cp__stat dt {
    font-family: var(--font-headline); font-size: 1.75rem; font-weight: 700;
    color: var(--warm-white); line-height: 1.1;
  }
  .cp__stat dd {
    margin: 2px 0 0; font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: rgba(247, 244, 239, 0.42);
  }

  .cp__body { display: grid; grid-template-columns: 1.38fr 0.62fr; gap: var(--space-xl); align-items: center; }

  .cp__stage { position: relative; }
  .cp__aura {
    position: absolute; inset: -10%;
    background: radial-gradient(circle at 50% 50%,
      rgba(78, 216, 194, 0.14) 0%,
      rgba(26, 58, 92, 0.18) 40%,
      rgba(12, 14, 20, 0) 70%);
    filter: blur(20px); pointer-events: none; z-index: 0;
  }
  .cp__wheel { position: relative; z-index: 1; width: 100%; max-width: 760px; height: auto; display: block; margin: 0 auto; }

  .cp__dom-text { font-family: var(--font-headline); font-size: 13px; font-weight: 700; fill: #0C0E14; letter-spacing: 0.01em; }
  .cp__cap-text { font-family: var(--font-body); font-size: 11px; font-weight: 500; fill: rgba(247, 244, 239, 0.94); }
  .cp__cap-text.is-ai-text { fill: #A6F5E7; }
  .cp__hub-name { font-family: var(--font-headline); font-size: 30px; font-weight: 700; fill: var(--warm-white); letter-spacing: 0.02em; }
  .cp__hub-sub { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 2.4px; fill: rgba(78, 216, 194, 0.95); }
  .cp__ai-label { font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: 2.4px; fill: #7FEEDC; }

  .cp__ai-dash { transform-origin: center; animation: cpSpin 50s linear infinite; }
  .cp__ai-label { transform-origin: center; animation: cpSpin 120s linear infinite reverse; }
  @keyframes cpSpin { to { transform: rotate(360deg); } }

  /* ─── Entrance: only armed once JS confirms it can also disarm ─── */
  .cp__seg { transition: opacity var(--duration-normal) var(--ease-out), filter var(--duration-normal) var(--ease-out); }
  .cp--anim .cp__seg { opacity: 0; transform: scale(0.965); transform-origin: 380px 380px; }
  .cp--anim.is-in .cp__seg {
    opacity: 1; transform: scale(1);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 22ms);
  }
  .cp__cap:hover, .cp__dom:hover { filter: brightness(1.3); }
  .cp__wheel-col.is-dim .cp__seg:not(.is-on) { opacity: 0.12; }
  .cp__wheel-col.is-dim .cp__seg.is-on { filter: brightness(1.1); }

  /* ─── Legend ─── */
  .cp__legend { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: var(--space-lg); }
  .cp__lg {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: inherit; font-size: 0.75rem; color: rgba(247, 244, 239, 0.66);
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 999px; padding: 0.4rem 0.5rem 0.4rem 0.8rem; cursor: pointer;
    transition: color var(--duration-fast), border-color var(--duration-fast), background var(--duration-fast);
  }
  .cp__lg i { width: 8px; height: 8px; border-radius: 50%; background: var(--lg, var(--mist-blue)); flex-shrink: 0; }
  .cp__lg b {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 400;
    color: rgba(247, 244, 239, 0.5); background: rgba(247, 244, 239, 0.07);
    border-radius: 999px; padding: 1px 6px; margin-left: 0.15rem;
  }
  .cp__lg:hover, .cp__lg:focus-visible {
    color: var(--warm-white); border-color: var(--lg, var(--reef-aqua));
    background: rgba(247, 244, 239, 0.07);
  }
  .cp__lg--ai { cursor: default; border-color: rgba(78, 216, 194, 0.4); color: rgba(166, 245, 231, 0.95); }
  .cp__lg--ai i { background: var(--reef-aqua); box-shadow: 0 0 9px rgba(78, 216, 194, 0.95); }

  /* ─── Integrations ─── */
  .cp__grid-head {
    display: flex; align-items: baseline; justify-content: space-between;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(247, 244, 239, 0.42);
    margin-bottom: var(--space-sm); padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(247, 244, 239, 0.09);
  }
  .cp__grid-count { color: var(--reef-aqua); }
  .cp__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }
  .cp__chip {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
    background: rgba(247, 244, 239, 0.045);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(247, 244, 239, 0.09);
    border-radius: 12px; padding: 0.7rem 0.35rem; min-height: 66px;
    transition: transform var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast), background var(--duration-fast),
                box-shadow var(--duration-fast);
  }
  /* Brand colour appears only on hover: a wall of 21 brand colours at rest
     would fight the wheel for attention. */
  .cp__chip:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--brand, #4ED8C2) 55%, transparent);
    background: color-mix(in srgb, var(--brand, #4ED8C2) 9%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--brand, #4ED8C2) 18%, transparent);
  }
  .cp__chip svg { width: 19px; height: 19px; }
  .cp__chip svg path { fill: rgba(247, 244, 239, 0.7); transition: fill var(--duration-fast); }
  .cp__chip:hover svg path { fill: var(--brand, #F7F4EF); }
  .cp__chip span { font-size: 0.65rem; color: rgba(247, 244, 239, 0.55); text-align: center; line-height: 1.25; }
  .cp__chip:hover span { color: var(--warm-white); }
  .cp__chip--word span { font-weight: 600; font-size: 0.7rem; color: rgba(247, 244, 239, 0.68); }
  .cp__note { font-size: 0.75rem; color: rgba(247, 244, 239, 0.38); margin-top: var(--space-md); text-align: center; }
  .cp__cta {
    display: block; text-align: center; margin-top: var(--space-sm);
    font-size: 0.8125rem; font-weight: 500; color: var(--reef-aqua);
    text-decoration: none; transition: opacity var(--duration-fast);
  }
  .cp__cta:hover { opacity: 0.75; }

  /* ─── Responsive ─── */
  @media (max-width: 1100px) {
    .cp__body { grid-template-columns: 1fr; gap: var(--space-xl); }
    .cp__wheel { max-width: 620px; }
    .cp__grid { grid-template-columns: repeat(6, 1fr); }
    .cp__grid-col { max-width: 780px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 760px) {
    .cp__grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 700px) {
    /* Rotated capability labels stop being legible here, so the outer ring
       becomes a quiet colour band and the legend carries the detail. */
    .cp__wheel { max-width: 380px; }
    .cp__cap-text { display: none; }
    .cp__dom-text { font-size: 15px; }
    .cp__hub-name { font-size: 34px; }
    .cp__stats { gap: 0 var(--space-sm); }
    .cp__stat dt { font-size: 1.375rem; }
  }
  @media (max-width: 480px) {
    .cp__grid { grid-template-columns: repeat(3, 1fr); }
    .cp__chip span { font-size: 0.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp__ai-dash, .cp__ai-label { animation: none; }
    .cp--anim .cp__seg { opacity: 1; transform: none; }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .cp__sub { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cp__stat dt { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cp__stat dd { color: rgba(12, 14, 20, 0.45); }
  :global(html[data-theme="light"]) .cp__stat + .cp__stat::before { background: rgba(12, 14, 20, 0.14); }
  :global(html[data-theme="light"]) .cp__cap-text { fill: rgba(12, 14, 20, 0.85); }
  :global(html[data-theme="light"]) .cp__cap-text.is-ai-text { fill: #0E7568; }
  :global(html[data-theme="light"]) .cp__ai-label { fill: #0E7568; }
  :global(html[data-theme="light"]) .cp__aura { opacity: 0.5; }
  :global(html[data-theme="light"]) .cp__chip { background: rgba(12, 14, 20, 0.03); border-color: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cp__chip svg path { fill: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .cp__chip span { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cp__chip:hover span { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cp__lg { color: rgba(12, 14, 20, 0.68); border-color: rgba(12, 14, 20, 0.12); }
  :global(html[data-theme="light"]) .cp__lg b { color: rgba(12, 14, 20, 0.5); background: rgba(12, 14, 20, 0.06); }
  :global(html[data-theme="light"]) .cp__grid-head { color: rgba(12, 14, 20, 0.45); border-bottom-color: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cp__note { color: rgba(12, 14, 20, 0.45); }
</style>

<script>
  (function () {
    const section = document.getElementById('connected-platform');
    const col = section?.querySelector('.cp__wheel-col');
    const svg = section?.querySelector('.cp__wheel');
    if (!section || !col || !svg) return;

    /* Arm the entrance only now that JS is running, so the wheel is never
       hidden by CSS that nothing can undo. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && 'IntersectionObserver' in window) {
      svg.classList.add('cp--anim');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { svg.classList.add('is-in'); io.disconnect(); }
        });
      }, { threshold: 0.2 });
      io.observe(svg);
      /* Belt and braces: if it never fires, show everything. */
      setTimeout(() => svg.classList.add('is-in'), 2500);
    }

    const clear = () => {
      col.classList.remove('is-dim');
      col.querySelectorAll('.cp__seg').forEach((s) => s.classList.remove('is-on'));
    };
    col.querySelectorAll('.cp__lg[data-domain]').forEach((btn) => {
      const on = () => {
        clear();
        col.classList.add('is-dim');
        col.querySelectorAll('.cp__seg--d' + btn.getAttribute('data-domain'))
           .forEach((s) => s.classList.add('is-on'));
      };
      btn.addEventListener('mouseenter', on);
      btn.addEventListener('focus', on);
      btn.addEventListener('mouseleave', clear);
      btn.addEventListener('blur', clear);
    });
  })();
</script>
