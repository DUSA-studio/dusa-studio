        const shape = new THREE.Shape();
        shape.moveTo(-w / 2 - 0.25, 0); shape.lineTo(w / 2 + 0.25, 0); shape.lineTo(0, w * 0.4); shape.closePath();
        const roofGeo = new THREE.ExtrudeGeometry(shape, { depth: d + 0.5, bevelEnabled: false }); roofGeo.translate(0, 0, -(d + 0.5) / 2);
        const roof = new THREE.Mesh(roofGeo, mat(roofColor, { roughness: 0.6 })); roof.position.y = h; roof.castShadow = true; roof.receiveShadow = true; g.add(roof);
        g.add(box(0.3, 0.5, 0.3, mat(C.trim), w * 0.28, h + w * 0.28, 0));
        g.add(box(0.5, 0.9, 0.06, mat(door), 0, 0.45, d / 2 + 0.03));
        g.add(box(0.5, 0.45, 0.06, winMat, -w * 0.3, h * 0.62, d / 2 + 0.03, false));
        g.add(box(0.5, 0.45, 0.06, winMat, w * 0.3, h * 0.62, d / 2 + 0.03, false));
        g.position.set(x, 0, z);
        return { g, h, w, d };
      };
      const home = nice
        ? house(HOME_X, -0.8, 3.0, 2.2, 1.45, C.wallNice, C.roofNice, C.aqua, windowMat)
        : house(HOME_X, -0.6, 2.2, 1.8, 1.2, C.wall, C.roof, C.ocean, laptopWinMat);
      const job = house(JOB_X, -0.9, 2.6, 2.1, 1.3, C.wall, C.roof, C.ocean, windowMat);
      scene.add(home.g, job.g);

      if (nice) {
        // White picket fence along the front, with a gap for the path.
        const picket = mat(C.warm, { roughness: 0.7 });
        const fz = -0.8 + 1.1 + 1.0;
        for (let fx = -2.1; fx <= 2.1; fx += 0.24) { if (Math.abs(fx) < 0.42) continue; scene.add(box(0.07, 0.48, 0.04, picket, HOME_X + fx, 0.24, fz)); }
        scene.add(box(1.7, 0.04, 0.03, picket, HOME_X - 1.28, 0.34, fz), box(1.7, 0.04, 0.03, picket, HOME_X + 1.28, 0.34, fz));
        const path = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 1.9), mat(0xb9c3cc, { roughness: 1 })); path.rotation.x = -Math.PI / 2; path.position.set(HOME_X, 0.012, 0.4); path.receiveShadow = true; scene.add(path);
        for (const [gx, gz] of [[-1.5, 0.75], [-0.9, 0.75], [0.9, 0.75], [1.5, 0.75]]) { const f = new THREE.Mesh(new THREE.SphereGeometry(0.13, 10, 8), mat(0xf2c3b0)); f.position.set(HOME_X + gx, 0.13, gz); f.castShadow = true; scene.add(f); }
      } else {
        scene.add(box(0.9, 0.3, 0.6, mat(0x3a4150), HOME_X + 1.5, 0.15, 0.6)); // the bin, and a tile pile that never got put away
        scene.add(box(0.8, 0.22, 0.5, mat(C.roof), HOME_X - 1.6, 0.11, 0.8));
      }

      // Ladder: leaning on the side wall of the job house, feet on the ground.
      const ladder = new THREE.Group();
      const rail = mat(C.wood);
      const LL = 1.75;
      ladder.add(box(0.05, LL, 0.05, rail, 0, LL / 2, -0.2), box(0.05, LL, 0.05, rail, 0, LL / 2, 0.2));
      for (let i = 0; i < 6; i++) ladder.add(box(0.04, 0.04, 0.4, rail, 0, 0.2 + i * 0.27, 0));
      ladder.position.set(JOB_X - job.w / 2 - 0.62, 0, -0.9 + 0.2); ladder.rotation.z = -0.5;
      scene.add(ladder);
      scene.add(box(0.7, 0.25, 0.5, mat(C.roof), JOB_X + 1.9, 0.125, 0.5));

      const tree = (x: number, z: number, s = 1) => {
        const g = new THREE.Group();
        g.add(box(0.14, 0.5 * s, 0.14, mat(C.wood), 0, 0.25 * s, 0));
        const leaf = new THREE.Mesh(new THREE.IcosahedronGeometry(0.42 * s, 1), mat(C.leaf, { roughness: 0.9 })); leaf.position.y = 0.72 * s; leaf.castShadow = true; g.add(leaf);
        g.position.set(x, 0, z); scene.add(g);
      };
      tree(-6.6, -2.4, 1.1); tree(-1.4, -3.5, 0.9); tree(6.6, -3.1, 1.2); tree(1.6, -3.7, 0.8); tree(-6, 4.1, 0.9); tree(6, 4.2, 1);
      if (nice) { tree(-6.2, 0.6, 0.8); tree(-1.3, -1.9, 0.7); }

      // Ute: the nice one is newer, lighter, with a roof rack.
      const ute = new THREE.Group();
      const uteBody = mat(nice ? C.mist : C.ocean, { roughness: nice ? 0.35 : 0.6, metalness: nice ? 0.35 : 0.15 });
      ute.add(box(1.7, 0.36, 0.8, uteBody, 0, 0.42, 0));
      ute.add(box(0.7, 0.42, 0.78, uteBody, 0.35, 0.8, 0));
      ute.add(box(0.72, 0.2, 0.7, mat(0x9fd8ea, { roughness: 0.2, metalness: 0.3 }), 0.35, 0.84, 0, false));
      ute.add(box(0.85, 0.14, 0.78, mat(C.ink), -0.45, 0.66, 0));
      if (nice) { ute.add(box(0.74, 0.03, 0.82, mat(0x9fb3c4, { metalness: 0.6, roughness: 0.3 }), 0.35, 1.03, 0)); ute.add(box(0.06, 0.08, 0.82, mat(0x9fb3c4, { metalness: 0.6, roughness: 0.3 }), 0.8, 0.5, 0)); }
      else ute.add(box(0.5, 0.05, 0.3, mat(0x7a5a3a), -0.1, 0.61, 0, false));
      const wheelGeo = new THREE.CylinderGeometry(0.17, 0.17, 0.14, 16);
      const wheels: THREE.Mesh[] = [];
      for (const [wx, wz] of [[-0.55, 0.42], [-0.55, -0.42], [0.55, 0.42], [0.55, -0.42]]) { const w = new THREE.Mesh(wheelGeo, mat(C.ink, { roughness: 0.9 })); w.rotation.x = Math.PI / 2; w.position.set(wx, 0.17, wz); w.castShadow = true; ute.add(w); wheels.push(w); }
      const head1 = new THREE.PointLight(0xfff1cc, 0, 4); head1.position.set(0.8, 0.5, 0.25); ute.add(head1);
      const head2 = head1.clone(); head2.position.z = -0.25; ute.add(head2);
      scene.add(ute);

      // People
      const roofer = person(nice ? C.aqua : 0xd6d0c4);
      scene.add(roofer.g);
      const family = new THREE.Group();
      const partner = person(nice ? C.mist : 0x8f8a80, 0.95, false); partner.g.position.set(0.5, 0, 0.1); family.add(partner.g);
      const kid = person(nice ? C.warm : 0x8f8a80, 0.6, false); kid.g.position.set(-0.45, 0, 0.25); family.add(kid.g);
      family.position.set(HOME_X + 0.2, 0, 1.0); family.visible = false; scene.add(family);
      // Evening props: a table. The nice one gets a warm lamp; the other a cold laptop.
      const table = new THREE.Group();
      table.add(box(0.9, 0.05, 0.6, mat(C.wood), 0, 0.5, 0), box(0.06, 0.5, 0.06, mat(C.wood), -0.4, 0.25, -0.25), box(0.06, 0.5, 0.06, mat(C.wood), 0.4, 0.25, 0.25), box(0.06, 0.5, 0.06, mat(C.wood), -0.4, 0.25, 0.25), box(0.06, 0.5, 0.06, mat(C.wood), 0.4, 0.25, -0.25));
      const laptopScreen = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.26, 0.02), new THREE.MeshStandardMaterial({ color: 0x1c2a3e, emissive: 0x9fd8ff, emissiveIntensity: 0 }));
      laptopScreen.position.set(0, 0.66, -0.1); laptopScreen.rotation.x = -0.25;
      const laptopBase = box(0.36, 0.02, 0.24, mat(0x8a94a6), 0, 0.53, 0.02);
      if (!nice) table.add(laptopScreen, laptopBase);
      const tableLight = new THREE.PointLight(nice ? 0xffb36b : 0x9fd8ff, 0, 4); tableLight.position.set(0, 1.1, 0); table.add(tableLight);
      table.position.set(HOME_X + 0.2, 0, 0.9); table.visible = false; scene.add(table);
      const porchLight = new THREE.PointLight(0xffc97a, 0, 5); porchLight.position.set(HOME_X, 1.6, home.d / 2 - 0.6 + 0.6); scene.add(porchLight);

      // Phone
      const phone = makePhone(nice);
      scene.add(phone.g);

      // Sky
      const sunBall = new THREE.Mesh(new THREE.SphereGeometry(0.5, 20, 16), new THREE.MeshBasicMaterial({ color: 0xffd58a })); scene.add(sunBall);
      const moonBall = new THREE.Mesh(new THREE.SphereGeometry(0.32, 20, 16), new THREE.MeshBasicMaterial({ color: 0xdde7f5 })); scene.add(moonBall);
      const starGeo = new THREE.BufferGeometry(); const sp = new Float32Array(200 * 3);
      for (let i = 0; i < 200; i++) { const a = Math.random() * Math.PI * 2, r = 12 + Math.random() * 12, y = 4 + Math.random() * 10; sp.set([Math.cos(a) * r, y, Math.sin(a) * r], i * 3); }
      starGeo.setAttribute('position', new THREE.BufferAttribute(sp, 3));
      const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0xffffff, size: 0.07, transparent: true, opacity: 0 })); scene.add(stars);

      // Timeline per roofer. The one without DUSA works late: stays on the job until the light goes.
      const leave = 0.07, arrive = 0.2, depart = nice ? 0.74 : 0.86, arriveHome = nice ? 0.84 : 0.95;
      const uteX = (p: number) => p < leave ? HOME_X : p < arrive ? lerp(HOME_X, JOB_X, smooth(leave, arrive, p)) : p < depart ? JOB_X : p < arriveHome ? lerp(JOB_X, HOME_X, smooth(depart, arriveHome, p)) : HOME_X;
      const driving = (p: number) => (p >= leave && p < arrive) || (p >= depart && p < arriveHome);
      const onRoof = (p: number) => smooth(arrive, arrive + 0.05, p) * (1 - smooth(depart - 0.04, depart, p));
      const evening = (p: number) => smooth(arriveHome, arriveHome + 0.03, p);

      let pingAt = -1e9, shownBeat = -1;
      const items: string[] = [];
      const hudTarget = new THREE.Vector3(), worldTarget = new THREE.Vector3(), phonePos = new THREE.Vector3();
      let phoneHud = 0;

      const applyTheme = (dark: boolean) => {
        hemi.groundColor.set(dark ? 0x223044 : 0x9aa7b5);
      };

      const update = (p: number, now: number, dt: number, sky: { hour: number; elev: number; sunT: number; night: number; dawn: number; dusk: number; dark: boolean }, beat: number, narrow: boolean) => {
        const { hour, elev, sunT, night, dawn, dusk, dark } = sky;
        const ev = evening(p);
        // Light
        sun.position.set(Math.cos(Math.PI - sunT * Math.PI) * 10, 2 + elev * 10, -5 + elev * 2);
        sun.intensity = 1.0 + elev * 3.2 * (1 - night);
        sun.color.copy(mix(0xfff4e0, 0xffa06a, Math.max(dawn, dusk)));
        hemi.intensity = 0.8 + elev * 1.0 * (1 - night) + 0.1 * night;
        hemi.color.copy(mix(dark ? 0xcfe3ff : 0xffffff, 0x3b5a8c, night));
        nightAmb.intensity = night * 0.8;
        // The ground greens up with the daylight and goes slate at night.
        const dayAmt = clamp01(elev * 1.4) * (1 - night);
        groundMat.color.copy(mix(dark ? C.groundNight : C.groundLightNight, dark ? C.groundDay : C.groundLightDay, dayAmt));
        roadMat.color.copy(mix(dark ? C.roadNight : 0x8a95a3, dark ? C.roadDay : C.roadLight, dayAmt));
        sunBall.position.set(Math.cos(Math.PI - sunT * Math.PI) * 9, 1 + elev * 7.5, -7.5);
        (sunBall.material as THREE.MeshBasicMaterial).color.copy(mix(0xffd58a, 0xff8c5a, Math.max(dawn, dusk)));
        sunBall.visible = elev > 0.02 && night < 0.95;
        const moonT = clamp01((hour - 17.5) / 3);
        moonBall.position.set(-6 + moonT * 3, 1 + moonT * 7, -8); moonBall.visible = night > 0.05;
        (stars.material as THREE.PointsMaterial).opacity = night * (dark ? 0.9 : 0.25);
        windowMat.emissiveIntensity = night * 1.6 + dawn * 0.5;
        laptopWinMat.emissiveIntensity = night * ev * 1.8;
        head1.intensity = head2.intensity = (night > 0.2 || dawn > 0.4) && driving(p) ? 2.5 : 0;

        // Camera: slow orbit, a touch closer at night.
        const ang = -0.8 + p * 1.45;
        const radius = 17.5 - ev * 6;
        const look = new THREE.Vector3(lerp(0, HOME_X + 0.6, ev), (narrow ? -0.6 : 0.3) - ev * 0.2, lerp(0, 0.6, ev));
        camera.position.set(look.x + Math.sin(ang) * radius, 8.2 - ev * 3.2, look.z + Math.cos(ang) * radius);
        camera.lookAt(look);

        // Ute
        ute.position.set(uteX(p), 0, ROAD_Z);
        ute.rotation.y = p < 0.5 ? 0 : Math.PI;
        if (driving(p)) wheels.forEach((w) => (w.rotation.y += dt * 9));
        const parkedJob = smooth(arrive - 0.01, arrive + 0.01, p) * (1 - smooth(depart - 0.01, depart + 0.01, p));
        const parkedHome = clamp01(1 - smooth(leave - 0.01, leave + 0.01, p) + smooth(arriveHome - 0.01, arriveHome + 0.01, p));
        ute.position.z = ROAD_Z + 0.8 * Math.min(1, parkedJob + parkedHome);

        // Roofer
        const r = onRoof(p), drv = driving(p);
        roofer.g.visible = !drv;
        if (!drv) {
          const atHome = p < leave || p >= arriveHome;
          const baseX = atHome ? HOME_X + (ev > 0 ? 0.2 : 1.4) : JOB_X - 2.1;
          const baseZ = atHome ? (ev > 0 ? 1.45 : ROAD_Z - 0.5) : ROAD_Z - 0.5;
          const roofX = JOB_X - 0.3, roofY = job.h + 0.42, roofZ = -0.9 + 0.55;
          roofer.g.position.set(lerp(baseX, roofX, r), lerp(0, roofY, r), lerp(baseZ, roofZ, r));
          roofer.g.rotation.y = atHome && ev > 0 ? Math.PI : lerp(-0.4, -1.1, r);
          roofer.arm.rotation.x = r > 0.5 ? -0.9 + Math.sin(now / 160) * 0.7 : atHome && ev > 0 && !nice ? -1.2 : 0.1;
        }
        // Evening: a table outside the house. Family for the one who got home.
        table.visible = ev > 0.01; family.visible = nice && ev > 0.01;
        table.scale.setScalar(Math.max(0.001, ev)); family.scale.setScalar(Math.max(0.001, ev));
        tableLight.intensity = ev * (nice ? 2.6 : 1.4) * Math.max(0.3, night);
        laptopScreen.material.emissiveIntensity = ev * 2.2;
        porchLight.intensity = nice ? night * 2.2 : 0;

        // Phone: beside the roofer, or up in the corner of this half when he cannot reach it.
        const wantHud = r > 0.5 || drv;
        phoneHud += ((wantHud ? 1 : 0) - phoneHud) * Math.min(1, dt * 3.5);
        worldTarget.copy(drv ? ute.position : roofer.g.position).add(new THREE.Vector3(drv ? 0 : 0.6, drv ? 1.5 : 1.35 - ev * 0.3, drv ? 0 : 0.25 + ev * 0.3));
        hudTarget.set(nice ? 0.58 : -0.58, narrow ? 0.1 : 0.38, 0.5).unproject(camera).sub(camera.position).normalize().multiplyScalar(6.5).add(camera.position);
        phonePos.lerpVectors(worldTarget, hudTarget, phoneHud);
        phone.g.position.copy(phonePos);
        phone.g.position.y += Math.sin(now / 900) * 0.05;
        phone.g.lookAt(camera.position);
        phone.g.scale.setScalar(lerp(0.9, 1.3, phoneHud) * (1 - ev * 0.4));

        // Notifications land on the screen once per beat.
        if (beat !== shownBeat) {
          shownBeat = beat; pingAt = now;
          items.length = 0; for (let i = 0; i <= beat; i++) items.push(notes[nice ? 1 : 0][i].text);
          phone.draw(notes[nice ? 1 : 0][beat].time, items, night);
        }
        const since = (now - pingAt) / 1000;
        const pulse = since < 1.6 ? 1 - since / 1.6 : 0;
        phone.ring.scale.setScalar(1 + (1 - pulse) * 0.9);
        (phone.ring.material as THREE.MeshBasicMaterial).opacity = pulse * 0.9;
        phone.light.intensity = 0.3 + pulse * 2.4 + night * 0.5;
      };
      return { scene, camera, update, applyTheme };
    };

    const worlds = [makeWorld(false), makeWorld(true)];

    /* ── Scroll state ── */
    let progress = 0, beat = -1, running = false, lastT = 0, dark = !isLight();
    const applyTheme = () => { dark = !isLight(); worlds.forEach((w) => w.applyTheme(dark)); };
    applyTheme();
    new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    const setBeat = (b: number) => {
      if (b === beat) return;
      beat = b;
      cardSets.forEach((set) => set.forEach((c, i) => { if (i === b) c.setAttribute('aria-current', 'step'); else c.removeAttribute('aria-current'); }));
      dots.forEach((d, i) => { d.classList.toggle('is-on', i === b); d.classList.toggle('is-past', i < b); });
      timeEl.textContent = notes[0][b].time;
      hintEl.classList.toggle('is-done', b > 0);
    };
    const readScroll = () => {
      const rect = root.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      progress = clamp01(-rect.top / Math.max(1, total));
      setBeat(Math.min(BEATS - 1, Math.floor(progress * BEATS)));
    };

    let W = 1, H = 1, narrow = false;
    const resize = () => {
      W = stage.clientWidth; H = stage.clientHeight; narrow = W < 900;
      renderer.setSize(W, H, false);
      const vw = narrow ? W : W / 2, vh = narrow ? H / 2 : H;
      const hFov = (narrow ? 60 : 50) * Math.PI / 180;
      worlds.forEach((w) => { w.camera.aspect = vw / vh; w.camera.fov = (2 * Math.atan(Math.tan(hFov / 2) / w.camera.aspect)) * 180 / Math.PI; w.camera.updateProjectionMatrix(); });
    };

    /* ── Frame ── */
    const frame = (now: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (now - lastT) / 1000 || 0); lastT = now;
      const p = progress;
      // 6:30am to 9:30pm across the scroll.
      const hour = 6.5 + p * 15;
      const sunT = clamp01((hour - 6) / 13);
      const elev = Math.sin(sunT * Math.PI);
      const night = smooth(17.8, 19.6, hour);
      const dawn = 1 - smooth(6.5, 8.5, hour);
      const dusk = smooth(16.2, 18.2, hour) * (1 - night);
      const sky = { hour, elev, sunT, night, dawn, dusk, dark };
      root.style.setProperty('--day', String(clamp01(elev * 1.3) * (1 - night)));
      skyEl.textContent = hour < 8 ? 'Dawn' : hour < 12 ? 'Morning' : hour < 17 ? 'Afternoon' : hour < 18.8 ? 'Dusk' : 'Night';

      const pr = renderer.getPixelRatio();
      worlds.forEach((w, i) => {
        w.update(p, now, dt, sky, beat, narrow);
        const x = narrow ? 0 : i * (W / 2), y = narrow ? (i === 0 ? H / 2 : 0) : 0;
        const vw = narrow ? W : W / 2, vh = narrow ? H / 2 : H;
        renderer.setViewport(x, y, vw, vh); renderer.setScissor(x, y, vw, vh);
        renderer.render(w.scene, w.camera);
      });
      void pr;
      requestAnimationFrame(frame);
    };

    const start = () => { if (running) return; running = true; lastT = performance.now(); resize(); readScroll(); requestAnimationFrame(frame); };
    const stop = () => { running = false; };
    new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.01 }).observe(root);
    window.addEventListener('scroll', readScroll, { passive: true });
    window.addEventListener('resize', () => { resize(); readScroll(); });
    resize(); readScroll();
  } else if (root && reduced) {
    root.querySelectorAll('[data-beat]').forEach((c) => c.setAttribute('aria-current', 'step'));
  }
</script>
