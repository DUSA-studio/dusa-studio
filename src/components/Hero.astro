---
// Hero.astro — Full-viewport editorial hero with notification phone mockup
---

<section class="hero section--dark" id="hero">
  <div class="hero__bg">
    <div class="hero__water" id="hero-water-canvas"></div>
    <div class="hero__grid-lines"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__layout">
      <div class="hero__content">
        <span class="label reveal">The AI-Powered Growth System</span>

        <h1 class="hero__title reveal">
          Everything you need.<br />
          <span class="gradient-text">One login.</span>
        </h1>

        <p class="hero__subtitle reveal">AI-powered marketing, sales, and engagement. All connected. So you can run your business, not your tech stack.</p>

        <div class="hero__ctas reveal">
          <a href="#features" class="btn btn--primary">Start Growing</a>
          <a href="#contact" class="btn btn--outline">Book a Demo</a>
        </div>
      </div>

      <div class="hero__phone-wrap reveal-right">
        <div class="hero__phone">
          <div class="hero__phone-notch"></div>
          <div class="hero__phone-time" id="hero-phone-clock">9:41</div>
          <div class="hero__phone-header">
            <img class="hero__phone-logo" id="hero-phone-lotus" src="/dusa-logo-animated.webp" alt="DUSA" width="22" height="22" />
            <span class="hero__phone-app">DUSA . studio</span>
          </div>

          <div class="hero__stats-ticker" id="hero-stats-ticker">
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-leads">8</span> leads</div>
            <div class="hero__stat-divider"></div>
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-revenue">$2.4k</span> tracked</div>
            <div class="hero__stat-divider"></div>
            <div class="hero__stat-item"><span class="hero__stat-val" id="stat-rating">4.8</span>&#9733;</div>
          </div>

          <div class="hero__notifs" id="hero-notif-feed"></div>
        </div>

        <div class="hero__platforms">
          <span class="hero__platforms-label">Available on</span>
          <div class="hero__platforms-icons">
            <!-- iOS -->
            <div class="hero__platform" title="iOS App">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
            </div>
            <!-- Android -->
            <div class="hero__platform" title="Android App">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.27-.86-.31-.16-.69-.04-.86.27l-1.87 3.23C14.89 8.35 13.48 8 12 8c-1.48 0-2.89.35-4.44.94L5.69 5.71c-.16-.31-.54-.43-.86-.27-.31.16-.43.55-.27.86l1.84 3.18C3.38 11.2 1.39 13.96 1 17h22c-.39-3.04-2.38-5.8-5.4-7.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/>
              </svg>
            </div>
            <!-- Desktop / Web -->
            <div class="hero__platform" title="Desktop App">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <!-- Web Browser -->
            <div class="hero__platform" title="Web Browser">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__capabilities reveal">
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">CRM & Contacts</span>
          <span class="hero__cap-sub">Track every lead</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">Email & SMS</span>
          <span class="hero__cap-sub">Campaigns on autopilot</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">Funnels & Automations</span>
          <span class="hero__cap-sub">Convert while you sleep</span>
        </div>
      </div>
      <div class="hero__cap">
        <div class="hero__cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4z"/><path d="M9 12h6l2 10H7l2-10z"/><circle cx="12" cy="5" r="1" fill="currentColor"/>
          </svg>
        </div>
        <div class="hero__cap-text">
          <span class="hero__cap-title">AI Built In</span>
          <span class="hero__cap-sub">Smarter conversations, faster growth</span>
        </div>
      </div>
    </div>

    <div class="hero__scroll-indicator">
      <span class="hero__scroll-text">Explore</span>
      <div class="hero__scroll-line"></div>
      <svg class="hero__scroll-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__water {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__water canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__grid-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(rgba(247, 244, 239, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 244, 239, 0.018) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .hero__title {
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    margin-bottom: 0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    font-size: 1.25rem;
    color: rgba(247, 244, 239, 0.5);
    line-height: 1.7;
    margin-top: var(--space-md);
    max-width: 480px;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* --- Phone Mockup --- */
  .hero__phone-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__phone {
    width: 320px;
    height: 640px;
    background: linear-gradient(165deg, rgba(247, 244, 239, 0.06) 0%, rgba(247, 244, 239, 0.02) 100%);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 36px;
    padding: 16px 16px 12px;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(247, 244, 239, 0.04),
      0 25px 80px rgba(0, 0, 0, 0.5),
      0 0 120px rgba(78, 216, 194, 0.08),
      inset 0 1px 0 rgba(247, 244, 239, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .hero__phone::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 37px;
    background: linear-gradient(165deg, rgba(247, 244, 239, 0.12) 0%, transparent 40%, rgba(78, 216, 194, 0.06) 100%);
    z-index: -1;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    padding: 1px;
  }

  .hero__phone-notch {
    width: 100px;
    height: 6px;
    background: rgba(247, 244, 239, 0.08);
    border-radius: 10px;
    margin: 0 auto 12px;
  }

  .hero__phone-time {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(247, 244, 239, 0.4);
    text-align: center;
    margin-bottom: 16px;
  }

  .hero__phone-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 4px 12px;
    border-bottom: 1px solid rgba(247, 244, 239, 0.06);
    margin-bottom: 12px;
  }

  .hero__phone-logo {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 4px;
  }

  .hero__phone-app {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.8125rem;
    color: rgba(247, 244, 239, 0.6);
  }

  /* --- Notifications --- */
  .hero__notifs {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(to bottom, transparent 0%, black 2%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 2%, black 92%, transparent 100%);
    padding: 4px 0;
  }

  .hero__notifs::-webkit-scrollbar {
    width: 3px;
  }

  .hero__notifs::-webkit-scrollbar-track {
    background: transparent;
  }

  .hero__notifs::-webkit-scrollbar-thumb {
    background: rgba(78, 216, 194, 0.2);
    border-radius: 3px;
  }

  .hero__notifs::-webkit-scrollbar-thumb:hover {
    background: rgba(78, 216, 194, 0.4);
  }

  .hero__notif {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-sm);
    transition: all var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Glow effect is applied via JS inline styles for reliability */

  /* ─── STATS TICKER ─── */
  .hero__stats-ticker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 6px 12px;
    background: rgba(78, 216, 194, 0.04);
    border-bottom: 1px solid rgba(247, 244, 239, 0.04);
    font-size: 0.625rem;
    color: rgba(247, 244, 239, 0.4);
    letter-spacing: 0.03em;
    font-family: var(--font-mono);
  }

  .hero__stat-item {
    display: flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
  }

  .hero__stat-val {
    color: var(--reef-aqua);
    font-weight: 600;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .hero__stat-val--bump {
    transform: scale(1.25);
    color: #fff;
  }

  .hero__stat-divider {
    width: 1px;
    height: 10px;
    background: rgba(247, 244, 239, 0.08);
    margin: 0 10px;
  }

  /* ─── TYPING INDICATOR ─── */
  .hero__typing {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(78, 216, 194, 0.04);
    border: 1px solid rgba(78, 216, 194, 0.12);
    border-radius: var(--radius-sm);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    align-items: center;
  }

  .hero__typing-dots {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .hero__typing-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--reef-aqua);
    opacity: 0.5;
    animation: typingBounce 1.2s ease-in-out infinite;
  }

  .hero__typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .hero__typing-dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .hero__typing-label {
    font-size: 0.6875rem;
    color: rgba(78, 216, 194, 0.6);
    font-style: italic;
  }

  /* ─── LOTUS PULSE ─── */
  .hero__phone-logo--pulse {
    animation: lotusPulse 0.8s ease-out;
  }

  @keyframes lotusPulse {
    0% { filter: drop-shadow(0 0 0 rgba(78, 216, 194, 0)); transform: scale(1); }
    30% { filter: drop-shadow(0 0 8px rgba(78, 216, 194, 0.6)); transform: scale(1.15); }
    100% { filter: drop-shadow(0 0 0 rgba(78, 216, 194, 0)); transform: scale(1); }
  }

  /* ─── QUIET HOURS NOTIFICATION ─── */
  .hero__notif--quiet {
    background: rgba(78, 216, 194, 0.06) !important;
    border-color: rgba(78, 216, 194, 0.2) !important;
    box-shadow: 0 0 12px 1px rgba(78, 216, 194, 0.12) !important;
  }

  .hero__notif::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    opacity: 0.6;
  }

  .hero__notif:hover {
    background: rgba(247, 244, 239, 0.07);
    border-color: rgba(247, 244, 239, 0.1);
  }

  .hero__notif:hover::before {
    opacity: 1;
  }

  .hero__notif-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
    overflow: hidden;
  }

  .hero__notif-icon svg {
    width: 14px !important;
    height: 14px !important;
    max-width: 14px;
    max-height: 14px;
    flex-shrink: 0;
  }

  .hero__notif-body {
    flex: 1;
    min-width: 0;
  }

  .hero__notif-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 2px;
  }

  .hero__notif-title {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--warm-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero__notif-time {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(247, 244, 239, 0.3);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__notif-text {
    font-size: 0.75rem;
    color: rgba(247, 244, 239, 0.45);
    line-height: 1.4;
  }

  /* --- Platform Availability --- */
  .hero__platforms {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: var(--space-md);
  }

  .hero__platforms-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 239, 0.3);
  }

  .hero__platforms-icons {
    display: flex;
    gap: 0.5rem;
  }

  .hero__platform {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(247, 244, 239, 0.04);
    border: 1px solid rgba(247, 244, 239, 0.08);
    color: rgba(247, 244, 239, 0.4);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .hero__platform:hover {
    color: var(--reef-aqua);
    border-color: rgba(78, 216, 194, 0.2);
    background: rgba(78, 216, 194, 0.06);
  }

  /* --- Capabilities Bar --- */
  .hero__capabilities {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-2xl);
    border-top: 1px solid rgba(247, 244, 239, 0.06);
  }

  .hero__cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.06);
    border-radius: var(--radius-md);
    transition: all var(--duration-normal) var(--ease-out);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__cap:hover {
    background: rgba(247, 244, 239, 0.06);
    border-color: rgba(78, 216, 194, 0.2);
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(78, 216, 194, 0.08),
      inset 0 1px 0 rgba(247, 244, 239, 0.06);
  }

  .hero__cap-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(78, 216, 194, 0.1);
    border: 1px solid rgba(78, 216, 194, 0.12);
    color: var(--reef-aqua);
    flex-shrink: 0;
    box-shadow: 0 0 16px rgba(78, 216, 194, 0.08);
  }

  .hero__cap-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .hero__cap-title {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--warm-white);
    white-space: nowrap;
  }

  .hero__cap-sub {
    font-size: 0.75rem;
    color: rgba(247, 244, 239, 0.4);
    white-space: nowrap;
  }

  /* --- Scroll Indicator --- */
  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .hero__scroll-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(247, 244, 239, 0.3);
    transition: color var(--duration-fast);
  }

  .hero__scroll-indicator:hover .hero__scroll-text {
    color: var(--reef-aqua);
  }

  .hero__scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0));
    animation: lineGrow 2s ease-in-out infinite;
  }

  .hero__scroll-chevron {
    color: rgba(78, 216, 194, 0.5);
    animation: chevronBounce 2s ease-in-out infinite;
  }

  .hero__scroll-indicator:hover .hero__scroll-chevron {
    color: var(--reef-aqua);
  }

  @keyframes lineGrow {
    0%, 100% { opacity: 0.4; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  @keyframes chevronBounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(4px); opacity: 1; }
  }

