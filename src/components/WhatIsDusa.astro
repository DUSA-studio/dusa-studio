---
// WhatIsDusa.astro — Clear explainer section placed right after the Hero
// Spells out the acronym and communicates what DUSA does at a glance.

interface Props {
  t?: Record<string, any>;
}
const { t = {} } = Astro.props;

const s = t?.whatIsDusa || {};
const widEyebrow = s.eyebrow || 'Digital Utility for Sales & Automation';
const widHeading = s.heading || 'DUSA is the all-in-one growth platform';
const widHeadingAccent = s.headingAccent || 'built for small businesses.';
const widSub = s.sub || 'We replace the patchwork of disconnected tools with a single, AI-powered system that handles your marketing, sales, and customer engagement. Less tech headaches, more growth.';
const widPillar1Title = s.pillar1Title || 'One platform, not nine subscriptions';
const widPillar1Desc = s.pillar1Desc || 'CRM, email, SMS, funnels, websites, payments, scheduling, reputation management. All under one roof with one login.';
const widPillar2Title = s.pillar2Title || 'AI that works while you sleep';
const widPillar2Desc = s.pillar2Desc || 'Automated follow-ups, smart lead scoring, review requests, and campaign triggers. Your business keeps moving, even when you step away.';
const widPillar3Title = s.pillar3Title || 'Built for businesses that want to grow';
const widPillar3Desc = s.pillar3Desc || 'Whether you are a solo founder or a small team, DUSA scales with you. Start simple, add features as you need them.';
---

<section class="wid section--dark" id="what-is-dusa">
  <div class="wid__inner">

    <span class="wid__eyebrow reveal">{widEyebrow}</span>

    <h2 class="wid__heading reveal">
      {widHeading}<br />
      <span class="wid__accent gradient-text">{widHeadingAccent}</span>
    </h2>

    <p class="wid__sub reveal">
      {widSub}
    </p>

    <div class="wid__pillars">
      <div class="wid__pillar reveal">
        <div class="wid__pillar-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="4" y="6" width="28" height="24" rx="3" stroke="rgba(78,216,194,0.6)" stroke-width="1.5" fill="none"/>
            <path d="M4 12h28" stroke="rgba(78,216,194,0.6)" stroke-width="1.5"/>
            <circle cx="8" cy="9" r="1" fill="rgba(78,216,194,0.4)"/>
            <circle cx="12" cy="9" r="1" fill="rgba(78,216,194,0.4)"/>
            <circle cx="16" cy="9" r="1" fill="rgba(78,216,194,0.4)"/>
            <rect x="8" y="16" width="8" height="2" rx="1" fill="rgba(78,216,194,0.4)"/>
            <rect x="8" y="21" width="12" height="2" rx="1" fill="rgba(78,216,194,0.3)"/>
            <rect x="8" y="26" width="6" height="2" rx="1" fill="rgba(78,216,194,0.3)"/>
            <rect x="22" y="16" width="6" height="12" rx="2" stroke="rgba(78,216,194,0.4)" stroke-width="1" fill="none"/>
          </svg>
        </div>
        <h3 class="wid__pillar-title">{widPillar1Title}</h3>
        <p class="wid__pillar-desc">
          {widPillar1Desc}
        </p>
      </div>

      <div class="wid__pillar reveal">
        <div class="wid__pillar-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 6v6m0 12v6M6 18h6m12 0h6" stroke="rgba(78,216,194,0.6)" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="18" cy="18" r="5" stroke="rgba(78,216,194,0.6)" stroke-width="1.5" fill="none"/>
            <circle cx="18" cy="18" r="1.5" fill="rgba(78,216,194,0.5)"/>
            <path d="M10.5 10.5l3 3m9 9l3 3M25.5 10.5l-3 3m-9 9l-3 3" stroke="rgba(78,216,194,0.3)" stroke-width="1" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="wid__pillar-title">{widPillar2Title}</h3>
        <p class="wid__pillar-desc">
          {widPillar2Desc}
        </p>
      </div>

      <div class="wid__pillar reveal">
        <div class="wid__pillar-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 28L14 18L20 22L28 8" stroke="rgba(78,216,194,0.6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="28" cy="8" r="3" stroke="rgba(78,216,194,0.6)" stroke-width="1.5" fill="none"/>
            <circle cx="28" cy="8" r="1" fill="rgba(78,216,194,0.5)"/>
            <path d="M6 32h24" stroke="rgba(78,216,194,0.25)" stroke-width="1" stroke-linecap="round"/>
            <path d="M6 8v24" stroke="rgba(78,216,194,0.25)" stroke-width="1" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="wid__pillar-title">{widPillar3Title}</h3>
        <p class="wid__pillar-desc">
          {widPillar3Desc}
        </p>
      </div>
    </div>

  </div>
</section>

<style>
  .wid {
    position: relative;
    background: var(--deep-black, #0C0E14);
    padding: 7rem 2rem 8rem;
    overflow: hidden;
  }

  /* Subtle separator line from Hero */
  .wid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(78, 216, 194, 0.1) 30%,
      rgba(78, 216, 194, 0.06) 50%,
      rgba(78, 216, 194, 0.1) 70%,
      transparent
    );
  }

  .wid__inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .wid__eyebrow {
    display: inline-block;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(78, 216, 194, 0.6);
    margin-bottom: 1.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid rgba(78, 216, 194, 0.15);
    border-radius: 100px;
    visibility: hidden;
  }

  .wid__heading {
    font-family: var(--font-headline, 'Space Grotesk', sans-serif);
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--warm-white, #F7F4EF);
    margin-bottom: 1.5rem;
    visibility: hidden;
  }

  .wid__accent {
    color: rgba(78, 216, 194, 0.9);
  }

  .wid__sub {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.75;
    color: rgba(247, 244, 239, 0.5);
    max-width: 620px;
    margin: 0 auto 4rem;
    visibility: hidden;
  }

  /* ─── PILLARS ─── */
  .wid__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    text-align: left;
  }

  .wid__pillar {
    padding: 2rem 1.5rem;
    border-radius: 12px;
    background: rgba(247, 244, 239, 0.02);
    border: 1px solid rgba(78, 216, 194, 0.06);
    transition: border-color 0.3s ease, background 0.3s ease;
    visibility: hidden;
    min-width: 0;
  }

  .wid__pillar:hover {
    border-color: rgba(78, 216, 194, 0.15);
    background: rgba(247, 244, 239, 0.04);
  }

  .wid__pillar-icon {
    margin-bottom: 1.25rem;
  }

  .wid__pillar-title {
    font-family: var(--font-headline, 'Space Grotesk', sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 600;
    color: var(--warm-white, #F7F4EF);
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }

  .wid__pillar-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.4);
    overflow-wrap: break-word;
  }

  /* ─── TABLET ─── */
  @media (max-width: 768px) {
    .wid {
      padding: 5rem var(--space-md) 6rem;
    }

    .wid__pillars {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 440px;
      margin: 0 auto;
    }
  }

  /* ─── MOBILE ─── */
  @media (max-width: 480px) {
    .wid {
      padding: 3.5rem 1.25rem 4rem;
    }

    .wid__eyebrow {
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      padding: 0.35rem 0.75rem;
    }

    .wid__sub {
      margin-bottom: 2.5rem;
    }

    .wid__pillar {
      padding: 1.5rem 1.25rem;
    }
  }

  /* ─── LIGHT MODE ─── */
  :global(html[data-theme="light"]) .wid {
    background: var(--warm-white);
    padding: 5rem 2rem 5rem;
  }

  :global(html[data-theme="light"]) .wid::before {
    background: linear-gradient(to right, transparent, rgba(26, 58, 92, 0.12) 30%, rgba(26, 58, 92, 0.08) 50%, rgba(26, 58, 92, 0.12) 70%, transparent);
  }

  :global(html[data-theme="light"]) .wid__eyebrow {
    color: var(--deep-ocean);
    border-color: rgba(26, 58, 92, 0.2);
  }

  :global(html[data-theme="light"]) .wid__heading {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .wid__accent {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .wid__sub {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .wid__pillar {
    background: rgba(26, 58, 92, 0.03);
    border-color: rgba(26, 58, 92, 0.08);
  }

  :global(html[data-theme="light"]) .wid__pillar:hover {
    border-color: rgba(26, 58, 92, 0.18);
    background: rgba(26, 58, 92, 0.05);
  }

  :global(html[data-theme="light"]) .wid__pillar-icon svg [stroke*="78,216,194"] {
    stroke: rgba(26, 58, 92, 0.5);
  }

  :global(html[data-theme="light"]) .wid__pillar-icon svg [fill*="78,216,194"] {
    fill: rgba(26, 58, 92, 0.35);
  }

  :global(html[data-theme="light"]) .wid__pillar-title {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .wid__pillar-desc {
    color: rgba(12, 14, 20, 0.5);
  }
</style>
