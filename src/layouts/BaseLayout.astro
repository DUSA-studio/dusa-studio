---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { stripRegion, urlFor, navRoutesByRegion, REGION_PREFIXES } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  lang?: string;
  ogLocale?: string;
  region?: string;
  t?: Record<string, any>;
}

const {
  title = 'DUSA . studio | Growth Platform for Small Business',
  description = 'Run your marketing, sales, and customer engagement from one platform. DUSA is the all-in-one growth system built for businesses that want to scale without the complexity.',
  noindex = false,
  lang = 'en-AU',
  ogLocale = 'en_AU',
  region,
  t = {},
} = Astro.props;

// Clamp meta descriptions to 160 chars at a word boundary (SERP hygiene).
const seoDescription = description.length <= 160
  ? description
  : description.slice(0, 157).replace(/\s+\S*$/, '') + '…';

/* ─── Canonical + hreflang logic ─── */
const siteBase = 'https://dusa.studio';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(rawPath === '/' ? '/' : rawPath, siteBase).href;

// Strip locale prefix to get the base page path
const localePattern = /^\/(es|mx|br|fr|de|us|uk)(\/|$)/;
const localeMatch = rawPath.match(localePattern);
const basePath = localeMatch ? rawPath.replace(localePattern, '/').replace(/^\/$/, '') : rawPath;
const pagePath = basePath === '/' ? '' : basePath;

// Hreflang definitions — emitted ONLY for regions where this page actually
// exists. Page coverage is uneven (61 EN blog posts vs 1 DE, and /us + /uk are
// pricing-only), so anything hand-maintained drifts and ends up advertising
// 404s to Google. Routes are read from the filesystem at build time instead.
const HREFLANG_BY_REGION: Record<string, string> = {
  au: 'en-au', us: 'en-us', uk: 'en-gb', es: 'es-es',
  mx: 'es-mx', br: 'pt-br', fr: 'fr-fr', de: 'de-de',
};

const { basePath: hreflangBasePath } = stripRegion(rawPath);

const hreflangs = REGION_PREFIXES
  .map((r) => ({ region: r, hreflang: HREFLANG_BY_REGION[r], href: urlFor(r, hreflangBasePath) }))
  .filter((x): x is { region: typeof REGION_PREFIXES[number]; hreflang: string; href: string } => x.href !== null);

// Which regions this page is reachable in — handed to the switcher so it can
// never send someone to a page that does not exist.
const regionAlternates: Record<string, string> = Object.fromEntries(
  hreflangs.map(({ region, href }) => [region, href])
);
// Which top-level pages each region actually has (blog posts collapsed).
const regionRoutes = navRoutesByRegion();
// Regions that have a homepage to fall back to.
const regionHomes: Record<string, string> = Object.fromEntries(
  REGION_PREFIXES.map((r) => [r, urlFor(r, '/')]).filter(([, href]) => href !== null) as [string, string][]
);

/* ─── Breadcrumb schema (non-homepage only) ─── */
const isHomepage = rawPath === '/' || rawPath === '';
const breadcrumbSegments = rawPath.split('/').filter(Boolean);
let breadcrumbSchema = '';
if (!isHomepage && breadcrumbSegments.length > 0) {
  const items = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase + '/' },
  ];
  let accumPath = '';
  for (let i = 0; i < breadcrumbSegments.length; i++) {
    accumPath += '/' + breadcrumbSegments[i];
    const segName = breadcrumbSegments[i]
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c: string) => c.toUpperCase());
    items.push({
      '@type': 'ListItem',
      position: i + 2,
      name: segName,
      item: siteBase + accumPath,
    });
  }
  breadcrumbSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  });
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seoDescription} />
    <meta name="theme-color" content="#0C0E14" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Hreflang alternate links for international SEO -->
    {hreflangs.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={`${siteBase}${href === '/' ? '' : href}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteBase}${(regionAlternates.au ?? rawPath) === '/' ? '' : (regionAlternates.au ?? rawPath)}`} />

    <!-- Theme detection — runs before paint to prevent flash -->
    <script is:inline>
      (function() {
        /* An explicit choice always wins. Otherwise follow the operating
           system, so a visitor in Light mode is not ambushed by a dark site.
           Runs inline in <head>, before paint, so there is no flash — moving
           it any later reintroduces one. */
        var saved = localStorage.getItem('dusa-theme');
        var wantsLight = saved === 'light' ||
          (saved !== 'dark' &&
           window.matchMedia &&
           window.matchMedia('(prefers-color-scheme: light)').matches);
        var mc = document.querySelector('meta[name="theme-color"]');
        if (wantsLight) {
          document.documentElement.setAttribute('data-theme', 'light');
          if (mc) mc.setAttribute('content', '#F7F4EF');
        } else if (mc) {
          mc.setAttribute('content', '#0C0E14');
        }
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://dusa.studio/og-default.jpg" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content="https://dusa.studio/og-default.jpg" />

    <!-- Breadcrumb structured data -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={breadcrumbSchema} />
    )}

    <!-- Fonts are self-hosted, so there is no third-party origin to warm up.
         Preload only the two faces used above the fold; the rest are
         unicode-range gated and fetched on demand. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    <!-- GSAP (self-hosted: same origin, immutable cache, no cdnjs round trip) -->
    <script src="/js/vendor/gsap-3.12.5.min.js" defer></script>
    <script src="/js/vendor/ScrollTrigger-3.12.5.min.js" defer></script>

    <!-- Scroll reveals: one IntersectionObserver, no GSAP dependency.
         Loaded early and deferred so anything already on screen is shown
         before first paint. -->
    <script src="/js/reveal.v2.js" defer></script>
    <noscript>
      <style>
        .reveal, .reveal-left, .reveal-right, .reveal-scale {
          visibility: visible !important;
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Nav t={t} regionAlternates={regionAlternates} regionHomes={regionHomes} regionRoutes={regionRoutes} />
    <main>
      <slot />
    </main>
    <Footer t={t} />

    <!-- Vercel Web Analytics (privacy-friendly, no cookies) -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- LeadConnector Chat Widget -->
    <script src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="6880d1b3b785852440a39d69"
      defer>
    </script>
  </body>
</html>
