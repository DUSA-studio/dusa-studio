---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingContent from '../../components/PricingContent.astro';
import { getRegion, getRegionPrices } from '../../i18n/regions.js';
import t from '../../i18n/translations/fi.json';

const region = getRegion('fi');
const prices = getRegionPrices('fi');
---
<BaseLayout
  title={t.pricing.metaTitle}
  description={t.pricing.metaDescription}
  lang={region.htmlLang}
  ogLocale={region.ogLocale}
  t={t}
>
  <PricingContent region={region} t={t} prices={prices} regionKey="fi" />
</BaseLayout>
