      /* What they say. Hours, who, the line, and whether it is said or thought. */
      type Line = { from: number; to: number; who: ReturnType<typeof makePerson>; text: string; thought?: boolean };
      const lines: Line[] = nice ? [
        { from: 7.6, to: 8.0, who: owner, text: 'Three booked overnight. Easy.', thought: true },
