---
/**
 * /compare/highlevel
 *
 * The honest page: DUSA runs on HighLevel. Who should go direct, who should
 * use DUSA, and the maths for a single Australian business. Written for people
 * who already know HighLevel and are choosing a provider, which is the warmest
 * traffic the site can get. English only for now.
 *
 * Conversion maths: HighLevel's direct prices (US$97 Starter, US$297
 * Unlimited, AI Employee US$50 Growth or US$97 Unlimited per location) from
 * gohighlevel.com and help.gohighlevel.com, October 2026. AUD figures use the
 * site's USD rate from regions.js (AUD -> USD 0.67) and are rounded to the
 * nearest $5, labelled "about".
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import t from '../../i18n/translations/en.json';
import { regions } from '../../i18n/regions.js';

const usdToAud = 1 / regions.us.rate;
const aud = (usd: number) => Math.round((usd * usdToAud) / 5) * 5;

const hl = {
  starter: 97,
  unlimited: 297,
  aiGrowth: 50,
  aiUnlimited: 97,
};
const hlStarterAud = aud(hl.starter);
const hlUnlimitedAud = aud(hl.unlimited);
const hlAiUnlimitedAud = aud(hl.aiUnlimited);
const hlAiGrowthAud = aud(hl.aiGrowth);

const rows = [
  { label: 'Built for', direct: 'Marketing agencies that resell the platform to clients', dusa: 'One business that wants it to work from day one' },
  { label: 'Monthly price', direct: `US$${hl.starter} Starter (3 sub-accounts) or US$${hl.unlimited} Unlimited, about A$${hlStarterAud} and A$${hlUnlimitedAud}`, dusa: '$47 Launchpad, $149 Starter, $297 Growth, all in AUD' },
  { label: 'Setup and migration', direct: 'You build it from a blank account, or pay a freelancer', dusa: 'Set up with you in the first week, contacts and campaigns migrated' },
  { label: 'Industry templates', direct: 'Build your own pipelines, calendars, workflows and funnels', dusa: 'Set up for your industry with you, across the 16 industries we serve' },
  { label: 'AI Employee', direct: `An add-on: US$${hl.aiGrowth} or US$${hl.aiUnlimited} per month per location (about A$${hlAiGrowthAud} to A$${hlAiUnlimitedAud})`, dusa: 'Included on Growth: AI answers calls and messages and books appointments' },
  { label: 'Ask AI assistant', direct: 'Pay per use on the base plans', dusa: 'On every plan, usage included on Growth and Bespoke' },
  { label: 'Users', direct: 'Unlimited', dusa: '1 on Launchpad and Starter, 3 on Growth, unlimited on Bespoke; extra users $29/mo' },
  { label: 'Support', direct: '24/7 global chat, written for agencies', dusa: 'Sydney-based team, 24/7 AI assistant, priority queue on Growth' },
  { label: 'Onboarding session', direct: 'Not included', dusa: 'Included on Growth and Bespoke, with AI setup' },
  { label: 'Messages, calls and email usage', direct: 'Pay as you go in USD', dusa: 'Pay as you go in USD, through the same providers' },
  { label: 'Lock-in', direct: 'None', dusa: 'None, and your data exports any time' },
];

const faqs = [
  {
    q: 'Is DUSA just a HighLevel reseller?',
    a: 'DUSA is built on HighLevel in the same way a lot of software is built on AWS. The engine is theirs; the setup, the industry setup, the Australian support, the AUD pricing and the AI inclusions are ours. If you only want the raw engine, going direct is the right call and we say so on this page.',
  },
  {
    q: 'Why tell people at all?',
    a: 'Because you would find out in a week, and finding it in our FAQ reads differently from finding it in a login URL. It also answers the question every small business asks about a platform run by a studio: what happens to my data if you disappear. The answer is that it sits on infrastructure powering 2.2 million businesses, and you can export it at any time.',
  },
  {
    q: 'Can I move to HighLevel direct later, or bring an existing HighLevel account to DUSA?',
    a: 'Yes to both. Contacts, pipelines, funnels and workflows can be exported and imported between HighLevel accounts, and we help with the move in either direction. There are no lock-in contracts on any DUSA plan.',
  },
  {
    q: 'Who should go direct to HighLevel?',
    a: 'Agencies and consultants who manage several clients, want unlimited sub-accounts and users, and have someone to build and maintain the setup. HighLevel is built for that buyer and priced in USD for it.',
  },
  {
    q: 'Who should use DUSA?',
    a: 'A single business, or a small group of locations, that wants the platform working in the first week, in AUD, with the AI Employee answering the phone on Growth and someone in Sydney to call. DUSA is built for trades, clinics, salons, gyms, real estate and professional services.',
  },
  {
    q: 'Is my data safe?',
    a: 'Your account lives on HighLevel infrastructure (SOC 2 Type II) with DUSA as your provider. You own your data, can export it whenever you like, and nothing is shared with other DUSA customers.',
  },
];

const title = 'DUSA vs going direct to HighLevel | DUSA . studio';
const description = 'DUSA runs on HighLevel. Here is what you get going direct, what DUSA adds on top, and the honest maths for an Australian small business.';
---

<BaseLayout t={t} title={title} description={description}>

  <!-- Hero -->
  <section class="cmp-hero section section--dark">
    <div class="container">
      <div class="cmp-hero__content">
        <span class="label">The honest comparison</span>
        <h1>Yes, DUSA runs on HighLevel.<br/><span class="gradient-text">Here is the whole picture.</span></h1>
        <p class="cmp-hero__sub">HighLevel is the engine behind 2.2 million businesses. DUSA is the car: set up, supported and priced in AUD for one Australian small business. If you already know HighLevel, this page is for you.</p>
      </div>
    </div>
  </section>

  <div class="section--dark cmp-trust"><TrustStrip t={t} tight /></div>

  <!-- Who it is for -->
  <section class="cmp-who section section--dark">
    <div class="container">
      <div class="cmp-who__grid">
        <div class="cmp-who__card">
          <span class="label">Go direct if</span>
          <h2>You are an agency<br/><span class="gradient-text">reselling to clients</span></h2>
          <p>You want unlimited sub-accounts and users, you have someone to build and maintain the setup, and USD billing is fine. HighLevel is built for that buyer, and you should buy it from them.</p>
        </div>
        <div class="cmp-who__card cmp-who__card--dusa">
          <span class="label">Use DUSA if</span>
          <h2>You run one business<br/><span class="gradient-text">and want it to just work</span></h2>
          <p>You want the platform live in the first week with your contacts migrated, a setup built for your industry, the AI Employee answering the phone on Growth, pricing in AUD and a team in Sydney to call.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Side by side -->
  <section class="cmp-table section section--dark" style="padding-top:0;">
    <div class="container">
      <div class="cmp-table__header">
        <span class="label">Side by side</span>
        <h2>Same engine,<br/><span class="gradient-text">different car</span></h2>
      </div>
      <div class="cmp-table__wrap">
        <table class="cmp-table__table">
          <thead>
            <tr>
              <th></th>
              <th>HighLevel direct</th>
              <th class="cmp-table__dusa-col">DUSA</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.direct}</td>
                <td class="cmp-table__dusa-col">{r.dusa}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp-table__note">HighLevel prices from gohighlevel.com and help.gohighlevel.com, October 2026. AUD conversions are approximate and move with the exchange rate. DUSA prices in AUD. Usage (messages, calls, email, and AI beyond what a plan includes) is billed as you use it on both.</p>
    </div>
  </section>

  <!-- The maths -->
  <section class="cmp-maths section section--sand">
    <div class="container">
      <div class="cmp-maths__header">
        <span class="label" style="color: var(--deep-ocean);">The maths</span>
        <h2 style="color: var(--deep-black);">For one business the price is close.<br/><span style="color: var(--deep-ocean);">The difference is who does the work.</span></h2>
      </div>
      <div class="cmp-maths__grid">
        <div class="cmp-maths__card">
          <span class="cmp-maths__tier">The platform, run by you</span>
          <div class="cmp-maths__row"><span>HighLevel Starter, direct</span><strong>about A${hlStarterAud}/mo</strong></div>
          <div class="cmp-maths__row"><span>Setup, migration and templates</span><strong>your time, or a freelancer</strong></div>
          <div class="cmp-maths__row cmp-maths__row--dusa"><span>DUSA Starter: set up with you, Sydney support, Ask AI</span><strong>A$149/mo</strong></div>
        </div>
        <div class="cmp-maths__card cmp-maths__card--pop">
          <span class="cmp-maths__tier">The platform plus the AI Employee</span>
          <div class="cmp-maths__row"><span>HighLevel Starter, direct</span><strong>about A${hlStarterAud}/mo</strong></div>
          <div class="cmp-maths__row"><span>AI Employee add-on (Growth tier)</span><strong>about A${hlAiGrowthAud}/mo</strong></div>
          <div class="cmp-maths__row"><span>Together, then you set up and train the AI yourself</span><strong>about A${aud(hl.starter + hl.aiGrowth)}/mo</strong></div>
          <div class="cmp-maths__row cmp-maths__row--dusa"><span>DUSA Growth: AI Employee included, onboarding and AI setup session, priority support</span><strong>A$297/mo</strong></div>
        </div>
      </div>
      <p class="cmp-maths__note">So Growth is about A${297 - aud(hl.starter + hl.aiGrowth)} a month more than the do-it-yourself version, and that is the price of someone setting it up, training the AI on your business and being on the phone in your time zone. If you would rather do that work yourself, go direct and we will still think you chose well. Both AI figures carry the same monthly allowance (100 call minutes, 1,000 replies); HighLevel's unlimited AI tier is about A${hlAiUnlimitedAud}/mo, DUSA's Unlimited AI add-on is $197/mo.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cmp-faq section section--dark" id="faq">
    <div class="container">
      <div class="cmp-faq__header">
        <span class="label">Straight answers</span>
        <h2>The questions people<br/><span class="gradient-text">actually ask</span></h2>
      </div>
      <div class="cmp-faq__list">
        {faqs.map((f, i) => (
          <details class="cmp-faq__item" {...(i === 0 ? { open: true } : {})}>
            <summary class="cmp-faq__q">{f.q}</summary>
            <p class="cmp-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cmp-cta section section--dark" id="contact">
    <div class="container">
      <div class="cmp-cta__content">
        <span class="label">Decide with your own data</span>
        <h2>Try DUSA free for 14 days.<br/><span class="gradient-text">Bring your HighLevel account if you have one.</span></h2>
        <div class="cmp-cta__actions">
          <a href="/start" data-page="start" class="btn btn--primary">Start free trial</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Book a demo</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
</BaseLayout>

<style>
  .cmp-hero { padding-top: calc(var(--nav-height) + var(--space-3xl)); padding-bottom: var(--space-xl); text-align: center; }
  .cmp-hero__content { max-width: 820px; margin: 0 auto; }
  .cmp-hero h1 { font-size: clamp(2.25rem, 4.6vw, 3.6rem); line-height: 1.08; }
  .cmp-hero__sub { font-size: 1.2rem; color: rgba(247, 244, 239, 0.66); line-height: 1.7; margin: var(--space-md) auto 0; max-width: 640px; }
  .cmp-trust { padding-bottom: var(--space-md); }

  .cmp-who { padding-top: var(--space-xl); }
  .cmp-who__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .cmp-who__card {
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(247, 244, 239, 0.1);
    background: rgba(247, 244, 239, 0.03);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .cmp-who__card--dusa { border-color: rgba(78, 216, 194, 0.35); background: rgba(78, 216, 194, 0.05); }
  .cmp-who__card h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0.5rem 0 var(--space-sm); }
  .cmp-who__card p { color: rgba(247, 244, 239, 0.68); line-height: 1.7; max-width: none; }

  .cmp-table__header { text-align: center; max-width: 600px; margin: 0 auto var(--space-xl); }
  .cmp-table__wrap { overflow-x: auto; border: 1px solid rgba(247, 244, 239, 0.08); border-radius: var(--radius-lg); background: rgba(247, 244, 239, 0.02); }
  .cmp-table__table { width: 100%; border-collapse: collapse; min-width: 720px; }
  .cmp-table__table th, .cmp-table__table td { padding: 1rem 1.25rem; text-align: left; vertical-align: top; border-bottom: 1px solid rgba(247, 244, 239, 0.07); font-size: 0.9375rem; line-height: 1.55; }
  .cmp-table__table thead th { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(247, 244, 239, 0.62); background: rgba(247, 244, 239, 0.03); }
  .cmp-table__table tbody th { font-weight: 600; color: var(--warm-white); width: 22%; }
  .cmp-table__table td { color: rgba(247, 244, 239, 0.7); }
  .cmp-table__dusa-col { background: rgba(78, 216, 194, 0.05); }
  .cmp-table__table thead .cmp-table__dusa-col { color: var(--reef-aqua); }
  .cmp-table__table td.cmp-table__dusa-col { color: rgba(247, 244, 239, 0.88); }
  .cmp-table__table tbody tr:last-child th, .cmp-table__table tbody tr:last-child td { border-bottom: none; }
  .cmp-table__note { margin: var(--space-md) auto 0; max-width: 760px; text-align: center; font-size: 0.8125rem; line-height: 1.65; color: rgba(247, 244, 239, 0.56); }

  .cmp-maths__header { text-align: center; max-width: 640px; margin: 0 auto var(--space-xl); }
  .cmp-maths__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .cmp-maths__card { padding: var(--space-lg); border-radius: var(--radius-lg); border: 1px solid rgba(12, 14, 20, 0.1); background: rgba(255, 255, 255, 0.55); }
  .cmp-maths__card--pop { border-color: var(--deep-ocean); box-shadow: 0 10px 40px rgba(26, 58, 92, 0.12); }
  .cmp-maths__tier { display: block; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--deep-ocean); margin-bottom: var(--space-sm); }
  .cmp-maths__row { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: 0.7rem 0; border-bottom: 1px solid rgba(12, 14, 20, 0.08); color: rgba(12, 14, 20, 0.7); font-size: 0.9375rem; line-height: 1.5; }
  .cmp-maths__row strong { color: var(--deep-black); white-space: nowrap; font-family: var(--font-mono); font-size: 0.875rem; }
  .cmp-maths__row--dusa { border-bottom: none; color: var(--deep-black); font-weight: 600; margin-top: 0.4rem; padding: 0.9rem 1rem; border-radius: var(--radius-md); background: rgba(26, 58, 92, 0.07); }
  .cmp-maths__row--dusa strong { color: var(--deep-ocean); font-size: 1rem; }
  .cmp-maths__note { margin: var(--space-md) auto 0; max-width: 760px; text-align: center; font-size: 0.875rem; line-height: 1.65; color: rgba(12, 14, 20, 0.62); }

  .cmp-faq__header { text-align: center; max-width: 600px; margin: 0 auto var(--space-xl); }
  .cmp-faq__list { max-width: 720px; margin: 0 auto; }
  .cmp-faq__item { border-bottom: 1px solid rgba(247, 244, 239, 0.08); padding: 0 0.25rem; }
  .cmp-faq__q { cursor: pointer; list-style: none; padding: 1.1rem 0; font-family: var(--font-headline); font-weight: 600; font-size: 1.0625rem; color: var(--warm-white); display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .cmp-faq__q::-webkit-details-marker { display: none; }
  .cmp-faq__q::after { content: '+'; font-family: var(--font-mono); color: var(--reef-aqua); flex-shrink: 0; }
  .cmp-faq__item[open] .cmp-faq__q::after { content: '\2212'; }
  .cmp-faq__a { padding: 0 0 1.25rem; color: rgba(247, 244, 239, 0.66); line-height: 1.7; max-width: none; }

  .cmp-cta { text-align: center; }
  .cmp-cta__content { max-width: 720px; margin: 0 auto; }
  .cmp-cta__actions { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; margin-top: var(--space-lg); }

  @media (max-width: 900px) {
    .cmp-who__grid, .cmp-maths__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .cmp-hero { padding-top: calc(var(--nav-height) + var(--space-2xl)); }
    .cmp-who__card { padding: var(--space-lg); }
    .cmp-maths__row { flex-direction: column; gap: 0.2rem; }
    .cmp-cta__actions .btn { width: 100%; text-align: center; }
  }

  /* Light mode */
  :global(html[data-theme="light"]) .cmp-hero__sub { color: rgba(12, 14, 20, 0.66); }
  :global(html[data-theme="light"]) .cmp-who__card { border-color: rgba(12, 14, 20, 0.1); background: rgba(12, 14, 20, 0.02); }
  :global(html[data-theme="light"]) .cmp-who__card--dusa { border-color: rgba(26, 58, 92, 0.4); background: rgba(26, 58, 92, 0.05); }
  :global(html[data-theme="light"]) .cmp-who__card p { color: rgba(12, 14, 20, 0.68); }
  :global(html[data-theme="light"]) .cmp-table__wrap { border-color: rgba(12, 14, 20, 0.1); background: rgba(12, 14, 20, 0.015); }
  :global(html[data-theme="light"]) .cmp-table__table th, :global(html[data-theme="light"]) .cmp-table__table td { border-bottom-color: rgba(12, 14, 20, 0.08); }
  :global(html[data-theme="light"]) .cmp-table__table thead th { color: rgba(12, 14, 20, 0.62); background: rgba(12, 14, 20, 0.03); }
  :global(html[data-theme="light"]) .cmp-table__table tbody th { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cmp-table__table td { color: rgba(12, 14, 20, 0.7); }
  :global(html[data-theme="light"]) .cmp-table__dusa-col { background: rgba(26, 58, 92, 0.05); }
  :global(html[data-theme="light"]) .cmp-table__table thead .cmp-table__dusa-col { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .cmp-table__table td.cmp-table__dusa-col { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cmp-table__note { color: rgba(12, 14, 20, 0.6); }
  :global(html[data-theme="light"]) .cmp-faq__item { border-bottom-color: rgba(12, 14, 20, 0.1); }
  :global(html[data-theme="light"]) .cmp-faq__q { color: var(--deep-black); }
  :global(html[data-theme="light"]) .cmp-faq__q::after { color: var(--deep-ocean); }
  :global(html[data-theme="light"]) .cmp-faq__a { color: rgba(12, 14, 20, 0.68); }
</style>
