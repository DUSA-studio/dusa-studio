---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/t.js';
import tData from '../../../i18n/translations/es.json';

const lang = 'es';
const region = 'mx';
---

<BaseLayout t={tData} title="Gestion de clientes para fotografos | DUSA . studio" description="Automatiza respuestas a consultas, contratos, recordatorios de sesion y entrega de galerias. DUSA le da a los fotografos un sistema completo de gestion de clientes desde la primera consulta hasta el pedido de impresiones.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://dusa.studio/mx/" },
      { "@type": "ListItem", "position": 2, "name": "Industrias", "item": "https://dusa.studio/mx/industries/" },
      { "@type": "ListItem", "position": 3, "name": "Fotografos", "item": "https://dusa.studio/mx/industries/photographers/" }
    ]
  })} />

  <!-- Hero -->
  <section class="industry-hero section section--dark">
    <div class="container">
      <div class="industry-hero__content">
        <span class="label">Fotografos</span>
        <h1>Agenda mas clientes y<br/><span class="gradient-text">nunca pierdas una consulta</span></h1>
        <p class="industry-hero__sub">DUSA automatiza tus respuestas a consultas, contratos, recordatorios de sesion y entrega de galerias para que puedas pasar mas tiempo detras de la camara.</p>
        <div class="industry-hero__actions">
          <a href="/mx/start" class="btn btn--primary">Comenzar</a>
          <a href="https://link.dusa.studio/widget/bookings/dusa-demo" target="_blank" rel="noopener noreferrer" class="btn btn--outline">Agendar una demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="pain-points section section--dark">
    <div class="container">
      <span class="label">El problema</span>
      <h2>Te suena familiar?</h2>
      <div class="pain-points__grid">
        <div class="pain-card">
          <div class="pain-card__icon">⏳</div>
          <h3>Respuestas lentas que pierden reservas</h3>
          <p>Un cliente potencial llena tu formulario el domingo por la noche. Tu respondes el lunes por la tarde. Para entonces, ya reservo con alguien mas.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">📝</div>
          <h3>Envio manual de contratos y cuestionarios</h3>
          <p>Cada reserva implica entrar a enviar un contrato, luego un cuestionario, luego un recordatorio. Se acumulan horas cada semana.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">🔔</div>
          <h3>Sin sistema de recordatorios de sesion</h3>
          <p>Los clientes olvidan los detalles de la sesion, llegan tarde o no siguen los pasos de preparacion porque no hay un recordatorio automatizado.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__icon">💰</div>
          <h3>Oportunidades de venta adicional perdidas</h3>
          <p>Entregas la galeria y sigues adelante. Albums, impresiones y sesiones adicionales nunca se ofrecen porque no hay un sistema de seguimiento.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution section section--dark">
    <div class="container">
      <span class="label">La solucion</span>
      <h2>Como funciona DUSA para <span class="gradient-text">fotografos</span></h2>
      <p class="solution__intro">Una sola plataforma maneja respuestas a consultas, contratos, recordatorios, entrega de galerias y secuencias de venta adicional.</p>
      <div class="solution__grid">
        <div class="solution-card">
          <h3>Respuesta automatica instantanea a consultas</h3>
          <p>Cada consulta recibe una respuesta inmediata y personalizada con tu guia de precios y disponibilidad. No mas prospectos perdidos.</p>
        </div>
        <div class="solution-card">
          <h3>Automatizacion de contratos y cuestionarios</h3>
          <p>Una vez que un cliente reserva, su contrato y cuestionario previo a la sesion se envian automaticamente. Firmados y devueltos sin que muevas un dedo.</p>
        </div>
        <div class="solution-card">
          <h3>Recordatorios de sesion</h3>
          <p>Recordatorios automaticos con detalles de ubicacion, consejos de vestuario y listas de preparacion se envian antes de cada sesion.</p>
        </div>
        <div class="solution-card">
          <h3>Entrega de galerias</h3>
          <p>Cuando la galeria esta lista, los clientes reciben un correo de entrega profesional con instrucciones de visualizacion y enlaces de descarga.</p>
        </div>
        <div class="solution-card">
          <h3>Secuencias de venta de impresiones y albums</h3>
          <p>Despues de la entrega de la galeria, seguimientos programados ofrecen albums, impresiones y arte para pared. Convierte cada sesion en ingresos adicionales.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline section section--dark">
    <div class="container">
      <span class="label">Tu pipeline</span>
      <h2>Cada cliente, cada etapa, <span class="gradient-text">perfectamente organizado</span></h2>
      <div class="pipeline__track">
        <div class="pipeline__stage">
          <div class="pipeline__number">1</div>
          <h3>Consulta</h3>
          <p>Llega un prospecto. La respuesta automatica se dispara con precios y siguientes pasos.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">2</div>
          <h3>Asesoria</h3>
          <p>Se agenda una llamada o reunion. El cliente conoce tu estilo y paquetes.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">3</div>
          <h3>Reservado</h3>
          <p>Contrato firmado y anticipo pagado. Cuestionario y preparacion de sesion se envian automaticamente.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">4</div>
          <h3>Sesion completada</h3>
          <p>Sesion realizada. El cliente recibe un mensaje de agradecimiento y la linea de tiempo de edicion.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">5</div>
          <h3>Galeria entregada</h3>
          <p>Galeria editada enviada. Comienza la solicitud de resena y la secuencia de venta adicional.</p>
        </div>
        <div class="pipeline__connector"></div>
        <div class="pipeline__stage">
          <div class="pipeline__number">6</div>
          <h3>Pedido de impresiones</h3>
          <p>Albums, impresiones o arte para pared ordenados. Se envia la oferta del programa de referidos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section section--dark">
    <div class="container">
      <span class="label">Resultados</span>
      <h2>Hecho para fotografos que quieren <span class="gradient-text">crecer</span></h2>
      <div class="stats__grid">
        <div class="stat-card">
          <div class="stat-card__number">50%</div>
          <p>mayor tasa de reservas con respuestas instantaneas a consultas</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">5hrs</div>
          <p>ahorradas por semana en administracion con flujos automatizados</p>
        </div>
        <div class="stat-card">
          <div class="stat-card__number">30%</div>
          <p>de los clientes agregan impresiones o albums con secuencias de venta adicional</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="final-cta section section--dark">
    <div class="container">
      <div class="final-cta__content">
        <h2>Listo para automatizar tu flujo de trabajo con clientes?</h2>
        <p>Pon tu negocio de fotografia a funcionar con DUSA en menos de una semana.</p>
        <div class="final-cta__actions">
          <a href="/mx/start" class="btn btn--primary">Comenzar</a>
          <a href="/blog/photographer-client-management" class="btn btn--outline">Leer la guia</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .industry-hero {
    padding-top: calc(var(--nav-height) + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .industry-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .industry-hero h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--warm-white);
  }

  .industry-hero__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(247, 244, 239, 0.6);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
  }

  .industry-hero__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain Points */
  .pain-points {
    padding: var(--space-2xl) 0;
  }

  .pain-points h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pain-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pain-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .pain-card__icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .pain-card h3 {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pain-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Solution */
  .solution {
    padding: var(--space-2xl) 0;
  }

  .solution h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .solution__intro {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .solution__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .solution-card {
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.25);
  }

  .solution-card h3 {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .solution-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline {
    padding: var(--space-2xl) 0;
  }

  .pipeline h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .pipeline__track {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .pipeline__stage {
    flex: 1;
    text-align: center;
    padding: 0 var(--space-sm);
  }

  .pipeline__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(78, 216, 194, 0.15);
    border: 1px solid rgba(78, 216, 194, 0.4);
    color: var(--reef-aqua);
    font-family: var(--font-headline);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-sm);
  }

  .pipeline__stage h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    color: var(--warm-white);
    margin-bottom: var(--space-xs);
  }

  .pipeline__stage p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pipeline__connector {
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
    margin-top: 20px;
    flex-shrink: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-2xl) 0;
  }

  .stats h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-xl);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    text-align: center;
    padding: var(--space-lg);
    background: rgba(247, 244, 239, 0.03);
    border: 1px solid rgba(247, 244, 239, 0.08);
    border-radius: var(--radius-md);
  }

  .stat-card__number {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--reef-aqua);
    margin-bottom: var(--space-xs);
  }

  .stat-card p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Final CTA */
  .final-cta {
    padding: var(--space-2xl) 0 var(--space-3xl);
    text-align: center;
  }

  .final-cta__content {
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--warm-white);
    margin-bottom: var(--space-sm);
  }

  .final-cta p {
    color: rgba(247, 244, 239, 0.6);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Light mode */
  :global(html[data-theme="light"]) .industry-hero h1,
  :global(html[data-theme="light"]) .pain-points h2,
  :global(html[data-theme="light"]) .solution h2,
  :global(html[data-theme="light"]) .pipeline h2,
  :global(html[data-theme="light"]) .stats h2,
  :global(html[data-theme="light"]) .final-cta h2,
  :global(html[data-theme="light"]) .pain-card h3,
  :global(html[data-theme="light"]) .pipeline__stage h3 {
    color: var(--deep-black);
  }

  :global(html[data-theme="light"]) .industry-hero__sub,
  :global(html[data-theme="light"]) .pain-card p,
  :global(html[data-theme="light"]) .solution__intro,
  :global(html[data-theme="light"]) .solution-card p,
  :global(html[data-theme="light"]) .pipeline__stage p,
  :global(html[data-theme="light"]) .stat-card p,
  :global(html[data-theme="light"]) .final-cta p {
    color: rgba(12, 14, 20, 0.55);
  }

  :global(html[data-theme="light"]) .pain-card,
  :global(html[data-theme="light"]) .solution-card,
  :global(html[data-theme="light"]) .stat-card {
    background: rgba(12, 14, 20, 0.03);
    border-color: rgba(12, 14, 20, 0.08);
  }

  :global(html[data-theme="light"]) .pain-card:hover,
  :global(html[data-theme="light"]) .solution-card:hover {
    border-color: rgba(78, 216, 194, 0.4);
  }

  :global(html[data-theme="light"]) .pipeline__connector {
    background: linear-gradient(90deg, rgba(78, 216, 194, 0.6), rgba(78, 216, 194, 0.2));
  }

  :global(html[data-theme="light"]) .pipeline__number {
    background: rgba(78, 216, 194, 0.1);
    border-color: rgba(78, 216, 194, 0.5);
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .stat-card__number {
    color: var(--deep-ocean);
  }

  :global(html[data-theme="light"]) .solution-card h3 {
    color: var(--deep-ocean);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
    }

    .solution__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .pipeline__track {
      flex-direction: column;
      align-items: center;
    }

    .pipeline__connector {
      width: 2px;
      height: 30px;
      min-width: unset;
      background: linear-gradient(180deg, rgba(78, 216, 194, 0.4), rgba(78, 216, 194, 0.1));
      margin-top: 0;
    }

    .pipeline__stage {
      padding: var(--space-sm) 0;
    }
  }

  @media (max-width: 480px) {
    .industry-hero {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
    }

    .pain-points,
    .solution,
    .pipeline,
    .stats,
    .final-cta {
      padding: var(--space-xl) 0;
    }

    .final-cta {
      padding-bottom: var(--space-2xl);
    }
  }
</style>
